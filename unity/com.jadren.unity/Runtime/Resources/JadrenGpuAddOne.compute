#pragma kernel AddOne

StructuredBuffer<int> Input;
RWStructuredBuffer<int> Output;
int JadrenElementCount;

[numthreads(64, 1, 1)]
void AddOne(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x < (uint)JadrenElementCount)
    {
        Output[dispatchId.x] = Input[dispatchId.x] + 1;
    }
}
