module app_data_http_session_client_project.main

import jadren.app.data.load_exact
import jadren.app.data.save_atomic
import jadren.app.data.write_exact
import jadren.app.fs.write_text
import jadren.app.list.count
import jadren.app.list.push_text
import jadren.app.list.read_text
import jadren.app.state.clear
import jadren.app.state.get_int
import jadren.app.state.set_int
import jadren.app.table.append_row
import jadren.app.table.read_cell
import jadren.app.table.row_count
import jadren.app.table.set_cell
import jadren.network.http.request_append
import jadren.network.http.response_body_prefix
import jadren.network.http.response_status_prefix
import jadren.network.http.write_request_prefix
import jadren.network.tcp.close_socket
import jadren.network.tcp.connect_dns
import jadren.network.tcp.receive
import jadren.network.tcp.send_all_prefix
import jadren.network.tcp.set_timeout

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn request_model(
    method: String,
    target: String,
    expected_status: UInt16,
    body: read Slice<UInt8>,
    body_length: UIntSize,
    request: write Slice<UInt8>,
    response: write Slice<UInt8>,
    snapshot: write Slice<UInt8>,
    snapshot_length: write Slice<UIntSize>,
) -> Int32 {
    let request_length: UIntSize = write_request_prefix(
        method, target, "localhost", body, body_length, request
    )
    if request_length == 0usize { return 1 }
    let socket: UIntSize = connect_dns("localhost", 38161u16)
    if socket == 0usize { return 2 }
    if !set_timeout(socket, 3000u32) {
        close_socket(socket)
        return 3
    }
    if send_all_prefix(socket, request, request_length) != request_length {
        close_socket(socket)
        return 4
    }
    var chunk: [UInt8; 256] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var received: UIntSize = 0usize
    var reads: UIntSize = 0usize
    while reads < 16usize {
        if received >= 1536usize { break }
        let chunk_length: UIntSize = receive(socket, chunk)
        if chunk_length == 0usize { break }
        let appended: UIntSize = request_append(
            response, received, chunk, chunk_length
        )
        if appended == 0usize { break }
        received = appended
        reads = reads + 1usize
        if response_body_prefix(response, received, snapshot) > 0usize { break }
    }
    let closed: Bool = close_socket(socket)
    if !closed { return 5 }
    if response_status_prefix(response, received) != expected_status { return 6 }
    let body_length_read: UIntSize = response_body_prefix(response, received, snapshot)
    if body_length_read == 0usize { return 7 }
    snapshot_length[0] = body_length_read
    return 0
}

fn verify_server_model(
    snapshot: read Slice<UInt8>, snapshot_length: UIntSize, expected_selected: Int64
) -> Int32 {
    if !load_exact(snapshot, snapshot_length) { return 1 }
    if get_int("selected") != expected_selected { return 2 }
    if count(0) != 1 { return 3 }
    if row_count(0) != 1 { return 4 }
    var item: [UInt8; 32] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if read_text(0, 0, item) != 11usize { return 5 }
    if item[0] != 82u8 { return 6 }
    var cell: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if read_cell(0, 0, 0, cell) != 6usize { return 7 }
    if cell[0] != 82u8 { return 8 }
    return 0
}

