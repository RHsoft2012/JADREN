module examples.stdlib_buffer_owning_enum_generic_record

// Generic C-layout records must keep their instantiated owning Buffer field
// offsets when used as an inline named-enum payload.
@repr(C)
struct Frame<T> {
    payload: T,
    marker: Int32
}

@repr(C)
enum Event {
    Idle,
    Frame(Frame<Buffer<Int32>>),
    Done
}

fn main() -> Int32 {
    let events_created: Result<Buffer<Event>, Int32> = buffer_create(0usize)
    let payload_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match events_created {
        Ok(events) => {
            match payload_created {
                Ok(payload) => {
                    if !buffer_append(payload, 99) { result_code = 1 }
                    let item: Frame<Buffer<Int32>> = Frame { payload: payload, marker: 7 }
                    if !buffer_append(events, Event.Frame(item)) { result_code = 2 }
                    if buffer_length(events) != 1usize { result_code = 3 }
                    if !buffer_remove_drop(events, 0usize) { result_code = 4 }
                    if !buffer_clear_move(events) { result_code = 5 }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
