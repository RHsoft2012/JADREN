module examples.if_local_nested_branch_lists

fn main() -> Int32 {
    var value: Int32 = 10
    if value < 11 {
        if value < 12 {
            value = value + 1
            value = value + 2
        } else {
            value = value + 3
            value = value + 4
        }
    } else {
        value = value + 5
        value = value + 6
    }
    value = value + 4
    value = value + 5
    return value
}
