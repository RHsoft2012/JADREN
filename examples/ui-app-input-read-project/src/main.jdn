module ui_app_input_read_project.main

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    app_state_clear()
    let root: Int32 = ui_app_begin("Retained input read",
    560,
    280,
    0xF6F8FCu32)
    if root == 0 { return 1 }
    let panel: Int32 = ui_app_panel(root,
    500,
    200,
    0xFFFFFFu32,
    12,
    12,
    8,
    0,
    1)
    if panel == 0 { return 2 }
    let input: Int32 = ui_app_text_input(panel,
    "Hello",
    41,
    320,
    38,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    if input == 0 { return 3 }
    if ui_app_input_length(input) != 5usize { return 4 }

    var output: [UInt8; 16] = [90u8, 90u8, 90u8, 90u8,
        90u8, 90u8, 90u8, 90u8, 90u8, 90u8, 90u8, 90u8,
        90u8, 90u8, 90u8, 90u8]
    var length: [UIntSize; 1] = [77usize]
    if ui_app_input_read(input, output) != 5usize { return 5 }
    if output[0] != 72u8 { return 6 }
    if output[4] != 111u8 { return 6 }

    output[0] = 91u8
    length[0] = 78usize
    if !ui_app_input_read_exact(input, output, length) { return 7 }
    if length[0] != 5usize { return 8 }
    if output[0] != 72u8 { return 9 }
    if output[4] != 111u8 { return 9 }

    output[0] = 92u8
    length[0] = 79usize
    let stale: UInt64 = app_data_revision()
    if !app_state_set_int("probe", 1 as Int64) { return 10 }
    if ui_app_input_read_exact_if_revision(input,
    output,
    length,
    stale) { return 11 }
    if output[0] != 92u8 { return 12 }
    if length[0] != 79usize { return 12 }

    let current: UInt64 = app_data_revision()
    if !ui_app_input_read_exact_if_revision(input,
    output,
    length,
    current) { return 13 }
    if length[0] != 5usize { return 14 }
    if output[0] != 72u8 { return 14 }
    if output[4] != 111u8 { return 14 }

    var short_output: [UInt8; 1] = [93u8]
    var short_length: [UIntSize; 1] = [80usize]
    if ui_app_input_read_exact_if_revision(input,
    short_output,
    short_length,
    app_data_revision()) { return 15 }
    if short_output[0] != 93u8 { return 16 }
    if short_length[0] != 80usize { return 16 }

    output[0] = 94u8
    length[0] = 81usize
    if ui_app_input_read_exact_if_revision(999,
    output,
    length,
    app_data_revision()) { return 17 }
    if output[0] != 94u8 { return 18 }
    if length[0] != 81usize { return 18 }

    if !ui_app_end(panel) { return 19 }
    if !ui_app_end(root) { return 20 }
    app_state_clear()
    return 0
}
