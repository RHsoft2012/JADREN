module examples.stdlib_buffer_nested_owning_record_nested_enum

// The final leaf of a nested Buffer chain is a record whose enum field carries
// another named enum and an owning Buffer. The recursive field table must walk
// the descriptor chain before selecting the outer/inner enum path.
@repr(C)
enum Inner {
    Empty,
    Values(Buffer<Int32>),
    Done
}

@repr(C)
enum Outer {
    Idle,
    Nested(Inner),
    Done
}

@repr(C)
struct Entry {
    id: Int32,
    payload: Outer
}

fn main() -> Int32 {
    let outer_created: Result<Buffer<Buffer<Entry>>, Int32> = buffer_create(0usize)
    let first_entries_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    let second_entries_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    let first_values_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let second_values_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match first_entries_created {
                Ok(first_entries) => {
                    match second_entries_created {
                        Ok(second_entries) => {
                            match first_values_created {
                                Ok(first_values) => {
                                    match second_values_created {
                                        Ok(second_values) => {
                                            if !buffer_append(first_values, 11) { result_code = 1 }
                                            if !buffer_append(second_values, 22) { result_code = 2 }
                                            let first_inner: Inner = Inner.Values(first_values)
                                            let second_inner: Inner = Inner.Values(second_values)
                                            let first_item: Entry = Entry { id: 1, payload: Outer.Nested(first_inner) }
                                            let second_item: Entry = Entry { id: 2, payload: Outer.Nested(second_inner) }
                                            if !buffer_append(first_entries, first_item) { result_code = 3 }
                                            if !buffer_append(second_entries, second_item) { result_code = 4 }
                                            if !buffer_append(outer, first_entries) { result_code = 5 }
                                            if !buffer_append(outer, second_entries) { result_code = 6 }
                                            if buffer_length(outer) != 2usize { result_code = 7 }
                                            if !buffer_remove_drop(outer, 0usize) { result_code = 8 }
                                            if buffer_length(outer) != 1usize { result_code = 9 }
                                            let clear_status: Int32 = buffer_clear_move_status(outer)
                                            if clear_status != 0 { result_code = clear_status }
                                            if buffer_length(outer) != 0usize { result_code = 10 }
                                        }
                                        Error(status) => { result_code = status }
                                    }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
