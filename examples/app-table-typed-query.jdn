module examples.app_table_typed_query

// Pri typed tabuľke hľadaj hodnoty priamo podľa ich typu.
// Query vracia prvý riadok od start_row alebo -1.
fn main() -> Int32 {
    app_table_clear(0)
    if !app_table_set_column_type(0, 0, 1) { return 1 } // int
    if !app_table_set_column_type(0, 1, 2) { return 2 } // uint
    if !app_table_set_column_type(0, 2, 4) { return 3 } // float
    if !app_table_set_column_type(0, 3, 3) { return 4 } // bool
    if !app_table_set_column_name(0, 0, "task_id") { return 5 }

    if !app_table_append_row(0) { return 6 }
    if !app_table_set_int(0, 0, 0, 42 as Int64) { return 7 }
    if !app_table_set_uint(0, 0, 1, 7u64) { return 8 }
    if !app_table_set_float(0, 0, 2, 1.25f64) { return 9 }
    if !app_table_set_bool(0, 0, 3, false) { return 10 }

    if !app_table_append_row(0) { return 11 }
    if !app_table_set_int(0, 1, 0, 99 as Int64) { return 12 }
    if !app_table_set_uint(0, 1, 1, 7u64) { return 13 }
    if !app_table_set_float(0, 1, 2, 2.5f64) { return 14 }
    if !app_table_set_bool(0, 1, 3, true) { return 15 }

    if app_table_find_int(0, 0, 42 as Int64, 0) != 0 { return 16 }
    if app_table_find_int(0, 0, 42 as Int64, 1) != -1 { return 17 }
    if app_table_find_uint(0, 1, 7u64, 0) != 0 { return 18 }
    if app_table_find_uint(0, 1, 7u64, 1) != 1 { return 19 }
    if app_table_find_float(0, 2, 2.5f64, 0) != 1 { return 20 }
    if app_table_find_bool(0, 3, true, 0) != 1 { return 21 }

    // Nesúlad typu a prázdna bunka nie sú zhodou.
    if app_table_find_int(0, 1, 7 as Int64, 0) != -1 { return 22 }
    if app_table_find_bool(0, 3, false, 2) != -1 { return 23 }

    app_table_clear(0)
    return 0
}
