module examples.windows_desktop_input_commit_if_revision

// A native control is an event source, not an unconditional writer.  Each
// commit below requires the revision captured before the event was handled;
// stale events must leave the newer model value untouched.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    app_state_clear()
    if !app_state_set_text("note", "Model") { return 1 }
    if !app_state_set_bool("enabled", true) { return 2 }
    if !app_state_set_int("choice", 1 as Int64) { return 3 }
    if !app_state_set_int("list_choice", 1 as Int64) { return 4 }
    if !app_state_set_int("table_choice", 0 as Int64) { return 5 }

    let root: Int32 = ui_app_begin("Guarded commits", 760, 520, 0xF6F8FCu32)
    if root == 0 { return 6 }
    let panel: Int32 = ui_app_panel(root, 680, 420, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 7 }
    let input: Int32 = ui_app_text_input(panel, "Draft", 10, 300, 36,
        0x111827u32, 0xFFFFFFu32, 8, 1)
    let checkbox: Int32 = ui_app_checkbox(panel, "Enabled", 20, 300, 36,
        0x111827u32, 0x168EF5u32, 8, 0, 1)
    let select: Int32 = ui_app_select(panel, 30, 300, 36,
        0x111827u32, 0xFFFFFFu32, 8, 1)
    if !ui_app_select_option(select, "First") { return 8 }
    if !ui_app_select_option(select, "Second") { return 9 }
    let list: Int32 = ui_app_list(panel, 40, 300, 90,
        0x111827u32, 0xFFFFFFu32, 8, 1)
    if !ui_app_list_item(list, "First") { return 10 }
    if !ui_app_list_item(list, "Second") { return 11 }
    let table: Int32 = ui_app_table(panel, 50, 500, 120,
        0x111827u32, 0xFFFFFFu32, 8, 1)
    if !ui_app_table_column(table, 0, "Name", 300) { return 12 }
    if !ui_app_table_cell(table, 0, 0, "First") { return 13 }
    if !ui_app_table_cell(table, 1, 0, "Second") { return 14 }
    if !ui_app_bind_app_state_exact(input, "note") { return 15 }
    if !ui_app_bind_app_state_exact(checkbox, "enabled") { return 16 }
    if !ui_app_bind_app_state_exact(select, "choice") { return 17 }
    if !ui_app_bind_app_state_exact(list, "list_choice") { return 18 }
    if !ui_app_bind_app_state_exact(table, "table_choice") { return 19 }
    if !ui_app_end(panel) { return 20 }
    if !ui_app_end(root) { return 21 }

    // Text: reject an event whose snapshot is stale, then commit the same
    // control against the current revision.
    ui_set_input_text(10, "Draft")
    let stale_text: UInt64 = app_data_revision()
    if !app_state_set_text("note", "Newer") { return 22 }
    let before_text_reject: UInt64 = app_data_revision()
    if ui_input_commit_app_state_if_revision(10, stale_text) { return 23 }
    if app_data_revision() != before_text_reject { return 24 }
    var text_output: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var text_length: [UIntSize; 1] = [0usize]
    if !app_state_read_text_exact("note", text_output, text_length) { return 25 }
    if text_length[0] != 5usize { return 26 }
    if text_output[0] != 78u8 { return 26 }
    if !ui_input_commit_app_state_if_revision(10, app_data_revision()) { return 27 }
    if !app_state_read_text_exact("note", text_output, text_length) { return 28 }
    if text_length[0] != 5usize { return 29 }
    if text_output[0] != 68u8 { return 29 }

    // Checkbox, select, list and table use the same guarded model setter.
    ui_set_checked(20, 1)
    let stale_checkbox: UInt64 = app_data_revision()
    if !app_state_set_bool("enabled", false) { return 30 }
    if ui_checkbox_commit_app_state_if_revision(20, stale_checkbox) { return 31 }
    if !ui_checkbox_commit_app_state_if_revision(20, app_data_revision()) { return 32 }
    if !app_state_get_bool("enabled") { return 33 }

    ui_select_set_index(30, 0)
    let stale_select: UInt64 = app_data_revision()
    if !app_state_set_int("choice", 1 as Int64) { return 34 }
    if ui_select_commit_app_state_if_revision(30, stale_select) { return 35 }
    if !ui_select_commit_app_state_if_revision(30, app_data_revision()) { return 36 }
    if app_state_get_int("choice") != 0 as Int64 { return 37 }

    ui_list_set_index(40, 0)
    let stale_list: UInt64 = app_data_revision()
    if !app_state_set_int("list_choice", 1 as Int64) { return 38 }
    if ui_list_commit_app_state_if_revision(40, stale_list) { return 39 }
    if !ui_list_commit_app_state_if_revision(40, app_data_revision()) { return 40 }
    if app_state_get_int("list_choice") != 0 as Int64 { return 41 }

    ui_table_set_selected_row(50, 1)
    let stale_table: UInt64 = app_data_revision()
    if !app_state_set_int("table_choice", 0 as Int64) { return 42 }
    if ui_table_commit_app_state_if_revision(50, stale_table) { return 43 }
    if !ui_table_commit_app_state_if_revision(50, app_data_revision()) { return 44 }
    if app_state_get_int("table_choice") != 1 as Int64 { return 45 }

    if ui_input_commit_app_state_if_revision(99, app_data_revision()) { return 46 }
    app_state_clear()
    return 0
}
