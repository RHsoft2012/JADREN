module examples.app_data_durable_retry_if_revision

// The stale mode proves the revision guard returns before lock acquisition or
// file mutation. The timeout mode proves lock exhaustion rolls the transaction
// back, while the default mode waits for the holder and reloads the commit.
fn selected_mode() -> Int32 {
    if process_arg_count() != 2usize { return 0 }
    var argument: [UInt8; 9] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let length: UIntSize = process_arg_read(1usize, argument)
    if length == 6usize {
        if argument[0usize] != 45u8 { return 0 }
        if argument[1usize] != 45u8 { return 0 }
        if argument[2usize] != 104u8 { return 0 }
        if argument[3usize] != 111u8 { return 0 }
        if argument[4usize] != 108u8 { return 0 }
        if argument[5usize] == 100u8 { return 1 }
    }
    if length == 7usize {
        if argument[0usize] != 45u8 { return 0 }
        if argument[1usize] != 45u8 { return 0 }
        if argument[2usize] != 115u8 { return 0 }
        if argument[3usize] != 116u8 { return 0 }
        if argument[4usize] != 97u8 { return 0 }
        if argument[5usize] != 108u8 { return 0 }
        if argument[6usize] == 101u8 { return 2 }
    }
    if length == 9usize {
        if argument[0usize] != 45u8 { return 0 }
        if argument[1usize] != 45u8 { return 0 }
        if argument[2usize] != 116u8 { return 0 }
        if argument[3usize] != 105u8 { return 0 }
        if argument[4usize] != 109u8 { return 0 }
        if argument[5usize] != 101u8 { return 0 }
        if argument[6usize] != 111u8 { return 0 }
        if argument[7usize] != 117u8 { return 0 }
        if argument[8usize] == 116u8 { return 3 }
    }
    return 0
}

fn initialize_transaction() -> Bool {
    app_state_clear()
    if !app_state_set_text("theme", "dark") { return false }
    if !app_data_tx_begin() { return false }
    return app_state_set_text("theme", "light")
}

fn state_is_dark() -> Bool {
    var output: [UInt8; 4] = [0u8, 0u8, 0u8, 0u8]
    let length: UIntSize = app_state_read_text("theme", output)
    if length != 4usize { return false }
    if output[0usize] != 100u8 { return false }
    if output[1usize] != 97u8 { return false }
    if output[2usize] != 114u8 { return false }
    if output[3usize] != 107u8 { return false }
    return true
}

fn state_is_light() -> Bool {
    var output: [UInt8; 5] = [0u8, 0u8, 0u8, 0u8, 0u8]
    let length: UIntSize = app_state_read_text("theme", output)
    if length != 5usize { return false }
    if output[0usize] != 108u8 { return false }
    if output[1usize] != 105u8 { return false }
    if output[2usize] != 103u8 { return false }
    if output[3usize] != 104u8 { return false }
    if output[4usize] != 116u8 { return false }
    return true
}

fn main() -> Int32 {
    let mode: Int32 = selected_mode()
    if mode == 1 {
        let token: UIntSize = file_lock("target/app-data-durable-retry-if-revision.lock")
        if token == 0usize { return 10 }
        if file_write_text("target/app-data-durable-retry-if-revision.ready", "ready") != 5usize {
            file_unlock(token)
            return 11
        }
        let started: UInt64 = time_now_monotonic_ms()
        while time_now_monotonic_ms() < started + 1200u64 { }
        if !file_unlock(token) { return 12 }
        return 0
    }

    if mode == 2 {
        if !initialize_transaction() { return 20 }
        let expected_revision: UInt64 = app_data_revision()
        if !app_state_set_text("revision_probe", "changed") { return 21 }
        if app_data_tx_commit_durable_retry_if_revision(
            "target/app-data-durable-retry-if-revision.tmp",
            "target/app-data-durable-retry-if-revision.data",
            "target/app-data-durable-retry-if-revision.lock",
            expected_revision,
            3usize,
            50usize
        ) { return 22 }
        if file_exists("target/app-data-durable-retry-if-revision.data") { return 23 }
        if !app_data_tx_rollback() { return 24 }
        if !state_is_dark() { return 25 }
        return 0
    }

    if mode == 3 {
        if !initialize_transaction() { return 30 }
        let expected_revision: UInt64 = app_data_revision()
        let started: UInt64 = time_now_monotonic_ms()
        if app_data_tx_commit_durable_retry_if_revision(
            "target/app-data-durable-retry-if-revision.tmp",
            "target/app-data-durable-retry-if-revision.data",
            "target/app-data-durable-retry-if-revision.lock",
            expected_revision,
            3usize,
            50usize
        ) { return 31 }
        let elapsed: UInt64 = time_now_monotonic_ms() - started
        if elapsed < 80u64 { return 32 }
        if !state_is_dark() { return 33 }
        return 0
    }

    if !initialize_transaction() { return 40 }
    let expected_revision: UInt64 = app_data_revision()
    if !app_data_tx_commit_durable_retry_if_revision(
        "target/app-data-durable-retry-if-revision.tmp",
        "target/app-data-durable-retry-if-revision.data",
        "target/app-data-durable-retry-if-revision.lock",
        expected_revision,
        50usize,
        50usize
    ) { return 41 }
    if !app_state_set_text("theme", "mutated") { return 42 }
    if !app_data_load("target/app-data-durable-retry-if-revision.data") { return 43 }
    if !state_is_light() { return 44 }
    return 0
}
