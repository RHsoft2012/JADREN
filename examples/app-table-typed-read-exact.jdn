module examples.app_table_typed_read_exact

// Presné typed reads odlišia platnú nulu/false od chyby bez sentinelov.
fn main() -> Int32 {
    app_table_clear(0)
    if !app_table_set_column_type(0, 0, 1) { return 1 }
    if !app_table_set_column_type(0, 1, 2) { return 2 }
    if !app_table_set_column_type(0, 2, 4) { return 3 }
    if !app_table_set_column_type(0, 3, 3) { return 4 }
    if !app_table_set_column_name(0, 0, "id") { return 5 }
    if !app_table_set_column_name(0, 1, "total") { return 6 }
    if !app_table_set_column_name(0, 2, "rate") { return 7 }
    if !app_table_set_column_name(0, 3, "done") { return 8 }
    if !app_table_append_row(0) { return 9 }
    if !app_table_set_int(0, 0, 0, -7 as Int64) { return 10 }
    if !app_table_set_uint(0, 0, 1, 0u64) { return 11 }
    if !app_table_set_float(0, 0, 2, 1.5f64) { return 12 }
    if !app_table_set_bool(0, 0, 3, false) { return 13 }

    var signed: [Int64; 1] = [99 as Int64]
    var unsigned: [UInt64; 1] = [99u64]
    var decimal: [Float64; 1] = [99.0f64]
    var flag: [Bool; 1] = [true]
    if !app_table_read_int_exact(0, 0, 0, signed) { return 14 }
    if !app_table_read_uint_exact(0, 0, 1, unsigned) { return 15 }
    if !app_table_read_float_exact(0, 0, 2, decimal) { return 16 }
    if !app_table_read_bool_exact(0, 0, 3, flag) { return 17 }
    if signed[0] != -7 as Int64 { return 18 }
    if unsigned[0] != 0u64 { return 18 }
    if decimal[0] != 1.5f64 { return 18 }
    if flag[0] { return 18 }

    if !app_table_read_named_int_exact(0, 0, "id", signed) { return 19 }
    if !app_table_read_named_uint_exact(0, 0, "total", unsigned) { return 20 }
    if !app_table_read_named_float_exact(0, 0, "rate", decimal) { return 21 }
    if !app_table_read_named_bool_exact(0, 0, "done", flag) { return 22 }
    if signed[0] != -7 as Int64 { return 23 }
    if unsigned[0] != 0u64 { return 23 }
    if decimal[0] != 1.5f64 { return 23 }
    if flag[0] { return 23 }

    if app_table_read_int_exact(0, 0, 1, signed) { return 24 }
    if signed[0] != -7 as Int64 { return 25 }
    if app_table_read_named_bool_exact(0, 0, "missing", flag) { return 26 }
    if flag[0] { return 27 }
    app_table_clear(0)
    return 0
}
