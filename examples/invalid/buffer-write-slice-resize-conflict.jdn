module invalid.buffer_write_slice_resize_conflict

fn main() -> Int32 {
    let created: Result<Buffer<UInt8>, Int32> = buffer_create(2usize)
    var status: Int32 = 0
    match created {
        Ok(values) => {
            if !buffer_resize(values, 2usize) { status = 1 }
            let view: write Slice<UInt8> = buffer_slice_write(values, 0usize, 2usize)
            view[0usize] = 7u8
            if buffer_resize(values, 0usize) { status = view[1usize] as Int32 }
        }
        Error(error) => { status = error }
    }
    return status
}
