module generic_buffer_equatable_map.main

import jadren.core.collections.map_in_place

fn keep_owned(value: OwnedString) -> OwnedString {
    return value
}

fn main() -> Int32 {
    let created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0
    match created {
        Ok(values) => {
            if map_in_place(values, keep_owned) { result_code = 1 }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
