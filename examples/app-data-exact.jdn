    ]
        var snapshot_length: [UIntSize; 1] = [777usize]
        if !app_data_write_exact(snapshot, snapshot_length) { return 8 }
        if snapshot_length[0] < 20usize { return 9 }
        if snapshot[0] != 74u8 { return 10 }
        if snapshot[1] != 65u8 { return 10 }

        // Clear the live model and restore it from memory without a file.
        app_state_clear()
        app_list_clear(0)
        app_table_clear(0)
        if !app_data_load_exact(snapshot, snapshot_length[0]) { return 11 }
        if app_state_get_int("selected") != 7 as Int64 { return 12 }
        if app_list_count(0) != 2 { return 13 }
        if app_table_row_count(0) != 1 { return 14 }

        var cell: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
        if app_table_read_cell(0, 0, 0, cell) != 5usize { return 15 }
        if cell[0] != 66u8 { return 16 }

        // A truncated prefix is rejected atomically and cannot erase state.
        if app_data_load_exact(snapshot, snapshot_length[0] - 1usize) { return 17 }
        if app_state_get_int("selected") != 7 as Int64 { return 18 }
        if app_list_count(0) != 2 { return 19 }
        if app_table_row_count(0) != 1 { return 20 }
    return 0
