    app_state_clear()
    app_list_clear(0)
    app_table_clear(0)

    if !app_state_set_int("selected", 7 as Int64) { return 1 }
    if !app_state_set_text("mode", "focus") { return 2 }
    if !app_list_push_text(0, "First task") { return 3 }
    if !app_list_push_text(0, "Second task") { return 4 }
    if !app_table_append_row(0) { return 5 }
    if !app_table_set_cell(0, 0, 0, "Build") { return 6 }
    if !app_table_set_cell(0, 0, 1, "Open") { return 7 }

