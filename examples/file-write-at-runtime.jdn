module examples.file_write_at_runtime;

// file_write_at updates a caller-owned chunk in place without truncating the
// file. An offset beyond EOF extends the file using native filesystem semantics.
fn main() -> Int32 {
    file_delete("target/jadren/file-write-at.txt")
    if !directory_create("target/jadren") { return 10 }
    if file_write_text("target/jadren/file-write-at.txt", "abcdef") != 6usize { return 11 }

    var patch: [UInt8; 2] = [88u8, 89u8]
    if file_write_at("target/jadren/file-write-at.txt", 2usize, patch) != 2usize { return 12 }

    var output: [UInt8; 6] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let loaded: UIntSize = file_read_at("target/jadren/file-write-at.txt", 0usize, output)
    if loaded != 6usize { return 13 }
    if output[0] != 97u8 { return 14 }
    if output[1] != 98u8 { return 15 }
    if output[2] != 88u8 { return 16 }
    if output[3] != 89u8 { return 17 }
    if output[4] != 101u8 { return 18 }
    if output[5] != 102u8 { return 19 }

    var tail: [UInt8; 1] = [90u8]
    if file_write_at("target/jadren/file-write-at.txt", 10usize, tail) != 1usize { return 20 }
    if file_size("target/jadren/file-write-at.txt") != 11usize { return 21 }
    var final_byte: [UInt8; 1] = [0u8]
    if file_read_at("target/jadren/file-write-at.txt", 10usize, final_byte) != 1usize { return 22 }
    if final_byte[0] != 90u8 { return 23 }

    if !file_delete("target/jadren/file-write-at.txt") { return 24 }
    return 0
}
