// A one-byte durable marker is published only after both model files in the
// selected slot have been promoted. The previous marker therefore remains a
// complete recovery point if the process stops between either file write.
fn read_commit_slot(output: write Slice<UInt8>) -> Bool {
    var marker:[UInt8;
    1] =[0u8]
    var marker_length:[UIntSize;
    1] =[0usize]
    if ! read_bytes_exact("target/jadren/time-tracker-pro-project.commit",
    marker,
    marker_length) {
        return false
    }
    if marker_length[0] != 1usize {
        return false
    }
    if marker[0] != 65u8 {
        if marker[0] != 66u8 {
            return false
        }
    }
    output[0] = marker[0]
    return true
}
fn save_slot_a() -> Bool {
    if ! app_data_save("target/jadren/time-tracker-pro-project.slot-a.data.tmp") {
        return false
    }
    if ! save_scheduler_temporary("target/jadren/time-tracker-pro-project.slot-a.scheduler.tmp") {
        return false
    }
    return commit_two_slot("target/jadren/time-tracker-pro-project.slot-a.data.tmp",
    "target/jadren/time-tracker-pro-project.slot-a.data",
    "target/jadren/time-tracker-pro-project.slot-a.scheduler.tmp",
    "target/jadren/time-tracker-pro-project.slot-a.scheduler.jds",
    "target/jadren/time-tracker-pro-project.commit.tmp",
    "target/jadren/time-tracker-pro-project.commit",
    "target/jadren",
    65u8)
}
fn save_slot_b() -> Bool {
    if ! app_data_save("target/jadren/time-tracker-pro-project.slot-b.data.tmp") {
        return false
    }
    if ! save_scheduler_temporary("target/jadren/time-tracker-pro-project.slot-b.scheduler.tmp") {
        return false
    }
    return commit_two_slot("target/jadren/time-tracker-pro-project.slot-b.data.tmp",
    "target/jadren/time-tracker-pro-project.slot-b.data",
    "target/jadren/time-tracker-pro-project.slot-b.scheduler.tmp",
    "target/jadren/time-tracker-pro-project.slot-b.scheduler.jds",
    "target/jadren/time-tracker-pro-project.commit.tmp",
    "target/jadren/time-tracker-pro-project.commit",
    "target/jadren",
    66u8)
}
fn load_slot_a() -> Bool {
    if ! app_data_load("target/jadren/time-tracker-pro-project.slot-a.data") {
        return false
    }
    return load_scheduler("target/jadren/time-tracker-pro-project.slot-a.scheduler.jds")
}
fn load_slot_b() -> Bool {
    if ! app_data_load("target/jadren/time-tracker-pro-project.slot-b.data") {
        return false
    }
    return load_scheduler("target/jadren/time-tracker-pro-project.slot-b.scheduler.jds")
}
fn load_legacy() -> Bool {
    if ! app_data_load("target/jadren/time-tracker-pro-project.data") {
        return false
    }
    return load_scheduler("target/jadren/time-tracker-pro-project.scheduler.jds")
}
pub fn save() -> Bool {
    var current:[UInt8;
    1] =[0u8]
    if exists("target/jadren/time-tracker-pro-project.commit") {
        if ! read_commit_slot(current) {
            return false
        }
        if current[0] == 65u8 {
            return save_slot_b()
        }
        if current[0] == 66u8 {
            return save_slot_a()
        }
        return false
    }
    if ! save_slot_a() {
        return false
    }
    return true
}
pub fn load() -> Bool {
    var current:[UInt8;
    1] =[0u8]
    if exists("target/jadren/time-tracker-pro-project.commit") {
        if ! read_commit_slot(current) {
            return false
        }
        if current[0] == 65u8 {
            return load_slot_a()
        }
        if current[0] == 66u8 {
            return load_slot_b()
        }
        return false
    }
    return load_legacy()
}
