module time_tracker_project.main
import jadren.app.fs.append_text
import jadren.app.fs.size
import jadren.app.fs.write_text
import jadren.app.list.count
import jadren.app.state.get_int
import jadren.app.table.read_cell
import jadren.app.ui.run
import jadren.core.process.arg_count
import jadren.core.process.arg_read
import time_tracker_project.model.bootstrap
import time_tracker_project.model.checkpoint
import time_tracker_project.model.row_count
import time_tracker_project.view.build
import time_tracker_project.view.dispatch_test
import time_tracker_project.storage.export_csv
import time_tracker_project.storage.smoke_file_backed_model_roundtrip
import time_tracker_project.network.sync_selected
fn smoke_mode() -> Bool {
    let count: UIntSize = arg_count()
    if count<2usize {
        return false
    }
    var flag:[UInt8;
    7] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let length: UIntSize = arg_read(1usize,
    flag)
    if length != 7usize {
        return false
    }
    if flag[0] != 45u8 {
        return false
    }
    if flag[1] != 45u8 {
        return false
    }
    if flag[2] != 115u8 {
        return false
    }
    if flag[3] != 109u8 {
        return false
    }
    if flag[4] != 111u8 {
        return false
    }
    if flag[5] != 107u8 {
        return false
    }
    if flag[6] != 101u8 {
        return false
    }
    return true
}
fn main() -> Int32 {
    let smoke: Bool = smoke_mode()
    if ! bootstrap() {
        return 1
    }
    if ! smoke_file_backed_model_roundtrip() {
        return 20
    }
    if row_count() != 2 as Int32 {
        return 2
    }
    if ! build() {
        return 3
    }
    if ! smoke {
        return run()
    }
    let restarted: Bool = get_int("controller_events")>0 as Int64
    if restarted {
        if sync_selected() != 200 {
            return 4
        }
    } else {
        if ! dispatch_test() {
            return 4
        }
    }
    if get_int("selected_task_id") != 1 as Int64 {
        return 5
    }
    if get_int("selected_row") != 0 as Int64 {
        return 6
    }
    if get_int("selected_list_index") != 1 as Int64 {
        return 7
    }
    if get_int("controller_events") != 1 as Int64 {
        return 8
    }
    if get_int("network_status") != 200 as Int64 {
        return 9
    }
    if get_int("list_events") != 1 as Int64 {
        return 10
    }
    if count(0) != 3 {
        return 11
    }
    var status:[UInt8;
    8] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let status_length: UIntSize = read_cell(0,
    0,
    2,
    status)
    if status_length != 4usize {
        return 12
    }
    if status[0] != 68u8 {
        return 13
    }
    if ! checkpoint() {
        return 14
    }
    if ! export_csv() {
        return 15
    }
    if size("target/jadren/time-tracker-pro-project.csv") == 0usize {
        return 16
    }
    if size("target/jadren/time-tracker-pro-project-list.csv") == 0usize {
        return 17
    }
    // Windows GUI subsystem entry points do not propagate an Int32 return
    // value as a process exit code.  Persist a sentinel after every module
    // completed so the package smoke can verify the result without relying on
    // the GUI process code.
    let written: UIntSize = write_text("target/jadren/time-tracker-pro-project.result",
    "multi-file-ok:42 controller-event:1 status:Done network:200 list:3 scheduler:2 input-bound export:csv restart:"
    )
    if written == 0usize {
        return 18
    }
    if restarted {
        if append_text("target/jadren/time-tracker-pro-project.result",
        "1\n") == 0usize {
            return 19
        }
    } else {
        if append_text("target/jadren/time-tracker-pro-project.result",
        "0\n") == 0usize {
            return 19
        }
    }
    return 0
}
