module time_tracker_project.controller

import jadren.app.event.AppEvent
import jadren.app.event.click
import jadren.app.event.is_click
import jadren.app.event.is_list_changed
import jadren.app.event.is_table_changed
import jadren.app.event.list_changed
import jadren.app.event.list_index_value
import jadren.app.event.table_changed
import jadren.app.event.table_row_value
import jadren.app.event.unknown
import jadren.app.input.read_text
import jadren.app.input.refresh_all
import jadren.app.input.list_index
import jadren.app.input.table_selected_row
import jadren.app.list.push_bytes
import jadren.app.state.get_int
import jadren.app.state.set_int
import jadren.app.table.find_int
import jadren.app.table.read_int
import jadren.app.table.set_named_cell
import jadren.app.ui.commit_state_if_revision
import time_tracker_project.network.sync_selected
import time_tracker_project.storage.save

// Controller owns event decisions.  It receives only the numeric event ID
// from the view callback, converts it to a typed AppEvent, and mutates the
// model through its public runtime API.
fn event_from_id(event_id: Int32) -> AppEvent {
    if event_id == 41 {
        return table_changed(event_id, table_selected_row(41))
    }
    if event_id == 44 {
        return list_changed(event_id, list_index(44))
    }
    if event_id == 42 { return click(event_id) }
    if event_id == 45 { return click(event_id) }
    return unknown(event_id)
}

pub fn handle(event_id: Int32) -> Int32 {
    // AppEvent is intentionally move-only.  Classify by the native callback
    // ID first, then consume each typed event exactly once in its branch.
    if event_id == 41 {
        let event: AppEvent = event_from_id(event_id)
        if !is_table_changed(event) { return 20 }
        let row: Int32 = table_row_value(event_from_id(event_id))
        if row < 0 { return 20 }
        let task_id: Int64 = read_int(0, row, 3)
        if task_id <= 0 as Int64 { return 21 }
        if !set_int("selected_task_id", task_id) { return 22 }
        if !set_int("selected_row", row as Int64) { return 23 }
        if !save() { return 24 }
        refresh_all()
        return 0
    }
    if event_id == 44 {
        let event: AppEvent = event_from_id(event_id)
        if !is_list_changed(event) { return 25 }
        let index: Int32 = list_index_value(event_from_id(event_id))
        if index < 0 { return 25 }
        if !set_int("selected_list_index", index as Int64) { return 26 }
        if !save() { return 27 }
        refresh_all()
        return 0
    }
    if event_id == 45 {
        let event: AppEvent = event_from_id(event_id)
        if !is_click(event) { return 8 }
        let input_node: Int64 = get_int("draft_input_node")
        if input_node <= 0 as Int64 { return 8 }
        let expected_revision: UInt64 = app_data_revision()
        if !commit_state_if_revision(input_node as Int32, expected_revision) { return 8 }
        var input: [UInt8; 64] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
        let length: UIntSize = read_text(43, input)
        if length == 0usize { return 9 }
        if !push_bytes(0, input, length) { return 10 }
        let events: Int64 = get_int("list_events") + 1 as Int64
        if !set_int("list_events", events) { return 11 }
        if !save() { return 12 }
        refresh_all()
        return 0
    }
    if event_id != 42 { return 1 }
    let event: AppEvent = event_from_id(event_id)
    if !is_click(event) { return 1 }
    let task_id: Int64 = get_int("selected_task_id")
    let row: Int32 = find_int(0, 3, task_id, 0)
    if row < 0 { return 2 }
    if !set_named_cell(0, row, "status", "Done") { return 3 }
    let count: Int64 = get_int("controller_events") + 1 as Int64
    if !set_int("controller_events", count) { return 4 }
    let network_status: Int32 = sync_selected()
    if !set_int("network_status", network_status as Int64) { return 5 }
    if network_status != 200 { return 6 }
    if !save() { return 7 }
    return 0
}
