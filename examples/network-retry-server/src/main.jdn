    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let received = receive(client,
    request)
    if received == 0usize {
        close_socket(client)
        close_socket(listener)
        return 16
    }
    if ! request_is_complete_prefix(request,
    received) {
        close_socket(client)
        close_socket(listener)
        return 17
    }
    if ! route_match_prefix(request,
    received,
    "GET",
    "/hello") {
        close_socket(client)
        close_socket(listener)
        return 18
    }
    var response:[UInt8;
    128] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
