module examples.app_table_typed_index

// Typed indexovanie zoradí row IDs podľa skutočného typu bunky.
// Textový index zostáva dostupný cez všeobecné index_build/index_find_text.
fn main() -> Int32 {
    app_table_clear(0)
    if !app_table_set_column_type(0, 0, 1) { return 1 } // int
    if !app_table_set_column_type(0, 1, 2) { return 2 } // uint
    if !app_table_set_column_type(0, 2, 4) { return 3 } // float
    if !app_table_set_column_type(0, 3, 3) { return 4 } // bool

    if !app_table_append_row(0) { return 5 }
    if !app_table_set_int(0, 0, 0, 100 as Int64) { return 6 }
    if !app_table_set_uint(0, 0, 1, 9u64) { return 7 }
    if !app_table_set_float(0, 0, 2, 2.5f64) { return 8 }
    if !app_table_set_bool(0, 0, 3, false) { return 9 }
    if !app_table_set_cell(0, 0, 4, "alpha") { return 10 }

    if !app_table_append_row(0) { return 11 }
    if !app_table_set_int(0, 1, 0, 2 as Int64) { return 12 }
    if !app_table_set_uint(0, 1, 1, 7u64) { return 13 }
    if !app_table_set_float(0, 1, 2, 1.25f64) { return 14 }
    if !app_table_set_bool(0, 1, 3, true) { return 15 }
    if !app_table_set_cell(0, 1, 4, "beta") { return 16 }

    if !app_table_append_row(0) { return 17 }
    if !app_table_set_int(0, 2, 0, 42 as Int64) { return 18 }
    if !app_table_set_uint(0, 2, 1, 7u64) { return 19 }
    if !app_table_set_float(0, 2, 2, 3.0f64) { return 20 }
    if !app_table_set_bool(0, 2, 3, false) { return 21 }
    if !app_table_set_cell(0, 2, 4, "alpha") { return 22 }

    if !app_table_index_build_int(0, 0) { return 23 }
    if !app_table_index_is_valid(0, 0) { return 24 }
    if app_table_index_find_int(0, 0, 2 as Int64) != 1 { return 25 }
    if app_table_index_find_int(0, 0, 42 as Int64) != 2 { return 26 }
    if app_table_index_find_text(0, 0, "42") != -1 { return 27 }

    if !app_table_index_build_uint(0, 1) { return 28 }
    if app_table_index_find_uint(0, 1, 7u64) != 1 { return 29 }
    if !app_table_index_build_float(0, 2) { return 30 }
    if app_table_index_find_float(0, 2, 2.5f64) != 0 { return 31 }
    if !app_table_index_build_bool(0, 3) { return 32 }
    if app_table_index_find_bool(0, 3, true) != 1 { return 33 }

    if !app_table_index_build(0, 4) { return 34 }
    if app_table_index_find_text(0, 4, "alpha") != 0 { return 35 }
    if app_table_index_find_int(0, 4, 42 as Int64) != -1 { return 36 }

    if !app_table_index_clear(0) { return 37 }
    app_table_clear(0)
    return 0
}
