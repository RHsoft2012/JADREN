    if request_length == 0usize {
        return 10
    }
    let socket_one = connect("127.0.0.1",
    38160u16)
    if socket_one == 0usize {
        return 11
    }
    let socket_two = connect("127.0.0.1",
    38160u16)
    if socket_two == 0usize {
        close_socket(socket_one)
        return 12
    }
    if ! set_timeout(socket_one,
    3000u32) {
        close_socket(socket_two)
        close_socket(socket_one)
        return 13
    }
    if ! set_timeout(socket_two,
    3000u32) {
        close_socket(socket_two)
        close_socket(socket_one)
        return 14
    }
    let slot_one = pool_acquire(handles,
    socket_one)
    if slot_one == 0usize {
        close_socket(socket_two)
        close_socket(socket_one)
        return 15
    }
    let slot_two = pool_acquire(handles,
    socket_two)
    if slot_two == 0usize {
        let released = pool_release(handles,
        slot_one)
        close_socket(released)
        close_socket(socket_two)
        return 16
    }
    let active_before = pool_active_count(handles)
    if active_before != 2usize {
        let released_two = pool_release(handles,
