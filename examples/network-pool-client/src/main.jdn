        slot_one)
        close_socket(released_two)
        close_socket(released_one)
        return 19
    }
    let sent_one = send_prefix(pooled_one,
    request,
    request_length)
    let sent_two = send_prefix(pooled_two,
    request,
    request_length)
    if sent_one != request_length {
        let released_two = pool_release(handles,
        slot_two)
        let released_one = pool_release(handles,
        slot_one)
        close_socket(released_two)
        close_socket(released_one)
        return 20
    }
    if sent_two != request_length {
        let released_two = pool_release(handles,
        slot_two)
        let released_one = pool_release(handles,
        slot_one)
        close_socket(released_two)
        close_socket(released_one)
