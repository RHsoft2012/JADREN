        "localhost",
        "localhost",
        38163u16,
        3000u32,
        2u32,
        request,
        response,
        response_length,
        body,
    )
    if status != 200 {
        return 1
    }
    if response_length[0] == 777usize {
        return 2
    }
    if file_write_text(
