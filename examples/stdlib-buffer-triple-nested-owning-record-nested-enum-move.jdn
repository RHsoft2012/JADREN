module examples.stdlib_buffer_triple_nested_owning_record_nested_enum_move

// Exercise three dynamic Buffer descriptor levels before a C-layout record
// leaf.  The leaf carries a nested named enum whose active variant owns a
// Buffer<Int32>; outer remove/insert/pop must transfer the complete chain
// exactly once and leave no stale descriptor behind.
@repr(C)
enum Inner {
    Empty,
    Values(Buffer<Int32>),
    Done
}

@repr(C)
enum Outer {
    Idle,
    Nested(Inner),
    Done
}

@repr(C)
struct Entry {
    id: Int32,
    payload: Outer
}

fn main() -> Int32 {
    let outer_created: Result<Buffer<Buffer<Buffer<Entry>>>, Int32> = buffer_create(0usize)
    let first_created: Result<Buffer<Buffer<Entry>>, Int32> = buffer_create(0usize)
    let entries_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    let values_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let moved_created: Result<Buffer<Buffer<Entry>>, Int32> = buffer_create(0usize)
    let popped_created: Result<Buffer<Buffer<Entry>>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match first_created {
                Ok(first) => {
                    match entries_created {
                        Ok(entries) => {
                            match values_created {
                                Ok(values) => {
                                    match moved_created {
                                        Ok(moved) => {
                                            match popped_created {
                                                Ok(popped) => {
                                                    if !buffer_append(values, 33) { result_code = 1 }
                                                    let item: Entry = Entry { id: 3, payload: Outer.Nested(Inner.Values(values)) }
                                                    if !buffer_append(entries, item) { result_code = 2 }
                                                    if !buffer_append(first, entries) { result_code = 3 }
                                                    if !buffer_append(outer, first) { result_code = 4 }
                                                    if buffer_length(outer) != 1usize { result_code = 5 }
                                                    if buffer_length(outer[0]) != 1usize { result_code = 6 }
                                                    if buffer_length(outer[0][0]) != 1usize { result_code = 7 }
                                                    if outer[0][0][0].id != 3 { result_code = 8 }

                                                    if !buffer_remove_move_into(outer, 0usize, moved) { result_code = 9 }
                                                    if buffer_length(outer) != 0usize { result_code = 10 }
                                                    if buffer_length(moved) != 1usize { result_code = 11 }
                                                    let inserted: Bool = buffer_insert_move_from(outer, 0usize, moved)
                                                    if !inserted { result_code = 12 }
                                                    if buffer_length(outer) != 1usize { result_code = 13 }

                                                    if !buffer_pop_move_into(outer, popped) { result_code = 14 }
                                                    if buffer_length(outer) != 0usize { result_code = 15 }
                                                    if buffer_length(popped) != 1usize { result_code = 16 }
                                                    let clear_popped: Int32 = buffer_clear_move_status(popped)
                                                    if clear_popped != 0 { result_code = 17 }
                                                    if buffer_length(popped) != 0usize { result_code = 18 }
                                                    let invalid_remove: Int32 = buffer_remove_move_into_status(outer, 0usize, popped)
                                                    if invalid_remove != -20 { result_code = 19 }
                                                    let invalid_pop: Int32 = buffer_pop_move_into_status(outer, popped)
                                                    if invalid_pop != -20 { result_code = 20 }
                                                }
                                                Error(status) => { result_code = status }
                                            }
                                        }
                                        Error(status) => { result_code = status }
                                    }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
