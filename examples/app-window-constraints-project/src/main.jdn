module app_window_constraints_project.main

import jadren.app.ui.begin
import jadren.app.ui.finish
import jadren.app.ui.window_max_height
import jadren.app.ui.window_max_width
import jadren.app.ui.window_min_height
import jadren.app.ui.window_min_width
import jadren.app.ui.window_set_constraints

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    let root: Int32 = begin("Window constraints", 720, 430, 0xF6F8FCu32)
    if root == 0 { return 1 }

    let accepted: Bool = window_set_constraints(480, 260, 1440, 900)
    if window_min_width() != 480 { return 3 }
    if window_min_height() != 260 { return 4 }
    if window_max_width() != 1440 { return 5 }
    if window_max_height() != 900 { return 6 }
    let rejected: Bool = window_set_constraints(1440, 900, 480, 260)
    if !finish(root) { return 7 }
    if !accepted { return 8 }
    if rejected { return 9 }
    if window_min_width() != 480 { return 10 }
    if window_min_height() != 260 { return 11 }
    if window_max_width() != 1440 { return 12 }
    if window_max_height() != 900 { return 13 }
    return 0
}
