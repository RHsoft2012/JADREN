module examples.stdlib_buffer_generic_record_carrier

// A generic C-layout record can carry an active owning Option payload while
// keeping an unrelated scalar field at a stable offset.
@repr(C)
struct Frame<T> {
    payload: T,
    marker: Int32
}

fn main() -> Int32 {
    let outer_created: Result<Buffer<Frame<Option<Buffer<OwnedString>>>>, Int32> = buffer_create(0usize)
    let inner_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match inner_created {
                Ok(inner) => {
                    let value: Result<OwnedString, Int32> = string_owned_from("Carrier")
                    match value {
                        Ok(text) => {
                            if !buffer_append(inner, text) { result_code = 1 }
                        }
                        Error(status) => { result_code = status }
                    }
                    let item: Frame<Option<Buffer<OwnedString>>> = Frame {
                        payload: Some(inner),
                        marker: 42
                    }
                    if !buffer_append(outer, item) { result_code = 2 }
                    if buffer_length(outer) != 1usize { result_code = 3 }

                    let output_inner_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
                    match output_inner_created {
                        Ok(output_inner) => {
                            let output: Frame<Option<Buffer<OwnedString>>> = Frame {
                                payload: Some(output_inner),
                                marker: 0
                            }
                            let move_status: Int32 = buffer_remove_move_into_status(outer, 0usize, output)
                            if move_status != 0 { result_code = move_status }
                            if output.marker != 42 { result_code = 4 }
                            match output.payload {
                                Some(payload) => {
                                    if buffer_length(payload) != 1usize { result_code = 5 }
                                    if string_owned_length(payload[0]) != 7usize { result_code = 6 }
                                    let clear_status: Int32 = buffer_clear_move_status(payload)
                                    if clear_status != 0 { result_code = clear_status }
                                }
                                None => { result_code = 7 }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                    if buffer_length(outer) != 0usize { result_code = 8 }
                    let outer_clear_status: Int32 = buffer_clear_move_status(outer)
                    if outer_clear_status != 0 { result_code = outer_clear_status }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
