module examples.stdlib_buffer_owning_path_nested_enum

@repr(C)
enum Leaf {
    Empty,
    Text(OwnedString),
    Done
}

@repr(C)
enum Level5 { Idle, Nested(Leaf), Done }
@repr(C)
enum Level4 { Idle, Nested(Level5), Done }
@repr(C)
enum Level3 { Idle, Nested(Level4), Done }
@repr(C)
enum Level2 { Idle, Nested(Level3), Done }
@repr(C)
enum Level1 { Idle, Nested(Level2), Done }
@repr(C)
enum Outer { Idle, Nested(Level1), Done }

fn mutate(values: write Buffer<Outer>, output: write Outer) {
    let leaf: Leaf = Leaf.Empty
    let level5: Level5 = Level5.Nested(leaf)
    let level4: Level4 = Level4.Nested(level5)
    let level3: Level3 = Level3.Nested(level4)
    let level2: Level2 = Level2.Nested(level3)
    let level1: Level1 = Level1.Nested(level2)
    let value: Outer = Outer.Nested(level1)
    buffer_append(values, value)
    buffer_remove_move_into(values, 0usize, output)
    buffer_resize_move(values, 1usize)
    buffer_clear_move(values)
}

fn main() -> Int32 {
    let created: Result<Buffer<Outer>, Int32> = buffer_create(0usize)
    let text_created: Result<OwnedString, Int32> = string_owned_from("path")
    var result_code: Int32 = 0
    match created {
        Ok(values) => {
            match text_created {
                Ok(text) => {
                    let leaf: Leaf = Leaf.Text(text)
                    let level5: Level5 = Level5.Nested(leaf)
                    let level4: Level4 = Level4.Nested(level5)
                    let level3: Level3 = Level3.Nested(level4)
                    let level2: Level2 = Level2.Nested(level3)
                    let level1: Level1 = Level1.Nested(level2)
                    let value: Outer = Outer.Nested(level1)
                    if !buffer_append(values, value) { result_code = 1 }
                    if buffer_length(values) != 1usize { result_code = 2 }
                    var output: Outer = Outer.Done
                    if !buffer_remove_move_into(values, 0usize, output) { result_code = 3 }
                    if buffer_length(values) != 0usize { result_code = 4 }
                    let clear_status: Int32 = buffer_clear_move_status(values)
                    if clear_status != 0 { result_code = clear_status }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
