module examples.windows_desktop_table;

// Tabuľka používa prirodzený Jadren model. Callback číta vybraný riadok a
// prepíše jeho stav bez externého GUI mosta.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 90 {
        let selected: Int32 = ui_table_selected_row(30)
        if selected >= 0 {
            ui_table_cell(30, selected, 2, "Hotovo")
            var cell_text: [UInt8; 32] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
            let copied: UIntSize = ui_table_read_cell(30, selected, 2, cell_text)
            ui_state_set(0, copied as Int32)
            ui_set_status("Vybrany riadok bol oznaceny ako hotovy.")
        } else {
            ui_set_status("Najprv vyber riadok v tabulke.")
        }
    }
    return event_id
}

fn main() -> Int32 {
    ui_window("Jadren Table Lab", 760, 500, 0xF6F8FCu32)
    ui_top_bar(48, 0x252526u32)
    ui_text("Jadren UI - natívna tabuľka", 24, 64, 700, 34, 0x111827u32, 0xFFFFFFu32, 8)

    ui_table(30, 24, 116, 680, 240, 0x111827u32, 0xFFFFFFu32)
    ui_table_column(30, 0, "Uloha", 250)
    ui_table_column(30, 1, "Cas", 120)
    ui_table_column(30, 2, "Stav", 180)
    ui_table_cell(30, 0, 0, "Navrhni UI")
    ui_table_cell(30, 0, 1, "08:30")
    ui_table_cell(30, 0, 2, "Otvorene")
    ui_table_cell(30, 1, 0, "Over build")
    ui_table_cell(30, 1, 1, "09:15")
    ui_table_cell(30, 1, 2, "Caka")
    ui_table_cell(30, 2, 0, "Spusti smoke")
    ui_table_cell(30, 2, 1, "10:00")
    ui_table_cell(30, 2, 2, "Pripravene")

    ui_status("Vyber riadok a oznac ho tlacidlom.", 24, 382, 430, 44, 0x111827u32, 0xDCFCE7u32, 12)
    ui_event_button("Oznac vybrany riadok", 90, 480, 382, 224, 42, 0xFFFFFFu32, 0x168EF5u32, 12)
    return ui_run()
}
