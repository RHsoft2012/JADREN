module generic_buffer_truncate.main

import jadren.core.collections.append
import jadren.core.collections.clear_move_status
import jadren.core.collections.length
import jadren.core.collections.truncate
import jadren.core.collections.truncate_move
import jadren.core.collections.truncate_move_status
import jadren.core.collections.truncate_status

fn main() -> Int32 {
    let numbers_created: Result<DynamicArray<Int32>, Int32> = buffer_create(0usize)
    let first_created: Result<OwnedString, Int32> = string_owned_from("first")
    let second_created: Result<OwnedString, Int32> = string_owned_from("second")
    let third_created: Result<OwnedString, Int32> = string_owned_from("third")
    var result_code: Int32 = 0

    match numbers_created {
        Ok(numbers) => {
            if !append(numbers, 10) { result_code = 1 }
            if !append(numbers, 20) { result_code = 2 }
            if !append(numbers, 30) { result_code = 3 }
            if length(numbers) != 3usize { result_code = 4 }
            if !truncate(numbers, 1usize) { result_code = 5 }
            if length(numbers) != 1usize { result_code = 6 }
            if truncate_status(numbers, 3usize) != 0 { result_code = 7 }
            if length(numbers) != 1usize { result_code = 8 }
        }
        Error(status) => { result_code = status }
    }

    let words_created: Result<DynamicArray<OwnedString>, Int32> = buffer_create(0usize)
    match words_created {
        Ok(words) => {
            match first_created {
                Ok(first) => {
                    if !append(words, first) { result_code = 10 }
                    match second_created {
                        Ok(second) => {
                            if !append(words, second) { result_code = 11 }
                            match third_created {
                                Ok(third) => {
                                    if !append(words, third) { result_code = 12 }
                                    if length(words) != 3usize { result_code = 13 }
                                    if !truncate_move(words, 1usize) { result_code = 14 }
                                    if length(words) != 1usize { result_code = 15 }
                                    if truncate_move_status(words, 4usize) != 0 { result_code = 16 }
                                    if length(words) != 1usize { result_code = 17 }
                                    if clear_move_status(words) != 0 { result_code = 18 }
                                    if length(words) != 0usize { result_code = 19 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
