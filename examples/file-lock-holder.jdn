module examples.file_lock_holder

// Holds a dedicated lock path long enough for another process to probe it.
fn main() -> Int32 {
    let token: UIntSize = file_lock("target/jadren-file-lock.lock")
    if token == 0usize { return 1 }
    if file_write_text("target/jadren-file-lock.ready", "ready") != 5usize {
        file_unlock(token)
        return 2
    }

    let started: UInt64 = time_now_monotonic_ms()
    while time_now_monotonic_ms() < started + 3000u64 { }
    if !file_unlock(token) { return 3 }
    return 0
}
