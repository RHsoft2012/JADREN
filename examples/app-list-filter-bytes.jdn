module app_list_filter_bytes.main

// Caller-owned UTF-8 input can drive a bounded list projection directly.
// The explicit length makes the valid prefix independent from the array capacity.
fn main() -> Int32 {
    app_list_clear(0)
    app_list_clear(1)

    app_list_push_text(0, "Focus")
    app_list_push_text(0, "Open")
    app_list_push_text(0, "Refocus")

    var query: [UInt8; 8] = [70u8, 79u8, 67u8, 85u8, 83u8, 0u8, 0u8, 0u8]
    app_list_push_text(1, "keep")
    let rejected: Bool = app_list_filter_text_ex_bytes(0, 1, query, 9usize, 5)
    if rejected { return 1 }
    if app_list_count(1) != 1 { return 2 }

    let filtered: Bool = app_list_filter_text_ex_bytes(0, 1, query, 5usize, 5)
    if !filtered { return 3 }
    if app_list_count(0) != 3 { return 4 }
    if app_list_count(1) != 2 { return 5 }

    app_list_clear(0)
    app_list_clear(1)
    return 0
}
