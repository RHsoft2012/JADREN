module examples.http_router_chunked

// Native router dispatch can serialize a registered route directly as a
// bounded connection-close chunked response. The fixture exercises exact,
// prefix-target and padded-request paths plus the no-partial-write boundary.
fn main() -> Int32 {
    http_router_clear()
    var body: [UInt8; 4] = [74u8, 68u8, 78u8, 33u8]
    if !http_router_add_exact("GET", "/export", 200u16, "text/plain", body, 4usize) { return 1 }

    var request: [UInt8; 24] = [
    71u8, 69u8, 84u8, 32u8, 47u8, 101u8, 120u8, 112u8, 111u8, 114u8, 116u8, 32u8,
    72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 13u8, 10u8, 0u8, 0u8
    ]
    var response: [UInt8; 106] = [
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    let full_written: UIntSize = http_router_respond_chunked(request, response)
    if full_written != 106usize { return 2 }
    if http_response_status_prefix(response, full_written) != 200u16 { return 3 }
    var decoded: [UInt8; 4] = [0u8, 0u8, 0u8, 0u8]
    var decoded_length: [UIntSize; 1] = [0usize]
    if !http_response_body_chunked_exact(response, decoded, decoded_length) { return 4 }
    if decoded_length[0] != 4usize { return 5 }
    if decoded[0] != 74u8 { return 5 }
    if decoded[3] != 33u8 { return 5 }

    let prefix_written: UIntSize = http_router_respond_chunked_prefix(request, 22usize, response)
    if prefix_written != 106usize { return 6 }
    if http_response_status_prefix(response, prefix_written) != 200u16 { return 7 }

    if !http_router_add_prefix("GET", "/api/", 200u16, "text/plain", body) { return 8 }
    var prefix_request: [UInt8; 24] = [
    71u8, 69u8, 84u8, 32u8, 47u8, 97u8, 112u8, 105u8, 47u8, 118u8, 49u8, 32u8,
    72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 13u8, 10u8, 0u8, 0u8
    ]
    let route_prefix_written: UIntSize = http_router_respond_chunked_prefix(prefix_request, 22usize, response)
    if route_prefix_written != 106usize { return 9 }
    if http_response_status_prefix(response, route_prefix_written) != 200u16 { return 10 }

    var too_small: [UInt8; 8] = [77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8]
    if http_router_respond_chunked_prefix(request, 22usize, too_small) != 0usize { return 11 }
    if too_small[0] != 77u8 { return 12 }
    return 0
}
