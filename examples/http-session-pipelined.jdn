module examples.http_session_pipelined

// The public bounded http_session API now retains unconsumed bytes after the
// first frame. Two requests can arrive in one TCP write; the next step
// processes the buffered suffix without waiting for another receive.
fn main() -> Int32 {
    let listener: UIntSize = net_tcp_listen(38146u16)
    if (listener as Int32) == 0 { return 10 }

    let session: UIntSize = http_session_open(listener, 1u32, 1024u32, 1024u32)
    if (session as Int32) == 0 {
        net_socket_close(listener)
        return 11
    }

    http_router_clear()
    var body: [UInt8; 2] = [79u8, 75u8]
    let added: Bool = http_router_add("GET", "/hello", 200u16, "text/plain", body)
    if !added {
        http_session_close(session)
        return 12
    }

    let first: UInt32 = http_session_step(session, 2000u32)
    let second: UInt32 = http_session_step(session, 2000u32)
    let closed: Bool = http_session_close(session)
    if first != 1u32 { return 13 }
    if second != 2u32 { return 14 }
    if !closed { return 15 }
    return 0
}
