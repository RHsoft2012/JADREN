module app_table_index_if_revision_project.main

import jadren.app.data.revision
import jadren.app.table.append_row
import jadren.app.table.clear
import jadren.app.table.index_build_bool
import jadren.app.table.index_build_float
import jadren.app.table.index_build_int
import jadren.app.table.index_build
import jadren.app.table.index_build_uint
import jadren.app.table.index_find_bool_if_revision
import jadren.app.table.index_find_float_if_revision
import jadren.app.table.index_find_int_if_revision
import jadren.app.table.index_find_text_if_revision
import jadren.app.table.index_find_uint_if_revision
import jadren.app.table.set_cell
import jadren.app.table.set_column_type

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    clear(0)
    if ! set_column_type(0, 0, 0) { return 1 }
    if ! set_column_type(0, 1, 1) { return 2 }
    if ! set_column_type(0, 2, 2) { return 3 }
    if ! set_column_type(0, 3, 4) { return 4 }
    if ! set_column_type(0, 4, 3) { return 5 }
    if ! append_row(0) { return 6 }
    if ! append_row(0) { return 7 }
    if ! append_row(0) { return 8 }

    if ! set_cell(0, 0, 0, "Alpha") { return 9 }
    if ! set_cell(0, 1, 0, "Bravo") { return 10 }
    if ! set_cell(0, 2, 0, "Charlie") { return 11 }
    if ! set_cell(0, 0, 1, "10") { return 12 }
    if ! set_cell(0, 1, 1, "20") { return 13 }
    if ! set_cell(0, 2, 1, "30") { return 14 }
    if ! set_cell(0, 0, 2, "100") { return 15 }
    if ! set_cell(0, 1, 2, "200") { return 16 }
    if ! set_cell(0, 2, 2, "300") { return 17 }
    if ! set_cell(0, 0, 3, "1.0") { return 18 }
    if ! set_cell(0, 1, 3, "2.0") { return 19 }
    if ! set_cell(0, 2, 3, "3.0") { return 20 }
    if ! set_cell(0, 0, 4, "false") { return 21 }
    if ! set_cell(0, 1, 4, "true") { return 22 }
    if ! set_cell(0, 2, 4, "false") { return 23 }

    if ! index_build(0, 0) { return 24 }
    let text_stale: UInt64 = revision()
    if ! set_cell(0, 0, 0, "Zulu") { return 25 }
    if index_find_text_if_revision(0, 0, "Bravo", text_stale) != -1 { return 26 }
    if ! set_cell(0, 0, 0, "Alpha") { return 27 }
    if ! index_build(0, 0) { return 28 }
    let text_current: UInt64 = revision()
    if index_find_text_if_revision(0, 0, "Bravo", text_current) != 1 { return 29 }

    if ! index_build_int(0, 1) { return 30 }
    let int_stale: UInt64 = revision()
    if ! set_cell(0, 1, 1, "25") { return 31 }
    if index_find_int_if_revision(0, 1, 20 as Int64, int_stale) != -1 { return 32 }
    if ! set_cell(0, 1, 1, "20") { return 33 }
    if ! index_build_int(0, 1) { return 34 }
    let int_current: UInt64 = revision()
    if index_find_int_if_revision(0, 1, 20 as Int64, int_current) != 1 { return 35 }

    if ! index_build_uint(0, 2) { return 36 }
    let uint_stale: UInt64 = revision()
    if ! set_cell(0, 1, 2, "250") { return 37 }
    if index_find_uint_if_revision(0, 2, 200u64, uint_stale) != -1 { return 38 }
    if ! set_cell(0, 1, 2, "200") { return 39 }
    if ! index_build_uint(0, 2) { return 40 }
    let uint_current: UInt64 = revision()
    if index_find_uint_if_revision(0, 2, 200u64, uint_current) != 1 { return 41 }

    if ! index_build_float(0, 3) { return 42 }
    let float_stale: UInt64 = revision()
    if ! set_cell(0, 1, 3, "2.5") { return 43 }
    if index_find_float_if_revision(0, 3, 2.0f64, float_stale) != -1 { return 44 }
    if ! set_cell(0, 1, 3, "2.0") { return 45 }
    if ! index_build_float(0, 3) { return 46 }
    let float_current: UInt64 = revision()
    if index_find_float_if_revision(0, 3, 2.0f64, float_current) != 1 { return 47 }

    if ! index_build_bool(0, 4) { return 48 }
    let bool_stale: UInt64 = revision()
    if ! set_cell(0, 1, 4, "false") { return 49 }
    if index_find_bool_if_revision(0, 4, true, bool_stale) != -1 { return 50 }
    if ! set_cell(0, 1, 4, "true") { return 51 }
    if ! index_build_bool(0, 4) { return 52 }
    let bool_current: UInt64 = revision()
    if index_find_bool_if_revision(0, 4, true, bool_current) != 1 { return 53 }

    return 0
}
