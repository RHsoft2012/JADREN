module examples.json_object_persistence;

// Malý lokálny aplikačný stav: zapíš JSON, načítaj bytes a obnov primitívne
// hodnoty priamo v Jadrene. Reader je zámerne bounded flat-object kontrakt.
// Desatinné čísla číta ako Float64 a neplatné/non-finite hodnoty vracajú 0.0.
fn main() -> Int32 {
    file_write_text("target/jadren/time-state.json", "{\"minutes\":42,\"rate\":1.25,\"done\":true,\"name\":\"Focus\"}")

    var input: [UInt8; 64] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let loaded: UIntSize = file_read("target/jadren/time-state.json", input)
    var text: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let minutes: Int64 = json_object_read_int(input, "minutes")
    let rate: Float64 = json_object_read_float(input, "rate")
    let done: Bool = json_object_read_bool(input, "done")
    let name_length: UIntSize = json_object_read_string(input, "name", text)
    file_delete("target/jadren/time-state.json")

    if loaded == 0usize { return 1 }
    if minutes != 42 as Int64 { return 1 }
    if rate != 1.25f64 { return 1 }
    if !done { return 1 }
    if name_length != 5usize { return 1 }
    return 0
}
