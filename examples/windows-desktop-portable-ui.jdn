module windows_desktop_portable_ui.main

// The retained ui_app_* contract exposes only stable node ids. The current
// build maps it to Win32; future platform backends can keep this source intact.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 1 {
        ui_set_status("Portable UI event received.")
    }
    return event_id
}

fn main() -> Int32 {
    let root: Int32 = ui_app_begin("Jadren Portable UI", 640, 420, 0xF6F8FCu32)
    if root == 0 { return 1 }

    let panel: Int32 = ui_app_panel(root, 560, 260, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 2 }
    ui_layout_status("Ready for a portable event.", 480, 34, 0x111827u32, 0xDCFCE7u32, 10, 1)
    let label: Int32 = ui_app_label(panel, "Same source contract, native backend today.", 480, 34,
                                    0x111827u32, 0xFFFFFFu32, 8, 1)
    let button: Int32 = ui_app_button(panel, "Run event", 1, 180, 42,
                                      0xFFFFFFu32, 0x168EF5u32, 12, 0)
    if label == 0 { return 3 }
    if button == 0 { return 3 }
    if !ui_app_end(panel) { return 4 }
    if !ui_app_end(root) { return 5 }
    return ui_app_run()
}
