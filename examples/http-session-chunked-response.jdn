module examples.http_session_chunked_response

// Opt-in chunked responses in the bounded session path.  The mode is plain
// HTTP and intentionally closes each connection after one routed response;
// keep-alive remains the contract of http_session_open.
fn main() -> Int32 {
    let listener: UIntSize = net_tcp_listen(38128u16)
    if (listener as Int32) == 0 { return 10 }

    let session: UIntSize = http_session_open_chunked(listener, 2u32, 1024u32, 1024u32)
    if (session as Int32) == 0 {
        net_socket_close(listener)
        return 11
    }

    http_router_clear()
    var body: [UInt8; 12] = [72u8, 101u8, 108u8, 108u8, 111u8, 32u8, 74u8, 97u8, 100u8, 114u8, 101u8, 110u8]
    let added: Bool = http_router_add("GET", "/chunked", 200u16, "text/plain", body)
    if !added {
        http_session_close(session)
        return 12
    }

    let state: UInt32 = http_session_step(session, 2000u32)
    let closed: Bool = http_session_close(session)
    if state != 2u32 { return 13 }
    if !closed { return 14 }
    return 0
}
