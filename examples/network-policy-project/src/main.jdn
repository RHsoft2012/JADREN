module examples.network_policy_project

import jadren.network.policy.rate_limit_allow
import jadren.network.policy.rate_limit_retry_after_ms

fn main() -> Int32 {
    // state[0] = window start in milliseconds; state[1] = accepted count.
    var state: [UInt64; 2] = [0u64, 0u64]

    if !rate_limit_allow(1000u64, 1000u64, 2u64, state) { return 1 }
    if !rate_limit_allow(1100u64, 1000u64, 2u64, state) { return 2 }
    if rate_limit_allow(1200u64, 1000u64, 2u64, state) { return 3 }
    if rate_limit_retry_after_ms(1200u64, 1000u64, state) != 800u64 { return 4 }

    // The boundary starts a fresh window and the first request is accepted.
    if !rate_limit_allow(2000u64, 1000u64, 2u64, state) { return 5 }
    if rate_limit_retry_after_ms(2000u64, 1000u64, state) != 1000u64 { return 6 }

    if rate_limit_allow(2001u64, 0u64, 2u64, state) { return 7 }
    if rate_limit_allow(2001u64, 1000u64, 0u64, state) { return 8 }
    return 0
}
