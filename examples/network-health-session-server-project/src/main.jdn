module network_health_session_server_project.main

import jadren.app.fs.write_text
import jadren.network.router.add_exact
import jadren.network.router.clear
import jadren.network.session.close
import jadren.network.session.open
import jadren.network.session.step
import jadren.network.tcp.listen

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

// Bounded native health server fixture. It accepts exactly two requests on
// one session: the first keeps the connection alive and the second closes it.
// The marker contains no request or response body data.
fn main() -> Int32 {
    clear()
    var body: [UInt8; 44] = [
        123u8, 34u8, 115u8, 99u8, 104u8, 101u8, 109u8, 97u8,
        34u8, 58u8, 34u8, 106u8, 97u8, 100u8, 114u8, 101u8,
        110u8, 45u8, 104u8, 101u8, 97u8, 108u8, 116u8, 104u8,
        45u8, 48u8, 46u8, 49u8, 34u8, 44u8, 34u8, 115u8,
        116u8, 97u8, 116u8, 117u8, 115u8, 34u8, 58u8, 34u8,
        111u8, 107u8, 34u8, 125u8
    ]
    if ! add_exact(
        "GET", "/healthz", 200u16, "application/json", body, 44usize
    ) {
        return 1
    }

    let listener: UIntSize = listen(38163u16)
    if listener == 0usize {
        return 2
    }
    let session: UIntSize = open(listener, 1u32, 1024u32, 1024u32)
    if session == 0usize {
        return 3
    }
    let first: UInt32 = step(session, 5000u32)
    if first != 1u32 {
        close(session)
        return 4
    }
    let second: UInt32 = step(session, 5000u32)
    if second != 2u32 {
        close(session)
        return 5
    }
    if ! close(session) {
        return 6
    }
    if write_text(
        "target/jadren/network-health-session-server.result",
        "native-health-session-server:200 checks:2 schema:jadren-health-0.1\n"
    ) == 0usize {
        return 7
    }
    return 0
}
