module app_scheduler_snapshot.main
// The scheduler snapshot is deterministic, caller-owned and transactional on
// load. It can be written through the existing atomic file APIs by the caller.
fn main() -> Int32 {
    app_scheduler_clear()
    if ! app_scheduler_set(7,
    300i64,
    60u64) {
        return 1
    }
    if ! app_scheduler_set(2,
    100i64,
    0u64) {
        return 2
    }
    if ! app_scheduler_set(5,
    100i64,
    20u64) {
        return 3
    }
    var snapshot:[UInt8;
    68] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
