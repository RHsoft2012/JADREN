    ]
    var index: UIntSize = 0usize
    while index<snapshot_length[0] {
        malformed[index] = snapshot[index]
        index = index + 1usize
    }
    malformed[0] = 88u8
    if app_scheduler_load_exact(malformed,
    snapshot_length[0]) {
        return 21
    }
    if app_scheduler_count() != 4usize {
        return 22
    }
    malformed[0] = 74u8
    malformed[28] = malformed[8]
    malformed[29] = malformed[9]
    malformed[30] = malformed[10]
    malformed[31] = malformed[11]
    if app_scheduler_load_exact(malformed,
    snapshot_length[0]) {
        return 23
    }
    if app_scheduler_count() != 4usize {
        return 24
    }
    if app_scheduler_load_exact(snapshot,
    snapshot_length[0] - 1usize) {
        return 25
    }
    if app_scheduler_count() != 4usize {
        return 26
    }
    var short_output:[UInt8;
    16] =[170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8,
    170u8]
    var short_length:[UIntSize;
    1] =[77usize]
    if app_scheduler_write_exact(short_output,
    short_length) {
        return 27
    }
    if short_length[0] != 77usize {
        return 28
    }
    if short_output[0] != 170u8 {
        return 29
    }
    app_scheduler_clear()
    return 0
}
