module windows_desktop_portable_checkbox.main

// Retained checkbox example: the source declares only parent, size and
// event metadata. The native backend owns the actual checkbox control.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 2 {
        if ui_checked(2) == 1 {
            ui_set_status("Feature is enabled.")
        }
        if ui_checked(2) == 0 {
            ui_set_status("Feature is disabled.")
        }
    }
    if event_id == 3 {
        ui_set_status("Saved checkbox state.")
    }
    return event_id
}

fn main() -> Int32 {
    let root: Int32 = ui_app_begin("Jadren Portable Checkbox", 720, 420, 0xF6F8FCu32)
    if root == 0 { return 1 }
    let panel: Int32 = ui_app_panel(root, 640, 260, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 2 }
    ui_layout_status("Toggle the retained checkbox and observe the callback.", 560, 34,
                     0x111827u32, 0xDCFCE7u32, 10, 1)
    let checkbox: Int32 = ui_app_checkbox(panel, "Enable feature", 2, 260, 38,
                                           0x111827u32, 0x168EF5u32, 8, 0, 1)
    let button: Int32 = ui_app_button(panel, "Save state", 3, 180, 42,
                                      0xFFFFFFu32, 0x168EF5u32, 12, 0)
    if checkbox == 0 { return 3 }
    if button == 0 { return 4 }
    if !ui_app_end(panel) { return 5 }
    if !ui_app_end(root) { return 6 }
    return ui_app_run()
}
