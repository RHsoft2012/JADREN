module examples.windows_desktop_input;

// Prirodzené Jadren UI API: vstup deklaruje program, nie C/Win32 host.
// Callback dostane ID po každej zmene textu. Pole deklarované v Jadrene sa
// automaticky požičia ako zapisovateľný `Slice<UInt8>`; FFI ani Buffer API
// nie sú potrebné.

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 10 {
        var output: [UInt8; 32] = [
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
        ]
        let copied: UIntSize = ui_input_read(10, output)
        if copied == 0usize {
            ui_set_status("Vstup je prazdny.")
        } else {
            ui_set_status("Text bol skopirovany do lokalneho pola UTF-8.")
        }
    }
    return event_id
}

fn main() -> Int32 {
    ui_window("Jadren Input Read", 720, 360, 0xF6F8FCu32)
    ui_top_bar(48, 0x252526u32)
    ui_text("Jadren UI - citanie vstupu", 24, 64, 660, 34, 0x111827u32, 0xFFFFFFu32, 8)
    ui_text_input("Napis sem text", 10, 24, 116, 660, 42, 0x111827u32, 0xFFFFFFu32, 8)
    ui_status("Zacni pisat. Callback cita aktualny UTF-8 text.", 24, 180, 660, 48, 0x111827u32, 0xDCFCE7u32, 12)
    return ui_run()
}
