module app_list_page_if_revision_project.main

import jadren.app.data.revision
import jadren.app.list.clear
import jadren.app.list.count
import jadren.app.list.find_text
import jadren.app.list.page_if_revision
import jadren.app.list.page_if_model_revision
import jadren.app.list.push_text

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    clear(0)
    clear(1)
    if ! push_text(0, "Alpha") { return 1 }
    if ! push_text(0, "Beta") { return 2 }
    if ! push_text(0, "Gamma") { return 3 }
    if ! push_text(1, "Sentinel") { return 4 }

    let stale: UInt64 = revision()
    if ! push_text(0, "Delta") { return 5 }
    if page_if_revision(0, 1, 1, 2, stale) { return 6 }
    if count(1) != 1 { return 7 }
    if find_text(1, "Sentinel", 0) != 0 { return 8 }

    let current: UInt64 = revision()
    if ! page_if_revision(0, 1, 1, 2, current) { return 9 }
    if count(1) != 2 { return 10 }
    if find_text(1, "Beta", 0) != 0 { return 11 }
    if find_text(1, "Gamma", 0) != 1 { return 12 }
    if find_text(0, "Alpha", 0) != 0 { return 13 }
    if page_if_revision(0, 0, 0, 1, revision()) { return 14 }
    if page_if_revision(99, 1, 0, 1, revision()) { return 15 }

    let model_stale: UInt64 = revision()
    if ! push_text(0, "Epsilon") { return 16 }
    if page_if_model_revision(0, 1, 2, 2, model_stale) { return 17 }
    if count(1) != 2 { return 18 }
    if ! page_if_model_revision(0, 1, 2, 2, revision()) { return 19 }
    if count(1) != 2 { return 20 }
    if find_text(1, "Gamma", 0) != 0 { return 21 }
    if find_text(1, "Delta", 0) != 1 { return 22 }
    if page_if_model_revision(99, 1, 0, 1, revision()) { return 23 }
    return 0
}
