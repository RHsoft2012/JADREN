module examples.unity_ui_text_command_stream;

/// Fixed 32-byte UI command record. Text payloads live in a separate bounded
/// UTF-8 byte slice addressed by offset and length.
@repr(C)
pub struct UnityUiTextCommandRecord {
    pub kind: UInt8,
    pub active: UInt8,
    pub reserved: UInt16,
    pub target_id: UInt32,
    pub text_offset: UInt32,
    pub text_length: UInt32,
    pub red: Float32,
    pub green: Float32,
    pub blue: Float32,
    pub alpha: Float32,
}

/// Emits one UTF-8 text update, one color update and one active-state update.
@export(name: "jadren_unity_emit_demo_ui_text_commands", abi: "C")
@noalloc
pub fn emit_demo_ui_text_commands(
    output: write Slice<UnityUiTextCommandRecord>,
    text_output: write Slice<UInt8>,
    capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if capacity < 3usize {
        return 0usize
    }
    if text_capacity < 9usize {
        return 0usize
    }

    // UTF-8 bytes for "Jadren UI".
    text_output[0] = 74u8
    text_output[1] = 97u8
    text_output[2] = 100u8
    text_output[3] = 114u8
    text_output[4] = 101u8
    text_output[5] = 110u8
    text_output[6] = 32u8
    text_output[7] = 85u8
    text_output[8] = 73u8

    output[0] = UnityUiTextCommandRecord {
        kind: 3u8,
        active: 1u8,
        reserved: 0u16,
        target_id: 21u32,
        text_offset: 0u32,
        text_length: 9u32,
        red: 0.0f32,
        green: 0.0f32,
        blue: 0.0f32,
        alpha: 1.0f32,
    }
    output[1] = UnityUiTextCommandRecord {
        kind: 1u8,
        active: 1u8,
        reserved: 0u16,
        target_id: 21u32,
        text_offset: 0u32,
        text_length: 0u32,
        red: 0.1f32,
        green: 0.6f32,
        blue: 1.0f32,
        alpha: 1.0f32,
    }
    output[2] = UnityUiTextCommandRecord {
        kind: 2u8,
        active: 0u8,
        reserved: 0u16,
        target_id: 21u32,
        text_offset: 0u32,
        text_length: 0u32,
        red: 0.0f32,
        green: 0.0f32,
        blue: 0.0f32,
        alpha: 1.0f32,
    }
    return 3usize
}
