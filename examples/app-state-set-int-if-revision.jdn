module app_state_set_int_if_revision.main
// An optimistic state replacement accepts a value only for the revision that
// the caller observed. Stale and invalid calls must not mutate value or
// revision, which is useful for form saves and server-side compare-and-swap.
fn main() -> Int32 {
    app_state_clear()
    if ! app_state_set_int("minutes",
    10i64) {
        return 1
    }
    let snapshot: UInt64 = app_state_revision()
    if ! app_state_set_int_if_revision("minutes",
    25i64,
    snapshot) {
        return 2
    }
    if app_state_get_int("minutes") != 25i64 {
        return 3
    }
    let current: UInt64 = app_state_revision()
    if app_state_set_int_if_revision("minutes",
    30i64,
    snapshot) {
        return 4
    }
    if app_state_get_int("minutes") != 25i64 {
        return 5
    }
    if app_state_revision() != current {
        return 6
    }
    if ! app_state_set_int_if_revision("missing",
    -7i64,
    current) {
        return 7
    }
    if app_state_get_int("missing") != -7i64 {
        return 8
    }
    if ! app_state_set_text("wrong_kind",
    "text") {
        return 9
    }
    let mismatch_revision: UInt64 = app_state_revision()
    if ! app_state_set_int_if_revision("wrong_kind",
    42i64,
    mismatch_revision) {
        return 10
    }
    if app_state_get_int("wrong_kind") != 42i64 {
        return 11
    }
    if app_state_set_int_if_revision("",
    99i64,
    app_state_revision()) {
        return 12
    }
    if app_state_revision() != mismatch_revision + 1u64 {
        return 13
    }
    return 0
}
