    0u8,
    0u8,
    0u8,
    0u8
    ]
    var length:[UIntSize;
    1] =[99usize]
    let stale: UInt64 = revision()
    if ! set_cell(0,
    0,
    0,
    "Alpha-open") {
        return 26
    }
    if table_filter_text_ex_if_model_revision(source_node,
    1,
    0,
    "open",
    5,
    stale) {
