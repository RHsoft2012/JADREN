@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn main() -> Int32 {
    clear(0)
    clear(1)
    if ! set_column_type(0,
    0,
    0) {
        return 1
