        return 15
    }
    let panel_node: Int32 = panel(root,
    660,
    340,
    0xFFFFFFu32,
    16,
    12,
    8,
    0,
    1)
    if panel_node == 0 {
        return 16
    }
    let source_node: Int32 = table(panel_node,
    30,
    600,
    120,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    let destination_node: Int32 = table(panel_node,
    31,
    600,
    120,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    let mirror_node: Int32 = table(panel_node,
    32,
    600,
    120,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    if source_node == 0 {
        return 17
    }
    if destination_node == 0 {
        return 18
    }
    if mirror_node == 0 {
        return 19
    }
    if ! table_column(source_node,
    0,
