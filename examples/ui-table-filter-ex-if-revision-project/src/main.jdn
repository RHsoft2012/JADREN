    300) {
        return 20
    }
    if ! table_column(destination_node,
    0,
    "Value",
    300) {
        return 21
    }
    if ! table_column(mirror_node,
    0,
    "Value",
    300) {
        return 22
    }
    if ! table_bind(source_node,
    0,
    1) {
        return 23
    }
    if ! table_bind(destination_node,
    1,
    1) {
        return 24
    }
    if ! table_bind(mirror_node,
    1,
    1) {
        return 25
    }
    var output:[UInt8;
    32] =[0u8,
    0u8,
    0u8,
    0u8,
