module network_auth_header_block_client_project.main

import jadren.app.fs.write_text
import jadren.network.client.request_once_header_block_exact_buffer

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 { return event_id }

fn request(
    headers: String,
    expected_status: Int32,
    body: write Buffer<UInt8>,
    request_buffer: write Buffer<UInt8>,
    response: write Buffer<UInt8>,
    output: write Buffer<UInt8>,
) -> Int32 {
    var response_length: [UIntSize; 1] = [0usize]
    var output_length: [UIntSize; 1] = [0usize]
    let status: Int32 = request_once_header_block_exact_buffer(
        "localhost", "localhost", 38166u16, 3000u32,
        "GET", "/status", headers,
        body, 0usize, request_buffer, 512usize,
        response, 256usize, response_length,
        output, 32usize, output_length,
    )
    if status != expected_status { return 1 }
    if expected_status == 200i32 {
        if output_length[0] != 2usize { return 2 }
        if output[0] != 79u8 { return 3 }
        if output[1] != 75u8 { return 4 }
    }
    return 0
}

fn main() -> Int32 {
    var status: Int32 = 0i32
    let body_created: Result<Buffer<UInt8>, Int32> = buffer_create(1usize)
    match body_created {
        Ok(body) => {
            let request_created: Result<Buffer<UInt8>, Int32> = buffer_create(512usize)
            match request_created {
                Ok(request_buffer) => {
                    let response_created: Result<Buffer<UInt8>, Int32> = buffer_create(256usize)
                    match response_created {
                        Ok(response) => {
                            let output_created: Result<Buffer<UInt8>, Int32> = buffer_create(32usize)
                            match output_created {
                                Ok(output) => {
                                    if !buffer_resize(body, 1usize) { status = 10i32 }
                                    if status == 0i32 {
                                        if !buffer_resize(request_buffer, 512usize) { status = 11i32 }
                                    }
                                    if status == 0i32 {
                                        if !buffer_resize(response, 256usize) { status = 12i32 }
                                    }
                                    if status == 0i32 {
                                        if !buffer_resize(output, 32usize) { status = 13i32 }
                                    }
                                    if status == 0i32 {
                                        let wrong: Int32 = request(
                                            "Authorization: Bearer wrong\r\nX-Jadren-Trace: plain-block-1",
                                            401i32, body, request_buffer, response, output)
                                        if wrong != 0i32 { status = 14i32 }
                                    }
                                    if status == 0i32 {
                                        let valid: Int32 = request(
                                            "Authorization: Bearer abc123\r\nX-Jadren-Trace: plain-block-1",
                                            200i32, body, request_buffer, response, output)
                                        if valid != 0i32 { status = 15i32 }
                                    }
                                }
                                Error(error) => { status = error }
                            }
                        }
                        Error(error) => { status = error }
                    }
                }
                Error(error) => { status = error }
            }
        }
        Error(error) => { status = error }
    }
    if status != 0i32 { return status }
    if write_text("target/jadren/network-auth-header-block-client.result",
        "plain-auth-header-block:401,200 exact:true\n") == 0usize { return 16 }
    return 0
}
