module windows_desktop_portable_list.main

// Retained dynamic list example. The first items are declared through the
// node API; binding then projects the same control from an app_list store.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 2 {
        ui_set_status("List selection changed.")
    }
    if event_id == 3 {
        ui_set_status("Saved list selection.")
    }
    return event_id
}

fn main() -> Int32 {
    app_list_clear(0)
    if !app_list_push_text(0, "Bound first") { return 1 }
    if !app_list_push_text(0, "Bound second") { return 2 }

    let root: Int32 = ui_app_begin("Jadren Portable List", 720, 460, 0xF6F8FCu32)
    if root == 0 { return 3 }
    let panel: Int32 = ui_app_panel(root, 640, 300, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 4 }
    ui_layout_status("Items are declared and then refreshed from app_list.", 560, 34,
                     0x111827u32, 0xDCFCE7u32, 10, 1)
    let list: Int32 = ui_app_list(panel, 2, 560, 120,
                                  0x111827u32, 0xFFFFFFu32, 8, 1)
    if list == 0 { return 5 }
    if !ui_app_list_item(list, "Local item") { return 6 }
    if ui_app_list_count(list) != 1 { return 7 }
    if !ui_app_list_bind_app(list, 0) { return 8 }
    if ui_app_list_count(list) != 2 { return 9 }
    if !ui_app_list_set_index(list, 1) { return 10 }
    if ui_app_list_index(list) != 1 { return 11 }
    let button: Int32 = ui_app_button(panel, "Save selection", 3, 200, 42,
                                      0xFFFFFFu32, 0x168EF5u32, 12, 0)
    if button == 0 { return 12 }
    if !ui_app_end(panel) { return 13 }
    if !ui_app_end(root) { return 14 }
    return ui_app_run()
}
