module examples.windows_desktop_list;

// Dynamický zoznam je stále deklarovaný v Jadrene. Callback ho môže po
// vytvorení natívneho okna dopĺňať, meniť alebo vymazať bez FFI mosta.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 1 {
        let count: Int32 = ui_list_count(20)
        if count < 3 {
            ui_list_item(20, "Polozka pridana po starte")
            var item_text: [UInt8; 32] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
            let copied: UIntSize = ui_list_read_item(20, count, item_text)
            ui_state_set(0, copied as Int32)
        } else {
            ui_list_set_item(20, 0, "Prva polozka bola upravena")
            ui_list_clear(20)
            ui_list_item(20, "Zoznam bol obnoveny")
            ui_list_item(20, "Druhy riadok")
        }
        ui_set_status("Zoznam bol zmeneny callbackom.")
    }
    return event_id
}

fn main() -> Int32 {
    ui_window("Jadren Dynamic List", 720, 420, 0xF6F8FCu32)
    ui_top_bar(48, 0x252526u32)
    ui_text("Jadren UI - dynamicky zoznam", 24, 64, 660, 34, 0x111827u32, 0xFFFFFFu32, 8)
    ui_list(20, 24, 116, 420, 170, 0x111827u32, 0xFFFFFFu32)
    ui_list_item(20, "Prva polozka")
    ui_list_item(20, "Druha polozka")
    ui_status("Klikni na tlacidlo a zmen zoznam po starte.", 24, 306, 420, 44, 0x111827u32, 0xDCFCE7u32, 12)
    ui_event_button("Zmen zoznam", 1, 470, 116, 190, 42, 0xFFFFFFu32, 0x168EF5u32, 12)
    return ui_run()
}
