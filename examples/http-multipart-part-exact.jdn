    request[311] = 10u8
    request[228] = 70u8
    var case_output: [UInt8; 8] = [66u8, 66u8, 66u8, 66u8, 66u8, 66u8, 66u8, 66u8]
    var case_length: [UIntSize; 1] = [222usize]
    if http_multipart_part_exact_prefix(request, 312usize, "file", case_output, case_length) { return 11 }
