module examples.selfhost.typed_nested_while_local_native_stage2

// Native producer -> JST2WN01 -> verified nested Int32 while CFG.
fn local_value() -> Int32 {
    var outer: Int32 = 0;
    while outer < 4 {
        outer = outer + 1;
        var inner: Int32 = 0;
        while inner < 2 {
            inner = inner + 1;
        }
        outer = outer + outer;
    }
    return outer;
}
