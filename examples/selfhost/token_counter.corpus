# Deterministic semantics corpus for the Rust/Jadren self-hosting slice.
jadren-selfhost-corpus-0.1

# byte,value -> compact class: identifier=1, digit=2, ASCII whitespace=3, other=0
byte,0x00,0
byte,0x09,3
byte,0x0a,3
byte,0x20,3
byte,0x2f,0
byte,0x30,2
byte,0x39,2
byte,0x3a,0
byte,0x40,0
byte,0x41,1
byte,0x5a,1
byte,0x5b,0
byte,0x5f,1
byte,0x60,0
byte,0x61,1
byte,0x7a,1
byte,0x7b,0
byte,0xff,0

# start,end -> returned start,end (order is intentionally not normalized)
span,0,0,0,0
span,3,9,3,9
span,18,12,18,12
span,18446744073709551615,0,18446744073709551615,0

# input,start,end -> first non-identifier/digit terminator span
scan,play1!,0,6,0,5
scan,_9!,0,3,0,2
scan,abc,1,3,1,3
scan,!,0,1,0,0

# input,start,end -> next token span after ASCII whitespace skipping
token,foo+12,0,6,0,3
token,123 +,0,5,0,3
token,x  foo,1,6,3,6
token,x  y,1,3,3,3

# input,start,end -> token kind (0 none, 1 identifier, 2 number, 3 symbol), start,end
info,foo+12,0,6,1,0,3
info,123 +,0,5,2,0,3
info,x  !,1,4,3,3,4
info,x  y,1,3,0,3,3

# input,start,end -> identifier,number,symbol,total token counts
count,foo+12,0,6,1,1,1,3
count,123 +,0,5,0,1,1,2
count,x  !,1,4,0,0,1,1
count,x  y,1,3,0,0,0,0

# input,start,end -> literal expression kind,type kind,start,end,delimiter depth
typed,true,0,4,1,1,0,4,0
typed,42,0,2,1,2,0,2,0
typed,3.5,0,3,1,3,0,3,0
typed,"hi",0,4,1,4,0,4,0
typed,'x',0,3,1,5,0,3,0
typed,(true),0,6,1,1,1,5,1

# input,start,end -> binary typed expression kind,type kind,start,end,delimiter depth
typed-binary,1 + 2,0,5,2,2,0,5,0
typed-binary,1 + 2.0,0,7,2,3,0,7,0
typed-binary,true && false,0,13,2,1,0,13,0
typed-binary,1 == 2,0,6,2,1,0,6,0
typed-binary,(1) + (2),0,9,2,2,0,9,0
typed-binary,(true) && (false),0,17,2,1,0,17,0
typed-binary,((1)) + ((2)),0,13,2,2,0,13,0
typed-binary,((true)) && ((false)),0,21,2,1,0,21,0
typed-binary,1 + 2 + 3,0,9,2,2,0,9,0
typed-binary,true && false && true,0,21,2,1,0,21,0
typed-binary,1 + 2 * 3,0,9,2,2,0,9,0
typed-binary,1 + 2 == 3,0,10,2,1,0,10,0

# input,start,end -> numeric cast expression kind,type kind,start,end,delimiter depth
typed-cast,42 as Int32,0,11,4,2,0,11,0
typed-cast,42 as Float64,0,13,4,3,0,13,0
typed-cast,3.5 as Float32,0,14,4,3,0,14,0
typed-cast,3.5 as Int64,0,12,4,2,0,12,0
typed-cast,(42) as Int32,0,13,4,2,0,13,1
typed-cast,((3.5)) as Float64,0,18,4,3,0,18,2
typed-cast,42 as Int32 as Float64,0,22,4,3,0,22,0
typed-cast,(3.5) as Float32 as Int64,0,25,4,2,0,25,1
typed-cast,(42 as Int32) as Float64,0,24,4,3,0,24,1
typed-cast,((42 as Int32)) as Float64,0,26,4,3,0,26,2

# input,start,end -> unary typed expression kind,type kind,start,end,delimiter depth
typed-unary,-42,0,3,3,2,0,3,0
typed-unary,+3.5,0,4,3,3,0,4,0
typed-unary,!true,0,5,3,1,0,5,0
