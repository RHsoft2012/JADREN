typed-unary,!!true,0,6,3,1,0,6,0
typed-unary,- -42,0,5,3,2,0,5,0
typed-unary,! !true,0,7,3,1,0,7,0

# input,start,end,expected count,callee start,end,open start,end,close start,end,argument count,delimiter depth
call,foo(),0,5,1,0,3,3,4,4,5,0,0
