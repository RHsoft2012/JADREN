pub fn parse_ast_pattern_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternHeader>,
) -> UIntSize {
    return parse_pattern_headers(bytes, start, end, output)
}

/// Projects the bounded pattern-binding scanner as an AST child view. Binding
/// kind, identifier span and delimiter depth remain syntax-only and are
/// written into caller-owned output; name resolution and binding semantics
/// remain later compiler stages.
@export(name: "jadren_selfhost_parse_ast_pattern_binding_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_binding_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternBindingHeader>,
) -> UIntSize {
    return parse_pattern_bindings(bytes, start, end, output)
}

/// Projects bounded pattern recovery records as an AST child view. Recovery
/// kind, offending span and delimiter depth remain syntax-only and are written
/// into caller-owned output; diagnostic policy remains a later compiler stage.
@export(name: "jadren_selfhost_parse_ast_pattern_recovery_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_recovery_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternRecoveryHeader>,
) -> UIntSize {
    return parse_pattern_recovery(bytes, start, end, output)
}

/// Projects bounded delimiter diagnostics as an AST child view. Kind,
/// expected/actual delimiters, span and depth remain syntax-only and are
/// written into caller-owned output; the opener stack is caller-owned too.
@export(name: "jadren_selfhost_parse_ast_pattern_diagnostic_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_diagnostic_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternDiagnosticHeader>,
    stack: write Slice<UInt8>,
) -> UIntSize {
    return parse_pattern_diagnostics(bytes, start, end, output, stack)
}

/// Emits bounded postfix spans from one explicit expression range. A call or
/// index opener is considered postfix only when a preceding atom/group can be
/// observed; a single dot followed by an identifier is a field span and `?`
/// is a try-postfix span. No name resolution or call arity is performed.
@export(name: "jadren_selfhost_parse_expression_postfixes", abi: "C")
@noalloc
pub fn parse_expression_postfixes(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPostfixHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var can_postfix: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                can_postfix = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                can_postfix = true
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                can_postfix = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                can_postfix = true
                source_index = next_source
                continue
            }
            if symbol == 0x2Eu8 {
                var is_range_prefix: Bool = false
                if end - token_start >= 2usize {
                    if bytes[token_start + 1usize] == 0x2Eu8 {
                        is_range_prefix = true
                    }
                }
                if can_postfix {
                    if !is_range_prefix {
                        let field_info: TokenInfo = scan_token_info(bytes, next_source, end)
                        if field_info.kind == 1u8 {
                            output[slot] = ExpressionPostfixHeader {
                                kind: 2u8,
                                start: token_start,
                                end: field_info.end,
                                depth: delimiter_depth,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                            source_index = field_info.end
                            can_postfix = true
                            break
                        }
                    }
                }
                can_postfix = false
                source_index = next_source
                continue
            }
            if symbol == 0x3Fu8 {
                if can_postfix {
                    output[slot] = ExpressionPostfixHeader {
                        kind: 4u8,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    source_index = next_source
                    break
                }
                source_index = next_source
                continue
            }
            var postfix_kind: UInt8 = 0u8
            var closing_symbol: UInt8 = 0u8
            if symbol == 0x28u8 {
                if can_postfix {
                    postfix_kind = 1u8
                    closing_symbol = 0x29u8
                }
            } else {
                if symbol == 0x5Bu8 {
                    if can_postfix {
                        postfix_kind = 3u8
                        closing_symbol = 0x5Du8
                    }
                }
            }
            if postfix_kind != 0u8 {
                var nested_depth: UIntSize = 1usize
                var cursor: UIntSize = next_source
                var group_end: UIntSize = end
                while cursor < end {
                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if nested_info.start >= end {
                        cursor = end
                        break
                    }
                    var nested_symbol: UInt8 = 0u8
                    if nested_info.kind == 3u8 {
                        nested_symbol = bytes[nested_info.start]
                    }
                    if nested_symbol == symbol {
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == closing_symbol {
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                            if nested_depth == 0usize {
                                group_end = nested_info.end
                                break
                            }
                        }
                    }
                    cursor = nested_info.end
                }
                output[slot] = ExpressionPostfixHeader {
                    kind: postfix_kind,
                    start: token_start,
                    end: group_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                delimiter_depth = delimiter_depth + 1usize
                can_postfix = false
                source_index = next_source
                break
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
            } else {
                if symbol == 0x5Bu8 {
                    delimiter_depth = delimiter_depth + 1usize
                }
            }
            can_postfix = false
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded call headers from one explicit expression range. A call is
/// recognized only when a parenthesized group follows an atom or completed
/// delimiter group. The scanner counts commas at the call's outer delimiter
/// level and skips nested groups; it does not resolve the callee or validate
/// argument types.
@export(name: "jadren_selfhost_parse_expression_calls", abi: "C")
@noalloc
pub fn parse_expression_calls(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionCallHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            output[slot] = ExpressionCallHeader {
                callee_start: callee_start,
                callee_end: callee_end,
                open_start: token_start,
                open_end: next_source,
                close_start: close_start,
                close_end: close_end,
                argument_count: argument_count,
                depth: delimiter_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits one bounded record for every top-level binary operator in an explicit
/// expression range. Delimiters are tracked so operators inside calls,
/// indexing, or groups are excluded. Unary shape, precedence, associativity,
/// and operand type resolution are intentionally deferred.
@export(name: "jadren_selfhost_parse_expression_binary_headers", abi: "C")
@noalloc
pub fn parse_expression_binary_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionBinaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind != 0u8 {
                        if candidate_kind != 5u8 {
                            if candidate_kind != 6u8 {
                                output[slot] = ExpressionBinaryHeader {
                                    kind: candidate_kind,
                                    left_start: start,
                                    left_end: token_start,
                                    operator_start: token_start,
                                    operator_end: operator_end,
                                    right_start: operator_end,
                                    right_end: end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded prefix/unary spans from one explicit expression range. A
/// prefix operator is recognized only while an operand is expected; the
/// following atom or delimiter group is retained as its operand span. This is
/// syntax-only and does not decide whether borrow/dereference is legal.
@export(name: "jadren_selfhost_parse_expression_unaries", abi: "C")
@noalloc
pub fn parse_expression_unaries(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionUnaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var expect_operand: Bool = true
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
            if expect_operand {
                if operator_end - token_start == 1usize {
                    var unary_kind: UInt8 = 0u8
                    if symbol == 0x2Bu8 {
                        unary_kind = 1u8
                    } else {
                        if symbol == 0x2Du8 {
                            unary_kind = 2u8
                        } else {
                            if symbol == 0x21u8 {
                                unary_kind = 3u8
                            } else {
                                if symbol == 0x7Eu8 {
                                    unary_kind = 4u8
                                } else {
                                    if symbol == 0x26u8 {
                                        unary_kind = 5u8
                                    } else {
                                        if symbol == 0x2Au8 {
                                            unary_kind = 6u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if unary_kind != 0u8 {
                        let operand_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                        var operand_start: UIntSize = end
                        var operand_end: UIntSize = end
                        if operand_info.start < end {
                            operand_start = operand_info.start
                            operand_end = operand_info.end
                            var operand_symbol: UInt8 = 0u8
                            if operand_info.kind == 3u8 {
                                operand_symbol = bytes[operand_info.start]
                            }
                            if operand_symbol == 0x28u8 {
                                var nested_depth: UIntSize = 1usize
                                var cursor: UIntSize = operand_info.end
                                while cursor < end {
                                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if nested_info.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var nested_symbol: UInt8 = 0u8
                                    if nested_info.kind == 3u8 {
                                        nested_symbol = bytes[nested_info.start]
                                    }
                                    if nested_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if nested_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                operand_end = nested_info.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = nested_info.end
                                }
                            } else {
                                if operand_symbol == 0x5Bu8 {
                                    var nested_depth: UIntSize = 1usize
                                    var cursor: UIntSize = operand_info.end
                                    while cursor < end {
                                        let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                        if nested_info.start >= end {
                                            cursor = end
                                            break
                                        }
                                        var nested_symbol: UInt8 = 0u8
                                        if nested_info.kind == 3u8 {
                                            nested_symbol = bytes[nested_info.start]
                                        }
                                        if nested_symbol == 0x5Bu8 {
                                            nested_depth = nested_depth + 1usize
                                        } else {
                                            if nested_symbol == 0x5Du8 {
                                                if nested_depth > 0usize {
                                                    nested_depth = nested_depth - 1usize
                                                }
                                                if nested_depth == 0usize {
                                                    operand_end = nested_info.end
                                                    break
                                                }
                                            }
                                        }
                                        cursor = nested_info.end
                                    }
                                }
                            }
                        }
                        output[slot] = ExpressionUnaryHeader {
                            kind: unary_kind,
                            operator_start: token_start,
                            operator_end: operator_end,
                            operand_start: operand_start,
                            operand_end: operand_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        expect_operand = true
                        source_index = operator_end
                        break
                    }
                }
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
            if candidate_kind != 0u8 {
                if candidate_kind != 5u8 {
                    if candidate_kind != 6u8 {
                        expect_operand = true
                    }
                }
                source_index = operator_end
                continue
            }
            if symbol == 0x2Cu8 {
                expect_operand = true
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits boolean, integer, float, string, and char literal spans from one
/// explicit expression range. Quoted literals honor a bounded backslash escape
/// state; invalid or unterminated literals are retained to `end` for recovery.
/// This stage does not validate literal contents or infer their types.
@export(name: "jadren_selfhost_parse_literal_headers", abi: "C")
@noalloc
pub fn parse_literal_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<LiteralHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = LiteralHeader {
                    kind: bool_kind,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_kind: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_kind = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = LiteralHeader {
                    kind: literal_kind,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first typed-semantics hand-off for self-hosting: builtin types
/// for boolean, integer, float, string, and char literals. The caller owns the
/// output buffer and receives records in the same source order as
/// `parse_literal_headers`. No names, operators, calls, aliases, or user
/// declarations are resolved here.
@export(name: "jadren_selfhost_infer_literal_types", abi: "C")
@noalloc
pub fn infer_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 1u8,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_type: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_type = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: literal_type,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed records for top-level binary expressions whose left and right
/// sides are each one builtin literal or one parenthesized builtin literal
/// group. Arithmetic over numeric literals yields integer or float, comparisons
/// yield bool, and logical operators over boolean literals yield bool. A
/// a bounded two-operator chain is also accepted: arithmetic operators may
/// mix, and one arithmetic operator may feed a numeric comparison according to
/// the bounded precedence categories. Names, casts, calls and user types remain
/// outside this narrow binary hand-off.
@export(name: "jadren_selfhost_infer_binary_literal_types", abi: "C")
@noalloc
pub fn infer_binary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let chain_header: TypedExpressionHeader = infer_binary_literal_chain_header(bytes, start, end)
    let chain_mode: Bool = chain_header.type_kind != 0u8
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        if chain_mode {
            output[slot] = TypedExpressionHeader {
                expression_kind: chain_header.expression_kind,
                type_kind: chain_header.type_kind,
                start: chain_header.start,
                end: chain_header.end,
                depth: chain_header.depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = end
        }
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind == 2u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        var result_type: UInt8 = 0u8
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                if left_type == 3u8 {
                                    result_type = 3u8
                                } else {
                                    if right_type == 3u8 {
                                        result_type = 3u8
                                    } else {
                                        result_type = 2u8
                                    }
                                }
                            }
                        }
                        if result_type != 0u8 {
                            let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                            let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                            var right_end: UIntSize = right_info.end
                            if right_grouped_type != 0u8 {
                                right_end = bounded_grouped_literal_end(bytes, operator_end, end)
                            } else {
                                if right_type == 3u8 {
                                    right_end = bounded_numeric_literal_end(bytes, operator_end, end)
                                }
                            }
                            output[slot] = TypedExpressionHeader {
                                expression_kind: 2u8,
                                type_kind: result_type,
                                start: left_info.start,
                                end: right_end,
                                depth: delimiter_depth,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                            source_index = operator_end
                            break
                        }
                    }
                    if candidate_kind == 3u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                let right_end: UIntSize = if right_grouped_type != 0u8 {
                                    bounded_grouped_literal_end(bytes, operator_end, end)
                                } else {
                                    right_info.end
                                }
                                output[slot] = TypedExpressionHeader {
                                    expression_kind: 2u8,
                                    type_kind: 1u8,
                                    start: left_info.start,
                                    end: right_end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                    if candidate_kind == 4u8 {
                        if is_boolean_binary_operator(bytes, token_start, operator_end) {
                            let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                start,
                                token_start,
                            )
                            let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                operator_end,
                                end,
                            )
                            let left_type: UInt8 = if left_grouped_type != 0u8 {
                                left_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, start, token_start)
                            }
                            let right_type: UInt8 = if right_grouped_type != 0u8 {
                                right_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, operator_end, end)
                            }
                            if left_type == 1u8 {
                                if right_type == 1u8 {
                                    let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                    let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                    let right_end: UIntSize = if right_grouped_type != 0u8 {
                                        bounded_grouped_literal_end(bytes, operator_end, end)
                                    } else {
                                        right_info.end
                                    }
                                    output[slot] = TypedExpressionHeader {
                                        expression_kind: 2u8,
                                        type_kind: 1u8,
                                        start: left_info.start,
                                        end: right_end,
                                        depth: delimiter_depth,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = operator_end
                                    break
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
        if chain_mode {
            break
        }
    }
    return output_index
}

/// Emits one typed record for the bounded explicit numeric cast route.
@export(name: "jadren_selfhost_infer_cast_literal_types", abi: "C")
@noalloc
pub fn infer_cast_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_cast_literal_header(bytes, start, end)
    if header.type_kind == 0u8 {
        return 0usize
    }
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        if header.type_kind != 0u8 {
            output[slot] = TypedExpressionHeader {
                expression_kind: header.expression_kind,
                type_kind: header.type_kind,
                start: header.start,
                end: header.end,
                depth: header.depth,
            }
            output_index = 1usize
        }
    }
    return output_index
}

/// Emits one typed record for a unary operator applied to exactly one builtin
/// literal or one or more nested parenthesized literal groups. Contiguous
/// prefix chains are applied from right to left, so `--42` preserves Integer
/// and `!!true` preserves Bool. `+`/`-` preserve integer or float, `!` accepts
/// bool, and `~` accepts integer. This is intentionally a prefix-only
/// hand-off; ASCII whitespace between prefix operators is accepted, while
/// borrow/dereference semantics, precedence and names remain later stages.
fn infer_unary_literal_header(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TypedExpressionHeader {
    let operator_info: TokenInfo = scan_token_info(bytes, start, end)
    if operator_info.start >= end {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operator_end: UIntSize = operator_info.end
    if operator_end != operator_info.start + 1usize {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if !is_unary_operator(bytes[operator_info.start]) {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    var operand_start: UIntSize = operator_end
    var chain_cursor: UIntSize = operator_end
    while chain_cursor < end {
        let chain_info: TokenInfo = scan_token_info(bytes, chain_cursor, end)
        if chain_info.start >= end {
            break
        }
        if chain_info.end != chain_info.start + 1usize {
            break
        }
        if !is_unary_operator(bytes[chain_info.start]) {
            break
        }
        operand_start = chain_info.end
        chain_cursor = chain_info.end
    }
    let grouped_operand_type: UInt8 = bounded_grouped_literal_type_kind(
        bytes,
        operand_start,
        end,
    )
    let operand_type: UInt8 = if grouped_operand_type != 0u8 {
        grouped_operand_type
    } else {
        bounded_literal_type_kind(bytes, operand_start, end)
    }
    let grouped: Bool = grouped_operand_type != 0u8
    var result_type: UInt8 = operand_type
    var operator_cursor: UIntSize = operand_start
    while operator_cursor > operator_info.start {
        operator_cursor = operator_cursor - 1usize
        if classify_byte(bytes[operator_cursor]) == 3u8 {
            continue
        }
        let operator: UInt8 = bytes[operator_cursor]
        var next_type: UInt8 = 0u8
        if operator == 0x2Bu8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x2Du8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x21u8 {
            if result_type == 1u8 {
                next_type = 1u8
            }
        }
        if operator == 0x7Eu8 {
            if result_type == 2u8 {
                next_type = 2u8
            }
        }
        result_type = next_type
        if result_type == 0u8 {
            break
        }
    }
    if result_type == 0u8 {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operand_info: TokenInfo = scan_token_info(bytes, operand_start, end)
    var operand_end: UIntSize = operand_info.end
    var depth: UIntSize = 0usize
    if grouped {
        operand_end = bounded_grouped_literal_end(bytes, operand_start, end)
        var depth_cursor: UIntSize = operand_start
        while true {
            let group_info: TokenInfo = scan_token_info(bytes, depth_cursor, end)
            if group_info.start >= end {
                break
            }
            if bytes[group_info.start] != 0x28u8 {
                break
            }
            depth = depth + 1usize
            depth_cursor = group_info.end
        }
    } else {
        if operand_type == 2u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
        if operand_type == 3u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
    }
    return TypedExpressionHeader {
        expression_kind: 3u8,
        type_kind: result_type,
        start: operator_info.start,
        end: operand_end,
        depth: depth,
    }
}

@export(name: "jadren_selfhost_infer_unary_literal_types", abi: "C")
@noalloc
pub fn infer_unary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_unary_literal_header(bytes, start, end)
    if header.type_kind != 0u8 {
        var output_index: UIntSize = 0usize
        for slot in output.indices {
            if output_index == 0usize {
                output[slot] = TypedExpressionHeader {
                    expression_kind: header.expression_kind,
                    type_kind: header.type_kind,
                    start: header.start,
                    end: header.end,
                    depth: header.depth,
                }
                output_index = 1usize
            }
        }
        return output_index
    }
    return 0usize
}

/// Emits one typed name record for every identifier token that matches a
/// caller-owned binding entry. The binding spans and output buffer are bounded
/// by the caller; results preserve source order and stop at output capacity.
/// This is a symbol-table hand-off, not a scope-aware resolver.
@export(name: "jadren_selfhost_infer_name_types", abi: "C")
@noalloc
pub fn infer_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                    var equal: Bool = true
                                    var compare_index: UIntSize = 0usize
                                    while compare_index < next_source - token_start {
                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                            equal = false
                                            break
                                        }
                                        compare_index = compare_index + 1usize
                                    }
                                    if equal {
                                        output[slot] = TypedExpressionHeader {
                                            expression_kind: 5u8,
                                            type_kind: bindings[binding_index].type_kind,
                                            start: token_start,
                                            end: next_source,
                                            depth: delimiter_depth,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        break
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records for caller-owned function bindings. The callee
/// bytes and positional argument count must match exactly; only builtin return
/// types are accepted. A valid record spans from the callee through the close
/// delimiter and uses expression kind `8` in the existing typed header.
@export(name: "jadren_selfhost_infer_call_types", abi: "C")
@noalloc
pub fn infer_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedCallBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    for binding_index in bindings.indices {
                    if bindings[binding_index].return_type_kind >= 1u8 {
                        if bindings[binding_index].return_type_kind <= 5u8 {
                            if bindings[binding_index].parameter_count == argument_count {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == callee_end - callee_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < callee_end - callee_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                output[slot] = TypedExpressionHeader {
                                                    expression_kind: 8u8,
                                                    type_kind: bindings[binding_index].return_type_kind,
                                                    start: callee_start,
                                                    end: close_end,
                                                    depth: delimiter_depth,
                                                }
                                                output_index = output_index + 1usize
                                                emitted = true
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records selected from caller-owned concrete overloads and
/// generic fallbacks. Matching is exact by name bytes and positional arity;
/// the lowest generic parameter count wins and an equal-specificity tie is
/// rejected as ambiguous. Parameter types, bounds and substitution remain
/// outside this additive resolver boundary.
@export(name: "jadren_selfhost_resolve_call_types", abi: "C")
@noalloc
pub fn resolve_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    candidates: read Slice<TypedCallCandidateHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    var argument_type_kind: UInt8 = 0u8
                    if argument_count == 1usize {
                        argument_type_kind = bounded_literal_type_kind(
                            bytes,
                            next_source,
                            close_start,
                        )
                    }
                    var argument_type_count: UIntSize = bounded_argument_type_count(
                        bytes,
                        next_source,
                        close_start,
                    )
                    var best_type_specificity: UInt8 = 0u8
                    var best_generic_count: UIntSize = 33usize
                    var best_return_type: UInt8 = 0u8
                    var best_match_count: UIntSize = 0usize
                    for candidate_index in candidates.indices {
                        if candidates[candidate_index].return_type_kind <= 5u8 {
                            var return_type_is_eligible: Bool = false
                            if candidates[candidate_index].return_type_kind >= 1u8 {
                                return_type_is_eligible = true
                            } else {
                                if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                    return_type_is_eligible = true
                                } else {
                                    if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                        return_type_is_eligible = true
                                    } else {
                                        if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                            return_type_is_eligible = true
                                        }
                                    }
                                }
                            }
                            if return_type_is_eligible {
                                if candidates[candidate_index].generic_parameter_count <= 32usize {
                                    if candidates[candidate_index].parameter_type_kind <= 5u8 {
                                        if candidates[candidate_index].generic_bound_kind <= 3u8 {
                                            var bound_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_parameter_count != 0usize {
                                                bound_is_eligible = true
                                            } else {
                                                if candidates[candidate_index].generic_bound_kind == 0u8 {
                                                    bound_is_eligible = true
                                                }
                                            }
                                            if bound_is_eligible {
                                            var substitution_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_substitution_kind == 0u8 {
                                                substitution_is_eligible = true
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if substitution_is_eligible {
                                        var parameter_matches: Bool = false
                                        var type_specificity: UInt8 = 0u8
                                        if candidates[candidate_index].parameter_count == argument_count {
                                            var has_parameter_type_span: Bool = false
                                            if candidates[candidate_index].parameter_type_start != 0u16 {
                                                has_parameter_type_span = true
                                            } else {
                                                if candidates[candidate_index].parameter_type_end != 0u16 {
                                                    has_parameter_type_span = true
                                                }
                                            }
                                            if has_parameter_type_span {
                                                if candidates[candidate_index].parameter_type_start < candidates[candidate_index].parameter_type_end {
                                                    let parameter_type_start: UIntSize = candidates[candidate_index].parameter_type_start as UIntSize
                                                    let parameter_type_end: UIntSize = candidates[candidate_index].parameter_type_end as UIntSize
                                                    if parameter_type_end <= source_length {
                                                        if argument_type_count == argument_count {
                                                            if bounded_parameter_type_count(bytes, parameter_type_start, parameter_type_end) == argument_count {
                                                                if argument_count <= 32usize {
                                                                    parameter_matches = true
                                                                    var parameter_index: UIntSize = 0usize
                                                                    while parameter_index < argument_count {
                                                                        let expected_type: UInt8 = bounded_parameter_type_kind_at(bytes, parameter_type_start, parameter_type_end, parameter_index)
                                                                        var actual_type: UInt8 = 0u8
                                                                        if argument_count == 1usize {
                                                                            actual_type = argument_type_kind
                                                                        } else {
                                                                            actual_type = bounded_argument_type_kind_at(bytes, next_source, close_start, parameter_index)
                                                                        }
                                                                        if expected_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if actual_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if expected_type != actual_type {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        parameter_index = parameter_index + 1usize
                                                                    }
                                                                    if parameter_matches {
                                                                        type_specificity = 2u8
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                        } else {
                                                        if candidates[candidate_index].parameter_type_kind == argument_type_kind {
                                                            parameter_matches = true
                                                            type_specificity = 2u8
                                                        }
                                                    }
                                                } else {
                                                    if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if !bounded_generic_bound_matches(bytes, next_source, close_start, argument_count, argument_type_kind, candidates[candidate_index].generic_bound_kind) {
                                                parameter_matches = false
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if argument_count != 1usize {
                                                    parameter_matches = false
                                                } else {
                                                    if argument_type_kind == 0u8 {
                                                        parameter_matches = false
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                    if !bounded_same_argument_type_matches(bytes, next_source, close_start, argument_count) {
                                                        parameter_matches = false
                                                    }
                                                } else {
                                                    if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                        if !bounded_all_argument_types_known(bytes, next_source, close_start, argument_count) {
                                                            parameter_matches = false
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].name_start < candidates[candidate_index].name_end {
                                                if candidates[candidate_index].name_end <= source_length {
                                                    if candidates[candidate_index].name_end - candidates[candidate_index].name_start == callee_end - callee_start {
                                                    var equal: Bool = true
                                                    var compare_index: UIntSize = 0usize
                                                    while compare_index < callee_end - callee_start {
                                                        if bytes[candidates[candidate_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                            equal = false
                                                            break
                                                        }
                                                        compare_index = compare_index + 1usize
                                                    }
                                                    if equal {
                                                        var selected_return_type: UInt8 = candidates[candidate_index].return_type_kind
                                                        if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                            selected_return_type = argument_type_kind
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                                selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                            } else {
                                                                if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                                    selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                                }
                                                            }
                                                        }
                                                        if type_specificity > best_type_specificity {
                                                            best_type_specificity = type_specificity
                                                            best_generic_count = candidates[candidate_index].generic_parameter_count
                                                            best_return_type = selected_return_type
                                                            best_match_count = 1usize
                                                        } else {
                                                            if type_specificity == best_type_specificity {
                                                                if candidates[candidate_index].generic_parameter_count < best_generic_count {
                                                                    best_generic_count = candidates[candidate_index].generic_parameter_count
                                                                    best_return_type = selected_return_type
                                                                    best_match_count = 1usize
                                                                } else {
                                                                    if candidates[candidate_index].generic_parameter_count == best_generic_count {
                                                                        best_match_count = best_match_count + 1usize
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    if best_match_count == 1usize {
                        output[slot] = TypedExpressionHeader {
                            expression_kind: 8u8,
                            type_kind: best_return_type,
                            start: callee_start,
                            end: close_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by the deepest visible caller-owned lexical
/// binding. Matching is exact byte equality, bindings with an invalid source
/// span/type are ignored, and later bindings win equal-depth ties. This is a
/// bounded shadowing prototype; it does not resolve regions, aliases,
/// generics, or user-defined types.
@export(name: "jadren_selfhost_infer_scoped_name_types", abi: "C")
@noalloc
pub fn infer_scoped_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedScopedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < next_source - token_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                var should_select: Bool = false
                                                if !selected {
                                                    should_select = true
                                                } else {
                                                    if bindings[binding_index].scope_depth >= selected_scope {
                                                        should_select = true
                                                    }
                                                }
                                                if should_select {
                                                    selected = true
                                                    selected_type = bindings[binding_index].type_kind
                                                    selected_scope = bindings[binding_index].scope_depth
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 6u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by a bounded caller-owned visibility region.
/// Invalid name/region spans and out-of-region tokens are ignored. This is a
/// region-aware prototype, not a complete alias, generic, or user-type
/// resolver. Region boundaries must align with the declared delimiter depth;
/// a span that cuts through a nested block is ignored.
fn delimiter_depth_at(bytes: read Slice<UInt8>, position: UIntSize) -> UIntSize {
    var cursor: UIntSize = 0usize
    var depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x29u8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x5Du8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x28u8 {
                depth = depth + 1usize
            }
            if symbol == 0x5Bu8 {
                depth = depth + 1usize
            }
        }
        cursor = info.end
    }
    return depth
}

/// Returns the top delimiter kind immediately before `position`, or `0xff`
/// for an unmatched/mismatched delimiter. Region boundaries compare this
/// value in addition to numeric depth so `(`/`[` pairs cannot be confused.
fn delimiter_top_at(bytes: read Slice<UInt8>, position: UIntSize) -> UInt8 {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return 0xffu8
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return 0xffu8
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    if stack_count == 0usize {
        return 0u8
    }
    return stack[stack_count - 1usize]
}

/// Validates the complete delimiter prefix before region name resolution.
/// This bounded hand-off rejects unmatched/mismatched closers and overflow so
/// malformed source cannot produce typed-name records.
fn delimiters_well_formed_through(bytes: read Slice<UInt8>, position: UIntSize) -> Bool {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return false
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return false
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    return true
}

@export(name: "jadren_selfhost_infer_region_name_types", abi: "C")
@noalloc
pub fn infer_region_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedRegionNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    if !delimiters_well_formed_through(bytes, end) {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                var selected_region_width: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].region_start < bindings[binding_index].region_end {
                                        if bindings[binding_index].region_end <= source_length {
                                            if bindings[binding_index].name_start >= bindings[binding_index].region_start {
                                                if bindings[binding_index].name_end <= bindings[binding_index].region_end {
                                                    if bindings[binding_index].region_start <= token_start {
                                                        if next_source <= bindings[binding_index].region_end {
                                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_start) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_end) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_end) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) != delimiter_top_at(bytes, bindings[binding_index].region_end) {
                                                    continue
                                                }
                                                if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                                                    var equal: Bool = true
                                                                    var compare_index: UIntSize = 0usize
                                                                    while compare_index < next_source - token_start {
                                                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                                            equal = false
                                                                            break
                                                                        }
                                                                        compare_index = compare_index + 1usize
                                                                    }
                                                                    if equal {
                                                                        var should_select: Bool = false
                                                                        var region_width: UIntSize = bindings[binding_index].region_end - bindings[binding_index].region_start
                                                                        if !selected {
                                                                            should_select = true
                                                                        } else {
                                                                            if bindings[binding_index].scope_depth > selected_scope {
                                                                                should_select = true
                                                                            } else {
                                                                                if bindings[binding_index].scope_depth == selected_scope {
                                                                                    if region_width <= selected_region_width {
                                                                                        should_select = true
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                        if should_select {
                                                                            selected = true
                                                                            selected_type = bindings[binding_index].type_kind
                                                                            selected_scope = bindings[binding_index].scope_depth
                                                                            selected_region_width = region_width
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 7u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only type components from an explicit `[start,end)` type
/// span. Path identifiers, capability/function keywords and delimiters are
/// preserved in source order with caller-owned output. No type resolution,
/// alias lookup, generic substitution or malformed-type recovery is done.
@export(name: "jadren_selfhost_parse_type_components", abi: "C")
@noalloc
pub fn parse_type_components(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypeComponentHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            var component_kind: UInt8 = type_component_kind(
                bytes,
                info.kind,
                token_start,
                next_source,
            )
            var component_end: UIntSize = next_source
            if symbol == 0x2Du8 {
                if next_source < end {
                    if bytes[next_source] == 0x3Eu8 {
                        component_kind = 14u8
                        component_end = next_source + 1usize
                    }
                }
            }
            if component_kind != 0u8 {
                let component_depth: UIntSize = delimiter_depth
                if component_kind == 5u8 {
                    if delimiter_depth > 0usize {
                        delimiter_depth = delimiter_depth - 1usize
                    }
                } else {
                    if component_kind == 7u8 {
                        if delimiter_depth > 0usize {
                            delimiter_depth = delimiter_depth - 1usize
                        }
                    } else {
                        if component_kind == 9u8 {
                            if delimiter_depth > 0usize {
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
                output[slot] = TypeComponentHeader {
                    kind: component_kind,
                    start: token_start,
                    end: component_end,
                    depth: component_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                if component_kind == 4u8 {
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if component_kind == 6u8 {
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if component_kind == 8u8 {
                            delimiter_depth = delimiter_depth + 1usize
                        }
                    }
                }
                source_index = component_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only match-arm spans from an explicit match-body range.
/// Patterns are bounded by a top-level `=>`; an optional top-level `if`
/// introduces a guard span. Arm bodies may be a balanced `{...}` block or an
/// expression ending at a top-level comma/semicolon. Pattern matching,
/// exhaustiveness, guard typing and recovery remain later AST/type stages.
@export(name: "jadren_selfhost_parse_match_arms", abi: "C")
@noalloc
pub fn parse_match_arms(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<MatchArmHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let first_info: TokenInfo = scan_token_info(bytes, source_index, end)
            if first_info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = first_info.start
            var pattern_end: UIntSize = end
            var guard_start: UIntSize = end
            var guard_end: UIntSize = end
            var arrow_start: UIntSize = end
            var arrow_end: UIntSize = end
            var pattern_depth: UIntSize = 0usize
            var guard_active: Bool = false
            var pattern_cursor: UIntSize = pattern_start
            while pattern_cursor < end {
                let info: TokenInfo = scan_token_info(bytes, pattern_cursor, end)
                if info.start >= end {
                    pattern_cursor = end
                    break
                }
                let token_start: UIntSize = info.start
                let next_source: UIntSize = info.end
                var symbol: UInt8 = 0u8
                if info.kind == 3u8 {
                    symbol = bytes[token_start]
                }
                if symbol == 0x28u8 {
                    pattern_depth = pattern_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        pattern_depth = pattern_depth + 1usize
                    } else {
                        if symbol == 0x29u8 {
                            if pattern_depth > 0usize {
                                pattern_depth = pattern_depth - 1usize
                            }
                        } else {
                            if symbol == 0x5Du8 {
                                if pattern_depth > 0usize {
                                    pattern_depth = pattern_depth - 1usize
                                }
                            }
                        }
                    }
                }
                if symbol == 0x3Du8 {
                    if next_source < end {
                        if bytes[next_source] == 0x3Eu8 {
                            if pattern_depth == 0usize {
                                arrow_start = token_start
                                arrow_end = next_source + 1usize
                                if !guard_active {
                                    pattern_end = arrow_start
                                } else {
                                    guard_end = arrow_start
                                }
                                pattern_cursor = arrow_end
                                break
                            }
                        }
                    }
                }
                if info.kind == 1u8 {
                    let width: UIntSize = next_source - token_start
                    if width == 2usize {
                        if bytes[token_start] == 0x69u8 {
                            if bytes[token_start + 1usize] == 0x66u8 {
                                if pattern_depth == 0usize {
                                    if !guard_active {
                                        pattern_end = token_start
                                        guard_start = next_source
                                        guard_active = true
                                    }
                                }
                            }
                        }
                    }
                }
                pattern_cursor = next_source
            }
            if arrow_start >= end {
                source_index = end
                break
            }
            if !guard_active {
                pattern_end = arrow_start
            }
            var body_start: UIntSize = end
            var body_end: UIntSize = end
            let body_info: TokenInfo = scan_token_info(bytes, arrow_end, end)
            if body_info.start < end {
                body_start = body_info.start
                var body_cursor: UIntSize = body_info.start
                var body_depth: UIntSize = 0usize
                var body_block: Bool = false
                if bytes[body_info.start] == 0x7Bu8 {
                    body_block = true
                    body_depth = 1usize
                    body_cursor = body_info.end
                }
                while body_cursor < end {
                    let body_token: TokenInfo = scan_token_info(bytes, body_cursor, end)
                    if body_token.start >= end {
                        body_cursor = end
                        break
                    }
                    var body_symbol: UInt8 = 0u8
                    if body_token.kind == 3u8 {
                        body_symbol = bytes[body_token.start]
                    }
                    if body_block {
                        if body_symbol == 0x7Bu8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x7Du8 {
                                if body_depth > 0usize {
                                    body_depth = body_depth - 1usize
                                }
                                if body_depth == 0usize {
                                    body_end = body_token.end
                                    body_cursor = body_token.end
                                    break
                                }
                            }
                        }
                    } else {
                        if body_symbol == 0x28u8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x5Bu8 {
                                body_depth = body_depth + 1usize
                            } else {
                                if body_symbol == 0x29u8 {
                                    if body_depth > 0usize {
                                        body_depth = body_depth - 1usize
                                    }
                                } else {
                                    if body_symbol == 0x5Du8 {
                                        if body_depth > 0usize {
                                            body_depth = body_depth - 1usize
                                        }
                                    } else {
                                        if body_depth == 0usize {
                                            if body_symbol == 0x2Cu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                            if body_symbol == 0x3Bu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    body_cursor = body_token.end
                }
                if body_end == end {
                    body_end = body_cursor
                }
            }
            output[slot] = MatchArmHeader {
                pattern_start: pattern_start,
                pattern_end: pattern_end,
                guard_start: guard_start,
                guard_end: guard_end,
                body_start: body_start,
                body_end: body_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = body_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if bytes[separator.start] == 0x2Cu8 {
                        source_index = separator.end
                    } else {
                        if separator.start == source_index {
                            if bytes[separator.start] == 0x3Bu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits top-level syntax-only pattern nodes from an explicit pattern range.
/// Wildcards, qualified paths, literals and constructor paths are retained as
/// bounded spans. Constructor payloads are paired with one scalar delimiter
/// depth counter; binding, exhaustiveness, type checking and recovery are
/// intentionally deferred to later compiler stages.
@export(name: "jadren_selfhost_parse_pattern_headers", abi: "C")
@noalloc
pub fn parse_pattern_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var pattern_end: UIntSize = next_source
            var payload_start: UIntSize = end
            var payload_end: UIntSize = end
            var pattern_kind: UInt8 = 2u8
            var pattern_depth: UIntSize = 0usize
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[pattern_start]
            }
            if info.kind == 1u8 {
                if next_source - pattern_start == 1usize {
                    if bytes[pattern_start] == 0x5Fu8 {
                        pattern_kind = 1u8
                    }
                }
            }
            if pattern_kind == 1u8 {
                pattern_kind = 1u8
            } else {
                let bool_kind: UInt8 = boolean_literal_kind(
                    bytes,
                    info.kind,
                    pattern_start,
                    next_source,
                )
                if info.kind == 2u8 {
                    pattern_kind = 3u8
                } else {
                    if bool_kind != 0u8 {
                        pattern_kind = 3u8
                    } else {
                        if symbol == 0x22u8 {
                            pattern_kind = 3u8
                        } else {
                            if symbol == 0x27u8 {
                                pattern_kind = 3u8
                            }
                        }
                    }
                }
            }
            if pattern_kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = next_source
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    pattern_end = quoted.end
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    if pattern_end == next_source {
                        pattern_end = cursor
                    }
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = next_source
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        pattern_end = quoted.end
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        if pattern_end == next_source {
                            pattern_end = cursor
                        }
                    }
                }
            } else {
                if info.kind == 1u8 {
                    var path_cursor: UIntSize = next_source
                    var path_done: Bool = false
                    while path_cursor < end {
                        let separator: TokenInfo = scan_token_info(bytes, path_cursor, end)
                        if separator.start >= end {
                            path_cursor = end
                            break
                        }
                        var separator_symbol: UInt8 = 0u8
                        if separator.kind == 3u8 {
                            separator_symbol = bytes[separator.start]
                        }
                        if separator_symbol == 0x2Eu8 {
                            let segment: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if segment.start < end {
                                if segment.kind == 1u8 {
                                    pattern_end = segment.end
                                    path_cursor = segment.end
                                    continue
                                }
                            }
                        }
                        if separator_symbol == 0x3Au8 {
                            let second: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if second.start < end {
                                if second.kind == 3u8 {
                                    if bytes[second.start] == 0x3Au8 {
                                        let segment: TokenInfo = scan_token_info(
                                            bytes,
                                            second.end,
                                            end,
                                        )
                                        if segment.start < end {
                                            if segment.kind == 1u8 {
                                                pattern_end = segment.end
                                                path_cursor = segment.end
                                                continue
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        path_done = true
                        break
                    }
                    if path_done {
                        path_cursor = pattern_end
                    }
                    let constructor: TokenInfo = scan_token_info(bytes, pattern_end, end)
                    if constructor.start < end {
                        if constructor.kind == 3u8 {
                            if bytes[constructor.start] == 0x28u8 {
                                pattern_kind = 4u8
                                payload_start = constructor.end
                                var cursor: UIntSize = constructor.end
                                var nested_depth: UIntSize = 1usize
                                while cursor < end {
                                    let payload: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if payload.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var payload_symbol: UInt8 = 0u8
                                    if payload.kind == 3u8 {
                                        payload_symbol = bytes[payload.start]
                                    }
                                    if payload_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if payload_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                payload_end = payload.start
                                                pattern_end = payload.end
                                                cursor = payload.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = payload.end
                                }
                                if payload_end == end {
                                    payload_end = cursor
                                    pattern_end = cursor
                                }
                            }
                        }
                    }
                }
            }
            output[slot] = PatternHeader {
                kind: pattern_kind,
                start: pattern_start,
                end: pattern_end,
                payload_start: payload_start,
                payload_end: payload_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = pattern_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if separator.kind == 3u8 {
                        if bytes[separator.start] == 0x2Cu8 {
                            source_index = separator.end
                        } else {
                            if bytes[separator.start] == 0x7Cu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only binding candidates from an explicit pattern range.
/// Bare identifiers are bindings; wildcard, literal, qualified-path and
/// constructor-head identifiers are deliberately excluded. This is a bounded
/// pre-stage for later binding/exhaustiveness/type checking and does not
/// resolve names.
@export(name: "jadren_selfhost_parse_pattern_bindings", abi: "C")
@noalloc
pub fn parse_pattern_bindings(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternBindingHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var path_pending: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    path_pending = false
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        path_pending = false
                        continue
                    }
                }
            }
            if info.kind == 1u8 {
                var wildcard: Bool = false
                if info.end - info.start == 1usize {
                    if bytes[info.start] == 0x5Fu8 {
                        wildcard = true
                    }
                }
                let next: TokenInfo = scan_token_info(bytes, info.end, end)
                var next_symbol: UInt8 = 0u8
                if next.kind == 3u8 {
                    next_symbol = bytes[next.start]
                }
                var path_segment: Bool = path_pending
                if next_symbol == 0x2Eu8 {
                    path_segment = true
                } else {
                    if next_symbol == 0x3Au8 {
                        path_segment = true
                    } else {
                        if next_symbol == 0x28u8 {
                            path_segment = true
                        }
                    }
                }
                if !wildcard {
                    if !path_segment {
                        output[slot] = PatternBindingHeader {
                            kind: 1u8,
                            start: info.start,
                            end: info.end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        source_index = info.end
                        path_pending = false
                        break
                    }
                }
                source_index = info.end
                path_pending = false
                continue
            }
            if info.kind == 3u8 {
                if symbol == 0x28u8 {
                    delimiter_depth = delimiter_depth + 1usize
                    path_pending = false
                } else {
                    if symbol == 0x5Bu8 {
                        delimiter_depth = delimiter_depth + 1usize
                        path_pending = false
                    } else {
                        if symbol == 0x7Bu8 {
                            delimiter_depth = delimiter_depth + 1usize
                            path_pending = false
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth > 0usize {
                                    delimiter_depth = delimiter_depth - 1usize
                                }
                                path_pending = false
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth > 0usize {
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                    path_pending = false
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth > 0usize {
                                            delimiter_depth = delimiter_depth - 1usize
                                        }
                                        path_pending = false
                                    } else {
                                        if symbol == 0x2Eu8 {
                                            path_pending = true
                                        } else {
                                            if symbol == 0x3Au8 {
                                                path_pending = true
                                            } else {
                                                path_pending = false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                path_pending = false
            }
            source_index = info.end
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded delimiter recovery records for an explicit pattern range.
/// Quoted strings/chars are skipped, unmatched closers are reported at their
/// own span, and an unclosed opener is reported from the first opener to the
/// caller-provided `end`. Full expected-token diagnostics remain a later
/// parser stage.
@export(name: "jadren_selfhost_parse_pattern_recovery", abi: "C")
@noalloc
pub fn parse_pattern_recovery(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternRecoveryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth == 0usize {
                                    output[slot] = PatternRecoveryHeader {
                                        kind: 2u8,
                                        start: info.start,
                                        end: info.end,
                                        depth: 0usize,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = info.end
                                    break
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth == 0usize {
                                        output[slot] = PatternRecoveryHeader {
                                            kind: 2u8,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        source_index = info.end
                                        break
                                    }
                                    delimiter_depth = delimiter_depth - 1usize
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth == 0usize {
                                            output[slot] = PatternRecoveryHeader {
                                                kind: 2u8,
                                                start: info.start,
                                                end: info.end,
                                                depth: 0usize,
                                            }
                                            output_index = output_index + 1usize
                                            emitted = true
                                            source_index = info.end
                                            break
                                        }
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = info.end
        }
        if !emitted {
            if delimiter_depth > 0usize {
                output[slot] = PatternRecoveryHeader {
                    kind: 1u8,
                    start: first_open_start,
                    end: end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = end
                delimiter_depth = 0usize
                first_open_start = end
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first bounded delimiter diagnostic for an explicit pattern range.
/// The caller-owned `stack` stores opener bytes so a mismatched closer can
/// report the expected closer without a heap-backed parser stack. Quoted
/// string/char spans are skipped and the output is at most one record.
@export(name: "jadren_selfhost_parse_pattern_diagnostics", abi: "C")
@noalloc
pub fn parse_pattern_diagnostics(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternDiagnosticHeader>,
    stack: write Slice<UInt8>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    var output_index: UIntSize = 0usize
    var output_capacity: UIntSize = 0usize
    for slot in output.indices {
        output_capacity = output_capacity + 1usize
    }
    while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    stack[delimiter_depth] = symbol
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        stack[delimiter_depth] = symbol
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            stack[delimiter_depth] = symbol
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            var is_closer: Bool = false
                            if symbol == 0x29u8 {
                                is_closer = true
                            } else {
                                if symbol == 0x5Du8 {
                                    is_closer = true
                                } else {
                                    if symbol == 0x7Du8 {
                                        is_closer = true
                                    }
                                }
                            }
                            if is_closer {
                                if delimiter_depth == 0usize {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 1u8,
                                            expected: 0u8,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                let opener: UInt8 = stack[delimiter_depth - 1usize]
                                var expected: UInt8 = 0u8
                                if opener == 0x28u8 {
                                    expected = 0x29u8
                                } else {
                                    if opener == 0x5Bu8 {
                                        expected = 0x5Du8
                                    } else {
                                        expected = 0x7Du8
                                    }
                                }
                                if symbol != expected {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 3u8,
                                            expected: expected,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: delimiter_depth,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
            }
            source_index = info.end
    }
    if delimiter_depth > 0usize {
                let opener: UInt8 = stack[delimiter_depth - 1usize]
                var expected: UInt8 = 0u8
                if opener == 0x28u8 {
                    expected = 0x29u8
                } else {
                    if opener == 0x5Bu8 {
                        expected = 0x5Du8
                    } else {
                        expected = 0x7Du8
                    }
                }
                if output_capacity > 0usize {
                    output[0] = PatternDiagnosticHeader {
                        kind: 2u8,
                        expected: expected,
                        actual: 0u8,
                        start: first_open_start,
                        end: end,
                        depth: delimiter_depth,
                    }
                    output_index = 1usize
                }
        return output_index
    }
    return output_index
}

/// Executes the complete currently-supported frontend slice through one
/// stable C ABI entry point. The implementation composes the existing Jadren
/// lexer, structural summary, root AST index, function/statement scanners and
/// call-expression scanner. Detailed records stay in caller-owned storage so
/// the same contract is usable by static, dynamic and portable hosts.
@export(name: "jadren_selfhost_compile_frontend_stage2", abi: "C")
@noalloc
pub fn compile_frontend_stage2(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    tokens: write Slice<TokenInfo>,
    ast_items: write Slice<AstItemHeader>,
    function_headers: write Slice<FunctionHeader>,
    statements: write Slice<StatementHeader>,
    calls: write Slice<ExpressionCallHeader>,
) -> FrontendStage2Summary {
    var source_length: UIntSize = 0usize
    for index in bytes.indices {
        source_length = source_length + 1usize
    }
    if start > end {
        return FrontendStage2Summary {
            source_bytes: 0usize,
            tokens_emitted: 0usize,
            ast_items_emitted: 0usize,
            function_headers_emitted: 0usize,
            statements_emitted: 0usize,
            calls_emitted: 0usize,
            syntax_errors: 1usize,
            status_flags: 0usize,
        }
    }
    if end > source_length {
        return FrontendStage2Summary {
            source_bytes: 0usize,
            tokens_emitted: 0usize,
            ast_items_emitted: 0usize,
            function_headers_emitted: 0usize,
            statements_emitted: 0usize,
            calls_emitted: 0usize,
            syntax_errors: 1usize,
            status_flags: 0usize,
        }
    }

    let source_summary: ParseSummary = summarize_source(bytes, start, end)
    let token_count: UIntSize = lex_tokens(bytes, start, end, tokens)
    let ast_item_count: UIntSize = parse_ast_items(bytes, start, end, ast_items)
    let function_header_count: UIntSize = parse_function_headers(
        bytes,
        start,
        end,
        function_headers,
    )
    let statement_count: UIntSize = parse_statements(bytes, start, end, statements)
    let call_count: UIntSize = parse_expression_calls(bytes, start, end, calls)
    var status: UIntSize = 0usize
    if source_summary.errors == 0usize {
        status = 1usize
    }
    if token_count == source_summary.tokens {
        status = status + 2usize
    }
    return FrontendStage2Summary {
        source_bytes: end - start,
        tokens_emitted: token_count,
        ast_items_emitted: ast_item_count,
        function_headers_emitted: function_header_count,
        statements_emitted: statement_count,
        calls_emitted: call_count,
        syntax_errors: source_summary.errors,
        status_flags: status,
    }
}

@noalloc
fn stage2_is_int32_name(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Bool {
    if end - start != 5usize {
        return false
    }
    if bytes[start] != 0x49u8 {
        return false
    }
    if bytes[start + 1usize] != 0x6Eu8 {
        return false
    }
    if bytes[start + 2usize] != 0x74u8 {
        return false
    }
    if bytes[start + 3usize] != 0x33u8 {
        return false
    }
    return bytes[start + 4usize] == 0x32u8
}

/// Validates the explicit `-> Int32` suffix of one parameter-free function
/// header. Parameter parsing itself remains owned by `FunctionHeader`.
@noalloc
fn stage2_has_int32_result(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Bool {
    var cursor: UIntSize = signature_start
    var saw_dash: Bool = false
    var saw_arrow: Bool = false
    var saw_type: Bool = false
    while cursor < body_start {
        let info: TokenInfo = scan_token_info(bytes, cursor, body_start)
        if info.start >= body_start {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if !saw_arrow {
            if symbol == 0x2Du8 {
                saw_dash = true
            } else {
                if symbol == 0x3Eu8 {
                    if !saw_dash {
                        return false
                    }
                    saw_arrow = true
                } else {
                    if saw_dash {
                        return false
                    }
                }
            }
        } else {
            if saw_type {
                return false
            }
            if info.kind != 1u8 {
                return false
            }
            if !stage2_is_int32_name(bytes, info.start, info.end) {
                return false
            }
            saw_type = true
        }
        cursor = info.end
    }
    if !saw_arrow {
        return false
    }
    return saw_type
}

@noalloc
fn stage2_invalid_parameter_info() -> Stage2ParameterInfo {
    return Stage2ParameterInfo {
        valid: false,
        count: 0usize,
        name_start: 0usize,
        name_end: 0usize,
        second_name_start: 0usize,
        second_name_end: 0usize,
    }
}

/// Parses exactly one `name: Int32` parameter from the function signature.
/// The return type is checked independently by `stage2_has_int32_result`.
@noalloc
fn stage2_parse_single_i32_parameter(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Stage2ParameterInfo {
    let invalid: Stage2ParameterInfo = stage2_invalid_parameter_info()
    let opening: TokenInfo = scan_token_info(bytes, signature_start, body_start)
    if opening.kind != 3u8 {
        return invalid
    }
    if opening.start >= opening.end {
        return invalid
    }
    if bytes[opening.start] != 0x28u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, opening.end, body_start)
    if name.kind != 1u8 {
        return invalid
    }
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_start)
    if colon.kind != 3u8 {
        return invalid
    }
    if colon.start >= colon.end {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 {
        return invalid
    }
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_start)
    if type_name.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    let closing: TokenInfo = scan_token_info(bytes, type_name.end, body_start)
    if closing.kind != 3u8 {
        return invalid
    }
    if closing.start >= closing.end {
        return invalid
    }
    if bytes[closing.start] != 0x29u8 {
        return invalid
    }
    return Stage2ParameterInfo {
        valid: true,
        count: 1usize,
        name_start: name.start,
        name_end: name.end,
        second_name_start: 0usize,
        second_name_end: 0usize,
    }
}

@noalloc
fn stage2_parse_pair_i32_parameters(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Stage2ParameterInfo {
    let invalid: Stage2ParameterInfo = stage2_invalid_parameter_info()
    let opening: TokenInfo = scan_token_info(bytes, signature_start, body_start)
    if opening.kind != 3u8 {
        return invalid
    }
    if opening.start >= opening.end {
        return invalid
    }
    if bytes[opening.start] != 0x28u8 {
        return invalid
    }
    let first_name: TokenInfo = scan_token_info(bytes, opening.end, body_start)
    if first_name.kind != 1u8 {
        return invalid
    }
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_start)
    if first_colon.kind != 3u8 {
        return invalid
    }
    if first_colon.start >= first_colon.end {
        return invalid
    }
    if bytes[first_colon.start] != 0x3Au8 {
        return invalid
    }
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_start)
    if first_type.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) {
        return invalid
    }
    let comma: TokenInfo = scan_token_info(bytes, first_type.end, body_start)
    if comma.kind != 3u8 {
        return invalid
    }
    if comma.start >= comma.end {
        return invalid
    }
    if bytes[comma.start] != 0x2Cu8 {
        return invalid
    }
    let second_name: TokenInfo = scan_token_info(bytes, comma.end, body_start)
    if second_name.kind != 1u8 {
        return invalid
    }
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_start)
    if second_colon.kind != 3u8 {
        return invalid
    }
    if second_colon.start >= second_colon.end {
        return invalid
    }
    if bytes[second_colon.start] != 0x3Au8 {
        return invalid
    }
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_start)
    if second_type.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) {
        return invalid
    }
    let closing: TokenInfo = scan_token_info(bytes, second_type.end, body_start)
    if closing.kind != 3u8 {
        return invalid
    }
    if closing.start >= closing.end {
        return invalid
    }
    if bytes[closing.start] != 0x29u8 {
        return invalid
    }
    return Stage2ParameterInfo {
        valid: true,
        count: 2usize,
        name_start: first_name.start,
        name_end: first_name.end,
        second_name_start: second_name.start,
        second_name_end: second_name.end,
    }
}

@noalloc
fn stage2_same_bytes(
    bytes: read Slice<UInt8>,
    first_start: UIntSize,
    first_end: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
) -> Bool {
    if first_end - first_start != second_end - second_start {
        return false
    }
    var first: UIntSize = first_start
    var second: UIntSize = second_start
    while first < first_end {
        if bytes[first] != bytes[second] {
            return false
        }
        first = first + 1usize
        second = second + 1usize
    }
    return true
}

/// Parses one non-negative decimal Int32 literal. `2147483648` is the invalid
/// sentinel and cannot collide with the supported value range.
@noalloc
fn stage2_i32_literal_value(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let invalid: UIntSize = 2147483648usize
    if start >= end {
        return invalid
    }
    var value: UIntSize = 0usize
    var cursor: UIntSize = start
    while cursor < end {
        let byte: UInt8 = bytes[cursor]
        if byte < 0x30u8 {
            return invalid
        }
        if byte > 0x39u8 {
            return invalid
        }
        let digit: UIntSize = byte as UIntSize - 48usize
        if value > 214748364usize {
            return invalid
        }
        if value == 214748364usize {
            if digit > 7usize {
                return invalid
            }
        }
        value = value * 10usize + digit
        cursor = cursor + 1usize
    }
    return value
}

/// Recognizes the first parameter-aware executable slice: `return name op
/// literal;`, where `name` is the one `Int32` parameter from the function
/// header. The parameter is SSA value zero and the literal becomes value one.
@noalloc
fn stage2_invalid_parameter_return_expression() -> Stage2ReturnExpression {
    return Stage2ReturnExpression {
        kind: 0u8,
        grouping_kind: 0u8,
        operator_opcode: 0u8,
        second_operator_opcode: 0u8,
        third_operator_opcode: 0u8,
        fourth_operator_opcode: 0u8,
        left_value: 2147483648usize,
        right_value: 2147483648usize,
        third_value: 2147483648usize,
        fourth_value: 2147483648usize,
        fifth_value: 2147483648usize,
        left_start: 0usize,
        left_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fifth_start: 0usize,
        fifth_end: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

@noalloc
fn stage2_parse_parameter_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    parameter_name_start: UIntSize,
    parameter_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        name.start,
        name.end,
        parameter_name_start,
        parameter_name_end,
    ) {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, name.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    var operator_opcode: UInt8 = 0u8
    if bytes[operator.start] == 0x2Bu8 {
        operator_opcode = 2u8
    }
    if bytes[operator.start] == 0x2Du8 {
        operator_opcode = 3u8
    }
    if bytes[operator.start] == 0x2Au8 {
        operator_opcode = 4u8
    }
    if operator_opcode == 0u8 {
        return invalid
    }
    let literal: TokenInfo = scan_token_info(bytes, operator.end, end)
    if literal.kind != 2u8 {
        return invalid
    }
    let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
    if value == 2147483648usize {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, literal.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 6u8
    expression.operator_opcode = operator_opcode
    expression.left_value = 0usize
    expression.right_value = value
    expression.left_start = name.start
    expression.left_end = name.end
    expression.right_start = literal.start
    expression.right_end = literal.end
    expression.expression_start = name.start
    expression.expression_end = literal.end
    expression.statement_end = semicolon.end
    return expression
}

@noalloc
fn stage2_parse_parameter_pair_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    first_name_start: UIntSize,
    first_name_end: UIntSize,
    second_name_start: UIntSize,
    second_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let first_name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if first_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(bytes, first_name.start, first_name.end, first_name_start, first_name_end) {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, first_name.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    var operator_opcode: UInt8 = 0u8
    if bytes[operator.start] == 0x2Bu8 {
        operator_opcode = 2u8
    }
    if bytes[operator.start] == 0x2Du8 {
        operator_opcode = 3u8
    }
    if bytes[operator.start] == 0x2Au8 {
        operator_opcode = 4u8
    }
    if operator_opcode == 0u8 {
        return invalid
    }
    let second_name: TokenInfo = scan_token_info(bytes, operator.end, end)
    if second_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        second_name.start,
        second_name.end,
        second_name_start,
        second_name_end,
    ) {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, second_name.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 7u8
    expression.operator_opcode = operator_opcode
    expression.left_value = 0usize
    expression.right_value = 1usize
    expression.left_start = first_name.start
    expression.left_end = first_name.end
    expression.right_start = second_name.start
    expression.right_end = second_name.end
    expression.expression_start = first_name.start
    expression.expression_end = second_name.end
    expression.statement_end = semicolon.end
    return expression
}

@noalloc
fn stage2_binary_opcode(byte: UInt8) -> UInt8 {
    if byte == 0x2Bu8 {
        return 2u8
    }
    if byte == 0x2Du8 {
        return 3u8
    }
    if byte == 0x2Au8 {
        return 4u8
    }
    return 0u8
}

@noalloc
fn stage2_token_is_symbol(
    bytes: read Slice<UInt8>,
    kind: UInt8,
    start: UIntSize,
    end: UIntSize,
    symbol: UInt8,
) -> Bool {
    if kind != 3u8 {
        return false
    }
    if start >= end {
        return false
    }
    return bytes[start] == symbol
}

@noalloc
fn stage2_invalid_streaming_expression_plan() -> Stage2StreamingExpressionPlan {
    return Stage2StreamingExpressionPlan {
        valid: false,
        literal_count: 0usize,
        operator_count: 0usize,
        grouping_kind: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        second_grouping_kind: 0usize,
        second_group_start: 0usize,
        second_group_end: 0usize,
        first_value: 2147483648usize,
        first_start: 0usize,
        first_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

/// Scans a longer return expression without retaining one field per operand.
/// Five through sixteen binary operators are accepted. The final JIR output
/// slice is the caller-owned plan table used by the emission pass.
@noalloc
fn stage2_parse_streaming_return_i32_expression_plan(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2StreamingExpressionPlan {
    let invalid: Stage2StreamingExpressionPlan = stage2_invalid_streaming_expression_plan()
    let invalid_value: UIntSize = 2147483648usize
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    var cursor: UIntSize = keyword.end
    var expecting_operand: Bool = true
    var literal_count: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var grouping_kind: UIntSize = 0usize
    var second_grouping_kind: UIntSize = 0usize
    var group_open: Bool = false
    var group_nested: Bool = false
    var group_count: UIntSize = 0usize
    var active_grouping_kind: UIntSize = 0usize
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var second_group_start: UIntSize = 0usize
    var second_group_end: UIntSize = 0usize
    var first_value: UIntSize = invalid_value
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var expression_start: UIntSize = 0usize
    var last_literal_end: UIntSize = 0usize

    while cursor < end {
        if expecting_operand {
            var literal: TokenInfo = scan_token_info(bytes, cursor, end)
            if stage2_token_is_symbol(
                bytes,
                literal.kind,
                literal.start,
                literal.end,
                0x28u8,
            ) {
                if group_open {
                    if group_nested {
                        return invalid
                    }
                    if literal_count + 1usize != active_grouping_kind {
                        return invalid
                    }
                    group_nested = true
                    literal = scan_token_info(bytes, literal.end, end)
                } else {
                    if group_count >= 2usize {
                        return invalid
                    }
                    group_open = true
                    active_grouping_kind = literal_count + 1usize
                    group_count = group_count + 1usize
                    if group_count == 1usize {
                        grouping_kind = active_grouping_kind
                        group_start = literal.start
                    } else {
                        second_grouping_kind = active_grouping_kind
                        second_group_start = literal.start
                    }
                    if literal_count == 0usize {
                        expression_start = literal.start
                    }
                    literal = scan_token_info(bytes, literal.end, end)
                }
            }
            if group_open {
                if !group_nested {
                    if stage2_token_is_symbol(
                        bytes,
                        literal.kind,
                        literal.start,
                        literal.end,
                        0x28u8,
                    ) {
                        group_nested = true
                        literal = scan_token_info(bytes, literal.end, end)
                    }
                }
            }
            if literal.kind != 2u8 {
                return invalid
            }
            let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
            if value == invalid_value {
                return invalid
            }
            if literal_count == 0usize {
                first_value = value
                first_start = literal.start
                first_end = literal.end
                if expression_start == 0usize {
                    expression_start = literal.start
                }
            }
            literal_count = literal_count + 1usize
            if literal_count > 17usize {
                return invalid
            }
            last_literal_end = literal.end
            cursor = literal.end
            expecting_operand = false
        } else {
            var separator: TokenInfo = scan_token_info(bytes, cursor, end)
            if separator.start >= end {
                return invalid
            }
            if group_open {
                if literal_count == active_grouping_kind + 1usize {
                    if !stage2_token_is_symbol(
                        bytes,
                        separator.kind,
                        separator.start,
                        separator.end,
                        0x29u8,
                    ) {
                        return invalid
                    }
                    let first_closing_end: UIntSize = separator.end
                    var closing: TokenInfo = separator
                    if group_nested {
                        closing = scan_token_info(bytes, first_closing_end, end)
                        if !stage2_token_is_symbol(
                            bytes,
                            closing.kind,
                            closing.start,
                            closing.end,
                            0x29u8,
                        ) {
                            return invalid
                        }
                    }
                    if group_count == 1usize {
                        group_end = closing.end
                    } else {
                        second_group_end = closing.end
                    }
                    group_open = false
                    cursor = closing.end
                    separator = scan_token_info(bytes, cursor, end)
                    if separator.start >= end {
                        return invalid
                    }
                }
            }
            if stage2_token_is_symbol(
                bytes,
                separator.kind,
                separator.start,
                separator.end,
                0x3Bu8,
            ) {
                if group_open {
                    return invalid
                }
                if operator_count < 5usize {
                    return invalid
                }
                if operator_count > 16usize {
                    return invalid
                }
                if operator_count + 1usize != literal_count {
                    return invalid
                }
                let trailing: TokenInfo = scan_token_info(bytes, separator.end, end)
                if trailing.start < end {
                    return invalid
                }
                var expression_end: UIntSize = last_literal_end
                if second_grouping_kind + 1usize == literal_count {
                    expression_end = second_group_end
                } else if grouping_kind + 1usize == literal_count {
                    expression_end = group_end
                }
                return Stage2StreamingExpressionPlan {
                    valid: true,
                    literal_count: literal_count,
                    operator_count: operator_count,
                    grouping_kind: grouping_kind,
                    group_start: group_start,
                    group_end: group_end,
                    second_grouping_kind: second_grouping_kind,
                    second_group_start: second_group_start,
                    second_group_end: second_group_end,
                    first_value: first_value,
                    first_start: first_start,
                    first_end: first_end,
                    expression_start: expression_start,
                    expression_end: expression_end,
                    statement_end: separator.end,
                }
            }
            if separator.kind != 3u8 {
                return invalid
            }
            let opcode: UInt8 = stage2_binary_opcode(bytes[separator.start])
            if opcode == 0u8 {
                return invalid
            }
            operator_count = operator_count + 1usize
            if operator_count > 16usize {
                return invalid
            }
            cursor = separator.end
            expecting_operand = true
        }
    }
    return invalid
}

@noalloc
fn stage2_invalid_return_expression() -> Stage2ReturnExpression {
    return Stage2ReturnExpression {
        kind: 0u8,
        grouping_kind: 0u8,
        operator_opcode: 0u8,
        second_operator_opcode: 0u8,
        third_operator_opcode: 0u8,
        fourth_operator_opcode: 0u8,
        left_value: 2147483648usize,
        right_value: 2147483648usize,
        third_value: 2147483648usize,
        fourth_value: 2147483648usize,
        fifth_value: 2147483648usize,
        left_start: 0usize,
        left_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fifth_start: 0usize,
        fifth_end: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

/// Recognizes the grouped long-plan slice before the legacy one-/two-operator
/// paths. Exactly one non-nested group must wrap two adjacent literals, and
/// the complete expression must contain three or four binary operators.
@noalloc
fn stage2_parse_grouped_long_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_return_expression()
    let invalid_value: UIntSize = 2147483648usize
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    var cursor: UIntSize = keyword.end
    var expecting_operand: Bool = true
    var operand_count: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var grouping_kind: UInt8 = 0u8
    var group_open: Bool = false
    var group_closed: Bool = false
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var expression_start: UIntSize = 0usize

    var operator_opcode: UInt8 = 0u8
    var second_operator_opcode: UInt8 = 0u8
    var third_operator_opcode: UInt8 = 0u8
    var fourth_operator_opcode: UInt8 = 0u8

    var left_value: UIntSize = invalid_value
    var right_value: UIntSize = invalid_value
    var third_value: UIntSize = invalid_value
    var fourth_value: UIntSize = invalid_value
    var fifth_value: UIntSize = invalid_value
    var left_start: UIntSize = 0usize
    var left_end: UIntSize = 0usize
    var right_start: UIntSize = 0usize
    var right_end: UIntSize = 0usize
    var third_start: UIntSize = 0usize
    var third_end: UIntSize = 0usize
    var fourth_start: UIntSize = 0usize
    var fourth_end: UIntSize = 0usize
    var fifth_start: UIntSize = 0usize
    var fifth_end: UIntSize = 0usize

    while cursor < end {
        if expecting_operand {
            var literal: TokenInfo = scan_token_info(bytes, cursor, end)
            if stage2_token_is_symbol(
                bytes,
                literal.kind,
                literal.start,
                literal.end,
                0x28u8,
            ) {
                if group_open {
                    return invalid
                }
                if group_closed {
                    return invalid
                }
                group_open = true
                grouping_kind = (operand_count + 1usize) as UInt8
                group_start = literal.start
                if operand_count == 0usize {
                    expression_start = group_start
                }
                literal = scan_token_info(bytes, literal.end, end)
            }
            if literal.kind != 2u8 {
                return invalid
            }
            if operand_count >= 5usize {
                return invalid
            }
            let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
            if value == invalid_value {
                return invalid
            }
            if operand_count == 0usize {
                left_value = value
                left_start = literal.start
                left_end = literal.end
                if expression_start == 0usize {
                    expression_start = literal.start
                }
            } else if operand_count == 1usize {
                right_value = value
                right_start = literal.start
                right_end = literal.end
            } else if operand_count == 2usize {
                third_value = value
                third_start = literal.start
                third_end = literal.end
            } else if operand_count == 3usize {
                fourth_value = value
                fourth_start = literal.start
                fourth_end = literal.end
            } else {
                fifth_value = value
                fifth_start = literal.start
                fifth_end = literal.end
            }
            operand_count = operand_count + 1usize
            cursor = literal.end
            expecting_operand = false
        } else {
            var separator: TokenInfo = scan_token_info(bytes, cursor, end)
            if separator.start >= end {
                return invalid
            }
            if group_open {
                let grouped_operand_end: UIntSize = (grouping_kind as UIntSize) + 1usize
                if operand_count == grouped_operand_end {
                    if !stage2_token_is_symbol(
                        bytes,
                        separator.kind,
                        separator.start,
                        separator.end,
                        0x29u8,
                    ) {
                        return invalid
                    }
                    group_end = separator.end
                    group_open = false
                    group_closed = true
                    cursor = separator.end
                    separator = scan_token_info(bytes, cursor, end)
                    if separator.start >= end {
                        return invalid
                    }
                }
            }
            if stage2_token_is_symbol(
                bytes,
                separator.kind,
                separator.start,
                separator.end,
                0x3Bu8,
            ) {
                if group_open {
                    return invalid
                }
                if !group_closed {
                    return invalid
                }
                if operand_count < 4usize {
                    return invalid
                }
                if operand_count > 5usize {
                    return invalid
                }
                if operator_count + 1usize != operand_count {
                    return invalid
                }
                let trailing: TokenInfo = scan_token_info(bytes, separator.end, end)
                if trailing.start < end {
                    return invalid
                }
                var expression_end: UIntSize = fourth_end
                var kind: UInt8 = 4u8
                if operand_count == 5usize {
                    expression_end = fifth_end
                    kind = 5u8
                }
                if (grouping_kind as UIntSize) + 1usize == operand_count {
                    expression_end = group_end
                }
                return Stage2ReturnExpression {
                    kind: kind,
                    grouping_kind: grouping_kind,
                    operator_opcode: operator_opcode,
                    second_operator_opcode: second_operator_opcode,
                    third_operator_opcode: third_operator_opcode,
                    fourth_operator_opcode: fourth_operator_opcode,
                    left_value: left_value,
                    right_value: right_value,
                    third_value: third_value,
                    fourth_value: fourth_value,
                    fifth_value: fifth_value,
                    left_start: left_start,
                    left_end: left_end,
                    right_start: right_start,
                    right_end: right_end,
                    third_start: third_start,
                    third_end: third_end,
                    fourth_start: fourth_start,
                    fourth_end: fourth_end,
                    fifth_start: fifth_start,
                    fifth_end: fifth_end,
                    group_start: group_start,
                    group_end: group_end,
                    expression_start: expression_start,
                    expression_end: expression_end,
                    statement_end: separator.end,
                }
            }
            if separator.kind != 3u8 {
                return invalid
            }
            if operator_count >= 4usize {
                return invalid
            }
            let opcode: UInt8 = stage2_binary_opcode(bytes[separator.start])
            if opcode == 0u8 {
                return invalid
            }
            if operator_count == 0usize {
                operator_opcode = opcode
            } else if operator_count == 1usize {
                second_operator_opcode = opcode
            } else if operator_count == 2usize {
                third_operator_opcode = opcode
            } else {
                fourth_operator_opcode = opcode
            }
            operator_count = operator_count + 1usize
            cursor = separator.end
            expecting_operand = true
        }
    }
    return invalid
}

/// Parses the executable stage-2 expression subset: a literal, one binary
/// operation, or a bounded add/subtract/multiply expression over at most five
/// non-negative Int32 literals. One explicit non-nested group may wrap one
/// adjacent binary pair. The emitter applies that group before multiplication
/// precedence and left associativity.
@noalloc
fn stage2_parse_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid_value: UIntSize = 2147483648usize
    let invalid: Stage2ReturnExpression = stage2_invalid_return_expression()
    let grouped_long: Stage2ReturnExpression = stage2_parse_grouped_long_return_i32_expression(
        bytes,
        start,
        end,
    )
    if grouped_long.kind == 4u8 {
        return grouped_long
    }
    if grouped_long.kind == 5u8 {
        return grouped_long
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    let first_expression_token: TokenInfo = scan_token_info(bytes, keyword.end, end)
    let first_expression_kind: UInt8 = first_expression_token.kind
    let first_expression_start: UIntSize = first_expression_token.start
    let first_expression_end: UIntSize = first_expression_token.end
    var grouping_kind: UInt8 = 0u8
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var left: TokenInfo = first_expression_token
    if stage2_token_is_symbol(
        bytes,
        first_expression_kind,
        first_expression_start,
        first_expression_end,
        0x28u8,
    ) {
        grouping_kind = 1u8
        group_start = first_expression_start
        left = scan_token_info(bytes, first_expression_end, end)
    }
    if left.kind != 2u8 {
        return invalid
    }
    let left_value: UIntSize = stage2_i32_literal_value(bytes, left.start, left.end)
    if left_value == invalid_value {
        return invalid
    }

    let operator_or_semicolon: TokenInfo = scan_token_info(bytes, left.end, end)
    if operator_or_semicolon.start >= end {
        return invalid
    }
    if grouping_kind == 0u8 {
        if stage2_token_is_symbol(
            bytes,
            operator_or_semicolon.kind,
            operator_or_semicolon.start,
            operator_or_semicolon.end,
            0x3Bu8,
        ) {
            let trailing: TokenInfo = scan_token_info(bytes, operator_or_semicolon.end, end)
            if trailing.start < end {
                return invalid
            }
            return Stage2ReturnExpression {
                kind: 1u8,
                grouping_kind: 0u8,
                operator_opcode: 0u8,
                second_operator_opcode: 0u8,
                third_operator_opcode: 0u8,
                fourth_operator_opcode: 0u8,
                left_value: left_value,
                right_value: 0usize,
                third_value: 0usize,
                fourth_value: 0usize,
                fifth_value: 0usize,
                left_start: left.start,
                left_end: left.end,
                right_start: 0usize,
                right_end: 0usize,
                third_start: 0usize,
                third_end: 0usize,
                fourth_start: 0usize,
                fourth_end: 0usize,
                fifth_start: 0usize,
                fifth_end: 0usize,
                group_start: 0usize,
                group_end: 0usize,
                expression_start: left.start,
                expression_end: left.end,
                statement_end: operator_or_semicolon.end,
            }
        }
    }
    if operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let operator_opcode: UInt8 = stage2_binary_opcode(bytes[operator_or_semicolon.start])
    if operator_opcode == 0u8 {
        return invalid
    }

    let right_or_open: TokenInfo = scan_token_info(bytes, operator_or_semicolon.end, end)
    let right_or_open_kind: UInt8 = right_or_open.kind
    let right_or_open_start: UIntSize = right_or_open.start
    let right_or_open_end: UIntSize = right_or_open.end
    var right: TokenInfo = right_or_open
    if grouping_kind == 0u8 {
        if stage2_token_is_symbol(
            bytes,
            right_or_open_kind,
            right_or_open_start,
            right_or_open_end,
            0x28u8,
        ) {
            grouping_kind = 2u8
            group_start = right_or_open_start
            right = scan_token_info(bytes, right_or_open_end, end)
        }
    }
    if right.kind != 2u8 {
        return invalid
    }
    let right_value: UIntSize = stage2_i32_literal_value(bytes, right.start, right.end)
    if right_value == invalid_value {
        return invalid
    }

    let after_right: TokenInfo = scan_token_info(bytes, right.end, end)
    if after_right.start >= end {
        return invalid
    }
    if grouping_kind == 1u8 {
        if !stage2_token_is_symbol(
            bytes,
            after_right.kind,
            after_right.start,
            after_right.end,
            0x29u8,
        ) {
            return invalid
        }
        group_end = after_right.end
        let after_left_group: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if stage2_token_is_symbol(
            bytes,
            after_left_group.kind,
            after_left_group.start,
            after_left_group.end,
            0x3Bu8,
        ) {
            let trailing: TokenInfo = scan_token_info(bytes, after_left_group.end, end)
            if trailing.start < end {
                return invalid
            }
            return Stage2ReturnExpression {
                kind: 2u8,
                grouping_kind: 3u8,
                operator_opcode: operator_opcode,
                second_operator_opcode: 0u8,
                third_operator_opcode: 0u8,
                fourth_operator_opcode: 0u8,
                left_value: left_value,
                right_value: right_value,
                third_value: 0usize,
                fourth_value: 0usize,
                fifth_value: 0usize,
                left_start: left.start,
                left_end: left.end,
                right_start: right.start,
                right_end: right.end,
                third_start: 0usize,
                third_end: 0usize,
                fourth_start: 0usize,
                fourth_end: 0usize,
                fifth_start: 0usize,
                fifth_end: 0usize,
                group_start: group_start,
                group_end: group_end,
                expression_start: group_start,
                expression_end: group_end,
                statement_end: after_left_group.end,
            }
        }
        let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_left_group.start])
        if second_operator_opcode == 0u8 {
            return invalid
        }
        let third: TokenInfo = scan_token_info(bytes, after_left_group.end, end)
        if third.kind != 2u8 {
            return invalid
        }
        let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
        if third_value == invalid_value {
            return invalid
        }
        let semicolon: TokenInfo = scan_token_info(bytes, third.end, end)
        if !stage2_token_is_symbol(
            bytes,
            semicolon.kind,
            semicolon.start,
            semicolon.end,
            0x3Bu8,
        ) {
            return invalid
        }
        let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 1u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: group_start,
            group_end: group_end,
            expression_start: group_start,
            expression_end: third.end,
            statement_end: semicolon.end,
        }
    }

    if grouping_kind == 2u8 {
        if after_right.kind != 3u8 {
            return invalid
        }
        let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_right.start])
        if second_operator_opcode == 0u8 {
            return invalid
        }
        let third: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if third.kind != 2u8 {
            return invalid
        }
        let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
        if third_value == invalid_value {
            return invalid
        }
        let close_group: TokenInfo = scan_token_info(bytes, third.end, end)
        if !stage2_token_is_symbol(
            bytes,
            close_group.kind,
            close_group.start,
            close_group.end,
            0x29u8,
        ) {
            return invalid
        }
        group_end = close_group.end
        let semicolon: TokenInfo = scan_token_info(bytes, close_group.end, end)
        if !stage2_token_is_symbol(
            bytes,
            semicolon.kind,
            semicolon.start,
            semicolon.end,
            0x3Bu8,
        ) {
            return invalid
        }
        let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 2u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: group_start,
            group_end: group_end,
            expression_start: left.start,
            expression_end: group_end,
            statement_end: semicolon.end,
        }
    }

    if stage2_token_is_symbol(
        bytes,
        after_right.kind,
        after_right.start,
        after_right.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 2u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: 0u8,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: 0usize,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: 0usize,
            third_end: 0usize,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: right.end,
            statement_end: after_right.end,
        }
    }
    if after_right.kind != 3u8 {
        return invalid
    }
    let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_right.start])
    if second_operator_opcode == 0u8 {
        return invalid
    }
    let third: TokenInfo = scan_token_info(bytes, after_right.end, end)
    if third.kind != 2u8 {
        return invalid
    }
    let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
    if third_value == invalid_value {
        return invalid
    }
    let third_operator_or_semicolon: TokenInfo = scan_token_info(bytes, third.end, end)
    if stage2_token_is_symbol(
        bytes,
        third_operator_or_semicolon.kind,
        third_operator_or_semicolon.start,
        third_operator_or_semicolon.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, third_operator_or_semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: third.end,
            statement_end: third_operator_or_semicolon.end,
        }
    }
    if third_operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let third_operator_opcode: UInt8 = stage2_binary_opcode(bytes[third_operator_or_semicolon.start])
    if third_operator_opcode == 0u8 {
        return invalid
    }
    let fourth: TokenInfo = scan_token_info(bytes, third_operator_or_semicolon.end, end)
    if fourth.kind != 2u8 {
        return invalid
    }
    let fourth_value: UIntSize = stage2_i32_literal_value(bytes, fourth.start, fourth.end)
    if fourth_value == invalid_value {
        return invalid
    }
    let fourth_operator_or_semicolon: TokenInfo = scan_token_info(bytes, fourth.end, end)
    if stage2_token_is_symbol(
        bytes,
        fourth_operator_or_semicolon.kind,
        fourth_operator_or_semicolon.start,
        fourth_operator_or_semicolon.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, fourth_operator_or_semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 4u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: third_operator_opcode,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: fourth_value,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: fourth.start,
            fourth_end: fourth.end,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: fourth.end,
            statement_end: fourth_operator_or_semicolon.end,
        }
    }
    if fourth_operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let fourth_operator_opcode: UInt8 = stage2_binary_opcode(bytes[fourth_operator_or_semicolon.start])
    if fourth_operator_opcode == 0u8 {
        return invalid
    }
    let fifth: TokenInfo = scan_token_info(bytes, fourth_operator_or_semicolon.end, end)
    if fifth.kind != 2u8 {
        return invalid
    }
    let fifth_value: UIntSize = stage2_i32_literal_value(bytes, fifth.start, fifth.end)
    if fifth_value == invalid_value {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, fifth.end, end)
    if !stage2_token_is_symbol(bytes, semicolon.kind, semicolon.start, semicolon.end, 0x3Bu8) {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    return Stage2ReturnExpression {
        kind: 5u8,
        grouping_kind: 0u8,
        operator_opcode: operator_opcode,
        second_operator_opcode: second_operator_opcode,
        third_operator_opcode: third_operator_opcode,
        fourth_operator_opcode: fourth_operator_opcode,
        left_value: left_value,
        right_value: right_value,
        third_value: third_value,
        fourth_value: fourth_value,
        fifth_value: fifth_value,
        left_start: left.start,
        left_end: left.end,
        right_start: right.start,
        right_end: right.end,
        third_start: third.start,
        third_end: third.end,
        fourth_start: fourth.start,
        fourth_end: fourth.end,
        fifth_start: fifth.start,
        fifth_end: fifth.end,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: left.start,
        expression_end: fifth.end,
        statement_end: semicolon.end,
    }
}

@noalloc
fn stage2_expression_literal_atom(
    expression: read Stage2ReturnExpression,
    literal_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if literal_index == 0usize {
        return Stage2ExpressionPlanAtom {
            value_index: 0usize,
            start: expression.left_start,
            end: expression.left_end,
        }
    }
    if literal_index == 1usize {
        return Stage2ExpressionPlanAtom {
            value_index: 1usize,
            start: expression.right_start,
            end: expression.right_end,
        }
    }
    if literal_index == 2usize {
        return Stage2ExpressionPlanAtom {
            value_index: 2usize,
            start: expression.third_start,
            end: expression.third_end,
        }
    }
    if literal_index == 3usize {
        return Stage2ExpressionPlanAtom {
            value_index: 3usize,
            start: expression.fourth_start,
            end: expression.fourth_end,
        }
    }
    return Stage2ExpressionPlanAtom {
        value_index: 4usize,
        start: expression.fifth_start,
        end: expression.fifth_end,
    }
}

@noalloc
fn stage2_expression_operator_at(
    expression: read Stage2ReturnExpression,
    operator_index: UIntSize,
) -> UInt8 {
    if operator_index == 0usize {
        return expression.operator_opcode
    }
    if operator_index == 1usize {
        return expression.second_operator_opcode
    }
    if operator_index == 2usize {
        return expression.third_operator_opcode
    }
    return expression.fourth_operator_opcode
}

@noalloc
fn stage2_expression_plan_atom(
    expression: read Stage2ReturnExpression,
    literal_count: UIntSize,
    effective_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if expression.grouping_kind == 0u8 {
        return stage2_expression_literal_atom(expression, effective_index)
    }
    let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
    if effective_index < group_left_index {
        return stage2_expression_literal_atom(expression, effective_index)
    }
    if effective_index == group_left_index {
        return Stage2ExpressionPlanAtom {
            value_index: literal_count,
            start: expression.group_start,
            end: expression.group_end,
        }
    }
    return stage2_expression_literal_atom(expression, effective_index + 1usize)
}

@noalloc
fn stage2_expression_plan_operator(
    expression: read Stage2ReturnExpression,
    effective_index: UIntSize,
) -> UInt8 {
    var source_index: UIntSize = effective_index
    if expression.grouping_kind != 0u8 {
        let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
        if effective_index >= group_left_index {
            source_index = source_index + 1usize
        }
    }
    return stage2_expression_operator_at(expression, source_index)
}

/// Emits kind 4/5 Int32 expressions through one bounded two-tier precedence
/// plan. An optional single binary group is emitted first as one effective
/// atom. Multiplication segments are then reduced before pending
/// addition/subtraction segments are folded from the left. Constants remain
/// dense before binary nodes and every binary node is written in
/// child-before-parent order directly into the caller-owned JIR slice.
@noalloc
fn stage2_emit_bounded_expression_plan(
    expression: Stage2ReturnExpression,
    function_index: UIntSize,
    return_statement_start: UIntSize,
    record_base: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2ExpressionPlanEmission {
    var literal_count: UIntSize = 4usize
    if expression.kind == 5u8 {
        literal_count = 5usize
    }
    let binary_count: UIntSize = literal_count - 1usize
    let record_count: UIntSize = 4usize + binary_count * 2usize
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }

    let literal_values: [UIntSize; 5] = [
        expression.left_value,
        expression.right_value,
        expression.third_value,
        expression.fourth_value,
        expression.fifth_value,
    ]
    let literal_starts: [UIntSize; 5] = [
        expression.left_start,
        expression.right_start,
        expression.third_start,
        expression.fourth_start,
        expression.fifth_start,
    ]
    let literal_ends: [UIntSize; 5] = [
        expression.left_end,
        expression.right_end,
        expression.third_end,
        expression.fourth_end,
        expression.fifth_end,
    ]
    var records_emitted: UIntSize = 0usize
    var literal_index: UIntSize = 1usize
    while literal_index < literal_count {
        let output_index: UIntSize = record_base + 2usize + literal_index
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_index,
                operand_a: literal_values[literal_index],
                operand_b: 0usize,
                source_start: literal_starts[literal_index],
                source_end: literal_ends[literal_index],
            }
            records_emitted = records_emitted + 1usize
        }
        literal_index = literal_index + 1usize
    }

    var nodes_emitted: UIntSize = 0usize
    var effective_atom_count: UIntSize = literal_count
    if expression.grouping_kind != 0u8 {
        let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
        if group_left_index >= binary_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2ExpressionPlanAtom = stage2_expression_literal_atom(
            expression,
            group_left_index,
        )
        let grouped_right: Stage2ExpressionPlanAtom = stage2_expression_literal_atom(
            expression,
            group_left_index + 1usize,
        )
        if expression.group_start >= grouped_left.start {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if expression.group_end <= grouped_right.end {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_expression_operator_at(
            expression,
            group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if grouped_opcode > 4u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + literal_count
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_count,
                operand_a: group_left_index,
                operand_b: group_left_index + 1usize,
                source_start: expression.group_start,
                source_end: expression.group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = 1usize
        effective_atom_count = literal_count - 1usize
    }

    let first_atom: Stage2ExpressionPlanAtom = stage2_expression_plan_atom(
        expression,
        literal_count,
        0usize,
    )
    var segment_value_index: UIntSize = first_atom.value_index
    var segment_start: UIntSize = first_atom.start
    var segment_end: UIntSize = first_atom.end
    var accumulated_value_index: UIntSize = 0usize
    var accumulated_start: UIntSize = first_atom.start
    var pending_low_opcode: UInt8 = 0u8
    var has_accumulated: Bool = false
    let effective_binary_count: UIntSize = effective_atom_count - 1usize
    var operator_index: UIntSize = 0usize
    while operator_index < effective_binary_count {
        let current_opcode: UInt8 = stage2_expression_plan_operator(expression, operator_index)
        if current_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if current_opcode > 4u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let next_atom: Stage2ExpressionPlanAtom = stage2_expression_plan_atom(
            expression,
            literal_count,
            operator_index + 1usize,
        )
        if current_opcode == 4u8 {
            let result_value_index: UIntSize = literal_count + nodes_emitted
            let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
            if output_index < output_capacity {
                output[output_index] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: current_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: result_value_index,
                    operand_a: segment_value_index,
                    operand_b: next_atom.value_index,
                    source_start: segment_start,
                    source_end: next_atom.end,
                }
                records_emitted = records_emitted + 1usize
            }
            segment_value_index = result_value_index
            segment_end = next_atom.end
            nodes_emitted = nodes_emitted + 1usize
        } else {
            if has_accumulated {
                let result_value_index: UIntSize = literal_count + nodes_emitted
                let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
                if output_index < output_capacity {
                    output[output_index] = Stage2JirRecord {
                        kind: 4u8,
                        opcode: pending_low_opcode,
                        type_kind: 2u8,
                        flags: 0u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: result_value_index,
                        operand_a: accumulated_value_index,
                        operand_b: segment_value_index,
                        source_start: accumulated_start,
                        source_end: segment_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                accumulated_value_index = result_value_index
                nodes_emitted = nodes_emitted + 1usize
            } else {
                accumulated_value_index = segment_value_index
                accumulated_start = segment_start
                has_accumulated = true
            }
            pending_low_opcode = current_opcode
            segment_value_index = next_atom.value_index
            segment_start = next_atom.start
            segment_end = next_atom.end
        }
        operator_index = operator_index + 1usize
    }

    var final_value_index: UIntSize = segment_value_index
    if has_accumulated {
        let result_value_index: UIntSize = literal_count + nodes_emitted
        let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: pending_low_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: result_value_index,
                operand_a: accumulated_value_index,
                operand_b: segment_value_index,
                source_start: accumulated_start,
                source_end: segment_end,
            }
            records_emitted = records_emitted + 1usize
        }
        final_value_index = result_value_index
        nodes_emitted = nodes_emitted + 1usize
    }
    if nodes_emitted != binary_count {
        return Stage2ExpressionPlanEmission {
            valid: false,
            record_count: record_count,
            records_emitted: records_emitted,
            final_value_index: 0usize,
        }
    }
    let return_output_index: UIntSize = record_base + 2usize + literal_count + binary_count
    if return_output_index < output_capacity {
        output[return_output_index] = Stage2JirRecord {
            kind: 5u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: function_index,
            block_index: 0usize,
            value_index: final_value_index,
            operand_a: 0usize,
            operand_b: 0usize,
            source_start: return_statement_start,
            source_end: expression.statement_end,
        }
        records_emitted = records_emitted + 1usize
    }
    return Stage2ExpressionPlanEmission {
        valid: true,
        record_count: record_count,
        records_emitted: records_emitted,
        final_value_index: final_value_index,
    }
}

@noalloc
fn stage2_streaming_literal_at(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    wanted_index: UIntSize,
) -> Stage2StreamingLiteral {
    var cursor: UIntSize = plan.expression_start
    var literal_index: UIntSize = 0usize
    while cursor < plan.expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, plan.expression_end)
        if token.start >= plan.expression_end {
            break
        }
        if token.kind == 2u8 {
            if literal_index == wanted_index {
                let value: UIntSize = stage2_i32_literal_value(bytes, token.start, token.end)
                if value == 2147483648usize {
                    return Stage2StreamingLiteral {
                        valid: false,
                        value: 0usize,
                        start: 0usize,
                        end: 0usize,
                    }
                }
                return Stage2StreamingLiteral {
                    valid: true,
                    value: value,
                    start: token.start,
                    end: token.end,
                }
            }
            literal_index = literal_index + 1usize
        }
        cursor = token.end
    }
    return Stage2StreamingLiteral {
        valid: false,
        value: 0usize,
        start: 0usize,
        end: 0usize,
    }
}

@noalloc
fn stage2_streaming_operator_at(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    wanted_index: UIntSize,
) -> UInt8 {
    var cursor: UIntSize = plan.expression_start
    var operator_index: UIntSize = 0usize
    while cursor < plan.expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, plan.expression_end)
        if token.start >= plan.expression_end {
            break
        }
        if token.kind == 3u8 {
            let opcode: UInt8 = stage2_binary_opcode(bytes[token.start])
            if opcode >= 2u8 {
                if opcode <= 4u8 {
                    if operator_index == wanted_index {
                        return opcode
                    }
                    operator_index = operator_index + 1usize
                }
            }
        }
        cursor = token.end
    }
    return 0u8
}

@noalloc
fn stage2_streaming_plan_atom(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    effective_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if plan.grouping_kind == 0usize {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            effective_index,
        )
        return Stage2ExpressionPlanAtom {
            value_index: effective_index,
            start: literal.start,
            end: literal.end,
        }
    }
    let group_left_index: UIntSize = plan.grouping_kind - 1usize
    if effective_index < group_left_index {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            effective_index,
        )
        return Stage2ExpressionPlanAtom {
            value_index: effective_index,
            start: literal.start,
            end: literal.end,
        }
    }
    if effective_index == group_left_index {
        return Stage2ExpressionPlanAtom {
            value_index: plan.literal_count,
            start: plan.group_start,
            end: plan.group_end,
        }
    }
    if plan.second_grouping_kind == 0usize {
        let literal_index: UIntSize = effective_index + 1usize
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
        return Stage2ExpressionPlanAtom {
            value_index: literal_index,
            start: literal.start,
            end: literal.end,
        }
    }
    let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
    let second_group_effective_index: UIntSize = second_group_left_index - 1usize
    if effective_index < second_group_effective_index {
        let literal_index: UIntSize = effective_index + 1usize
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
        return Stage2ExpressionPlanAtom {
            value_index: literal_index,
            start: literal.start,
            end: literal.end,
        }
    }
    if effective_index == second_group_effective_index {
        return Stage2ExpressionPlanAtom {
            value_index: plan.literal_count + 1usize,
            start: plan.second_group_start,
            end: plan.second_group_end,
        }
    }
    let literal_index: UIntSize = effective_index + 2usize
    let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
    return Stage2ExpressionPlanAtom {
        value_index: literal_index,
        start: literal.start,
        end: literal.end,
    }
}

@noalloc
fn stage2_streaming_plan_operator(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    effective_index: UIntSize,
) -> UInt8 {
    var source_index: UIntSize = effective_index
    if plan.grouping_kind != 0usize {
        let group_left_index: UIntSize = plan.grouping_kind - 1usize
        if effective_index >= group_left_index {
            source_index = source_index + 1usize
        }
    }
    if plan.second_grouping_kind != 0usize {
        let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
        let second_group_effective_index: UIntSize = second_group_left_index - 1usize
        if effective_index >= second_group_effective_index {
            source_index = source_index + 1usize
        }
    }
    return stage2_streaming_operator_at(bytes, plan, source_index)
}

/// Emits five through sixteen operators by rescanning the validated source and
/// writing constants plus child-before-parent reductions directly into the
/// caller-owned Stage2JirRecord table. At most two disjoint, non-nested binary
/// groups are emitted in source order. No fixed operand array is retained.
@noalloc
fn stage2_emit_streaming_expression_plan(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    function_index: UIntSize,
    return_statement_start: UIntSize,
    record_base: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2ExpressionPlanEmission {
    let record_count: UIntSize = 4usize + plan.operator_count * 2usize
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    var records_emitted: UIntSize = 0usize
    var literal_index: UIntSize = 1usize
    while literal_index < plan.literal_count {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            literal_index,
        )
        if !literal.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let output_index: UIntSize = record_base + 2usize + literal_index
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_index,
                operand_a: literal.value,
                operand_b: 0usize,
                source_start: literal.start,
                source_end: literal.end,
            }
            records_emitted = records_emitted + 1usize
        }
        literal_index = literal_index + 1usize
    }

    var nodes_emitted: UIntSize = 0usize
    var effective_atom_count: UIntSize = plan.literal_count
    if plan.grouping_kind != 0usize {
        let group_left_index: UIntSize = plan.grouping_kind - 1usize
        if group_left_index >= plan.operator_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            group_left_index,
        )
        let grouped_right: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            group_left_index + 1usize,
        )
        if !grouped_left.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if !grouped_right.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_streaming_operator_at(
            bytes,
            plan,
            group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + plan.literal_count
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: plan.literal_count,
                operand_a: group_left_index,
                operand_b: group_left_index + 1usize,
                source_start: plan.group_start,
                source_end: plan.group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = 1usize
        effective_atom_count = plan.literal_count - 1usize
    }
    if plan.second_grouping_kind != 0usize {
        if plan.grouping_kind == 0usize {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let first_group_left_index: UIntSize = plan.grouping_kind - 1usize
        let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
        if second_group_left_index >= plan.operator_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if second_group_left_index <= first_group_left_index + 1usize {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            second_group_left_index,
        )
        let grouped_right: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            second_group_left_index + 1usize,
        )
        if !grouped_left.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if !grouped_right.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_streaming_operator_at(
            bytes,
            plan,
            second_group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: plan.literal_count + nodes_emitted,
                operand_a: second_group_left_index,
                operand_b: second_group_left_index + 1usize,
                source_start: plan.second_group_start,
                source_end: plan.second_group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = nodes_emitted + 1usize
        effective_atom_count = effective_atom_count - 1usize
    }

    let first_atom: Stage2ExpressionPlanAtom = stage2_streaming_plan_atom(bytes, plan, 0usize)
    var segment_value_index: UIntSize = first_atom.value_index
    var segment_start: UIntSize = first_atom.start
    var segment_end: UIntSize = first_atom.end
    var accumulated_value_index: UIntSize = 0usize
    var accumulated_start: UIntSize = first_atom.start
    var pending_low_opcode: UInt8 = 0u8
    var has_accumulated: Bool = false
    let effective_binary_count: UIntSize = effective_atom_count - 1usize
    var operator_index: UIntSize = 0usize
    while operator_index < effective_binary_count {
        let current_opcode: UInt8 = stage2_streaming_plan_operator(
            bytes,
            plan,
            operator_index,
        )
        if current_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let next_atom: Stage2ExpressionPlanAtom = stage2_streaming_plan_atom(
            bytes,
            plan,
            operator_index + 1usize,
        )
        if current_opcode == 4u8 {
            let result_value_index: UIntSize = plan.literal_count + nodes_emitted
            let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
            if output_index < output_capacity {
                output[output_index] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: current_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: result_value_index,
                    operand_a: segment_value_index,
                    operand_b: next_atom.value_index,
                    source_start: segment_start,
                    source_end: next_atom.end,
                }
                records_emitted = records_emitted + 1usize
            }
            segment_value_index = result_value_index
            segment_end = next_atom.end
            nodes_emitted = nodes_emitted + 1usize
        } else {
            if has_accumulated {
                let result_value_index: UIntSize = plan.literal_count + nodes_emitted
                let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
                if output_index < output_capacity {
                    output[output_index] = Stage2JirRecord {
                        kind: 4u8,
                        opcode: pending_low_opcode,
                        type_kind: 2u8,
                        flags: 0u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: result_value_index,
                        operand_a: accumulated_value_index,
                        operand_b: segment_value_index,
                        source_start: accumulated_start,
                        source_end: segment_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                accumulated_value_index = result_value_index
                nodes_emitted = nodes_emitted + 1usize
            } else {
                accumulated_value_index = segment_value_index
                accumulated_start = segment_start
                has_accumulated = true
            }
            pending_low_opcode = current_opcode
            segment_value_index = next_atom.value_index
            segment_start = next_atom.start
            segment_end = next_atom.end
        }
        operator_index = operator_index + 1usize
    }

    var final_value_index: UIntSize = segment_value_index
    if has_accumulated {
        let result_value_index: UIntSize = plan.literal_count + nodes_emitted
        let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: pending_low_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: result_value_index,
                operand_a: accumulated_value_index,
                operand_b: segment_value_index,
                source_start: accumulated_start,
                source_end: segment_end,
            }
            records_emitted = records_emitted + 1usize
        }
        final_value_index = result_value_index
        nodes_emitted = nodes_emitted + 1usize
    }
    if nodes_emitted != plan.operator_count {
        return Stage2ExpressionPlanEmission {
            valid: false,
            record_count: record_count,
            records_emitted: records_emitted,
            final_value_index: 0usize,
        }
    }
    let return_output_index: UIntSize = record_base + 2usize + plan.literal_count + plan.operator_count
    if return_output_index < output_capacity {
        output[return_output_index] = Stage2JirRecord {
            kind: 5u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: function_index,
            block_index: 0usize,
            value_index: final_value_index,
            operand_a: 0usize,
            operand_b: 0usize,
            source_start: return_statement_start,
            source_end: plan.statement_end,
        }
        records_emitted = records_emitted + 1usize
    }
    return Stage2ExpressionPlanEmission {
        valid: true,
        record_count: record_count,
        records_emitted: records_emitted,
        final_value_index: final_value_index,
    }
}

/// Emits a deterministic, fixed-record JIR subset from the caller-owned
/// function/statement/call tables produced by `compile_frontend_stage2`.
///
/// The supported semantic slice is deliberately executable-shaped and exact:
/// one or more source-ordered `-> Int32` functions, each with zero parameters
/// or one explicit `name: Int32` parameter, and each
/// containing exactly one literal return, one binary operation, or one bounded
/// two-operator chain, or an expression plan with three through sixteen binary
/// operators, optionally with at most two explicit, disjoint, non-nested
/// binary groups, over
/// non-negative Int32 literals, and no
/// executable call expression. The generic call
/// scan reports a leading return group as `return(...)`; that one header is
/// accepted only when its delimiters exactly match the bounded expression.
/// Truncation is reported without writing outside the caller's output slice.
@export(name: "jadren_selfhost_emit_stage2_jir", abi: "C")
@noalloc
pub fn emit_stage2_jir(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    var call_count: UIntSize = 0usize
    for call_index in calls.indices {
        call_count = call_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }

    var previous_function_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        if function_headers[function_index].name_start >= function_headers[function_index].name_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].name_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].body_start >= function_headers[function_index].body_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].body_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if bytes[function_headers[function_index].body_start] != 0x7Bu8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if bytes[function_headers[function_index].body_end - 1usize] != 0x7Du8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_index > 0usize {
            if function_headers[function_index].name_start < previous_function_end {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 0usize,
                }
            }
        }
        previous_function_end = function_headers[function_index].body_end
    }
    for statement_index in statements.indices {
        if statements[statement_index].kind < 1u8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].kind > 9u8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].start >= statements[statement_index].end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
    }
    for call_index in calls.indices {
        if calls[call_index].callee_start >= calls[call_index].callee_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if calls[call_index].close_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
    }

    if function_count == 0usize {
        return Stage2JirSummary {
            functions_seen: function_count,
            statements_seen: statement_count,
            calls_seen: call_count,
            records_required: 0usize,
            records_emitted: 0usize,
            functions_lowered: 0usize,
            errors: 1usize,
            status_flags: 1usize,
        }
    }
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        var is_leading_expression_group: Bool = false
        for function_index in function_headers.indices {
            if calls[call_index].callee_start == function_headers[function_index].name_start {
                if calls[call_index].callee_end == function_headers[function_index].name_end {
                    if calls[call_index].open_start >= function_headers[function_index].name_end {
                        if calls[call_index].close_end < function_headers[function_index].body_start {
                            is_signature_group = true
                        }
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    for statement_index in statements.indices {
                        if statements[statement_index].start > function_headers[function_index].body_start {
                            if statements[statement_index].end < function_headers[function_index].body_end {
                                let streaming_plan: Stage2StreamingExpressionPlan = stage2_parse_streaming_return_i32_expression_plan(
                                    bytes,
                                    statements[statement_index].start,
                                    function_headers[function_index].body_end - 1usize,
                                )
                                let expression: Stage2ReturnExpression = stage2_parse_return_i32_expression(
                                    bytes,
                                    statements[statement_index].start,
                                    function_headers[function_index].body_end - 1usize,
                                )
                                var is_supported_leading_group: Bool = false
                                var supported_group_start: UIntSize = 0usize
                                var supported_group_end: UIntSize = 0usize
                                if expression.kind != 0u8 {
                                    if expression.grouping_kind == 1u8 {
                                        is_supported_leading_group = true
                                        supported_group_start = expression.group_start
                                        supported_group_end = expression.group_end
                                    }
                                    if expression.grouping_kind == 3u8 {
                                        is_supported_leading_group = true
                                        supported_group_start = expression.group_start
                                        supported_group_end = expression.group_end
                                    }
                                }
                                if streaming_plan.valid {
                                    if streaming_plan.grouping_kind == 1usize {
                                        is_supported_leading_group = true
                                        supported_group_start = streaming_plan.group_start
                                        supported_group_end = streaming_plan.group_end
                                    }
                                }
                                if is_supported_leading_group {
                                    let keyword: TokenInfo = scan_token_info(
                                        bytes,
                                        statements[statement_index].start,
                                        function_headers[function_index].body_end - 1usize,
                                    )
                                    if calls[call_index].callee_start == keyword.start {
                                        if calls[call_index].callee_end == keyword.end {
                                            if calls[call_index].open_start == supported_group_start {
                                                if calls[call_index].open_end == supported_group_start + 1usize {
                                                    if calls[call_index].close_start + 1usize == supported_group_end {
                                                        if calls[call_index].close_end == supported_group_end {
                                                            if calls[call_index].argument_count == 1usize {
                                                                if calls[call_index].depth == 0usize {
                                                                    is_leading_expression_group = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !is_signature_group {
            if !is_leading_expression_group {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
        }
    }
    var matched_statements: UIntSize = 0usize
    var binary_operation_count: UIntSize = 0usize
    var parameter_function_count: UIntSize = 0usize
    var parameter_total_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        if function_headers[function_index].parameter_count > 2usize {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
        var parameter: Stage2ParameterInfo = stage2_invalid_parameter_info()
        if function_headers[function_index].parameter_count == 1usize {
            parameter = stage2_parse_single_i32_parameter(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            if !parameter.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            parameter_function_count = parameter_function_count + 1usize
            parameter_total_count = parameter_total_count + 1usize
        }
        if function_headers[function_index].parameter_count == 2usize {
            parameter = stage2_parse_pair_i32_parameters(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            if !parameter.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 11usize,
                }
            }
            if parameter.count != 2usize {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 12usize,
                }
            }
            parameter_function_count = parameter_function_count + 1usize
            parameter_total_count = parameter_total_count + 2usize
        }
        if !stage2_has_int32_result(
            bytes,
            function_headers[function_index].name_end,
            function_headers[function_index].body_start,
        ) {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
        var function_statement_count: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    function_statement_count = function_statement_count + 1usize
                    matched_statements = matched_statements + 1usize
                    if statements[statement_index].kind != 2u8 {
                        return Stage2JirSummary {
                            functions_seen: function_count,
                            statements_seen: statement_count,
                            calls_seen: call_count,
                            records_required: 0usize,
                            records_emitted: 0usize,
                            functions_lowered: 0usize,
                            errors: 1usize,
                            status_flags: 1usize,
                        }
                    }
                    let streaming_plan: Stage2StreamingExpressionPlan = stage2_parse_streaming_return_i32_expression_plan(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                    )
                    let expression: Stage2ReturnExpression = stage2_parse_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                    )
                    let parameter_expression: Stage2ReturnExpression = stage2_parse_parameter_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                    )
                    let parameter_pair_expression: Stage2ReturnExpression = stage2_parse_parameter_pair_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                        parameter.second_name_start,
                        parameter.second_name_end,
                    )
                    if function_headers[function_index].parameter_count == 1usize {
                        if parameter_expression.kind != 6u8 {
                            return Stage2JirSummary {
                                functions_seen: function_count,
                                statements_seen: statement_count,
                                calls_seen: call_count,
                                records_required: 0usize,
                                records_emitted: 0usize,
                                functions_lowered: 0usize,
                                errors: 1usize,
                                status_flags: 1usize,
                            }
                        }
                        binary_operation_count = binary_operation_count + 1usize
                    } else {
                        if function_headers[function_index].parameter_count == 2usize {
                            if parameter_pair_expression.kind != 7u8 {
                                return Stage2JirSummary {
                                    functions_seen: function_count,
                                    statements_seen: statement_count,
                                    calls_seen: call_count,
                                    records_required: 0usize,
                                    records_emitted: 0usize,
                                    functions_lowered: 0usize,
                                    errors: 1usize,
                                    status_flags: 13usize,
                                }
                            }
                            binary_operation_count = binary_operation_count + 1usize
                        } else {
                            if streaming_plan.valid {
                                binary_operation_count = binary_operation_count + streaming_plan.operator_count
                            } else {
                                if expression.kind == 0u8 {
                                    return Stage2JirSummary {
                                        functions_seen: function_count,
                                        statements_seen: statement_count,
                                        calls_seen: call_count,
                                        records_required: 0usize,
                                        records_emitted: 0usize,
                                        functions_lowered: 0usize,
                                        errors: 1usize,
                                        status_flags: 1usize,
                                    }
                                }
                                if expression.kind == 2u8 {
                                    binary_operation_count = binary_operation_count + 1usize
                                }
                                if expression.kind == 3u8 {
                                    binary_operation_count = binary_operation_count + 2usize
                                }
                                if expression.kind == 4u8 {
                                    binary_operation_count = binary_operation_count + 3usize
                                }
                                if expression.kind == 5u8 {
                                    binary_operation_count = binary_operation_count + 4usize
                                }
                            }
                        }
                    }
                }
            }
        }
        if function_statement_count != 1usize {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
    }
    if matched_statements != statement_count {
        return Stage2JirSummary {
            functions_seen: function_count,
            statements_seen: statement_count,
            calls_seen: call_count,
            records_required: 0usize,
            records_emitted: 0usize,
            functions_lowered: 0usize,
            errors: 1usize,
            status_flags: 1usize,
        }
    }

    let records_required: UIntSize = 1usize + function_count * 4usize
        + binary_operation_count * 2usize
        - parameter_total_count
    var records_emitted: UIntSize = 0usize
    if output_capacity > 0usize {
        output[0] = Stage2JirRecord {
            kind: 1u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: 0usize,
            block_index: 0usize,
            value_index: 0usize,
            operand_a: 32usize,
            operand_b: 0usize,
            source_start: 0usize,
            source_end: 0usize,
        }
        records_emitted = 1usize
    }
    var record_cursor: UIntSize = 1usize
    for function_index in function_headers.indices {
        var return_statement_index: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    return_statement_index = statement_index
                }
            }
        }
        let streaming_plan: Stage2StreamingExpressionPlan = stage2_parse_streaming_return_i32_expression_plan(
            bytes,
            statements[return_statement_index].start,
            function_headers[function_index].body_end - 1usize,
        )
        let expression: Stage2ReturnExpression = stage2_parse_return_i32_expression(
            bytes,
            statements[return_statement_index].start,
            function_headers[function_index].body_end - 1usize,
        )
        var parameter: Stage2ParameterInfo = stage2_invalid_parameter_info()
        var parameter_expression: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
        var parameter_pair_expression: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
        if function_headers[function_index].parameter_count == 1usize {
            parameter = stage2_parse_single_i32_parameter(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            parameter_expression = stage2_parse_parameter_return_i32_expression(
                bytes,
                statements[return_statement_index].start,
                function_headers[function_index].body_end - 1usize,
                parameter.valid,
                parameter.name_start,
                parameter.name_end,
            )
        }
        if function_headers[function_index].parameter_count == 2usize {
            parameter = stage2_parse_pair_i32_parameters(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            parameter_pair_expression = stage2_parse_parameter_pair_return_i32_expression(
                bytes,
                statements[return_statement_index].start,
                function_headers[function_index].body_end - 1usize,
                parameter.valid,
                parameter.name_start,
                parameter.name_end,
                parameter.second_name_start,
                parameter.second_name_end,
            )
        }
        if function_headers[function_index].parameter_count == 1usize {
            if parameter_expression.kind != 6u8 {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 0usize,
                }
            }
        } else {
            if function_headers[function_index].parameter_count == 2usize {
                if parameter_pair_expression.kind != 7u8 {
                    return Stage2JirSummary {
                        functions_seen: function_count,
                        statements_seen: statement_count,
                        calls_seen: call_count,
                        records_required: 0usize,
                        records_emitted: 0usize,
                        functions_lowered: 0usize,
                        errors: 1usize,
                        status_flags: 0usize,
                    }
                }
            } else {
            if !streaming_plan.valid {
                if expression.kind == 0u8 {
                    return Stage2JirSummary {
                        functions_seen: function_count,
                        statements_seen: statement_count,
                        calls_seen: call_count,
                        records_required: 0usize,
                        records_emitted: 0usize,
                        functions_lowered: 0usize,
                        errors: 1usize,
                        status_flags: 0usize,
                    }
                }
            }
            }
        }
        var first_value: UIntSize = expression.left_value
        var first_start: UIntSize = expression.left_start
        var first_end: UIntSize = expression.left_end
        if streaming_plan.valid {
            first_value = streaming_plan.first_value
            first_start = streaming_plan.first_start
            first_end = streaming_plan.first_end
        }
        let record_base: UIntSize = record_cursor
        if record_base < output_capacity {
            output[record_base] = Stage2JirRecord {
                kind: 2u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 1u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: 0usize,
                operand_a: function_headers[function_index].parameter_count,
                operand_b: 0usize,
                source_start: function_headers[function_index].name_start,
                source_end: function_headers[function_index].body_end,
