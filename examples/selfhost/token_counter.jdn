                    output[record_base + direct_call_record_offset + 1usize] = Stage2JirRecord {
                        kind: 5u8,
                        opcode: 1u8,
                        type_kind: 2u8,
                        flags: 1u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: direct_call_result_value_index,
                        operand_a: 0usize,
                        operand_b: 0usize,
                        source_start: statements[return_statement_index].start,
