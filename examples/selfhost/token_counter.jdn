                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 0usize,
                }
            }
            if record_base + 2usize < output_capacity {
                output[record_base + 2usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: parameter_pair_expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 1usize,
                    source_start: parameter_pair_expression.expression_start,
                    source_end: parameter_pair_expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: parameter_pair_expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 4usize
            continue
        }
        if record_base + 2usize < output_capacity {
            output[record_base + 2usize] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: 0usize,
                operand_a: first_value,
                operand_b: 0usize,
                source_start: first_start,
                source_end: first_end,
            }
            records_emitted = records_emitted + 1usize
        }
        var use_legacy_long_plan: Bool = false
        if expression.kind == 4u8 {
            if expression.grouping_kind == 0u8 {
                use_legacy_long_plan = true
            }
        }
        if streaming_plan.valid {
            let plan: Stage2ExpressionPlanEmission = stage2_emit_streaming_expression_plan(
                bytes,
                streaming_plan,
                function_index,
                statements[return_statement_index].start,
                record_base,
                output,
            )
            if !plan.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            records_emitted = records_emitted + plan.records_emitted
            record_cursor = record_cursor + plan.record_count
        } else if expression.kind == 1u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 0usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 4usize
        } else if expression.kind == 2u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 1usize,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 5usize < output_capacity {
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 6usize
        } else if expression.kind == 3u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: expression.third_value,
                    operand_b: 0usize,
                    source_start: expression.third_start,
                    source_end: expression.third_end,
                }
                records_emitted = records_emitted + 1usize
            }
            var reduce_right_first: Bool = false
            if expression.grouping_kind == 2u8 {
                reduce_right_first = true
            } else {
                if expression.grouping_kind == 0u8 {
                    if expression.second_operator_opcode == 4u8 {
                        if expression.operator_opcode != 4u8 {
                            reduce_right_first = true
                        }
                    }
                }
            }
            if record_base + 5usize < output_capacity {
                var first_opcode: UInt8 = expression.operator_opcode
                var first_operand_a: UIntSize = 0usize
                var first_operand_b: UIntSize = 1usize
                var first_source_start: UIntSize = expression.left_start
                var first_source_end: UIntSize = expression.right_end
                if reduce_right_first {
                    first_opcode = expression.second_operator_opcode
                    first_operand_a = 1usize
                    first_operand_b = 2usize
                    first_source_start = expression.right_start
                    first_source_end = expression.third_end
                }
                if expression.grouping_kind == 1u8 {
                    first_source_start = expression.group_start
                    first_source_end = expression.group_end
                }
                if expression.grouping_kind == 2u8 {
                    first_source_start = expression.group_start
                    first_source_end = expression.group_end
                }
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: first_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 3usize,
                    operand_a: first_operand_a,
                    operand_b: first_operand_b,
                    source_start: first_source_start,
                    source_end: first_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 6usize < output_capacity {
                var final_opcode: UInt8 = expression.second_operator_opcode
                var final_operand_a: UIntSize = 3usize
                var final_operand_b: UIntSize = 2usize
                if reduce_right_first {
                    final_opcode = expression.operator_opcode
                    final_operand_a = 0usize
                    final_operand_b = 3usize
                }
                output[record_base + 6usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: final_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: final_operand_a,
                    operand_b: final_operand_b,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 7usize < output_capacity {
                output[record_base + 7usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 8usize
        } else if use_legacy_long_plan {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: expression.third_value,
                    operand_b: 0usize,
                    source_start: expression.third_start,
                    source_end: expression.third_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 5usize < output_capacity {
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 3usize,
                    operand_a: expression.fourth_value,
                    operand_b: 0usize,
                    source_start: expression.fourth_start,
                    source_end: expression.fourth_end,
                }
                records_emitted = records_emitted + 1usize
            }
            var reduce_first_left: Bool = true
            if expression.operator_opcode != 4u8 {
                if expression.second_operator_opcode == 4u8 {
                    reduce_first_left = false
                }
            }
            var reduce_second_left: Bool = true
            if reduce_first_left {
                if expression.second_operator_opcode != 4u8 {
                    if expression.third_operator_opcode == 4u8 {
                        reduce_second_left = false
                    }
                }
            } else {
                if expression.operator_opcode != 4u8 {
                    if expression.third_operator_opcode == 4u8 {
                        reduce_second_left = false
                    }
                }
            }
            if record_base + 6usize < output_capacity {
                var first_opcode: UInt8 = expression.operator_opcode
                var first_operand_a: UIntSize = 0usize
                var first_operand_b: UIntSize = 1usize
                var first_source_start: UIntSize = expression.left_start
                var first_source_end: UIntSize = expression.right_end
                if !reduce_first_left {
                    first_opcode = expression.second_operator_opcode
                    first_operand_a = 1usize
                    first_operand_b = 2usize
                    first_source_start = expression.right_start
                    first_source_end = expression.third_end
                }
                output[record_base + 6usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: first_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: first_operand_a,
                    operand_b: first_operand_b,
                    source_start: first_source_start,
                    source_end: first_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 7usize < output_capacity {
                var second_opcode: UInt8 = expression.second_operator_opcode
                var second_operand_a: UIntSize = 4usize
                var second_operand_b: UIntSize = 2usize
                var second_source_start: UIntSize = expression.left_start
                var second_source_end: UIntSize = expression.third_end
                if reduce_first_left {
                    if !reduce_second_left {
                        second_opcode = expression.third_operator_opcode
                        second_operand_a = 2usize
                        second_operand_b = 3usize
                        second_source_start = expression.third_start
                        second_source_end = expression.fourth_end
                    }
                } else {
                    if reduce_second_left {
                        second_opcode = expression.operator_opcode
                        second_operand_a = 0usize
                        second_operand_b = 4usize
                        second_source_start = expression.left_start
                        second_source_end = expression.third_end
                    } else {
                        second_opcode = expression.third_operator_opcode
                        second_operand_a = 4usize
                        second_operand_b = 3usize
                        second_source_start = expression.right_start
                        second_source_end = expression.fourth_end
                    }
                }
                output[record_base + 7usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: second_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 5usize,
                    operand_a: second_operand_a,
                    operand_b: second_operand_b,
                    source_start: second_source_start,
                    source_end: second_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 8usize < output_capacity {
                var final_opcode: UInt8 = expression.third_operator_opcode
                var final_operand_a: UIntSize = 5usize
                var final_operand_b: UIntSize = 3usize
                if reduce_first_left {
                    if !reduce_second_left {
                        final_opcode = expression.second_operator_opcode
                        final_operand_a = 4usize
                        final_operand_b = 5usize
                    }
                } else {
                    if !reduce_second_left {
                        final_opcode = expression.operator_opcode
                        final_operand_a = 0usize
                        final_operand_b = 5usize
                    }
                }
                output[record_base + 8usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: final_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 6usize,
                    operand_a: final_operand_a,
                    operand_b: final_operand_b,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 9usize < output_capacity {
                output[record_base + 9usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 6usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 10usize
        } else {
            let plan: Stage2ExpressionPlanEmission = stage2_emit_bounded_expression_plan(
                expression,
                function_index,
                statements[return_statement_index].start,
                record_base,
                output,
            )
            if !plan.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            records_emitted = records_emitted + plan.records_emitted
            record_cursor = record_cursor + plan.record_count
        }
    }
    var status: UIntSize = 3usize
    if records_emitted == records_required {
        status = 7usize
    }
    return Stage2JirSummary {
        functions_seen: function_count,
        statements_seen: statement_count,
        calls_seen: call_count,
        records_required: records_required,
        records_emitted: records_emitted,
        functions_lowered: function_count,
        errors: 0usize,
        status_flags: status,
    }
}
