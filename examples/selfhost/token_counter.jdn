    if output_capacity > 1usize { output[1] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: shape.name_start, source_end: shape.body_end }; emitted = emitted + 1usize }
    if output_capacity > 2usize { output[2] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: shape.body_start, source_end: shape.body_end }; emitted = emitted + 1usize }
    if output_capacity > 3usize { output[3] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: local.literal_value, operand_b: 0usize, source_start: local.literal_start, source_end: local.literal_end }; emitted = emitted + 1usize }
    if output_capacity > 4usize { output[4] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: local.use_start, operand_b: local.use_end, source_start: local.declaration_start, source_end: local.declaration_end }; emitted = emitted + 1usize }
    if output_capacity > 5usize { output[5] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: local.return_start, source_end: local.return_end }; emitted = emitted + 1usize }
