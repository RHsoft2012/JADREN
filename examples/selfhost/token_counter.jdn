                                                                      direct_call_extra_record_count = if argument_is_local_binary { 3usize } else { 1usize }
                                                                 }
                                                                 if argument_is_local_binary_operand {
                                                                     direct_call_extra_record_count = 3usize
                                                                 }
                                                                if argument_is_binary {
                                                                    if !argument_is_local_binary_operand {
                                                                        direct_call_extra_record_count = 2usize
                                                                    }
                                                                }
                                                                for result_statement_index in statements.indices {
                                                                    if statements[result_statement_index].kind == 1u8 {
                                                                        if statements[result_statement_index].start < candidate_start {
                                                                            var result_binding: Stage2DirectCallResultBindingInfo = stage2_parse_direct_call_result_binding_fallback(
                                                                                bytes,
                                                                                statements[result_statement_index].start,
                                                                                candidate_start,
                                                                                calls[call_index].close_end,
                                                                                function_headers[function_index].body_end,
                                                                            )
                                                                            if result_binding.valid {
                                                                                direct_call_result_binding_valid = true
                                                                                direct_call_result_binding_declaration_start = result_binding.declaration_start
                                                                                direct_call_result_binding_declaration_end = result_binding.declaration_end
                                                                                direct_call_result_binding_use_start = result_binding.use_start
                                                                                direct_call_result_binding_use_end = result_binding.use_end
                                                                                direct_call_result_binding_return_start = result_binding.return_start
                                                                                direct_call_result_binding_return_end = result_binding.return_end
                                                                                direct_call_result_binding_record_count = 1usize
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                is_direct_call = true
                                                            }
                                                        }
                                                    }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    for statement_index in statements.indices {
                        if statements[statement_index].start > function_headers[function_index].body_start {
                            if statements[statement_index].end < function_headers[function_index].body_end {
                                let streaming_plan: Stage2StreamingExpressionPlan = stage2_parse_streaming_return_i32_expression_plan(
                                    bytes,
                                    statements[statement_index].start,
                                    function_headers[function_index].body_end - 1usize,
                                )
                                let expression: Stage2ReturnExpression = stage2_parse_return_i32_expression(
                                    bytes,
                                    statements[statement_index].start,
                                    function_headers[function_index].body_end - 1usize,
                                )
                                var is_supported_leading_group: Bool = false
                                var supported_group_start: UIntSize = 0usize
                                var supported_group_end: UIntSize = 0usize
                                if expression.kind != 0u8 {
                                    if expression.grouping_kind == 1u8 {
                                        is_supported_leading_group = true
                                        supported_group_start = expression.group_start
                                        supported_group_end = expression.group_end
                                    }
                                    if expression.grouping_kind == 3u8 {
                                        is_supported_leading_group = true
                                        supported_group_start = expression.group_start
                                        supported_group_end = expression.group_end
                                    }
                                }
                                if streaming_plan.valid {
                                    if streaming_plan.grouping_kind == 1usize {
                                        is_supported_leading_group = true
                                        supported_group_start = streaming_plan.group_start
                                        supported_group_end = streaming_plan.group_end
                                    }
                                }
                                if is_supported_leading_group {
                                    let keyword: TokenInfo = scan_token_info(
                                        bytes,
                                        statements[statement_index].start,
                                        function_headers[function_index].body_end - 1usize,
                                    )
                                    if calls[call_index].callee_start == keyword.start {
                                        if calls[call_index].callee_end == keyword.end {
                                            if calls[call_index].open_start == supported_group_start {
                                                if calls[call_index].open_end == supported_group_start + 1usize {
                                                    if calls[call_index].close_start + 1usize == supported_group_end {
                                                        if calls[call_index].close_end == supported_group_end {
                                                            if calls[call_index].argument_count == 1usize {
                                                                if calls[call_index].depth == 0usize {
                                                                    is_leading_expression_group = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if !is_signature_group {
            if !is_leading_expression_group {
                if !is_direct_call {
                    return Stage2JirSummary {
                        functions_seen: function_count,
                        statements_seen: statement_count,
                        calls_seen: call_count,
                        records_required: 0usize,
                        records_emitted: 0usize,
                        functions_lowered: 0usize,
                        errors: 1usize,
                        status_flags: 1usize,
                    }
                }
            }
        }
    }
    var matched_statements: UIntSize = 0usize
    var binary_operation_count: UIntSize = 0usize
    var parameter_function_count: UIntSize = 0usize
    var parameter_total_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        if function_headers[function_index].parameter_count > 2usize {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
        var parameter: Stage2ParameterInfo = stage2_invalid_parameter_info()
        if function_headers[function_index].parameter_count == 1usize {
            parameter = stage2_parse_single_i32_parameter(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            if !parameter.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            parameter_function_count = parameter_function_count + 1usize
            parameter_total_count = parameter_total_count + 1usize
        }
        if function_headers[function_index].parameter_count == 2usize {
            parameter = stage2_parse_pair_i32_parameters(
                bytes,
                function_headers[function_index].name_end,
                function_headers[function_index].body_start,
            )
            if !parameter.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 11usize,
                }
            }
            if parameter.count != 2usize {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 12usize,
                }
            }
            parameter_function_count = parameter_function_count + 1usize
            parameter_total_count = parameter_total_count + 2usize
        }
        if !stage2_has_int32_result(
            bytes,
            function_headers[function_index].name_end,
            function_headers[function_index].body_start,
        ) {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
        var function_statement_count: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    function_statement_count = function_statement_count + 1usize
                    matched_statements = matched_statements + 1usize
                    if direct_call_count == 1usize {
                        if function_index == direct_call_caller_index {
                            if direct_call_result_binding_valid {
                                if function_statement_count == 1usize {
                                    if statements[statement_index].kind != 1u8 {
                                        return Stage2JirSummary {
                                            functions_seen: function_count,
                                            statements_seen: statement_count,
                                            calls_seen: call_count,
                                            records_required: 0usize,
                                            records_emitted: 0usize,
                                            functions_lowered: 0usize,
                                            errors: 1usize,
                                            status_flags: 1usize,
                                        }
                                    }
                                } else {
                                    if function_statement_count == 2usize {
                                        if statements[statement_index].kind != 2u8 {
                                            return Stage2JirSummary {
                                                functions_seen: function_count,
                                                statements_seen: statement_count,
                                                calls_seen: call_count,
                                                records_required: 0usize,
                                                records_emitted: 0usize,
                                                functions_lowered: 0usize,
                                                errors: 1usize,
                                                status_flags: 1usize,
                                            }
                                        }
                                    } else {
                                        return Stage2JirSummary {
                                            functions_seen: function_count,
                                            statements_seen: statement_count,
                                            calls_seen: call_count,
                                            records_required: 0usize,
                                            records_emitted: 0usize,
                                            functions_lowered: 0usize,
                                            errors: 1usize,
                                            status_flags: 1usize,
                                        }
                                    }
                                }
                                continue
                            }
                            if direct_call_argument_is_local {
                                if function_statement_count == 1usize {
                                    if statements[statement_index].kind != 1u8 {
                                        return Stage2JirSummary {
                                            functions_seen: function_count,
                                            statements_seen: statement_count,
                                            calls_seen: call_count,
                                            records_required: 0usize,
                                            records_emitted: 0usize,
                                            functions_lowered: 0usize,
                                            errors: 1usize,
                                            status_flags: 1usize,
                                        }
                                    }
                                } else {
                                    if function_statement_count == 2usize {
                                        if statements[statement_index].kind != 2u8 {
                                            return Stage2JirSummary {
                                                functions_seen: function_count,
                                                statements_seen: statement_count,
                                                calls_seen: call_count,
                                                records_required: 0usize,
                                                records_emitted: 0usize,
                                                functions_lowered: 0usize,
                                                errors: 1usize,
                                                status_flags: 1usize,
                                            }
                                        }
                                    } else {
                                        return Stage2JirSummary {
                                            functions_seen: function_count,
                                            statements_seen: statement_count,
                                            calls_seen: call_count,
                                            records_required: 0usize,
                                            records_emitted: 0usize,
                                            functions_lowered: 0usize,
                                            errors: 1usize,
                                            status_flags: 1usize,
                                        }
                                    }
                                }
                                continue
                            }
                            if statements[statement_index].kind != 2u8 {
                                return Stage2JirSummary {
                                    functions_seen: function_count,
                                    statements_seen: statement_count,
                                    calls_seen: call_count,
                                    records_required: 0usize,
                                    records_emitted: 0usize,
                                    functions_lowered: 0usize,
                                    errors: 1usize,
                                    status_flags: 1usize,
                                }
                            }
                            continue
                        }
                    }
                    if statements[statement_index].kind != 2u8 {
                        return Stage2JirSummary {
                            functions_seen: function_count,
                            statements_seen: statement_count,
                            calls_seen: call_count,
                            records_required: 0usize,
                            records_emitted: 0usize,
                            functions_lowered: 0usize,
                            errors: 1usize,
                            status_flags: 1usize,
                        }
                    }
                    let streaming_plan: Stage2StreamingExpressionPlan = stage2_parse_streaming_return_i32_expression_plan(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                    )
                    let expression: Stage2ReturnExpression = stage2_parse_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                    )
                    let parameter_expression: Stage2ReturnExpression = stage2_parse_parameter_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                    )
                    if parameter_expression.kind == 0u8 {
                        parameter_expression = stage2_parse_literal_parameter_return_i32_expression(
                            bytes,
                            statements[statement_index].start,
                            function_headers[function_index].body_end - 1usize,
                            parameter.valid,
                            parameter.name_start,
                            parameter.name_end,
                        )
                    }
                    let parameter_chain_expression: Stage2ReturnExpression = stage2_parse_parameter_two_node_chain_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                    )
                    let parameter_four_atom_expression: Stage2ReturnExpression = stage2_parse_parameter_four_atom_precedence_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                    )
                    let parameter_pair_expression: Stage2ReturnExpression = stage2_parse_parameter_pair_return_i32_expression(
                        bytes,
                        statements[statement_index].start,
                        function_headers[function_index].body_end - 1usize,
                        parameter.valid,
                        parameter.name_start,
                        parameter.name_end,
                        parameter.second_name_start,
                        parameter.second_name_end,
                    )
                    if parameter_pair_expression.kind == 0u8 {
                        parameter_pair_expression = stage2_parse_reverse_parameter_pair_return_i32_expression(
                            bytes,
                            statements[statement_index].start,
                            function_headers[function_index].body_end - 1usize,
                            parameter.valid,
                            parameter.name_start,
                            parameter.name_end,
                            parameter.second_name_start,
                            parameter.second_name_end,
                        )
                    }
                    if function_headers[function_index].parameter_count == 1usize {
                        if parameter_four_atom_expression.kind == 11u8 {
                            binary_operation_count = binary_operation_count + 3usize
                        } else {
                            if parameter_chain_expression.kind == 10u8 {
                            binary_operation_count = binary_operation_count + 2usize
                            } else {
                            if parameter_expression.kind != 6u8 {
                                if parameter_expression.kind != 8u8 {
                                    return Stage2JirSummary {
                                        functions_seen: function_count,
                                        statements_seen: statement_count,
                                        calls_seen: call_count,
                                        records_required: 0usize,
                                        records_emitted: 0usize,
                                        functions_lowered: 0usize,
                                        errors: 1usize,
                                        status_flags: 1usize,
                                    }
                                }
                            }
                            binary_operation_count = binary_operation_count + 1usize
                            }
                        }
                    } else {
                        if function_headers[function_index].parameter_count == 2usize {
                            if parameter_pair_expression.kind != 7u8 {
                                if parameter_pair_expression.kind != 9u8 {
                                    return Stage2JirSummary {
                                        functions_seen: function_count,
                                        statements_seen: statement_count,
                                        calls_seen: call_count,
                                        records_required: 0usize,
                                        records_emitted: 0usize,
                                        functions_lowered: 0usize,
                                        errors: 1usize,
                                        status_flags: 13usize,
                                    }
                                }
                            }
                            binary_operation_count = binary_operation_count + 1usize
                        } else {
                            if streaming_plan.valid {
                                binary_operation_count = binary_operation_count + streaming_plan.operator_count
                            } else {
                                if expression.kind == 0u8 {
                                    return Stage2JirSummary {
                                        functions_seen: function_count,
                                        statements_seen: statement_count,
                                        calls_seen: call_count,
                                        records_required: 0usize,
                                        records_emitted: 0usize,
                                        functions_lowered: 0usize,
                                        errors: 1usize,
                                        status_flags: 1usize,
                                    }
                                }
                                if expression.kind == 2u8 {
                                    binary_operation_count = binary_operation_count + 1usize
                                }
                                if expression.kind == 3u8 {
                                    binary_operation_count = binary_operation_count + 2usize
                                }
                                if expression.kind == 4u8 {
                                    binary_operation_count = binary_operation_count + 3usize
                                }
                                if expression.kind == 5u8 {
                                    binary_operation_count = binary_operation_count + 4usize
                                }
                            }
                        }
                    }
                }
            }
        }
        var expected_statement_count: UIntSize = 1usize
        if direct_call_count == 1usize {
            if direct_call_argument_is_local {
                if function_index == direct_call_caller_index {
                    expected_statement_count = 2usize
                }
            }
            if direct_call_result_binding_valid {
                if function_index == direct_call_caller_index {
                    expected_statement_count = 2usize
                }
            }
        }
        if function_statement_count != expected_statement_count {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 1usize,
            }
        }
    }
    if matched_statements != statement_count {
        return Stage2JirSummary {
            functions_seen: function_count,
            statements_seen: statement_count,
            calls_seen: call_count,
            records_required: 0usize,
            records_emitted: 0usize,
            functions_lowered: 0usize,
            errors: 1usize,
            status_flags: 1usize,
        }
    }

    let records_required: UIntSize = 1usize + function_count * 4usize
        + binary_operation_count * 2usize
        - parameter_total_count
        + if direct_call_argument_is_empty { 0usize } else { direct_call_count }
        + direct_call_result_binding_record_count
        + direct_call_extra_record_count
    var records_emitted: UIntSize = 0usize
    if output_capacity > 0usize {
        output[0] = Stage2JirRecord {
            kind: 1u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: 0usize,
            block_index: 0usize,
            value_index: 0usize,
            operand_a: 32usize,
            operand_b: 0usize,
            source_start: 0usize,
            source_end: 0usize,
        }
        records_emitted = 1usize
    }
    var record_cursor: UIntSize = 1usize
    for function_index in function_headers.indices {
        var return_statement_index: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    return_statement_index = statement_index
                }
            }
        }
        if direct_call_count == 1usize {
            if function_index == direct_call_caller_index {
                let record_base: UIntSize = record_cursor
                if record_base < output_capacity {
                    output[record_base] = Stage2JirRecord {
                        kind: 2u8,
                        opcode: 1u8,
                        type_kind: 2u8,
                        flags: 1u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: 0usize,
                        operand_a: function_headers[function_index].parameter_count,
                        operand_b: 0usize,
                        source_start: function_headers[function_index].name_start,
                        source_end: function_headers[function_index].body_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                if record_base + 1usize < output_capacity {
                    output[record_base + 1usize] = Stage2JirRecord {
                        kind: 3u8,
                        opcode: 1u8,
                        type_kind: 0u8,
                        flags: 0u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: 0usize,
                        operand_a: 0usize,
                        operand_b: 0usize,
                        source_start: function_headers[function_index].body_start,
                        source_end: function_headers[function_index].body_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                var direct_call_record_offset: UIntSize = 2usize
                if direct_call_argument_is_local_binary {
                    if record_base + direct_call_record_offset < output_capacity {
                        output[record_base + direct_call_record_offset] = Stage2JirRecord {
                            kind: 4u8,
                            opcode: 1u8,
                            type_kind: 2u8,
                            flags: 0u8,
                            function_index: function_index,
                            block_index: 0usize,
                            value_index: 0usize,
                            operand_a: stage2_i32_literal_value(
                                bytes,
                                direct_call_local_binary_first_start,
                                direct_call_local_binary_first_end,
                            ),
                            operand_b: 0usize,
                            source_start: direct_call_local_binary_first_start,
                            source_end: direct_call_local_binary_first_end,
                        }
                        records_emitted = records_emitted + 1usize
                    }
                    if record_base + direct_call_record_offset + 1usize < output_capacity {
                        output[record_base + direct_call_record_offset + 1usize] = Stage2JirRecord {
                            kind: 4u8,
                            opcode: 1u8,
                            type_kind: 2u8,
                            flags: 0u8,
                            function_index: function_index,
                            block_index: 0usize,
                            value_index: 1usize,
                            operand_a: stage2_i32_literal_value(
                                bytes,
                                direct_call_local_binary_second_start,
                                direct_call_local_binary_second_end,
                            ),
                            operand_b: 0usize,
                            source_start: direct_call_local_binary_second_start,
                            source_end: direct_call_local_binary_second_end,
                        }
                        records_emitted = records_emitted + 1usize
                    }
                    if record_base + direct_call_record_offset + 2usize < output_capacity {
                        output[record_base + direct_call_record_offset + 2usize] = Stage2JirRecord {
                            kind: 4u8,
                            opcode: direct_call_local_binary_opcode,
                            type_kind: 2u8,
                            flags: 0u8,
                            function_index: function_index,
                            block_index: 0usize,
                            value_index: 2usize,
                            operand_a: 0usize,
                            operand_b: 1usize,
                            source_start: direct_call_local_binary_start,
                            source_end: direct_call_local_binary_end,
                        }
                        records_emitted = records_emitted + 1usize
                    }
                     direct_call_record_offset = direct_call_record_offset + 3usize
                 }
                 if direct_call_argument_has_local_binary_operand {
                     if direct_call_argument_right_is_local {
                         if record_base + direct_call_record_offset < output_capacity {
                             output[record_base + direct_call_record_offset] = Stage2JirRecord {
                                 kind: 4u8,
                                 opcode: 1u8,
                                 type_kind: 2u8,
                                 flags: 0u8,
                                 function_index: function_index,
                                 block_index: 0usize,
                                 value_index: 0usize,
                                 operand_a: stage2_i32_literal_value(
                                     bytes,
                                     direct_call_argument_left_start,
                                     direct_call_argument_left_end,
                                 ),
                                 operand_b: 0usize,
                                 source_start: direct_call_argument_left_start,
                                 source_end: direct_call_argument_left_end,
                             }
                             records_emitted = records_emitted + 1usize
                         }
                         direct_call_record_offset = direct_call_record_offset + 1usize
                     }
                     if record_base + direct_call_record_offset < output_capacity {
                         output[record_base + direct_call_record_offset] = Stage2JirRecord {
                             kind: 4u8,
                             opcode: 1u8,
                             type_kind: 2u8,
                             flags: 0u8,
                             function_index: function_index,
                             block_index: 0usize,
                             value_index: if direct_call_argument_right_is_local { 1usize } else { 0usize },
                             operand_a: stage2_i32_literal_value(
                                 bytes,
                                 direct_call_local_literal_start,
                                 direct_call_local_literal_end,
                             ),
                             operand_b: 0usize,
                             source_start: direct_call_local_literal_start,
                             source_end: direct_call_local_literal_end,
                         }
                         records_emitted = records_emitted + 1usize
                     }
                     direct_call_record_offset = direct_call_record_offset + 1usize
                 }
                 if direct_call_argument_is_literal {
                    if record_base + direct_call_record_offset < output_capacity {
                        output[record_base + direct_call_record_offset] = Stage2JirRecord {
                            kind: 4u8,
                            opcode: 1u8,
                            type_kind: 2u8,
                            flags: 0u8,
                            function_index: function_index,
                            block_index: 0usize,
                            value_index: direct_call_argument_value_index,
                            operand_a: stage2_i32_literal_value(
                                bytes,
                                direct_call_argument_start,
                                direct_call_argument_end,
                            ),
                            operand_b: 0usize,
                            source_start: direct_call_argument_start,
                            source_end: direct_call_argument_end,
                        }
                        records_emitted = records_emitted + 1usize
                    }
                    direct_call_record_offset = direct_call_record_offset + 1usize
                }
                if direct_call_argument_is_local {
                    if record_base + direct_call_record_offset < output_capacity {
                        output[record_base + direct_call_record_offset] = Stage2JirRecord {
                            kind: 6u8,
                            opcode: 1u8,
                            type_kind: 2u8,
                            flags: 1u8,
                            function_index: function_index,
                            block_index: 0usize,
                             value_index: if direct_call_argument_is_local_binary {
                                 2usize
                             } else if direct_call_argument_has_local_binary_operand {
                                 if direct_call_argument_right_is_local { 1usize } else { 0usize }
                             } else {
                                 0usize
                             },
                            operand_a: direct_call_local_use_start,
                            operand_b: direct_call_local_use_end,
                            source_start: direct_call_local_declaration_start,
                            source_end: direct_call_local_declaration_end,
                        }
                        records_emitted = records_emitted + 1usize
                    }
                    direct_call_record_offset = direct_call_record_offset + 1usize
                 }
                 if direct_call_argument_is_binary {
                     if direct_call_argument_left_is_local {
                         if record_base + direct_call_record_offset < output_capacity {
                             output[record_base + direct_call_record_offset] = Stage2JirRecord {
                                 kind: 4u8,
                                 opcode: 1u8,
                                 type_kind: 2u8,
                                 flags: 0u8,
                                 function_index: function_index,
                                 block_index: 0usize,
                                 value_index: 1usize,
