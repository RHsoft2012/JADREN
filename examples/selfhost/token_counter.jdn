                        operand_b: second_binary_right,
                        source_start: parameter_chain_expression.left_start,
                        source_end: parameter_chain_expression.expression_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                if record_base + 6usize < output_capacity {
                    output[record_base + 6usize] = Stage2JirRecord {
                        kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8,
                        function_index: function_index, block_index: 0usize, value_index: 4usize,
                        operand_a: 0usize, operand_b: 0usize,
                        source_start: statements[return_statement_index].start,
                        source_end: parameter_chain_expression.statement_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                record_cursor = record_cursor + 7usize
                continue
            }
            if record_base + 2usize < output_capacity {
                output[record_base + 2usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: parameter_literal_value,
                    operand_b: 0usize,
                    source_start: parameter_literal_start,
                    source_end: parameter_literal_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: parameter_expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: parameter_binary_left,
                    operand_b: parameter_binary_right,
                    source_start: parameter_expression.expression_start,
                    source_end: parameter_expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: parameter_expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 5usize
            continue
        }
        if function_headers[function_index].parameter_count == 2usize {
            if parameter_pair_expression.kind != 7u8 {
                if parameter_pair_expression.kind != 9u8 {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 0usize,
                }
                }
            }
            if record_base + 2usize < output_capacity {
                output[record_base + 2usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: parameter_pair_expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: parameter_pair_binary_left,
                    operand_b: parameter_pair_binary_right,
                    source_start: parameter_pair_expression.expression_start,
                    source_end: parameter_pair_expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: parameter_pair_expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 4usize
            continue
        }
        if record_base + 2usize < output_capacity {
            output[record_base + 2usize] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: 0usize,
                operand_a: first_value,
                operand_b: 0usize,
                source_start: first_start,
                source_end: first_end,
            }
            records_emitted = records_emitted + 1usize
        }
        var use_legacy_long_plan: Bool = false
        if expression.kind == 4u8 {
            if expression.grouping_kind == 0u8 {
                use_legacy_long_plan = true
            }
        }
        if streaming_plan.valid {
            let plan: Stage2ExpressionPlanEmission = stage2_emit_streaming_expression_plan(
                bytes,
                streaming_plan,
                function_index,
                statements[return_statement_index].start,
                record_base,
                output,
            )
            if !plan.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            records_emitted = records_emitted + plan.records_emitted
            record_cursor = record_cursor + plan.record_count
        } else if expression.kind == 1u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 0usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 4usize
        } else if expression.kind == 2u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 1usize,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 5usize < output_capacity {
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 6usize
        } else if expression.kind == 3u8 {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: expression.third_value,
                    operand_b: 0usize,
                    source_start: expression.third_start,
                    source_end: expression.third_end,
                }
                records_emitted = records_emitted + 1usize
            }
            var reduce_right_first: Bool = false
            if expression.grouping_kind == 2u8 {
                reduce_right_first = true
            } else {
                if expression.grouping_kind == 0u8 {
                    if expression.second_operator_opcode == 4u8 {
                        if expression.operator_opcode != 4u8 {
                            reduce_right_first = true
                        }
                    }
                }
            }
            if record_base + 5usize < output_capacity {
                var first_opcode: UInt8 = expression.operator_opcode
                var first_operand_a: UIntSize = 0usize
                var first_operand_b: UIntSize = 1usize
                var first_source_start: UIntSize = expression.left_start
                var first_source_end: UIntSize = expression.right_end
                if reduce_right_first {
                    first_opcode = expression.second_operator_opcode
                    first_operand_a = 1usize
                    first_operand_b = 2usize
                    first_source_start = expression.right_start
                    first_source_end = expression.third_end
                }
                if expression.grouping_kind == 1u8 {
                    first_source_start = expression.group_start
                    first_source_end = expression.group_end
                }
                if expression.grouping_kind == 2u8 {
                    first_source_start = expression.group_start
                    first_source_end = expression.group_end
                }
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: first_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 3usize,
                    operand_a: first_operand_a,
                    operand_b: first_operand_b,
                    source_start: first_source_start,
                    source_end: first_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 6usize < output_capacity {
                var final_opcode: UInt8 = expression.second_operator_opcode
                var final_operand_a: UIntSize = 3usize
                var final_operand_b: UIntSize = 2usize
                if reduce_right_first {
                    final_opcode = expression.operator_opcode
                    final_operand_a = 0usize
                    final_operand_b = 3usize
                }
                output[record_base + 6usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: final_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: final_operand_a,
                    operand_b: final_operand_b,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 7usize < output_capacity {
                output[record_base + 7usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 8usize
        } else if use_legacy_long_plan {
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: expression.right_value,
                    operand_b: 0usize,
                    source_start: expression.right_start,
                    source_end: expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: expression.third_value,
                    operand_b: 0usize,
                    source_start: expression.third_start,
                    source_end: expression.third_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 5usize < output_capacity {
                output[record_base + 5usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 3usize,
                    operand_a: expression.fourth_value,
                    operand_b: 0usize,
                    source_start: expression.fourth_start,
                    source_end: expression.fourth_end,
                }
                records_emitted = records_emitted + 1usize
            }
            var reduce_first_left: Bool = true
            if expression.operator_opcode != 4u8 {
                if expression.second_operator_opcode == 4u8 {
                    reduce_first_left = false
                }
            }
            var reduce_second_left: Bool = true
            if reduce_first_left {
                if expression.second_operator_opcode != 4u8 {
                    if expression.third_operator_opcode == 4u8 {
                        reduce_second_left = false
                    }
                }
            } else {
                if expression.operator_opcode != 4u8 {
                    if expression.third_operator_opcode == 4u8 {
                        reduce_second_left = false
                    }
                }
            }
            if record_base + 6usize < output_capacity {
                var first_opcode: UInt8 = expression.operator_opcode
                var first_operand_a: UIntSize = 0usize
                var first_operand_b: UIntSize = 1usize
                var first_source_start: UIntSize = expression.left_start
                var first_source_end: UIntSize = expression.right_end
                if !reduce_first_left {
                    first_opcode = expression.second_operator_opcode
                    first_operand_a = 1usize
                    first_operand_b = 2usize
                    first_source_start = expression.right_start
                    first_source_end = expression.third_end
                }
                output[record_base + 6usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: first_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 4usize,
                    operand_a: first_operand_a,
                    operand_b: first_operand_b,
                    source_start: first_source_start,
                    source_end: first_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 7usize < output_capacity {
                var second_opcode: UInt8 = expression.second_operator_opcode
                var second_operand_a: UIntSize = 4usize
                var second_operand_b: UIntSize = 2usize
                var second_source_start: UIntSize = expression.left_start
                var second_source_end: UIntSize = expression.third_end
                if reduce_first_left {
                    if !reduce_second_left {
                        second_opcode = expression.third_operator_opcode
                        second_operand_a = 2usize
                        second_operand_b = 3usize
                        second_source_start = expression.third_start
                        second_source_end = expression.fourth_end
                    }
                } else {
                    if reduce_second_left {
                        second_opcode = expression.operator_opcode
                        second_operand_a = 0usize
                        second_operand_b = 4usize
                        second_source_start = expression.left_start
                        second_source_end = expression.third_end
                    } else {
                        second_opcode = expression.third_operator_opcode
                        second_operand_a = 4usize
                        second_operand_b = 3usize
                        second_source_start = expression.right_start
                        second_source_end = expression.fourth_end
                    }
                }
                output[record_base + 7usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: second_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 5usize,
                    operand_a: second_operand_a,
                    operand_b: second_operand_b,
                    source_start: second_source_start,
                    source_end: second_source_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 8usize < output_capacity {
                var final_opcode: UInt8 = expression.third_operator_opcode
                var final_operand_a: UIntSize = 5usize
                var final_operand_b: UIntSize = 3usize
                if reduce_first_left {
                    if !reduce_second_left {
                        final_opcode = expression.second_operator_opcode
                        final_operand_a = 4usize
                        final_operand_b = 5usize
                    }
                } else {
                    if !reduce_second_left {
                        final_opcode = expression.operator_opcode
                        final_operand_a = 0usize
                        final_operand_b = 5usize
                    }
                }
                output[record_base + 8usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: final_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 6usize,
                    operand_a: final_operand_a,
                    operand_b: final_operand_b,
                    source_start: expression.expression_start,
                    source_end: expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 9usize < output_capacity {
                output[record_base + 9usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 6usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 10usize
        } else {
            let plan: Stage2ExpressionPlanEmission = stage2_emit_bounded_expression_plan(
                expression,
                function_index,
                statements[return_statement_index].start,
                record_base,
                output,
            )
            if !plan.valid {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 1usize,
                }
            }
            records_emitted = records_emitted + plan.records_emitted
            record_cursor = record_cursor + plan.record_count
        }
    }
    var status: UIntSize = 3usize
    if records_emitted == records_required {
        status = 7usize
    }
    return Stage2JirSummary {
        functions_seen: function_count,
        statements_seen: statement_count,
        calls_seen: call_count,
        records_required: records_required,
        records_emitted: records_emitted,
        functions_lowered: function_count,
        errors: 0usize,
        status_flags: status,
    }
}

@noalloc
fn stage2_same_ascii(
    bytes: read Slice<UInt8>,
    left_start: UIntSize,
    left_end: UIntSize,
    right_start: UIntSize,
    right_end: UIntSize,
) -> Bool {
    if left_end - left_start != right_end - right_start {
        return false
    }
    var offset: UIntSize = 0usize
    while left_start + offset < left_end {
        if bytes[left_start + offset] != bytes[right_start + offset] {
            return false
        }
        offset = offset + 1usize
    }
    return true
}

fn stage2_parse_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    parameter_count: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2LocalBindingInfo {
    let invalid: Stage2LocalBindingInfo = Stage2LocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        literal_value: 0usize,
        operator_opcode: 0u8,
        parameter_on_left: false,
    }
    if parameter_count != 1usize {
        return invalid
    }
    let parameter: Stage2ParameterInfo = stage2_parse_single_i32_parameter(
        bytes,
        name_end,
        body_start,
    )
    if !parameter.valid {
        return invalid
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    var cursor: UIntSize = body_start + 1usize
    let let_token: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
    if let_token.kind != 1u8 {
        return invalid
    }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let first_operand: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let operator: TokenInfo = scan_token_info(bytes, first_operand.end, body_end_exclusive)
    let second_operand: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
    let parameter_on_left: Bool = first_operand.kind != 2u8
    let parameter_use_start: UIntSize = if parameter_on_left { first_operand.start } else { second_operand.start }
    let parameter_use_end: UIntSize = if parameter_on_left { first_operand.end } else { second_operand.end }
    let literal_start: UIntSize = if parameter_on_left { second_operand.start } else { first_operand.start }
    let literal_end: UIntSize = if parameter_on_left { second_operand.end } else { first_operand.end }
    let parameter_use_kind: UInt8 = if parameter_on_left { first_operand.kind } else { second_operand.kind }
    let literal_kind: UInt8 = if parameter_on_left { second_operand.kind } else { first_operand.kind }
    let declaration_end: TokenInfo = scan_token_info(bytes, second_operand.end, body_end_exclusive)
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if parameter_use_kind != 1u8 { return invalid }
    if operator.kind != 3u8 { return invalid }
    if literal_kind != 2u8 { return invalid }
    if declaration_end.kind == 3u8 {
        if bytes[declaration_end.start] != 0x3Bu8 { return invalid }
    } else {
        if declaration_end.kind != 1u8 { return invalid }
    }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if bytes[operator.start] != 0x2Bu8 {
        if bytes[operator.start] != 0x2Du8 {
            if bytes[operator.start] != 0x2Au8 { return invalid }
        }
    }
    if !stage2_same_ascii(bytes, parameter.name_start, parameter.name_end, parameter_use_start, parameter_use_end) {
        return invalid
    }
    var literal_value: UIntSize = 0usize
    var literal_index: UIntSize = literal_start
    while literal_index < literal_end {
        literal_value = literal_value * 10usize + (bytes[literal_index] as UIntSize) - 48usize
        literal_index = literal_index + 1usize
    }
    var return_start_cursor: UIntSize = second_operand.end
    if declaration_end.kind == 3u8 {
        return_start_cursor = declaration_end.end
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive {
        return invalid
    }
    return Stage2LocalBindingInfo {
        valid: true,
        parameter_start: parameter.name_start,
        parameter_end: parameter.name_end,
        declaration_start: name.start,
        declaration_end: name.end,
        literal_start: literal_start,
        literal_end: literal_end,
        binary_start: if parameter_on_left { parameter_use_start } else { literal_start },
        binary_end: if parameter_on_left { literal_end } else { parameter_use_end },
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
        use_start: return_name.start,
        use_end: return_name.end,
        literal_value: literal_value,
        operator_opcode: if bytes[operator.start] == 0x2Bu8 { 2u8 } else if bytes[operator.start] == 0x2Du8 { 3u8 } else { 4u8 },
        parameter_on_left: parameter_on_left,
    }
}

fn stage2_parse_literal_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2LocalBindingInfo {
    let invalid: Stage2LocalBindingInfo = Stage2LocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        literal_value: 0usize,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let literal: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_end: TokenInfo = scan_token_info(bytes, literal.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if literal.kind != 2u8 { return invalid }
    if declaration_end.kind == 3u8 {
        if bytes[declaration_end.start] != 0x3Bu8 { return invalid }
    } else if declaration_end.kind != 1u8 {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    var literal_value: UIntSize = 0usize
    var literal_index: UIntSize = literal.start
    while literal_index < literal.end {
        literal_value = literal_value * 10usize + (bytes[literal_index] as UIntSize) - 48usize
        literal_index = literal_index + 1usize
    }
    var return_start_cursor: UIntSize = declaration_end.start
    if declaration_end.kind == 3u8 { return_start_cursor = declaration_end.end }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
    }
    if return_end.kind == 3u8 {
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2LocalBindingInfo {
        valid: true,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: name.start,
        declaration_end: name.end,
        literal_start: literal.start,
        literal_end: literal.end,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
        use_start: return_name.start,
        use_end: return_name.end,
        literal_value: literal_value,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
}

fn stage2_parse_direct_call_binding_prefix(
    bytes: read Slice<UInt8>,
    statement_start: UIntSize,
    call_start: UIntSize,
) -> Stage2DirectCallResultBindingInfo {
    let invalid = stage2_invalid_direct_call_result_binding_info()
    if statement_start >= call_start {
        return invalid
    }
    let let_token = scan_token_info(bytes, statement_start, call_start)
    let name = scan_token_info(bytes, let_token.end, call_start)
    let colon = scan_token_info(bytes, name.end, call_start)
    let type_name = scan_token_info(bytes, colon.end, call_start)
    let equals = scan_token_info(bytes, type_name.end, call_start)
    let initializer = scan_token_info(bytes, equals.end, call_start)
    if let_token.kind != 1u8 {
        return invalid
    }
    if name.kind != 1u8 {
        return invalid
    }
    if colon.kind != 3u8 {
        return invalid
    }
    if type_name.kind != 1u8 {
        return invalid
    }
    if equals.kind != 3u8 {
        return invalid
    }
    if initializer.start != call_start {
        return invalid
    }
    if let_token.end - let_token.start != 3usize {
        return invalid
    }
    if bytes[let_token.start] != 0x6Cu8 {
        return invalid
    }
    if bytes[let_token.start + 1usize] != 0x65u8 {
        return invalid
    }
    if bytes[let_token.start + 2usize] != 0x74u8 {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 {
        return invalid
    }
    if bytes[equals.start] != 0x3Du8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    return Stage2DirectCallResultBindingInfo {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        use_start: 0usize,
        use_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
}

fn stage2_parse_direct_call_result_binding(
    bytes: read Slice<UInt8>,
    statement_start: UIntSize,
    statement_end: UIntSize,
    body_end: UIntSize,
    call_start: UIntSize,
    call_end: UIntSize,
) -> Stage2DirectCallResultBindingInfo {
    let invalid: Stage2DirectCallResultBindingInfo = Stage2DirectCallResultBindingInfo {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if statement_start >= statement_end {
        return invalid
    }
    if call_start >= call_end {
        return invalid
    }
    if body_end <= statement_end + 1usize {
        return invalid
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, statement_start, call_start)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, call_start)
    let colon: TokenInfo = scan_token_info(bytes, name.end, call_start)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, call_start)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, call_start)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, call_start)
    if let_token.kind != 1u8 {
        return invalid
    }
    if let_token.end - let_token.start != 3usize {
        return invalid
    }
    if bytes[let_token.start] != 0x6Cu8 {
        return invalid
    }
    if bytes[let_token.start + 1usize] != 0x65u8 {
        return invalid
    }
    if bytes[let_token.start + 2usize] != 0x74u8 {
        return invalid
    }
    if name.kind != 1u8 {
        return invalid
    }
    if colon.kind != 3u8 {
        return invalid
    }
    if type_name.kind != 1u8 {
        return invalid
    }
    if equals.kind != 3u8 {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 {
        return invalid
    }
    if bytes[equals.start] != 0x3Du8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    if initializer.start != call_start {
        return invalid
    }
    let statement_tail: TokenInfo = scan_token_info(bytes, call_end, statement_end)
    if statement_tail.kind != 3u8 {
        return invalid
    }
    if bytes[statement_tail.start] != 0x3Bu8 {
        return invalid
    }
    let statement_trailing: TokenInfo = scan_token_info(bytes, statement_tail.end, statement_end)
    if statement_trailing.start < statement_end {
        return invalid
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, statement_end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 {
        return invalid
    }
    if return_keyword.end - return_keyword.start != 6usize {
        return invalid
    }
    if bytes[return_keyword.start] != 0x72u8 {
        return invalid
    }
    if bytes[return_keyword.start + 1usize] != 0x65u8 {
        return invalid
    }
    if bytes[return_keyword.start + 2usize] != 0x74u8 {
        return invalid
    }
    if bytes[return_keyword.start + 3usize] != 0x75u8 {
        return invalid
    }
    if bytes[return_keyword.start + 4usize] != 0x72u8 {
        return invalid
    }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 {
        return invalid
    }
    if return_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) {
        return invalid
    }
    if return_end.kind != 3u8 {
        return invalid
    }
    if bytes[return_end.start] != 0x3Bu8 {
        return invalid
    }
    let return_trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if return_trailing.start < body_end_exclusive {
        return invalid
    }
    return Stage2DirectCallResultBindingInfo {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        use_start: return_name.start,
        use_end: return_name.end,
        return_start: return_keyword.start,
        return_end: return_end.end,
    }
}

/// Recovers the same bounded result-binding shape from token positions when
/// the generic statement-end span is not aligned with the call scanner's
/// half-open close span. This keeps the admission rule syntax-based while
/// tolerating the two independent producer tables' boundary conventions.
fn stage2_parse_direct_call_result_binding_fallback(
    bytes: read Slice<UInt8>,
    statement_start: UIntSize,
    call_start: UIntSize,
    call_end: UIntSize,
    body_end: UIntSize,
) -> Stage2DirectCallResultBindingInfo {
    let invalid: Stage2DirectCallResultBindingInfo = Stage2DirectCallResultBindingInfo {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if statement_start >= call_start {
        return invalid
    }
    if call_start >= call_end {
        return invalid
    }
    if body_end <= call_end + 1usize {
        return invalid
    }
    let let_token: TokenInfo = scan_token_info(bytes, statement_start, call_start)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, call_start)
    let colon: TokenInfo = scan_token_info(bytes, name.end, call_start)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, call_start)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, call_start)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, call_start)
    if let_token.kind != 1u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if initializer.start != call_start { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let after_call: TokenInfo = scan_token_info(bytes, call_end, body_end_exclusive)
    var return_cursor: UIntSize = call_end
    if after_call.kind == 3u8 {
        if bytes[after_call.start] == 0x3Bu8 {
            return_cursor = after_call.end
        }
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    return Stage2DirectCallResultBindingInfo {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        use_start: return_name.start,
        use_end: return_name.end,
        return_start: return_keyword.start,
        return_end: return_end.end,
    }
}

fn stage2_parse_literal_local_call(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2LocalBindingInfo {
    let invalid: Stage2LocalBindingInfo = Stage2LocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        literal_value: 0usize,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let literal: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_end: TokenInfo = scan_token_info(bytes, literal.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if literal.kind != 2u8 { return invalid }
    if declaration_end.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if bytes[declaration_end.start] != 0x3Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    var literal_value: UIntSize = 0usize
    var literal_index: UIntSize = literal.start
    while literal_index < literal.end {
        literal_value = literal_value * 10usize + (bytes[literal_index] as UIntSize) - 48usize
        literal_index = literal_index + 1usize
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, declaration_end.end, body_end_exclusive)
    let callee: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let open: TokenInfo = scan_token_info(bytes, callee.end, body_end_exclusive)
    let argument: TokenInfo = scan_token_info(bytes, open.end, body_end_exclusive)
    let close: TokenInfo = scan_token_info(bytes, argument.end, body_end_exclusive)
    let statement_end: TokenInfo = scan_token_info(bytes, close.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if callee.kind != 1u8 { return invalid }
    if open.kind != 3u8 { return invalid }
    if argument.kind != 1u8 { return invalid }
    if close.kind != 3u8 { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if bytes[open.start] != 0x28u8 { return invalid }
    if bytes[close.start] != 0x29u8 { return invalid }
    if statement_end.kind != 3u8 { return invalid }
    if bytes[statement_end.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, statement_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive {
        return invalid
    }
    if !stage2_same_ascii(bytes, name.start, name.end, argument.start, argument.end) {
        return invalid
    }
    return Stage2LocalBindingInfo {
        valid: true,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: name.start,
        declaration_end: name.end,
        literal_start: literal.start,
        literal_end: literal.end,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: return_keyword.start,
        return_end: statement_end.end,
        use_start: argument.start,
        use_end: argument.end,
        literal_value: literal_value,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
}

fn stage2_parse_local_call_binary(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2LocalCallBinaryInfo {
    let invalid: Stage2LocalCallBinaryInfo = Stage2LocalCallBinaryInfo {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        first_literal_value: 0usize,
        second_literal_value: 0usize,
        operator_opcode: 0u8,
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let operator: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
    let declaration_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if declaration_end.kind != 3u8 {
        return invalid
    }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if bytes[declaration_end.start] != 0x3Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    let operator_opcode = stage2_binary_opcode(bytes[operator.start])
    if operator_opcode == 0u8 {
        return invalid
    }
    var first_value: UIntSize = 0usize
    var first_index: UIntSize = first_literal.start
    while first_index < first_literal.end {
        first_value = first_value * 10usize + (bytes[first_index] as UIntSize) - 48usize
        first_index = first_index + 1usize
    }
    var second_value: UIntSize = 0usize
    var second_index: UIntSize = second_literal.start
    while second_index < second_literal.end {
        second_value = second_value * 10usize + (bytes[second_index] as UIntSize) - 48usize
        second_index = second_index + 1usize
    }
    if first_value == 2147483648usize { return invalid }
    if second_value == 2147483648usize { return invalid }
    let return_keyword: TokenInfo = scan_token_info(bytes, declaration_end.end, body_end_exclusive)
    let callee: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let open: TokenInfo = scan_token_info(bytes, callee.end, body_end_exclusive)
    let argument: TokenInfo = scan_token_info(bytes, open.end, body_end_exclusive)
    let close: TokenInfo = scan_token_info(bytes, argument.end, body_end_exclusive)
    let statement_end: TokenInfo = scan_token_info(bytes, close.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if callee.kind != 1u8 { return invalid }
    if open.kind != 3u8 { return invalid }
    if argument.kind != 1u8 { return invalid }
    if close.kind != 3u8 { return invalid }
    if statement_end.kind != 3u8 { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if bytes[open.start] != 0x28u8 { return invalid }
    if bytes[close.start] != 0x29u8 { return invalid }
    if bytes[statement_end.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, statement_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive {
        return invalid
    }
    if !stage2_same_ascii(bytes, name.start, name.end, argument.start, argument.end) {
        return invalid
    }
    return Stage2LocalCallBinaryInfo {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        binary_start: first_literal.start,
        binary_end: second_literal.end,
        return_start: return_keyword.start,
        return_end: statement_end.end,
        use_start: argument.start,
        use_end: argument.end,
        first_literal_value: first_value,
        second_literal_value: second_value,
        operator_opcode: operator_opcode,
    }
}

