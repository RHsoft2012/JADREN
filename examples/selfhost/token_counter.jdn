module selfhost.token_counter;

/// Bootstrap dogfooding slice used by the self-hosting prototype.
///
/// The Rust compiler remains the bootstrap authority. This small, allocation-
/// free lexer primitive is intentionally expressible in the 0.1 core and can
/// later be composed into a Jadren lexer module without changing the bootstrap
/// contract.
@repr(C)
pub struct TokenSpan {
    pub start: UIntSize,
    pub end: UIntSize,
}

/// Stable token record used by the next self-hosted lexer layer.
@repr(C)
pub struct TokenInfo {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
}

/// Allocation-free token stream summary used by the first parser-shaped slice.
@repr(C)
pub struct TokenCounts {
    pub identifiers: UIntSize,
    pub numbers: UIntSize,
    pub symbols: UIntSize,
    pub total: UIntSize,
}

/// Parser-shaped source summary used before a complete self-hosted AST.
/// The fields are deliberately small and caller-independent: the stage only
/// counts tokens and checks balanced `{}`/`()` delimiters without allocating.
@repr(C)
pub struct ParseSummary {
    pub tokens: UIntSize,
    pub braces: UIntSize,
    pub parentheses: UIntSize,
    pub errors: UIntSize,
}

/// Small enum fixture for the parser-shaped variant stage. Payload types are
/// intentionally syntax-only here; the resolver remains the Rust bootstrap.
enum TokenKind<T> {
    Identifier,
    Number(T),
    Symbol(value: UInt8),
}

/// Compact declaration header emitted by the parser-shaped pre-AST stage.
/// Kind values are `1=module`, `2=import`, `3=fn`, `4=struct`, `5=enum`.
@repr(C)
pub struct DeclarationHeader {
    pub kind: UInt8,
    pub keyword_start: UIntSize,
    pub keyword_end: UIntSize,
    pub name_start: UIntSize,
    pub name_end: UIntSize,
}

/// Flat top-level AST item index emitted after the declaration pre-stage.
/// `kind` uses the declaration values (`1=module`, `2=import`, `3=fn`,
/// `4=struct`, `5=enum`, `6=extern`). `start/end` cover the complete bounded
/// item, while `body_start/end` is non-empty only for brace-bodied items.
/// This is an allocation-free syntax tree root table, not a typed AST.
@repr(C)
pub struct AstItemHeader {
    pub kind: UInt8,
    pub has_body: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub body_start: UIntSize,
    pub body_end: UIntSize,
}

/// Function-only header emitted before a full typed AST exists.
/// `parameter_count` is a syntax-level comma count and body spans are half-open.
@repr(C)
pub struct FunctionHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub parameter_count: UIntSize,
    pub body_start: UIntSize,
    pub body_end: UIntSize,
}

/// Parameter span emitted by the parser-shaped pre-AST stage. This stable
/// caller-owned layout is also the first AST child view for function items;
/// the owner name and parameter/type spans attach each child to the flat root
/// without introducing typed semantics.
/// `parameter_start/end` cover the complete syntax-level parameter segment;
/// `name_start/end` identify its first identifier token. Exact type syntax is
/// intentionally deferred to the typed AST parser.
@repr(C)
pub struct FunctionParameter {
    pub function_name_start: UIntSize,
    pub function_name_end: UIntSize,
    pub parameter_start: UIntSize,
    pub parameter_end: UIntSize,
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub type_start: UIntSize,
    pub type_end: UIntSize,
}

/// Return-type head emitted by the parser-shaped pre-AST stage.
/// `return_start/end` is the syntax span after `->` and before the body;
/// functions without an explicit arrow use the empty `[end, end)` span.
@repr(C)
pub struct FunctionReturnHeader {
    pub function_name_start: UIntSize,
    pub function_name_end: UIntSize,
    pub return_start: UIntSize,
    pub return_end: UIntSize,
    pub body_start: UIntSize,
    pub body_end: UIntSize,
}

/// Field span emitted by the parser-shaped struct pre-stage.
/// The type is a source span only; visibility, aliases and generic arguments
/// are intentionally left for the typed AST and resolver.
@repr(C)
pub struct StructFieldHeader {
    pub struct_name_start: UIntSize,
    pub struct_name_end: UIntSize,
    pub field_name_start: UIntSize,
    pub field_name_end: UIntSize,
    pub type_start: UIntSize,
    pub type_end: UIntSize,
}

/// Variant span emitted by the parser-shaped enum pre-stage.
/// `payload_start/end` covers the syntax inside the outer parentheses; an
/// empty `[end, end)` span means that the variant has no payload.
@repr(C)
pub struct EnumVariantHeader {
    pub enum_name_start: UIntSize,
    pub enum_name_end: UIntSize,
    pub variant_name_start: UIntSize,
    pub variant_name_end: UIntSize,
    pub payload_start: UIntSize,
    pub payload_end: UIntSize,
}

/// Generic parameter span emitted by the parser-shaped declaration stage.
/// `owner_kind` uses the declaration keyword values (`3=fn`, `4=struct`,
/// `5=enum`); bounds remain syntax-only inside `parameter_start/end`.
@repr(C)
pub struct GenericParameterHeader {
    pub owner_kind: UInt8,
    pub owner_name_start: UIntSize,
    pub owner_name_end: UIntSize,
    pub parameter_start: UIntSize,
    pub parameter_end: UIntSize,
    pub name_start: UIntSize,
    pub name_end: UIntSize,
}

/// Top-level annotation span emitted by the parser-shaped pre-AST stage.
/// An annotation without parentheses has an empty `[end, end)` argument span.
@repr(C)
pub struct AttributeHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub arguments_start: UIntSize,
    pub arguments_end: UIntSize,
}

/// Module/import path span emitted by the parser-shaped source stage.
/// `kind` is `1=module` or `2=import`; separators remain inside the span.
@repr(C)
pub struct PathHeader {
    pub kind: UInt8,
    pub path_start: UIntSize,
    pub path_end: UIntSize,
    pub segment_count: UIntSize,
}

/// Extern-function declaration span emitted by the parser-shaped FFI stage.
/// The ABI, function name, parameter list and optional return type are kept as
/// source spans; `is_unsafe` is syntax-only and does not authorize a call.
@repr(C)
pub struct ExternFunctionHeader {
    pub abi_start: UIntSize,
    pub abi_end: UIntSize,
    pub function_name_start: UIntSize,
    pub function_name_end: UIntSize,
    pub parameter_start: UIntSize,
    pub parameter_end: UIntSize,
    pub parameter_count: UIntSize,
    pub return_start: UIntSize,
    pub return_end: UIntSize,
    pub is_unsafe: UInt8,
}

/// Paired brace block emitted by the parser-shaped structure stage.
/// `depth` is the source nesting depth at the opening brace.
@repr(C)
pub struct BlockHeader {
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only statement header emitted before a complete self-hosted AST.
/// `kind` values are `1=let`, `2=return`, `3=region`, `4=while`, `5=for`,
/// `6=break`, `7=continue`, `8=if`, and `9=match`. Control-flow statements
/// retain the first body block span; simple statements use an empty body span.
@repr(C)
pub struct StatementHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub body_start: UIntSize,
    pub body_end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only expression delimiter group emitted before expression AST
/// lowering. `kind` is `1=parenthesized` or `2=bracketed` (array/index); the
/// record keeps a half-open span and enclosing block depth.
@repr(C)
pub struct ExpressionGroupHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Atom span emitted from one explicit expression range. `kind` is
/// `1=identifier`, `2=number`, `3=parenthesized group`, or `4=bracketed
/// group`; punctuation and operators remain for a later precedence parser.
@repr(C)
pub struct ExpressionAtomHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Operator span emitted from one explicit expression range. `kind` groups
/// assignment, arithmetic/range, comparison, logical/bitwise and
/// propagation/path operators; exact precedence remains a later AST concern.
@repr(C)
pub struct ExpressionOperatorHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Postfix span emitted from one explicit expression range. `kind` is
/// `1=call`, `2=field`, `3=index`, or `4=try`; this stage records syntax only.
@repr(C)
pub struct ExpressionPostfixHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Caller-owned call syntax header. The callee span is the immediately
/// preceding atom/group span, while `open_*`/`close_*` delimit the call
/// argument group. `argument_count` is syntax-only: name resolution,
/// overload selection, and type checking remain outside this hand-off.
@repr(C)
pub struct ExpressionCallHeader {
    pub callee_start: UIntSize,
    pub callee_end: UIntSize,
    pub open_start: UIntSize,
    pub open_end: UIntSize,
    pub close_start: UIntSize,
    pub close_end: UIntSize,
    pub argument_count: UIntSize,
    pub depth: UIntSize,
}

/// Top-level binary expression segment emitted for a later precedence pass.
/// Each record retains the left operand span, operator span and right operand
/// span within the caller-provided expression range.
@repr(C)
pub struct ExpressionBinaryHeader {
    pub kind: UInt8,
    pub left_start: UIntSize,
    pub left_end: UIntSize,
    pub operator_start: UIntSize,
    pub operator_end: UIntSize,
    pub right_start: UIntSize,
    pub right_end: UIntSize,
    pub depth: UIntSize,
}

/// Binary expression node emitted in child-before-parent order by the bounded
/// precedence hand-off. `precedence` and `associativity` mirror the parser
/// table (`associativity=1` left, `2` right); the two-node contract is
/// intentionally additive and does not change `ExpressionBinaryHeader`.
@repr(C)
pub struct ExpressionPrecedenceHeader {
    pub kind: UInt8,
    pub precedence: UInt8,
    pub associativity: UInt8,
    pub left_start: UIntSize,
    pub left_end: UIntSize,
    pub operator_start: UIntSize,
    pub operator_end: UIntSize,
    pub right_start: UIntSize,
    pub right_end: UIntSize,
    pub depth: UIntSize,
}

/// Prefix/unary expression span emitted before type checking. `kind` is
/// `1=plus`, `2=minus`, `3=logical-not`, `4=bit-not`, `5=borrow`, or
/// `6=dereference`.
@repr(C)
pub struct ExpressionUnaryHeader {
    pub kind: UInt8,
    pub operator_start: UIntSize,
    pub operator_end: UIntSize,
    pub operand_start: UIntSize,
    pub operand_end: UIntSize,
    pub depth: UIntSize,
}

/// Literal span emitted from an explicit expression range. `kind` is
/// `1=bool`, `2=integer`, `3=float`, `4=string`, or `5=char`.
@repr(C)
pub struct LiteralHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Narrow typed-semantics hand-off for builtin literals, binary expressions,
/// bounded explicit numeric casts over builtin operands/groups, and caller-owned
/// identifier bindings. `expression_kind` is `1=literal`, `2=binary`,
/// `3=unary`, `4=cast`, `5=name`, `6=scoped-name`, or `7=region-name`; `type_kind` uses the builtin categories
/// `1=Bool`, `2=Integer`, `3=Float`, `4=String`, and `5=Char`. This is not a
/// typed AST or a general resolver: scope, aliases, precedence, calls and user
/// types remain outside the 0.1 self-hosting boundary. Scoped names use a
/// caller-provided lexical delimiter depth; region-name entries additionally
/// require caller-provided visibility spans.
@repr(C)
pub struct TypedExpressionHeader {
    pub expression_kind: UInt8,
    pub type_kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Caller-owned symbol-table entry for the bounded typed-name hand-off. The
/// name span points into the source buffer supplied to the same call. Matching
/// is exact byte equality; no scope, shadowing, alias, generic, or user-defined
/// type resolution is performed by this stage.
@repr(C)
pub struct TypedNameBindingHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub type_kind: UInt8,
}

/// Caller-owned bounded function signature for typed call hand-off. Matching
/// is exact by name bytes and positional argument count; return_type_kind uses
/// the builtin categories and does not imply overload or generic resolution.
@repr(C)
pub struct TypedCallBindingHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub parameter_count: UIntSize,
    pub return_type_kind: UInt8,
}

/// Caller-owned bounded overload candidate for typed-call resolution. A zero
/// generic count marks a concrete overload; positive counts are generic
/// fallbacks. `parameter_type_kind` is the legacy single-literal matcher and
/// the optional u16 span is a comma-separated builtin parameter type list.
/// The resolver prefers exact types, then a compatible builtin family bound,
/// then the lowest generic count and rejects a tie as ambiguous. The bound
/// kind is `0` for unconstrained, `1` Numeric, `2` Boolean and `3` Text.
/// `generic_substitution_kind=1` derives the return builtin from the first
/// argument of a one-argument generic candidate; `2` requires two or more
/// literal arguments to share that type and derives the same return type; `3`
/// derives from the first literal while allowing remaining literal types to
/// differ.
/// Full trait bounds and general substitution remain outside this bounded
/// hand-off.
@repr(C)
pub struct TypedCallCandidateHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub parameter_count: UIntSize,
    pub generic_parameter_count: UIntSize,
    pub return_type_kind: UInt8,
    pub parameter_type_kind: UInt8,
    pub parameter_type_start: UInt16,
    pub parameter_type_end: UInt16,
    pub generic_bound_kind: UInt8,
    pub generic_substitution_kind: UInt8,
}

/// Caller-owned lexical-depth binding for the bounded scoped-name hand-off.
/// The deepest visible matching entry wins; later entries win equal-depth
/// ties. This is a resolver-shaped prototype, not a complete scope system.
@repr(C)
pub struct TypedScopedNameBindingHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub type_kind: UInt8,
    pub scope_depth: UIntSize,
}

/// Caller-owned region binding for the bounded region-aware name hand-off.
/// A matching identifier is visible only inside `region_start..region_end`;
/// the deepest visible binding wins and later entries win equal-depth ties.
@repr(C)
pub struct TypedRegionNameBindingHeader {
    pub name_start: UIntSize,
    pub name_end: UIntSize,
    pub region_start: UIntSize,
    pub region_end: UIntSize,
    pub type_kind: UInt8,
    pub scope_depth: UIntSize,
}

/// Type-syntax component emitted from an explicit type span. `kind` is
/// `1=path/identifier`, `2=capability`, `3=function keyword`, `4=array open`,
/// `5=array close`, `6=function group open`, `7=function group close`,
/// `8=generic open`, `9=generic close`, `10=path separator`, `11=comma`,
/// `12=array length separator`, `13=bound plus`, or `14=function arrow`.
/// `depth` is the delimiter depth before the component is applied.
@repr(C)
pub struct TypeComponentHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only match-arm header emitted before pattern/type lowering.
/// `pattern_start/end` covers the arm pattern, `guard_start/end` covers the
/// expression after `if` (or is empty), and `body_start/end` covers the arm
/// expression or block after `=>`. All spans are half-open and caller-owned.
@repr(C)
pub struct MatchArmHeader {
    pub pattern_start: UIntSize,
    pub pattern_end: UIntSize,
    pub guard_start: UIntSize,
    pub guard_end: UIntSize,
    pub body_start: UIntSize,
    pub body_end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only pattern node emitted from one explicit pattern span.
/// `kind` is `1=wildcard`, `2=path`, `3=literal`, or `4=constructor`; a
/// constructor keeps the payload inside its outer parentheses as a span.
@repr(C)
pub struct PatternHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub payload_start: UIntSize,
    pub payload_end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only binding candidate emitted from a pattern range. `kind` is
/// `1=binding`; constructor/path segments and wildcard/literal tokens are
/// excluded. `start/end` is the identifier span and `depth` is the scalar
/// delimiter depth before the identifier is consumed.
@repr(C)
pub struct PatternBindingHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-only pattern recovery record. `kind` is `1=unclosed opener` or
/// `2=unmatched closer`; `start/end` identifies the offending delimiter span
/// or the bounded range from the first opener to `end`.
@repr(C)
pub struct PatternRecoveryHeader {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

/// Syntax-level delimiter diagnostic. `kind` is `1=unmatched closer`,
/// `2=unclosed opener`, or `3=mismatched closer`; `expected` and `actual`
/// contain ASCII delimiter bytes (`actual=0` for an unclosed opener).
/// The parser receives a caller-owned opener stack and never allocates.
@repr(C)
pub struct PatternDiagnosticHeader {
    pub kind: UInt8,
    pub expected: UInt8,
    pub actual: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
    pub depth: UIntSize,
}

@repr(C)
pub struct DiagnosticValue {
    pub code: UInt16,
    pub severity: UInt8,
}

/// Jadren-side descriptor for the implementation-neutral frontend API.
/// Callback table layout remains in the separate C contract; the source-level
/// function value type does not by itself define ABI lifetime or ownership.
@repr(C)
pub struct FrontendApiDescriptor {
    pub api_version: UInt32,
    pub token_span_size: UIntSize,
    pub diagnostic_size: UIntSize,
    pub byte_class_count: UInt8,
}

/// Host-provided direct dispatch boundary for the versioned API.
/// The host must bind this symbol to a validated `FrontendApiV1` table entry.
extern "C" {
    unsafe fn jadren_frontend_api_classify_byte(byte: UInt8) -> UInt8;
    unsafe fn jadren_frontend_api_token_span(start: UIntSize, end: UIntSize) -> TokenSpan;
    unsafe fn jadren_frontend_api_token_info(
        kind: UInt8,
        start: UIntSize,
        end: UIntSize,
    ) -> TokenInfo;
    unsafe fn jadren_frontend_api_diagnostic(code: UInt16, severity: UInt8) -> DiagnosticValue;
}

@export(name: "jadren_selfhost_is_identifier_start", abi: "C")
@noalloc
pub fn is_identifier_start(byte: UInt8) -> Bool {
    var valid: Bool = false
    if byte == 0x5Fu8 {
        valid = true
    }
    if byte >= 0x41u8 {
        if byte <= 0x5Au8 {
            valid = true
        }
    }
    if byte >= 0x61u8 {
        if byte <= 0x7Au8 {
            valid = true
        }
    }
    return valid
}

/// Returns a compact token-byte class without allocating or reading memory:
/// identifier byte = 1, decimal digit = 2, ASCII whitespace = 3, other = 0.
@export(name: "jadren_selfhost_classify_byte", abi: "C")
@noalloc
pub fn classify_byte(byte: UInt8) -> UInt8 {
    if is_identifier_start(byte) {
        return 1u8
    }
    if byte >= 0x30u8 {
        if byte <= 0x39u8 {
            return 2u8
        }
    }
    if byte == 0x09u8 {
        return 3u8
    }
    if byte == 0x0Au8 {
        return 3u8
    }
    if byte == 0x20u8 {
        return 3u8
    }
    return 0u8
}

/// Classifies every byte in a caller-owned slice in place and returns the
/// number of visited elements. This is the first range-shaped lexer primitive:
/// it exercises allocation-free slice iteration while reusing the single-byte
/// classification authority above.
@export(name: "jadren_selfhost_classify_bytes_in_place", abi: "C")
@noalloc
pub fn classify_bytes_in_place(bytes: write Slice<UInt8>) -> UIntSize {
    var processed: UIntSize = 0usize
    for index in bytes.indices {
        bytes[index] = classify_byte(bytes[index])
        processed = processed + 1usize
    }
    return processed
}

/// Constructs the source span carried by a future self-hosted token.
@export(name: "jadren_selfhost_token_span", abi: "C")
@noalloc
pub fn token_span(start: UIntSize, end: UIntSize) -> TokenSpan {
    return TokenSpan { start: start, end: end }
}

/// Calls the host-provided aggregate `FrontendApiV1` span constructor.
@export(name: "jadren_selfhost_token_span_via_api", abi: "C")
pub fn token_span_via_api(start: UIntSize, end: UIntSize) -> TokenSpan {
    return jadren_frontend_api_token_span(start, end)
}

/// Calls the additive `FrontendTokenInfoApiV1` aggregate constructor.
@export(name: "jadren_selfhost_token_info_via_api", abi: "C")
pub fn token_info_via_api(kind: UInt8, start: UIntSize, end: UIntSize) -> TokenInfo {
    return jadren_frontend_api_token_info(kind, start, end)
}

/// Constructs a stable diagnostic payload for the future self-hosted lexer.
@export(name: "jadren_selfhost_diagnostic", abi: "C")
@noalloc
pub fn diagnostic(code: UInt16, severity: UInt8) -> DiagnosticValue {
    return DiagnosticValue { code: code, severity: severity }
}

/// Calls the host-provided aggregate `FrontendApiV1` diagnostic constructor.
@export(name: "jadren_selfhost_diagnostic_via_api", abi: "C")
pub fn diagnostic_via_api(code: UInt16, severity: UInt8) -> DiagnosticValue {
    return jadren_frontend_api_diagnostic(code, severity)
}

/// Exposes the parts of `FrontendApiV1` that are expressible by Jadren 0.1.
@export(name: "jadren_selfhost_frontend_api_descriptor", abi: "C")
@noalloc
pub fn frontend_api_descriptor() -> FrontendApiDescriptor {
    return FrontendApiDescriptor {
        api_version: 1u32,
        token_span_size: 16usize,
        diagnostic_size: 4usize,
        byte_class_count: 4u8,
    }
}

/// Calls the host-provided C entry without exposing a Rust function-pointer
/// representation to Jadren 0.1 source.
@export(name: "jadren_selfhost_classify_via_api", abi: "C")
pub fn classify_via_api(byte: UInt8) -> UInt8 {
    return jadren_frontend_api_classify_byte(byte)
}

/// Dispatches a caller-owned byte range through the versioned host API.
/// Unlike `classify_bytes_in_place`, this path does not duplicate the byte
/// classification rules in Jadren; every element crosses the extern contract.
@export(name: "jadren_selfhost_classify_bytes_via_api", abi: "C")
pub fn classify_bytes_via_api(bytes: write Slice<UInt8>) -> UIntSize {
    var processed: UIntSize = 0usize
    for index in bytes.indices {
        bytes[index] = jadren_frontend_api_classify_byte(bytes[index])
        processed = processed + 1usize
    }
    return processed
}

/// Scans an identifier-shaped token in the half-open caller-provided range
/// `[start, end)`. ASCII letters/underscore and decimal digits are accepted;
/// the first other byte terminates the token and the original start is kept in
/// the returned aggregate.
@export(name: "jadren_selfhost_scan_identifier", abi: "C")
@noalloc
pub fn scan_identifier(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenSpan {
    var index: UIntSize = start
    while index < end {
        let class: UInt8 = classify_byte(bytes[index])
        if class == 1u8 {
            index = index + 1usize
        } else {
            if class == 2u8 {
                index = index + 1usize
            } else {
                break
            }
        }
    }
    return TokenSpan { start: start, end: index }
}

/// Scans the same identifier-shaped token through the host-provided
/// `FrontendApiV1` byte classifier. This composes the external dispatch
/// contract with the allocation-free aggregate scan without duplicating the
/// byte classification rules in this function.
@export(name: "jadren_selfhost_scan_identifier_via_api", abi: "C")
pub fn scan_identifier_via_api(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenSpan {
    var index: UIntSize = start
    while index < end {
        let class: UInt8 = jadren_frontend_api_classify_byte(bytes[index])
        if class == 1u8 {
            index = index + 1usize
        } else {
            if class == 2u8 {
                index = index + 1usize
            } else {
                break
            }
        }
    }
    return TokenSpan { start: start, end: index }
}

/// Scans the next token-shaped span in `[start, end)`: leading ASCII
/// whitespace is skipped, identifiers accept decimal digits after their first
/// byte, decimal numbers accept digits, and any other byte is one symbol.
/// This remains allocation-free and returns `[end, end)` for whitespace-only
/// or empty ranges.
@export(name: "jadren_selfhost_scan_token", abi: "C")
@noalloc
pub fn scan_token(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenSpan {
    var index: UIntSize = start
    while index < end {
        let class: UInt8 = classify_byte(bytes[index])
        if class == 3u8 {
            index = index + 1usize
        } else {
            break
        }
    }
    let token_start: UIntSize = index
    if index < end {
        let class: UInt8 = classify_byte(bytes[index])
        if class == 1u8 {
            while index < end {
                let next: UInt8 = classify_byte(bytes[index])
                if next == 1u8 {
                    index = index + 1usize
                } else {
                    if next == 2u8 {
                        index = index + 1usize
                    } else {
                        break
                    }
                }
            }
        } else {
            if class == 2u8 {
                while index < end {
                    let next: UInt8 = classify_byte(bytes[index])
                    if next == 2u8 {
                        index = index + 1usize
                    } else {
                        break
                    }
                }
            } else {
                index = index + 1usize
            }
        }
    }
    return TokenSpan { start: token_start, end: index }
}

/// Returns the next token span together with its compact kind:
/// 0 = no token, 1 = identifier, 2 = decimal number, 3 = symbol.
@export(name: "jadren_selfhost_scan_token_info", abi: "C")
@noalloc
pub fn scan_token_info(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenInfo {
    let span = scan_token(bytes, start, end)
    var kind: UInt8 = 0u8
    if span.start < end {
        let class: UInt8 = classify_byte(bytes[span.start])
        if class == 1u8 {
            kind = 1u8
        } else {
            if class == 2u8 {
                kind = 2u8
            } else {
                kind = 3u8
            }
        }
    }
    return TokenInfo { kind: kind, start: span.start, end: span.end }
}

/// Counts the next tokens in `[start, end)` without allocating or copying the
/// source. The reducer stops when the scanner reaches the end without a token.
@export(name: "jadren_selfhost_count_tokens", abi: "C")
@noalloc
pub fn count_tokens(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenCounts {
    var index: UIntSize = start
    var identifiers: UIntSize = 0usize
    var numbers: UIntSize = 0usize
    var symbols: UIntSize = 0usize
    var total: UIntSize = 0usize
    while index < end {
        let info: TokenInfo = scan_token_info(bytes, index, end)
        if info.start >= end {
            break
        }
        if info.kind == 1u8 {
            identifiers = identifiers + 1usize
        } else {
            if info.kind == 2u8 {
                numbers = numbers + 1usize
            } else {
                symbols = symbols + 1usize
            }
        }
        total = total + 1usize
        index = info.end
    }
    return TokenCounts {
        identifiers: identifiers,
        numbers: numbers,
        symbols: symbols,
        total: total,
    }
}

/// Counts the same token stream through the host-provided byte classifier.
/// This is the first reducer-shaped self-hosting primitive that composes a
/// caller-owned slice, a host callback and a by-value aggregate result.
@export(name: "jadren_selfhost_count_tokens_via_api", abi: "C")
pub fn count_tokens_via_api(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TokenCounts {
    var index: UIntSize = start
    var identifiers: UIntSize = 0usize
    var numbers: UIntSize = 0usize
    var symbols: UIntSize = 0usize
    var total: UIntSize = 0usize
    while index < end {
        while index < end {
            let whitespace: UInt8 = jadren_frontend_api_classify_byte(bytes[index])
            if whitespace == 3u8 {
                index = index + 1usize
            } else {
                break
            }
        }
        if index >= end {
            break
        }
        let first: UInt8 = jadren_frontend_api_classify_byte(bytes[index])
        if first == 1u8 {
            identifiers = identifiers + 1usize
            index = index + 1usize
            while index < end {
                let next: UInt8 = jadren_frontend_api_classify_byte(bytes[index])
                if next == 1u8 {
                    index = index + 1usize
                } else {
                    if next == 2u8 {
                        index = index + 1usize
                    } else {
                        break
                    }
                }
            }
        } else {
            if first == 2u8 {
                numbers = numbers + 1usize
                index = index + 1usize
                while index < end {
                    let next: UInt8 = jadren_frontend_api_classify_byte(bytes[index])
                    if next == 2u8 {
                        index = index + 1usize
                    } else {
                        break
                    }
                }
            } else {
                symbols = symbols + 1usize
                index = index + 1usize
            }
        }
        total = total + 1usize
    }
    return TokenCounts {
        identifiers: identifiers,
        numbers: numbers,
        symbols: symbols,
        total: total,
    }
}

/// Produces the first parser-shaped summary for a caller-owned source range.
/// `braces` and `parentheses` contain unmatched opening delimiters at the end
/// of the scan; `errors` contains unmatched closings plus those remaining
/// openings. This is a structural pre-parser contract, not an AST parser.
@export(name: "jadren_selfhost_summarize_source", abi: "C")
@noalloc
pub fn summarize_source(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> ParseSummary {
    var index: UIntSize = start
    var tokens: UIntSize = 0usize
    var braces: UIntSize = 0usize
    var parentheses: UIntSize = 0usize
    var errors: UIntSize = 0usize
    while index < end {
        let info: TokenInfo = scan_token_info(bytes, index, end)
        if info.start >= end {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x7Bu8 {
                braces = braces + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if braces > 0usize {
                        braces = braces - 1usize
                    } else {
                        errors = errors + 1usize
                    }
                } else {
                    if symbol == 0x28u8 {
                        parentheses = parentheses + 1usize
                    } else {
                        if symbol == 0x29u8 {
                            if parentheses > 0usize {
                                parentheses = parentheses - 1usize
                            } else {
                                errors = errors + 1usize
                            }
                        }
                    }
                }
            }
        }
        tokens = tokens + 1usize
        index = info.end
    }
    errors = errors + braces + parentheses
    return ParseSummary {
        tokens: tokens,
        braces: braces,
        parentheses: parentheses,
        errors: errors,
    }
}

/// Materializes a bounded token stream into caller-owned `TokenInfo` storage.
/// This is the first pre-AST hand-off: no allocation or hidden global state is
/// used, and the return value is the number of records actually written.
@export(name: "jadren_selfhost_lex_tokens", abi: "C")
@noalloc
pub fn lex_tokens(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TokenInfo>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        if source_index >= end {
            break
        }
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            break
        }
        let next_source: UIntSize = info.end
        output[slot] = info
        output_index = output_index + 1usize
        source_index = next_source
    }
    return output_index
}

/// Returns the declaration kind for one identifier token, or zero when the
/// token is not one of the supported top-level declaration keywords.
/// Kind `6` is an `extern` block.
@noalloc
fn declaration_kind(
    bytes: read Slice<UInt8>,
    token_kind: UInt8,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    if token_kind != 1u8 {
        return 0u8
    }
    let width: UIntSize = end - start
    if width == 2usize {
        if bytes[start] == 0x66u8 {
            if bytes[start + 1usize] == 0x6Eu8 {
                return 3u8
            }
        }
    }
    if width == 4usize {
        if bytes[start] == 0x65u8 {
            if bytes[start + 1usize] == 0x6Eu8 {
                if bytes[start + 2usize] == 0x75u8 {
                    if bytes[start + 3usize] == 0x6Du8 {
                        return 5u8
                    }
                }
            }
        }
    }
    if width == 6usize {
        if bytes[start] == 0x6Du8 {
            if bytes[start + 1usize] == 0x6Fu8 {
                if bytes[start + 2usize] == 0x64u8 {
                    if bytes[start + 3usize] == 0x75u8 {
                        if bytes[start + 4usize] == 0x6Cu8 {
                            if bytes[start + 5usize] == 0x65u8 {
                                return 1u8
                            }
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x69u8 {
            if bytes[start + 1usize] == 0x6Du8 {
                if bytes[start + 2usize] == 0x70u8 {
                    if bytes[start + 3usize] == 0x6Fu8 {
                        if bytes[start + 4usize] == 0x72u8 {
                            if bytes[start + 5usize] == 0x74u8 {
                                return 2u8
                            }
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x73u8 {
            if bytes[start + 1usize] == 0x74u8 {
                if bytes[start + 2usize] == 0x72u8 {
                    if bytes[start + 3usize] == 0x75u8 {
                        if bytes[start + 4usize] == 0x63u8 {
                            if bytes[start + 5usize] == 0x74u8 {
                                return 4u8
                            }
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x65u8 {
            if bytes[start + 1usize] == 0x78u8 {
                if bytes[start + 2usize] == 0x74u8 {
                    if bytes[start + 3usize] == 0x65u8 {
                        if bytes[start + 4usize] == 0x72u8 {
                            if bytes[start + 5usize] == 0x6Eu8 {
                                return 6u8
                            }
                        }
                    }
                }
            }
        }
    }
    return 0u8
}

/// Returns the syntax-only statement kind for one identifier token. The
/// returned values are consumed by `parse_statements`; no keyword is treated
/// as proof of type correctness or control-flow validity at this stage.
@noalloc
fn statement_kind(
    bytes: read Slice<UInt8>,
    token_kind: UInt8,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    if token_kind != 1u8 {
        return 0u8
    }
    let width: UIntSize = end - start
    if width == 2usize {
        if bytes[start] == 0x69u8 {
            if bytes[start + 1usize] == 0x66u8 {
                return 8u8
            }
        }
    }
    if width == 3usize {
        if bytes[start] == 0x6Cu8 {
            if bytes[start + 1usize] == 0x65u8 {
                if bytes[start + 2usize] == 0x74u8 {
                    return 1u8
                }
            }
        }
        if bytes[start] == 0x66u8 {
            if bytes[start + 1usize] == 0x6Fu8 {
                if bytes[start + 2usize] == 0x72u8 {
                    return 5u8
                }
            }
        }
    }
    if width == 5usize {
        if bytes[start] == 0x62u8 {
            if bytes[start + 1usize] == 0x72u8 {
                if bytes[start + 2usize] == 0x65u8 {
                    if bytes[start + 3usize] == 0x61u8 {
                        if bytes[start + 4usize] == 0x6Bu8 {
                            return 6u8
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x77u8 {
            if bytes[start + 1usize] == 0x68u8 {
                if bytes[start + 2usize] == 0x69u8 {
                    if bytes[start + 3usize] == 0x6Cu8 {
                        if bytes[start + 4usize] == 0x65u8 {
                            return 4u8
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x6Du8 {
            if bytes[start + 1usize] == 0x61u8 {
                if bytes[start + 2usize] == 0x74u8 {
                    if bytes[start + 3usize] == 0x63u8 {
                        if bytes[start + 4usize] == 0x68u8 {
                            return 9u8
                        }
                    }
                }
            }
        }
    }
    if width == 6usize {
        if bytes[start] == 0x72u8 {
            if bytes[start + 1usize] == 0x65u8 {
                if bytes[start + 2usize] == 0x74u8 {
                    if bytes[start + 3usize] == 0x75u8 {
                        if bytes[start + 4usize] == 0x72u8 {
                            if bytes[start + 5usize] == 0x6Eu8 {
                                return 2u8
                            }
                        }
                    }
                }
            }
        }
        if bytes[start] == 0x72u8 {
            if bytes[start + 1usize] == 0x65u8 {
                if bytes[start + 2usize] == 0x67u8 {
                    if bytes[start + 3usize] == 0x69u8 {
                        if bytes[start + 4usize] == 0x6Fu8 {
                            if bytes[start + 5usize] == 0x6Eu8 {
                                return 3u8
                            }
                        }
                    }
                }
            }
        }
    }
    if width == 8usize {
        if bytes[start] == 0x63u8 {
            if bytes[start + 1usize] == 0x6Fu8 {
                if bytes[start + 2usize] == 0x6Eu8 {
                    if bytes[start + 3usize] == 0x74u8 {
                        if bytes[start + 4usize] == 0x69u8 {
                            if bytes[start + 5usize] == 0x6Eu8 {
                                if bytes[start + 6usize] == 0x75u8 {
                                    if bytes[start + 7usize] == 0x65u8 {
                                        return 7u8
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0u8
}

/// Returns whether a syntax-only statement kind owns a following body block.
/// Loop-control and value statements intentionally remain header-only.
@noalloc
fn statement_has_body(kind: UInt8) -> Bool {
    if kind == 3u8 {
        return true
    }
    if kind == 4u8 {
        return true
    }
    if kind == 5u8 {
        return true
    }
    if kind == 8u8 {
        return true
    }
    if kind == 9u8 {
        return true
    }
    return false
}

/// Returns the longest contiguous operator span beginning at `start`.
/// Expression tokenization is byte-based here, so whitespace never joins two
/// operator characters. The caller must provide a valid `[start,end)` range.
@noalloc
fn operator_span_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let remaining: UIntSize = end - start
    if remaining >= 3usize {
        if bytes[start] == 0x2Eu8 {
            if bytes[start + 1usize] == 0x2Eu8 {
                if bytes[start + 2usize] == 0x3Cu8 {
                    return start + 3usize
                }
            }
        }
    }
    if remaining >= 2usize {
        if bytes[start] == 0x3Du8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
            if bytes[start + 1usize] == 0x3Eu8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x21u8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x3Cu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x3Eu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x26u8 {
            if bytes[start + 1usize] == 0x26u8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x7Cu8 {
            if bytes[start + 1usize] == 0x7Cu8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x2Bu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x2Du8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
            if bytes[start + 1usize] == 0x3Eu8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x2Au8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x2Fu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x25u8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x2Eu8 {
            if bytes[start + 1usize] == 0x2Eu8 {
                return start + 2usize
            }
        }
        if bytes[start] == 0x3Au8 {
            if bytes[start + 1usize] == 0x3Au8 {
                return start + 2usize
            }
        }
    }
    return start + 1usize
}

/// Categorizes one already-bounded operator span. Kinds are `1=assignment`,
/// `2=arithmetic/range`, `3=comparison`, `4=logical/bitwise`,
/// `5=propagation/arrow`, and `6=path separator`.
@noalloc
fn operator_kind(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let width: UIntSize = end - start
    if width == 3usize {
        return 2u8
    }
    if width == 2usize {
        if bytes[start] == 0x3Du8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return 3u8
            }
            return 5u8
        }
        if bytes[start] == 0x21u8 {
            return 3u8
        }
        if bytes[start] == 0x3Cu8 {
            return 3u8
        }
        if bytes[start] == 0x3Eu8 {
            return 3u8
        }
        if bytes[start] == 0x26u8 {
            return 4u8
        }
        if bytes[start] == 0x7Cu8 {
            return 4u8
        }
        if bytes[start] == 0x2Bu8 {
            return 1u8
        }
        if bytes[start] == 0x2Du8 {
            if bytes[start + 1usize] == 0x3Eu8 {
                return 5u8
            }
            return 1u8
        }
        if bytes[start] == 0x2Au8 {
            return 1u8
        }
        if bytes[start] == 0x2Fu8 {
            return 1u8
        }
        if bytes[start] == 0x25u8 {
            return 1u8
        }
        if bytes[start] == 0x2Eu8 {
            return 2u8
        }
        if bytes[start] == 0x3Au8 {
            return 6u8
        }
    }
    if width == 1usize {
        if bytes[start] == 0x3Du8 {
            return 1u8
        }
        if bytes[start] == 0x2Bu8 {
            return 2u8
        }
        if bytes[start] == 0x2Du8 {
            return 2u8
        }
        if bytes[start] == 0x2Au8 {
            return 2u8
        }
        if bytes[start] == 0x2Fu8 {
            return 2u8
        }
        if bytes[start] == 0x25u8 {
            return 2u8
        }
        if bytes[start] == 0x3Cu8 {
            return 3u8
        }
        if bytes[start] == 0x3Eu8 {
            return 3u8
        }
        if bytes[start] == 0x21u8 {
            return 4u8
        }
        if bytes[start] == 0x26u8 {
            return 4u8
        }
        if bytes[start] == 0x7Cu8 {
            return 4u8
        }
        if bytes[start] == 0x5Eu8 {
            return 4u8
        }
        if bytes[start] == 0x7Eu8 {
            return 4u8
        }
        if bytes[start] == 0x3Fu8 {
            return 5u8
        }
    }
    return 0u8
}

/// Returns the parser precedence for one bounded operator span. Values mirror
/// `jadren-parser::infix_precedence`: assignment `1`, `||` `2`, `&&` `3`,
/// equality `4`, ordering `5`, ranges `6`, additive `7`, multiplicative `8`,
/// ampersand `9` and xor/pipe `10`.
@noalloc
fn expression_operator_precedence(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let width: UIntSize = end - start
    if width == 1usize {
        if bytes[start] == 0x3Du8 {
            return 1u8
        }
        if bytes[start] == 0x2Bu8 {
            return 7u8
        }
        if bytes[start] == 0x2Du8 {
            return 7u8
        }
        if bytes[start] == 0x2Au8 {
            return 8u8
        }
        if bytes[start] == 0x2Fu8 {
            return 8u8
        }
        if bytes[start] == 0x25u8 {
            return 8u8
        }
        if bytes[start] == 0x26u8 {
            return 9u8
        }
        if bytes[start] == 0x5Eu8 {
            return 10u8
        }
        if bytes[start] == 0x7Cu8 {
            return 10u8
        }
        if bytes[start] == 0x3Cu8 {
            return 5u8
        }
        if bytes[start] == 0x3Eu8 {
            return 5u8
        }
    }
    if width == 3usize {
        if bytes[start] == 0x2Eu8 {
            if bytes[start + 1usize] == 0x2Eu8 {
                if bytes[start + 2usize] == 0x3Cu8 {
                    return 6u8
                }
            }
        }
    }
    if width == 2usize {
        if bytes[start] == 0x3Du8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return 4u8
            }
            if bytes[start + 1usize] == 0x2Bu8 {
                return 1u8
            }
            if bytes[start + 1usize] == 0x2Du8 {
                return 1u8
            }
            if bytes[start + 1usize] == 0x2Au8 {
                return 1u8
            }
            if bytes[start + 1usize] == 0x2Fu8 {
                return 1u8
            }
            if bytes[start + 1usize] == 0x25u8 {
                return 1u8
            }
        }
        if bytes[start] == 0x21u8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return 4u8
            }
        }
        if bytes[start] == 0x3Cu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return 5u8
            }
        }
        if bytes[start] == 0x3Eu8 {
            if bytes[start + 1usize] == 0x3Du8 {
                return 5u8
            }
        }
        if bytes[start] == 0x26u8 {
            if bytes[start + 1usize] == 0x26u8 {
                return 3u8
            }
        }
        if bytes[start] == 0x7Cu8 {
            if bytes[start + 1usize] == 0x7Cu8 {
                return 2u8
            }
        }
        if bytes[start] == 0x2Eu8 {
            if bytes[start + 1usize] == 0x2Eu8 {
                return 6u8
            }
        }
    }
    return 0u8
}

/// Recognizes the one-byte prefix operators that are valid while the parser
/// expects an operand. A prefix operator is not a binary precedence node.
@noalloc
fn is_unary_prefix_operator(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Bool {
    if end - start != 1usize {
        return false
    }
    let symbol: UInt8 = bytes[start]
    if symbol == 0x2Bu8 {
        return true
    }
    if symbol == 0x2Du8 {
        return true
    }
    if symbol == 0x21u8 {
        return true
    }
    if symbol == 0x7Eu8 {
        return true
    }
    if symbol == 0x26u8 {
        return true
    }
    if symbol == 0x2Au8 {
        return true
    }
    return false
}

@noalloc
fn expression_operator_associativity(precedence: UInt8) -> UInt8 {
    if precedence == 1u8 {
        return 2u8
    }
    if precedence != 0u8 {
        return 1u8
    }
    return 0u8
}

@noalloc
fn bounded_expression_start(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let info: TokenInfo = scan_token_info(bytes, start, end)
    if info.start >= end {
        return end
    }
    return info.start
}

@noalloc
fn bounded_expression_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    var cursor: UIntSize = start
    var last_end: UIntSize = start
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            break
        }
        last_end = info.end
        cursor = info.end
    }
    return last_end
}

/// Emits exactly two binary nodes in child-before-parent order for a bounded
/// three-operand expression. Prefix operators are skipped while an operand is
/// expected; longer expressions and recovery remain later stages.
@export(name: "jadren_selfhost_parse_expression_precedence_headers", abi: "C")
@noalloc
pub fn parse_expression_precedence_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPrecedenceHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var delimiter_stack_count: UIntSize = 0usize
    var expecting_operand: Bool = true
    var operator_count: UIntSize = 0usize
    var first_operator_start: UIntSize = 0usize
    var first_operator_end: UIntSize = 0usize
    var first_precedence: UInt8 = 0u8
    var first_associativity: UInt8 = 0u8
    var second_operator_start: UIntSize = 0usize
    var second_operator_end: UIntSize = 0usize
    var second_precedence: UInt8 = 0u8
    var second_associativity: UInt8 = 0u8
    while source_index < end {
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            source_index = end
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[token_start]
        }
        if symbol == 0x29u8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x28u8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x5Du8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x5Bu8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x28u8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if symbol == 0x5Bu8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if delimiter_stack_count == 0usize {
            if info.kind == 3u8 {
                let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                let precedence: UInt8 = expression_operator_precedence(
                    bytes,
                    token_start,
                    operator_end,
                )
                if precedence != 0u8 {
                    if expecting_operand {
                        if is_unary_prefix_operator(bytes, token_start, operator_end) {
                            source_index = operator_end
                            continue
                        }
                    }
                    let associativity: UInt8 = expression_operator_associativity(precedence)
                    operator_count = operator_count + 1usize
                    if operator_count == 1usize {
                        first_operator_start = token_start
                        first_operator_end = operator_end
                        first_precedence = precedence
                        first_associativity = associativity
                    } else {
                        if operator_count == 2usize {
                            second_operator_start = token_start
                            second_operator_end = operator_end
                            second_precedence = precedence
                            second_associativity = associativity
                        } else {
                            return 0usize
                        }
                    }
                    expecting_operand = true
                    source_index = operator_end
                    continue
                }
            }
        }
        expecting_operand = false
        source_index = next_source
    }
    if delimiter_stack_count != 0usize {
        return 0usize
    }
    if operator_count != 2usize {
        return 0usize
    }
    let left_start: UIntSize = bounded_expression_start(bytes, start, first_operator_start)
    let left_end: UIntSize = bounded_expression_end(bytes, start, first_operator_start)
    let middle_start: UIntSize = bounded_expression_start(
        bytes,
        first_operator_end,
        second_operator_start,
    )
    let middle_end: UIntSize = bounded_expression_end(
        bytes,
        first_operator_end,
        second_operator_start,
    )
    let right_start: UIntSize = bounded_expression_start(bytes, second_operator_end, end)
    let right_end: UIntSize = bounded_expression_end(bytes, second_operator_end, end)
    if left_start >= left_end {
        return 0usize
    }
    if middle_start >= middle_end {
        return 0usize
    }
    if right_start >= right_end {
        return 0usize
    }
    var first_is_child: Bool = false
    if first_precedence > second_precedence {
        first_is_child = true
    } else {
        if first_precedence == second_precedence {
            if first_associativity == 1u8 {
                first_is_child = true
            }
        }
    }
    let child_left_start: UIntSize = if first_is_child { left_start } else { middle_start }
    let child_left_end: UIntSize = if first_is_child { left_end } else { middle_end }
    let child_operator_start: UIntSize = if first_is_child {
        first_operator_start
    } else {
        second_operator_start
    }
    let child_operator_end: UIntSize = if first_is_child {
        first_operator_end
    } else {
        second_operator_end
    }
    let child_right_start: UIntSize = if first_is_child { middle_start } else { right_start }
    let child_right_end: UIntSize = if first_is_child { middle_end } else { right_end }
    let root_left_start: UIntSize = left_start
    let root_left_end: UIntSize = if first_is_child { middle_end } else { left_end }
    let root_operator_start: UIntSize = if first_is_child {
        second_operator_start
    } else {
        first_operator_start
    }
    let root_operator_end: UIntSize = if first_is_child {
        second_operator_end
    } else {
        first_operator_end
    }
    let root_right_start: UIntSize = if first_is_child { right_start } else { middle_start }
    let root_right_end: UIntSize = right_end
    let child_kind: UInt8 = if first_is_child {
        operator_kind(bytes, first_operator_start, first_operator_end)
    } else {
        operator_kind(bytes, second_operator_start, second_operator_end)
    }
    let root_kind: UInt8 = if first_is_child {
        operator_kind(bytes, second_operator_start, second_operator_end)
    } else {
        operator_kind(bytes, first_operator_start, first_operator_end)
    }
    let child_precedence: UInt8 = if first_is_child { first_precedence } else { second_precedence }
    let child_associativity: UInt8 = if first_is_child {
        first_associativity
    } else {
        second_associativity
    }
    let root_precedence: UInt8 = if first_is_child { second_precedence } else { first_precedence }
    let root_associativity: UInt8 = if first_is_child {
        second_associativity
    } else {
        first_associativity
    }
    var emitted: UIntSize = 0usize
    for slot in output.indices {
        if emitted == 0usize {
            output[slot] = ExpressionPrecedenceHeader {
                kind: child_kind,
                precedence: child_precedence,
                associativity: child_associativity,
                left_start: child_left_start,
                left_end: child_left_end,
                operator_start: child_operator_start,
                operator_end: child_operator_end,
                right_start: child_right_start,
                right_end: child_right_end,
                depth: 0usize,
            }
            emitted = emitted + 1usize
        } else {
            if emitted == 1usize {
                output[slot] = ExpressionPrecedenceHeader {
                    kind: root_kind,
                    precedence: root_precedence,
                    associativity: root_associativity,
                    left_start: root_left_start,
                    left_end: root_left_end,
                    operator_start: root_operator_start,
                    operator_end: root_operator_end,
                    right_start: root_right_start,
                    right_end: root_right_end,
                    depth: 0usize,
                }
                emitted = emitted + 1usize
            }
        }
    }
    return emitted
}

/// Emits exactly three binary nodes in post-order for a bounded
/// four-operand/three-operator expression. The root is selected with the
/// parser's precedence and associativity table; prefix operators are skipped
/// while an operand is expected.
@export(name: "jadren_selfhost_parse_expression_precedence_chain_headers", abi: "C")
@noalloc
pub fn parse_expression_precedence_chain_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPrecedenceHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var delimiter_stack_count: UIntSize = 0usize
    var expecting_operand: Bool = true
    var operator_count: UIntSize = 0usize
    var first_operator_start: UIntSize = 0usize
    var first_operator_end: UIntSize = 0usize
    var first_precedence: UInt8 = 0u8
    var first_associativity: UInt8 = 0u8
    var second_operator_start: UIntSize = 0usize
    var second_operator_end: UIntSize = 0usize
    var second_precedence: UInt8 = 0u8
    var second_associativity: UInt8 = 0u8
    var third_operator_start: UIntSize = 0usize
    var third_operator_end: UIntSize = 0usize
    var third_precedence: UInt8 = 0u8
    var third_associativity: UInt8 = 0u8
    while source_index < end {
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            source_index = end
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[token_start]
        }
        if symbol == 0x29u8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x28u8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x5Du8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x5Bu8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x28u8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if symbol == 0x5Bu8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if delimiter_stack_count == 0usize {
            if info.kind == 3u8 {
                let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                let precedence: UInt8 = expression_operator_precedence(
                    bytes,
                    token_start,
                    operator_end,
                )
                if precedence != 0u8 {
                    if expecting_operand {
                        if is_unary_prefix_operator(bytes, token_start, operator_end) {
                            source_index = operator_end
                            continue
                        }
                    }
                    let associativity: UInt8 = expression_operator_associativity(precedence)
                    operator_count = operator_count + 1usize
                    if operator_count == 1usize {
                        first_operator_start = token_start
                        first_operator_end = operator_end
                        first_precedence = precedence
                        first_associativity = associativity
                    } else {
                        if operator_count == 2usize {
                            second_operator_start = token_start
                            second_operator_end = operator_end
                            second_precedence = precedence
                            second_associativity = associativity
                        } else {
                            if operator_count == 3usize {
                                third_operator_start = token_start
                                third_operator_end = operator_end
                                third_precedence = precedence
                                third_associativity = associativity
                            } else {
                                return 0usize
                            }
                        }
                    }
                    expecting_operand = true
                    source_index = operator_end
                    continue
                }
            }
        }
        expecting_operand = false
        source_index = next_source
    }
    if delimiter_stack_count != 0usize {
        return 0usize
    }
    if operator_count != 3usize {
        return 0usize
    }
    let operand_zero_start: UIntSize = bounded_expression_start(bytes, start, first_operator_start)
    let operand_zero_end: UIntSize = bounded_expression_end(bytes, start, first_operator_start)
    let operand_one_start: UIntSize = bounded_expression_start(
        bytes,
        first_operator_end,
        second_operator_start,
    )
    let operand_one_end: UIntSize = bounded_expression_end(
        bytes,
        first_operator_end,
        second_operator_start,
    )
    let operand_two_start: UIntSize = bounded_expression_start(
        bytes,
        second_operator_end,
        third_operator_start,
    )
    let operand_two_end: UIntSize = bounded_expression_end(
        bytes,
        second_operator_end,
        third_operator_start,
    )
    let operand_three_start: UIntSize = bounded_expression_start(bytes, third_operator_end, end)
    let operand_three_end: UIntSize = bounded_expression_end(bytes, third_operator_end, end)
    if operand_zero_start >= operand_zero_end {
        return 0usize
    }
    if operand_one_start >= operand_one_end {
        return 0usize
    }
    if operand_two_start >= operand_two_end {
        return 0usize
    }
    if operand_three_start >= operand_three_end {
        return 0usize
    }
    var root_index: UInt8 = 0u8
    if second_precedence < first_precedence {
        root_index = 1u8
    } else {
        if second_precedence == first_precedence {
            if second_associativity == 1u8 {
                root_index = 1u8
            }
        }
    }
    let root_precedence: UInt8 = if root_index == 0u8 {
        first_precedence
    } else {
        second_precedence
    }
    if third_precedence < root_precedence {
        root_index = 2u8
    } else {
        if third_precedence == root_precedence {
            if third_associativity == 1u8 {
                root_index = 2u8
            }
        }
    }
    var node_one: ExpressionPrecedenceHeader = ExpressionPrecedenceHeader {
        kind: 0u8,
        precedence: 0u8,
        associativity: 0u8,
        left_start: 0usize,
        left_end: 0usize,
        operator_start: 0usize,
        operator_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        depth: 0usize,
    }
    var node_two: ExpressionPrecedenceHeader = ExpressionPrecedenceHeader {
        kind: 0u8,
        precedence: 0u8,
        associativity: 0u8,
        left_start: 0usize,
        left_end: 0usize,
        operator_start: 0usize,
        operator_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        depth: 0usize,
    }
    var node_three: ExpressionPrecedenceHeader = ExpressionPrecedenceHeader {
        kind: 0u8,
        precedence: 0u8,
        associativity: 0u8,
        left_start: 0usize,
        left_end: 0usize,
        operator_start: 0usize,
        operator_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        depth: 0usize,
    }
    if root_index == 0u8 {
        let child_is_first: Bool = if second_precedence > third_precedence {
            true
        } else {
            if second_precedence == third_precedence {
                second_associativity == 1u8
            } else {
                false
            }
        }
        node_one = if child_is_first {
            ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, second_operator_start, second_operator_end),
                precedence: second_precedence,
                associativity: second_associativity,
                left_start: operand_one_start,
                left_end: operand_one_end,
                operator_start: second_operator_start,
                operator_end: second_operator_end,
                right_start: operand_two_start,
                right_end: operand_two_end,
                depth: 0usize,
            }
        } else {
            ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, third_operator_start, third_operator_end),
                precedence: third_precedence,
                associativity: third_associativity,
                left_start: operand_two_start,
                left_end: operand_two_end,
                operator_start: third_operator_start,
                operator_end: third_operator_end,
                right_start: operand_three_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
        }
        node_two = if child_is_first {
            ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, third_operator_start, third_operator_end),
                precedence: third_precedence,
                associativity: third_associativity,
                left_start: operand_one_start,
                left_end: operand_two_end,
                operator_start: third_operator_start,
                operator_end: third_operator_end,
                right_start: operand_three_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
        } else {
            ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, second_operator_start, second_operator_end),
                precedence: second_precedence,
                associativity: second_associativity,
                left_start: operand_one_start,
                left_end: operand_one_end,
                operator_start: second_operator_start,
                operator_end: second_operator_end,
                right_start: operand_two_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
        }
        node_three = ExpressionPrecedenceHeader {
            kind: operator_kind(bytes, first_operator_start, first_operator_end),
            precedence: first_precedence,
            associativity: first_associativity,
            left_start: operand_zero_start,
            left_end: operand_zero_end,
            operator_start: first_operator_start,
            operator_end: first_operator_end,
            right_start: operand_one_start,
            right_end: operand_three_end,
            depth: 0usize,
        }
    } else {
        if root_index == 1u8 {
            node_one = ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, first_operator_start, first_operator_end),
                precedence: first_precedence,
                associativity: first_associativity,
                left_start: operand_zero_start,
                left_end: operand_zero_end,
                operator_start: first_operator_start,
                operator_end: first_operator_end,
                right_start: operand_one_start,
                right_end: operand_one_end,
                depth: 0usize,
            }
            node_two = ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, third_operator_start, third_operator_end),
                precedence: third_precedence,
                associativity: third_associativity,
                left_start: operand_two_start,
                left_end: operand_two_end,
                operator_start: third_operator_start,
                operator_end: third_operator_end,
                right_start: operand_three_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
            node_three = ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, second_operator_start, second_operator_end),
                precedence: second_precedence,
                associativity: second_associativity,
                left_start: operand_zero_start,
                left_end: operand_one_end,
                operator_start: second_operator_start,
                operator_end: second_operator_end,
                right_start: operand_two_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
        } else {
            let child_is_first: Bool = if first_precedence > second_precedence {
                true
            } else {
                if first_precedence == second_precedence {
                    first_associativity == 1u8
                } else {
                    false
                }
            }
            node_one = if child_is_first {
                ExpressionPrecedenceHeader {
                    kind: operator_kind(bytes, first_operator_start, first_operator_end),
                    precedence: first_precedence,
                    associativity: first_associativity,
                    left_start: operand_zero_start,
                    left_end: operand_zero_end,
                    operator_start: first_operator_start,
                    operator_end: first_operator_end,
                    right_start: operand_one_start,
                    right_end: operand_one_end,
                    depth: 0usize,
                }
            } else {
                ExpressionPrecedenceHeader {
                    kind: operator_kind(bytes, second_operator_start, second_operator_end),
                    precedence: second_precedence,
                    associativity: second_associativity,
                    left_start: operand_one_start,
                    left_end: operand_one_end,
                    operator_start: second_operator_start,
                    operator_end: second_operator_end,
                    right_start: operand_two_start,
                    right_end: operand_two_end,
                    depth: 0usize,
                }
            }
            node_two = if child_is_first {
                ExpressionPrecedenceHeader {
                    kind: operator_kind(bytes, second_operator_start, second_operator_end),
                    precedence: second_precedence,
                    associativity: second_associativity,
                    left_start: operand_zero_start,
                    left_end: operand_one_end,
                    operator_start: second_operator_start,
                    operator_end: second_operator_end,
                    right_start: operand_two_start,
                    right_end: operand_two_end,
                    depth: 0usize,
                }
            } else {
                ExpressionPrecedenceHeader {
                    kind: operator_kind(bytes, first_operator_start, first_operator_end),
                    precedence: first_precedence,
                    associativity: first_associativity,
                    left_start: operand_zero_start,
                    left_end: operand_one_end,
                    operator_start: first_operator_start,
                    operator_end: first_operator_end,
                    right_start: operand_one_start,
                    right_end: operand_two_end,
                    depth: 0usize,
                }
            }
            node_three = ExpressionPrecedenceHeader {
                kind: operator_kind(bytes, third_operator_start, third_operator_end),
                precedence: third_precedence,
                associativity: third_associativity,
                left_start: operand_zero_start,
                left_end: operand_two_end,
                operator_start: third_operator_start,
                operator_end: third_operator_end,
                right_start: operand_three_start,
                right_end: operand_three_end,
                depth: 0usize,
            }
        }
    }
    var output_capacity: UIntSize = 0usize
    for slot in output.indices {
        output_capacity = output_capacity + 1usize
    }
    if output_capacity > 0usize {
        output[0] = node_one
    }
    if output_capacity > 1usize {
        output[1] = node_two
    }
    if output_capacity > 2usize {
        output[2] = node_three
    }
    if output_capacity < 3usize {
        return output_capacity
    }
    return 3usize
}

/// Emits exactly four binary nodes in post-order for a bounded
/// five-operand/four-operator expression. The fixed-size shunting-yard
/// stacks keep this self-hosted route allocation-free while preserving the
/// parser's precedence and associativity table.
@export(name: "jadren_selfhost_parse_expression_precedence_long_chain_headers", abi: "C")
@noalloc
pub fn parse_expression_precedence_long_chain_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPrecedenceHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var delimiter_stack_count: UIntSize = 0usize
    var expecting_operand: Bool = true
    var operator_count: UIntSize = 0usize
    var operator_starts: [UIntSize; 4] = [0usize, 0usize, 0usize, 0usize]
    var operator_ends: [UIntSize; 4] = [0usize, 0usize, 0usize, 0usize]
    var operator_precedences: [UInt8; 4] = [0u8, 0u8, 0u8, 0u8]
    var operator_associativities: [UInt8; 4] = [0u8, 0u8, 0u8, 0u8]
    while source_index < end {
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            source_index = end
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[token_start]
        }
        if symbol == 0x29u8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x28u8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x5Du8 {
            if delimiter_stack_count == 0usize {
                return 0usize
            }
            let top_delimiter: UIntSize = delimiter_stack_count - 1usize
            if delimiter_stack[top_delimiter] != 0x5Bu8 {
                return 0usize
            }
            delimiter_stack_count = top_delimiter
            expecting_operand = false
            source_index = next_source
            continue
        }
        if symbol == 0x28u8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if symbol == 0x5Bu8 {
            if delimiter_stack_count >= 32usize {
                return 0usize
            }
            delimiter_stack[delimiter_stack_count] = symbol
            delimiter_stack_count = delimiter_stack_count + 1usize
            expecting_operand = true
            source_index = next_source
            continue
        }
        if delimiter_stack_count == 0usize {
            if info.kind == 3u8 {
                let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                let precedence: UInt8 = expression_operator_precedence(
                    bytes,
                    token_start,
                    operator_end,
                )
                if precedence != 0u8 {
                    if expecting_operand {
                        if is_unary_prefix_operator(bytes, token_start, operator_end) {
                            source_index = operator_end
                            continue
                        }
                    }
                    if operator_count >= 4usize {
                        return 0usize
                    }
                    operator_starts[operator_count] = token_start
                    operator_ends[operator_count] = operator_end
                    operator_precedences[operator_count] = precedence
                    operator_associativities[operator_count] =
                        expression_operator_associativity(precedence)
                    operator_count = operator_count + 1usize
                    expecting_operand = true
                    source_index = operator_end
                    continue
                }
            }
        }
        expecting_operand = false
        source_index = next_source
    }
    if delimiter_stack_count != 0usize {
        return 0usize
    }
    if operator_count != 4usize {
        return 0usize
    }

    var operand_starts: [UIntSize; 5] = [0usize, 0usize, 0usize, 0usize, 0usize]
    var operand_ends: [UIntSize; 5] = [0usize, 0usize, 0usize, 0usize, 0usize]
    operand_starts[0] = bounded_expression_start(bytes, start, operator_starts[0])
    operand_ends[0] = bounded_expression_end(bytes, start, operator_starts[0])
    operand_starts[1] = bounded_expression_start(bytes, operator_ends[0], operator_starts[1])
    operand_ends[1] = bounded_expression_end(bytes, operator_ends[0], operator_starts[1])
    operand_starts[2] = bounded_expression_start(bytes, operator_ends[1], operator_starts[2])
    operand_ends[2] = bounded_expression_end(bytes, operator_ends[1], operator_starts[2])
    operand_starts[3] = bounded_expression_start(bytes, operator_ends[2], operator_starts[3])
    operand_ends[3] = bounded_expression_end(bytes, operator_ends[2], operator_starts[3])
    operand_starts[4] = bounded_expression_start(bytes, operator_ends[3], end)
    operand_ends[4] = bounded_expression_end(bytes, operator_ends[3], end)
    if operand_starts[0] >= operand_ends[0] {
        return 0usize
    }
    if operand_starts[1] >= operand_ends[1] {
        return 0usize
    }
    if operand_starts[2] >= operand_ends[2] {
        return 0usize
    }
    if operand_starts[3] >= operand_ends[3] {
        return 0usize
    }
    if operand_starts[4] >= operand_ends[4] {
        return 0usize
    }

    var operator_stack: [UIntSize; 4] = [0usize, 0usize, 0usize, 0usize]
    var operator_stack_count: UIntSize = 0usize
    var value_starts: [UIntSize; 5] = [0usize, 0usize, 0usize, 0usize, 0usize]
    var value_ends: [UIntSize; 5] = [0usize, 0usize, 0usize, 0usize, 0usize]
    var value_count: UIntSize = 1usize
    value_starts[0] = operand_starts[0]
    value_ends[0] = operand_ends[0]
    var output_capacity: UIntSize = 0usize
    for slot in output.indices {
        output_capacity = output_capacity + 1usize
    }
    var node_count: UIntSize = 0usize
    var operator_index: UIntSize = 0usize
    while operator_index < 4usize {
        let current_precedence: UInt8 = operator_precedences[operator_index]
        let current_associativity: UInt8 = operator_associativities[operator_index]
        while operator_stack_count > 0usize {
            let top_stack_index: UIntSize = operator_stack_count - 1usize
            let top_operator_index: UIntSize = operator_stack[top_stack_index]
            let top_precedence: UInt8 = operator_precedences[top_operator_index]
            var reduce_top: Bool = top_precedence > current_precedence
            if top_precedence == current_precedence {
                reduce_top = current_associativity == 1u8
            }
            if !reduce_top {
                break
            }
            if value_count < 2usize {
                return 0usize
            }
            let right_value_index: UIntSize = value_count - 1usize
            let left_value_index: UIntSize = value_count - 2usize
            if node_count < output_capacity {
                output[node_count] = ExpressionPrecedenceHeader {
                    kind: operator_kind(
                        bytes,
                        operator_starts[top_operator_index],
                        operator_ends[top_operator_index],
                    ),
                    precedence: top_precedence,
                    associativity: operator_associativities[top_operator_index],
                    left_start: value_starts[left_value_index],
                    left_end: value_ends[left_value_index],
                    operator_start: operator_starts[top_operator_index],
                    operator_end: operator_ends[top_operator_index],
                    right_start: value_starts[right_value_index],
                    right_end: value_ends[right_value_index],
                    depth: 0usize,
                }
            }
            node_count = node_count + 1usize
            value_ends[left_value_index] = value_ends[right_value_index]
            value_count = value_count - 1usize
            operator_stack_count = operator_stack_count - 1usize
        }
        operator_stack[operator_stack_count] = operator_index
        operator_stack_count = operator_stack_count + 1usize
        value_starts[value_count] = operand_starts[operator_index + 1usize]
        value_ends[value_count] = operand_ends[operator_index + 1usize]
        value_count = value_count + 1usize
        operator_index = operator_index + 1usize
    }
    while operator_stack_count > 0usize {
        if value_count < 2usize {
            return 0usize
        }
        let top_stack_index: UIntSize = operator_stack_count - 1usize
        let top_operator_index: UIntSize = operator_stack[top_stack_index]
        let right_value_index: UIntSize = value_count - 1usize
        let left_value_index: UIntSize = value_count - 2usize
        if node_count < output_capacity {
            output[node_count] = ExpressionPrecedenceHeader {
                kind: operator_kind(
                    bytes,
                    operator_starts[top_operator_index],
                    operator_ends[top_operator_index],
                ),
                precedence: operator_precedences[top_operator_index],
                associativity: operator_associativities[top_operator_index],
                left_start: value_starts[left_value_index],
                left_end: value_ends[left_value_index],
                operator_start: operator_starts[top_operator_index],
                operator_end: operator_ends[top_operator_index],
                right_start: value_starts[right_value_index],
                right_end: value_ends[right_value_index],
                depth: 0usize,
            }
        }
        node_count = node_count + 1usize
        value_ends[left_value_index] = value_ends[right_value_index]
        value_count = value_count - 1usize
        operator_stack_count = operator_stack_count - 1usize
    }
    if node_count != 4usize {
        return 0usize
    }
    if value_count != 1usize {
        return 0usize
    }
    if node_count < output_capacity {
        return node_count
    }
    return output_capacity
}

/// Recognizes only the boolean identifier spellings used by the literal
/// stage. Other identifier tokens remain names for the AST parser.
@noalloc
fn boolean_literal_kind(
    bytes: read Slice<UInt8>,
    token_kind: UInt8,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    if token_kind != 1u8 {
        return 0u8
    }
    let width: UIntSize = end - start
    if width == 4usize {
        if bytes[start] == 0x74u8 {
            if bytes[start + 1usize] == 0x72u8 {
                if bytes[start + 2usize] == 0x75u8 {
                    if bytes[start + 3usize] == 0x65u8 {
                        return 1u8
                    }
                }
            }
        }
    }
    if width == 5usize {
        if bytes[start] == 0x66u8 {
            if bytes[start + 1usize] == 0x61u8 {
                if bytes[start + 2usize] == 0x6Cu8 {
                    if bytes[start + 3usize] == 0x73u8 {
                        if bytes[start + 4usize] == 0x65u8 {
                            return 1u8
                        }
                    }
                }
            }
        }
    }
    return 0u8
}

/// Returns a builtin type kind only when the bounded range contains one
/// literal token (optionally surrounded by whitespace). This helper is used
/// by the deliberately narrow binary typed-semantics hand-off; it does not
/// parse names, casts, unary operators, or user-defined literals.
@noalloc
fn bounded_literal_type_kind(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let info: TokenInfo = scan_token_info(bytes, start, end)
    if info.start >= end {
        return 0u8
    }
    let token_start: UIntSize = info.start
    let next_source: UIntSize = info.end
    let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
    if bool_kind != 0u8 {
        let trailing: TokenInfo = scan_token_info(bytes, next_source, end)
        if trailing.start >= end {
            return 1u8
        }
        return 0u8
    }
    if info.kind == 2u8 {
        var literal_type: UInt8 = 2u8
        var literal_end: UIntSize = next_source
        if next_source < end {
            if bytes[next_source] == 0x2Eu8 {
                if next_source + 1usize < end {
                    if bytes[next_source + 1usize] != 0x2Eu8 {
                        let fraction_info: TokenInfo = scan_token_info(
                            bytes,
                            next_source + 1usize,
                            end,
                        )
                        if fraction_info.kind == 2u8 {
                            if fraction_info.start == next_source + 1usize {
                                literal_type = 3u8
                                literal_end = fraction_info.end
                            }
                        }
                    }
                }
            }
        }
        let trailing: TokenInfo = scan_token_info(bytes, literal_end, end)
        if trailing.start >= end {
            return literal_type
        }
        return 0u8
    }
    if info.kind == 3u8 {
        let quote: UInt8 = bytes[token_start]
        if quote == 0x22u8 {
            var cursor: UIntSize = next_source
            var escaped: Bool = false
            var literal_end: UIntSize = end
            while cursor < end {
                let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if quoted_info.start >= end {
                    cursor = end
                    break
                }
                let quoted_symbol: UInt8 = bytes[quoted_info.start]
                if escaped {
                    escaped = false
                } else {
                    if quoted_symbol == 0x5Cu8 {
                        escaped = true
                    } else {
                        if quoted_symbol == quote {
                            literal_end = quoted_info.end
                            break
                        }
                    }
                }
                cursor = quoted_info.end
            }
            let trailing: TokenInfo = scan_token_info(bytes, literal_end, end)
            if trailing.start >= end {
                return 4u8
            }
        }
        if quote == 0x27u8 {
            var cursor: UIntSize = next_source
            var escaped: Bool = false
            var literal_end: UIntSize = end
            while cursor < end {
                let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if quoted_info.start >= end {
                    cursor = end
                    break
                }
                let quoted_symbol: UInt8 = bytes[quoted_info.start]
                if escaped {
                    escaped = false
                } else {
                    if quoted_symbol == 0x5Cu8 {
                        escaped = true
                    } else {
                        if quoted_symbol == quote {
                            literal_end = quoted_info.end
                            break
                        }
                    }
                }
                cursor = quoted_info.end
            }
            let trailing: TokenInfo = scan_token_info(bytes, literal_end, end)
            if trailing.start >= end {
                return 5u8
            }
        }
    }
    return 0u8
}

@noalloc
fn builtin_parameter_type_kind(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let width: UIntSize = end - start
    if width == 4usize {
        if bytes[start] == 0x42u8 {
            if bytes[start + 1usize] == 0x6Fu8 {
                if bytes[start + 2usize] == 0x6Fu8 {
                    if bytes[start + 3usize] == 0x6Cu8 {
                        return 1u8
                    }
                }
            }
        }
        if bytes[start] == 0x43u8 {
            if bytes[start + 1usize] == 0x68u8 {
                if bytes[start + 2usize] == 0x61u8 {
                    if bytes[start + 3usize] == 0x72u8 {
                        return 5u8
                    }
                }
            }
        }
    }
    if width == 5usize {
        if bytes[start] == 0x46u8 {
            if bytes[start + 1usize] == 0x6Cu8 {
                if bytes[start + 2usize] == 0x6Fu8 {
                    if bytes[start + 3usize] == 0x61u8 {
                        if bytes[start + 4usize] == 0x74u8 {
                            return 3u8
                        }
                    }
                }
            }
        }
    }
    if width == 6usize {
        if bytes[start] == 0x53u8 {
            if bytes[start + 1usize] == 0x74u8 {
                if bytes[start + 2usize] == 0x72u8 {
                    if bytes[start + 3usize] == 0x69u8 {
                        if bytes[start + 4usize] == 0x6Eu8 {
                            if bytes[start + 5usize] == 0x67u8 {
                                return 4u8
                            }
                        }
                    }
                }
            }
        }
    }
    if width == 7usize {
        if bytes[start] == 0x49u8 {
            if bytes[start + 1usize] == 0x6Eu8 {
                if bytes[start + 2usize] == 0x74u8 {
                    if bytes[start + 3usize] == 0x65u8 {
                        if bytes[start + 4usize] == 0x67u8 {
                            if bytes[start + 5usize] == 0x65u8 {
                                if bytes[start + 6usize] == 0x72u8 {
                                    return 2u8
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0u8
}

@noalloc
fn bounded_parameter_type_count(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    if start >= end {
        return 0usize
    }
    var cursor: UIntSize = start
    var type_count: UIntSize = 0usize
    var expecting_type: Bool = true
    var wrapped: Bool = false
    var closed: Bool = false
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if !wrapped {
            if type_count == 0usize {
                if symbol == 0x5Bu8 {
                    wrapped = true
                    cursor = info.end
                    continue
                }
            }
        }
        if wrapped {
            if symbol == 0x5Du8 {
                if expecting_type {
                    return 0usize
                }
                closed = true
                cursor = info.end
                break
            }
        }
        if info.kind == 1u8 {
            if !expecting_type {
                return 0usize
            }
            if builtin_parameter_type_kind(bytes, info.start, info.end) == 0u8 {
                return 0usize
            }
            type_count = type_count + 1usize
            expecting_type = false
        } else {
            if symbol == 0x2Cu8 {
                if expecting_type {
                    return 0usize
                }
                expecting_type = true
            } else {
                return 0usize
            }
        }
        cursor = info.end
    }
    if wrapped {
        if !closed {
            return 0usize
        }
        let trailing: TokenInfo = scan_token_info(bytes, cursor, end)
        if trailing.start < end {
            return 0usize
        }
    }
    if expecting_type {
        return 0usize
    }
    return type_count
}

@noalloc
fn bounded_parameter_type_kind_at(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    wanted_index: UIntSize,
) -> UInt8 {
    if start >= end {
        return 0u8
    }
    var cursor: UIntSize = start
    var type_index: UIntSize = 0usize
    var selected_type: UInt8 = 0u8
    var expecting_type: Bool = true
    var wrapped: Bool = false
    var closed: Bool = false
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if !wrapped {
            if type_index == 0usize {
                if symbol == 0x5Bu8 {
                    wrapped = true
                    cursor = info.end
                    continue
                }
            }
        }
        if wrapped {
            if symbol == 0x5Du8 {
                if expecting_type {
                    return 0u8
                }
                closed = true
                cursor = info.end
                break
            }
        }
        if info.kind == 1u8 {
            if !expecting_type {
                return 0u8
            }
            let type_kind: UInt8 = builtin_parameter_type_kind(bytes, info.start, info.end)
            if type_kind == 0u8 {
                return 0u8
            }
            if type_index == wanted_index {
                selected_type = type_kind
            }
            type_index = type_index + 1usize
            expecting_type = false
        } else {
            if symbol == 0x2Cu8 {
                if expecting_type {
                    return 0u8
                }
                expecting_type = true
            } else {
                return 0u8
            }
        }
        cursor = info.end
    }
    if wrapped {
        if !closed {
            return 0u8
        }
        let trailing: TokenInfo = scan_token_info(bytes, cursor, end)
        if trailing.start < end {
            return 0u8
        }
    }
    if expecting_type {
        return 0u8
    }
    return selected_type
}

@noalloc
fn bounded_argument_type_count(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    if start >= end {
        return 0usize
    }
    var cursor: UIntSize = start
    var depth: UIntSize = 0usize
    var argument_count: UIntSize = 0usize
    var has_token: Bool = false
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if symbol == 0x28u8 {
            depth = depth + 1usize
            has_token = true
        } else {
            if symbol == 0x5Bu8 {
                depth = depth + 1usize
                has_token = true
            } else {
                if symbol == 0x29u8 {
                    if depth > 0usize {
                        depth = depth - 1usize
                    }
                    has_token = true
                } else {
                    if symbol == 0x5Du8 {
                        if depth > 0usize {
                            depth = depth - 1usize
                        }
                        has_token = true
                    } else {
                        if symbol == 0x2Cu8 {
                            if depth == 0usize {
                                if has_token {
                                    argument_count = argument_count + 1usize
                                    has_token = false
                                }
                            } else {
                                if info.kind != 0u8 {
                                    has_token = true
                                }
                            }
                        } else {
                            if info.kind != 0u8 {
                                has_token = true
                            }
                        }
                    }
                }
            }
        }
        cursor = info.end
    }
    if has_token {
        argument_count = argument_count + 1usize
    }
    return argument_count
}

@noalloc
fn bounded_argument_type_kind_at(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    wanted_index: UIntSize,
) -> UInt8 {
    if start >= end {
        return 0u8
    }
    var cursor: UIntSize = start
    var argument_start: UIntSize = start
    var depth: UIntSize = 0usize
    var argument_index: UIntSize = 0usize
    var has_token: Bool = false
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if symbol == 0x28u8 {
            depth = depth + 1usize
            has_token = true
        } else {
            if symbol == 0x5Bu8 {
                depth = depth + 1usize
                has_token = true
            } else {
                if symbol == 0x29u8 {
                    if depth > 0usize {
                        depth = depth - 1usize
                    }
                    has_token = true
                } else {
                    if symbol == 0x5Du8 {
                        if depth > 0usize {
                            depth = depth - 1usize
                        }
                        has_token = true
                    } else {
                        if symbol == 0x2Cu8 {
                            if depth == 0usize {
                                if has_token {
                                    if argument_index == wanted_index {
                                        return bounded_literal_type_kind(bytes, argument_start, info.start)
                                    }
                                    argument_index = argument_index + 1usize
                                    has_token = false
                                }
                                argument_start = info.end
                            } else {
                                if info.kind != 0u8 {
                                    has_token = true
                                }
                            }
                        } else {
                            if info.kind != 0u8 {
                                has_token = true
                            }
                        }
                    }
                }
            }
        }
        cursor = info.end
    }
    if has_token {
        if argument_index == wanted_index {
            return bounded_literal_type_kind(bytes, argument_start, end)
        }
    }
    return 0u8
}

@noalloc
fn bounded_generic_bound_matches(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    argument_count: UIntSize,
    single_argument_type: UInt8,
    bound_kind: UInt8,
) -> Bool {
    if bound_kind == 0u8 {
        return true
    }
    if bound_kind > 3u8 {
        return false
    }
    if argument_count == 0usize {
        return false
    }
    var argument_index: UIntSize = 0usize
    while argument_index < argument_count {
        var actual_type: UInt8 = single_argument_type
        if argument_count > 1usize {
            actual_type = bounded_argument_type_kind_at(bytes, start, end, argument_index)
        }
        if actual_type == 0u8 {
            return false
        }
        var matches: Bool = false
        if bound_kind == 1u8 {
            if actual_type == 2u8 {
                matches = true
            } else {
                if actual_type == 3u8 {
                    matches = true
                }
            }
        } else {
            if bound_kind == 2u8 {
                if actual_type == 1u8 {
                    matches = true
                }
            } else {
                if actual_type == 4u8 {
                    matches = true
                } else {
                    if actual_type == 5u8 {
                        matches = true
                    }
                }
            }
        }
        if !matches {
            return false
        }
        argument_index = argument_index + 1usize
    }
    return true
}

@noalloc
fn bounded_same_argument_type_matches(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    argument_count: UIntSize,
) -> Bool {
    if argument_count < 2usize {
        return false
    }
    let first_type: UInt8 = bounded_argument_type_kind_at(bytes, start, end, 0usize)
    if first_type == 0u8 {
        return false
    }
    var argument_index: UIntSize = 1usize
    while argument_index < argument_count {
        let actual_type: UInt8 = bounded_argument_type_kind_at(bytes, start, end, argument_index)
        if actual_type == 0u8 {
            return false
        }
        if actual_type != first_type {
            return false
        }
        argument_index = argument_index + 1usize
    }
    return true
}

@noalloc
fn bounded_all_argument_types_known(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    argument_count: UIntSize,
) -> Bool {
    if argument_count < 2usize {
        return false
    }
    var argument_index: UIntSize = 0usize
    while argument_index < argument_count {
        if bounded_argument_type_kind_at(bytes, start, end, argument_index) == 0u8 {
            return false
        }
        argument_index = argument_index + 1usize
    }
    return true
}

/// Returns the builtin type inside one or more nested parenthesized literal
/// groups. The helper accepts only `((literal))`-shaped ranges (with optional
/// whitespace); names, casts and trailing operators remain outside this
/// bootstrap hand-off.
@noalloc
fn bounded_grouped_literal_type_kind(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let open_info: TokenInfo = scan_token_info(bytes, start, end)
    if open_info.start >= end {
        return 0u8
    }
    if bytes[open_info.start] != 0x28u8 {
        return 0u8
    }
    var group_depth: UIntSize = 1usize
    var literal_start: UIntSize = open_info.end
    var cursor: UIntSize = literal_start
    while true {
        let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if nested_info.start >= end {
            return 0u8
        }
        if bytes[nested_info.start] == 0x28u8 {
            group_depth = group_depth + 1usize
            cursor = nested_info.end
        } else {
            literal_start = nested_info.start
            cursor = literal_start
            break
        }
    }
    var literal_end: UIntSize = 0usize
    var literal_type: UInt8 = 0u8
    while cursor < end {
        let candidate_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if candidate_info.start >= end {
            return 0u8
        }
        if bytes[candidate_info.start] == 0x29u8 {
            return 0u8
        }
        let candidate_type: UInt8 = bounded_literal_type_kind(
            bytes,
            literal_start,
            candidate_info.end,
        )
        if candidate_type != 0u8 {
            literal_end = candidate_info.end
            literal_type = candidate_type
            break
        }
        cursor = candidate_info.end
    }
    if literal_end == 0usize {
        return 0u8
    }
    var close_cursor: UIntSize = literal_end
    var remaining: UIntSize = group_depth
    while remaining > 0usize {
        let close_info: TokenInfo = scan_token_info(bytes, close_cursor, end)
        if close_info.start >= end {
            return 0u8
        }
        if bytes[close_info.start] != 0x29u8 {
            return 0u8
        }
        close_cursor = close_info.end
        remaining = remaining - 1usize
    }
    let trailing: TokenInfo = scan_token_info(bytes, close_cursor, end)
    if trailing.start >= end {
        return literal_type
    }
    return 0u8
}

/// Returns the end offset of one or more nested parenthesized builtin literal
/// groups, or zero when the bounded range is not such a group.
@noalloc
fn bounded_grouped_literal_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let open_info: TokenInfo = scan_token_info(bytes, start, end)
    if open_info.start >= end {
        return 0usize
    }
    if bytes[open_info.start] != 0x28u8 {
        return 0usize
    }
    var group_depth: UIntSize = 1usize
    var literal_start: UIntSize = open_info.end
    var cursor: UIntSize = literal_start
    while true {
        let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if nested_info.start >= end {
            return 0usize
        }
        if bytes[nested_info.start] == 0x28u8 {
            group_depth = group_depth + 1usize
            cursor = nested_info.end
        } else {
            literal_start = nested_info.start
            cursor = literal_start
            break
        }
    }
    var literal_end: UIntSize = 0usize
    while cursor < end {
        let candidate_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if candidate_info.start >= end {
            return 0usize
        }
        if bytes[candidate_info.start] == 0x29u8 {
            return 0usize
        }
        let candidate_type: UInt8 = bounded_literal_type_kind(bytes, literal_start, candidate_info.end)
        if candidate_type != 0u8 {
            literal_end = candidate_info.end
            break
        }
        cursor = candidate_info.end
    }
    if literal_end == 0usize {
        return 0usize
    }
    var close_cursor: UIntSize = literal_end
    var remaining: UIntSize = group_depth
    while remaining > 0usize {
        let close_info: TokenInfo = scan_token_info(bytes, close_cursor, end)
        if close_info.start >= end {
            return 0usize
        }
        if bytes[close_info.start] != 0x29u8 {
            return 0usize
        }
        close_cursor = close_info.end
        remaining = remaining - 1usize
    }
    let trailing: TokenInfo = scan_token_info(bytes, close_cursor, end)
    if trailing.start >= end {
        return close_cursor
    }
    return 0usize
}

@noalloc
fn bounded_numeric_literal_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let info: TokenInfo = scan_token_info(bytes, start, end)
    var literal_end: UIntSize = info.end
    if info.kind == 2u8 {
        if info.end < end {
            if bytes[info.end] == 0x2Eu8 {
                if info.end + 1usize < end {
                    if bytes[info.end + 1usize] != 0x2Eu8 {
                        let fraction_info: TokenInfo = scan_token_info(
                            bytes,
                            info.end + 1usize,
                            end,
                        )
                        if fraction_info.kind == 2u8 {
                            if fraction_info.start == info.end + 1usize {
                                literal_end = fraction_info.end
                            }
                        }
                    }
                }
            }
        }
    }
    return literal_end
}

@noalloc
fn is_numeric_literal_type(value: UInt8) -> Bool {
    if value == 2u8 {
        return true
    }
    if value == 3u8 {
        return true
    }
    return false
}

@noalloc
fn is_supported_typed_binary_kind(value: UInt8) -> Bool {
    if value == 2u8 {
        return true
    }
    if value == 3u8 {
        return true
    }
    if value == 4u8 {
        return true
    }
    return false
}

@noalloc
fn is_unary_operator(value: UInt8) -> Bool {
    if value == 0x2Bu8 {
        return true
    }
    if value == 0x2Du8 {
        return true
    }
    if value == 0x21u8 {
        return true
    }
    if value == 0x7Eu8 {
        return true
    }
    return false
}

@noalloc
fn is_boolean_binary_operator(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Bool {
    if end - start == 2usize {
        if bytes[start] == 0x26u8 {
            if bytes[start + 1usize] == 0x26u8 {
                return true
            }
        }
        if bytes[start] == 0x7Cu8 {
            if bytes[start + 1usize] == 0x7Cu8 {
                return true
            }
        }
    }
    return false
}

/// Returns the builtin numeric type selected by a bounded cast target name.
/// Only the scalar targets used by the bootstrap corpus are accepted here;
/// resolver/type aliases remain outside this narrow hand-off.
@noalloc
fn bounded_numeric_cast_target_type_kind(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let info: TokenInfo = scan_token_info(bytes, start, end)
    if info.kind != 1u8 {
        return 0u8
    }
    let width: UIntSize = info.end - info.start
    var target_kind: UInt8 = 0u8
    if width == 5usize {
        if bytes[info.start] == 0x49u8 {
            if bytes[info.start + 1usize] == 0x6Eu8 {
                if bytes[info.start + 2usize] == 0x74u8 {
                    if bytes[info.start + 3usize] == 0x33u8 {
                        if bytes[info.start + 4usize] == 0x32u8 {
                            target_kind = 2u8
                        }
                    }
                    if bytes[info.start + 3usize] == 0x36u8 {
                        if bytes[info.start + 4usize] == 0x34u8 {
                            target_kind = 2u8
                        }
                    }
                }
            }
        }
    }
    if width == 7usize {
        if bytes[info.start] == 0x46u8 {
            if bytes[info.start + 1usize] == 0x6Cu8 {
                if bytes[info.start + 2usize] == 0x6Fu8 {
                    if bytes[info.start + 3usize] == 0x61u8 {
                        if bytes[info.start + 4usize] == 0x74u8 {
                            if bytes[info.start + 5usize] == 0x33u8 {
                                if bytes[info.start + 6usize] == 0x32u8 {
                                    target_kind = 3u8
                                }
                            }
                            if bytes[info.start + 5usize] == 0x36u8 {
                                if bytes[info.start + 6usize] == 0x34u8 {
                                    target_kind = 3u8
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if target_kind == 0u8 {
        return 0u8
    }
    return target_kind
}

/// Recognizes a bounded explicit numeric cast over a builtin literal, one or
/// more parenthesized groups and an optional chain of numeric cast targets.
@noalloc
fn infer_cast_literal_header(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TypedExpressionHeader {
    let first_info: TokenInfo = scan_token_info(bytes, start, end)
    if first_info.start >= end {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    var cursor: UIntSize = first_info.end
    var depth: UIntSize = 0usize
    var literal_start: UIntSize = first_info.start
    if first_info.kind == 2u8 {
        cursor = bounded_numeric_literal_end(bytes, literal_start, end)
    } else if first_info.kind == 3u8 {
        if bytes[first_info.start] != 0x28u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        depth = 1usize
        var opening: Bool = true
        while opening {
            let open_info: TokenInfo = scan_token_info(bytes, cursor, end)
            if open_info.kind == 3u8 {
                if open_info.start < end {
                    if bytes[open_info.start] == 0x28u8 {
                        depth = depth + 1usize
                        if depth > 32usize {
                            return TypedExpressionHeader {
                                expression_kind: 0u8,
                                type_kind: 0u8,
                                start: 0usize,
                                end: 0usize,
                                depth: 0usize,
                            }
                        }
                        cursor = open_info.end
                    } else {
                        opening = false
                    }
                } else {
                    opening = false
                }
            } else {
                opening = false
            }
        }
        let literal_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if literal_info.kind != 2u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        literal_start = literal_info.start
        cursor = bounded_numeric_literal_end(bytes, literal_start, end)
    } else {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if cursor <= literal_start {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if depth > 0usize {
        let inner_as: TokenInfo = scan_token_info(bytes, cursor, end)
        if inner_as.kind == 1u8 {
            if inner_as.end - inner_as.start == 2usize {
                if bytes[inner_as.start] == 0x61u8 {
                    if bytes[inner_as.start + 1usize] == 0x73u8 {
                        let inner_target: TokenInfo = scan_token_info(bytes, inner_as.end, end)
                        let inner_kind: UInt8 = bounded_numeric_cast_target_type_kind(bytes, inner_as.end, end)
                        if inner_target.kind != 1u8 {
                            return TypedExpressionHeader {
                                expression_kind: 0u8,
                                type_kind: 0u8,
                                start: 0usize,
                                end: 0usize,
                                depth: 0usize,
                            }
                        }
                        if inner_kind == 0u8 {
                            return TypedExpressionHeader {
                                expression_kind: 0u8,
                                type_kind: 0u8,
                                start: 0usize,
                                end: 0usize,
                                depth: 0usize,
                            }
                        }
                        cursor = inner_target.end
                        var inner_closed: UIntSize = 0usize
                        while inner_closed < depth {
                            let close_info: TokenInfo = scan_token_info(bytes, cursor, end)
                            if close_info.kind != 3u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if close_info.start >= end {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if bytes[close_info.start] != 0x29u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            cursor = close_info.end
                            inner_closed = inner_closed + 1usize
                        }
                        var nested_kind: UInt8 = inner_kind
                        var nested_end: UIntSize = cursor
                        var nested_hops: UIntSize = 1usize
                        var nested_parsing: Bool = true
                        while nested_parsing {
                            let outer_as: TokenInfo = scan_token_info(bytes, cursor, end)
                            if outer_as.kind != 1u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if outer_as.end - outer_as.start != 2usize {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if bytes[outer_as.start] != 0x61u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if bytes[outer_as.start + 1usize] != 0x73u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            let outer_target: TokenInfo = scan_token_info(bytes, outer_as.end, end)
                            let outer_kind: UInt8 = bounded_numeric_cast_target_type_kind(bytes, outer_as.end, end)
                            if outer_target.kind != 1u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            if outer_kind == 0u8 {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            nested_kind = outer_kind
                            nested_end = outer_target.end
                            nested_hops = nested_hops + 1usize
                            if nested_hops > 4usize {
                                return TypedExpressionHeader {
                                    expression_kind: 0u8,
                                    type_kind: 0u8,
                                    start: 0usize,
                                    end: 0usize,
                                    depth: 0usize,
                                }
                            }
                            let trailing: TokenInfo = scan_token_info(bytes, nested_end, end)
                            if trailing.start >= end {
                                nested_parsing = false
                            } else {
                                if trailing.kind != 1u8 {
                                    return TypedExpressionHeader {
                                        expression_kind: 0u8,
                                        type_kind: 0u8,
                                        start: 0usize,
                                        end: 0usize,
                                        depth: 0usize,
                                    }
                                }
                                if trailing.end - trailing.start != 2usize {
                                    return TypedExpressionHeader {
                                        expression_kind: 0u8,
                                        type_kind: 0u8,
                                        start: 0usize,
                                        end: 0usize,
                                        depth: 0usize,
                                    }
                                }
                                if bytes[trailing.start] != 0x61u8 {
                                    return TypedExpressionHeader {
                                        expression_kind: 0u8,
                                        type_kind: 0u8,
                                        start: 0usize,
                                        end: 0usize,
                                        depth: 0usize,
                                    }
                                }
                                if bytes[trailing.start + 1usize] != 0x73u8 {
                                    return TypedExpressionHeader {
                                        expression_kind: 0u8,
                                        type_kind: 0u8,
                                        start: 0usize,
                                        end: 0usize,
                                        depth: 0usize,
                                    }
                                }
                                cursor = nested_end
                            }
                        }
                        return TypedExpressionHeader {
                            expression_kind: 4u8,
                            type_kind: nested_kind,
                            start: first_info.start,
                            end: nested_end,
                            depth: depth,
                        }
                    }
                }
            }
        }
    }
    var closed: UIntSize = 0usize
    while closed < depth {
        let close_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if close_info.kind != 3u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        if close_info.start >= end {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        if bytes[close_info.start] != 0x29u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        cursor = close_info.end
        closed = closed + 1usize
    }

    var target_kind: UInt8 = 0u8
    var target_end: UIntSize = cursor
    var cast_count: UIntSize = 0usize
    var parsing: Bool = true
    while parsing {
        cast_count = cast_count + 1usize
        if cast_count > 4usize {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        let as_info: TokenInfo = scan_token_info(bytes, cursor, end)
        if as_info.kind != 1u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        if as_info.end - as_info.start != 2usize {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        if bytes[as_info.start] != 0x61u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        if bytes[as_info.start + 1usize] != 0x73u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        let target_info: TokenInfo = scan_token_info(bytes, as_info.end, end)
        if target_info.kind != 1u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        target_kind = bounded_numeric_cast_target_type_kind(bytes, as_info.end, end)
        if target_kind == 0u8 {
            return TypedExpressionHeader {
                expression_kind: 0u8,
                type_kind: 0u8,
                start: 0usize,
                end: 0usize,
                depth: 0usize,
            }
        }
        target_end = target_info.end
        let trailing: TokenInfo = scan_token_info(bytes, target_end, end)
        if trailing.start >= end {
            parsing = false
        } else {
            if trailing.kind != 1u8 {
                return TypedExpressionHeader {
                    expression_kind: 0u8,
                    type_kind: 0u8,
                    start: 0usize,
                    end: 0usize,
                    depth: 0usize,
                }
            }
            if trailing.end - trailing.start != 2usize {
                return TypedExpressionHeader {
                    expression_kind: 0u8,
                    type_kind: 0u8,
                    start: 0usize,
                    end: 0usize,
                    depth: 0usize,
                }
            }
            if bytes[trailing.start] != 0x61u8 {
                return TypedExpressionHeader {
                    expression_kind: 0u8,
                    type_kind: 0u8,
                    start: 0usize,
                    end: 0usize,
                    depth: 0usize,
                }
            }
            if bytes[trailing.start + 1usize] != 0x73u8 {
                return TypedExpressionHeader {
                    expression_kind: 0u8,
                    type_kind: 0u8,
                    start: 0usize,
                    end: 0usize,
                    depth: 0usize,
                }
            }
            cursor = target_end
        }
    }

    return TypedExpressionHeader {
        expression_kind: 4u8,
        type_kind: target_kind,
        start: first_info.start,
        end: target_end,
        depth: depth,
    }
}

/// Recognizes one bounded two-step chain made from builtin literal operands.
/// Arithmetic operators may mix, and one arithmetic operator may feed a
/// numeric comparison; this keeps the result type aligned with the bounded
/// precedence shape without adding a new ABI record.
@noalloc
fn bounded_binary_operand_type(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    let grouped_type: UInt8 = bounded_grouped_literal_type_kind(bytes, start, end)
    if grouped_type != 0u8 {
        return grouped_type
    }
    return bounded_literal_type_kind(bytes, start, end)
}

@noalloc
fn infer_binary_literal_chain_header(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TypedExpressionHeader {
    var source_index: UIntSize = start
    var delimiter_depth: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var operator_kind_value: UInt8 = 0u8
    var second_operator_kind_value: UInt8 = 0u8
    var first_operator_start: UIntSize = 0usize
    var first_operator_end: UIntSize = 0usize
    var second_operator_start: UIntSize = 0usize
    var second_operator_end: UIntSize = 0usize
    while source_index < end {
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            source_index = end
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[token_start]
        }
        if symbol == 0x29u8 {
            if delimiter_depth > 0usize {
                delimiter_depth = delimiter_depth - 1usize
            }
            source_index = next_source
            continue
        }
        if symbol == 0x5Du8 {
            if delimiter_depth > 0usize {
                delimiter_depth = delimiter_depth - 1usize
            }
            source_index = next_source
            continue
        }
        if symbol == 0x28u8 {
            delimiter_depth = delimiter_depth + 1usize
            source_index = next_source
            continue
        }
        if symbol == 0x5Bu8 {
            delimiter_depth = delimiter_depth + 1usize
            source_index = next_source
            continue
        }
        if delimiter_depth == 0usize {
            if info.kind == 3u8 {
                let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                if is_supported_typed_binary_kind(candidate_kind) {
                    operator_count = operator_count + 1usize
                    if operator_count == 1usize {
                        operator_kind_value = candidate_kind
                        first_operator_start = token_start
                        first_operator_end = operator_end
                    } else {
                        if operator_count == 2usize {
                            second_operator_kind_value = candidate_kind
                            second_operator_start = token_start
                            second_operator_end = operator_end
                        } else {
                            return TypedExpressionHeader {
                                expression_kind: 0u8,
                                type_kind: 0u8,
                                start: 0usize,
                                end: 0usize,
                                depth: 0usize,
                            }
                        }
                    }
                }
                    source_index = operator_end
                    continue
                }
        }
        source_index = next_source
    }
    if delimiter_depth != 0usize {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if operator_count != 2usize {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if operator_kind_value == 0u8 {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let first_type: UInt8 = bounded_binary_operand_type(bytes, start, first_operator_start)
    let middle_type: UInt8 = bounded_binary_operand_type(
        bytes,
        first_operator_end,
        second_operator_start,
    )
    let last_type: UInt8 = bounded_binary_operand_type(bytes, second_operator_end, end)
    var result_type: UInt8 = 0u8
    if operator_kind_value == 2u8 {
        if second_operator_kind_value == 2u8 {
        if is_numeric_literal_type(first_type) {
            if is_numeric_literal_type(middle_type) {
                if is_numeric_literal_type(last_type) {
                    if first_type == 3u8 {
                        result_type = 3u8
                    } else {
                        if middle_type == 3u8 {
                            result_type = 3u8
                        } else {
                            if last_type == 3u8 {
                                result_type = 3u8
                            } else {
                                result_type = 2u8
                            }
                        }
                    }
                }
            }
        }
        }
        if second_operator_kind_value == 3u8 {
            if is_numeric_literal_type(first_type) {
                if is_numeric_literal_type(middle_type) {
                    if is_numeric_literal_type(last_type) {
                        result_type = 1u8
                    }
                }
            }
        }
    }
    if operator_kind_value == 3u8 {
        if second_operator_kind_value == 2u8 {
            if is_numeric_literal_type(first_type) {
                if is_numeric_literal_type(middle_type) {
                    if is_numeric_literal_type(last_type) {
                        result_type = 1u8
                    }
                }
            }
        }
    }
    if operator_kind_value == 4u8 {
        if second_operator_kind_value == 4u8 {
        if first_type == 1u8 {
            if middle_type == 1u8 {
                if last_type == 1u8 {
                    result_type = 1u8
                }
            }
        }
        }
    }
    if result_type == 0u8 {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let left_info: TokenInfo = scan_token_info(bytes, start, first_operator_start)
    let right_grouped_end: UIntSize = bounded_grouped_literal_end(bytes, second_operator_end, end)
    var right_end: UIntSize = right_grouped_end
    if right_end == 0usize {
        if last_type == 3u8 {
            right_end = bounded_numeric_literal_end(bytes, second_operator_end, end)
        } else {
            let right_info: TokenInfo = scan_token_info(bytes, second_operator_end, end)
            right_end = right_info.end
        }
    }
    return TypedExpressionHeader {
        expression_kind: 2u8,
        type_kind: result_type,
        start: left_info.start,
        end: right_end,
        depth: 0usize,
    }
}

/// Classifies the syntax-only pieces needed to build a type AST later.
/// Identifier text is intentionally not resolved; only the capability and
/// function keywords receive dedicated kinds.
@noalloc
fn type_component_kind(
    bytes: read Slice<UInt8>,
    token_kind: UInt8,
    start: UIntSize,
    end: UIntSize,
) -> UInt8 {
    if token_kind == 1u8 {
        let width: UIntSize = end - start
        if width == 2usize {
            if bytes[start] == 0x66u8 {
                if bytes[start + 1usize] == 0x6Eu8 {
                    return 3u8
                }
            }
        }
        if width == 4usize {
            if bytes[start] == 0x72u8 {
                if bytes[start + 1usize] == 0x65u8 {
                    if bytes[start + 2usize] == 0x61u8 {
                        if bytes[start + 3usize] == 0x64u8 {
                            return 2u8
                        }
                    }
                }
            }
        }
        if width == 5usize {
            if bytes[start] == 0x6Fu8 {
                if bytes[start + 1usize] == 0x77u8 {
                    if bytes[start + 2usize] == 0x6Eu8 {
                        if bytes[start + 3usize] == 0x65u8 {
                            if bytes[start + 4usize] == 0x64u8 {
                                return 2u8
                            }
                        }
                    }
                }
            }
        }
        if width == 5usize {
            if bytes[start] == 0x77u8 {
                if bytes[start + 1usize] == 0x72u8 {
                    if bytes[start + 2usize] == 0x69u8 {
                        if bytes[start + 3usize] == 0x74u8 {
                            if bytes[start + 4usize] == 0x65u8 {
                                return 2u8
                            }
                        }
                    }
                }
            }
        }
        return 1u8
    }
    if token_kind != 3u8 {
        return 0u8
    }
    let symbol: UInt8 = bytes[start]
    if symbol == 0x5Bu8 {
        return 4u8
    }
    if symbol == 0x5Du8 {
        return 5u8
    }
    if symbol == 0x28u8 {
        return 6u8
    }
    if symbol == 0x29u8 {
        return 7u8
    }
    if symbol == 0x3Cu8 {
        return 8u8
    }
    if symbol == 0x3Eu8 {
        return 9u8
    }
    if symbol == 0x2Eu8 {
        return 10u8
    }
    if symbol == 0x3Au8 {
        return 10u8
    }
    if symbol == 0x2Cu8 {
        return 11u8
    }
    if symbol == 0x3Bu8 {
        return 12u8
    }
    if symbol == 0x2Bu8 {
        return 13u8
    }
    return 0u8
}

/// Emits bounded top-level declaration headers from a source range. The
/// output includes the declaration keyword and following identifier span;
/// bodies and nested grammar are parsed by later stages.
@export(name: "jadren_selfhost_parse_declarations", abi: "C")
@noalloc
pub fn parse_declarations(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<DeclarationHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        if source_index >= end {
            break
        }
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[token_start]
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
        }
        if brace_depth == 0usize {
            let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
            if kind != 0u8 {
                let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                if name_info.kind == 1u8 {
                    let name_start: UIntSize = name_info.start
                    let name_end: UIntSize = name_info.end
                    output[slot] = DeclarationHeader {
                        kind: kind,
                        keyword_start: token_start,
                        keyword_end: next_source,
                        name_start: name_start,
                        name_end: name_end,
                    }
                    output_index = output_index + 1usize
                    source_index = name_end
                    continue
                }
            }
        }
        source_index = next_source
    }
    return output_index
}

/// Skips a quoted string/character span while preserving bounded escape state.
/// The helper is used only by the flat AST index so braces in literals do not
/// terminate a declaration body prematurely.
@noalloc
fn ast_quoted_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    quote: UInt8,
) -> UIntSize {
    var cursor: UIntSize = start
    var escaped: Bool = false
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            return end
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if escaped {
            escaped = false
        } else {
            if symbol == 0x5Cu8 {
                escaped = true
            } else {
                if symbol == quote {
                    return info.end
                }
            }
        }
        cursor = info.end
    }
    return cursor
}

/// Finds the matching brace for a bounded AST item body. A missing closer is
/// retained as `end`, leaving recovery/diagnostics to the next parser stage.
@noalloc
fn ast_body_end(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    var cursor: UIntSize = start
    var depth: UIntSize = 0usize
    while cursor < end {
        let info: TokenInfo = scan_token_info(bytes, cursor, end)
        if info.start >= end {
            return end
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if info.kind == 3u8 {
            if symbol == 0x22u8 {
                cursor = ast_quoted_end(bytes, info.end, end, symbol)
                continue
            } else {
                if symbol == 0x27u8 {
                    cursor = ast_quoted_end(bytes, info.end, end, symbol)
                    continue
                }
            }
            if symbol == 0x7Bu8 {
                depth = depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if depth > 0usize {
                        depth = depth - 1usize
                    }
                    if depth == 0usize {
                        return info.end
                    }
                }
            }
        }
        cursor = info.end
    }
    return end
}

/// Emits a flat caller-owned AST root table for top-level declarations. The
/// scanner composes declaration keyword/name spans with bounded item/body
/// spans, skips nested bodies, and never allocates. It deliberately does not
/// resolve types, build child nodes, or validate semantics.
@export(name: "jadren_selfhost_parse_ast_items", abi: "C")
@noalloc
pub fn parse_ast_items(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<AstItemHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            if info.kind == 3u8 {
                let symbol: UInt8 = bytes[token_start]
                if symbol == 0x7Bu8 {
                    brace_depth = brace_depth + 1usize
                } else {
                    if symbol == 0x7Du8 {
                        if brace_depth > 0usize {
                            brace_depth = brace_depth - 1usize
                        }
                    }
                }
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind != 0u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    var name_start: UIntSize = end
                    var name_end: UIntSize = end
                    if name_info.kind == 1u8 {
                        name_start = name_info.start
                        name_end = name_info.end
                    }
                    var item_end: UIntSize = next_source
                    var body_start: UIntSize = end
                    var body_end: UIntSize = end
                    if kind == 1u8 {
                        var cursor: UIntSize = next_source
                        while cursor < end {
                            let part: TokenInfo = scan_token_info(bytes, cursor, end)
                            if part.start >= end {
                                cursor = end
                                break
                            }
                            if part.kind == 3u8 {
                                let part_symbol: UInt8 = bytes[part.start]
                                if part_symbol == 0x3Bu8 {
                                    item_end = part.end
                                    cursor = end
                                    break
                                }
                            }
                            cursor = part.end
                        }
                        if item_end == next_source {
                            item_end = end
                        }
                    } else {
                        var cursor: UIntSize = if name_end > name_start {
                            name_end
                        } else {
                            next_source
                        }
                        while cursor < end {
                            let part: TokenInfo = scan_token_info(bytes, cursor, end)
                            if part.start >= end {
                                cursor = end
                                break
                            }
                            if part.kind == 3u8 {
                                let part_symbol: UInt8 = bytes[part.start]
                                if part_symbol == 0x22u8 {
                                    cursor = ast_quoted_end(bytes, part.end, end, part_symbol)
                                    continue
                                } else {
                                    if part_symbol == 0x27u8 {
                                        cursor = ast_quoted_end(bytes, part.end, end, part_symbol)
                                        continue
                                    }
                                }
                                if part_symbol == 0x7Bu8 {
                                    body_start = part.start
                                    body_end = ast_body_end(bytes, part.start, end)
                                    item_end = body_end
                                    break
                                } else {
                                    if part_symbol == 0x3Bu8 {
                                        item_end = part.end
                                        break
                                    }
                                }
                            }
                            cursor = part.end
                        }
                        if item_end == next_source {
                            item_end = end
                        }
                    }
                    var has_body: UInt8 = 0u8
                    if body_start < end {
                        has_body = 1u8
                    }
                    output[slot] = AstItemHeader {
                        kind: kind,
                        has_body: has_body,
                        start: token_start,
                        end: item_end,
                        name_start: name_start,
                        name_end: name_end,
                        body_start: body_start,
                        body_end: body_end,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    if item_end > token_start {
                        source_index = item_end
                    } else {
                        source_index = next_source
                    }
                    break
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded function headers with name, parameter-list count and body
/// span. It only accepts top-level `fn` declarations; nested bodies are
/// skipped by brace tracking and are intentionally left to the full parser.
@export(name: "jadren_selfhost_parse_function_headers", abi: "C")
@noalloc
pub fn parse_function_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<FunctionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        if source_index >= end {
            break
        }
        let info: TokenInfo = scan_token_info(bytes, source_index, end)
        if info.start >= end {
            break
        }
        let token_start: UIntSize = info.start
        let next_source: UIntSize = info.end
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[token_start]
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
        }
        if brace_depth == 0usize {
            let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
            if kind == 3u8 {
                let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                if name_info.kind == 1u8 {
                    let name_start: UIntSize = name_info.start
                    let name_end: UIntSize = name_info.end
                    var cursor: UIntSize = name_end
                    var paren_depth: UIntSize = 0usize
                    var parameter_count: UIntSize = 0usize
                    var parameter_has_token: Bool = false
                    var parameters_done: Bool = false
                    var body_start: UIntSize = end
                    var body_end: UIntSize = end
                    while cursor < end {
                        let part: TokenInfo = scan_token_info(bytes, cursor, end)
                        if part.start >= end {
                            break
                        }
                        let part_start: UIntSize = part.start
                        let part_end: UIntSize = part.end
                        var part_symbol: UInt8 = 0u8
                        if part.kind == 3u8 {
                            part_symbol = bytes[part_start]
                            if part_symbol == 0x28u8 {
                                paren_depth = paren_depth + 1usize
                            } else {
                                if part_symbol == 0x29u8 {
                                    if paren_depth > 0usize {
                                        paren_depth = paren_depth - 1usize
                                        if paren_depth == 0usize {
                                            if parameter_has_token {
                                                parameter_count = parameter_count + 1usize
                                            }
                                            parameters_done = true
                                        }
                                    }
                                } else {
                                    if part_symbol == 0x2Cu8 {
                                        if paren_depth == 1usize {
                                            if parameter_has_token {
                                                parameter_count = parameter_count + 1usize
                                            }
                                            parameter_has_token = false
                                        }
                                    } else {
                                        if paren_depth == 1usize {
                                            parameter_has_token = true
                                        }
                                    }
                                }
                            }
                        } else {
                            if paren_depth == 1usize {
                                parameter_has_token = true
                            }
                        }
                        if part_symbol == 0x7Bu8 {
                            if parameters_done {
                                if paren_depth == 0usize {
                                body_start = part_start
                                var body_depth: UIntSize = 1usize
                                cursor = part_end
                                while cursor < end {
                                    let body_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if body_info.start >= end {
                                        break
                                    }
                                    let body_token_start: UIntSize = body_info.start
                                    let body_next: UIntSize = body_info.end
                                    if body_info.kind == 3u8 {
                                        let body_symbol: UInt8 = bytes[body_token_start]
                                        if body_symbol == 0x7Bu8 {
                                            body_depth = body_depth + 1usize
                                        } else {
                                            if body_symbol == 0x7Du8 {
                                                if body_depth > 0usize {
                                                    body_depth = body_depth - 1usize
                                                }
                                                if body_depth == 0usize {
                                                    body_end = body_next
                                                    break
                                                }
                                            }
                                        }
                                    }
                                    cursor = body_next
                                }
                                break
                                }
                            }
                        }
                        cursor = part_end
                    }
                    if body_start < end {
                        output[slot] = FunctionHeader {
                            name_start: name_start,
                            name_end: name_end,
                            parameter_count: parameter_count,
                            body_start: body_start,
                            body_end: body_end,
                        }
                        output_index = output_index + 1usize
                        if body_end > body_start {
                            source_index = body_end
                        } else {
                            source_index = name_end
                        }
                        continue
                    }
                }
            }
        }
        source_index = next_source
    }
    return output_index
}

/// Emits bounded parameter spans for top-level function declarations. A
/// record carries the owning function name, the complete syntax-level
/// parameter span and its first identifier token. Nested parentheses are
/// skipped while commas at the outer parameter depth delimit records; exact
/// type parsing remains the responsibility of the typed AST stage.
@export(name: "jadren_selfhost_parse_function_parameters", abi: "C")
@noalloc
pub fn parse_function_parameters(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<FunctionParameter>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var in_parameters: Bool = false
    var after_parameters: Bool = false
    var paren_depth: UIntSize = 0usize
    var function_name_start: UIntSize = end
    var function_name_end: UIntSize = end
    var parameter_start: UIntSize = end
    var parameter_end: UIntSize = end
    var parameter_name_start: UIntSize = end
    var parameter_name_end: UIntSize = end
    var parameter_type_start: UIntSize = end
    var parameter_type_end: UIntSize = end
    var parameter_type_started: Bool = false
    var parameter_seen: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_parameters {
                if symbol == 0x28u8 {
                    if paren_depth == 0usize {
                        paren_depth = 1usize
                    } else {
                        if !parameter_seen {
                            parameter_start = token_start
                            parameter_seen = true
                        }
                        parameter_end = next_source
                        if parameter_type_started {
                            if parameter_type_start == end {
                                parameter_type_start = token_start
                            }
                            parameter_type_end = next_source
                        }
                        paren_depth = paren_depth + 1usize
                    }
                } else {
                    if symbol == 0x29u8 {
                        if paren_depth > 1usize {
                            parameter_end = next_source
                            if parameter_type_started {
                                if parameter_type_start == end {
                                    parameter_type_start = token_start
                                }
                                parameter_type_end = next_source
                            }
                            paren_depth = paren_depth - 1usize
                        } else {
                            if paren_depth == 1usize {
                                if parameter_seen {
                                    output[slot] = FunctionParameter {
                                        function_name_start: function_name_start,
                                        function_name_end: function_name_end,
                                        parameter_start: parameter_start,
                                        parameter_end: parameter_end,
                                        name_start: parameter_name_start,
                                        name_end: parameter_name_end,
                                        type_start: parameter_type_start,
                                        type_end: parameter_type_end,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                }
                                parameter_seen = false
                                parameter_start = end
                                parameter_end = end
                                parameter_name_start = end
                                parameter_name_end = end
                                parameter_type_start = end
                                parameter_type_end = end
                                parameter_type_started = false
                                paren_depth = 0usize
                                in_parameters = false
                                after_parameters = true
                            }
                        }
                    } else {
                        if symbol == 0x2Cu8 {
                            if paren_depth == 1usize {
                                if parameter_seen {
                                    output[slot] = FunctionParameter {
                                        function_name_start: function_name_start,
                                        function_name_end: function_name_end,
                                        parameter_start: parameter_start,
                                        parameter_end: parameter_end,
                                        name_start: parameter_name_start,
                                        name_end: parameter_name_end,
                                        type_start: parameter_type_start,
                                        type_end: parameter_type_end,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                }
                                parameter_seen = false
                                parameter_start = end
                                parameter_end = end
                                parameter_name_start = end
                                parameter_name_end = end
                                parameter_type_start = end
                                parameter_type_end = end
                                parameter_type_started = false
                            } else {
                                if paren_depth > 0usize {
                                    if !parameter_seen {
                                        parameter_start = token_start
                                        parameter_seen = true
                                    }
                                    parameter_end = next_source
                                    if parameter_type_started {
                                        if parameter_type_start == end {
                                            parameter_type_start = token_start
                                        }
                                        parameter_type_end = next_source
                                    }
                                }
                            }
                        } else {
                            if paren_depth > 0usize {
                                if !parameter_seen {
                                    parameter_start = token_start
                                    parameter_seen = true
                                }
                                parameter_end = next_source
                                if symbol == 0x3Au8 {
                                    if paren_depth == 1usize {
                                        parameter_type_started = true
                                    } else {
                                        if parameter_type_started {
                                            if parameter_type_start == end {
                                                parameter_type_start = token_start
                                            }
                                            parameter_type_end = next_source
                                        }
                                        if info.kind == 1u8 {
                                            if parameter_name_start == end {
                                                parameter_name_start = token_start
                                                parameter_name_end = next_source
                                            }
                                        }
                                    }
                                } else {
                                    if parameter_type_started {
                                        if parameter_type_start == end {
                                            parameter_type_start = token_start
                                        }
                                        parameter_type_end = next_source
                                    }
                                    if info.kind == 1u8 {
                                        if parameter_name_start == end {
                                            parameter_name_start = token_start
                                            parameter_name_end = next_source
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                source_index = next_source
                if emitted {
                    break
                }
                continue
            }
            if after_parameters {
                if symbol == 0x7Bu8 {
                    var body_depth: UIntSize = 1usize
                    var body_cursor: UIntSize = next_source
                    var body_end: UIntSize = end
                    while body_cursor < end {
                        let body_info: TokenInfo = scan_token_info(bytes, body_cursor, end)
                        if body_info.start >= end {
                            break
                        }
                        let body_start: UIntSize = body_info.start
                        let body_next: UIntSize = body_info.end
                        if body_info.kind == 3u8 {
                            let body_symbol: UInt8 = bytes[body_start]
                            if body_symbol == 0x7Bu8 {
                                body_depth = body_depth + 1usize
                            } else {
                                if body_symbol == 0x7Du8 {
                                    if body_depth > 0usize {
                                        body_depth = body_depth - 1usize
                                    }
                                    if body_depth == 0usize {
                                        body_end = body_next
                                        break
                                    }
                                }
                            }
                        }
                        body_cursor = body_next
                    }
                    source_index = body_end
                    after_parameters = false
                    continue
                }
                if symbol == 0x3Bu8 {
                    source_index = next_source
                    after_parameters = false
                    continue
                }
                source_index = next_source
                continue
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 3u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    if name_info.kind == 1u8 {
                        function_name_start = name_info.start
                        function_name_end = name_info.end
                        paren_depth = 0usize
                        parameter_start = end
                        parameter_end = end
                        parameter_name_start = end
                        parameter_name_end = end
                        parameter_type_start = end
                        parameter_type_end = end
                        parameter_type_started = false
                        parameter_seen = false
                        in_parameters = true
                        source_index = function_name_end
                        continue
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded function-parameter parser as the first
/// caller-owned AST child index. This is an additive ABI alias over the
/// `FunctionParameter` layout; it does not resolve types or build a typed AST.
@export(name: "jadren_selfhost_parse_ast_function_children", abi: "C")
@noalloc
pub fn parse_ast_function_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<FunctionParameter>,
) -> UIntSize {
    return parse_function_parameters(bytes, start, end, output)
}

/// Emits one bounded return/body header for each top-level function. The
/// return span starts after the `->` token and ends immediately before the
/// body; no attempt is made to resolve generic arguments or type aliases.
@export(name: "jadren_selfhost_parse_function_return_headers", abi: "C")
@noalloc
pub fn parse_function_return_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<FunctionReturnHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 3u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    if name_info.kind == 1u8 {
                        let function_name_start: UIntSize = name_info.start
                        let function_name_end: UIntSize = name_info.end
                        var cursor: UIntSize = function_name_end
                        var paren_depth: UIntSize = 0usize
                        var parameters_done: Bool = false
                        var pending_minus: Bool = false
                        var return_started: Bool = false
                        var return_start: UIntSize = end
                        var return_end: UIntSize = end
                        while cursor < end {
                            let part: TokenInfo = scan_token_info(bytes, cursor, end)
                            if part.start >= end {
                                break
                            }
                            let part_start: UIntSize = part.start
                            let part_end: UIntSize = part.end
                            var part_symbol: UInt8 = 0u8
                            if part.kind == 3u8 {
                                part_symbol = bytes[part_start]
                            }
                            if !parameters_done {
                                if part_symbol == 0x28u8 {
                                    paren_depth = paren_depth + 1usize
                                } else {
                                    if part_symbol == 0x29u8 {
                                        if paren_depth > 0usize {
                                            paren_depth = paren_depth - 1usize
                                            if paren_depth == 0usize {
                                                parameters_done = true
                                            }
                                        }
                                    }
                                }
                            } else {
                                if !return_started {
                                    if part_symbol == 0x2Du8 {
                                        pending_minus = true
                                    } else {
                                        if pending_minus {
                                            if part_symbol == 0x3Eu8 {
                                                return_started = true
                                                pending_minus = false
                                            } else {
                                                pending_minus = false
                                            }
                                        }
                                        if part_symbol == 0x7Bu8 {
                                            var body_depth: UIntSize = 1usize
                                            var body_cursor: UIntSize = part_end
                                            var body_end: UIntSize = end
                                            while body_cursor < end {
                                                let body_info: TokenInfo = scan_token_info(bytes, body_cursor, end)
                                                if body_info.start >= end {
                                                    break
                                                }
                                                let body_start: UIntSize = body_info.start
                                                let body_next: UIntSize = body_info.end
                                                if body_info.kind == 3u8 {
                                                    let body_symbol: UInt8 = bytes[body_start]
                                                    if body_symbol == 0x7Bu8 {
                                                        body_depth = body_depth + 1usize
                                                    } else {
                                                        if body_symbol == 0x7Du8 {
                                                            if body_depth > 0usize {
                                                                body_depth = body_depth - 1usize
                                                            }
                                                            if body_depth == 0usize {
                                                                body_end = body_next
                                                                break
                                                            }
                                                        }
                                                    }
                                                }
                                                body_cursor = body_next
                                            }
                                            output[slot] = FunctionReturnHeader {
                                                function_name_start: function_name_start,
                                                function_name_end: function_name_end,
                                                return_start: return_start,
                                                return_end: return_end,
                                                body_start: part_start,
                                                body_end: body_end,
                                            }
                                            output_index = output_index + 1usize
                                            emitted = true
                                            source_index = body_end
                                            cursor = end
                                        }
                                    }
                                } else {
                                    if part_symbol == 0x7Bu8 {
                                        var body_depth: UIntSize = 1usize
                                        var body_cursor: UIntSize = part_end
                                        var body_end: UIntSize = end
                                        while body_cursor < end {
                                            let body_info: TokenInfo = scan_token_info(bytes, body_cursor, end)
                                            if body_info.start >= end {
                                                break
                                            }
                                            let body_start: UIntSize = body_info.start
                                            let body_next: UIntSize = body_info.end
                                            if body_info.kind == 3u8 {
                                                let body_symbol: UInt8 = bytes[body_start]
                                                if body_symbol == 0x7Bu8 {
                                                    body_depth = body_depth + 1usize
                                                } else {
                                                    if body_symbol == 0x7Du8 {
                                                        if body_depth > 0usize {
                                                            body_depth = body_depth - 1usize
                                                        }
                                                        if body_depth == 0usize {
                                                            body_end = body_next
                                                            break
                                                        }
                                                    }
                                                }
                                            }
                                            body_cursor = body_next
                                        }
                                        output[slot] = FunctionReturnHeader {
                                            function_name_start: function_name_start,
                                            function_name_end: function_name_end,
                                            return_start: return_start,
                                            return_end: return_end,
                                            body_start: part_start,
                                            body_end: body_end,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        source_index = body_end
                                        cursor = end
                                    } else {
                                        if return_start == end {
                                            return_start = part_start
                                        }
                                        return_end = part_end
                                    }
                                }
                            }
                            if cursor < end {
                                cursor = part_end
                            }
                            if emitted {
                                break
                            }
                        }
                        if !emitted {
                            source_index = cursor
                        }
                        if emitted {
                            break
                        }
                        continue
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded field headers for top-level `struct` declarations. Commas at
/// the outer struct depth delimit fields; parentheses, brackets and generic
/// angle brackets are treated as nested type syntax. The parser does not
/// resolve visibility, aliases or generic arguments.
@export(name: "jadren_selfhost_parse_struct_fields", abi: "C")
@noalloc
pub fn parse_struct_fields(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<StructFieldHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var struct_pending: Bool = false
    var in_struct: Bool = false
    var struct_depth: UIntSize = 0usize
    var nested_depth: UIntSize = 0usize
    var struct_name_start: UIntSize = end
    var struct_name_end: UIntSize = end
    var field_seen: Bool = false
    var field_name_start: UIntSize = end
    var field_name_end: UIntSize = end
    var field_type_started: Bool = false
    var field_type_start: UIntSize = end
    var field_type_end: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_struct {
                if struct_depth > 1usize {
                    if symbol == 0x7Bu8 {
                        struct_depth = struct_depth + 1usize
                    } else {
                        if symbol == 0x7Du8 {
                            if struct_depth > 0usize {
                                struct_depth = struct_depth - 1usize
                            }
                        }
                    }
                    if field_type_started {
                        if field_type_start == end {
                            field_type_start = token_start
                        }
                        field_type_end = next_source
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x7Bu8 {
                    struct_depth = struct_depth + 1usize
                    if field_type_started {
                        if field_type_start == end {
                            field_type_start = token_start
                        }
                        field_type_end = next_source
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x7Du8 {
                    if field_seen {
                        output[slot] = StructFieldHeader {
                            struct_name_start: struct_name_start,
                            struct_name_end: struct_name_end,
                            field_name_start: field_name_start,
                            field_name_end: field_name_end,
                            type_start: field_type_start,
                            type_end: field_type_end,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                    }
                    in_struct = false
                    struct_depth = 0usize
                    source_index = next_source
                    if emitted {
                        break
                    }
                    continue
                }
                if symbol == 0x2Cu8 {
                    if nested_depth == 0usize {
                        if field_seen {
                            output[slot] = StructFieldHeader {
                                struct_name_start: struct_name_start,
                                struct_name_end: struct_name_end,
                                field_name_start: field_name_start,
                                field_name_end: field_name_end,
                                type_start: field_type_start,
                                type_end: field_type_end,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                        }
                        field_seen = false
                        field_name_start = end
                        field_name_end = end
                        field_type_started = false
                        field_type_start = end
                        field_type_end = end
                        source_index = next_source
                        if emitted {
                            break
                        }
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    nested_depth = nested_depth + 1usize
                } else {
                    if symbol == 0x29u8 {
                        if nested_depth > 0usize {
                            nested_depth = nested_depth - 1usize
                        }
                    } else {
                        if symbol == 0x5Bu8 {
                            nested_depth = nested_depth + 1usize
                        } else {
                            if symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if symbol == 0x3Cu8 {
                                    nested_depth = nested_depth + 1usize
                                } else {
                                    if symbol == 0x3Eu8 {
                                        if nested_depth > 0usize {
                                            nested_depth = nested_depth - 1usize
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if nested_depth == 0usize {
                    if symbol == 0x3Au8 {
                        field_type_started = true
                        source_index = next_source
                        continue
                    }
                }
                if field_type_started {
                    if field_type_start == end {
                        field_type_start = token_start
                    }
                    field_type_end = next_source
                } else {
                    if info.kind == 1u8 {
                        if !field_seen {
                            let width: UIntSize = next_source - token_start
                            var is_pub: Bool = false
                            if width == 3usize {
                                if bytes[token_start] == 0x70u8 {
                                    if bytes[token_start + 1usize] == 0x75u8 {
                                        if bytes[token_start + 2usize] == 0x62u8 {
                                            is_pub = true
                                        }
                                    }
                                }
                            }
                            if !is_pub {
                                field_name_start = token_start
                                field_name_end = next_source
                                field_seen = true
                            }
                        }
                    }
                }
                source_index = next_source
                continue
            }
            if struct_pending {
                if symbol == 0x7Bu8 {
                    in_struct = true
                    struct_pending = false
                    struct_depth = 1usize
                    nested_depth = 0usize
                    field_seen = false
                    field_name_start = end
                    field_name_end = end
                    field_type_started = false
                    field_type_start = end
                    field_type_end = end
                    source_index = next_source
                    continue
                }
                if symbol == 0x3Bu8 {
                    struct_pending = false
                }
                source_index = next_source
                continue
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 4u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    if name_info.kind == 1u8 {
                        struct_name_start = name_info.start
                        struct_name_end = name_info.end
                        struct_pending = true
                        source_index = struct_name_end
                        continue
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded struct-field parser as an AST child view.
/// The exported ABI intentionally reuses `StructFieldHeader` without adding
/// typed field resolution or a second child-node representation.
@export(name: "jadren_selfhost_parse_ast_struct_children", abi: "C")
@noalloc
pub fn parse_ast_struct_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<StructFieldHeader>,
) -> UIntSize {
    return parse_struct_fields(bytes, start, end, output)
}

/// Emits bounded variant headers for top-level `enum` declarations. The
/// outer comma separates variants while nested payload delimiters protect
/// commas in tuple/generic syntax. This stage records source spans only; it
/// does not resolve payload types or constructor semantics.
@export(name: "jadren_selfhost_parse_enum_variants", abi: "C")
@noalloc
pub fn parse_enum_variants(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<EnumVariantHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var enum_pending: Bool = false
    var in_enum: Bool = false
    var enum_depth: UIntSize = 0usize
    var enum_name_start: UIntSize = end
    var enum_name_end: UIntSize = end
    var variant_seen: Bool = false
    var variant_name_start: UIntSize = end
    var variant_name_end: UIntSize = end
    var payload_started: Bool = false
    var payload_start: UIntSize = end
    var payload_end: UIntSize = end
    var nested_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_enum {
                if symbol == 0x7Bu8 {
                    enum_depth = enum_depth + 1usize
                    source_index = next_source
                    continue
                }
                if symbol == 0x7Du8 {
                    if enum_depth > 1usize {
                        enum_depth = enum_depth - 1usize
                        source_index = next_source
                        continue
                    }
                    if variant_seen {
                        output[slot] = EnumVariantHeader {
                            enum_name_start: enum_name_start,
                            enum_name_end: enum_name_end,
                            variant_name_start: variant_name_start,
                            variant_name_end: variant_name_end,
                            payload_start: payload_start,
                            payload_end: payload_end,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                    }
                    in_enum = false
                    enum_depth = 0usize
                    source_index = next_source
                    if emitted {
                        break
                    }
                    continue
                }
                if symbol == 0x2Cu8 {
                    if nested_depth == 0usize {
                        if variant_seen {
                            output[slot] = EnumVariantHeader {
                                enum_name_start: enum_name_start,
                                enum_name_end: enum_name_end,
                                variant_name_start: variant_name_start,
                                variant_name_end: variant_name_end,
                                payload_start: payload_start,
                                payload_end: payload_end,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                        }
                        variant_seen = false
                        variant_name_start = end
                        variant_name_end = end
                        payload_started = false
                        payload_start = end
                        payload_end = end
                        source_index = next_source
                        if emitted {
                            break
                        }
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    nested_depth = nested_depth + 1usize
                    payload_started = true
                    source_index = next_source
                    continue
                }
                if symbol == 0x29u8 {
                    if nested_depth > 0usize {
                        nested_depth = nested_depth - 1usize
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x5Bu8 {
                    nested_depth = nested_depth + 1usize
                } else {
                    if symbol == 0x5Du8 {
                        if nested_depth > 0usize {
                            nested_depth = nested_depth - 1usize
                        }
                    } else {
                        if symbol == 0x3Cu8 {
                            nested_depth = nested_depth + 1usize
                        } else {
                            if symbol == 0x3Eu8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            }
                        }
                    }
                }
                if payload_started {
                    if nested_depth > 0usize {
                        if payload_start == end {
                            payload_start = token_start
                        }
                        if symbol != 0x29u8 {
                            payload_end = next_source
                        }
                    }
                } else {
                    if info.kind == 1u8 {
                        if !variant_seen {
                            variant_name_start = token_start
                            variant_name_end = next_source
                            variant_seen = true
                        }
                    }
                }
                source_index = next_source
                continue
            }
            if enum_pending {
                if symbol == 0x7Bu8 {
                    in_enum = true
                    enum_pending = false
                    enum_depth = 1usize
                    nested_depth = 0usize
                    variant_seen = false
                    variant_name_start = end
                    variant_name_end = end
                    payload_started = false
                    payload_start = end
                    payload_end = end
                    source_index = next_source
                    continue
                }
                if symbol == 0x3Bu8 {
                    enum_pending = false
                }
                source_index = next_source
                continue
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 5u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    if name_info.kind == 1u8 {
                        enum_name_start = name_info.start
                        enum_name_end = name_info.end
                        enum_pending = true
                        source_index = enum_name_end
                        continue
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded enum-variant parser as an AST child view.
/// The exported ABI intentionally reuses `EnumVariantHeader`; payloads remain
/// syntax spans and no constructor or type semantics are claimed.
@export(name: "jadren_selfhost_parse_ast_enum_children", abi: "C")
@noalloc
pub fn parse_ast_enum_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<EnumVariantHeader>,
) -> UIntSize {
    return parse_enum_variants(bytes, start, end, output)
}

/// Emits bounded generic-parameter headers for top-level `fn`, `struct` and
/// `enum` declarations. The first identifier of each comma-delimited segment
/// is the parameter name; the full segment is retained for future bounds and
/// resolver work. No generic substitution or trait resolution happens here.
@export(name: "jadren_selfhost_parse_generic_parameters", abi: "C")
@noalloc
pub fn parse_generic_parameters(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<GenericParameterHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var pending_kind: UInt8 = 0u8
    var pending_owner_start: UIntSize = end
    var pending_owner_end: UIntSize = end
    var in_generics: Bool = false
    var generic_depth: UIntSize = 0usize
    var parameter_seen: Bool = false
    var parameter_start: UIntSize = end
    var parameter_end: UIntSize = end
    var parameter_name_start: UIntSize = end
    var parameter_name_end: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_generics {
                if symbol == 0x3Cu8 {
                    generic_depth = generic_depth + 1usize
                    if parameter_seen {
                        parameter_end = next_source
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x3Eu8 {
                    if generic_depth == 1usize {
                        if parameter_seen {
                            output[slot] = GenericParameterHeader {
                                owner_kind: pending_kind,
                                owner_name_start: pending_owner_start,
                                owner_name_end: pending_owner_end,
                                parameter_start: parameter_start,
                                parameter_end: parameter_end,
                                name_start: parameter_name_start,
                                name_end: parameter_name_end,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                        }
                        in_generics = false
                        generic_depth = 0usize
                        pending_kind = 0u8
                        parameter_seen = false
                        parameter_start = end
                        parameter_end = end
                        parameter_name_start = end
                        parameter_name_end = end
                        source_index = next_source
                        if emitted {
                            break
                        }
                        continue
                    }
                    if generic_depth > 0usize {
                        generic_depth = generic_depth - 1usize
                    }
                    if parameter_seen {
                        parameter_end = token_start
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x2Cu8 {
                    if generic_depth == 1usize {
                        if parameter_seen {
                            output[slot] = GenericParameterHeader {
                                owner_kind: pending_kind,
                                owner_name_start: pending_owner_start,
                                owner_name_end: pending_owner_end,
                                parameter_start: parameter_start,
                                parameter_end: parameter_end,
                                name_start: parameter_name_start,
                                name_end: parameter_name_end,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                        }
                        parameter_seen = false
                        parameter_start = end
                        parameter_end = end
                        parameter_name_start = end
                        parameter_name_end = end
                        source_index = next_source
                        if emitted {
                            break
                        }
                        continue
                    }
                }
                if parameter_seen {
                    parameter_end = next_source
                } else {
                    if info.kind == 1u8 {
                        if generic_depth == 1usize {
                            parameter_start = token_start
                            parameter_end = next_source
                            parameter_name_start = token_start
                            parameter_name_end = next_source
                            parameter_seen = true
                        }
                    }
                }
                source_index = next_source
                continue
            }
            if pending_kind != 0u8 {
                if symbol == 0x3Cu8 {
                    in_generics = true
                    generic_depth = 1usize
                    parameter_seen = false
                    parameter_start = end
                    parameter_end = end
                    parameter_name_start = end
                    parameter_name_end = end
                    source_index = next_source
                    continue
                }
                if symbol == 0x7Bu8 {
                    pending_kind = 0u8
                } else {
                    if symbol == 0x3Bu8 {
                        pending_kind = 0u8
                    }
                }
                source_index = next_source
                continue
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 3u8 {
                    let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                    if name_info.kind == 1u8 {
                        pending_kind = kind
                        pending_owner_start = name_info.start
                        pending_owner_end = name_info.end
                        source_index = name_info.end
                        continue
                    }
                } else {
                    if kind == 4u8 {
                        let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                        if name_info.kind == 1u8 {
                            pending_kind = kind
                            pending_owner_start = name_info.start
                            pending_owner_end = name_info.end
                            source_index = name_info.end
                            continue
                        }
                    } else {
                        if kind == 5u8 {
                            let name_info: TokenInfo = scan_token_info(bytes, next_source, end)
                            if name_info.kind == 1u8 {
                                pending_kind = kind
                                pending_owner_start = name_info.start
                                pending_owner_end = name_info.end
                                source_index = name_info.end
                                continue
                            }
                        }
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded generic-parameter parser as an AST child view.
/// The exported ABI intentionally reuses `GenericParameterHeader`; parameter
/// bounds remain syntax spans and no generic substitution or name resolution
/// is claimed at this stage.
@export(name: "jadren_selfhost_parse_ast_generic_children", abi: "C")
@noalloc
pub fn parse_ast_generic_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<GenericParameterHeader>,
) -> UIntSize {
    return parse_generic_parameters(bytes, start, end, output)
}

/// Emits bounded top-level annotation headers. `@name` and `@name(...)` are
/// both accepted; nested delimiters inside the argument list are retained in
/// one source span. Annotation semantics are intentionally left to later AST
/// and resolver stages.
@export(name: "jadren_selfhost_parse_attributes", abi: "C")
@noalloc
pub fn parse_attributes(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<AttributeHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var pending_at: Bool = false
    var attribute_name_start: UIntSize = end
    var attribute_name_end: UIntSize = end
    var in_arguments: Bool = false
    var argument_depth: UIntSize = 0usize
    var arguments_started: Bool = false
    var arguments_start: UIntSize = end
    var arguments_end: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_arguments {
                if symbol == 0x28u8 {
                    argument_depth = argument_depth + 1usize
                    if arguments_started {
                        arguments_end = next_source
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x29u8 {
                    if argument_depth == 1usize {
                        if arguments_started {
                            output[slot] = AttributeHeader {
                                name_start: attribute_name_start,
                                name_end: attribute_name_end,
                                arguments_start: arguments_start,
                                arguments_end: arguments_end,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                        }
                        in_arguments = false
                        argument_depth = 0usize
                        arguments_started = false
                        arguments_start = end
                        arguments_end = end
                        pending_at = false
                        source_index = next_source
                        if emitted {
                            break
                        }
                        continue
                    }
                    if argument_depth > 0usize {
                        argument_depth = argument_depth - 1usize
                    }
                    if arguments_started {
                        arguments_end = token_start
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x5Bu8 {
                    argument_depth = argument_depth + 1usize
                } else {
                    if symbol == 0x5Du8 {
                        if argument_depth > 0usize {
                            argument_depth = argument_depth - 1usize
                        }
                    } else {
                        if symbol == 0x3Cu8 {
                            argument_depth = argument_depth + 1usize
                        } else {
                            if symbol == 0x3Eu8 {
                                if argument_depth > 0usize {
                                    argument_depth = argument_depth - 1usize
                                }
                            }
                        }
                    }
                }
                if !arguments_started {
                    if symbol != 0x29u8 {
                        arguments_start = token_start
                        arguments_end = next_source
                        arguments_started = true
                    }
                } else {
                    arguments_end = next_source
                }
                source_index = next_source
                continue
            }
            if pending_at {
                if attribute_name_start == end {
                    if info.kind == 1u8 {
                        attribute_name_start = token_start
                        attribute_name_end = next_source
                        source_index = next_source
                        continue
                    }
                    pending_at = false
                    source_index = next_source
                    continue
                }
                if symbol == 0x28u8 {
                    in_arguments = true
                    argument_depth = 1usize
                    arguments_started = false
                    arguments_start = end
                    arguments_end = end
                    source_index = next_source
                    continue
                }
                output[slot] = AttributeHeader {
                    name_start: attribute_name_start,
                    name_end: attribute_name_end,
                    arguments_start: end,
                    arguments_end: end,
                }
                output_index = output_index + 1usize
                emitted = true
                pending_at = false
                attribute_name_start = end
                attribute_name_end = end
                if symbol == 0x40u8 {
                    source_index = token_start
                } else {
                    source_index = next_source
                }
                break
            }
            if brace_depth == 0usize {
                if symbol == 0x40u8 {
                    pending_at = true
                    attribute_name_start = end
                    attribute_name_end = end
                    source_index = next_source
                    continue
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded annotation parser as an AST child view.
/// The exported ABI reuses `AttributeHeader`; arguments remain syntax spans
/// and no annotation semantics or resolver identity is claimed.
@export(name: "jadren_selfhost_parse_ast_attribute_children", abi: "C")
@noalloc
pub fn parse_ast_attribute_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<AttributeHeader>,
) -> UIntSize {
    return parse_attributes(bytes, start, end, output)
}

/// Emits bounded module/import path headers. The scanner retains `.` and `::`
/// separators in the half-open path span and counts identifier segments; it
/// does not resolve module identities or validate package imports.
@export(name: "jadren_selfhost_parse_paths", abi: "C")
@noalloc
pub fn parse_paths(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PathHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var pending_kind: UInt8 = 0u8
    var path_active: Bool = false
    var path_start: UIntSize = end
    var path_end: UIntSize = end
    var segment_count: UIntSize = 0usize
    var path_separator_pending: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if path_active {
                if symbol == 0x3Bu8 {
                    output[slot] = PathHeader {
                        kind: pending_kind,
                        path_start: path_start,
                        path_end: path_end,
                        segment_count: segment_count,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    path_active = false
                    pending_kind = 0u8
                    path_separator_pending = false
                    source_index = next_source
                    break
                }
                if info.kind == 1u8 {
                    if path_separator_pending {
                        segment_count = segment_count + 1usize
                        path_end = next_source
                        path_separator_pending = false
                    } else {
                        output[slot] = PathHeader {
                            kind: pending_kind,
                            path_start: path_start,
                            path_end: path_end,
                            segment_count: segment_count,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        path_active = false
                        pending_kind = 0u8
                        path_separator_pending = false
                        source_index = token_start
                        break
                    }
                } else {
                    if symbol == 0x2Eu8 {
                        path_end = next_source
                        path_separator_pending = true
                    } else {
                        if symbol == 0x3Au8 {
                            path_end = next_source
                            path_separator_pending = true
                        } else {
                            if symbol == 0x7Bu8 {
                                output[slot] = PathHeader {
                                    kind: pending_kind,
                                    path_start: path_start,
                                    path_end: path_end,
                                    segment_count: segment_count,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                path_active = false
                                pending_kind = 0u8
                                path_separator_pending = false
                                source_index = token_start
                                break
                            }
                        }
                    }
                }
                source_index = next_source
                continue
            }
            if pending_kind != 0u8 {
                if info.kind == 1u8 {
                    path_active = true
                    path_start = token_start
                    path_end = next_source
                    segment_count = 1usize
                    path_separator_pending = false
                    source_index = next_source
                    continue
                }
                pending_kind = 0u8
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 1u8 {
                    pending_kind = kind
                    source_index = next_source
                    continue
                } else {
                    if kind == 2u8 {
                        pending_kind = kind
                        source_index = next_source
                        continue
                    }
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded extern-function headers from `extern "C" { ... }` blocks.
/// Parameter and return spans are syntax-level only; ABI validation, unsafe
/// policy and type resolution remain in the host compiler.
@export(name: "jadren_selfhost_parse_extern_functions", abi: "C")
@noalloc
pub fn parse_extern_functions(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExternFunctionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    var extern_pending: Bool = false
    var in_extern: Bool = false
    var extern_depth: UIntSize = 0usize
    var abi_seen: Bool = false
    var abi_start: UIntSize = end
    var abi_end: UIntSize = end
    var function_pending: Bool = false
    var pending_unsafe: UInt8 = 0u8
    var in_function: Bool = false
    var function_name_start: UIntSize = end
    var function_name_end: UIntSize = end
    var parameter_start: UIntSize = end
    var parameter_end: UIntSize = end
    var parameter_count: UIntSize = 0usize
    var parameter_seen: Bool = false
    var paren_depth: UIntSize = 0usize
    var generic_depth: UIntSize = 0usize
    var parameters_done: Bool = false
    var pending_minus: Bool = false
    var return_started: Bool = false
    var return_start: UIntSize = end
    var return_end: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if in_function {
                if !parameters_done {
                    if symbol == 0x28u8 {
                        if paren_depth == 0usize {
                            paren_depth = 1usize
                            parameter_start = end
                            parameter_end = end
                            parameter_seen = false
                        } else {
                            paren_depth = paren_depth + 1usize
                            if !parameter_seen {
                                parameter_start = token_start
                            }
                            parameter_seen = true
                            parameter_end = next_source
                        }
                        source_index = next_source
                        continue
                    }
                    if symbol == 0x29u8 {
                        if paren_depth > 0usize {
                            if paren_depth == 1usize {
                                if parameter_seen {
                                    parameter_count = parameter_count + 1usize
                                    parameter_end = token_start
                                }
                                paren_depth = 0usize
                                parameters_done = true
                            } else {
                                paren_depth = paren_depth - 1usize
                                if parameter_seen {
                                    parameter_end = token_start
                                }
                            }
                        }
                        source_index = next_source
                        continue
                    }
                    if symbol == 0x3Cu8 {
                        generic_depth = generic_depth + 1usize
                    } else {
                        if symbol == 0x3Eu8 {
                            if generic_depth > 0usize {
                                generic_depth = generic_depth - 1usize
                            }
                        }
                    }
                    if symbol == 0x2Cu8 {
                        if paren_depth == 1usize {
                            if generic_depth == 0usize {
                                if parameter_seen {
                                    parameter_count = parameter_count + 1usize
                                    parameter_end = token_start
                                }
                                parameter_seen = false
                                parameter_start = end
                                parameter_end = end
                                source_index = next_source
                                continue
                            }
                        }
                    }
                    if paren_depth > 0usize {
                        if !parameter_seen {
                            parameter_start = token_start
                            parameter_seen = true
                        }
                        parameter_end = next_source
                    }
                    source_index = next_source
                    continue
                }
                if !return_started {
                    if symbol == 0x2Du8 {
                        pending_minus = true
                    } else {
                        if pending_minus {
                            if symbol == 0x3Eu8 {
                                return_started = true
                                pending_minus = false
                            } else {
                                pending_minus = false
                            }
                        }
                    }
                    if symbol == 0x3Bu8 {
                        output[slot] = ExternFunctionHeader {
                            abi_start: abi_start,
                            abi_end: abi_end,
                            function_name_start: function_name_start,
                            function_name_end: function_name_end,
                            parameter_start: parameter_start,
                            parameter_end: parameter_end,
                            parameter_count: parameter_count,
                            return_start: return_start,
                            return_end: return_end,
                            is_unsafe: pending_unsafe,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        in_function = false
                        pending_unsafe = 0u8
                        function_name_start = end
                        function_name_end = end
                        parameter_start = end
                        parameter_end = end
                        parameter_count = 0usize
                        return_start = end
                        return_end = end
                        source_index = next_source
                        break
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x3Bu8 {
                    output[slot] = ExternFunctionHeader {
                        abi_start: abi_start,
                        abi_end: abi_end,
                        function_name_start: function_name_start,
                        function_name_end: function_name_end,
                        parameter_start: parameter_start,
                        parameter_end: parameter_end,
                        parameter_count: parameter_count,
                        return_start: return_start,
                        return_end: return_end,
                        is_unsafe: pending_unsafe,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    in_function = false
                    pending_unsafe = 0u8
                    function_name_start = end
                    function_name_end = end
                    parameter_start = end
                    parameter_end = end
                    parameter_count = 0usize
                    return_start = end
                    return_end = end
                    source_index = next_source
                    break
                }
                if return_start == end {
                    return_start = token_start
                }
                return_end = next_source
                source_index = next_source
                continue
            }
            if in_extern {
                if symbol == 0x7Du8 {
                    if extern_depth == 1usize {
                        in_extern = false
                        extern_depth = 0usize
                        source_index = next_source
                        continue
                    }
                    if extern_depth > 0usize {
                        extern_depth = extern_depth - 1usize
                    }
                    source_index = next_source
                    continue
                }
                if symbol == 0x7Bu8 {
                    extern_depth = extern_depth + 1usize
                    source_index = next_source
                    continue
                }
                if function_pending {
                    if info.kind == 1u8 {
                        function_name_start = token_start
                        function_name_end = next_source
                        in_function = true
                        function_pending = false
                        parameter_start = end
                        parameter_end = end
                        parameter_count = 0usize
                        parameter_seen = false
                        paren_depth = 0usize
                        generic_depth = 0usize
                        parameters_done = false
                        pending_minus = false
                        return_started = false
                        return_start = end
                        return_end = end
                        source_index = next_source
                        continue
                    }
                    function_pending = false
                }
                if info.kind == 1u8 {
                    let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                    if kind == 3u8 {
                        function_pending = true
                        source_index = next_source
                        continue
                    }
                    pending_unsafe = 1u8
                }
                source_index = next_source
                continue
            }
            if extern_pending {
                if symbol == 0x7Bu8 {
                    in_extern = true
                    extern_pending = false
                    extern_depth = 1usize
                    source_index = next_source
                    continue
                }
                if !abi_seen {
                    abi_start = token_start
                    abi_seen = true
                }
                abi_end = next_source
                source_index = next_source
                continue
            }
            if brace_depth == 0usize {
                let kind: UInt8 = declaration_kind(bytes, info.kind, token_start, next_source)
                if kind == 6u8 {
                    extern_pending = true
                    abi_seen = false
                    abi_start = end
                    abi_end = end
                    source_index = next_source
                    continue
                }
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
            } else {
                if symbol == 0x7Du8 {
                    if brace_depth > 0usize {
                        brace_depth = brace_depth - 1usize
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded extern-function parser as an AST child view.
/// The exported ABI reuses `ExternFunctionHeader`; ABI policy, unsafe checking
/// and type resolution remain outside this syntax-only projection.
@export(name: "jadren_selfhost_parse_ast_extern_children", abi: "C")
@noalloc
pub fn parse_ast_extern_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExternFunctionHeader>,
) -> UIntSize {
    return parse_extern_functions(bytes, start, end, output)
}

/// Emits bounded `{ ... }` block headers in source order. Each opening brace
/// is matched independently so nested blocks can be handed to a caller-owned
/// output without allocating a stack; this is structural data only, not a
/// statement or control-flow interpretation.
@export(name: "jadren_selfhost_parse_blocks", abi: "C")
@noalloc
pub fn parse_blocks(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<BlockHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x7Bu8 {
                let block_depth: UIntSize = brace_depth + 1usize
                var nested_depth: UIntSize = 1usize
                var cursor: UIntSize = next_source
                var block_end: UIntSize = end
                while cursor < end {
                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if nested_info.start >= end {
                        cursor = end
                        break
                    }
                    var nested_symbol: UInt8 = 0u8
                    if nested_info.kind == 3u8 {
                        nested_symbol = bytes[nested_info.start]
                    }
                    if nested_symbol == 0x7Bu8 {
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x7Du8 {
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                            if nested_depth == 0usize {
                                block_end = nested_info.end
                                break
                            }
                        }
                    }
                    cursor = nested_info.end
                }
                output[slot] = BlockHeader {
                    start: token_start,
                    end: block_end,
                    depth: block_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                brace_depth = brace_depth + 1usize
                source_index = next_source
                break
            }
            if symbol == 0x7Du8 {
                if brace_depth > 0usize {
                    brace_depth = brace_depth - 1usize
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded block scanner as an AST child view.
/// `BlockHeader` keeps only source span and nesting depth; statement and
/// control-flow semantics remain outside this syntax-only projection.
@export(name: "jadren_selfhost_parse_ast_block_children", abi: "C")
@noalloc
pub fn parse_ast_block_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<BlockHeader>,
) -> UIntSize {
    return parse_blocks(bytes, start, end, output)
}

/// Emits bounded statement headers from function/region blocks. Simple
/// statements retain only their keyword span; control-flow statements also
/// retain the first matching body block. The scanner is deliberately
/// syntax-only and does not resolve expressions, names, or branch semantics.
@export(name: "jadren_selfhost_parse_statements", abi: "C")
@noalloc
pub fn parse_statements(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<StatementHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x7Du8 {
                if brace_depth > 0usize {
                    brace_depth = brace_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if brace_depth > 0usize {
                let kind: UInt8 = statement_kind(bytes, info.kind, token_start, next_source)
                if kind != 0u8 {
                    var statement_end: UIntSize = next_source
                    var body_start: UIntSize = next_source
                    var body_end: UIntSize = next_source
                    if statement_has_body(kind) {
                        var cursor: UIntSize = next_source
                        var delimiter_depth: UIntSize = 0usize
                        while cursor < end {
                            let candidate: TokenInfo = scan_token_info(bytes, cursor, end)
                            if candidate.start >= end {
                                cursor = end
                                break
                            }
                            var candidate_symbol: UInt8 = 0u8
                            if candidate.kind == 3u8 {
                                candidate_symbol = bytes[candidate.start]
                            }
                            if candidate_symbol == 0x28u8 {
                                delimiter_depth = delimiter_depth + 1usize
                            } else {
                                if candidate_symbol == 0x29u8 {
                                    if delimiter_depth > 0usize {
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                } else {
                                    if candidate_symbol == 0x5Bu8 {
                                        delimiter_depth = delimiter_depth + 1usize
                                    } else {
                                        if candidate_symbol == 0x5Du8 {
                                            if delimiter_depth > 0usize {
                                                delimiter_depth = delimiter_depth - 1usize
                                            }
                                        } else {
                                            if candidate_symbol == 0x7Bu8 {
                                                if delimiter_depth == 0usize {
                                                    body_start = candidate.start
                                                    var nested_depth: UIntSize = 1usize
                                                    var body_cursor: UIntSize = candidate.end
                                                    body_end = end
                                                    while body_cursor < end {
                                                        let nested_info: TokenInfo = scan_token_info(bytes, body_cursor, end)
                                                        if nested_info.start >= end {
                                                            body_cursor = end
                                                            break
                                                        }
                                                        var nested_symbol: UInt8 = 0u8
                                                        if nested_info.kind == 3u8 {
                                                            nested_symbol = bytes[nested_info.start]
                                                        }
                                                        if nested_symbol == 0x7Bu8 {
                                                            nested_depth = nested_depth + 1usize
                                                        } else {
                                                            if nested_symbol == 0x7Du8 {
                                                                if nested_depth > 0usize {
                                                                    nested_depth = nested_depth - 1usize
                                                                }
                                                                if nested_depth == 0usize {
                                                                    body_end = nested_info.end
                                                                    break
                                                                }
                                                            }
                                                        }
                                                        body_cursor = nested_info.end
                                                    }
                                                    statement_end = body_end
                                                    break
                                                }
                                            } else {
                                                if candidate_symbol == 0x3Bu8 {
                                                    if delimiter_depth == 0usize {
                                                        statement_end = candidate.end
                                                        break
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            cursor = candidate.end
                        }
                    }
                    output[slot] = StatementHeader {
                        kind: kind,
                        start: token_start,
                        end: statement_end,
                        body_start: body_start,
                        body_end: body_end,
                        depth: brace_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    source_index = next_source
                    break
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded statement scanner as an AST child view.
/// `StatementHeader` keeps syntax spans and nesting depth; expression,
/// control-flow and name semantics remain outside this projection.
@export(name: "jadren_selfhost_parse_ast_statement_children", abi: "C")
@noalloc
pub fn parse_ast_statement_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<StatementHeader>,
) -> UIntSize {
    return parse_statements(bytes, start, end, output)
}

/// Emits bounded parenthesized and bracketed expression groups in source
/// order. Each opener is matched independently with a scalar depth counter;
/// nested groups are therefore available to a caller-owned AST builder without
/// allocating a delimiter stack. This stage does not classify operators,
/// resolve types, or validate mismatched delimiters.
@export(name: "jadren_selfhost_parse_expression_groups", abi: "C")
@noalloc
pub fn parse_expression_groups(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionGroupHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var brace_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x7Bu8 {
                brace_depth = brace_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x7Du8 {
                if brace_depth > 0usize {
                    brace_depth = brace_depth - 1usize
                }
                source_index = next_source
                continue
            }
            var group_kind: UInt8 = 0u8
            var closing_symbol: UInt8 = 0u8
            if symbol == 0x28u8 {
                group_kind = 1u8
                closing_symbol = 0x29u8
            } else {
                if symbol == 0x5Bu8 {
                    group_kind = 2u8
                    closing_symbol = 0x5Du8
                }
            }
            if group_kind != 0u8 {
                var nested_depth: UIntSize = 1usize
                var cursor: UIntSize = next_source
                var group_end: UIntSize = end
                while cursor < end {
                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if nested_info.start >= end {
                        cursor = end
                        break
                    }
                    var nested_symbol: UInt8 = 0u8
                    if nested_info.kind == 3u8 {
                        nested_symbol = bytes[nested_info.start]
                    }
                    if nested_symbol == symbol {
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == closing_symbol {
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                            if nested_depth == 0usize {
                                group_end = nested_info.end
                                break
                            }
                        }
                    }
                    cursor = nested_info.end
                }
                output[slot] = ExpressionGroupHeader {
                    kind: group_kind,
                    start: token_start,
                    end: group_end,
                    depth: brace_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded expression-group scanner as an AST child
/// view. Group kind/span and enclosing brace depth remain syntax-only.
@export(name: "jadren_selfhost_parse_ast_expression_group_children", abi: "C")
@noalloc
pub fn parse_ast_expression_group_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionGroupHeader>,
) -> UIntSize {
    return parse_expression_groups(bytes, start, end, output)
}

/// Emits identifier/number atoms and complete delimiter-group atoms from one
/// explicit expression range. Parenthesized and bracketed groups are emitted
/// as records while their interior is still visited, so a caller can build a
/// nested atom stream with the scalar delimiter depth. Operators and other
/// punctuation only advance the cursor in this syntax-only stage.
@export(name: "jadren_selfhost_parse_expression_atoms", abi: "C")
@noalloc
pub fn parse_expression_atoms(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionAtomHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                output[slot] = ExpressionAtomHeader {
                    kind: 1u8,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                output[slot] = ExpressionAtomHeader {
                    kind: 2u8,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            var group_kind: UInt8 = 0u8
            var closing_symbol: UInt8 = 0u8
            if symbol == 0x28u8 {
                group_kind = 3u8
                closing_symbol = 0x29u8
            } else {
                if symbol == 0x5Bu8 {
                    group_kind = 4u8
                    closing_symbol = 0x5Du8
                }
            }
            if group_kind != 0u8 {
                var nested_depth: UIntSize = 1usize
                var cursor: UIntSize = next_source
                var group_end: UIntSize = end
                while cursor < end {
                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if nested_info.start >= end {
                        cursor = end
                        break
                    }
                    var nested_symbol: UInt8 = 0u8
                    if nested_info.kind == 3u8 {
                        nested_symbol = bytes[nested_info.start]
                    }
                    if nested_symbol == symbol {
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == closing_symbol {
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                            if nested_depth == 0usize {
                                group_end = nested_info.end
                                break
                            }
                        }
                    }
                    cursor = nested_info.end
                }
                output[slot] = ExpressionAtomHeader {
                    kind: group_kind,
                    start: token_start,
                    end: group_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the existing bounded expression-atom scanner as an AST child
/// view. Atom kind/span/depth are syntax-only and retain caller-owned output.
@export(name: "jadren_selfhost_parse_ast_expression_atom_children", abi: "C")
@noalloc
pub fn parse_ast_expression_atom_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionAtomHeader>,
) -> UIntSize {
    return parse_expression_atoms(bytes, start, end, output)
}

/// Emits categorized operator spans from one explicit expression range. The
/// scanner uses longest-match byte spans for multi-character operators and
/// records the surrounding parenthesis/bracket depth. No precedence or
/// operand association is inferred here.
@export(name: "jadren_selfhost_parse_expression_operators", abi: "C")
@noalloc
pub fn parse_expression_operators(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionOperatorHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 3u8 {
                let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                let kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                if kind != 0u8 {
                    output[slot] = ExpressionOperatorHeader {
                        kind: kind,
                        start: token_start,
                        end: operator_end,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    source_index = operator_end
                    break
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Projects the bounded operator scanner as an AST child view. Operator
/// kind/span/depth are syntax-only and retain caller-owned output.
@export(name: "jadren_selfhost_parse_ast_expression_operator_children", abi: "C")
@noalloc
pub fn parse_ast_expression_operator_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionOperatorHeader>,
) -> UIntSize {
    return parse_expression_operators(bytes, start, end, output)
}

/// Projects the bounded postfix scanner as an AST child view. Postfix
/// kind/span/depth are syntax-only and retain caller-owned output.
@export(name: "jadren_selfhost_parse_ast_expression_postfix_children", abi: "C")
@noalloc
pub fn parse_ast_expression_postfix_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPostfixHeader>,
) -> UIntSize {
    return parse_expression_postfixes(bytes, start, end, output)
}

/// Projects the bounded binary scanner as an AST child view. Operand/operator
/// spans and depth are syntax-only and retain caller-owned output.
@export(name: "jadren_selfhost_parse_ast_expression_binary_children", abi: "C")
@noalloc
pub fn parse_ast_expression_binary_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionBinaryHeader>,
) -> UIntSize {
    return parse_expression_binary_headers(bytes, start, end, output)
}

/// Projects the bounded unary scanner as an AST child view. Prefix
/// operator/operand spans and depth are syntax-only and retain caller-owned
/// output.
@export(name: "jadren_selfhost_parse_ast_expression_unary_children", abi: "C")
@noalloc
pub fn parse_ast_expression_unary_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionUnaryHeader>,
) -> UIntSize {
    return parse_expression_unaries(bytes, start, end, output)
}

@export(name: "jadren_selfhost_parse_ast_expression_literal_children", abi: "C")
@noalloc
pub fn parse_ast_expression_literal_children(
    bytes: read Slice<UInt8>,
