/// Projects the bounded match-arm scanner as an AST child view. Pattern,
/// optional guard, body spans and delimiter depth remain syntax-only and are
/// written into caller-owned output; exhaustiveness and arm typing remain
/// later compiler stages.
@export(name: "jadren_selfhost_parse_ast_match_arm_children", abi: "C")
@noalloc
pub fn parse_ast_match_arm_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<MatchArmHeader>,
) -> UIntSize {
    return parse_match_arms(bytes, start, end, output)
}

/// Projects the bounded pattern scanner as an AST child view. Pattern kind,
