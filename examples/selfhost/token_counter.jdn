/// syntax-only and are written into caller-owned output; bindings,
/// exhaustiveness and type checking remain later compiler stages.
@export(name: "jadren_selfhost_parse_ast_pattern_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternHeader>,
) -> UIntSize {
    return parse_pattern_headers(bytes, start, end, output)
}

/// Projects the bounded pattern-binding scanner as an AST child view. Binding
