}

@export(name: "jadren_selfhost_parse_ast_type_component_children", abi: "C")
@noalloc
pub fn parse_ast_type_component_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypeComponentHeader>,
) -> UIntSize {
    return parse_type_components(bytes, start, end, output)
