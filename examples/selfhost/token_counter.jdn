            if ast_capacity > root_node { ast[root_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: ast_cursor, right: second_node, aux: 0usize, start: operand_starts[0], end: operand_ends[3] } }
        } else {
            if ast_capacity > first_node { ast[first_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: ast_cursor + 2usize, right: ast_cursor + 3usize, aux: 0usize, start: operand_starts[2], end: operand_ends[3] } }
            if ast_capacity > second_node { ast[second_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: ast_cursor + 1usize, right: first_node, aux: 0usize, start: operand_starts[1], end: operand_ends[3] } }
            if ast_capacity > root_node { ast[root_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: ast_cursor, right: second_node, aux: 0usize, start: operand_starts[0], end: operand_ends[3] } }
        }
        return Stage2TypedExpressionEmission { valid: true, node_count: 7usize, root_node: root_node }
    }
    return invalid
}

fn stage2_emit_typed_assignment_expression(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
    ast: write Slice<TypedExpressionAstNodeHeader>,
    ast_capacity: UIntSize,
    ast_cursor: UIntSize,
) -> Stage2TypedExpressionEmission {
    let legacy: Stage2TypedExpressionEmission = stage2_emit_typed_assignment_expression_legacy(bytes, expression_start, expression_end, ast, ast_capacity, ast_cursor)
    if legacy.valid { return legacy }
    return stage2_emit_generic_typed_int32_expression(bytes, expression_start, expression_end, ast, ast_capacity, ast_cursor)
}

fn stage2_parse_typed_while_dynamic_body_span(
    bytes: read Slice<UInt8>,
    cursor: UIntSize,
    body_end: UIntSize,
    name_start: UIntSize,
    name_end: UIntSize,
) -> Stage2TypedWhileDynamicBodySpan {
    let invalid: Stage2TypedWhileDynamicBodySpan = Stage2TypedWhileDynamicBodySpan {
        valid: false,
        kind: 0u8,
        start: 0usize,
        end: 0usize,
        target_start: 0usize,
        target_end: 0usize,
        expression_left_start: 0usize,
        expression_left_end: 0usize,
        expression_middle_start: 0usize,
        expression_middle_end: 0usize,
        expression_middle_kind: 0u8,
        expression_right_start: 0usize,
        expression_right_end: 0usize,
        expression_right_kind: 0u8,
        expression_node_count: 0usize,
        next_cursor: 0usize,
    }
    let first: TokenInfo = scan_token_info(bytes, cursor, body_end)
    if first.start >= body_end { return invalid }
    if first.kind == 1u8 {
        if first.end - first.start == 2usize {
            if bytes[first.start] == 0x69u8 {
                if bytes[first.start + 1usize] == 0x66u8 {
                    let condition_left: TokenInfo = scan_token_info(bytes, first.end, body_end)
                    let condition_operator: TokenInfo = scan_stage2_operator_info(bytes, condition_left.end, body_end)
                    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end)
                    let condition_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end)
                    let control_keyword: TokenInfo = scan_token_info(bytes, condition_open.end, body_end)
                    let control_tail: TokenInfo = scan_token_info(bytes, control_keyword.end, body_end)
                    let condition_close: TokenInfo = scan_token_info(bytes, control_tail.end, body_end)
                    var control_kind: UInt8 = 0u8
                    if control_keyword.kind == 1u8 {
                        if control_keyword.end - control_keyword.start == 5usize {
                            if bytes[control_keyword.start] == 0x62u8 {
                                if bytes[control_keyword.start + 1usize] == 0x72u8 {
                                    if bytes[control_keyword.start + 2usize] == 0x65u8 {
                                        if bytes[control_keyword.start + 3usize] == 0x61u8 {
                                            if bytes[control_keyword.start + 4usize] == 0x6Bu8 { control_kind = 4u8 }
                                        }
                                    }
                                }
                            }
                        }
                        if control_keyword.end - control_keyword.start == 8usize {
                            if bytes[control_keyword.start] == 0x63u8 {
                                if bytes[control_keyword.start + 1usize] == 0x6Fu8 {
                                    if bytes[control_keyword.start + 2usize] == 0x6Eu8 {
                                        if bytes[control_keyword.start + 3usize] == 0x74u8 {
                                            if bytes[control_keyword.start + 4usize] == 0x69u8 {
                                                if bytes[control_keyword.start + 5usize] == 0x6Eu8 {
                                                    if bytes[control_keyword.start + 6usize] == 0x75u8 {
                                                        if bytes[control_keyword.start + 7usize] == 0x65u8 { control_kind = 5u8 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if condition_left.kind != 1u8 { return invalid }
                    if !stage2_same_ascii(bytes, name_start, name_end, condition_left.start, condition_left.end) { return invalid }
                    if condition_operator.kind != 3u8 { return invalid }
                    let compare_operator_valid: Bool = operator_kind(bytes, condition_operator.start, condition_operator.end) == 3u8
                    if !compare_operator_valid { return invalid }
                    var condition_right_kind: UInt8 = 0u8
                    if condition_right.kind == 2u8 { condition_right_kind = 2u8 }
                    if condition_right.kind == 1u8 { condition_right_kind = 1u8 }
                    if condition_right_kind == 0u8 { return invalid }
                    if condition_open.kind != 3u8 { return invalid }
                    if bytes[condition_open.start] != 0x7Bu8 { return invalid }
                    if control_kind == 0u8 { return invalid }
                    if control_tail.kind != 3u8 { return invalid }
                    if bytes[control_tail.start] != 0x3Bu8 { return invalid }
                    if condition_close.kind != 3u8 { return invalid }
                    if bytes[condition_close.start] != 0x7Du8 { return invalid }
                    return Stage2TypedWhileDynamicBodySpan {
                        valid: true,
                        kind: control_kind,
                        start: first.start,
                        end: condition_close.end,
                        target_start: 0usize,
                        target_end: 0usize,
                        expression_left_start: condition_left.start,
                        expression_left_end: condition_left.end,
                        expression_middle_start: 0usize,
                        expression_middle_end: 0usize,
                        expression_middle_kind: 0u8,
                        expression_right_start: condition_right.start,
                        expression_right_end: condition_right.end,
                        expression_right_kind: condition_right_kind,
                        expression_node_count: 3usize,
                        next_cursor: condition_close.end,
                    }
                }
            }
        }
    }

    // Keep immutable body-local declarations on a compact direct path.  The
    // diagnostic helper validates the token shape first; emitting the span
    // here avoids the large compatibility recognizer's nested branch pressure.
    if stage2_validate_dynamic_body_let(bytes, cursor, body_end) {
        let declaration_name: TokenInfo = scan_token_info(bytes, first.end, body_end)
        let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end)
        let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end)
        let declaration_equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end)
        let expression_end: UIntSize = stage2_find_expression_semicolon(bytes, declaration_equals.end, body_end)
        let expression_tail: TokenInfo = scan_token_info(bytes, expression_end, body_end)
        let expression_first: TokenInfo = scan_token_info(bytes, declaration_equals.end, expression_end)
        let expression_last: TokenInfo = stage2_last_expression_token(bytes, declaration_equals.end, expression_end)
        let expression_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, declaration_equals.end, expression_end)
        return Stage2TypedWhileDynamicBodySpan {
            valid: true,
            kind: 1u8,
            start: first.start,
            end: expression_tail.end,
            target_start: declaration_name.start,
            target_end: declaration_name.end,
            expression_left_start: expression_first.start,
            expression_left_end: expression_first.end,
            expression_middle_start: 0usize,
            expression_middle_end: 0usize,
            expression_middle_kind: 0u8,
            expression_right_start: expression_last.start,
            expression_right_end: expression_last.end,
            expression_right_kind: expression_last.kind,
            expression_node_count: expression_node_count,
            next_cursor: expression_tail.end,
        }
    }

    // A dynamic while body may introduce an iteration-local Int32 binding.
    // Keep the declaration span explicit so Stage-2 can allocate its storage
    // and expose it to subsequent body expressions without widening the
    // physical statement header ABI. Internal kind 3 denotes `var`; the
    // producer maps it to the existing LET+MUTABLE header combination.
    if first.kind == 1u8 {
        if first.end - first.start == 3usize {
            let is_var_keyword: Bool = if bytes[first.start] == 0x76u8 {
                if bytes[first.start + 1usize] == 0x61u8 {
                    if bytes[first.start + 2usize] == 0x72u8 { true } else { false }
                } else { false }
            } else { false }
            if is_var_keyword {
                let declaration_name: TokenInfo = scan_token_info(bytes, first.end, body_end)
                let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end)
                let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end)
                let declaration_equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end)
                let expression_end: UIntSize = stage2_find_expression_semicolon(bytes, declaration_equals.end, body_end)
                let expression_tail: TokenInfo = scan_token_info(bytes, expression_end, body_end)
                if declaration_name.kind == 1u8 {
                    if colon.kind == 3u8 {
                        if bytes[colon.start] == 0x3Au8 {
                            if type_name.kind == 1u8 {
                                if stage2_is_int32_name(bytes, type_name.start, type_name.end) {
                                    if declaration_equals.kind == 3u8 {
                                        if bytes[declaration_equals.start] == 0x3Du8 {
                                            if expression_end > declaration_equals.end {
                                                if expression_tail.kind == 3u8 {
                                                    if bytes[expression_tail.start] == 0x3Bu8 {
                                                        let expression_first: TokenInfo = scan_token_info(bytes, declaration_equals.end, expression_end)
                                                        let expression_last: TokenInfo = stage2_last_expression_token(bytes, declaration_equals.end, expression_end)
                                                        let expression_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, declaration_equals.end, expression_end)
                                                        if expression_first.start < expression_end {
                                                            if expression_last.start < expression_end {
                                                                if expression_node_count > 0usize {
                                                                    return Stage2TypedWhileDynamicBodySpan {
                                                                        valid: true,
                                                                        kind: 3u8,
                                                                        start: first.start,
                                                                        end: expression_tail.end,
                                                                        target_start: declaration_name.start,
                                                                        target_end: declaration_name.end,
                                                                        expression_left_start: expression_first.start,
                                                                        expression_left_end: expression_first.end,
                                                                        expression_middle_start: 0usize,
                                                                        expression_middle_end: 0usize,
                                                                        expression_middle_kind: 0u8,
                                                                        expression_right_start: expression_last.start,
                                                                        expression_right_end: expression_last.end,
                                                                        expression_right_kind: expression_last.kind,
                                                                        expression_node_count: expression_node_count,
                                                                        next_cursor: expression_tail.end,
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Keep the original immutable `let` declaration path byte-for-byte
    // compatible with the existing dynamic body-let captures.  Mutable `var`
    // is handled by the additive branch above and is lowered to LET+MUTABLE.
    if first.kind == 1u8 {
        if first.end - first.start == 3usize {
            if bytes[first.start] == 0x6Cu8 {
                if bytes[first.start + 1usize] == 0x65u8 {
                    if bytes[first.start + 2usize] == 0x74u8 {
                        let declaration_name: TokenInfo = scan_token_info(bytes, first.end, body_end)
                        let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end)
                        let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end)
                        let declaration_equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end)
                        let expression_end: UIntSize = stage2_find_expression_semicolon(bytes, declaration_equals.end, body_end)
                        let expression_tail: TokenInfo = scan_token_info(bytes, expression_end, body_end)
                        if declaration_name.kind == 1u8 {
                            if colon.kind == 3u8 {
                                if bytes[colon.start] == 0x3Au8 {
                                    if type_name.kind == 1u8 {
                                        if stage2_is_int32_name(bytes, type_name.start, type_name.end) {
                                            if declaration_equals.kind == 3u8 {
                                                if bytes[declaration_equals.start] == 0x3Du8 {
                                                    if expression_end > declaration_equals.end {
                                                        if expression_tail.kind == 3u8 {
                                                            if bytes[expression_tail.start] == 0x3Bu8 {
                                                                let expression_first: TokenInfo = scan_token_info(bytes, declaration_equals.end, expression_end)
                                                                let expression_last: TokenInfo = stage2_last_expression_token(bytes, declaration_equals.end, expression_end)
                                                                let expression_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, declaration_equals.end, expression_end)
                                                                if expression_first.start < expression_end {
                                                                    if expression_last.start < expression_end {
                                                                        if expression_node_count > 0usize {
                                                                            return Stage2TypedWhileDynamicBodySpan {
                                                                                valid: true,
                                                                                kind: 1u8,
                                                                                start: first.start,
                                                                                end: expression_tail.end,
                                                                                target_start: declaration_name.start,
                                                                                target_end: declaration_name.end,
                                                                                expression_left_start: expression_first.start,
                                                                                expression_left_end: expression_first.end,
                                                                                expression_middle_start: 0usize,
                                                                                expression_middle_end: 0usize,
                                                                                expression_middle_kind: 0u8,
                                                                                expression_right_start: expression_last.start,
                                                                                expression_right_end: expression_last.end,
                                                                                expression_right_kind: expression_last.kind,
                                                                                expression_node_count: expression_node_count,
                                                                                next_cursor: expression_tail.end,
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let equals: TokenInfo = scan_token_info(bytes, first.end, body_end)
    if first.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }

    // Prefer the generic AST path before the historical three-operator group
    // recognizers.  This lets deeply grouped arithmetic use the generic
    // post-order parser instead of being rejected by a narrow compatibility
    // branch once it grows past that legacy shape.
    let early_generic_expression_end: UIntSize = stage2_find_expression_semicolon(bytes, equals.end, body_end)
    if early_generic_expression_end > equals.end {
        let early_generic_first: TokenInfo = scan_token_info(bytes, equals.end, early_generic_expression_end)
        let early_generic_last: TokenInfo = stage2_last_expression_token(bytes, equals.end, early_generic_expression_end)
        let early_generic_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, equals.end, early_generic_expression_end)
        let early_generic_tail: TokenInfo = scan_token_info(bytes, early_generic_expression_end, body_end)
        if early_generic_first.kind != 0u8 {
            if early_generic_node_count > 7usize {
                if early_generic_tail.kind == 3u8 {
                    if bytes[early_generic_tail.start] == 0x3Bu8 {
                        if stage2_same_ascii(bytes, first.start, first.end, early_generic_first.start, early_generic_first.end) {
                            return Stage2TypedWhileDynamicBodySpan {
                                valid: true,
                                kind: 2u8,
                                start: first.start,
                                end: early_generic_tail.end,
                                target_start: first.start,
                                target_end: first.end,
                                expression_left_start: early_generic_first.start,
                                expression_left_end: early_generic_first.end,
                                expression_middle_start: 0usize,
                                expression_middle_end: 0usize,
                                expression_middle_kind: 0u8,
                                expression_right_start: early_generic_last.start,
                                expression_right_end: early_generic_last.end,
                                expression_right_kind: early_generic_last.kind,
                                expression_node_count: early_generic_node_count,
                                next_cursor: early_generic_tail.end,
                            }
                        }
                    }
                }
            }
        }
    }

    let two_group_first_open: TokenInfo = scan_token_info(bytes, equals.end, body_end)
    if stage2_has_nested_left_group_shape(bytes, equals.end, body_end) {
        let nested_outer_open: TokenInfo = scan_token_info(bytes, equals.end, body_end)
        let nested_inner_open: TokenInfo = scan_token_info(bytes, nested_outer_open.end, body_end)
        let nested_left: TokenInfo = scan_token_info(bytes, nested_inner_open.end, body_end)
        let nested_inner_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_left.end, body_end)
        let nested_inner_right: TokenInfo = scan_token_info(bytes, nested_inner_operator.end, body_end)
        let nested_inner_close: TokenInfo = scan_token_info(bytes, nested_inner_right.end, body_end)
        let nested_outer_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_inner_close.end, body_end)
        let nested_outer_right: TokenInfo = scan_token_info(bytes, nested_outer_operator.end, body_end)
        let nested_outer_close: TokenInfo = scan_token_info(bytes, nested_outer_right.end, body_end)
        let nested_final_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_outer_close.end, body_end)
        let nested_final_right: TokenInfo = scan_token_info(bytes, nested_final_operator.end, body_end)
        let nested_tail: TokenInfo = scan_token_info(bytes, nested_final_right.end, body_end)
        if nested_left.kind != 1u8 { if nested_left.kind != 2u8 { return invalid } }
        if nested_inner_right.kind != 1u8 { if nested_inner_right.kind != 2u8 { return invalid } }
        if nested_outer_right.kind != 1u8 { if nested_outer_right.kind != 2u8 { return invalid } }
        if nested_final_right.kind != 1u8 { if nested_final_right.kind != 2u8 { return invalid } }
        if nested_inner_operator.kind != 3u8 { return invalid }
        if nested_outer_operator.kind != 3u8 { return invalid }
        if nested_final_operator.kind != 3u8 { return invalid }
        if bytes[nested_inner_operator.start] != 0x2Bu8 {
            if bytes[nested_inner_operator.start] != 0x2Du8 {
                if bytes[nested_inner_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if bytes[nested_outer_operator.start] != 0x2Bu8 {
            if bytes[nested_outer_operator.start] != 0x2Du8 {
                if bytes[nested_outer_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if bytes[nested_final_operator.start] != 0x2Bu8 {
            if bytes[nested_final_operator.start] != 0x2Du8 {
                if bytes[nested_final_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if nested_inner_close.kind != 3u8 { return invalid }
        if bytes[nested_inner_close.start] != 0x29u8 { return invalid }
        if nested_outer_close.kind != 3u8 { return invalid }
        if bytes[nested_outer_close.start] != 0x29u8 { return invalid }
        if nested_tail.kind != 3u8 { return invalid }
        if bytes[nested_tail.start] != 0x3Bu8 { return invalid }
        if nested_left.kind == 1u8 { if !stage2_same_ascii(bytes, first.start, first.end, nested_left.start, nested_left.end) { return invalid } }
        return Stage2TypedWhileDynamicBodySpan {
            valid: true,
            kind: 2u8,
            start: first.start,
            end: nested_tail.end,
            target_start: first.start,
            target_end: first.end,
            expression_left_start: nested_outer_open.start,
            expression_left_end: nested_outer_open.end,
            expression_middle_start: 0usize,
            expression_middle_end: 0usize,
            expression_middle_kind: 0u8,
            expression_right_start: nested_final_right.start,
            expression_right_end: nested_final_right.end,
            expression_right_kind: if nested_final_right.kind == 1u8 { 1u8 } else { 2u8 },
            expression_node_count: 7usize,
            next_cursor: nested_tail.end,
        }
    }
    // Fall back to the generic expression parser for any scalar arithmetic
    // shape not covered by the historical compatibility branches.  The
    // parser pass only needs the node count; the typed emitter performs the
    // full caller-owned AST hand-off in the second pass.
    let generic_expression_end: UIntSize = stage2_find_expression_semicolon(bytes, equals.end, body_end)
    if generic_expression_end > equals.end {
        let generic_first: TokenInfo = scan_token_info(bytes, equals.end, generic_expression_end)
        let generic_last: TokenInfo = stage2_last_expression_token(bytes, equals.end, generic_expression_end)
        let generic_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, equals.end, generic_expression_end)
        let generic_tail: TokenInfo = scan_token_info(bytes, generic_expression_end, body_end)
        if generic_first.kind != 0u8 {
            if generic_node_count > 7usize {
                if !stage2_has_two_group_shape(bytes, equals.end, body_end) {
                if generic_tail.kind == 3u8 {
                    if bytes[generic_tail.start] == 0x3Bu8 {
                        if stage2_same_ascii(bytes, first.start, first.end, generic_first.start, generic_first.end) {
                            return Stage2TypedWhileDynamicBodySpan {
                                valid: true,
                                kind: 2u8,
                                start: first.start,
                                end: generic_tail.end,
                                target_start: first.start,
                                target_end: first.end,
                                expression_left_start: generic_first.start,
                                expression_left_end: generic_first.end,
                                expression_middle_start: 0usize,
                                expression_middle_end: 0usize,
                                expression_middle_kind: 0u8,
                                expression_right_start: generic_last.start,
                                 expression_right_end: generic_last.end,
                                expression_right_kind: generic_last.kind,
                                expression_node_count: generic_node_count,
                                next_cursor: generic_tail.end,
                            }
                        }
                    }
                }
                }
            }
        }
    }
    if stage2_has_two_group_shape(bytes, equals.end, body_end) {
            let two_group_first_left: TokenInfo = scan_token_info(bytes, two_group_first_open.end, body_end)
            let two_group_first_operator: TokenInfo = scan_stage2_operator_info(bytes, two_group_first_left.end, body_end)
            let two_group_first_right: TokenInfo = scan_token_info(bytes, two_group_first_operator.end, body_end)
            let two_group_first_close: TokenInfo = scan_token_info(bytes, two_group_first_right.end, body_end)
            let two_group_outer_operator: TokenInfo = scan_stage2_operator_info(bytes, two_group_first_close.end, body_end)
            let two_group_second_open: TokenInfo = scan_token_info(bytes, two_group_outer_operator.end, body_end)
            let two_group_second_left: TokenInfo = scan_token_info(bytes, two_group_second_open.end, body_end)
            let two_group_second_operator: TokenInfo = scan_stage2_operator_info(bytes, two_group_second_left.end, body_end)
            let two_group_second_right: TokenInfo = scan_token_info(bytes, two_group_second_operator.end, body_end)
            let two_group_second_close: TokenInfo = scan_token_info(bytes, two_group_second_right.end, body_end)
            let tail: TokenInfo = scan_token_info(bytes, two_group_second_close.end, body_end)
                    if two_group_first_left.kind != 1u8 { if two_group_first_left.kind != 2u8 { return invalid } }
                    if two_group_first_right.kind != 1u8 { if two_group_first_right.kind != 2u8 { return invalid } }
                    if two_group_second_left.kind != 1u8 { if two_group_second_left.kind != 2u8 { return invalid } }
                    if two_group_second_right.kind != 1u8 { if two_group_second_right.kind != 2u8 { return invalid } }
                    if two_group_first_operator.kind != 3u8 { return invalid }
                    if two_group_outer_operator.kind != 3u8 { return invalid }
                    if two_group_second_operator.kind != 3u8 { return invalid }
                    if bytes[two_group_first_operator.start] != 0x2Bu8 {
                        if bytes[two_group_first_operator.start] != 0x2Du8 {
                            if bytes[two_group_first_operator.start] != 0x2Au8 { return invalid }
                        }
                    }
                    if bytes[two_group_outer_operator.start] != 0x2Bu8 {
                        if bytes[two_group_outer_operator.start] != 0x2Du8 {
                            if bytes[two_group_outer_operator.start] != 0x2Au8 { return invalid }
                        }
                    }
                    if bytes[two_group_second_operator.start] != 0x2Bu8 {
                        if bytes[two_group_second_operator.start] != 0x2Du8 {
                            if bytes[two_group_second_operator.start] != 0x2Au8 { return invalid }
                        }
                    }
                    if two_group_first_close.kind != 3u8 { return invalid }
                    if bytes[two_group_first_close.start] != 0x29u8 { return invalid }
                    if two_group_second_close.kind != 3u8 { return invalid }
                    if bytes[two_group_second_close.start] != 0x29u8 { return invalid }
                    if tail.kind != 3u8 { return invalid }
                    if bytes[tail.start] != 0x3Bu8 { return invalid }
                    if !stage2_same_ascii(bytes, first.start, first.end, two_group_first_left.start, two_group_first_left.end) { return invalid }
                    return Stage2TypedWhileDynamicBodySpan {
                        valid: true,
                        kind: 2u8,
                        start: first.start,
                        end: tail.end,
                        target_start: first.start,
                        target_end: first.end,
                        expression_left_start: two_group_first_open.start,
                        expression_left_end: two_group_first_open.end,
                        expression_middle_start: 0usize,
                        expression_middle_end: 0usize,
                        expression_middle_kind: 0u8,
                        expression_right_start: two_group_second_open.start,
                        expression_right_end: two_group_second_close.end,
                        expression_right_kind: 7u8,
                        expression_node_count: 7usize,
                        next_cursor: tail.end,
                    }
    }

    let grouped_open: TokenInfo = scan_token_info(bytes, equals.end, body_end)
    if grouped_open.kind == 3u8 {
        if bytes[grouped_open.start] == 0x28u8 {
            let grouped_left: TokenInfo = scan_token_info(bytes, grouped_open.end, body_end)
            let grouped_operator: TokenInfo = scan_stage2_operator_info(bytes, grouped_left.end, body_end)
            let grouped_right: TokenInfo = scan_token_info(bytes, grouped_operator.end, body_end)
            let grouped_close: TokenInfo = scan_token_info(bytes, grouped_right.end, body_end)
            let outer_operator: TokenInfo = scan_stage2_operator_info(bytes, grouped_close.end, body_end)
            let outer_right: TokenInfo = scan_token_info(bytes, outer_operator.end, body_end)
            let tail: TokenInfo = scan_token_info(bytes, outer_right.end, body_end)
            if grouped_left.kind != 1u8 { if grouped_left.kind != 2u8 { return invalid } }
            if grouped_right.kind != 1u8 { if grouped_right.kind != 2u8 { return invalid } }
            if outer_right.kind != 1u8 { if outer_right.kind != 2u8 { return invalid } }
            if grouped_operator.kind != 3u8 { return invalid }
            if outer_operator.kind != 3u8 { return invalid }
            if bytes[grouped_operator.start] != 0x2Bu8 {
                if bytes[grouped_operator.start] != 0x2Du8 {
                    if bytes[grouped_operator.start] != 0x2Au8 { return invalid }
                }
            }
            if bytes[outer_operator.start] != 0x2Bu8 {
                if bytes[outer_operator.start] != 0x2Du8 {
                    if bytes[outer_operator.start] != 0x2Au8 { return invalid }
                }
            }
            if grouped_close.kind != 3u8 { return invalid }
            if bytes[grouped_close.start] != 0x29u8 { return invalid }
            if tail.kind != 3u8 { return invalid }
            if bytes[tail.start] != 0x3Bu8 { return invalid }
            if grouped_left.kind == 1u8 { if !stage2_same_ascii(bytes, first.start, first.end, grouped_left.start, grouped_left.end) { return invalid } }
            return Stage2TypedWhileDynamicBodySpan {
                valid: true,
                kind: 2u8,
                start: first.start,
                end: tail.end,
                target_start: first.start,
                target_end: first.end,
                expression_left_start: grouped_open.start,
                expression_left_end: grouped_open.end,
                expression_middle_start: 0usize,
                expression_middle_end: 0usize,
                expression_middle_kind: 0u8,
                expression_right_start: outer_right.start,
                expression_right_end: outer_right.end,
                expression_right_kind: if outer_right.kind == 1u8 { 1u8 } else { 2u8 },
                expression_node_count: 5usize,
                next_cursor: tail.end,
            }
        }
    }

    let right_group_left: TokenInfo = scan_token_info(bytes, equals.end, body_end)
    let right_group_outer_operator: TokenInfo = scan_stage2_operator_info(bytes, right_group_left.end, body_end)
    let right_group_open: TokenInfo = scan_token_info(bytes, right_group_outer_operator.end, body_end)
    if right_group_open.kind == 3u8 {
        if bytes[right_group_open.start] == 0x28u8 {
            let right_group_inner_left: TokenInfo = scan_token_info(bytes, right_group_open.end, body_end)
            let right_group_inner_operator: TokenInfo = scan_stage2_operator_info(bytes, right_group_inner_left.end, body_end)
            let right_group_inner_right: TokenInfo = scan_token_info(bytes, right_group_inner_operator.end, body_end)
            let right_group_close: TokenInfo = scan_token_info(bytes, right_group_inner_right.end, body_end)
            let tail: TokenInfo = scan_token_info(bytes, right_group_close.end, body_end)
            if right_group_left.kind != 1u8 { if right_group_left.kind != 2u8 { return invalid } }
            if right_group_inner_left.kind != 1u8 { if right_group_inner_left.kind != 2u8 { return invalid } }
            if right_group_inner_right.kind != 1u8 { if right_group_inner_right.kind != 2u8 { return invalid } }
            if right_group_outer_operator.kind != 3u8 { return invalid }
            if right_group_inner_operator.kind != 3u8 { return invalid }
            if bytes[right_group_outer_operator.start] != 0x2Bu8 {
                if bytes[right_group_outer_operator.start] != 0x2Du8 {
                    if bytes[right_group_outer_operator.start] != 0x2Au8 { return invalid }
                }
            }
            if bytes[right_group_inner_operator.start] != 0x2Bu8 {
                if bytes[right_group_inner_operator.start] != 0x2Du8 {
                    if bytes[right_group_inner_operator.start] != 0x2Au8 { return invalid }
                }
            }
            if right_group_close.kind != 3u8 { return invalid }
            if bytes[right_group_close.start] != 0x29u8 { return invalid }
            if tail.kind != 3u8 { return invalid }
            if bytes[tail.start] != 0x3Bu8 { return invalid }
            if !stage2_same_ascii(bytes, first.start, first.end, right_group_left.start, right_group_left.end) { return invalid }
            return Stage2TypedWhileDynamicBodySpan {
                valid: true,
                kind: 2u8,
                start: first.start,
                end: tail.end,
                target_start: first.start,
                target_end: first.end,
                expression_left_start: right_group_left.start,
                expression_left_end: right_group_left.end,
                expression_middle_start: 0usize,
                expression_middle_end: 0usize,
                expression_middle_kind: 0u8,
                expression_right_start: right_group_open.start,
                expression_right_end: right_group_close.end,
                expression_right_kind: 7u8,
                expression_node_count: 5usize,
                next_cursor: tail.end,
            }
        }
    }
    var operand_starts: [UIntSize; 4] = [0usize, 0usize, 0usize, 0usize]
    var operand_ends: [UIntSize; 4] = [0usize, 0usize, 0usize, 0usize]
    var operand_kinds: [UInt8; 4] = [0u8, 0u8, 0u8, 0u8]
    var operand_count: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var expression_cursor: UIntSize = equals.end
    var next_cursor: UIntSize = 0usize
    var expression_valid: Bool = true
    while expression_cursor < body_end {
        let operand: TokenInfo = scan_token_info(bytes, expression_cursor, body_end)
        if operand.start >= body_end { expression_valid = false; break }
        if operand.kind != 1u8 {
            if operand.kind != 2u8 { expression_valid = false; break }
        }
        if operand_count >= 4usize { expression_valid = false; break }
        if operand_count == 0usize {
            if operand.kind != 1u8 { expression_valid = false; break }
            if !stage2_same_ascii(bytes, first.start, first.end, operand.start, operand.end) { expression_valid = false; break }
        }
        operand_starts[operand_count] = operand.start
        operand_ends[operand_count] = operand.end
        operand_kinds[operand_count] = if operand.kind == 1u8 { 1u8 } else { 2u8 }
        operand_count = operand_count + 1usize
        let separator: TokenInfo = scan_token_info(bytes, operand.end, body_end)
        if separator.start >= body_end { expression_valid = false; break }
        if separator.kind == 3u8 {
            if bytes[separator.start] == 0x3Bu8 {
                next_cursor = separator.end
                break
            }
        }
        if separator.kind != 3u8 { expression_valid = false; break }
        if bytes[separator.start] != 0x2Bu8 {
            if bytes[separator.start] != 0x2Du8 {
                if bytes[separator.start] != 0x2Au8 { expression_valid = false; break }
            }
        }
        operator_count = operator_count + 1usize
        if operator_count >= 4usize { expression_valid = false; break }
        expression_cursor = separator.end
    }
    if !expression_valid { return invalid }
    if next_cursor == 0usize { return invalid }
    if operand_count < 2usize { return invalid }
    if operator_count + 1usize != operand_count { return invalid }
    var expression_middle_start: UIntSize = 0usize
    var expression_middle_end: UIntSize = 0usize
    var expression_middle_kind: UInt8 = 0u8
    if operand_count > 2usize {
        expression_middle_start = operand_starts[2]
        expression_middle_end = operand_ends[2]
        expression_middle_kind = operand_kinds[2]
    }
    let expression_right_start: UIntSize = operand_starts[operand_count - 1usize]
    let expression_right_end: UIntSize = operand_ends[operand_count - 1usize]
    let expression_right_kind: UInt8 = operand_kinds[operand_count - 1usize]
    let expression_node_count: UIntSize = operand_count + operator_count
    return Stage2TypedWhileDynamicBodySpan {
        valid: true,
        kind: 2u8,
        start: first.start,
        end: next_cursor,
        target_start: first.start,
        target_end: first.end,
        expression_left_start: operand_starts[0],
        expression_left_end: operand_ends[0],
        expression_middle_start: expression_middle_start,
        expression_middle_end: expression_middle_end,
        expression_middle_kind: expression_middle_kind,
        expression_right_start: expression_right_start,
        expression_right_end: expression_right_end,
        expression_right_kind: expression_right_kind,
        expression_node_count: expression_node_count,
        next_cursor: next_cursor,
    }
}

// Nested outer tails may read the inner local after the inner loop exits.
// Keep the ordinary dynamic parser strict for one-local loops and admit this
// one additional, explicitly named RHS in the nested contract.
fn stage2_parse_typed_nested_outer_tail_span(
    bytes: read Slice<UInt8>,
    cursor: UIntSize,
    body_end: UIntSize,
    outer_start: UIntSize,
    outer_end: UIntSize,
    inner_start: UIntSize,
    inner_end: UIntSize,
) -> Stage2TypedWhileDynamicBodySpan {
    let invalid: Stage2TypedWhileDynamicBodySpan = Stage2TypedWhileDynamicBodySpan {
        valid: false,
        kind: 0u8,
        start: 0usize,
        end: 0usize,
        target_start: 0usize,
        target_end: 0usize,
        expression_left_start: 0usize,
        expression_left_end: 0usize,
        expression_middle_start: 0usize,
        expression_middle_end: 0usize,
        expression_middle_kind: 0u8,
        expression_right_start: 0usize,
        expression_right_end: 0usize,
        expression_right_kind: 0u8,
        expression_node_count: 0usize,
        next_cursor: 0usize,
    }
    let target: TokenInfo = scan_token_info(bytes, cursor, body_end)
    let equals: TokenInfo = scan_token_info(bytes, target.end, body_end)
    let use: TokenInfo = scan_token_info(bytes, equals.end, body_end)
    let operator: TokenInfo = scan_token_info(bytes, use.end, body_end)
    let right: TokenInfo = scan_token_info(bytes, operator.end, body_end)
    let tail: TokenInfo = scan_token_info(bytes, right.end, body_end)
    if target.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, outer_start, outer_end, target.start, target.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if use.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, outer_start, outer_end, use.start, use.end) { return invalid }
    if operator.kind != 3u8 { return invalid }
    if bytes[operator.start] != 0x2Bu8 { return invalid }
    var right_kind: UInt8 = 0u8
    if right.kind == 2u8 { right_kind = 2u8 }
    if right.kind == 1u8 {
        if stage2_same_ascii(bytes, inner_start, inner_end, right.start, right.end) { right_kind = 1u8 }
        if stage2_same_ascii(bytes, outer_start, outer_end, right.start, right.end) { right_kind = 1u8 }
    }
    if right_kind == 0u8 { return invalid }
    if tail.kind != 3u8 { return invalid }
    if bytes[tail.start] != 0x3Bu8 { return invalid }
    return Stage2TypedWhileDynamicBodySpan {
        valid: true,
        kind: 2u8,
        start: target.start,
        end: tail.end,
        target_start: target.start,
        target_end: target.end,
        expression_left_start: use.start,
        expression_left_end: use.end,
        expression_middle_start: 0usize,
        expression_middle_end: 0usize,
        expression_middle_kind: 0u8,
        expression_right_start: right.start,
        expression_right_end: right.end,
        expression_right_kind: right_kind,
        expression_node_count: 3usize,
        next_cursor: tail.end,
    }
}

fn stage2_probe_typed_nested_assignment(
    bytes: read Slice<UInt8>,
    cursor: UIntSize,
    body_end: UIntSize,
    name_start: UIntSize,
    name_end: UIntSize,
) -> UIntSize {
    let target: TokenInfo = scan_token_info(bytes, cursor, body_end)
    let equals: TokenInfo = scan_token_info(bytes, target.end, body_end)
    let use: TokenInfo = scan_token_info(bytes, equals.end, body_end)
    let operator: TokenInfo = scan_token_info(bytes, use.end, body_end)
    let right: TokenInfo = scan_token_info(bytes, operator.end, body_end)
    let tail: TokenInfo = scan_token_info(bytes, right.end, body_end)
    if target.kind != 1u8 { return 100000usize + target.start }
    if !stage2_same_ascii(bytes, name_start, name_end, target.start, target.end) { return 2usize }
    if equals.kind != 3u8 { return 3usize }
    if bytes[equals.start] != 0x3Du8 { return 4usize }
    if use.kind != 1u8 { return 5usize }
    if !stage2_same_ascii(bytes, name_start, name_end, use.start, use.end) { return 6usize }
    if operator.kind != 3u8 { return 7usize }
    if bytes[operator.start] != 0x2Bu8 {
        if bytes[operator.start] != 0x2Du8 {
            if bytes[operator.start] != 0x2Au8 { return 8usize }
        }
    }
    if right.kind != 1u8 { if right.kind != 2u8 { return 9usize } }
    if right.kind == 1u8 { if !stage2_same_ascii(bytes, name_start, name_end, right.start, right.end) { return 10usize } }
    if tail.kind != 3u8 { return 11usize }
    if bytes[tail.start] != 0x3Bu8 { return 12usize }
    return 0usize
}

fn stage2_parse_typed_while_dynamic_control_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedWhileDynamicSpans {
    let invalid: Stage2TypedWhileDynamicSpans = Stage2TypedWhileDynamicSpans {
        valid: false,
        body_count: 0usize,
        ast_nodes_required: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        while_start: 0usize,
        while_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        loop_body_start: 0usize,
        loop_body_end: 0usize,
        body_start: 0usize,
        body_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let var_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let declaration_name: TokenInfo = scan_token_info(bytes, var_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    let while_token: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, while_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let loop_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    if var_token.kind != 1u8 { return invalid }
    if var_token.end - var_token.start != 3usize { return invalid }
    if bytes[var_token.start] != 0x76u8 { return invalid }
    if bytes[var_token.start + 1usize] != 0x61u8 { return invalid }
    if bytes[var_token.start + 2usize] != 0x72u8 { return invalid }
    if declaration_name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if while_token.kind != 1u8 { return invalid }
    if while_token.end - while_token.start != 5usize { return invalid }
    if bytes[while_token.start] != 0x77u8 { return invalid }
    if bytes[while_token.start + 1usize] != 0x68u8 { return invalid }
    if bytes[while_token.start + 2usize] != 0x69u8 { return invalid }
    if bytes[while_token.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[while_token.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, condition_left.start, condition_left.end) { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Cu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if loop_open.kind != 3u8 { return invalid }
    if bytes[loop_open.start] != 0x7Bu8 { return invalid }
    var cursor: UIntSize = loop_open.end
    var statement_count: UIntSize = 0usize
    var assignment_count: UIntSize = 0usize
    var conditional_count: UIntSize = 0usize
    var ast_nodes_required: UIntSize = 5usize
    var first_start: UIntSize = 0usize
    var last_end: UIntSize = 0usize
    var loop_close: TokenInfo = TokenInfo { kind: 0u8, start: 0usize, end: 0usize }
    var body_valid: Bool = true
    while cursor < body_end_exclusive {
        let next: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
        if next.start >= body_end_exclusive { body_valid = false; break }
        if next.kind == 3u8 {
            if bytes[next.start] == 0x7Du8 {
                let next_end: UIntSize = next.end
                loop_close = next
                cursor = next_end
                break
            }
        }
        if statement_count == 0usize {
            if stage2_validate_dynamic_body_let(bytes, cursor, body_end_exclusive) {
                let let_token: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
                let let_name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
                let let_colon: TokenInfo = scan_token_info(bytes, let_name.end, body_end_exclusive)
                let let_type: TokenInfo = scan_token_info(bytes, let_colon.end, body_end_exclusive)
                let let_equals: TokenInfo = scan_token_info(bytes, let_type.end, body_end_exclusive)
                let let_expression_end: UIntSize = stage2_find_expression_semicolon(bytes, let_equals.end, body_end_exclusive)
                let let_tail: TokenInfo = scan_token_info(bytes, let_expression_end, body_end_exclusive)
                if let_tail.kind != 3u8 { body_valid = false; break }
                if bytes[let_tail.start] != 0x3Bu8 { body_valid = false; break }
                let let_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, let_equals.end, let_expression_end)
                if let_node_count == 0usize { body_valid = false; break }
                ast_nodes_required = ast_nodes_required + let_node_count
                first_start = cursor
                last_end = let_tail.end
                statement_count = statement_count + 1usize
                cursor = let_tail.end
                continue
            }
        }
        var statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, body_end_exclusive, declaration_name.start, declaration_name.end)
        if !statement.valid {
            statement = stage2_parse_dynamic_assignment_direct(bytes, cursor, body_end_exclusive, declaration_name.start, declaration_name.end)
        }
        if !statement.valid { body_valid = false; break }
        ast_nodes_required = ast_nodes_required + statement.expression_node_count
        if statement_count == 0usize { first_start = statement.start }
        last_end = statement.end
        statement_count = statement_count + 1usize
        if statement.kind == 2u8 { assignment_count = assignment_count + 1usize }
        if statement.kind == 3u8 { assignment_count = assignment_count + 1usize }
        if statement.kind == 4u8 { conditional_count = conditional_count + 1usize }
        if statement.kind == 5u8 { conditional_count = conditional_count + 1usize }
        if statement_count > 4096usize { body_valid = false; break }
        cursor = statement.next_cursor
    }
    if !body_valid { return invalid }
    if statement_count == 0usize { return invalid }
    if assignment_count == 0usize { return invalid }
    if conditional_count == 0usize { return invalid }
    if loop_close.kind != 3u8 { return invalid }
    let return_keyword: TokenInfo = scan_token_info(bytes, loop_close.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedWhileDynamicSpans {
        valid: true,
        body_count: statement_count,
        ast_nodes_required: ast_nodes_required,
        declaration_start: declaration_name.start,
        declaration_end: declaration_name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        while_start: while_token.start,
        while_end: loop_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        loop_body_start: loop_open.end,
        loop_body_end: loop_close.start,
        body_start: first_start,
        body_end: last_end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

    // Validates the bounded immutable body-local declaration shape without
    // allocating; the caller then emits the same span into the typed ABI.
@noalloc
fn stage2_validate_dynamic_body_let(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Bool {
    let first: TokenInfo = scan_token_info(bytes, start, end)
    if first.kind != 1u8 { return false }
    if first.end - first.start != 3usize { return false }
    if bytes[first.start] != 0x6Cu8 { return false }
    if bytes[first.start + 1usize] != 0x65u8 { return false }
    if bytes[first.start + 2usize] != 0x74u8 { return false }
    let declaration_name: TokenInfo = scan_token_info(bytes, first.end, end)
    if declaration_name.kind != 1u8 { return false }
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, end)
    if colon.kind != 3u8 { return false }
    if bytes[colon.start] != 0x3Au8 { return false }
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, end)
    if type_name.kind != 1u8 { return false }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return false }
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, end)
    if equals.kind != 3u8 { return false }
    if bytes[equals.start] != 0x3Du8 { return false }
    let expression_end: UIntSize = stage2_find_expression_semicolon(bytes, equals.end, end)
    if expression_end <= equals.end { return false }
    let tail: TokenInfo = scan_token_info(bytes, expression_end, end)
    if tail.kind != 3u8 { return false }
    if bytes[tail.start] != 0x3Bu8 { return false }
    let expression_first: TokenInfo = scan_token_info(bytes, equals.end, expression_end)
    if expression_first.start >= expression_end { return false }
    let expression_last: TokenInfo = stage2_last_expression_token(bytes, equals.end, expression_end)
    if expression_last.start >= expression_end { return false }
    let generic_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, equals.end, expression_end)
    let direct_call_node_count: UIntSize = stage2_count_dynamic_direct_call_expression(bytes, equals.end, expression_end)
    let node_count: UIntSize = if direct_call_node_count > 0usize { direct_call_node_count } else { generic_node_count }
    if node_count == 0usize { return false }
    return true
}

@noalloc
fn stage2_parse_dynamic_assignment_direct(
    bytes: read Slice<UInt8>,
    cursor: UIntSize,
    body_end: UIntSize,
    name_start: UIntSize,
    name_end: UIntSize,
) -> Stage2TypedWhileDynamicBodySpan {
    let invalid: Stage2TypedWhileDynamicBodySpan = Stage2TypedWhileDynamicBodySpan {
        valid: false, kind: 0u8, start: 0usize, end: 0usize,
        target_start: 0usize, target_end: 0usize,
        expression_left_start: 0usize, expression_left_end: 0usize,
        expression_middle_start: 0usize, expression_middle_end: 0usize,
        expression_middle_kind: 0u8, expression_right_start: 0usize,
        expression_right_end: 0usize, expression_right_kind: 0u8,
        expression_node_count: 0usize, next_cursor: 0usize,
    }
    let target: TokenInfo = scan_token_info(bytes, cursor, body_end)
    let equals: TokenInfo = scan_token_info(bytes, target.end, body_end)
    let expression_end: UIntSize = stage2_find_expression_semicolon(bytes, equals.end, body_end)
    let tail: TokenInfo = scan_token_info(bytes, expression_end, body_end)
    if target.kind != 1u8 { return invalid }
    // The bounded dynamic body can assign either the enclosing loop local or
    // a mutable iteration-local declared earlier in the same body.  Keep the
    // target span caller-owned; the host/lowerer resolves the binding.
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if expression_end <= equals.end { return invalid }
    if tail.kind != 3u8 { return invalid }
    if bytes[tail.start] != 0x3Bu8 { return invalid }
    let first: TokenInfo = scan_token_info(bytes, equals.end, expression_end)
    let last: TokenInfo = stage2_last_expression_token(bytes, equals.end, expression_end)
    let generic_node_count: UIntSize = stage2_count_generic_int32_expression(bytes, equals.end, expression_end)
    let direct_call_node_count: UIntSize = stage2_count_dynamic_direct_call_expression(bytes, equals.end, expression_end)
    let node_count: UIntSize = if direct_call_node_count > 0usize { direct_call_node_count } else { generic_node_count }
    if first.start >= expression_end { return invalid }
    if last.start >= expression_end { return invalid }
    if node_count == 0usize { return invalid }
    return Stage2TypedWhileDynamicBodySpan {
        valid: true, kind: 2u8, start: target.start, end: tail.end,
        target_start: target.start, target_end: target.end,
        expression_left_start: first.start, expression_left_end: first.end,
        expression_middle_start: 0usize, expression_middle_end: 0usize,
        expression_middle_kind: 0u8, expression_right_start: last.start,
        expression_right_end: last.end, expression_right_kind: last.kind,
        expression_node_count: node_count, next_cursor: tail.end,
    }
}

/// Source spans for the first native nested-`while` hand-off. The producer
/// admits one outer Int32 loop, one mutable inner Int32 loop and ordered
/// assignment segments around the inner loop; Stage-2 owns the CFG lowering.
struct Stage2TypedNestedWhileSpans {
    valid: Bool,
    body_count: UIntSize,
    assignment_count: UIntSize,
    ast_nodes_required: UIntSize,
    conditional_control_count: UIntSize,
    first_control_kind: UInt8,
    first_control_start: UIntSize,
    first_control_end: UIntSize,
    first_control_condition_left_start: UIntSize,
    first_control_condition_left_end: UIntSize,
    first_control_condition_right_start: UIntSize,
    first_control_condition_right_end: UIntSize,
    second_control_kind: UInt8,
    second_control_start: UIntSize,
    second_control_end: UIntSize,
    second_control_condition_left_start: UIntSize,
    second_control_condition_left_end: UIntSize,
    second_control_condition_right_start: UIntSize,
    second_control_condition_right_end: UIntSize,
    outer_declaration_start: UIntSize,
    outer_declaration_end: UIntSize,
    outer_initializer_start: UIntSize,
    outer_initializer_end: UIntSize,
    outer_while_start: UIntSize,
    outer_while_end: UIntSize,
    outer_condition_left_start: UIntSize,
    outer_condition_left_end: UIntSize,
    outer_condition_right_start: UIntSize,
    outer_condition_right_end: UIntSize,
    outer_loop_body_start: UIntSize,
    outer_loop_body_end: UIntSize,
    inner_declaration_start: UIntSize,
    inner_declaration_end: UIntSize,
    inner_initializer_statement_start: UIntSize,
    inner_initializer_statement_end: UIntSize,
    inner_initializer_start: UIntSize,
    inner_initializer_end: UIntSize,
    inner_while_start: UIntSize,
    inner_while_end: UIntSize,
    inner_condition_left_start: UIntSize,
    inner_condition_left_end: UIntSize,
    inner_condition_right_start: UIntSize,
    inner_condition_right_end: UIntSize,
    inner_loop_body_start: UIntSize,
    inner_loop_body_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_nested_while_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedNestedWhileSpans {
    let invalid: Stage2TypedNestedWhileSpans = Stage2TypedNestedWhileSpans {
        valid: false,
        body_count: 0usize,
        assignment_count: 0usize,
        ast_nodes_required: 0usize,
        conditional_control_count: 0usize,
        first_control_kind: 0u8,
        first_control_start: 0usize,
        first_control_end: 0usize,
        first_control_condition_left_start: 0usize,
        first_control_condition_left_end: 0usize,
        first_control_condition_right_start: 0usize,
        first_control_condition_right_end: 0usize,
        second_control_kind: 0u8,
        second_control_start: 0usize,
        second_control_end: 0usize,
        second_control_condition_left_start: 0usize,
        second_control_condition_left_end: 0usize,
        second_control_condition_right_start: 0usize,
        second_control_condition_right_end: 0usize,
        outer_declaration_start: 0usize,
        outer_declaration_end: 0usize,
        outer_initializer_start: 0usize,
        outer_initializer_end: 0usize,
        outer_while_start: 0usize,
        outer_while_end: 0usize,
        outer_condition_left_start: 0usize,
        outer_condition_left_end: 0usize,
        outer_condition_right_start: 0usize,
        outer_condition_right_end: 0usize,
        outer_loop_body_start: 0usize,
        outer_loop_body_end: 0usize,
        inner_declaration_start: 0usize,
        inner_declaration_end: 0usize,
        inner_initializer_statement_start: 0usize,
        inner_initializer_statement_end: 0usize,
        inner_initializer_start: 0usize,
        inner_initializer_end: 0usize,
        inner_while_start: 0usize,
        inner_while_end: 0usize,
        inner_condition_left_start: 0usize,
        inner_condition_left_end: 0usize,
        inner_condition_right_start: 0usize,
        inner_condition_right_end: 0usize,
        inner_loop_body_start: 0usize,
        inner_loop_body_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let outer_var: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let outer_name: TokenInfo = scan_token_info(bytes, outer_var.end, body_end_exclusive)
    let outer_colon: TokenInfo = scan_token_info(bytes, outer_name.end, body_end_exclusive)
    let outer_type: TokenInfo = scan_token_info(bytes, outer_colon.end, body_end_exclusive)
    let outer_equals: TokenInfo = scan_token_info(bytes, outer_type.end, body_end_exclusive)
    let outer_initializer: TokenInfo = scan_token_info(bytes, outer_equals.end, body_end_exclusive)
    let outer_declaration_tail: TokenInfo = scan_token_info(bytes, outer_initializer.end, body_end_exclusive)
    let outer_while: TokenInfo = scan_token_info(bytes, outer_declaration_tail.end, body_end_exclusive)
    let outer_condition_left: TokenInfo = scan_token_info(bytes, outer_while.end, body_end_exclusive)
    let outer_condition_operator: TokenInfo = scan_token_info(bytes, outer_condition_left.end, body_end_exclusive)
    let outer_condition_right: TokenInfo = scan_token_info(bytes, outer_condition_operator.end, body_end_exclusive)
    let outer_open: TokenInfo = scan_token_info(bytes, outer_condition_right.end, body_end_exclusive)
    if outer_var.kind != 1u8 { return invalid }
    if outer_var.end - outer_var.start != 3usize { return invalid }
    if bytes[outer_var.start] != 0x76u8 { return invalid }
    if bytes[outer_var.start + 1usize] != 0x61u8 { return invalid }
    if bytes[outer_var.start + 2usize] != 0x72u8 { return invalid }
    if outer_name.kind != 1u8 { return invalid }
    if outer_colon.kind != 3u8 { return invalid }
    if bytes[outer_colon.start] != 0x3Au8 { return invalid }
    if outer_type.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, outer_type.start, outer_type.end) { return invalid }
    if outer_equals.kind != 3u8 { return invalid }
    if bytes[outer_equals.start] != 0x3Du8 { return invalid }
    if outer_initializer.kind != 2u8 { return invalid }
    if outer_declaration_tail.kind != 3u8 { return invalid }
    if bytes[outer_declaration_tail.start] != 0x3Bu8 { return invalid }
    if outer_while.kind != 1u8 { return invalid }
    if outer_while.end - outer_while.start != 5usize { return invalid }
    if bytes[outer_while.start] != 0x77u8 { return invalid }
    if bytes[outer_while.start + 1usize] != 0x68u8 { return invalid }
    if bytes[outer_while.start + 2usize] != 0x69u8 { return invalid }
    if bytes[outer_while.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[outer_while.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, outer_name.start, outer_name.end, outer_condition_left.start, outer_condition_left.end) { return invalid }
    if outer_condition_operator.kind != 3u8 { return invalid }
    if bytes[outer_condition_operator.start] != 0x3Cu8 { return invalid }
    if outer_condition_right.kind != 2u8 { return invalid }
    if outer_open.kind != 3u8 { return invalid }
    if bytes[outer_open.start] != 0x7Bu8 { return invalid }

    var cursor: UIntSize = outer_open.end
    var outer_prefix_count: UIntSize = 0usize
    var ast_nodes_required: UIntSize = 8usize
    var prefix_valid: Bool = true
    while cursor < body_end_exclusive {
        let next: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
        if next.start >= body_end_exclusive { prefix_valid = false; break }
        if next.kind == 1u8 {
            if next.end - next.start == 3usize {
                if bytes[next.start] == 0x76u8 {
                    if bytes[next.start + 1usize] == 0x61u8 {
                        if bytes[next.start + 2usize] == 0x72u8 { break }
                    }
                }
            }
        }
        let assignment: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, body_end_exclusive, outer_name.start, outer_name.end)
        if !assignment.valid { prefix_valid = false; break }
        outer_prefix_count = outer_prefix_count + 1usize
        ast_nodes_required = ast_nodes_required + assignment.expression_node_count
        if outer_prefix_count > 4096usize { prefix_valid = false; break }
        cursor = assignment.next_cursor
    }
    if !prefix_valid { return invalid }
    if outer_prefix_count == 0usize { return invalid }
    let inner_initializer_statement_start: UIntSize = cursor
    let inner_var: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
    let inner_name: TokenInfo = scan_token_info(bytes, inner_var.end, body_end_exclusive)
    let inner_colon: TokenInfo = scan_token_info(bytes, inner_name.end, body_end_exclusive)
    let inner_type: TokenInfo = scan_token_info(bytes, inner_colon.end, body_end_exclusive)
    let inner_equals: TokenInfo = scan_token_info(bytes, inner_type.end, body_end_exclusive)
    let inner_initializer: TokenInfo = scan_token_info(bytes, inner_equals.end, body_end_exclusive)
    let inner_tail: TokenInfo = scan_token_info(bytes, inner_initializer.end, body_end_exclusive)
    if inner_var.kind != 1u8 { return invalid }
    if inner_var.end - inner_var.start != 3usize { return invalid }
    if bytes[inner_var.start] != 0x76u8 { return invalid }
    if bytes[inner_var.start + 1usize] != 0x61u8 { return invalid }
    if bytes[inner_var.start + 2usize] != 0x72u8 { return invalid }
    if inner_name.kind != 1u8 { return invalid }
    if inner_colon.kind != 3u8 { return invalid }
    if bytes[inner_colon.start] != 0x3Au8 { return invalid }
    if inner_type.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, inner_type.start, inner_type.end) { return invalid }
    if inner_equals.kind != 3u8 { return invalid }
    if bytes[inner_equals.start] != 0x3Du8 { return invalid }
    if inner_initializer.kind != 2u8 { return invalid }
    if inner_tail.kind != 3u8 { return invalid }
    if bytes[inner_tail.start] != 0x3Bu8 { return invalid }
    if stage2_same_ascii(bytes, outer_name.start, outer_name.end, inner_name.start, inner_name.end) { return invalid }
    let inner_initializer_statement_end: UIntSize = inner_tail.end

    let inner_while: TokenInfo = scan_token_info(bytes, inner_tail.end, body_end_exclusive)
    let inner_condition_left: TokenInfo = scan_token_info(bytes, inner_while.end, body_end_exclusive)
    let inner_condition_operator: TokenInfo = scan_token_info(bytes, inner_condition_left.end, body_end_exclusive)
    let inner_condition_right: TokenInfo = scan_token_info(bytes, inner_condition_operator.end, body_end_exclusive)
    let inner_open: TokenInfo = scan_token_info(bytes, inner_condition_right.end, body_end_exclusive)
    if inner_while.kind != 1u8 { return invalid }
    if inner_while.end - inner_while.start != 5usize { return invalid }
    if bytes[inner_while.start] != 0x77u8 { return invalid }
    if bytes[inner_while.start + 1usize] != 0x68u8 { return invalid }
    if bytes[inner_while.start + 2usize] != 0x69u8 { return invalid }
    if bytes[inner_while.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[inner_while.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, inner_name.start, inner_name.end, inner_condition_left.start, inner_condition_left.end) { return invalid }
    if inner_condition_operator.kind != 3u8 { return invalid }
    if bytes[inner_condition_operator.start] != 0x3Cu8 { return invalid }
    if inner_condition_right.kind != 2u8 { return invalid }
    if inner_open.kind != 3u8 { return invalid }
    if bytes[inner_open.start] != 0x7Bu8 { return invalid }

    cursor = inner_open.end
    var inner_body_count: UIntSize = 0usize
    var conditional_control_count: UIntSize = 0usize
    var first_control_kind: UInt8 = 0u8
    var first_control_start: UIntSize = 0usize
    var first_control_end: UIntSize = 0usize
    var first_control_condition_left_start: UIntSize = 0usize
    var first_control_condition_left_end: UIntSize = 0usize
    var first_control_condition_right_start: UIntSize = 0usize
    var first_control_condition_right_end: UIntSize = 0usize
    var second_control_kind: UInt8 = 0u8
    var second_control_start: UIntSize = 0usize
    var second_control_end: UIntSize = 0usize
    var second_control_condition_left_start: UIntSize = 0usize
    var second_control_condition_left_end: UIntSize = 0usize
    var second_control_condition_right_start: UIntSize = 0usize
    var second_control_condition_right_end: UIntSize = 0usize
    var inner_valid: Bool = true
    var inner_close: TokenInfo = TokenInfo { kind: 0u8, start: 0usize, end: 0usize }
    while cursor < body_end_exclusive {
        let next: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
        if next.start >= body_end_exclusive { inner_valid = false; break }
        if next.kind == 3u8 {
            if bytes[next.start] == 0x7Du8 {
                cursor = next.end
                inner_close = next
                break
            }
        }
        let assignment: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, body_end_exclusive, inner_name.start, inner_name.end)
        if !assignment.valid { inner_valid = false; break }
        ast_nodes_required = ast_nodes_required + assignment.expression_node_count
        let conditional: Bool = if assignment.kind == 4u8 { true } else { assignment.kind == 5u8 }
        if conditional {
            conditional_control_count = conditional_control_count + 1usize
            if conditional_control_count > 4096usize { inner_valid = false; break }
            if conditional_control_count == 1usize {
                first_control_kind = assignment.kind
                first_control_start = assignment.start
                first_control_end = assignment.end
                first_control_condition_left_start = assignment.expression_left_start
                first_control_condition_left_end = assignment.expression_left_end
                first_control_condition_right_start = assignment.expression_right_start
                first_control_condition_right_end = assignment.expression_right_end
            } else if conditional_control_count == 2usize {
                second_control_kind = assignment.kind
                second_control_start = assignment.start
                second_control_end = assignment.end
                second_control_condition_left_start = assignment.expression_left_start
                second_control_condition_left_end = assignment.expression_left_end
                second_control_condition_right_start = assignment.expression_right_start
                second_control_condition_right_end = assignment.expression_right_end
            }
        } else {
            if assignment.kind != 2u8 { inner_valid = false; break }
        }
        inner_body_count = inner_body_count + 1usize
        if inner_body_count > 4096usize { inner_valid = false; break }
        cursor = assignment.next_cursor
    }
    if !inner_valid { return invalid }
    if inner_body_count == 0usize { return invalid }
    if inner_close.kind != 3u8 { return invalid }
    if bytes[inner_close.start] != 0x7Du8 { return invalid }

    var outer_tail_count: UIntSize = 0usize
    var outer_tail_valid: Bool = true
    var outer_close: TokenInfo = TokenInfo { kind: 0u8, start: 0usize, end: 0usize }
    while cursor < body_end_exclusive {
        let next: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
        if next.start >= body_end_exclusive { outer_tail_valid = false; break }
        if next.kind == 3u8 {
            if bytes[next.start] == 0x7Du8 {
                cursor = next.end
                outer_close = next
                break
            }
        }
        let assignment: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, body_end_exclusive, outer_name.start, outer_name.end)
        if !assignment.valid { outer_tail_valid = false; break }
        ast_nodes_required = ast_nodes_required + assignment.expression_node_count
        outer_tail_count = outer_tail_count + 1usize
        if outer_tail_count > 4096usize { outer_tail_valid = false; break }
        cursor = assignment.next_cursor
    }
    if !outer_tail_valid { return invalid }
    if outer_tail_count == 0usize { return invalid }
    if outer_close.kind != 3u8 { return invalid }
    if bytes[outer_close.start] != 0x7Du8 { return invalid }

    let return_keyword: TokenInfo = scan_token_info(bytes, outer_close.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, outer_name.start, outer_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    let assignment_count: UIntSize = outer_prefix_count + inner_body_count + outer_tail_count
    let body_count: UIntSize = assignment_count + 1usize
    if body_count > 4096usize { return invalid }
    return Stage2TypedNestedWhileSpans {
        valid: true,
        body_count: body_count,
        assignment_count: assignment_count,
        ast_nodes_required: ast_nodes_required,
        conditional_control_count: conditional_control_count,
        first_control_kind: first_control_kind,
        first_control_start: first_control_start,
        first_control_end: first_control_end,
        first_control_condition_left_start: first_control_condition_left_start,
        first_control_condition_left_end: first_control_condition_left_end,
        first_control_condition_right_start: first_control_condition_right_start,
        first_control_condition_right_end: first_control_condition_right_end,
        second_control_kind: second_control_kind,
        second_control_start: second_control_start,
        second_control_end: second_control_end,
        second_control_condition_left_start: second_control_condition_left_start,
        second_control_condition_left_end: second_control_condition_left_end,
        second_control_condition_right_start: second_control_condition_right_start,
        second_control_condition_right_end: second_control_condition_right_end,
        outer_declaration_start: outer_name.start,
        outer_declaration_end: outer_name.end,
        outer_initializer_start: outer_initializer.start,
        outer_initializer_end: outer_initializer.end,
        outer_while_start: outer_while.start,
        outer_while_end: outer_close.end,
        outer_condition_left_start: outer_condition_left.start,
        outer_condition_left_end: outer_condition_left.end,
        outer_condition_right_start: outer_condition_right.start,
        outer_condition_right_end: outer_condition_right.end,
        outer_loop_body_start: outer_open.end,
        outer_loop_body_end: outer_close.start,
        inner_declaration_start: inner_name.start,
        inner_declaration_end: inner_name.end,
        inner_initializer_statement_start: inner_initializer_statement_start,
        inner_initializer_statement_end: inner_initializer_statement_end,
        inner_initializer_start: inner_initializer.start,
        inner_initializer_end: inner_initializer.end,
        inner_while_start: inner_while.start,
        inner_while_end: inner_close.end,
        inner_condition_left_start: inner_condition_left.start,
        inner_condition_left_end: inner_condition_left.end,
        inner_condition_right_start: inner_condition_right.start,
        inner_condition_right_end: inner_condition_right.end,
        inner_loop_body_start: inner_open.end,
        inner_loop_body_end: inner_close.start,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

fn stage2_parse_typed_while_dynamic_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedWhileDynamicSpans {
    let invalid: Stage2TypedWhileDynamicSpans = Stage2TypedWhileDynamicSpans {
        valid: false,
        body_count: 0usize,
        ast_nodes_required: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        while_start: 0usize,
        while_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        loop_body_start: 0usize,
        loop_body_end: 0usize,
        body_start: 0usize,
        body_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let var_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let declaration_name: TokenInfo = scan_token_info(bytes, var_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    let while_token: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, while_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let loop_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    if var_token.kind != 1u8 { return invalid }
    if var_token.end - var_token.start != 3usize { return invalid }
    if bytes[var_token.start] != 0x76u8 { return invalid }
    if bytes[var_token.start + 1usize] != 0x61u8 { return invalid }
    if bytes[var_token.start + 2usize] != 0x72u8 { return invalid }
    if declaration_name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if while_token.kind != 1u8 { return invalid }
    if while_token.end - while_token.start != 5usize { return invalid }
    if bytes[while_token.start] != 0x77u8 { return invalid }
    if bytes[while_token.start + 1usize] != 0x68u8 { return invalid }
    if bytes[while_token.start + 2usize] != 0x69u8 { return invalid }
    if bytes[while_token.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[while_token.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, condition_left.start, condition_left.end) { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Cu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if loop_open.kind != 3u8 { return invalid }
    if bytes[loop_open.start] != 0x7Bu8 { return invalid }
    var cursor: UIntSize = loop_open.end
    var statement_count: UIntSize = 0usize
    var ast_nodes_required: UIntSize = 5usize
    var first_start: UIntSize = 0usize
    var last_end: UIntSize = 0usize
    var loop_close: TokenInfo = TokenInfo { kind: 0u8, start: 0usize, end: 0usize }
    var body_valid: Bool = true
    while cursor < body_end_exclusive {
        let target: TokenInfo = scan_token_info(bytes, cursor, body_end_exclusive)
        if target.start >= body_end_exclusive { body_valid = false; break }
        if target.kind == 3u8 {
            if bytes[target.start] == 0x7Du8 {
                let target_end: UIntSize = target.end
                loop_close = target
                cursor = target_end
                break
            }
        }
        let assignment_equals: TokenInfo = scan_token_info(bytes, target.end, body_end_exclusive)
        let use: TokenInfo = scan_token_info(bytes, assignment_equals.end, body_end_exclusive)
        let operator: TokenInfo = scan_token_info(bytes, use.end, body_end_exclusive)
        let literal: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
        let tail: TokenInfo = scan_token_info(bytes, literal.end, body_end_exclusive)
        if target.kind != 1u8 { body_valid = false; break }
        if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, target.start, target.end) { body_valid = false; break }
        if assignment_equals.kind != 3u8 { body_valid = false; break }
        if bytes[assignment_equals.start] != 0x3Du8 { body_valid = false; break }
        if use.kind != 1u8 { body_valid = false; break }
        if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, use.start, use.end) { body_valid = false; break }
        if operator.kind != 3u8 { body_valid = false; break }
        if bytes[operator.start] != 0x2Bu8 { body_valid = false; break }
        if literal.kind == 1u8 {
            if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, literal.start, literal.end) { body_valid = false; break }
        } else if literal.kind != 2u8 { body_valid = false; break }
        if tail.kind != 3u8 { body_valid = false; break }
        if bytes[tail.start] != 0x3Bu8 { body_valid = false; break }
        ast_nodes_required = ast_nodes_required + 3usize
        if statement_count == 0usize { first_start = target.start }
        last_end = tail.end
        statement_count = statement_count + 1usize
        if statement_count > 4096usize { body_valid = false; break }
        cursor = tail.end
    }
    if !body_valid { return invalid }
    if statement_count == 0usize { return invalid }
    if loop_close.kind != 3u8 { return invalid }
    if bytes[loop_close.start] != 0x7Du8 { return invalid }
    let return_keyword: TokenInfo = scan_token_info(bytes, loop_close.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedWhileDynamicSpans {
        valid: true,
        body_count: statement_count,
        ast_nodes_required: ast_nodes_required,
        declaration_start: declaration_name.start,
        declaration_end: declaration_name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        while_start: while_token.start,
        while_end: loop_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        loop_body_start: loop_open.end,
        loop_body_end: loop_close.start,
        body_start: first_start,
        body_end: last_end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

/// Source spans for the first native producer `while` hand-off. The admitted
/// shape is intentionally small: one `var counter: Int32 = <literal>;`, one
/// `while counter < <literal> { counter = counter + <literal>; }` with an
/// optional terminal `break;` or `continue;`, and a final `return counter;`.
struct Stage2TypedWhileSpans {
    valid: Bool,
    body_count: UIntSize,
    control_kind: UInt8,
    conditional_control: Bool,
    second_conditional_control: Bool,
    second_control_kind: UInt8,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    initializer_start: UIntSize,
    initializer_end: UIntSize,
    while_start: UIntSize,
    while_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
    body_target_start: UIntSize,
    body_target_end: UIntSize,
    body_use_start: UIntSize,
    body_use_end: UIntSize,
    body_literal_start: UIntSize,
    body_literal_end: UIntSize,
    break_start: UIntSize,
    break_end: UIntSize,
    control_condition_left_start: UIntSize,
    control_condition_left_end: UIntSize,
    control_condition_right_start: UIntSize,
    control_condition_right_end: UIntSize,
    second_control_condition_left_start: UIntSize,
    second_control_condition_left_end: UIntSize,
    second_control_condition_right_start: UIntSize,
    second_control_condition_right_end: UIntSize,
    second_break_start: UIntSize,
    second_break_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_while_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedWhileSpans {
    let invalid: Stage2TypedWhileSpans = Stage2TypedWhileSpans {
        valid: false,
        body_count: 0usize,
        control_kind: 0u8,
        conditional_control: false,
        second_conditional_control: false,
        second_control_kind: 0u8,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        while_start: 0usize,
        while_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        body_start: 0usize,
        body_end: 0usize,
        body_target_start: 0usize,
        body_target_end: 0usize,
        body_use_start: 0usize,
        body_use_end: 0usize,
        body_literal_start: 0usize,
        body_literal_end: 0usize,
        break_start: 0usize,
        break_end: 0usize,
        control_condition_left_start: 0usize,
        control_condition_left_end: 0usize,
        control_condition_right_start: 0usize,
        control_condition_right_end: 0usize,
        second_control_condition_left_start: 0usize,
        second_control_condition_left_end: 0usize,
        second_control_condition_right_start: 0usize,
        second_control_condition_right_end: 0usize,
        second_break_start: 0usize,
        second_break_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let var_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let declaration_name: TokenInfo = scan_token_info(bytes, var_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    let while_token: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, while_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let loop_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let body_target: TokenInfo = scan_token_info(bytes, loop_open.end, body_end_exclusive)
    let body_equals: TokenInfo = scan_token_info(bytes, body_target.end, body_end_exclusive)
    let body_use: TokenInfo = scan_token_info(bytes, body_equals.end, body_end_exclusive)
    let body_operator: TokenInfo = scan_token_info(bytes, body_use.end, body_end_exclusive)
    let body_literal: TokenInfo = scan_token_info(bytes, body_operator.end, body_end_exclusive)
    let body_tail: TokenInfo = scan_token_info(bytes, body_literal.end, body_end_exclusive)
    let possible_control_keyword: TokenInfo = scan_token_info(bytes, body_tail.end, body_end_exclusive)
    let control_tail: TokenInfo = scan_token_info(bytes, possible_control_keyword.end, body_end_exclusive)
    let control_loop_close: TokenInfo = scan_token_info(bytes, control_tail.end, body_end_exclusive)
    let conditional_left: TokenInfo = scan_token_info(bytes, possible_control_keyword.end, body_end_exclusive)
    let conditional_operator: TokenInfo = scan_token_info(bytes, conditional_left.end, body_end_exclusive)
    let conditional_right: TokenInfo = scan_token_info(bytes, conditional_operator.end, body_end_exclusive)
    let conditional_open: TokenInfo = scan_token_info(bytes, conditional_right.end, body_end_exclusive)
    let conditional_keyword: TokenInfo = scan_token_info(bytes, conditional_open.end, body_end_exclusive)
    let conditional_tail: TokenInfo = scan_token_info(bytes, conditional_keyword.end, body_end_exclusive)
    let conditional_close: TokenInfo = scan_token_info(bytes, conditional_tail.end, body_end_exclusive)
    let conditional_loop_close: TokenInfo = scan_token_info(bytes, conditional_close.end, body_end_exclusive)
    let second_possible_control_keyword: TokenInfo = scan_token_info(bytes, conditional_close.end, body_end_exclusive)
    let second_conditional_left: TokenInfo = scan_token_info(bytes, second_possible_control_keyword.end, body_end_exclusive)
    let second_conditional_operator: TokenInfo = scan_token_info(bytes, second_conditional_left.end, body_end_exclusive)
    let second_conditional_right: TokenInfo = scan_token_info(bytes, second_conditional_operator.end, body_end_exclusive)
    let second_conditional_open: TokenInfo = scan_token_info(bytes, second_conditional_right.end, body_end_exclusive)
    let second_conditional_keyword: TokenInfo = scan_token_info(bytes, second_conditional_open.end, body_end_exclusive)
    let second_conditional_tail: TokenInfo = scan_token_info(bytes, second_conditional_keyword.end, body_end_exclusive)
    let second_conditional_close: TokenInfo = scan_token_info(bytes, second_conditional_tail.end, body_end_exclusive)
    let second_conditional_loop_close: TokenInfo = scan_token_info(bytes, second_conditional_close.end, body_end_exclusive)
    var loop_close_start: UIntSize = possible_control_keyword.start
    var loop_close_end: UIntSize = possible_control_keyword.end
    var body_count: UIntSize = 1usize
    var control_kind: UInt8 = 0u8
    var conditional_control: Bool = false
    var second_conditional_control: Bool = false
    var second_control_kind: UInt8 = 0u8
    if possible_control_keyword.kind == 1u8 {
        if possible_control_keyword.end - possible_control_keyword.start == 2usize {
            if bytes[possible_control_keyword.start] == 0x69u8 {
                if bytes[possible_control_keyword.start + 1usize] == 0x66u8 {
                    conditional_control = true
                    loop_close_start = conditional_loop_close.start
                    loop_close_end = conditional_loop_close.end
                    body_count = 2usize
                    if conditional_keyword.kind == 1u8 {
                        if conditional_keyword.end - conditional_keyword.start == 5usize {
                            if bytes[conditional_keyword.start] == 0x62u8 {
                                if bytes[conditional_keyword.start + 1usize] == 0x72u8 {
                                    if bytes[conditional_keyword.start + 2usize] == 0x65u8 {
                                        if bytes[conditional_keyword.start + 3usize] == 0x61u8 {
                                            if bytes[conditional_keyword.start + 4usize] == 0x6Bu8 {
                                                control_kind = 4u8
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if conditional_keyword.kind == 1u8 {
                        if conditional_keyword.end - conditional_keyword.start == 8usize {
                            if bytes[conditional_keyword.start] == 0x63u8 {
                                if bytes[conditional_keyword.start + 1usize] == 0x6Fu8 {
                                    if bytes[conditional_keyword.start + 2usize] == 0x6Eu8 {
                                        if bytes[conditional_keyword.start + 3usize] == 0x74u8 {
                                            if bytes[conditional_keyword.start + 4usize] == 0x69u8 {
                                                if bytes[conditional_keyword.start + 5usize] == 0x6Eu8 {
                                                    if bytes[conditional_keyword.start + 6usize] == 0x75u8 {
                                                        if bytes[conditional_keyword.start + 7usize] == 0x65u8 {
                                                            control_kind = 5u8
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if conditional_control {
        if second_possible_control_keyword.kind == 1u8 {
            if second_possible_control_keyword.end - second_possible_control_keyword.start == 2usize {
                if bytes[second_possible_control_keyword.start] == 0x69u8 {
                    if bytes[second_possible_control_keyword.start + 1usize] == 0x66u8 {
                        if second_conditional_keyword.kind == 1u8 {
                            if second_conditional_keyword.end - second_conditional_keyword.start == 5usize {
                                if bytes[second_conditional_keyword.start] == 0x62u8 {
                                    if bytes[second_conditional_keyword.start + 1usize] == 0x72u8 {
                                        if bytes[second_conditional_keyword.start + 2usize] == 0x65u8 {
                                            if bytes[second_conditional_keyword.start + 3usize] == 0x61u8 {
                                                if bytes[second_conditional_keyword.start + 4usize] == 0x6Bu8 {
                                                    second_control_kind = 4u8
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if second_conditional_keyword.end - second_conditional_keyword.start == 8usize {
                                if bytes[second_conditional_keyword.start] == 0x63u8 {
                                    if bytes[second_conditional_keyword.start + 1usize] == 0x6Fu8 {
                                        if bytes[second_conditional_keyword.start + 2usize] == 0x6Eu8 {
                                            if bytes[second_conditional_keyword.start + 3usize] == 0x74u8 {
                                                if bytes[second_conditional_keyword.start + 4usize] == 0x69u8 {
                                                    if bytes[second_conditional_keyword.start + 5usize] == 0x6Eu8 {
                                                        if bytes[second_conditional_keyword.start + 6usize] == 0x75u8 {
                                                            if bytes[second_conditional_keyword.start + 7usize] == 0x65u8 {
                                                                second_control_kind = 5u8
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if second_control_kind != 0u8 {
                            second_conditional_control = true
                            body_count = 3usize
                            loop_close_start = second_conditional_loop_close.start
                            loop_close_end = second_conditional_loop_close.end
                        }
                    }
                }
            }
        }
    }
    if !conditional_control {
        if possible_control_keyword.kind == 1u8 {
        loop_close_start = control_loop_close.start
        loop_close_end = control_loop_close.end
        body_count = 2usize
        if possible_control_keyword.end - possible_control_keyword.start == 5usize {
            if bytes[possible_control_keyword.start] == 0x62u8 {
                if bytes[possible_control_keyword.start + 1usize] == 0x72u8 {
                    if bytes[possible_control_keyword.start + 2usize] == 0x65u8 {
                        if bytes[possible_control_keyword.start + 3usize] == 0x61u8 {
                            if bytes[possible_control_keyword.start + 4usize] == 0x6Bu8 {
                                control_kind = 4u8
                            }
                        }
                    }
                }
            }
        }
        if possible_control_keyword.end - possible_control_keyword.start == 8usize {
            if bytes[possible_control_keyword.start] == 0x63u8 {
                if bytes[possible_control_keyword.start + 1usize] == 0x6Fu8 {
                    if bytes[possible_control_keyword.start + 2usize] == 0x6Eu8 {
                        if bytes[possible_control_keyword.start + 3usize] == 0x74u8 {
                            if bytes[possible_control_keyword.start + 4usize] == 0x69u8 {
                                if bytes[possible_control_keyword.start + 5usize] == 0x6Eu8 {
                                    if bytes[possible_control_keyword.start + 6usize] == 0x75u8 {
                                        if bytes[possible_control_keyword.start + 7usize] == 0x65u8 {
                                            control_kind = 5u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, loop_close_end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if var_token.kind != 1u8 { return invalid }
    if var_token.end - var_token.start != 3usize { return invalid }
    if bytes[var_token.start] != 0x76u8 { return invalid }
    if bytes[var_token.start + 1usize] != 0x61u8 { return invalid }
    if bytes[var_token.start + 2usize] != 0x72u8 { return invalid }
    if declaration_name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if while_token.kind != 1u8 { return invalid }
    if while_token.end - while_token.start != 5usize { return invalid }
    if bytes[while_token.start] != 0x77u8 { return invalid }
    if bytes[while_token.start + 1usize] != 0x68u8 { return invalid }
    if bytes[while_token.start + 2usize] != 0x69u8 { return invalid }
    if bytes[while_token.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[while_token.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, condition_left.start, condition_left.end) { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Cu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if loop_open.kind != 3u8 { return invalid }
    if bytes[loop_open.start] != 0x7Bu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, body_target.start, body_target.end) { return invalid }
    if body_equals.kind != 3u8 { return invalid }
    if bytes[body_equals.start] != 0x3Du8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, body_use.start, body_use.end) { return invalid }
    if body_operator.kind != 3u8 { return invalid }
    if bytes[body_operator.start] != 0x2Bu8 { return invalid }
    if body_literal.kind != 2u8 { return invalid }
    if body_tail.kind != 3u8 { return invalid }
    if bytes[body_tail.start] != 0x3Bu8 { return invalid }
    let has_control_body: Bool = if body_count == 2usize { true } else { body_count == 3usize }
    if has_control_body {
        if conditional_control {
            if possible_control_keyword.kind != 1u8 { return invalid }
            if possible_control_keyword.end - possible_control_keyword.start != 2usize { return invalid }
            if bytes[possible_control_keyword.start] != 0x69u8 { return invalid }
            if bytes[possible_control_keyword.start + 1usize] != 0x66u8 { return invalid }
            if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, conditional_left.start, conditional_left.end) { return invalid }
            if conditional_operator.kind != 3u8 { return invalid }
            if bytes[conditional_operator.start] != 0x3Cu8 { return invalid }
            if conditional_right.kind != 2u8 { return invalid }
            if conditional_open.kind != 3u8 { return invalid }
            if bytes[conditional_open.start] != 0x7Bu8 { return invalid }
            if control_kind == 0u8 { return invalid }
            if conditional_tail.kind != 3u8 { return invalid }
            if bytes[conditional_tail.start] != 0x3Bu8 { return invalid }
            if conditional_close.kind != 3u8 { return invalid }
            if bytes[conditional_close.start] != 0x7Du8 { return invalid }
            if body_count == 2usize {
                if conditional_loop_close.kind != 3u8 { return invalid }
            }
            if body_count == 3usize {
                if !second_conditional_control { return invalid }
                if second_possible_control_keyword.kind != 1u8 { return invalid }
                if second_possible_control_keyword.end - second_possible_control_keyword.start != 2usize { return invalid }
                if bytes[second_possible_control_keyword.start] != 0x69u8 { return invalid }
                if bytes[second_possible_control_keyword.start + 1usize] != 0x66u8 { return invalid }
                if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, second_conditional_left.start, second_conditional_left.end) { return invalid }
                if second_conditional_operator.kind != 3u8 { return invalid }
                if bytes[second_conditional_operator.start] != 0x3Cu8 { return invalid }
                if second_conditional_right.kind != 2u8 { return invalid }
                if second_conditional_open.kind != 3u8 { return invalid }
                if bytes[second_conditional_open.start] != 0x7Bu8 { return invalid }
                if second_control_kind == 0u8 { return invalid }
                if second_conditional_tail.kind != 3u8 { return invalid }
                if bytes[second_conditional_tail.start] != 0x3Bu8 { return invalid }
                if second_conditional_close.kind != 3u8 { return invalid }
                if bytes[second_conditional_close.start] != 0x7Du8 { return invalid }
                if second_conditional_loop_close.kind != 3u8 { return invalid }
            }
        } else if body_count == 2usize {
            if possible_control_keyword.kind != 1u8 { return invalid }
            if control_kind == 0u8 { return invalid }
            if control_tail.kind != 3u8 { return invalid }
            if bytes[control_tail.start] != 0x3Bu8 { return invalid }
            if control_loop_close.kind != 3u8 { return invalid }
        } else {
            return invalid
        }
    } else {
        if possible_control_keyword.kind != 3u8 { return invalid }
    }
    if bytes[loop_close_start] != 0x7Du8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedWhileSpans {
        valid: true,
        body_count: body_count,
        control_kind: control_kind,
        conditional_control: conditional_control,
        second_conditional_control: second_conditional_control,
        second_control_kind: second_control_kind,
        declaration_start: declaration_name.start,
        declaration_end: declaration_name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        while_start: while_token.start,
        while_end: loop_close_end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        body_start: body_target.start,
        body_end: body_tail.end,
        body_target_start: body_target.start,
        body_target_end: body_target.end,
        body_use_start: body_use.start,
        body_use_end: body_use.end,
        body_literal_start: body_literal.start,
        body_literal_end: body_literal.end,
        break_start: possible_control_keyword.start,
        break_end: if conditional_control { conditional_close.end } else { control_tail.end },
        control_condition_left_start: conditional_left.start,
        control_condition_left_end: conditional_left.end,
        control_condition_right_start: conditional_right.start,
        control_condition_right_end: conditional_right.end,
        second_control_condition_left_start: second_conditional_left.start,
        second_control_condition_left_end: second_conditional_left.end,
        second_control_condition_right_start: second_conditional_right.start,
        second_control_condition_right_end: second_conditional_right.end,
        second_break_start: second_possible_control_keyword.start,
        second_break_end: second_conditional_close.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

/// Source spans for the first native-producer multi-statement `while` hand-off.
/// The admitted shape keeps the same mutable local and adds one ordered
/// assignment to the loop body.  The typed AST remains caller-owned and the
/// Rust Stage-2 lowerer decides how the statement list is lowered.
struct Stage2TypedWhileStatementsSpans {
    valid: Bool,
    body_count: UIntSize,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    initializer_start: UIntSize,
    initializer_end: UIntSize,
    while_start: UIntSize,
    while_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    first_start: UIntSize,
    first_end: UIntSize,
    first_target_start: UIntSize,
    first_target_end: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
    second_target_start: UIntSize,
    second_target_end: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    third_start: UIntSize,
    third_end: UIntSize,
    third_target_start: UIntSize,
    third_target_end: UIntSize,
    third_use_start: UIntSize,
    third_use_end: UIntSize,
    third_literal_start: UIntSize,
    third_literal_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_while_statements_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedWhileStatementsSpans {
    let invalid: Stage2TypedWhileStatementsSpans = Stage2TypedWhileStatementsSpans {
        valid: false,
        body_count: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        while_start: 0usize,
        while_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_target_start: 0usize,
        first_target_end: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        second_target_start: 0usize,
        second_target_end: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        third_target_start: 0usize,
        third_target_end: 0usize,
        third_use_start: 0usize,
        third_use_end: 0usize,
        third_literal_start: 0usize,
        third_literal_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let var_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let declaration_name: TokenInfo = scan_token_info(bytes, var_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    let while_token: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, while_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let loop_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let first_target: TokenInfo = scan_token_info(bytes, loop_open.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_target.end, body_end_exclusive)
    let first_use: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_operator: TokenInfo = scan_token_info(bytes, first_use.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, body_end_exclusive)
    let first_tail: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    let second_target: TokenInfo = scan_token_info(bytes, first_tail.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_target.end, body_end_exclusive)
    let second_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let second_operator: TokenInfo = scan_token_info(bytes, second_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, body_end_exclusive)
    let second_tail: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    let possible_third_target: TokenInfo = scan_token_info(bytes, second_tail.end, body_end_exclusive)
    let third_equals: TokenInfo = scan_token_info(bytes, possible_third_target.end, body_end_exclusive)
    let third_use: TokenInfo = scan_token_info(bytes, third_equals.end, body_end_exclusive)
    let third_operator: TokenInfo = scan_token_info(bytes, third_use.end, body_end_exclusive)
    let third_literal: TokenInfo = scan_token_info(bytes, third_operator.end, body_end_exclusive)
    let third_tail: TokenInfo = scan_token_info(bytes, third_literal.end, body_end_exclusive)
    let third_loop_close: TokenInfo = scan_token_info(bytes, third_tail.end, body_end_exclusive)
    var loop_close_start: UIntSize = possible_third_target.start
    var loop_close_end: UIntSize = possible_third_target.end
    var body_count: UIntSize = 2usize
    if possible_third_target.kind == 1u8 {
        loop_close_start = third_loop_close.start
        loop_close_end = third_loop_close.end
        body_count = 3usize
    }
    let return_keyword: TokenInfo = scan_token_info(bytes, loop_close_end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if var_token.kind != 1u8 { return invalid }
    if var_token.end - var_token.start != 3usize { return invalid }
    if bytes[var_token.start] != 0x76u8 { return invalid }
    if bytes[var_token.start + 1usize] != 0x61u8 { return invalid }
    if bytes[var_token.start + 2usize] != 0x72u8 { return invalid }
    if declaration_name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if while_token.kind != 1u8 { return invalid }
    if while_token.end - while_token.start != 5usize { return invalid }
    if bytes[while_token.start] != 0x77u8 { return invalid }
    if bytes[while_token.start + 1usize] != 0x68u8 { return invalid }
    if bytes[while_token.start + 2usize] != 0x69u8 { return invalid }
    if bytes[while_token.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[while_token.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, condition_left.start, condition_left.end) { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Cu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if loop_open.kind != 3u8 { return invalid }
    if bytes[loop_open.start] != 0x7Bu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, first_target.start, first_target.end) { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, first_use.start, first_use.end) { return invalid }
    if first_operator.kind != 3u8 { return invalid }
    if bytes[first_operator.start] != 0x2Bu8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_tail.kind != 3u8 { return invalid }
    if bytes[first_tail.start] != 0x3Bu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, second_target.start, second_target.end) { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, second_use.start, second_use.end) { return invalid }
    if second_operator.kind != 3u8 { return invalid }
    if bytes[second_operator.start] != 0x2Bu8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_tail.kind != 3u8 { return invalid }
    if bytes[second_tail.start] != 0x3Bu8 { return invalid }
    if body_count == 3usize {
        if possible_third_target.kind != 1u8 { return invalid }
        if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, possible_third_target.start, possible_third_target.end) { return invalid }
        if third_equals.kind != 3u8 { return invalid }
        if bytes[third_equals.start] != 0x3Du8 { return invalid }
        if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, third_use.start, third_use.end) { return invalid }
        if third_operator.kind != 3u8 { return invalid }
        if bytes[third_operator.start] != 0x2Bu8 { return invalid }
        if third_literal.kind != 2u8 { return invalid }
        if third_tail.kind != 3u8 { return invalid }
        if bytes[third_tail.start] != 0x3Bu8 { return invalid }
        if third_loop_close.kind != 3u8 { return invalid }
        if bytes[third_loop_close.start] != 0x7Du8 { return invalid }
    } else {
        if possible_third_target.kind != 3u8 { return invalid }
    }
    if bytes[loop_close_start] != 0x7Du8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedWhileStatementsSpans {
        valid: true,
        body_count: body_count,
        declaration_start: declaration_name.start,
        declaration_end: declaration_name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        while_start: while_token.start,
        while_end: loop_close_end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        first_start: first_target.start,
        first_end: first_tail.end,
        first_target_start: first_target.start,
        first_target_end: first_target.end,
        first_use_start: first_use.start,
        first_use_end: first_use.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        second_start: second_target.start,
        second_end: second_tail.end,
        second_target_start: second_target.start,
        second_target_end: second_target.end,
        second_use_start: second_use.start,
        second_use_end: second_use.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        third_start: possible_third_target.start,
        third_end: third_tail.end,
        third_target_start: possible_third_target.start,
        third_target_end: possible_third_target.end,
        third_use_start: third_use.start,
        third_use_end: third_use.end,
        third_literal_start: third_literal.start,
        third_literal_end: third_literal.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

/// Source spans for a bounded loop body that declares one local and then
/// assigns the outer loop local from it. This exercises the lowerer's per
/// iteration body-local StackAlloc contract without introducing a general
/// nested-scope parser.
struct Stage2TypedWhileBodyLetSpans {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    initializer_start: UIntSize,
    initializer_end: UIntSize,
    while_start: UIntSize,
    while_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    let_start: UIntSize,
    let_end: UIntSize,
    let_target_start: UIntSize,
    let_target_end: UIntSize,
    let_use_start: UIntSize,
    let_use_end: UIntSize,
    let_literal_start: UIntSize,
    let_literal_end: UIntSize,
    assign_start: UIntSize,
    assign_end: UIntSize,
    assign_target_start: UIntSize,
    assign_target_end: UIntSize,
    assign_use_start: UIntSize,
    assign_use_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_while_body_let_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedWhileBodyLetSpans {
    let invalid: Stage2TypedWhileBodyLetSpans = Stage2TypedWhileBodyLetSpans {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        while_start: 0usize,
        while_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        let_start: 0usize,
        let_end: 0usize,
        let_target_start: 0usize,
        let_target_end: 0usize,
        let_use_start: 0usize,
        let_use_end: 0usize,
        let_literal_start: 0usize,
        let_literal_end: 0usize,
        assign_start: 0usize,
        assign_end: 0usize,
        assign_target_start: 0usize,
        assign_target_end: 0usize,
        assign_use_start: 0usize,
        assign_use_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let var_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let declaration_name: TokenInfo = scan_token_info(bytes, var_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, declaration_name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    let while_token: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, while_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let loop_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let let_token: TokenInfo = scan_token_info(bytes, loop_open.end, body_end_exclusive)
    let let_target: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let let_colon: TokenInfo = scan_token_info(bytes, let_target.end, body_end_exclusive)
    let let_type: TokenInfo = scan_token_info(bytes, let_colon.end, body_end_exclusive)
    let let_equals: TokenInfo = scan_token_info(bytes, let_type.end, body_end_exclusive)
    let let_use: TokenInfo = scan_token_info(bytes, let_equals.end, body_end_exclusive)
    let let_operator: TokenInfo = scan_token_info(bytes, let_use.end, body_end_exclusive)
    let let_literal: TokenInfo = scan_token_info(bytes, let_operator.end, body_end_exclusive)
    let let_tail: TokenInfo = scan_token_info(bytes, let_literal.end, body_end_exclusive)
    let assign_target: TokenInfo = scan_token_info(bytes, let_tail.end, body_end_exclusive)
    let assign_equals: TokenInfo = scan_token_info(bytes, assign_target.end, body_end_exclusive)
    let assign_use: TokenInfo = scan_token_info(bytes, assign_equals.end, body_end_exclusive)
    let assign_tail: TokenInfo = scan_token_info(bytes, assign_use.end, body_end_exclusive)
    let loop_close: TokenInfo = scan_token_info(bytes, assign_tail.end, body_end_exclusive)
    let return_keyword: TokenInfo = scan_token_info(bytes, loop_close.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if var_token.kind != 1u8 { return invalid }
    if var_token.end - var_token.start != 3usize { return invalid }
    if bytes[var_token.start] != 0x76u8 { return invalid }
    if bytes[var_token.start + 1usize] != 0x61u8 { return invalid }
    if bytes[var_token.start + 2usize] != 0x72u8 { return invalid }
    if declaration_name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if while_token.kind != 1u8 { return invalid }
    if while_token.end - while_token.start != 5usize { return invalid }
    if bytes[while_token.start] != 0x77u8 { return invalid }
    if bytes[while_token.start + 1usize] != 0x68u8 { return invalid }
    if bytes[while_token.start + 2usize] != 0x69u8 { return invalid }
    if bytes[while_token.start + 3usize] != 0x6Cu8 { return invalid }
    if bytes[while_token.start + 4usize] != 0x65u8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, condition_left.start, condition_left.end) { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Cu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if loop_open.kind != 3u8 { return invalid }
    if bytes[loop_open.start] != 0x7Bu8 { return invalid }
    if let_token.kind != 1u8 { return invalid }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if let_target.kind != 1u8 { return invalid }
    if stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, let_target.start, let_target.end) { return invalid }
    if let_colon.kind != 3u8 { return invalid }
    if bytes[let_colon.start] != 0x3Au8 { return invalid }
    if let_type.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, let_type.start, let_type.end) { return invalid }
    if let_equals.kind != 3u8 { return invalid }
    if bytes[let_equals.start] != 0x3Du8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, let_use.start, let_use.end) { return invalid }
    if let_operator.kind != 3u8 { return invalid }
    if bytes[let_operator.start] != 0x2Bu8 { return invalid }
    if let_literal.kind != 2u8 { return invalid }
    if let_tail.kind != 3u8 { return invalid }
    if bytes[let_tail.start] != 0x3Bu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, assign_target.start, assign_target.end) { return invalid }
    if assign_equals.kind != 3u8 { return invalid }
    if bytes[assign_equals.start] != 0x3Du8 { return invalid }
    if !stage2_same_ascii(bytes, let_target.start, let_target.end, assign_use.start, assign_use.end) { return invalid }
    if assign_tail.kind != 3u8 { return invalid }
    if bytes[assign_tail.start] != 0x3Bu8 { return invalid }
    if loop_close.kind != 3u8 { return invalid }
    if bytes[loop_close.start] != 0x7Du8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, declaration_name.start, declaration_name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedWhileBodyLetSpans {
        valid: true,
        declaration_start: declaration_name.start,
        declaration_end: declaration_name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        while_start: while_token.start,
        while_end: loop_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        let_start: let_token.start,
        let_end: let_tail.end,
        let_target_start: let_target.start,
        let_target_end: let_target.end,
        let_use_start: let_use.start,
        let_use_end: let_use.end,
        let_literal_start: let_literal.start,
        let_literal_end: let_literal.end,
        assign_start: assign_target.start,
        assign_end: assign_tail.end,
        assign_target_start: assign_target.start,
        assign_target_end: assign_target.end,
        assign_use_start: assign_use.start,
        assign_use_end: assign_use.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

fn stage2_parse_typed_if_value_continuation_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedIfValueContinuationSpans {
    let invalid: Stage2TypedIfValueContinuationSpans = Stage2TypedIfValueContinuationSpans {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        if_start: 0usize,
        if_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        then_start: 0usize,
        then_end: 0usize,
        else_start: 0usize,
        else_end: 0usize,
        continuation_start: 0usize,
        continuation_end: 0usize,
        continuation_name_end: 0usize,
        continuation_literal_start: 0usize,
        continuation_literal_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let if_token: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, if_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let then_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let then_literal: TokenInfo = scan_token_info(bytes, then_open.end, body_end_exclusive)
    let then_close: TokenInfo = scan_token_info(bytes, then_literal.end, body_end_exclusive)
    let else_keyword: TokenInfo = scan_token_info(bytes, then_close.end, body_end_exclusive)
    let else_open: TokenInfo = scan_token_info(bytes, else_keyword.end, body_end_exclusive)
    let else_literal: TokenInfo = scan_token_info(bytes, else_open.end, body_end_exclusive)
    let else_close: TokenInfo = scan_token_info(bytes, else_literal.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, else_close.end, body_end_exclusive)
    let return_keyword: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_operator: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    let return_literal: TokenInfo = scan_token_info(bytes, return_operator.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_literal.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if if_token.kind != 1u8 { return invalid }
    if if_token.end - if_token.start != 2usize { return invalid }
    if bytes[if_token.start] != 0x69u8 { return invalid }
    if bytes[if_token.start + 1usize] != 0x66u8 { return invalid }
    if condition_left.kind != 2u8 { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Eu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if then_open.kind != 3u8 { return invalid }
    if bytes[then_open.start] != 0x7Bu8 { return invalid }
    if then_literal.kind != 2u8 { return invalid }
    if then_close.kind != 3u8 { return invalid }
    if bytes[then_close.start] != 0x7Du8 { return invalid }
    if else_keyword.kind != 1u8 { return invalid }
    if else_keyword.end - else_keyword.start != 4usize { return invalid }
    if bytes[else_keyword.start] != 0x65u8 { return invalid }
    if bytes[else_keyword.start + 1usize] != 0x6Cu8 { return invalid }
    if bytes[else_keyword.start + 2usize] != 0x73u8 { return invalid }
    if bytes[else_keyword.start + 3usize] != 0x65u8 { return invalid }
    if else_open.kind != 3u8 { return invalid }
    if bytes[else_open.start] != 0x7Bu8 { return invalid }
    if else_literal.kind != 2u8 { return invalid }
    if else_close.kind != 3u8 { return invalid }
    if bytes[else_close.start] != 0x7Du8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    if return_operator.kind != 3u8 { return invalid }
    if bytes[return_operator.start] != 0x2Bu8 { return invalid }
    if return_literal.kind != 2u8 { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedIfValueContinuationSpans {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        if_start: if_token.start,
        if_end: else_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        then_start: then_literal.start,
        then_end: then_literal.end,
        else_start: else_literal.start,
        else_end: else_literal.end,
        continuation_start: return_name.start,
        continuation_end: return_literal.end,
        continuation_name_end: return_name.end,
        continuation_literal_start: return_literal.start,
        continuation_literal_end: return_literal.end,
    }
}

fn stage2_parse_typed_if_return_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedIfReturnSpans {
    let invalid: Stage2TypedIfReturnSpans = Stage2TypedIfReturnSpans {
        valid: false,
        if_start: 0usize,
        if_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        then_start: 0usize,
        then_end: 0usize,
        else_start: 0usize,
        else_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let return_keyword: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let if_token: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, if_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let then_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let then_literal: TokenInfo = scan_token_info(bytes, then_open.end, body_end_exclusive)
    let then_close: TokenInfo = scan_token_info(bytes, then_literal.end, body_end_exclusive)
    let else_keyword: TokenInfo = scan_token_info(bytes, then_close.end, body_end_exclusive)
    let else_open: TokenInfo = scan_token_info(bytes, else_keyword.end, body_end_exclusive)
    let else_literal: TokenInfo = scan_token_info(bytes, else_open.end, body_end_exclusive)
    let else_close: TokenInfo = scan_token_info(bytes, else_literal.end, body_end_exclusive)
    let semicolon: TokenInfo = scan_token_info(bytes, else_close.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if if_token.kind != 1u8 { return invalid }
    if if_token.end - if_token.start != 2usize { return invalid }
    if bytes[if_token.start] != 0x69u8 { return invalid }
    if bytes[if_token.start + 1usize] != 0x66u8 { return invalid }
    if condition_left.kind != 2u8 { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Eu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if then_open.kind != 3u8 { return invalid }
    if bytes[then_open.start] != 0x7Bu8 { return invalid }
    if then_literal.kind != 2u8 { return invalid }
    if then_close.kind != 3u8 { return invalid }
    if bytes[then_close.start] != 0x7Du8 { return invalid }
    if else_keyword.kind != 1u8 { return invalid }
    if else_keyword.end - else_keyword.start != 4usize { return invalid }
    if bytes[else_keyword.start] != 0x65u8 { return invalid }
    if bytes[else_keyword.start + 1usize] != 0x6Cu8 { return invalid }
    if bytes[else_keyword.start + 2usize] != 0x73u8 { return invalid }
    if bytes[else_keyword.start + 3usize] != 0x65u8 { return invalid }
    if else_open.kind != 3u8 { return invalid }
    if bytes[else_open.start] != 0x7Bu8 { return invalid }
    if else_literal.kind != 2u8 { return invalid }
    if else_close.kind != 3u8 { return invalid }
    if bytes[else_close.start] != 0x7Du8 { return invalid }
    if semicolon.kind != 3u8 { return invalid }
    if bytes[semicolon.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedIfReturnSpans {
        valid: true,
        if_start: if_token.start,
        if_end: else_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        then_start: then_literal.start,
        then_end: then_literal.end,
        else_start: else_literal.start,
        else_end: else_literal.end,
    }
}

fn stage2_parse_typed_assignment_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedAssignmentSpans {
    let invalid: Stage2TypedAssignmentSpans = Stage2TypedAssignmentSpans {
        valid: false,
        declaration_statement_start: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        initializer_start: 0usize,
        initializer_end: 0usize,
        assign_start: 0usize,
        assign_end: 0usize,
        assign_target_end: 0usize,
        assign_use_start: 0usize,
        assign_use_end: 0usize,
        assign_literal_start: 0usize,
        assign_literal_end: 0usize,
        assign_binary_start: 0usize,
        assign_binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let initializer: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, initializer.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if initializer.kind != 2u8 { return invalid }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    let assign_target: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let assign_equals: TokenInfo = scan_token_info(bytes, assign_target.end, body_end_exclusive)
    let assign_use: TokenInfo = scan_token_info(bytes, assign_equals.end, body_end_exclusive)
    let assign_operator: TokenInfo = scan_token_info(bytes, assign_use.end, body_end_exclusive)
    let assign_literal: TokenInfo = scan_token_info(bytes, assign_operator.end, body_end_exclusive)
    let assign_tail: TokenInfo = scan_token_info(bytes, assign_literal.end, body_end_exclusive)
    if assign_target.kind != 1u8 { return invalid }
    if assign_equals.kind != 3u8 { return invalid }
    if bytes[assign_equals.start] != 0x3Du8 { return invalid }
    if assign_use.kind != 1u8 { return invalid }
    if assign_operator.kind != 3u8 { return invalid }
    if bytes[assign_operator.start] != 0x2Bu8 { return invalid }
    if assign_literal.kind != 2u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, assign_target.start, assign_target.end) { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, assign_use.start, assign_use.end) { return invalid }
    if assign_tail.kind != 3u8 { return invalid }
    if bytes[assign_tail.start] != 0x3Bu8 { return invalid }
    let return_keyword: TokenInfo = scan_token_info(bytes, assign_tail.end, body_end_exclusive)
    let return_use: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_use.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_use.kind != 1u8 { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_use.start, return_use.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedAssignmentSpans {
        valid: true,
        declaration_statement_start: let_token.start,
        declaration_start: name.start,
        declaration_end: name.end,
        initializer_start: initializer.start,
        initializer_end: initializer.end,
        assign_start: assign_target.start,
        assign_end: assign_tail.end,
        assign_target_end: assign_target.end,
        assign_use_start: assign_use.start,
        assign_use_end: assign_use.end,
        assign_literal_start: assign_literal.start,
        assign_literal_end: assign_literal.end,
        assign_binary_start: assign_use.start,
        assign_binary_end: assign_literal.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_use.start,
        return_use_end: return_use.end,
    }
}

fn stage2_typed_sequence_spans(
    bytes: read Slice<UInt8>,
    local_declaration_start: UIntSize,
    local_declaration_end: UIntSize,
    local_return_start: UIntSize,
    local_return_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedSequenceSpans {
    let invalid: Stage2TypedSequenceSpans = Stage2TypedSequenceSpans {
        valid: false,
        let_start: 0usize,
        let_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if body_end <= body_start + 1usize {
        return invalid
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let first_operand: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let operator: TokenInfo = scan_token_info(bytes, first_operand.end, body_end_exclusive)
    let second_operand: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, second_operand.end, body_end_exclusive)
    if let_token.kind != 1u8 {
        return invalid
    }
    if let_token.end - let_token.start != 3usize {
        return invalid
    }
    if bytes[let_token.start] != 0x6Cu8 {
        return invalid
    }
    if bytes[let_token.start + 1usize] != 0x65u8 {
        return invalid
    }
    if bytes[let_token.start + 2usize] != 0x74u8 {
        return invalid
    }
    if name.start != local_declaration_start {
        return invalid
    }
    if name.end != local_declaration_end {
        return invalid
    }
    if declaration_tail.kind == 3u8 {
        if declaration_tail.start >= body_end_exclusive {
            return invalid
        }
        if bytes[declaration_tail.start] != 0x3Bu8 {
            return invalid
        }
    } else if declaration_tail.kind != 1u8 {
        return invalid
    }
    let let_end: UIntSize = if declaration_tail.kind == 3u8 { declaration_tail.end } else { second_operand.end }
    if let_end >= local_return_start {
        return invalid
    }
    if local_return_end <= local_return_start {
        return invalid
    }
    return Stage2TypedSequenceSpans {
        valid: true,
        let_start: let_token.start,
        let_end: let_end,
        return_start: local_return_start,
        return_end: local_return_end,
    }
}

fn stage2_typed_two_local_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedTwoLocalSpans {
    let invalid: Stage2TypedTwoLocalSpans = Stage2TypedTwoLocalSpans {
        valid: false,
        first_let_start: 0usize,
        first_let_end: 0usize,
        second_let_start: 0usize,
        second_let_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if body_end <= body_start + 1usize {
        return invalid
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let first_let: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let first_name: TokenInfo = scan_token_info(bytes, first_let.end, body_end_exclusive)
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_end_exclusive)
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_type.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_end: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    let second_start: UIntSize = if first_end.kind == 3u8 { first_end.end } else { first_end.start }
    let second_let: TokenInfo = scan_token_info(bytes, second_start, body_end_exclusive)
    let second_name: TokenInfo = scan_token_info(bytes, second_let.end, body_end_exclusive)
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_end_exclusive)
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_type.end, body_end_exclusive)
    let second_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let operator: TokenInfo = scan_token_info(bytes, second_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
    let second_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    let return_start: UIntSize = if second_end.kind == 3u8 { second_end.end } else { second_end.start }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if first_let.kind != 1u8 { return invalid }
    if first_name.kind != 1u8 { return invalid }
    if first_colon.kind != 3u8 { return invalid }
    if first_type.kind != 1u8 { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if second_let.kind != 1u8 { return invalid }
    if second_name.kind != 1u8 { return invalid }
    if second_colon.kind != 3u8 { return invalid }
    if second_type.kind != 1u8 { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if second_use.kind != 1u8 { return invalid }
    if operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
    }
    let final_return_end: UIntSize = if return_end.kind == 0u8 { return_name.end } else { return_end.end }
    return Stage2TypedTwoLocalSpans {
        valid: true,
        first_let_start: first_let.start,
        first_let_end: first_end.end,
        second_let_start: second_let.start,
        second_let_end: second_end.end,
        return_start: return_keyword.start,
        return_end: final_return_end,
    }
}

fn stage2_typed_sequence_summary(
    source_bytes: UIntSize,
    statements_required: UIntSize,
    statements_emitted: UIntSize,
    ast_nodes_required: UIntSize,
    ast_nodes_emitted: UIntSize,
    errors: UIntSize,
    status_flags: UIntSize,
) -> TypedStatementStage2Summary {
    return TypedStatementStage2Summary {
        source_bytes: source_bytes,
        statements_required: statements_required,
        statements_emitted: statements_emitted,
        ast_nodes_required: ast_nodes_required,
        ast_nodes_emitted: ast_nodes_emitted,
        errors: errors,
        status_flags: status_flags,
        reserved: 0usize,
    }
}

fn stage2_typed_assignment_summary(
    source_bytes: UIntSize,
    statements_required: UIntSize,
    statements_emitted: UIntSize,
    ast_nodes_required: UIntSize,
    ast_nodes_emitted: UIntSize,
    errors: UIntSize,
    status_flags: UIntSize,
) -> TypedStatementStage2Summary {
    return TypedStatementStage2Summary {
        source_bytes: source_bytes,
        statements_required: statements_required,
        statements_emitted: statements_emitted,
        ast_nodes_required: ast_nodes_required,
        ast_nodes_emitted: ast_nodes_emitted,
        errors: errors,
        status_flags: status_flags,
        reserved: 0usize,
    }
}

/// Emits the first explicit mutable-local statement sequence.  The native
/// producer owns source validation and typed metadata; the Rust Stage-2
/// consumer owns the lowering to real stack mutation.
@export(name: "jadren_selfhost_parse_typed_statement_assignment_sequence", abi: "C")
@noalloc
pub fn parse_typed_statement_assignment_sequence(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    if function_headers[0].name_start != shape.name_start { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    if function_headers[0].name_end != shape.name_end { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    if function_headers[0].parameter_count != 0usize { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    if function_headers[0].body_start != shape.body_start { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    if function_headers[0].body_end != shape.body_end { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    let spans: Stage2TypedAssignmentSpans = stage2_parse_typed_assignment_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_assignment_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var statement_capacity: UIntSize = 0usize
    for _statement in statements.indices { statement_capacity = statement_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let statements_required: UIntSize = 3usize
    let ast_nodes_required: UIntSize = 5usize
    var statements_emitted: UIntSize = statement_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if statement_capacity > 0usize { statements[0] = TypedStatementHeader { kind: 1u8, flags: 1u8, type_kind: 2u8, reserved: 0u8, target_start: spans.declaration_start, target_end: spans.declaration_end, expression_node: 0usize, start: spans.declaration_statement_start, end: spans.initializer_end + 1usize } }
    if statement_capacity > 1usize { statements[1] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.assign_start, target_end: spans.assign_target_end, expression_node: 3usize, start: spans.assign_start, end: spans.assign_end } }
    if statement_capacity > 2usize { statements[2] = TypedStatementHeader { kind: 3u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 4usize, start: spans.return_start, end: spans.return_end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.assign_use_start, end: spans.assign_use_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.assign_literal_start, end: spans.assign_literal_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.assign_binary_start, end: spans.assign_binary_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    var status: UIntSize = 3usize
    if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } }
    return stage2_typed_assignment_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits one bounded typed `if ... else ...` return header and its post-order
/// expression AST. The native producer owns source validation; the Rust
/// Stage-2 consumer owns the actual CFG lowering and verification.
@export(name: "jadren_selfhost_parse_typed_if_return", abi: "C")
@noalloc
pub fn parse_typed_if_return(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedIfReturnHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
    }
    let spans: Stage2TypedIfReturnSpans = stage2_parse_typed_if_return_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let ast_nodes_required: UIntSize = 5usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize {
        control[0] = TypedIfReturnHeader {
            condition_node: 2usize,
            then_node: 3usize,
            else_node: 4usize,
            start: spans.if_start,
            end: spans.if_end,
            kind: 1u8,
            type_kind: 2u8,
            reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        }
    }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 1usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.then_start, end: spans.then_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.else_start, end: spans.else_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } }
    return stage2_typed_sequence_summary(source_length, controls_required, controls_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits one bounded typed `if` value, its immutable continuation binding and
/// one post-join binary expression. The Rust Stage-2 consumer owns block
/// parameter creation and continuation lowering.
@export(name: "jadren_selfhost_parse_typed_if_value_continuation", abi: "C")
@noalloc
pub fn parse_typed_if_value_continuation(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedIfReturnHeader>,
    continuation: write Slice<TypedIfValueContinuationHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
    }
    let spans: Stage2TypedIfValueContinuationSpans = stage2_parse_typed_if_value_continuation_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
    }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var continuation_capacity: UIntSize = 0usize
    for _header in continuation.indices { continuation_capacity = continuation_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let continuation_required: UIntSize = 1usize
    let ast_nodes_required: UIntSize = 8usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var continuation_emitted: UIntSize = continuation_capacity
    if continuation_emitted > continuation_required { continuation_emitted = continuation_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize {
        control[0] = TypedIfReturnHeader {
            condition_node: 2usize,
            then_node: 3usize,
            else_node: 4usize,
            start: spans.if_start,
            end: spans.if_end,
            kind: 2u8,
            type_kind: 2u8,
            reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        }
    }
    if continuation_capacity > 0usize {
        continuation[0] = TypedIfValueContinuationHeader {
            continuation_node: 7usize,
            binding_name_start: spans.declaration_start,
            binding_name_end: spans.declaration_end,
            type_kind: 2u8,
            reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        }
    }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 1usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.then_start, end: spans.then_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.else_start, end: spans.else_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.continuation_start, end: spans.continuation_name_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.continuation_literal_start, end: spans.continuation_literal_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.continuation_start, end: spans.continuation_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required {
        if continuation_emitted == continuation_required {
            if ast_nodes_emitted == ast_nodes_required { status = 7usize }
        }
    }
    return stage2_typed_sequence_summary(source_length, controls_required, controls_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits one bounded typed `if` value, a mutable local binding and one
/// post-join assignment expression. The Rust Stage-2 consumer materialises
/// the merged value in a stack slot and lowers `value = value + 1` with a
/// verified Store before returning the assigned value.
@export(name: "jadren_selfhost_parse_typed_if_value_local_assignment", abi: "C")
@noalloc
pub fn parse_typed_if_value_local_assignment(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedIfReturnHeader>,
    continuation: write Slice<TypedIfValueLocalAssignmentHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedIfValueLocalAssignmentSpans = stage2_parse_typed_if_value_local_assignment_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var continuation_capacity: UIntSize = 0usize
    for _header in continuation.indices { continuation_capacity = continuation_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let continuation_required: UIntSize = 1usize
    let ast_nodes_required: UIntSize = 8usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var continuation_emitted: UIntSize = continuation_capacity
    if continuation_emitted > continuation_required { continuation_emitted = continuation_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedIfReturnHeader { condition_node: 2usize, then_node: 3usize, else_node: 4usize, start: spans.if_start, end: spans.if_end, kind: 2u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if continuation_capacity > 0usize { continuation[0] = TypedIfValueLocalAssignmentHeader { continuation_node: 7usize, binding_name_start: spans.declaration_start, binding_name_end: spans.declaration_end, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 1usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.then_start, end: spans.then_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.else_start, end: spans.else_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.assignment_use_start, end: spans.assignment_use_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.assignment_literal_start, end: spans.assignment_literal_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.assignment_use_start, end: spans.assignment_literal_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if continuation_emitted == continuation_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } }
    return stage2_typed_sequence_summary(source_length, controls_required, controls_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits the first native producer typed `while` hand-off. The caller owns the
/// control, local binding, body statement and AST buffers; Rust Stage-2 owns
/// the verified loop lowering.
@export(name: "jadren_selfhost_parse_typed_while_local", abi: "C")
@noalloc
pub fn parse_typed_while_local(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    // The source driver has already validated exactly one function header.
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedWhileSpans = stage2_parse_typed_while_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = if spans.second_conditional_control { 14usize } else if spans.conditional_control { 11usize } else { 8usize }
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > controls_required { bindings_emitted = controls_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.while_start, end: spans.while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.declaration_start, name_end: spans.declaration_end, type_kind: 2u8 } }
    if body_capacity > 0usize { body[0] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.body_target_start, target_end: spans.body_target_end, expression_node: 6usize, start: spans.body_start, end: spans.body_end } }
    if body_capacity > 1usize { body[1] = TypedStatementHeader { kind: spans.control_kind, flags: if spans.conditional_control { 2u8 } else { 0u8 }, type_kind: if spans.conditional_control { 1u8 } else { 0u8 }, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: if spans.conditional_control { 9usize } else { 0usize }, start: spans.break_start, end: spans.break_end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.body_use_start, end: spans.body_use_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.body_literal_start, end: spans.body_literal_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 4usize, right: 5usize, aux: 0usize, start: spans.body_use_start, end: spans.body_literal_end } }
    if !spans.conditional_control {
        if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    }
    if spans.conditional_control {
        if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.control_condition_left_start, end: spans.control_condition_left_end } }
        if ast_capacity > 8usize { ast[8] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.control_condition_right_start, end: spans.control_condition_right_end } }
        if ast_capacity > 9usize { ast[9] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 7usize, right: 8usize, aux: 0usize, start: spans.control_condition_left_start, end: spans.control_condition_right_end } }
        if spans.second_conditional_control {
            if body_capacity > 2usize { body[2] = TypedStatementHeader { kind: spans.second_control_kind, flags: 2u8, type_kind: 1u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 12usize, start: spans.second_break_start, end: spans.second_break_end } }
            if ast_capacity > 10usize { ast[10] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_control_condition_left_start, end: spans.second_control_condition_left_end } }
            if ast_capacity > 11usize { ast[11] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_control_condition_right_start, end: spans.second_control_condition_right_end } }
            if ast_capacity > 12usize { ast[12] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 10usize, right: 11usize, aux: 0usize, start: spans.second_control_condition_left_start, end: spans.second_control_condition_right_end } }
            if ast_capacity > 13usize { ast[13] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
        } else if ast_capacity > 10usize { ast[10] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if bindings_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits a caller-owned dynamic assignment list for a bounded typed `while`.
/// The required body and AST counts are discovered from the source during the
/// sizing pass; the second pass re-scans each assignment and fills only the
/// capacity supplied by the host. This is the first non-fixed statement-list
/// producer contract; control statements and nested blocks remain separate
/// later extensions.
@export(name: "jadren_selfhost_parse_typed_while_local_dynamic", abi: "C")
@noalloc
pub fn parse_typed_while_local_dynamic(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedWhileDynamicSpans = stage2_parse_typed_while_dynamic_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = spans.ast_nodes_required
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > controls_required { bindings_emitted = controls_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.while_start, end: spans.while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.declaration_start, name_end: spans.declaration_end, type_kind: 2u8 } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    var cursor: UIntSize = spans.loop_body_start
    var statement_index: UIntSize = 0usize
    while statement_index < statements_required {
        let target: TokenInfo = scan_token_info(bytes, cursor, spans.loop_body_end)
        let assignment_equals: TokenInfo = scan_token_info(bytes, target.end, spans.loop_body_end)
        let use: TokenInfo = scan_token_info(bytes, assignment_equals.end, spans.loop_body_end)
        let operator: TokenInfo = scan_token_info(bytes, use.end, spans.loop_body_end)
        let literal: TokenInfo = scan_token_info(bytes, operator.end, spans.loop_body_end)
        let tail: TokenInfo = scan_token_info(bytes, literal.end, spans.loop_body_end)
        let expression_right_kind: UInt8 = if literal.kind == 1u8 { 1u8 } else { 2u8 }
        let expression_node: UIntSize = 6usize + statement_index * 3usize
        let expression_left: UIntSize = 4usize + statement_index * 3usize
        if body_capacity > statement_index { body[statement_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: target.start, target_end: target.end, expression_node: expression_node, start: target.start, end: tail.end } }
        if ast_capacity > expression_left { ast[expression_left] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: use.start, end: use.end } }
        if ast_capacity > expression_left + 1usize { ast[expression_left + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: literal.start, end: literal.end } }
        if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: expression_left, right: expression_left + 1usize, aux: 0usize, start: use.start, end: literal.end } }
        cursor = tail.end
        statement_index = statement_index + 1usize
    }
    let return_node: UIntSize = 4usize + statements_required * 3usize
    if ast_capacity > return_node { ast[return_node] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if bindings_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits a dynamic caller-owned `while` list containing assignments and
/// conditional `break`/`continue` controls. The list is counted in sizing and
/// then re-scanned into the same fixed physical header ABI.
@export(name: "jadren_selfhost_parse_typed_while_local_dynamic_control", abi: "C")
@noalloc
pub fn parse_typed_while_local_dynamic_control(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedWhileDynamicSpans = stage2_parse_typed_while_dynamic_control_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = spans.ast_nodes_required
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > controls_required { bindings_emitted = controls_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.while_start, end: spans.while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.declaration_start, name_end: spans.declaration_end, type_kind: 2u8 } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    var cursor: UIntSize = spans.loop_body_start
    var statement_index: UIntSize = 0usize
    var ast_cursor: UIntSize = 4usize
    var emission_valid: Bool = true
    while statement_index < statements_required {
        var statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, spans.loop_body_end, spans.declaration_start, spans.declaration_end)
        if !statement.valid { statement = stage2_parse_dynamic_assignment_direct(bytes, cursor, spans.loop_body_end, spans.declaration_start, spans.declaration_end) }
        if !statement.valid { emission_valid = false; break }
        let conditional: Bool = if statement.kind == 4u8 { true } else { statement.kind == 5u8 }
        let mutable_declaration: Bool = statement.kind == 3u8
        var expression_node: UIntSize = ast_cursor
        var expression_node_count: UIntSize = statement.expression_node_count
        if conditional {
            if statement.expression_node_count != 3usize { emission_valid = false; break }
            expression_node = ast_cursor + 2usize
            if ast_capacity > ast_cursor { ast[ast_cursor] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_left_end } }
            if ast_capacity > ast_cursor + 1usize { ast[ast_cursor + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: statement.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_right_start, end: statement.expression_right_end } }
            if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: ast_cursor, right: ast_cursor + 1usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_right_end } }
        } else {
            let expression: Stage2TypedExpressionEmission = stage2_emit_typed_assignment_expression(bytes, statement.expression_left_start, statement.expression_right_end, ast, ast_capacity, ast_cursor)
            if !expression.valid { emission_valid = false; break }
            if expression.node_count != statement.expression_node_count { emission_valid = false; break }
            expression_node = expression.root_node
            expression_node_count = expression.node_count
        }
        if body_capacity > statement_index { body[statement_index] = TypedStatementHeader { kind: if mutable_declaration { 1u8 } else { statement.kind }, flags: if mutable_declaration { 1u8 } else { if conditional { 2u8 } else { 0u8 } }, type_kind: if conditional { 1u8 } else { 2u8 }, reserved: 0u8, target_start: if conditional { 0usize } else { statement.target_start }, target_end: if conditional { 0usize } else { statement.target_end }, expression_node: expression_node, start: statement.start, end: statement.end } }
        cursor = statement.next_cursor
        statement_index = statement_index + 1usize
        ast_cursor = ast_cursor + expression_node_count
    }
    if statement_index != statements_required { emission_valid = false }
    let return_node: UIntSize = ast_cursor
    if ast_capacity > return_node { ast[return_node] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    if ast_cursor + 1usize != ast_nodes_required { emission_valid = false }
    var status: UIntSize = 3usize
    if emission_valid { if controls_emitted == controls_required { if bindings_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } } }
    let errors: UIntSize = if emission_valid { 0usize } else { 24usize }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, errors, status)
}

/// Emits the native nested-`while` hand-off. Two caller-owned loop and binding
/// headers describe the outer and inner Int32 locals; the body keeps an ordered
/// outer-prefix, inner `var` initializer, dynamic inner assignment list and
/// outer-tail records while Stage-2 remains the sole CFG lowerer.
@export(name: "jadren_selfhost_parse_typed_nested_while_local", abi: "C")
@noalloc
pub fn parse_typed_nested_while_local(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedNestedWhileSpans = stage2_parse_typed_nested_while_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 2usize
    let bindings_required: UIntSize = 2usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = 8usize + spans.assignment_count * 3usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > bindings_required { bindings_emitted = bindings_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    var cursor: UIntSize = spans.outer_loop_body_start
    var assignment_index: UIntSize = 0usize
    var emission_valid: Bool = true
    var emission_error: UIntSize = 0usize
    var derived_inner_close_start: UIntSize = 0usize
    var derived_inner_close_end: UIntSize = 0usize
    var inner_cursor: UIntSize = spans.inner_loop_body_start
    var inner_statement_count: UIntSize = 0usize
    while inner_cursor < spans.outer_loop_body_end {
        let candidate: TokenInfo = scan_token_info(bytes, inner_cursor, spans.outer_loop_body_end)
        if candidate.start >= spans.outer_loop_body_end { emission_valid = false; emission_error = 21usize; break }
        if candidate.kind == 3u8 {
            if bytes[candidate.start] == 0x7Du8 {
                derived_inner_close_start = candidate.start
                derived_inner_close_end = candidate.end
                break
            }
        }
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, inner_cursor, spans.outer_loop_body_end, spans.inner_declaration_start, spans.inner_declaration_end)
        if !statement.valid { emission_valid = false; emission_error = 21usize; break }
        inner_cursor = statement.next_cursor
        inner_statement_count = inner_statement_count + 1usize
        if inner_statement_count > 4096usize { emission_valid = false; emission_error = 21usize; break }
    }
    let derived_inner_close_valid: Bool = if derived_inner_close_end > derived_inner_close_start { true } else { false }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.outer_while_start, end: spans.outer_while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if control_capacity > 1usize { control[1] = TypedWhileHeader { condition_node: 7usize, start: spans.inner_while_start, end: derived_inner_close_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.outer_declaration_start, name_end: spans.outer_declaration_end, type_kind: 2u8 } }
    if binding_capacity > 1usize { binding[1] = TypedNameBindingHeader { name_start: spans.inner_declaration_start, name_end: spans.inner_declaration_end, type_kind: 2u8 } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_initializer_start, end: spans.outer_initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_right_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_initializer_start, end: spans.inner_initializer_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_left_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_right_start, end: spans.inner_condition_right_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_right_end } }
    while cursor < spans.inner_initializer_statement_start {
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, spans.inner_initializer_statement_start, spans.outer_declaration_start, spans.outer_declaration_end)
        if !statement.valid { emission_valid = false; emission_error = 1usize; break }
        let expression_node: UIntSize = 10usize + assignment_index * 3usize
        let expression_left: UIntSize = expression_node - 2usize
        if body_capacity > assignment_index { body[assignment_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: statement.target_start, target_end: statement.target_end, expression_node: expression_node, start: statement.start, end: statement.end } }
        if ast_capacity > expression_left { ast[expression_left] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_left_end } }
        if ast_capacity > expression_left + 1usize { ast[expression_left + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: statement.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_right_start, end: statement.expression_right_end } }
        if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: expression_left, right: expression_left + 1usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_right_end } }
        cursor = statement.next_cursor
        assignment_index = assignment_index + 1usize
    }
    let inner_body_index: UIntSize = assignment_index
    if body_capacity > inner_body_index { body[inner_body_index] = TypedStatementHeader { kind: 1u8, flags: 1u8, type_kind: 2u8, reserved: 0u8, target_start: spans.inner_declaration_start, target_end: spans.inner_declaration_end, expression_node: 4usize, start: spans.inner_initializer_statement_start, end: spans.inner_initializer_statement_end } }
    assignment_index = assignment_index + 1usize
    var emit_inner_cursor: UIntSize = spans.inner_loop_body_start
    var emitted_inner_count: UIntSize = 0usize
    while emit_inner_cursor < derived_inner_close_start {
        let next: TokenInfo = scan_token_info(bytes, emit_inner_cursor, spans.outer_loop_body_end)
        if next.start >= derived_inner_close_start { break }
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, emit_inner_cursor, derived_inner_close_start, spans.inner_declaration_start, spans.inner_declaration_end)
        if !statement.valid { emission_valid = false; emission_error = 22usize; break }
        let body_index: UIntSize = assignment_index
        let expression_node: UIntSize = 10usize + (assignment_index - 1usize) * 3usize
        let expression_left: UIntSize = expression_node - 2usize
        if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: statement.target_start, target_end: statement.target_end, expression_node: expression_node, start: statement.start, end: statement.end } }
        if ast_capacity > expression_left { ast[expression_left] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_left_end } }
        if ast_capacity > expression_left + 1usize { ast[expression_left + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: statement.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_right_start, end: statement.expression_right_end } }
        if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: expression_left, right: expression_left + 1usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_right_end } }
        emit_inner_cursor = statement.next_cursor
        assignment_index = assignment_index + 1usize
        emitted_inner_count = emitted_inner_count + 1usize
        if emitted_inner_count > 4096usize { emission_valid = false; emission_error = 22usize; break }
    }
    var scan_cursor: UIntSize = derived_inner_close_end
    while scan_cursor < spans.outer_loop_body_end {
        let candidate: TokenInfo = scan_token_info(bytes, scan_cursor, spans.outer_loop_body_end)
        if candidate.start >= spans.outer_loop_body_end { break }
        if candidate.kind == 3u8 {
            if bytes[candidate.start] == 0x7Du8 { break }
        }
        let parsed: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, scan_cursor, spans.outer_loop_body_end, spans.outer_declaration_start, spans.outer_declaration_end)
        if !parsed.valid { emission_valid = false; emission_error = 32usize; break }
        let body_index: UIntSize = assignment_index
        let expression_node: UIntSize = 10usize + (assignment_index - 1usize) * 3usize
        let expression_left: UIntSize = expression_node - 2usize
        if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: parsed.target_start, target_end: parsed.target_end, expression_node: expression_node, start: parsed.start, end: parsed.end } }
        if ast_capacity > expression_left { ast[expression_left] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: parsed.expression_left_start, end: parsed.expression_left_end } }
        if ast_capacity > expression_left + 1usize { ast[expression_left + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: parsed.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: parsed.expression_right_start, end: parsed.expression_right_end } }
        if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: expression_left, right: expression_left + 1usize, aux: 0usize, start: parsed.expression_left_start, end: parsed.expression_right_end } }
        scan_cursor = parsed.next_cursor
        assignment_index = assignment_index + 1usize
    }
    var status: UIntSize = 3usize
    if !derived_inner_close_valid { status = 24usize; emission_error = 41usize }
    if !emission_valid { status = 24usize }
    if emission_valid { if assignment_index - 1usize != spans.assignment_count { status = 24usize; emission_error = 4200usize + assignment_index * 100usize + spans.assignment_count } }
    if emission_valid { if controls_emitted == controls_required { if bindings_emitted == bindings_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, emission_error, status)
}

/// Emits a bounded nested `while` hand-off with one or two conditional inner
/// `break`/`continue` controls. The shared `TypedStatementHeader` ABI keeps
/// the controls after the inner assignment and the shared post-order AST
/// carries their Bool comparisons; Stage-2 remains the CFG owner.
@export(name: "jadren_selfhost_parse_typed_nested_while_local_conditional", abi: "C")
@noalloc
pub fn parse_typed_nested_while_local_conditional(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedNestedWhileSpans = stage2_parse_typed_nested_while_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    if spans.body_count != 5usize { if spans.body_count != 6usize { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) } }
    if spans.conditional_control_count != 1usize { if spans.conditional_control_count != 2usize { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) } }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 2usize
    let bindings_required: UIntSize = 2usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = 17usize + spans.conditional_control_count * 3usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > bindings_required { bindings_emitted = bindings_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    let outer_prefix: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, spans.outer_loop_body_start, spans.inner_initializer_statement_start, spans.outer_declaration_start, spans.outer_declaration_end)
    let inner_assignment: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, spans.inner_loop_body_start, spans.inner_loop_body_end, spans.inner_declaration_start, spans.inner_declaration_end)
    let inner_control: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, inner_assignment.next_cursor, spans.inner_loop_body_end, spans.inner_declaration_start, spans.inner_declaration_end)
    let second_inner_control: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, inner_control.next_cursor, spans.inner_loop_body_end, spans.inner_declaration_start, spans.inner_declaration_end)
    let outer_tail: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, spans.inner_while_end, spans.outer_loop_body_end, spans.outer_declaration_start, spans.outer_declaration_end)
    var emission_valid: Bool = outer_prefix.valid
    if !inner_assignment.valid { emission_valid = false }
    if !inner_control.valid { emission_valid = false }
    if inner_control.kind != 4u8 { if inner_control.kind != 5u8 { emission_valid = false } }
    if spans.conditional_control_count == 2usize {
        if !second_inner_control.valid { emission_valid = false }
        if second_inner_control.kind != 4u8 { if second_inner_control.kind != 5u8 { emission_valid = false } }
    }
    if !outer_tail.valid { emission_valid = false }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.outer_while_start, end: spans.outer_while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if control_capacity > 1usize { control[1] = TypedWhileHeader { condition_node: 7usize, start: spans.inner_while_start, end: spans.inner_while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.outer_declaration_start, name_end: spans.outer_declaration_end, type_kind: 2u8 } }
    if binding_capacity > 1usize { binding[1] = TypedNameBindingHeader { name_start: spans.inner_declaration_start, name_end: spans.inner_declaration_end, type_kind: 2u8 } }
    if body_capacity > 0usize { body[0] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: outer_prefix.target_start, target_end: outer_prefix.target_end, expression_node: 10usize, start: outer_prefix.start, end: outer_prefix.end } }
    if body_capacity > 1usize { body[1] = TypedStatementHeader { kind: 1u8, flags: 1u8, type_kind: 2u8, reserved: 0u8, target_start: spans.inner_declaration_start, target_end: spans.inner_declaration_end, expression_node: 4usize, start: spans.inner_initializer_statement_start, end: spans.inner_initializer_statement_end } }
    if body_capacity > 2usize { body[2] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: inner_assignment.target_start, target_end: inner_assignment.target_end, expression_node: 13usize, start: inner_assignment.start, end: inner_assignment.end } }
    if body_capacity > 3usize { body[3] = TypedStatementHeader { kind: inner_control.kind, flags: 2u8, type_kind: 1u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 19usize, start: inner_control.start, end: inner_control.end } }
    if spans.conditional_control_count == 2usize {
        if body_capacity > 4usize { body[4] = TypedStatementHeader { kind: second_inner_control.kind, flags: 2u8, type_kind: 1u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 22usize, start: second_inner_control.start, end: second_inner_control.end } }
        if body_capacity > 5usize { body[5] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: outer_tail.target_start, target_end: outer_tail.target_end, expression_node: 16usize, start: outer_tail.start, end: outer_tail.end } }
    } else if body_capacity > 4usize { body[4] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: outer_tail.target_start, target_end: outer_tail.target_end, expression_node: 16usize, start: outer_tail.start, end: outer_tail.end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_initializer_start, end: spans.outer_initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_right_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_initializer_start, end: spans.inner_initializer_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_left_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_right_start, end: spans.inner_condition_right_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_right_end } }
    if ast_capacity > 8usize { ast[8] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: outer_prefix.expression_left_start, end: outer_prefix.expression_left_end } }
    if ast_capacity > 9usize { ast[9] = TypedExpressionAstNodeHeader { syntax_kind: outer_prefix.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: outer_prefix.expression_right_start, end: outer_prefix.expression_right_end } }
    if ast_capacity > 10usize { ast[10] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 8usize, right: 9usize, aux: 0usize, start: outer_prefix.expression_left_start, end: outer_prefix.expression_right_end } }
    if ast_capacity > 11usize { ast[11] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: inner_assignment.expression_left_start, end: inner_assignment.expression_left_end } }
    if ast_capacity > 12usize { ast[12] = TypedExpressionAstNodeHeader { syntax_kind: inner_assignment.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: inner_assignment.expression_right_start, end: inner_assignment.expression_right_end } }
    if ast_capacity > 13usize { ast[13] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 11usize, right: 12usize, aux: 0usize, start: inner_assignment.expression_left_start, end: inner_assignment.expression_right_end } }
    if ast_capacity > 14usize { ast[14] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: outer_tail.expression_left_start, end: outer_tail.expression_left_end } }
    if ast_capacity > 15usize { ast[15] = TypedExpressionAstNodeHeader { syntax_kind: outer_tail.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: outer_tail.expression_right_start, end: outer_tail.expression_right_end } }
    if ast_capacity > 16usize { ast[16] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 14usize, right: 15usize, aux: 0usize, start: outer_tail.expression_left_start, end: outer_tail.expression_right_end } }
    if ast_capacity > 17usize { ast[17] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: inner_control.expression_left_start, end: inner_control.expression_left_end } }
    if ast_capacity > 18usize { ast[18] = TypedExpressionAstNodeHeader { syntax_kind: inner_control.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: inner_control.expression_right_start, end: inner_control.expression_right_end } }
    if ast_capacity > 19usize { ast[19] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 17usize, right: 18usize, aux: 0usize, start: inner_control.expression_left_start, end: inner_control.expression_right_end } }
    if spans.conditional_control_count == 2usize {
        if ast_capacity > 20usize { ast[20] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: second_inner_control.expression_left_start, end: second_inner_control.expression_left_end } }
        if ast_capacity > 21usize { ast[21] = TypedExpressionAstNodeHeader { syntax_kind: second_inner_control.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: second_inner_control.expression_right_start, end: second_inner_control.expression_right_end } }
        if ast_capacity > 22usize { ast[22] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 20usize, right: 21usize, aux: 0usize, start: second_inner_control.expression_left_start, end: second_inner_control.expression_right_end } }
    }
    var status: UIntSize = 3usize
    if emission_valid { if controls_emitted == controls_required { if bindings_emitted == bindings_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } } }
    let errors: UIntSize = if emission_valid { 0usize } else { 24usize }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, errors, status)
}

/// Emits a dynamic nested `while` body whose inner statement list may contain
/// three or more conditional `break`/`continue` controls. The physical capture
/// headers remain unchanged; only the caller-owned body and AST slices grow.
@export(name: "jadren_selfhost_parse_typed_nested_while_local_dynamic_control", abi: "C")
@noalloc
pub fn parse_typed_nested_while_local_dynamic_control(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedNestedWhileSpans = stage2_parse_typed_nested_while_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    if spans.conditional_control_count < 1usize { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 2usize
    let bindings_required: UIntSize = 2usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = spans.ast_nodes_required
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > bindings_required { bindings_emitted = bindings_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    let outer_prefix: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, spans.outer_loop_body_start, spans.inner_initializer_statement_start, spans.outer_declaration_start, spans.outer_declaration_end)
    var emission_valid: Bool = outer_prefix.valid
    var body_index: UIntSize = 0usize
    var ast_cursor: UIntSize = 8usize
    var cursor: UIntSize = spans.outer_loop_body_start
    while cursor < spans.inner_initializer_statement_start {
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, spans.inner_initializer_statement_start, spans.outer_declaration_start, spans.outer_declaration_end)
        if !statement.valid { emission_valid = false; break }
        let expression: Stage2TypedExpressionEmission = stage2_emit_typed_assignment_expression(bytes, statement.expression_left_start, statement.expression_right_end, ast, ast_capacity, ast_cursor)
        if !expression.valid { emission_valid = false; break }
        if expression.node_count != statement.expression_node_count { emission_valid = false; break }
        let expression_node: UIntSize = expression.root_node
        if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: statement.target_start, target_end: statement.target_end, expression_node: expression_node, start: statement.start, end: statement.end } }
        cursor = statement.next_cursor
        body_index = body_index + 1usize
        ast_cursor = ast_cursor + statement.expression_node_count
    }
    if cursor != spans.inner_initializer_statement_start { emission_valid = false }
    if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: 1u8, flags: 1u8, type_kind: 2u8, reserved: 0u8, target_start: spans.inner_declaration_start, target_end: spans.inner_declaration_end, expression_node: 4usize, start: spans.inner_initializer_statement_start, end: spans.inner_initializer_statement_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_initializer_start, end: spans.inner_initializer_end } }
    body_index = body_index + 1usize
    cursor = spans.inner_loop_body_start
    while cursor < spans.inner_loop_body_end {
        let next: TokenInfo = scan_token_info(bytes, cursor, spans.inner_loop_body_end)
        if next.start >= spans.inner_loop_body_end { cursor = spans.inner_loop_body_end; break }
        if next.kind == 3u8 {
            if bytes[next.start] == 0x7Du8 { cursor = spans.inner_loop_body_end; break }
        }
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_while_dynamic_body_span(bytes, cursor, spans.inner_loop_body_end, spans.inner_declaration_start, spans.inner_declaration_end)
        if !statement.valid { emission_valid = false; break }
        let conditional: Bool = if statement.kind == 4u8 { true } else { statement.kind == 5u8 }
        var expression_node: UIntSize = ast_cursor
        var expression_node_count: UIntSize = 3usize
        if conditional {
            expression_node = ast_cursor + 2usize
            if ast_capacity > ast_cursor { ast[ast_cursor] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_left_end } }
            if ast_capacity > ast_cursor + 1usize { ast[ast_cursor + 1usize] = TypedExpressionAstNodeHeader { syntax_kind: statement.expression_right_kind, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: statement.expression_right_start, end: statement.expression_right_end } }
            if ast_capacity > expression_node { ast[expression_node] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: ast_cursor, right: ast_cursor + 1usize, aux: 0usize, start: statement.expression_left_start, end: statement.expression_right_end } }
        } else {
            let expression: Stage2TypedExpressionEmission = stage2_emit_typed_assignment_expression(bytes, statement.expression_left_start, statement.expression_right_end, ast, ast_capacity, ast_cursor)
            if !expression.valid { emission_valid = false; break }
            if expression.node_count != statement.expression_node_count { emission_valid = false; break }
            expression_node = expression.root_node
            expression_node_count = expression.node_count
        }
        if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: statement.kind, flags: if conditional { 2u8 } else { 0u8 }, type_kind: if conditional { 1u8 } else { 2u8 }, reserved: 0u8, target_start: if conditional { 0usize } else { statement.target_start }, target_end: if conditional { 0usize } else { statement.target_end }, expression_node: expression_node, start: statement.start, end: statement.end } }
        cursor = statement.next_cursor
        body_index = body_index + 1usize
        ast_cursor = ast_cursor + expression_node_count
    }
    cursor = spans.inner_while_end
    while cursor < spans.outer_loop_body_end {
        let next: TokenInfo = scan_token_info(bytes, cursor, spans.outer_loop_body_end)
        if next.start >= spans.outer_loop_body_end { cursor = spans.outer_loop_body_end; break }
        if next.kind == 3u8 {
            if bytes[next.start] == 0x7Du8 { cursor = spans.outer_loop_body_end; break }
        }
        let statement: Stage2TypedWhileDynamicBodySpan = stage2_parse_typed_nested_outer_tail_span(bytes, cursor, spans.outer_loop_body_end, spans.outer_declaration_start, spans.outer_declaration_end, spans.inner_declaration_start, spans.inner_declaration_end)
        if !statement.valid { emission_valid = false; break }
        let expression: Stage2TypedExpressionEmission = stage2_emit_typed_assignment_expression(bytes, statement.expression_left_start, statement.expression_right_end, ast, ast_capacity, ast_cursor)
        if !expression.valid { emission_valid = false; break }
        if expression.node_count != statement.expression_node_count { emission_valid = false; break }
        let expression_node: UIntSize = expression.root_node
        if body_capacity > body_index { body[body_index] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: statement.target_start, target_end: statement.target_end, expression_node: expression_node, start: statement.start, end: statement.end } }
        cursor = statement.next_cursor
        body_index = body_index + 1usize
        ast_cursor = ast_cursor + statement.expression_node_count
    }
    if cursor != spans.outer_loop_body_end { emission_valid = false }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.outer_while_start, end: spans.outer_while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if control_capacity > 1usize { control[1] = TypedWhileHeader { condition_node: 7usize, start: spans.inner_while_start, end: spans.inner_while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.outer_declaration_start, name_end: spans.outer_declaration_end, type_kind: 2u8 } }
    if binding_capacity > 1usize { binding[1] = TypedNameBindingHeader { name_start: spans.inner_declaration_start, name_end: spans.inner_declaration_end, type_kind: 2u8 } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_initializer_start, end: spans.outer_initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.outer_condition_right_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.outer_condition_left_start, end: spans.outer_condition_right_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_left_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.inner_condition_right_start, end: spans.inner_condition_right_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.inner_condition_left_start, end: spans.inner_condition_right_end } }
    if body_index != statements_required { emission_valid = false }
    if ast_cursor != ast_nodes_required { emission_valid = false }
    var status: UIntSize = 3usize
    if emission_valid { if controls_emitted == controls_required { if bindings_emitted == bindings_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } } }
    let errors: UIntSize = if emission_valid { 0usize } else { 24usize }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, errors, status)
}

/// Emits the first native-producer ordered multi-statement `while` hand-off.
/// The shape is deliberately bounded to two assignments so the capture carries
/// a real statement list while the existing Stage-2 lowerer remains the single
/// owner of CFG construction and mutation validation.
@export(name: "jadren_selfhost_parse_typed_while_local_statements", abi: "C")
@noalloc
pub fn parse_typed_while_local_statements(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedWhileStatementsSpans = stage2_parse_typed_while_statements_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = spans.body_count
    let ast_nodes_required: UIntSize = if spans.body_count == 3usize { 14usize } else { 11usize }
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > controls_required { bindings_emitted = controls_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.while_start, end: spans.while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.declaration_start, name_end: spans.declaration_end, type_kind: 2u8 } }
    if body_capacity > 0usize { body[0] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.first_target_start, target_end: spans.first_target_end, expression_node: 6usize, start: spans.first_start, end: spans.first_end } }
    if body_capacity > 1usize { body[1] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.second_target_start, target_end: spans.second_target_end, expression_node: 9usize, start: spans.second_start, end: spans.second_end } }
    if body_capacity > 2usize { body[2] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.third_target_start, target_end: spans.third_target_end, expression_node: 12usize, start: spans.third_start, end: spans.third_end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.first_use_start, end: spans.first_use_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.first_literal_start, end: spans.first_literal_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 4usize, right: 5usize, aux: 0usize, start: spans.first_use_start, end: spans.first_literal_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_use_start, end: spans.second_use_end } }
    if ast_capacity > 8usize { ast[8] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_literal_start, end: spans.second_literal_end } }
    if ast_capacity > 9usize { ast[9] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 7usize, right: 8usize, aux: 0usize, start: spans.second_use_start, end: spans.second_literal_end } }
    if ast_capacity > 10usize { ast[10] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.third_use_start, end: spans.third_use_end } }
    if ast_capacity > 11usize { ast[11] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.third_literal_start, end: spans.third_literal_end } }
    if ast_capacity > 12usize { ast[12] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 10usize, right: 11usize, aux: 0usize, start: spans.third_use_start, end: spans.third_literal_end } }
    if ast_capacity > 13usize { ast[13] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if bindings_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits the bounded body-local `let` plus outer-local assignment hand-off.
/// The lowerer owns the per-iteration local slot and its cleanup/visibility
/// rules; this producer only emits verified source spans and typed AST roots.
@export(name: "jadren_selfhost_parse_typed_while_local_body_let", abi: "C")
@noalloc
pub fn parse_typed_while_local_body_let(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedWhileHeader>,
    binding: write Slice<TypedNameBindingHeader>,
    body: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedWhileBodyLetSpans = stage2_parse_typed_while_body_let_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var binding_capacity: UIntSize = 0usize
    for _header in binding.indices { binding_capacity = binding_capacity + 1usize }
    var body_capacity: UIntSize = 0usize
    for _statement in body.indices { body_capacity = body_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = 2usize
    let ast_nodes_required: UIntSize = 9usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var bindings_emitted: UIntSize = binding_capacity
    if bindings_emitted > controls_required { bindings_emitted = controls_required }
    var statements_emitted: UIntSize = body_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedWhileHeader { condition_node: 3usize, start: spans.while_start, end: spans.while_end, kind: 3u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if binding_capacity > 0usize { binding[0] = TypedNameBindingHeader { name_start: spans.declaration_start, name_end: spans.declaration_end, type_kind: 2u8 } }
    if body_capacity > 0usize { body[0] = TypedStatementHeader { kind: 1u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.let_target_start, target_end: spans.let_target_end, expression_node: 6usize, start: spans.let_start, end: spans.let_end } }
    if body_capacity > 1usize { body[1] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.assign_target_start, target_end: spans.assign_target_end, expression_node: 7usize, start: spans.assign_start, end: spans.assign_end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.initializer_start, end: spans.initializer_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.let_use_start, end: spans.let_use_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.let_literal_start, end: spans.let_literal_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 4usize, right: 5usize, aux: 0usize, start: spans.let_use_start, end: spans.let_literal_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.assign_use_start, end: spans.assign_use_end } }
    if ast_capacity > 8usize { ast[8] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if bindings_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits a bounded two-assignment post-join tail using the reusable
/// `TypedStatementHeader` ABI. This is the first native producer hand-off
/// that keeps the explicit return in the statement list instead of encoding
/// it only in a continuation header.
@export(name: "jadren_selfhost_parse_typed_if_value_statement_tail", abi: "C")
@noalloc
pub fn parse_typed_if_value_statement_tail(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    control: write Slice<TypedIfReturnHeader>,
    continuation: write Slice<TypedIfValueContinuationHeader>,
    statements: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize) }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    let spans: Stage2TypedIfValueStatementTailSpans = stage2_parse_typed_if_value_statement_tail_spans(bytes, shape.body_start, shape.body_end)
    if !spans.valid { return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize) }
    var control_capacity: UIntSize = 0usize
    for _header in control.indices { control_capacity = control_capacity + 1usize }
    var continuation_capacity: UIntSize = 0usize
    for _header in continuation.indices { continuation_capacity = continuation_capacity + 1usize }
    var statement_capacity: UIntSize = 0usize
    for _statement in statements.indices { statement_capacity = statement_capacity + 1usize }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
    let controls_required: UIntSize = 1usize
    let statements_required: UIntSize = 3usize
    let ast_nodes_required: UIntSize = 12usize
    var controls_emitted: UIntSize = control_capacity
    if controls_emitted > controls_required { controls_emitted = controls_required }
    var continuation_emitted: UIntSize = continuation_capacity
    if continuation_emitted > controls_required { continuation_emitted = controls_required }
    var statements_emitted: UIntSize = statement_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if control_capacity > 0usize { control[0] = TypedIfReturnHeader { condition_node: 2usize, then_node: 3usize, else_node: 4usize, start: spans.if_start, end: spans.if_end, kind: 2u8, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if continuation_capacity > 0usize { continuation[0] = TypedIfValueContinuationHeader { continuation_node: 0usize, binding_name_start: spans.declaration_start, binding_name_end: spans.declaration_end, type_kind: 2u8, reserved: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8] } }
    if statement_capacity > 0usize { statements[0] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.first_start, target_end: spans.first_start + (spans.first_use_end - spans.first_use_start), expression_node: 7usize, start: spans.first_start, end: spans.first_end } }
    if statement_capacity > 1usize { statements[1] = TypedStatementHeader { kind: 2u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: spans.second_start, target_end: spans.second_start + (spans.second_use_end - spans.second_use_start), expression_node: 10usize, start: spans.second_start, end: spans.second_end } }
    if statement_capacity > 2usize { statements[2] = TypedStatementHeader { kind: 3u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 11usize, start: spans.return_start, end: spans.return_end } }
    if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_left_end } }
    if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.condition_right_start, end: spans.condition_right_end } }
    if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 1u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 1usize, aux: 0usize, start: spans.condition_left_start, end: spans.condition_right_end } }
    if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.then_start, end: spans.then_end } }
    if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.else_start, end: spans.else_end } }
    if ast_capacity > 5usize { ast[5] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.first_use_start, end: spans.first_use_end } }
    if ast_capacity > 6usize { ast[6] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.first_literal_start, end: spans.first_literal_end } }
    if ast_capacity > 7usize { ast[7] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 5usize, right: 6usize, aux: 0usize, start: spans.first_use_start, end: spans.first_literal_end } }
    if ast_capacity > 8usize { ast[8] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_use_start, end: spans.second_use_end } }
    if ast_capacity > 9usize { ast[9] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.second_literal_start, end: spans.second_literal_end } }
    if ast_capacity > 10usize { ast[10] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 8usize, right: 9usize, aux: 0usize, start: spans.second_use_start, end: spans.second_literal_end } }
    if ast_capacity > 11usize { ast[11] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: spans.return_use_start, end: spans.return_use_end } }
    var status: UIntSize = 3usize
    if controls_emitted == controls_required { if continuation_emitted == controls_required { if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } } } }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

/// Emits the typed metadata for the first straight-line statement slice.  The
/// source parser, typed metadata and dense expression AST are all owned by
/// Jadren; callers only provide the output buffers. Unsupported sources return
/// status `24` so a host can continue with the existing generic Stage-2 path.
@export(name: "jadren_selfhost_parse_typed_statement_sequence", abi: "C")
@noalloc
pub fn parse_typed_statement_sequence(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: write Slice<TypedStatementHeader>,
    ast: write Slice<TypedExpressionAstNodeHeader>,
) -> TypedStatementStage2Summary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
    }
    if function_count != 1usize {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
    }
    if function_headers[0].name_start != shape.name_start {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].name_end != shape.name_end {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].body_start != shape.body_start {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].body_end != shape.body_end {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].parameter_count == 0usize {
        let two: Stage2TwoLocalBindingInfo = stage2_parse_two_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
        if !two.valid {
            return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
        }
        let two_spans: Stage2TypedTwoLocalSpans = stage2_typed_two_local_spans(bytes, shape.body_start, shape.body_end)
        if !two_spans.valid {
            return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
        }
        var statement_capacity: UIntSize = 0usize
        for _statement in statements.indices { statement_capacity = statement_capacity + 1usize }
        var ast_capacity: UIntSize = 0usize
        for _node in ast.indices { ast_capacity = ast_capacity + 1usize }
        let statements_required: UIntSize = 3usize
        let ast_nodes_required: UIntSize = 5usize
        var statements_emitted: UIntSize = statement_capacity
        if statements_emitted > statements_required { statements_emitted = statements_required }
        var ast_nodes_emitted: UIntSize = ast_capacity
        if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
        if statement_capacity > 0usize { statements[0] = TypedStatementHeader { kind: 1u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: two.first_declaration_start, target_end: two.first_declaration_end, expression_node: 0usize, start: two_spans.first_let_start, end: two_spans.first_let_end } }
        if statement_capacity > 1usize { statements[1] = TypedStatementHeader { kind: 1u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: two.second_declaration_start, target_end: two.second_declaration_end, expression_node: 3usize, start: two_spans.second_let_start, end: two_spans.second_let_end } }
        if statement_capacity > 2usize { statements[2] = TypedStatementHeader { kind: 3u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 4usize, start: two_spans.return_start, end: two_spans.return_end } }
        if ast_capacity > 0usize { ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: two.first_literal_start, end: two.first_literal_end } }
        if ast_capacity > 1usize { ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: two.first_use_start, end: two.first_use_end } }
        if ast_capacity > 2usize { ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: two.second_literal_start, end: two.second_literal_end } }
        if ast_capacity > 3usize { ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 1usize, right: 2usize, aux: 0usize, start: two.first_use_start, end: two.second_literal_end } }
        if ast_capacity > 4usize { ast[4] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: two.second_use_start, end: two.second_use_end } }
        var status: UIntSize = 3usize
        if statements_emitted == statements_required { if ast_nodes_emitted == ast_nodes_required { status = 7usize } }
        return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
    }
    if function_headers[0].parameter_count != 1usize {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].body_start != shape.body_start {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    if function_headers[0].body_end != shape.body_end {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    let local: Stage2LocalBindingInfo = stage2_parse_local_binding(bytes, shape.name_start, shape.name_end, 1usize, shape.body_start, shape.body_end)
    if !local.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 0usize, 24usize)
    }
    let spans: Stage2TypedSequenceSpans = stage2_typed_sequence_spans(bytes, local.declaration_start, local.declaration_end, local.return_start, local.return_end, shape.body_start, shape.body_end)
    if !spans.valid {
        return stage2_typed_sequence_summary(source_length, 0usize, 0usize, 0usize, 0usize, 1usize, 0usize)
    }
    var statement_capacity: UIntSize = 0usize
    for _statement in statements.indices {
        statement_capacity = statement_capacity + 1usize
    }
    var ast_capacity: UIntSize = 0usize
    for _node in ast.indices {
        ast_capacity = ast_capacity + 1usize
    }
    let statements_required: UIntSize = 2usize
    let ast_nodes_required: UIntSize = 4usize
    var statements_emitted: UIntSize = statement_capacity
    if statements_emitted > statements_required { statements_emitted = statements_required }
    var ast_nodes_emitted: UIntSize = ast_capacity
    if ast_nodes_emitted > ast_nodes_required { ast_nodes_emitted = ast_nodes_required }
    if statement_capacity > 0usize {
        statements[0] = TypedStatementHeader { kind: 1u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: local.declaration_start, target_end: local.declaration_end, expression_node: 2usize, start: spans.let_start, end: spans.let_end }
    }
    if statement_capacity > 1usize {
        statements[1] = TypedStatementHeader { kind: 3u8, flags: 0u8, type_kind: 2u8, reserved: 0u8, target_start: 0usize, target_end: 0usize, expression_node: 3usize, start: spans.return_start, end: spans.return_end }
    }
    if ast_capacity > 0usize {
        ast[0] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: local.parameter_start, end: local.parameter_end }
    }
    if ast_capacity > 1usize {
        ast[1] = TypedExpressionAstNodeHeader { syntax_kind: 2u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: local.literal_start, end: local.literal_end }
    }
    if ast_capacity > 2usize {
        ast[2] = TypedExpressionAstNodeHeader { syntax_kind: 7u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: if local.parameter_on_left { 0usize } else { 1usize }, right: if local.parameter_on_left { 1usize } else { 0usize }, aux: 0usize, start: local.binary_start, end: local.binary_end }
    }
    if ast_capacity > 3usize {
        ast[3] = TypedExpressionAstNodeHeader { syntax_kind: 1u8, type_kind: 2u8, flags: 1u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: local.use_start, end: local.use_end }
    }
    var status: UIntSize = 3usize
    if statements_emitted == statements_required {
        if ast_nodes_emitted == ast_nodes_required {
            status = 7usize
        }
    }
    return stage2_typed_sequence_summary(source_length, statements_required, statements_emitted, ast_nodes_required, ast_nodes_emitted, 0usize, status)
}

fn stage2_validate_typed_statement_sequence(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<TypedStatementHeader>,
    ast: read Slice<TypedExpressionAstNodeHeader>,
) -> Bool {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices { source_length = source_index + 1usize }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if function_count != 1usize { return false }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid { return false }
    if function_headers[0].name_start != shape.name_start { return false }
    if function_headers[0].name_end != shape.name_end { return false }
    if function_headers[0].body_start != shape.body_start { return false }
    if function_headers[0].body_end != shape.body_end { return false }
    if function_headers[0].parameter_count == 0usize {
        let two: Stage2TwoLocalBindingInfo = stage2_parse_two_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
        if !two.valid { return false }
        let two_spans: Stage2TypedTwoLocalSpans = stage2_typed_two_local_spans(bytes, shape.body_start, shape.body_end)
        if !two_spans.valid { return false }
        var statement_count: UIntSize = 0usize
        for _statement in statements.indices { statement_count = statement_count + 1usize }
        var ast_count: UIntSize = 0usize
        for _node in ast.indices { ast_count = ast_count + 1usize }
        if statement_count != 3usize { return false }
        if ast_count != 5usize { return false }
        if statements[0].kind != 1u8 { return false }
        if statements[0].flags != 0u8 { return false }
        if statements[0].type_kind != 2u8 { return false }
        if statements[0].reserved != 0u8 { return false }
        if statements[0].target_start != two.first_declaration_start { return false }
        if statements[0].target_end != two.first_declaration_end { return false }
        if statements[0].expression_node != 0usize { return false }
        if statements[0].start != two_spans.first_let_start { return false }
        if statements[0].end != two_spans.first_let_end { return false }
        if statements[1].kind != 1u8 { return false }
        if statements[1].flags != 0u8 { return false }
        if statements[1].type_kind != 2u8 { return false }
        if statements[1].reserved != 0u8 { return false }
        if statements[1].target_start != two.second_declaration_start { return false }
        if statements[1].target_end != two.second_declaration_end { return false }
        if statements[1].expression_node != 3usize { return false }
        if statements[1].start != two_spans.second_let_start { return false }
        if statements[1].end != two_spans.second_let_end { return false }
        if statements[2].kind != 3u8 { return false }
        if statements[2].flags != 0u8 { return false }
        if statements[2].type_kind != 2u8 { return false }
        if statements[2].reserved != 0u8 { return false }
        if statements[2].target_start != 0usize { return false }
        if statements[2].target_end != 0usize { return false }
        if statements[2].expression_node != 4usize { return false }
        if statements[2].start != two_spans.return_start { return false }
        if statements[2].end != two_spans.return_end { return false }
        if ast[0].syntax_kind != 2u8 { return false }
        if ast[0].type_kind != 2u8 { return false }
        if ast[0].flags != 1u8 { return false }
        if ast[0].reserved != 0u8 { return false }
        if ast[0].start != two.first_literal_start { return false }
        if ast[0].end != two.first_literal_end { return false }
        if ast[1].syntax_kind != 1u8 { return false }
        if ast[1].type_kind != 2u8 { return false }
        if ast[1].flags != 1u8 { return false }
        if ast[1].reserved != 0u8 { return false }
        if ast[1].start != two.first_use_start { return false }
        if ast[1].end != two.first_use_end { return false }
        if ast[2].syntax_kind != 2u8 { return false }
        if ast[2].type_kind != 2u8 { return false }
        if ast[2].flags != 1u8 { return false }
        if ast[2].reserved != 0u8 { return false }
        if ast[2].start != two.second_literal_start { return false }
        if ast[2].end != two.second_literal_end { return false }
        if ast[3].syntax_kind != 7u8 { return false }
        if ast[3].type_kind != 2u8 { return false }
        if ast[3].flags != 1u8 { return false }
        if ast[3].reserved != 0u8 { return false }
        if ast[3].left != 1usize { return false }
        if ast[3].right != 2usize { return false }
        if ast[3].start != two.first_use_start { return false }
        if ast[3].end != two.second_literal_end { return false }
        if ast[4].syntax_kind != 1u8 { return false }
        if ast[4].type_kind != 2u8 { return false }
        if ast[4].flags != 1u8 { return false }
        if ast[4].reserved != 0u8 { return false }
        if ast[4].start != two.second_use_start { return false }
        if ast[4].end != two.second_use_end { return false }
        return true
    }
    if function_headers[0].parameter_count != 1usize { return false }
    let local: Stage2LocalBindingInfo = stage2_parse_local_binding(bytes, shape.name_start, shape.name_end, 1usize, shape.body_start, shape.body_end)
    if !local.valid { return false }
    let spans: Stage2TypedSequenceSpans = stage2_typed_sequence_spans(bytes, local.declaration_start, local.declaration_end, local.return_start, local.return_end, shape.body_start, shape.body_end)
    if !spans.valid { return false }
    var statement_count: UIntSize = 0usize
    for _statement in statements.indices { statement_count = statement_count + 1usize }
    var ast_count: UIntSize = 0usize
    for _node in ast.indices { ast_count = ast_count + 1usize }
    if statement_count != 2usize { return false }
    if ast_count != 4usize { return false }
    if statements[0].kind != 1u8 { return false }
    if statements[0].flags != 0u8 { return false }
    if statements[0].type_kind != 2u8 { return false }
    if statements[0].reserved != 0u8 { return false }
    if statements[0].target_start != local.declaration_start { return false }
    if statements[0].target_end != local.declaration_end { return false }
    if statements[0].expression_node != 2usize { return false }
    if statements[0].start != spans.let_start { return false }
    if statements[0].end != spans.let_end { return false }
    if statements[1].kind != 3u8 { return false }
    if statements[1].flags != 0u8 { return false }
    if statements[1].type_kind != 2u8 { return false }
    if statements[1].reserved != 0u8 { return false }
    if statements[1].target_start != 0usize { return false }
    if statements[1].target_end != 0usize { return false }
    if statements[1].expression_node != 3usize { return false }
    if statements[1].start != spans.return_start { return false }
    if statements[1].end != spans.return_end { return false }
    if ast[0].syntax_kind != 1u8 { return false }
    if ast[0].type_kind != 2u8 { return false }
    if ast[0].flags != 1u8 { return false }
    if ast[0].reserved != 0u8 { return false }
    if ast[0].left != 0usize { return false }
    if ast[0].right != 0usize { return false }
    if ast[0].aux != 0usize { return false }
    if ast[0].start != local.parameter_start { return false }
    if ast[0].end != local.parameter_end { return false }
    if ast[1].syntax_kind != 2u8 { return false }
    if ast[1].type_kind != 2u8 { return false }
    if ast[1].flags != 1u8 { return false }
    if ast[1].reserved != 0u8 { return false }
    if ast[1].left != 0usize { return false }
    if ast[1].right != 0usize { return false }
    if ast[1].aux != 0usize { return false }
    if ast[1].start != local.literal_start { return false }
    if ast[1].end != local.literal_end { return false }
    if ast[2].syntax_kind != 7u8 { return false }
    if ast[2].type_kind != 2u8 { return false }
    if ast[2].flags != 1u8 { return false }
    if ast[2].reserved != 0u8 { return false }
    if ast[2].left != if local.parameter_on_left { 0usize } else { 1usize } { return false }
    if ast[2].right != if local.parameter_on_left { 1usize } else { 0usize } { return false }
    if ast[2].aux != 0usize { return false }
    if ast[2].start != local.binary_start { return false }
    if ast[2].end != local.binary_end { return false }
    if ast[3].syntax_kind != 1u8 { return false }
    if ast[3].type_kind != 2u8 { return false }
    if ast[3].flags != 1u8 { return false }
    if ast[3].reserved != 0u8 { return false }
    if ast[3].left != 0usize { return false }
    if ast[3].right != 0usize { return false }
    if ast[3].aux != 0usize { return false }
    if ast[3].start != local.use_start { return false }
    if ast[3].end != local.use_end { return false }
    return true
}

/// Validates the typed statement/AST hand-off and then reuses the existing
/// immutable-local JIR emitter.  The old Stage2 record protocol remains
/// unchanged; forged metadata or a wider statement shape is rejected before
/// any record is written.
@export(name: "jadren_selfhost_emit_typed_statement_sequence_jir", abi: "C")
@noalloc
pub fn emit_typed_statement_sequence_jir(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<TypedStatementHeader>,
    ast: read Slice<TypedExpressionAstNodeHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices { function_count = function_index + 1usize }
    if !stage2_validate_typed_statement_sequence(bytes, function_headers, statements, ast) {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 1usize, status_flags: 0usize }
    }
    if function_count == 1usize {
        if function_headers[0].parameter_count == 0usize {
            return emit_stage2_two_local_binding_jir(bytes, function_headers, output)
        }
    }
    return emit_stage2_local_binding_jir(bytes, function_headers, output)
}

/// Fuses the bounded frontend and JIR hand-offs into one Jadren-owned
/// pipeline entry point. All detailed storage remains caller-owned; the
/// function only composes already-admitted stages and preserves their
/// independent summaries in a compact 64-byte result.
///
/// The five-call admission keeps a fixed prefix view before entering the
/// emitter. This is intentional: the fused Linux ABI path receives the
/// caller's full capacity, while the emitter must see only records that the
/// frontend actually admitted.
@noalloc
fn stage2_copy_function_header(source: read Slice<FunctionHeader>, index: UIntSize) -> FunctionHeader {
    return FunctionHeader {
        name_start: source[index].name_start,
        name_end: source[index].name_end,
        parameter_count: source[index].parameter_count,
        body_start: source[index].body_start,
        body_end: source[index].body_end,
    }
}

@noalloc
fn stage2_copy_statement_header(source: read Slice<StatementHeader>, index: UIntSize) -> StatementHeader {
    return StatementHeader {
        kind: source[index].kind,
        start: source[index].start,
        end: source[index].end,
        body_start: source[index].body_start,
        body_end: source[index].body_end,
        depth: source[index].depth,
    }
}

@noalloc
fn stage2_copy_expression_call(source: read Slice<ExpressionCallHeader>, index: UIntSize) -> ExpressionCallHeader {
    return ExpressionCallHeader {
        callee_start: source[index].callee_start,
        callee_end: source[index].callee_end,
        open_start: source[index].open_start,
        open_end: source[index].open_end,
        close_start: source[index].close_start,
        close_end: source[index].close_end,
        argument_count: source[index].argument_count,
        depth: source[index].depth,
    }
}

@noalloc
fn stage2_emit_five_literal_pipeline(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var bounded_functions: [FunctionHeader; 6] = [
        stage2_copy_function_header(function_headers, 0usize),
        stage2_copy_function_header(function_headers, 1usize),
        stage2_copy_function_header(function_headers, 2usize),
        stage2_copy_function_header(function_headers, 3usize),
        stage2_copy_function_header(function_headers, 4usize),
        stage2_copy_function_header(function_headers, 5usize),
    ]
    var bounded_statements: [StatementHeader; 6] = [
        stage2_copy_statement_header(statements, 0usize),
        stage2_copy_statement_header(statements, 1usize),
        stage2_copy_statement_header(statements, 2usize),
        stage2_copy_statement_header(statements, 3usize),
        stage2_copy_statement_header(statements, 4usize),
        stage2_copy_statement_header(statements, 5usize),
    ]
    var bounded_calls: [ExpressionCallHeader; 11] = [
        stage2_copy_expression_call(calls, 0usize),
        stage2_copy_expression_call(calls, 1usize),
        stage2_copy_expression_call(calls, 2usize),
        stage2_copy_expression_call(calls, 3usize),
        stage2_copy_expression_call(calls, 4usize),
        stage2_copy_expression_call(calls, 5usize),
        stage2_copy_expression_call(calls, 6usize),
        stage2_copy_expression_call(calls, 7usize),
        stage2_copy_expression_call(calls, 8usize),
        stage2_copy_expression_call(calls, 9usize),
        stage2_copy_expression_call(calls, 10usize),
    ]
    return emit_stage2_jir(bytes, bounded_functions, bounded_statements, bounded_calls, output)
}

@noalloc
fn stage2_emit_result_binding_pipeline(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var bounded_functions: [FunctionHeader; 2] = [
        stage2_copy_function_header(function_headers, 0usize),
        stage2_copy_function_header(function_headers, 1usize),
    ]
    var bounded_statements: [StatementHeader; 3] = [
        stage2_copy_statement_header(statements, 0usize),
        stage2_copy_statement_header(statements, 1usize),
        stage2_copy_statement_header(statements, 2usize),
    ]
    var bounded_calls: [ExpressionCallHeader; 3] = [
        stage2_copy_expression_call(calls, 0usize),
        stage2_copy_expression_call(calls, 1usize),
        stage2_copy_expression_call(calls, 2usize),
    ]
    return emit_stage2_jir(bytes, bounded_functions, bounded_statements, bounded_calls, output)
}

@noalloc
fn stage2_emit_two_zero_argument_result_bindings_pipeline(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var bounded_functions: [FunctionHeader; 3] = [
        stage2_copy_function_header(function_headers, 0usize),
        stage2_copy_function_header(function_headers, 1usize),
        stage2_copy_function_header(function_headers, 2usize),
    ]
    var bounded_statements: [StatementHeader; 5] = [
        stage2_copy_statement_header(statements, 0usize),
        stage2_copy_statement_header(statements, 1usize),
        stage2_copy_statement_header(statements, 2usize),
        stage2_copy_statement_header(statements, 3usize),
        stage2_copy_statement_header(statements, 4usize),
    ]
    var bounded_calls: [ExpressionCallHeader; 5] = [
        stage2_copy_expression_call(calls, 0usize),
        stage2_copy_expression_call(calls, 1usize),
        stage2_copy_expression_call(calls, 2usize),
        stage2_copy_expression_call(calls, 3usize),
        stage2_copy_expression_call(calls, 4usize),
    ]
    return emit_stage2_jir(bytes, bounded_functions, bounded_statements, bounded_calls, output)
}

@noalloc
fn stage2_emit_same_function_two_zero_calls_pipeline(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var bounded_functions: [FunctionHeader; 2] = [
        stage2_copy_function_header(function_headers, 0usize),
        stage2_copy_function_header(function_headers, 1usize),
    ]
    var bounded_statements: [StatementHeader; 3] = [
        stage2_copy_statement_header(statements, 0usize),
        stage2_copy_statement_header(statements, 1usize),
        stage2_copy_statement_header(statements, 2usize),
    ]
    var bounded_calls: [ExpressionCallHeader; 4] = [
        stage2_copy_expression_call(calls, 0usize),
        stage2_copy_expression_call(calls, 1usize),
        stage2_copy_expression_call(calls, 2usize),
        stage2_copy_expression_call(calls, 3usize),
    ]
    return emit_stage2_jir(bytes, bounded_functions, bounded_statements, bounded_calls, output)
}

@noalloc
fn stage2_emit_same_function_two_zero_result_bindings_pipeline(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var bounded_functions: [FunctionHeader; 2] = [
        stage2_copy_function_header(function_headers, 0usize),
        stage2_copy_function_header(function_headers, 1usize),
    ]
    var bounded_statements: [StatementHeader; 4] = [
        stage2_copy_statement_header(statements, 0usize),
        stage2_copy_statement_header(statements, 1usize),
        stage2_copy_statement_header(statements, 2usize),
        stage2_copy_statement_header(statements, 3usize),
    ]
    var bounded_calls: [ExpressionCallHeader; 4] = [
        stage2_copy_expression_call(calls, 0usize),
        stage2_copy_expression_call(calls, 1usize),
        stage2_copy_expression_call(calls, 2usize),
        stage2_copy_expression_call(calls, 3usize),
    ]
    return emit_stage2_jir(bytes, bounded_functions, bounded_statements, bounded_calls, output)
}

@export(name: "jadren_selfhost_compile_stage2_jir", abi: "C")
@noalloc
pub fn compile_stage2_jir(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    tokens: write Slice<TokenInfo>,
    ast_items: write Slice<AstItemHeader>,
    function_headers: write Slice<FunctionHeader>,
    statements: write Slice<StatementHeader>,
    calls: write Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2PipelineSummary {
    let frontend: FrontendStage2Summary = compile_frontend_stage2(
        bytes,
        start,
        end,
        tokens,
        ast_items,
        function_headers,
        statements,
        calls,
    )
    let jir: Stage2JirSummary = if frontend.function_headers_emitted == 2usize {
        if frontend.statements_emitted == 4usize {
            if frontend.calls_emitted == 4usize {
                stage2_emit_same_function_two_zero_result_bindings_pipeline(bytes, function_headers, statements, calls, output)
            } else {
                emit_stage2_jir(bytes, function_headers, statements, calls, output)
            }
        } else if frontend.statements_emitted == 3usize {
            if frontend.calls_emitted == 4usize {
                stage2_emit_same_function_two_zero_calls_pipeline(bytes, function_headers, statements, calls, output)
            } else if frontend.calls_emitted == 3usize {
                stage2_emit_result_binding_pipeline(bytes, function_headers, statements, calls, output)
            } else {
                emit_stage2_jir(bytes, function_headers, statements, calls, output)
            }
        } else {
            emit_stage2_jir(bytes, function_headers, statements, calls, output)
        }
    } else if frontend.function_headers_emitted == 6usize {
        if frontend.statements_emitted == 6usize {
            if frontend.calls_emitted == 11usize {
                stage2_emit_five_literal_pipeline(bytes, function_headers, statements, calls, output)
            } else {
                emit_stage2_jir(bytes, function_headers, statements, calls, output)
            }
        } else {
            emit_stage2_jir(bytes, function_headers, statements, calls, output)
        }
    } else if frontend.function_headers_emitted == 3usize {
        if frontend.statements_emitted == 5usize {
            if frontend.calls_emitted == 5usize {
                stage2_emit_two_zero_argument_result_bindings_pipeline(bytes, function_headers, statements, calls, output)
            } else {
                emit_stage2_jir(bytes, function_headers, statements, calls, output)
            }
        } else {
            emit_stage2_jir(bytes, function_headers, statements, calls, output)
        }
    } else {
        emit_stage2_jir(bytes, function_headers, statements, calls, output)
    }
    var status: UIntSize = 0usize
    if frontend.syntax_errors == 0usize {
        status = 1usize
    }
    if frontend.status_flags == 3usize {
        status = status + 2usize
    }
    if jir.errors == 0usize {
        if jir.records_emitted == jir.records_required {
            status = status + 4usize
        }
    }
    return Stage2PipelineSummary {
        source_bytes: frontend.source_bytes,
        tokens_emitted: frontend.tokens_emitted,
        syntax_errors: frontend.syntax_errors + jir.errors,
        frontend_status_flags: frontend.status_flags,
        records_required: jir.records_required,
        records_emitted: jir.records_emitted,
        functions_lowered: jir.functions_lowered,
        status_flags: status,
    }
}
