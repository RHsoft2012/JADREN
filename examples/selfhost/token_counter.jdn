    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let first_name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if first_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(bytes, first_name.start, first_name.end, first_name_start, first_name_end) {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, first_name.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    var operator_opcode: UInt8 = 0u8
    if bytes[operator.start] == 0x2Bu8 {
        operator_opcode = 2u8
    }
    if bytes[operator.start] == 0x2Du8 {
        operator_opcode = 3u8
    }
    if bytes[operator.start] == 0x2Au8 {
        operator_opcode = 4u8
    }
    if operator_opcode == 0u8 {
        return invalid
    }
    let second_name: TokenInfo = scan_token_info(bytes, operator.end, end)
    if second_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        second_name.start,
        second_name.end,
        second_name_start,
        second_name_end,
    ) {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, second_name.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 7u8
    expression.operator_opcode = operator_opcode
    expression.left_value = 0usize
    expression.right_value = 1usize
    expression.left_start = first_name.start
    expression.left_end = first_name.end
    expression.right_start = second_name.start
    expression.right_end = second_name.end
    expression.expression_start = first_name.start
    expression.expression_end = second_name.end
    expression.statement_end = semicolon.end
    return expression
}

/// Recognizes the mirrored two-parameter slice: `return second op first;`.
/// Both declared parameters retain their header SSA identities; only the
/// binary record reverses its operands, which is observable for subtraction.
@noalloc
fn stage2_parse_reverse_parameter_pair_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    first_name_start: UIntSize,
    first_name_end: UIntSize,
    second_name_start: UIntSize,
    second_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let second_name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if second_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(bytes, second_name.start, second_name.end, second_name_start, second_name_end) {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, second_name.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    let operator_opcode: UInt8 = stage2_binary_opcode(bytes[operator.start])
    if operator_opcode == 0u8 {
        return invalid
    }
    let first_name: TokenInfo = scan_token_info(bytes, operator.end, end)
    if first_name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(bytes, first_name.start, first_name.end, first_name_start, first_name_end) {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, first_name.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 9u8
    expression.operator_opcode = operator_opcode
    expression.left_value = 1usize
    expression.right_value = 0usize
    expression.left_start = second_name.start
    expression.left_end = second_name.end
    expression.right_start = first_name.start
    expression.right_end = first_name.end
    expression.expression_start = second_name.start
    expression.expression_end = first_name.end
    expression.statement_end = semicolon.end
    return expression
}

@noalloc
fn stage2_binary_opcode(byte: UInt8) -> UInt8 {
    if byte == 0x2Bu8 {
        return 2u8
    }
    if byte == 0x2Du8 {
        return 3u8
    }
    if byte == 0x2Au8 {
        return 4u8
    }
    return 0u8
}

@noalloc
fn stage2_token_is_symbol(
    bytes: read Slice<UInt8>,
    kind: UInt8,
    start: UIntSize,
    end: UIntSize,
    symbol: UInt8,
) -> Bool {
    if kind != 3u8 {
        return false
    }
    if start >= end {
        return false
    }
    return bytes[start] == symbol
}

@noalloc
fn stage2_invalid_streaming_expression_plan() -> Stage2StreamingExpressionPlan {
    return Stage2StreamingExpressionPlan {
        valid: false,
        literal_count: 0usize,
        operator_count: 0usize,
        grouping_kind: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        second_grouping_kind: 0usize,
        second_group_start: 0usize,
        second_group_end: 0usize,
        first_value: 2147483648usize,
        first_start: 0usize,
        first_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

/// Scans a longer return expression without retaining one field per operand.
/// Five through sixteen binary operators are accepted. The final JIR output
/// slice is the caller-owned plan table used by the emission pass.
@noalloc
fn stage2_parse_streaming_return_i32_expression_plan(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2StreamingExpressionPlan {
    let invalid: Stage2StreamingExpressionPlan = stage2_invalid_streaming_expression_plan()
    let invalid_value: UIntSize = 2147483648usize
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    var cursor: UIntSize = keyword.end
    var expecting_operand: Bool = true
    var literal_count: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var grouping_kind: UIntSize = 0usize
    var second_grouping_kind: UIntSize = 0usize
    var group_open: Bool = false
    var group_nested: Bool = false
    var group_count: UIntSize = 0usize
    var active_grouping_kind: UIntSize = 0usize
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var second_group_start: UIntSize = 0usize
    var second_group_end: UIntSize = 0usize
    var first_value: UIntSize = invalid_value
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var expression_start: UIntSize = 0usize
    var last_literal_end: UIntSize = 0usize

    while cursor < end {
        if expecting_operand {
            var literal: TokenInfo = scan_token_info(bytes, cursor, end)
            if stage2_token_is_symbol(
                bytes,
                literal.kind,
                literal.start,
                literal.end,
                0x28u8,
            ) {
                if group_open {
                    if group_nested {
                        return invalid
                    }
                    if literal_count + 1usize != active_grouping_kind {
                        return invalid
                    }
                    group_nested = true
                    literal = scan_token_info(bytes, literal.end, end)
                } else {
                    if group_count >= 2usize {
                        return invalid
                    }
                    group_open = true
                    active_grouping_kind = literal_count + 1usize
                    group_count = group_count + 1usize
                    if group_count == 1usize {
                        grouping_kind = active_grouping_kind
                        group_start = literal.start
                    } else {
                        second_grouping_kind = active_grouping_kind
                        second_group_start = literal.start
                    }
                    if literal_count == 0usize {
                        expression_start = literal.start
                    }
                    literal = scan_token_info(bytes, literal.end, end)
                }
            }
            if group_open {
                if !group_nested {
                    if stage2_token_is_symbol(
                        bytes,
                        literal.kind,
                        literal.start,
                        literal.end,
                        0x28u8,
                    ) {
                        group_nested = true
                        literal = scan_token_info(bytes, literal.end, end)
                    }
                }
            }
            if literal.kind != 2u8 {
                return invalid
            }
            let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
            if value == invalid_value {
                return invalid
            }
            if literal_count == 0usize {
                first_value = value
                first_start = literal.start
                first_end = literal.end
                if expression_start == 0usize {
                    expression_start = literal.start
                }
            }
            literal_count = literal_count + 1usize
            if literal_count > 17usize {
                return invalid
            }
            last_literal_end = literal.end
            cursor = literal.end
            expecting_operand = false
        } else {
            var separator: TokenInfo = scan_token_info(bytes, cursor, end)
            if separator.start >= end {
                return invalid
            }
            if group_open {
                if literal_count == active_grouping_kind + 1usize {
                    if !stage2_token_is_symbol(
                        bytes,
                        separator.kind,
                        separator.start,
                        separator.end,
                        0x29u8,
                    ) {
                        return invalid
                    }
                    let first_closing_end: UIntSize = separator.end
                    var closing: TokenInfo = separator
                    if group_nested {
                        closing = scan_token_info(bytes, first_closing_end, end)
                        if !stage2_token_is_symbol(
                            bytes,
                            closing.kind,
                            closing.start,
                            closing.end,
                            0x29u8,
                        ) {
                            return invalid
                        }
                    }
                    if group_count == 1usize {
                        group_end = closing.end
                    } else {
                        second_group_end = closing.end
                    }
                    group_open = false
                    cursor = closing.end
                    separator = scan_token_info(bytes, cursor, end)
                    if separator.start >= end {
                        return invalid
                    }
                }
            }
            if stage2_token_is_symbol(
                bytes,
                separator.kind,
                separator.start,
                separator.end,
                0x3Bu8,
            ) {
                if group_open {
                    return invalid
                }
                if operator_count < 5usize {
                    return invalid
                }
                if operator_count > 16usize {
                    return invalid
                }
                if operator_count + 1usize != literal_count {
                    return invalid
                }
                let trailing: TokenInfo = scan_token_info(bytes, separator.end, end)
                if trailing.start < end {
                    return invalid
                }
                var expression_end: UIntSize = last_literal_end
                if second_grouping_kind + 1usize == literal_count {
                    expression_end = second_group_end
                } else if grouping_kind + 1usize == literal_count {
                    expression_end = group_end
                }
                return Stage2StreamingExpressionPlan {
                    valid: true,
                    literal_count: literal_count,
                    operator_count: operator_count,
                    grouping_kind: grouping_kind,
                    group_start: group_start,
                    group_end: group_end,
                    second_grouping_kind: second_grouping_kind,
                    second_group_start: second_group_start,
                    second_group_end: second_group_end,
                    first_value: first_value,
                    first_start: first_start,
                    first_end: first_end,
                    expression_start: expression_start,
                    expression_end: expression_end,
                    statement_end: separator.end,
                }
            }
            if separator.kind != 3u8 {
                return invalid
            }
            let opcode: UInt8 = stage2_binary_opcode(bytes[separator.start])
            if opcode == 0u8 {
                return invalid
            }
            operator_count = operator_count + 1usize
            if operator_count > 16usize {
                return invalid
            }
            cursor = separator.end
            expecting_operand = true
        }
    }
    return invalid
}

@noalloc
fn stage2_invalid_return_expression() -> Stage2ReturnExpression {
    return Stage2ReturnExpression {
        kind: 0u8,
        grouping_kind: 0u8,
        operator_opcode: 0u8,
        second_operator_opcode: 0u8,
        third_operator_opcode: 0u8,
        fourth_operator_opcode: 0u8,
        left_value: 2147483648usize,
        right_value: 2147483648usize,
        third_value: 2147483648usize,
        fourth_value: 2147483648usize,
        fifth_value: 2147483648usize,
        left_start: 0usize,
        left_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fifth_start: 0usize,
        fifth_end: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

/// Recognizes the grouped long-plan slice before the legacy one-/two-operator
/// paths. Exactly one non-nested group must wrap two adjacent literals, and
/// the complete expression must contain three or four binary operators.
@noalloc
fn stage2_parse_grouped_long_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_return_expression()
    let invalid_value: UIntSize = 2147483648usize
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    var cursor: UIntSize = keyword.end
    var expecting_operand: Bool = true
    var operand_count: UIntSize = 0usize
    var operator_count: UIntSize = 0usize
    var grouping_kind: UInt8 = 0u8
    var group_open: Bool = false
    var group_closed: Bool = false
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var expression_start: UIntSize = 0usize

    var operator_opcode: UInt8 = 0u8
    var second_operator_opcode: UInt8 = 0u8
    var third_operator_opcode: UInt8 = 0u8
    var fourth_operator_opcode: UInt8 = 0u8

    var left_value: UIntSize = invalid_value
    var right_value: UIntSize = invalid_value
    var third_value: UIntSize = invalid_value
    var fourth_value: UIntSize = invalid_value
    var fifth_value: UIntSize = invalid_value
    var left_start: UIntSize = 0usize
    var left_end: UIntSize = 0usize
    var right_start: UIntSize = 0usize
    var right_end: UIntSize = 0usize
    var third_start: UIntSize = 0usize
    var third_end: UIntSize = 0usize
    var fourth_start: UIntSize = 0usize
    var fourth_end: UIntSize = 0usize
    var fifth_start: UIntSize = 0usize
    var fifth_end: UIntSize = 0usize

    while cursor < end {
        if expecting_operand {
            var literal: TokenInfo = scan_token_info(bytes, cursor, end)
            if stage2_token_is_symbol(
                bytes,
                literal.kind,
                literal.start,
                literal.end,
                0x28u8,
            ) {
                if group_open {
                    return invalid
                }
                if group_closed {
                    return invalid
                }
                group_open = true
                grouping_kind = (operand_count + 1usize) as UInt8
                group_start = literal.start
                if operand_count == 0usize {
                    expression_start = group_start
                }
                literal = scan_token_info(bytes, literal.end, end)
            }
            if literal.kind != 2u8 {
                return invalid
            }
            if operand_count >= 5usize {
                return invalid
            }
            let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
            if value == invalid_value {
                return invalid
            }
            if operand_count == 0usize {
                left_value = value
                left_start = literal.start
                left_end = literal.end
                if expression_start == 0usize {
                    expression_start = literal.start
                }
            } else if operand_count == 1usize {
                right_value = value
                right_start = literal.start
                right_end = literal.end
            } else if operand_count == 2usize {
                third_value = value
                third_start = literal.start
                third_end = literal.end
            } else if operand_count == 3usize {
                fourth_value = value
                fourth_start = literal.start
                fourth_end = literal.end
            } else {
                fifth_value = value
                fifth_start = literal.start
                fifth_end = literal.end
            }
            operand_count = operand_count + 1usize
            cursor = literal.end
            expecting_operand = false
        } else {
            var separator: TokenInfo = scan_token_info(bytes, cursor, end)
            if separator.start >= end {
                return invalid
            }
            if group_open {
                let grouped_operand_end: UIntSize = (grouping_kind as UIntSize) + 1usize
                if operand_count == grouped_operand_end {
                    if !stage2_token_is_symbol(
                        bytes,
                        separator.kind,
                        separator.start,
                        separator.end,
                        0x29u8,
                    ) {
                        return invalid
                    }
                    group_end = separator.end
                    group_open = false
                    group_closed = true
                    cursor = separator.end
                    separator = scan_token_info(bytes, cursor, end)
                    if separator.start >= end {
                        return invalid
                    }
                }
            }
            if stage2_token_is_symbol(
                bytes,
                separator.kind,
                separator.start,
                separator.end,
                0x3Bu8,
            ) {
                if group_open {
                    return invalid
                }
                if !group_closed {
                    return invalid
                }
                if operand_count < 4usize {
                    return invalid
                }
                if operand_count > 5usize {
                    return invalid
                }
                if operator_count + 1usize != operand_count {
                    return invalid
                }
                let trailing: TokenInfo = scan_token_info(bytes, separator.end, end)
                if trailing.start < end {
                    return invalid
                }
                var expression_end: UIntSize = fourth_end
                var kind: UInt8 = 4u8
                if operand_count == 5usize {
                    expression_end = fifth_end
                    kind = 5u8
                }
                if (grouping_kind as UIntSize) + 1usize == operand_count {
                    expression_end = group_end
                }
                return Stage2ReturnExpression {
                    kind: kind,
                    grouping_kind: grouping_kind,
                    operator_opcode: operator_opcode,
                    second_operator_opcode: second_operator_opcode,
                    third_operator_opcode: third_operator_opcode,
                    fourth_operator_opcode: fourth_operator_opcode,
                    left_value: left_value,
                    right_value: right_value,
                    third_value: third_value,
                    fourth_value: fourth_value,
                    fifth_value: fifth_value,
                    left_start: left_start,
                    left_end: left_end,
                    right_start: right_start,
                    right_end: right_end,
                    third_start: third_start,
                    third_end: third_end,
                    fourth_start: fourth_start,
                    fourth_end: fourth_end,
                    fifth_start: fifth_start,
                    fifth_end: fifth_end,
                    group_start: group_start,
                    group_end: group_end,
                    expression_start: expression_start,
                    expression_end: expression_end,
                    statement_end: separator.end,
                }
            }
            if separator.kind != 3u8 {
                return invalid
            }
            if operator_count >= 4usize {
                return invalid
            }
            let opcode: UInt8 = stage2_binary_opcode(bytes[separator.start])
            if opcode == 0u8 {
                return invalid
            }
            if operator_count == 0usize {
                operator_opcode = opcode
            } else if operator_count == 1usize {
                second_operator_opcode = opcode
            } else if operator_count == 2usize {
                third_operator_opcode = opcode
            } else {
                fourth_operator_opcode = opcode
            }
            operator_count = operator_count + 1usize
            cursor = separator.end
            expecting_operand = true
        }
    }
    return invalid
}

/// Parses the executable stage-2 expression subset: a literal, one binary
/// operation, or a bounded add/subtract/multiply expression over at most five
/// non-negative Int32 literals. One explicit non-nested group may wrap one
/// adjacent binary pair. The emitter applies that group before multiplication
/// precedence and left associativity.
@noalloc
fn stage2_parse_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid_value: UIntSize = 2147483648usize
    let invalid: Stage2ReturnExpression = stage2_invalid_return_expression()
    let grouped_long: Stage2ReturnExpression = stage2_parse_grouped_long_return_i32_expression(
        bytes,
        start,
        end,
    )
    if grouped_long.kind == 4u8 {
        return grouped_long
    }
    if grouped_long.kind == 5u8 {
        return grouped_long
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }

    let first_expression_token: TokenInfo = scan_token_info(bytes, keyword.end, end)
    let first_expression_kind: UInt8 = first_expression_token.kind
    let first_expression_start: UIntSize = first_expression_token.start
    let first_expression_end: UIntSize = first_expression_token.end
    var grouping_kind: UInt8 = 0u8
    var group_start: UIntSize = 0usize
    var group_end: UIntSize = 0usize
    var left: TokenInfo = first_expression_token
    if stage2_token_is_symbol(
        bytes,
        first_expression_kind,
        first_expression_start,
        first_expression_end,
        0x28u8,
    ) {
        grouping_kind = 1u8
        group_start = first_expression_start
        left = scan_token_info(bytes, first_expression_end, end)
    }
    if left.kind != 2u8 {
        return invalid
    }
    let left_value: UIntSize = stage2_i32_literal_value(bytes, left.start, left.end)
    if left_value == invalid_value {
        return invalid
    }

    let operator_or_semicolon: TokenInfo = scan_token_info(bytes, left.end, end)
    if operator_or_semicolon.start >= end {
        return invalid
    }
    if grouping_kind == 0u8 {
        if stage2_token_is_symbol(
            bytes,
            operator_or_semicolon.kind,
            operator_or_semicolon.start,
            operator_or_semicolon.end,
            0x3Bu8,
        ) {
            let trailing: TokenInfo = scan_token_info(bytes, operator_or_semicolon.end, end)
            if trailing.start < end {
                return invalid
            }
            return Stage2ReturnExpression {
                kind: 1u8,
                grouping_kind: 0u8,
                operator_opcode: 0u8,
                second_operator_opcode: 0u8,
                third_operator_opcode: 0u8,
                fourth_operator_opcode: 0u8,
                left_value: left_value,
                right_value: 0usize,
                third_value: 0usize,
                fourth_value: 0usize,
                fifth_value: 0usize,
                left_start: left.start,
                left_end: left.end,
                right_start: 0usize,
                right_end: 0usize,
                third_start: 0usize,
                third_end: 0usize,
                fourth_start: 0usize,
                fourth_end: 0usize,
                fifth_start: 0usize,
                fifth_end: 0usize,
                group_start: 0usize,
                group_end: 0usize,
                expression_start: left.start,
                expression_end: left.end,
                statement_end: operator_or_semicolon.end,
            }
        }
    }
    if operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let operator_opcode: UInt8 = stage2_binary_opcode(bytes[operator_or_semicolon.start])
    if operator_opcode == 0u8 {
        return invalid
    }

    let right_or_open: TokenInfo = scan_token_info(bytes, operator_or_semicolon.end, end)
    let right_or_open_kind: UInt8 = right_or_open.kind
    let right_or_open_start: UIntSize = right_or_open.start
    let right_or_open_end: UIntSize = right_or_open.end
    var right: TokenInfo = right_or_open
    if grouping_kind == 0u8 {
        if stage2_token_is_symbol(
            bytes,
            right_or_open_kind,
            right_or_open_start,
            right_or_open_end,
            0x28u8,
        ) {
            grouping_kind = 2u8
            group_start = right_or_open_start
            right = scan_token_info(bytes, right_or_open_end, end)
        }
    }
    if right.kind != 2u8 {
        return invalid
    }
    let right_value: UIntSize = stage2_i32_literal_value(bytes, right.start, right.end)
    if right_value == invalid_value {
        return invalid
    }

    let after_right: TokenInfo = scan_token_info(bytes, right.end, end)
    if after_right.start >= end {
        return invalid
    }
    if grouping_kind == 1u8 {
        if !stage2_token_is_symbol(
            bytes,
            after_right.kind,
            after_right.start,
            after_right.end,
            0x29u8,
        ) {
            return invalid
        }
        group_end = after_right.end
        let after_left_group: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if stage2_token_is_symbol(
            bytes,
            after_left_group.kind,
            after_left_group.start,
            after_left_group.end,
            0x3Bu8,
        ) {
            let trailing: TokenInfo = scan_token_info(bytes, after_left_group.end, end)
            if trailing.start < end {
                return invalid
            }
            return Stage2ReturnExpression {
                kind: 2u8,
                grouping_kind: 3u8,
                operator_opcode: operator_opcode,
                second_operator_opcode: 0u8,
                third_operator_opcode: 0u8,
                fourth_operator_opcode: 0u8,
                left_value: left_value,
                right_value: right_value,
                third_value: 0usize,
                fourth_value: 0usize,
                fifth_value: 0usize,
                left_start: left.start,
                left_end: left.end,
                right_start: right.start,
                right_end: right.end,
                third_start: 0usize,
                third_end: 0usize,
                fourth_start: 0usize,
                fourth_end: 0usize,
                fifth_start: 0usize,
                fifth_end: 0usize,
                group_start: group_start,
                group_end: group_end,
                expression_start: group_start,
                expression_end: group_end,
                statement_end: after_left_group.end,
            }
        }
        let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_left_group.start])
        if second_operator_opcode == 0u8 {
            return invalid
        }
        let third: TokenInfo = scan_token_info(bytes, after_left_group.end, end)
        if third.kind != 2u8 {
            return invalid
        }
        let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
        if third_value == invalid_value {
            return invalid
        }
        let semicolon: TokenInfo = scan_token_info(bytes, third.end, end)
        if !stage2_token_is_symbol(
            bytes,
            semicolon.kind,
            semicolon.start,
            semicolon.end,
            0x3Bu8,
        ) {
            return invalid
        }
        let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 1u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: group_start,
            group_end: group_end,
            expression_start: group_start,
            expression_end: third.end,
            statement_end: semicolon.end,
        }
    }

    if grouping_kind == 2u8 {
        if after_right.kind != 3u8 {
            return invalid
        }
        let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_right.start])
        if second_operator_opcode == 0u8 {
            return invalid
        }
        let third: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if third.kind != 2u8 {
            return invalid
        }
        let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
        if third_value == invalid_value {
            return invalid
        }
        let close_group: TokenInfo = scan_token_info(bytes, third.end, end)
        if !stage2_token_is_symbol(
            bytes,
            close_group.kind,
            close_group.start,
            close_group.end,
            0x29u8,
        ) {
            return invalid
        }
        group_end = close_group.end
        let semicolon: TokenInfo = scan_token_info(bytes, close_group.end, end)
        if !stage2_token_is_symbol(
            bytes,
            semicolon.kind,
            semicolon.start,
            semicolon.end,
            0x3Bu8,
        ) {
            return invalid
        }
        let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 2u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: group_start,
            group_end: group_end,
            expression_start: left.start,
            expression_end: group_end,
            statement_end: semicolon.end,
        }
    }

    if stage2_token_is_symbol(
        bytes,
        after_right.kind,
        after_right.start,
        after_right.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, after_right.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 2u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: 0u8,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: 0usize,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: 0usize,
            third_end: 0usize,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: right.end,
            statement_end: after_right.end,
        }
    }
    if after_right.kind != 3u8 {
        return invalid
    }
    let second_operator_opcode: UInt8 = stage2_binary_opcode(bytes[after_right.start])
    if second_operator_opcode == 0u8 {
        return invalid
    }
    let third: TokenInfo = scan_token_info(bytes, after_right.end, end)
    if third.kind != 2u8 {
        return invalid
    }
    let third_value: UIntSize = stage2_i32_literal_value(bytes, third.start, third.end)
    if third_value == invalid_value {
        return invalid
    }
    let third_operator_or_semicolon: TokenInfo = scan_token_info(bytes, third.end, end)
    if stage2_token_is_symbol(
        bytes,
        third_operator_or_semicolon.kind,
        third_operator_or_semicolon.start,
        third_operator_or_semicolon.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, third_operator_or_semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 3u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: 0u8,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: 0usize,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: 0usize,
            fourth_end: 0usize,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: third.end,
            statement_end: third_operator_or_semicolon.end,
        }
    }
    if third_operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let third_operator_opcode: UInt8 = stage2_binary_opcode(bytes[third_operator_or_semicolon.start])
    if third_operator_opcode == 0u8 {
        return invalid
    }
    let fourth: TokenInfo = scan_token_info(bytes, third_operator_or_semicolon.end, end)
    if fourth.kind != 2u8 {
        return invalid
    }
    let fourth_value: UIntSize = stage2_i32_literal_value(bytes, fourth.start, fourth.end)
    if fourth_value == invalid_value {
        return invalid
    }
    let fourth_operator_or_semicolon: TokenInfo = scan_token_info(bytes, fourth.end, end)
    if stage2_token_is_symbol(
        bytes,
        fourth_operator_or_semicolon.kind,
        fourth_operator_or_semicolon.start,
        fourth_operator_or_semicolon.end,
        0x3Bu8,
    ) {
        let trailing: TokenInfo = scan_token_info(bytes, fourth_operator_or_semicolon.end, end)
        if trailing.start < end {
            return invalid
        }
        return Stage2ReturnExpression {
            kind: 4u8,
            grouping_kind: 0u8,
            operator_opcode: operator_opcode,
            second_operator_opcode: second_operator_opcode,
            third_operator_opcode: third_operator_opcode,
            fourth_operator_opcode: 0u8,
            left_value: left_value,
            right_value: right_value,
            third_value: third_value,
            fourth_value: fourth_value,
            fifth_value: 0usize,
            left_start: left.start,
            left_end: left.end,
            right_start: right.start,
            right_end: right.end,
            third_start: third.start,
            third_end: third.end,
            fourth_start: fourth.start,
            fourth_end: fourth.end,
            fifth_start: 0usize,
            fifth_end: 0usize,
            group_start: 0usize,
            group_end: 0usize,
            expression_start: left.start,
            expression_end: fourth.end,
            statement_end: fourth_operator_or_semicolon.end,
        }
    }
    if fourth_operator_or_semicolon.kind != 3u8 {
        return invalid
    }
    let fourth_operator_opcode: UInt8 = stage2_binary_opcode(bytes[fourth_operator_or_semicolon.start])
    if fourth_operator_opcode == 0u8 {
        return invalid
    }
    let fifth: TokenInfo = scan_token_info(bytes, fourth_operator_or_semicolon.end, end)
    if fifth.kind != 2u8 {
        return invalid
    }
    let fifth_value: UIntSize = stage2_i32_literal_value(bytes, fifth.start, fifth.end)
    if fifth_value == invalid_value {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, fifth.end, end)
    if !stage2_token_is_symbol(bytes, semicolon.kind, semicolon.start, semicolon.end, 0x3Bu8) {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    return Stage2ReturnExpression {
        kind: 5u8,
        grouping_kind: 0u8,
        operator_opcode: operator_opcode,
        second_operator_opcode: second_operator_opcode,
        third_operator_opcode: third_operator_opcode,
        fourth_operator_opcode: fourth_operator_opcode,
        left_value: left_value,
        right_value: right_value,
        third_value: third_value,
        fourth_value: fourth_value,
        fifth_value: fifth_value,
        left_start: left.start,
        left_end: left.end,
        right_start: right.start,
        right_end: right.end,
        third_start: third.start,
        third_end: third.end,
        fourth_start: fourth.start,
        fourth_end: fourth.end,
        fifth_start: fifth.start,
        fifth_end: fifth.end,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: left.start,
        expression_end: fifth.end,
        statement_end: semicolon.end,
    }
}

@noalloc
fn stage2_expression_literal_atom(
    expression: read Stage2ReturnExpression,
    literal_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if literal_index == 0usize {
        return Stage2ExpressionPlanAtom {
            value_index: 0usize,
            start: expression.left_start,
            end: expression.left_end,
        }
    }
    if literal_index == 1usize {
        return Stage2ExpressionPlanAtom {
            value_index: 1usize,
            start: expression.right_start,
            end: expression.right_end,
        }
    }
    if literal_index == 2usize {
        return Stage2ExpressionPlanAtom {
            value_index: 2usize,
            start: expression.third_start,
            end: expression.third_end,
        }
    }
    if literal_index == 3usize {
        return Stage2ExpressionPlanAtom {
            value_index: 3usize,
            start: expression.fourth_start,
            end: expression.fourth_end,
        }
    }
    return Stage2ExpressionPlanAtom {
        value_index: 4usize,
        start: expression.fifth_start,
        end: expression.fifth_end,
    }
}

@noalloc
fn stage2_expression_operator_at(
    expression: read Stage2ReturnExpression,
    operator_index: UIntSize,
) -> UInt8 {
    if operator_index == 0usize {
        return expression.operator_opcode
    }
    if operator_index == 1usize {
        return expression.second_operator_opcode
    }
    if operator_index == 2usize {
        return expression.third_operator_opcode
    }
    return expression.fourth_operator_opcode
}

@noalloc
fn stage2_expression_plan_atom(
    expression: read Stage2ReturnExpression,
    literal_count: UIntSize,
    effective_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if expression.grouping_kind == 0u8 {
        return stage2_expression_literal_atom(expression, effective_index)
    }
    let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
    if effective_index < group_left_index {
        return stage2_expression_literal_atom(expression, effective_index)
    }
    if effective_index == group_left_index {
        return Stage2ExpressionPlanAtom {
            value_index: literal_count,
            start: expression.group_start,
            end: expression.group_end,
        }
    }
    return stage2_expression_literal_atom(expression, effective_index + 1usize)
}

@noalloc
fn stage2_expression_plan_operator(
    expression: read Stage2ReturnExpression,
    effective_index: UIntSize,
) -> UInt8 {
    var source_index: UIntSize = effective_index
    if expression.grouping_kind != 0u8 {
        let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
        if effective_index >= group_left_index {
            source_index = source_index + 1usize
        }
    }
    return stage2_expression_operator_at(expression, source_index)
}

/// Emits kind 4/5 Int32 expressions through one bounded two-tier precedence
/// plan. An optional single binary group is emitted first as one effective
/// atom. Multiplication segments are then reduced before pending
/// addition/subtraction segments are folded from the left. Constants remain
/// dense before binary nodes and every binary node is written in
/// child-before-parent order directly into the caller-owned JIR slice.
@noalloc
fn stage2_emit_bounded_expression_plan(
    expression: Stage2ReturnExpression,
    function_index: UIntSize,
    return_statement_start: UIntSize,
    record_base: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2ExpressionPlanEmission {
    var literal_count: UIntSize = 4usize
    if expression.kind == 5u8 {
        literal_count = 5usize
    }
    let binary_count: UIntSize = literal_count - 1usize
    let record_count: UIntSize = 4usize + binary_count * 2usize
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }

    let literal_values: [UIntSize; 5] = [
        expression.left_value,
        expression.right_value,
        expression.third_value,
        expression.fourth_value,
        expression.fifth_value,
    ]
    let literal_starts: [UIntSize; 5] = [
        expression.left_start,
        expression.right_start,
        expression.third_start,
        expression.fourth_start,
        expression.fifth_start,
    ]
    let literal_ends: [UIntSize; 5] = [
        expression.left_end,
        expression.right_end,
        expression.third_end,
        expression.fourth_end,
        expression.fifth_end,
    ]
    var records_emitted: UIntSize = 0usize
    var literal_index: UIntSize = 1usize
    while literal_index < literal_count {
        let output_index: UIntSize = record_base + 2usize + literal_index
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_index,
                operand_a: literal_values[literal_index],
                operand_b: 0usize,
                source_start: literal_starts[literal_index],
                source_end: literal_ends[literal_index],
            }
            records_emitted = records_emitted + 1usize
        }
        literal_index = literal_index + 1usize
    }

    var nodes_emitted: UIntSize = 0usize
    var effective_atom_count: UIntSize = literal_count
    if expression.grouping_kind != 0u8 {
        let group_left_index: UIntSize = (expression.grouping_kind as UIntSize) - 1usize
        if group_left_index >= binary_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2ExpressionPlanAtom = stage2_expression_literal_atom(
            expression,
            group_left_index,
        )
        let grouped_right: Stage2ExpressionPlanAtom = stage2_expression_literal_atom(
            expression,
            group_left_index + 1usize,
        )
        if expression.group_start >= grouped_left.start {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if expression.group_end <= grouped_right.end {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_expression_operator_at(
            expression,
            group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if grouped_opcode > 4u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + literal_count
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_count,
                operand_a: group_left_index,
                operand_b: group_left_index + 1usize,
                source_start: expression.group_start,
                source_end: expression.group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = 1usize
        effective_atom_count = literal_count - 1usize
    }

    let first_atom: Stage2ExpressionPlanAtom = stage2_expression_plan_atom(
        expression,
        literal_count,
        0usize,
    )
    var segment_value_index: UIntSize = first_atom.value_index
    var segment_start: UIntSize = first_atom.start
    var segment_end: UIntSize = first_atom.end
    var accumulated_value_index: UIntSize = 0usize
    var accumulated_start: UIntSize = first_atom.start
    var pending_low_opcode: UInt8 = 0u8
    var has_accumulated: Bool = false
    let effective_binary_count: UIntSize = effective_atom_count - 1usize
    var operator_index: UIntSize = 0usize
    while operator_index < effective_binary_count {
        let current_opcode: UInt8 = stage2_expression_plan_operator(expression, operator_index)
        if current_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if current_opcode > 4u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let next_atom: Stage2ExpressionPlanAtom = stage2_expression_plan_atom(
            expression,
            literal_count,
            operator_index + 1usize,
        )
        if current_opcode == 4u8 {
            let result_value_index: UIntSize = literal_count + nodes_emitted
            let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
            if output_index < output_capacity {
                output[output_index] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: current_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: result_value_index,
                    operand_a: segment_value_index,
                    operand_b: next_atom.value_index,
                    source_start: segment_start,
                    source_end: next_atom.end,
                }
                records_emitted = records_emitted + 1usize
            }
            segment_value_index = result_value_index
            segment_end = next_atom.end
            nodes_emitted = nodes_emitted + 1usize
        } else {
            if has_accumulated {
                let result_value_index: UIntSize = literal_count + nodes_emitted
                let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
                if output_index < output_capacity {
                    output[output_index] = Stage2JirRecord {
                        kind: 4u8,
                        opcode: pending_low_opcode,
                        type_kind: 2u8,
                        flags: 0u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: result_value_index,
                        operand_a: accumulated_value_index,
                        operand_b: segment_value_index,
                        source_start: accumulated_start,
                        source_end: segment_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                accumulated_value_index = result_value_index
                nodes_emitted = nodes_emitted + 1usize
            } else {
                accumulated_value_index = segment_value_index
                accumulated_start = segment_start
                has_accumulated = true
            }
            pending_low_opcode = current_opcode
            segment_value_index = next_atom.value_index
            segment_start = next_atom.start
            segment_end = next_atom.end
        }
        operator_index = operator_index + 1usize
    }

    var final_value_index: UIntSize = segment_value_index
    if has_accumulated {
        let result_value_index: UIntSize = literal_count + nodes_emitted
        let output_index: UIntSize = record_base + 2usize + literal_count + nodes_emitted
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: pending_low_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: result_value_index,
                operand_a: accumulated_value_index,
                operand_b: segment_value_index,
                source_start: accumulated_start,
                source_end: segment_end,
            }
            records_emitted = records_emitted + 1usize
        }
        final_value_index = result_value_index
        nodes_emitted = nodes_emitted + 1usize
    }
    if nodes_emitted != binary_count {
        return Stage2ExpressionPlanEmission {
            valid: false,
            record_count: record_count,
            records_emitted: records_emitted,
            final_value_index: 0usize,
        }
    }
    let return_output_index: UIntSize = record_base + 2usize + literal_count + binary_count
    if return_output_index < output_capacity {
        output[return_output_index] = Stage2JirRecord {
            kind: 5u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: function_index,
            block_index: 0usize,
            value_index: final_value_index,
            operand_a: 0usize,
            operand_b: 0usize,
            source_start: return_statement_start,
            source_end: expression.statement_end,
        }
        records_emitted = records_emitted + 1usize
    }
    return Stage2ExpressionPlanEmission {
        valid: true,
        record_count: record_count,
        records_emitted: records_emitted,
        final_value_index: final_value_index,
    }
}

@noalloc
fn stage2_streaming_literal_at(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    wanted_index: UIntSize,
) -> Stage2StreamingLiteral {
    var cursor: UIntSize = plan.expression_start
    var literal_index: UIntSize = 0usize
    while cursor < plan.expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, plan.expression_end)
        if token.start >= plan.expression_end {
            break
        }
        if token.kind == 2u8 {
            if literal_index == wanted_index {
                let value: UIntSize = stage2_i32_literal_value(bytes, token.start, token.end)
                if value == 2147483648usize {
                    return Stage2StreamingLiteral {
                        valid: false,
                        value: 0usize,
                        start: 0usize,
                        end: 0usize,
                    }
                }
                return Stage2StreamingLiteral {
                    valid: true,
                    value: value,
                    start: token.start,
                    end: token.end,
                }
            }
            literal_index = literal_index + 1usize
        }
        cursor = token.end
    }
    return Stage2StreamingLiteral {
        valid: false,
        value: 0usize,
        start: 0usize,
        end: 0usize,
    }
}

@noalloc
fn stage2_streaming_operator_at(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    wanted_index: UIntSize,
) -> UInt8 {
    var cursor: UIntSize = plan.expression_start
    var operator_index: UIntSize = 0usize
    while cursor < plan.expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, plan.expression_end)
        if token.start >= plan.expression_end {
            break
        }
        if token.kind == 3u8 {
            let opcode: UInt8 = stage2_binary_opcode(bytes[token.start])
            if opcode >= 2u8 {
                if opcode <= 4u8 {
                    if operator_index == wanted_index {
                        return opcode
                    }
                    operator_index = operator_index + 1usize
                }
            }
        }
        cursor = token.end
    }
    return 0u8
}

@noalloc
fn stage2_streaming_plan_atom(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    effective_index: UIntSize,
) -> Stage2ExpressionPlanAtom {
    if plan.grouping_kind == 0usize {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            effective_index,
        )
        return Stage2ExpressionPlanAtom {
            value_index: effective_index,
            start: literal.start,
            end: literal.end,
        }
    }
    let group_left_index: UIntSize = plan.grouping_kind - 1usize
    if effective_index < group_left_index {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            effective_index,
        )
        return Stage2ExpressionPlanAtom {
            value_index: effective_index,
            start: literal.start,
            end: literal.end,
        }
    }
    if effective_index == group_left_index {
        return Stage2ExpressionPlanAtom {
            value_index: plan.literal_count,
            start: plan.group_start,
            end: plan.group_end,
        }
    }
    if plan.second_grouping_kind == 0usize {
        let literal_index: UIntSize = effective_index + 1usize
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
        return Stage2ExpressionPlanAtom {
            value_index: literal_index,
            start: literal.start,
            end: literal.end,
        }
    }
    let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
    let second_group_effective_index: UIntSize = second_group_left_index - 1usize
    if effective_index < second_group_effective_index {
        let literal_index: UIntSize = effective_index + 1usize
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
        return Stage2ExpressionPlanAtom {
            value_index: literal_index,
            start: literal.start,
            end: literal.end,
        }
    }
    if effective_index == second_group_effective_index {
        return Stage2ExpressionPlanAtom {
            value_index: plan.literal_count + 1usize,
            start: plan.second_group_start,
            end: plan.second_group_end,
        }
    }
    let literal_index: UIntSize = effective_index + 2usize
    let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(bytes, plan, literal_index)
    return Stage2ExpressionPlanAtom {
        value_index: literal_index,
        start: literal.start,
        end: literal.end,
    }
}

@noalloc
fn stage2_streaming_plan_operator(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    effective_index: UIntSize,
) -> UInt8 {
    var source_index: UIntSize = effective_index
    if plan.grouping_kind != 0usize {
        let group_left_index: UIntSize = plan.grouping_kind - 1usize
        if effective_index >= group_left_index {
            source_index = source_index + 1usize
        }
    }
    if plan.second_grouping_kind != 0usize {
        let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
        let second_group_effective_index: UIntSize = second_group_left_index - 1usize
        if effective_index >= second_group_effective_index {
            source_index = source_index + 1usize
        }
    }
    return stage2_streaming_operator_at(bytes, plan, source_index)
}

/// Emits five through sixteen operators by rescanning the validated source and
/// writing constants plus child-before-parent reductions directly into the
/// caller-owned Stage2JirRecord table. At most two disjoint, non-nested binary
/// groups are emitted in source order. No fixed operand array is retained.
@noalloc
fn stage2_emit_streaming_expression_plan(
    bytes: read Slice<UInt8>,
    plan: read Stage2StreamingExpressionPlan,
    function_index: UIntSize,
    return_statement_start: UIntSize,
    record_base: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2ExpressionPlanEmission {
    let record_count: UIntSize = 4usize + plan.operator_count * 2usize
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    var records_emitted: UIntSize = 0usize
    var literal_index: UIntSize = 1usize
    while literal_index < plan.literal_count {
        let literal: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            literal_index,
        )
        if !literal.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let output_index: UIntSize = record_base + 2usize + literal_index
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: 1u8,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: literal_index,
                operand_a: literal.value,
                operand_b: 0usize,
                source_start: literal.start,
                source_end: literal.end,
            }
            records_emitted = records_emitted + 1usize
        }
        literal_index = literal_index + 1usize
    }

    var nodes_emitted: UIntSize = 0usize
    var effective_atom_count: UIntSize = plan.literal_count
    if plan.grouping_kind != 0usize {
        let group_left_index: UIntSize = plan.grouping_kind - 1usize
        if group_left_index >= plan.operator_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            group_left_index,
        )
        let grouped_right: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            group_left_index + 1usize,
        )
        if !grouped_left.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if !grouped_right.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_streaming_operator_at(
            bytes,
            plan,
            group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + plan.literal_count
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: plan.literal_count,
                operand_a: group_left_index,
                operand_b: group_left_index + 1usize,
                source_start: plan.group_start,
                source_end: plan.group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = 1usize
        effective_atom_count = plan.literal_count - 1usize
    }
    if plan.second_grouping_kind != 0usize {
        if plan.grouping_kind == 0usize {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let first_group_left_index: UIntSize = plan.grouping_kind - 1usize
        let second_group_left_index: UIntSize = plan.second_grouping_kind - 1usize
        if second_group_left_index >= plan.operator_count {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if second_group_left_index <= first_group_left_index + 1usize {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_left: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            second_group_left_index,
        )
        let grouped_right: Stage2StreamingLiteral = stage2_streaming_literal_at(
            bytes,
            plan,
            second_group_left_index + 1usize,
        )
        if !grouped_left.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        if !grouped_right.valid {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let grouped_opcode: UInt8 = stage2_streaming_operator_at(
            bytes,
            plan,
            second_group_left_index,
        )
        if grouped_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let group_output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
        if group_output_index < output_capacity {
            output[group_output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: grouped_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: plan.literal_count + nodes_emitted,
                operand_a: second_group_left_index,
                operand_b: second_group_left_index + 1usize,
                source_start: plan.second_group_start,
                source_end: plan.second_group_end,
            }
            records_emitted = records_emitted + 1usize
        }
        nodes_emitted = nodes_emitted + 1usize
        effective_atom_count = effective_atom_count - 1usize
    }

    let first_atom: Stage2ExpressionPlanAtom = stage2_streaming_plan_atom(bytes, plan, 0usize)
    var segment_value_index: UIntSize = first_atom.value_index
    var segment_start: UIntSize = first_atom.start
    var segment_end: UIntSize = first_atom.end
    var accumulated_value_index: UIntSize = 0usize
    var accumulated_start: UIntSize = first_atom.start
    var pending_low_opcode: UInt8 = 0u8
    var has_accumulated: Bool = false
    let effective_binary_count: UIntSize = effective_atom_count - 1usize
    var operator_index: UIntSize = 0usize
    while operator_index < effective_binary_count {
        let current_opcode: UInt8 = stage2_streaming_plan_operator(
            bytes,
            plan,
            operator_index,
        )
        if current_opcode < 2u8 {
            return Stage2ExpressionPlanEmission {
                valid: false,
                record_count: record_count,
                records_emitted: records_emitted,
                final_value_index: 0usize,
            }
        }
        let next_atom: Stage2ExpressionPlanAtom = stage2_streaming_plan_atom(
            bytes,
            plan,
            operator_index + 1usize,
        )
        if current_opcode == 4u8 {
            let result_value_index: UIntSize = plan.literal_count + nodes_emitted
            let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
            if output_index < output_capacity {
                output[output_index] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: current_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: result_value_index,
                    operand_a: segment_value_index,
                    operand_b: next_atom.value_index,
                    source_start: segment_start,
                    source_end: next_atom.end,
                }
                records_emitted = records_emitted + 1usize
            }
            segment_value_index = result_value_index
            segment_end = next_atom.end
            nodes_emitted = nodes_emitted + 1usize
        } else {
            if has_accumulated {
                let result_value_index: UIntSize = plan.literal_count + nodes_emitted
                let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
                if output_index < output_capacity {
                    output[output_index] = Stage2JirRecord {
                        kind: 4u8,
                        opcode: pending_low_opcode,
                        type_kind: 2u8,
                        flags: 0u8,
                        function_index: function_index,
                        block_index: 0usize,
                        value_index: result_value_index,
                        operand_a: accumulated_value_index,
                        operand_b: segment_value_index,
                        source_start: accumulated_start,
                        source_end: segment_end,
                    }
                    records_emitted = records_emitted + 1usize
                }
                accumulated_value_index = result_value_index
                nodes_emitted = nodes_emitted + 1usize
            } else {
                accumulated_value_index = segment_value_index
                accumulated_start = segment_start
                has_accumulated = true
            }
            pending_low_opcode = current_opcode
            segment_value_index = next_atom.value_index
            segment_start = next_atom.start
            segment_end = next_atom.end
        }
        operator_index = operator_index + 1usize
    }

    var final_value_index: UIntSize = segment_value_index
    if has_accumulated {
        let result_value_index: UIntSize = plan.literal_count + nodes_emitted
        let output_index: UIntSize = record_base + 2usize + plan.literal_count + nodes_emitted
        if output_index < output_capacity {
            output[output_index] = Stage2JirRecord {
                kind: 4u8,
                opcode: pending_low_opcode,
                type_kind: 2u8,
                flags: 0u8,
                function_index: function_index,
                block_index: 0usize,
                value_index: result_value_index,
                operand_a: accumulated_value_index,
                operand_b: segment_value_index,
                source_start: accumulated_start,
                source_end: segment_end,
            }
            records_emitted = records_emitted + 1usize
        }
        final_value_index = result_value_index
        nodes_emitted = nodes_emitted + 1usize
    }
    if nodes_emitted != plan.operator_count {
        return Stage2ExpressionPlanEmission {
            valid: false,
            record_count: record_count,
            records_emitted: records_emitted,
            final_value_index: 0usize,
        }
    }
    let return_output_index: UIntSize = record_base + 2usize + plan.literal_count + plan.operator_count
    if return_output_index < output_capacity {
        output[return_output_index] = Stage2JirRecord {
            kind: 5u8,
            opcode: 1u8,
            type_kind: 2u8,
            flags: 1u8,
            function_index: function_index,
            block_index: 0usize,
            value_index: final_value_index,
            operand_a: 0usize,
            operand_b: 0usize,
            source_start: return_statement_start,
            source_end: plan.statement_end,
        }
        records_emitted = records_emitted + 1usize
    }
    return Stage2ExpressionPlanEmission {
        valid: true,
        record_count: record_count,
        records_emitted: records_emitted,
        final_value_index: final_value_index,
    }
}

fn stage2_invalid_two_literal_argument_direct_call_info() -> Stage2TwoLiteralArgumentDirectCallInfo {
    return Stage2TwoLiteralArgumentDirectCallInfo {
        valid: false,
        function_count: 0usize,
        direct_call_count: 0usize,
        first_caller_index: 0usize,
        first_callee_index: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_argument_start: 0usize,
        first_argument_end: 0usize,
        first_argument_value: 0usize,
        first_return_start: 0usize,
        first_return_end: 0usize,
        second_caller_index: 0usize,
        second_callee_index: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        second_argument_start: 0usize,
        second_argument_end: 0usize,
        second_argument_value: 0usize,
        second_return_start: 0usize,
        second_return_end: 0usize,
        third_caller_index: 0usize,
        third_callee_index: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        third_argument_start: 0usize,
        third_argument_end: 0usize,
        third_argument_value: 0usize,
        third_return_start: 0usize,
        third_return_end: 0usize,
        fourth_caller_index: 0usize,
        fourth_callee_index: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fourth_argument_start: 0usize,
        fourth_argument_end: 0usize,
        fourth_argument_value: 0usize,
        fourth_return_start: 0usize,
        fourth_return_end: 0usize,
        fifth_caller_index: 0usize,
        fifth_callee_index: 0usize,
        fifth_start: 0usize,
        fifth_end: 0usize,
        fifth_argument_start: 0usize,
        fifth_argument_end: 0usize,
        fifth_argument_value: 0usize,
        fifth_return_start: 0usize,
        fifth_return_end: 0usize,
        literal_function_index: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        literal_value: 0usize,
        literal_return_start: 0usize,
        literal_return_end: 0usize,
    }
}

/// Recognizes two through five same-module calls with one literal argument before
/// the historical single-call emitter runs. The frontend declaration,
/// statement and call tables remain the only source of identity and spans.
fn stage2_try_two_literal_argument_direct_calls(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
) -> Stage2TwoLiteralArgumentDirectCallInfo {
    let invalid = stage2_invalid_two_literal_argument_direct_call_info()
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
        if function_headers[function_index].parameter_count > 1usize {
            return invalid
        }
    }
    if function_count != 3usize {
        if function_count != 4usize {
            if function_count != 5usize {
                if function_count != 6usize {
                    return invalid
                }
            }
        }
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    if statement_count != function_count {
        return invalid
    }

    var direct_call_count: UIntSize = 0usize
    var first_caller_index: UIntSize = function_count
    var first_callee_index: UIntSize = function_count
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var first_argument_start: UIntSize = 0usize
    var first_argument_end: UIntSize = 0usize
    var first_argument_value: UIntSize = 0usize
    var second_caller_index: UIntSize = function_count
    var second_callee_index: UIntSize = function_count
    var second_start: UIntSize = 0usize
    var second_end: UIntSize = 0usize
    var second_argument_start: UIntSize = 0usize
    var second_argument_end: UIntSize = 0usize
    var second_argument_value: UIntSize = 0usize
    var third_caller_index: UIntSize = function_count
    var third_callee_index: UIntSize = function_count
    var third_start: UIntSize = 0usize
    var third_end: UIntSize = 0usize
    var third_argument_start: UIntSize = 0usize
    var third_argument_end: UIntSize = 0usize
    var third_argument_value: UIntSize = 0usize
    var fourth_caller_index: UIntSize = function_count
    var fourth_callee_index: UIntSize = function_count
    var fourth_start: UIntSize = 0usize
    var fourth_end: UIntSize = 0usize
    var fourth_argument_start: UIntSize = 0usize
    var fourth_argument_end: UIntSize = 0usize
    var fourth_argument_value: UIntSize = 0usize
    var fifth_caller_index: UIntSize = function_count
    var fifth_callee_index: UIntSize = function_count
    var fifth_start: UIntSize = 0usize
    var fifth_end: UIntSize = 0usize
    var fifth_argument_start: UIntSize = 0usize
    var fifth_argument_end: UIntSize = 0usize
    var fifth_argument_value: UIntSize = 0usize
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                calls[call_index].callee_start,
                calls[call_index].callee_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                if calls[call_index].open_start >= function_headers[function_index].name_end {
                    if calls[call_index].close_end < function_headers[function_index].body_start {
                        is_signature_group = true
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if is_signature_group {
            continue
        }
        var caller_index: UIntSize = function_count
        for function_index in function_headers.indices {
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    if caller_index != function_count {
                        return invalid
                    }
                    caller_index = function_index
                }
            }
        }
        if caller_index == function_count {
            // Declarations and other non-body call-shaped spans are not
            // executable direct calls; only a call nested in one function
            // body participates in this bounded admission.
            continue
        }
        if calls[call_index].argument_count != 1usize {
            return invalid
        }
        if calls[call_index].depth != 0usize {
            return invalid
        }
        var candidate_start: UIntSize = calls[call_index].callee_start
        let candidate_end: UIntSize = calls[call_index].callee_end
        if candidate_end >= candidate_start + 7usize {
            if bytes[candidate_start] == 0x72u8 {
                if bytes[candidate_start + 1usize] == 0x65u8 {
                    if bytes[candidate_start + 2usize] == 0x74u8 {
                        if bytes[candidate_start + 3usize] == 0x75u8 {
                            if bytes[candidate_start + 4usize] == 0x72u8 {
                                if bytes[candidate_start + 5usize] == 0x6Eu8 {
                                    if bytes[candidate_start + 6usize] == 0x20u8 {
                                        candidate_start = candidate_start + 7usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var target_index: UIntSize = function_count
        var target_matches: UIntSize = 0usize
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                candidate_start,
                candidate_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                if function_headers[function_index].parameter_count != 1usize {
                    return invalid
                }
                target_index = function_index
                target_matches = target_matches + 1usize
            }
        }
        if target_matches != 1usize {
            return invalid
        }
        let argument = scan_token_info(
            bytes,
            calls[call_index].open_end,
            calls[call_index].close_start,
        )
        let argument_value = stage2_i32_literal_value(bytes, argument.start, argument.end)
        if argument.start >= argument.end {
            return invalid
        }
        if argument_value == 2147483648usize {
            return invalid
        }
        let trailing = scan_token_info(bytes, argument.end, calls[call_index].close_start)
        if trailing.start < calls[call_index].close_start {
            return invalid
        }
        if direct_call_count == 0usize {
            first_caller_index = caller_index
            first_callee_index = target_index
            first_start = candidate_start
            first_end = calls[call_index].close_end
            first_argument_start = argument.start
            first_argument_end = argument.end
            first_argument_value = argument_value
        } else if direct_call_count == 1usize {
            second_caller_index = caller_index
            second_callee_index = target_index
            second_start = candidate_start
            second_end = calls[call_index].close_end
            second_argument_start = argument.start
            second_argument_end = argument.end
            second_argument_value = argument_value
        } else if direct_call_count == 2usize {
            third_caller_index = caller_index
            third_callee_index = target_index
            third_start = candidate_start
            third_end = calls[call_index].close_end
            third_argument_start = argument.start
            third_argument_end = argument.end
            third_argument_value = argument_value
        } else if direct_call_count == 3usize {
            fourth_caller_index = caller_index
            fourth_callee_index = target_index
            fourth_start = candidate_start
            fourth_end = calls[call_index].close_end
            fourth_argument_start = argument.start
            fourth_argument_end = argument.end
            fourth_argument_value = argument_value
        } else if direct_call_count == 4usize {
            fifth_caller_index = caller_index
            fifth_callee_index = target_index
            fifth_start = candidate_start
            fifth_end = calls[call_index].close_end
            fifth_argument_start = argument.start
            fifth_argument_end = argument.end
            fifth_argument_value = argument_value
        } else {
            return invalid
        }
        direct_call_count = direct_call_count + 1usize
    }
    let expected_direct_call_count: UIntSize = function_count - 1usize
    if direct_call_count != expected_direct_call_count {
        return invalid
    }
    if first_caller_index == second_caller_index {
        return invalid
    }
    if direct_call_count == 3usize {
        if third_caller_index == first_caller_index {
            return invalid
        }
        if third_caller_index == second_caller_index {
            return invalid
        }
    }
    if direct_call_count == 4usize {
        if fourth_caller_index == first_caller_index {
            return invalid
        }
        if fourth_caller_index == second_caller_index {
            return invalid
        }
        if fourth_caller_index == third_caller_index {
            return invalid
        }
    }
    if direct_call_count == 5usize {
        if fifth_caller_index == first_caller_index {
            return invalid
        }
        if fifth_caller_index == second_caller_index {
            return invalid
        }
        if fifth_caller_index == third_caller_index {
            return invalid
        }
        if fifth_caller_index == fourth_caller_index {
            return invalid
        }
    }

    var first_return_start: UIntSize = 0usize
    var first_return_end: UIntSize = 0usize
    var second_return_start: UIntSize = 0usize
    var second_return_end: UIntSize = 0usize
    var third_return_start: UIntSize = 0usize
    var third_return_end: UIntSize = 0usize
    var fourth_return_start: UIntSize = 0usize
    var fourth_return_end: UIntSize = 0usize
    var fifth_return_start: UIntSize = 0usize
    var fifth_return_end: UIntSize = 0usize
    var literal_function_index: UIntSize = function_count
    var literal_start: UIntSize = 0usize
    var literal_end: UIntSize = 0usize
    var literal_value: UIntSize = 0usize
    var literal_return_start: UIntSize = 0usize
    var literal_return_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        var body_statement_count: UIntSize = 0usize
        var body_statement_index: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    body_statement_count = body_statement_count + 1usize
                    body_statement_index = statement_index
                }
            }
        }
        if body_statement_count != 1usize {
            return invalid
        }
        if statements[body_statement_index].kind != 2u8 {
            return invalid
        }
        if function_index == first_caller_index {
            first_return_start = statements[body_statement_index].start
            first_return_end = first_end + 1usize
        } else if function_index == second_caller_index {
            second_return_start = statements[body_statement_index].start
            second_return_end = second_end + 1usize
        } else if function_index == third_caller_index {
            third_return_start = statements[body_statement_index].start
            third_return_end = third_end + 1usize
        } else if function_index == fourth_caller_index {
            fourth_return_start = statements[body_statement_index].start
            fourth_return_end = fourth_end + 1usize
        } else if function_index == fifth_caller_index {
            fifth_return_start = statements[body_statement_index].start
            fifth_return_end = fifth_end + 1usize
        } else {
            let expression = stage2_parse_return_i32_expression(
                bytes,
                statements[body_statement_index].start,
                function_headers[function_index].body_end - 1usize,
            )
            if expression.kind != 1u8 {
                return invalid
            }
            literal_function_index = function_index
            literal_start = expression.left_start
            literal_end = expression.left_end
            literal_value = expression.left_value
            literal_return_start = statements[body_statement_index].start
            literal_return_end = expression.statement_end
        }
    }
    if literal_function_index == function_count {
        return invalid
    }
    return Stage2TwoLiteralArgumentDirectCallInfo {
        valid: true,
        function_count: function_count,
        direct_call_count: direct_call_count,
        first_caller_index: first_caller_index,
        first_callee_index: first_callee_index,
        first_start: first_start,
        first_end: first_end,
        first_argument_start: first_argument_start,
        first_argument_end: first_argument_end,
        first_argument_value: first_argument_value,
        first_return_start: first_return_start,
        first_return_end: first_return_end,
        second_caller_index: second_caller_index,
        second_callee_index: second_callee_index,
        second_start: second_start,
        second_end: second_end,
        second_argument_start: second_argument_start,
        second_argument_end: second_argument_end,
        second_argument_value: second_argument_value,
        second_return_start: second_return_start,
        second_return_end: second_return_end,
        third_caller_index: third_caller_index,
        third_callee_index: third_callee_index,
        third_start: third_start,
        third_end: third_end,
        third_argument_start: third_argument_start,
        third_argument_end: third_argument_end,
        third_argument_value: third_argument_value,
        third_return_start: third_return_start,
        third_return_end: third_return_end,
        fourth_caller_index: fourth_caller_index,
        fourth_callee_index: fourth_callee_index,
        fourth_start: fourth_start,
        fourth_end: fourth_end,
        fourth_argument_start: fourth_argument_start,
        fourth_argument_end: fourth_argument_end,
        fourth_argument_value: fourth_argument_value,
        fourth_return_start: fourth_return_start,
        fourth_return_end: fourth_return_end,
        fifth_caller_index: fifth_caller_index,
        fifth_callee_index: fifth_callee_index,
        fifth_start: fifth_start,
        fifth_end: fifth_end,
        fifth_argument_start: fifth_argument_start,
        fifth_argument_end: fifth_argument_end,
        fifth_argument_value: fifth_argument_value,
        fifth_return_start: fifth_return_start,
        fifth_return_end: fifth_return_end,
        literal_function_index: literal_function_index,
        literal_start: literal_start,
        literal_end: literal_end,
        literal_value: literal_value,
        literal_return_start: literal_return_start,
        literal_return_end: literal_return_end,
    }
}

fn stage2_invalid_two_zero_direct_call_info() -> Stage2TwoZeroDirectCallInfo {
    return Stage2TwoZeroDirectCallInfo {
        valid: false,
        function_count: 0usize,
        direct_call_count: 0usize,
        first_caller_index: 0usize,
        first_callee_index: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_return_start: 0usize,
        first_return_end: 0usize,
        second_caller_index: 0usize,
        second_callee_index: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        second_return_start: 0usize,
        second_return_end: 0usize,
        third_caller_index: 0usize,
        third_callee_index: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        third_return_start: 0usize,
        third_return_end: 0usize,
        fourth_caller_index: 0usize,
        fourth_callee_index: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fourth_return_start: 0usize,
        fourth_return_end: 0usize,
        literal_function_index: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        literal_value: 0usize,
        literal_return_start: 0usize,
        literal_return_end: 0usize,
    }
}

struct Stage2TwoZeroResultBindingInfo {
    valid: Bool,
    function_count: UIntSize,
    first_caller_index: UIntSize,
    first_callee_index: UIntSize,
    first_start: UIntSize,
    first_end: UIntSize,
    first_declaration_start: UIntSize,
    first_declaration_end: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    first_return_start: UIntSize,
    first_return_end: UIntSize,
    second_caller_index: UIntSize,
    second_callee_index: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
    second_declaration_start: UIntSize,
    second_declaration_end: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    second_return_start: UIntSize,
    second_return_end: UIntSize,
    literal_function_index: UIntSize,
    literal_start: UIntSize,
    literal_end: UIntSize,
    literal_value: UIntSize,
    literal_return_start: UIntSize,
    literal_return_end: UIntSize,
}

struct Stage2SameFunctionTwoZeroCallInfo {
    valid: Bool,
    function_count: UIntSize,
    caller_index: UIntSize,
    first_callee_index: UIntSize,
    first_start: UIntSize,
    first_end: UIntSize,
    first_declaration_start: UIntSize,
    first_declaration_end: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    second_callee_index: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    literal_function_index: UIntSize,
    literal_start: UIntSize,
    literal_end: UIntSize,
    literal_value: UIntSize,
    literal_return_start: UIntSize,
    literal_return_end: UIntSize,
    second_declaration_start: UIntSize,
    second_declaration_end: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    binary_operator_opcode: UInt8,
}

fn stage2_invalid_same_function_two_zero_call_info() -> Stage2SameFunctionTwoZeroCallInfo {
    return Stage2SameFunctionTwoZeroCallInfo {
        valid: false,
        function_count: 0usize,
        caller_index: 0usize,
        first_callee_index: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        second_callee_index: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        literal_function_index: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        literal_value: 0usize,
        literal_return_start: 0usize,
        literal_return_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        binary_operator_opcode: 0u8,
    }
}

/// Recognizes one parameterless caller which evaluates two zero-argument
/// direct calls in source order. The first result is bound to an immutable
/// local, the second call is intentionally evaluated for its side effect, and
/// the caller returns the first result. This is the smallest useful admission
/// for same-function call sequencing; arbitrary statement graphs remain out.
fn stage2_try_same_function_two_zero_calls(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
) -> Stage2SameFunctionTwoZeroCallInfo {
    let invalid = stage2_invalid_same_function_two_zero_call_info()
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
        if function_headers[function_index].parameter_count != 0usize {
            return invalid
        }
    }
    if function_count != 2usize {
        return invalid
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    if statement_count != 3usize {
        if statement_count != 4usize {
            return invalid
        }
    }
    var direct_call_count: UIntSize = 0usize
    var caller_index: UIntSize = function_count
    var first_callee_index: UIntSize = function_count
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var second_callee_index: UIntSize = function_count
    var second_start: UIntSize = 0usize
    var second_end: UIntSize = 0usize
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                calls[call_index].callee_start,
                calls[call_index].callee_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                if calls[call_index].open_start >= function_headers[function_index].name_end {
                    if calls[call_index].close_end < function_headers[function_index].body_start {
                        is_signature_group = true
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if is_signature_group {
            continue
        }
        var body_caller: UIntSize = function_count
        for function_index in function_headers.indices {
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    if body_caller != function_count {
                        return invalid
                    }
                    body_caller = function_index
                }
            }
        }
        if body_caller == function_count {
            return invalid
        }
        if calls[call_index].argument_count != 0usize {
            return invalid
        }
        if calls[call_index].depth != 0usize {
            return invalid
        }
        var candidate_start: UIntSize = calls[call_index].callee_start
        let candidate_end: UIntSize = calls[call_index].callee_end
        if candidate_end >= candidate_start + 7usize {
            if bytes[candidate_start] == 0x72u8 {
                if bytes[candidate_start + 1usize] == 0x65u8 {
                    if bytes[candidate_start + 2usize] == 0x74u8 {
                        if bytes[candidate_start + 3usize] == 0x75u8 {
                            if bytes[candidate_start + 4usize] == 0x72u8 {
                                if bytes[candidate_start + 5usize] == 0x6Eu8 {
                                    if bytes[candidate_start + 6usize] == 0x20u8 {
                                        candidate_start = candidate_start + 7usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var target_index: UIntSize = function_count
        var target_matches: UIntSize = 0usize
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                candidate_start,
                candidate_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                target_index = function_index
                target_matches = target_matches + 1usize
            }
        }
        if target_matches != 1usize {
            return invalid
        }
        if direct_call_count == 0usize {
            caller_index = body_caller
            first_callee_index = target_index
            first_start = candidate_start
            first_end = calls[call_index].close_end
        } else if direct_call_count == 1usize {
            if body_caller != caller_index {
                return invalid
            }
            second_callee_index = target_index
            second_start = candidate_start
            second_end = calls[call_index].close_end
        } else {
            return invalid
        }
        direct_call_count = direct_call_count + 1usize
    }
    if direct_call_count != 2usize {
        return invalid
    }
    if first_callee_index == caller_index {
        return invalid
    }
    if second_callee_index == caller_index {
        return invalid
    }
    var first_statement_start: UIntSize = function_headers[caller_index].body_end
    var caller_statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        if statements[statement_index].start > function_headers[caller_index].body_start {
            if statements[statement_index].end < function_headers[caller_index].body_end {
                caller_statement_count = caller_statement_count + 1usize
                if statements[statement_index].start < first_statement_start {
                    first_statement_start = statements[statement_index].start
                }
            }
        }
    }
    if caller_statement_count != 2usize {
        if caller_statement_count != 3usize {
            return invalid
        }
    }
    var binding = stage2_invalid_direct_call_result_binding_info()
    var second_binding = stage2_invalid_direct_call_result_binding_info()
    var binary_start: UIntSize = 0usize
    var binary_end: UIntSize = 0usize
    var binary_operator_opcode: UInt8 = 0u8
    if caller_statement_count == 2usize {
        binding = stage2_parse_direct_call_result_binding_fallback(
            bytes,
            first_statement_start,
            first_start,
            second_end,
            function_headers[caller_index].body_end,
        )
        if !binding.valid {
            return invalid
        }
    } else {
        var second_statement_start: UIntSize = function_headers[caller_index].body_end
        var return_statement_start: UIntSize = function_headers[caller_index].body_end
        var return_statement_end: UIntSize = function_headers[caller_index].body_end
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[caller_index].body_start {
                if statements[statement_index].end < function_headers[caller_index].body_end {
                    if statements[statement_index].start < second_start {
                        if statements[statement_index].start > first_start {
                            second_statement_start = statements[statement_index].start
                        }
                    }
                    if statements[statement_index].start > second_end {
                        if statements[statement_index].start < return_statement_start {
                            return_statement_start = statements[statement_index].start
                            return_statement_end = function_headers[caller_index].body_end - 1usize
                        }
                    }
                }
            }
        }
        if second_statement_start >= second_start {
            return invalid
        }
        if return_statement_start >= return_statement_end {
            return invalid
        }
        binding = stage2_parse_direct_call_binding_prefix(bytes, first_statement_start, first_start)
        second_binding = stage2_parse_direct_call_binding_prefix(bytes, second_statement_start, second_start)
        if !binding.valid {
            return invalid
        }
        if !second_binding.valid {
            return invalid
        }
        let expression = stage2_parse_parameter_pair_return_i32_expression(
            bytes,
            return_statement_start,
            return_statement_end,
            true,
            binding.declaration_start,
            binding.declaration_end,
            second_binding.declaration_start,
            second_binding.declaration_end,
        )
        if expression.kind != 7u8 {
            return invalid
        }
        binary_start = expression.expression_start
        binary_end = expression.expression_end
        binary_operator_opcode = expression.operator_opcode
        binding.use_start = expression.left_start
        binding.use_end = expression.left_end
        binding.return_start = return_statement_start
        binding.return_end = expression.statement_end
        second_binding.use_start = expression.right_start
        second_binding.use_end = expression.right_end
        second_binding.return_start = return_statement_start
        second_binding.return_end = expression.statement_end
    }
    var literal_function_index: UIntSize = function_count
    var literal_start: UIntSize = 0usize
    var literal_end: UIntSize = 0usize
    var literal_value: UIntSize = 0usize
    var literal_return_start: UIntSize = 0usize
    var literal_return_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        if function_index != caller_index {
            var body_statement_count: UIntSize = 0usize
            var body_statement_index: UIntSize = 0usize
            for statement_index in statements.indices {
                if statements[statement_index].start > function_headers[function_index].body_start {
                    if statements[statement_index].end < function_headers[function_index].body_end {
                        body_statement_count = body_statement_count + 1usize
                        body_statement_index = statement_index
                    }
                }
            }
            if body_statement_count != 1usize {
                return invalid
            }
            let expression = stage2_parse_return_i32_expression(
                bytes,
                statements[body_statement_index].start,
                function_headers[function_index].body_end - 1usize,
            )
            if expression.kind != 1u8 {
                return invalid
            }
            literal_function_index = function_index
            literal_start = expression.left_start
            literal_end = expression.left_end
            literal_value = expression.left_value
            literal_return_start = statements[body_statement_index].start
            literal_return_end = expression.statement_end
        }
    }
    return Stage2SameFunctionTwoZeroCallInfo {
        valid: true,
        function_count: function_count,
        caller_index: caller_index,
        first_callee_index: first_callee_index,
        first_start: first_start,
        first_end: first_end,
        first_declaration_start: binding.declaration_start,
        first_declaration_end: binding.declaration_end,
        first_use_start: binding.use_start,
        first_use_end: binding.use_end,
        second_callee_index: second_callee_index,
        second_start: second_start,
        second_end: second_end,
        return_start: binding.return_start,
        return_end: binding.return_end,
        literal_function_index: literal_function_index,
        literal_start: literal_start,
        literal_end: literal_end,
        literal_value: literal_value,
        literal_return_start: literal_return_start,
        literal_return_end: literal_return_end,
        second_declaration_start: second_binding.declaration_start,
        second_declaration_end: second_binding.declaration_end,
        second_use_start: second_binding.use_start,
        second_use_end: second_binding.use_end,
        binary_start: binary_start,
        binary_end: binary_end,
        binary_operator_opcode: binary_operator_opcode,
    }
}

fn stage2_emit_same_function_two_zero_calls(
    info: Stage2SameFunctionTwoZeroCallInfo,
    function_headers: read Slice<FunctionHeader>,
    calls_seen: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    let has_two_result_bindings: Bool = info.second_declaration_start > 0usize
    let records_required: UIntSize = if has_two_result_bindings { 13usize } else { 1usize + info.function_count * 2usize + 2usize + 4usize }
    var records_emitted: UIntSize = 0usize
    var record_cursor: UIntSize = 0usize
    if record_cursor < output_capacity {
        output[record_cursor] = Stage2JirRecord { kind: 1u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 32usize, operand_b: 0usize, source_start: 0usize, source_end: 0usize }
        records_emitted = records_emitted + 1usize
    }
    record_cursor = record_cursor + 1usize
    for function_index in function_headers.indices {
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].name_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].body_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if function_index == info.caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.first_callee_index, operand_b: 0usize, source_start: info.first_start, source_end: info.first_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.first_use_start, operand_b: info.first_use_end, source_start: info.first_declaration_start, source_end: info.first_declaration_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 1usize, operand_a: info.second_callee_index, operand_b: 0usize, source_start: info.second_start, source_end: info.second_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if has_two_result_bindings {
                if record_cursor < output_capacity {
                    output[record_cursor] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 1usize, operand_a: info.second_use_start, operand_b: info.second_use_end, source_start: info.second_declaration_start, source_end: info.second_declaration_end }
                    records_emitted = records_emitted + 1usize
                }
                record_cursor = record_cursor + 1usize
                if record_cursor < output_capacity {
                    output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: info.binary_operator_opcode, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 2usize, operand_a: 0usize, operand_b: 1usize, source_start: info.binary_start, source_end: info.binary_end }
                    records_emitted = records_emitted + 1usize
                }
                record_cursor = record_cursor + 1usize
                if record_cursor < output_capacity {
                    output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 2usize, operand_a: 0usize, operand_b: 0usize, source_start: info.return_start, source_end: info.return_end }
                    records_emitted = records_emitted + 1usize
                }
                record_cursor = record_cursor + 1usize
            } else {
                if record_cursor < output_capacity {
                    output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.return_start, source_end: info.return_end }
                    records_emitted = records_emitted + 1usize
                }
                record_cursor = record_cursor + 1usize
            }
        } else {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.literal_value, operand_b: 0usize, source_start: info.literal_start, source_end: info.literal_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.literal_return_start, source_end: info.literal_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        }
    }
    return Stage2JirSummary { functions_seen: info.function_count, statements_seen: if has_two_result_bindings { 4usize } else { 3usize }, calls_seen: calls_seen, records_required: records_required, records_emitted: records_emitted, functions_lowered: info.function_count, errors: 0usize, status_flags: if records_emitted == records_required { 7usize } else { 3usize } }
}

fn stage2_invalid_two_zero_result_binding_info() -> Stage2TwoZeroResultBindingInfo {
    return Stage2TwoZeroResultBindingInfo {
        valid: false,
        function_count: 0usize,
        first_caller_index: 0usize,
        first_callee_index: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        first_return_start: 0usize,
        first_return_end: 0usize,
        second_caller_index: 0usize,
        second_callee_index: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        second_return_start: 0usize,
        second_return_end: 0usize,
        literal_function_index: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        literal_value: 0usize,
        literal_return_start: 0usize,
        literal_return_end: 0usize,
    }
}

/// Recognizes two distinct parameterless caller functions which each bind one
/// zero-argument direct-call result and immediately return that immutable local.
/// This is intentionally a three-function, two-call admission; arbitrary
/// multiple calls and mixed statement graphs remain outside this producer step.
fn stage2_try_two_zero_result_bindings(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
) -> Stage2TwoZeroResultBindingInfo {
    let invalid = stage2_invalid_two_zero_result_binding_info()
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
        if function_headers[function_index].parameter_count != 0usize {
            return invalid
        }
    }
    if function_count != 3usize {
        return invalid
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    if statement_count != 5usize {
        return invalid
    }
    var direct_call_count: UIntSize = 0usize
    var first_caller_index: UIntSize = function_count
    var first_callee_index: UIntSize = function_count
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var second_caller_index: UIntSize = function_count
    var second_callee_index: UIntSize = function_count
    var second_start: UIntSize = 0usize
    var second_end: UIntSize = 0usize
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                calls[call_index].callee_start,
                calls[call_index].callee_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                if calls[call_index].open_start >= function_headers[function_index].name_end {
                    if calls[call_index].close_end < function_headers[function_index].body_start {
                        is_signature_group = true
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if is_signature_group {
            continue
        }
        var caller_index: UIntSize = function_count
        for function_index in function_headers.indices {
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    if caller_index != function_count {
                        return invalid
                    }
                    caller_index = function_index
                }
            }
        }
        if caller_index == function_count {
            return invalid
        }
        if calls[call_index].argument_count != 0usize {
            return invalid
        }
        if calls[call_index].depth != 0usize {
            return invalid
        }
        var candidate_start: UIntSize = calls[call_index].callee_start
        let candidate_end: UIntSize = calls[call_index].callee_end
        if candidate_end >= candidate_start + 7usize {
            if bytes[candidate_start] == 0x72u8 {
                if bytes[candidate_start + 1usize] == 0x65u8 {
                    if bytes[candidate_start + 2usize] == 0x74u8 {
                        if bytes[candidate_start + 3usize] == 0x75u8 {
                            if bytes[candidate_start + 4usize] == 0x72u8 {
                                if bytes[candidate_start + 5usize] == 0x6Eu8 {
                                    if bytes[candidate_start + 6usize] == 0x20u8 {
                                        candidate_start = candidate_start + 7usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var target_index: UIntSize = function_count
        var target_matches: UIntSize = 0usize
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                candidate_start,
                candidate_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                target_index = function_index
                target_matches = target_matches + 1usize
            }
        }
        if target_matches != 1usize {
            return invalid
        }
        if direct_call_count == 0usize {
            first_caller_index = caller_index
            first_callee_index = target_index
            first_start = candidate_start
            first_end = calls[call_index].close_end
        } else if direct_call_count == 1usize {
            second_caller_index = caller_index
            second_callee_index = target_index
            second_start = candidate_start
            second_end = calls[call_index].close_end
        } else {
            return invalid
        }
        direct_call_count = direct_call_count + 1usize
    }
    if direct_call_count != 2usize {
        return invalid
    }
    if first_caller_index == second_caller_index {
        return invalid
    }
    var first_declaration_start: UIntSize = 0usize
    var first_declaration_end: UIntSize = 0usize
    var first_use_start: UIntSize = 0usize
    var first_use_end: UIntSize = 0usize
    var first_return_start: UIntSize = 0usize
    var first_return_end: UIntSize = 0usize
    var second_declaration_start: UIntSize = 0usize
    var second_declaration_end: UIntSize = 0usize
    var second_use_start: UIntSize = 0usize
    var second_use_end: UIntSize = 0usize
    var second_return_start: UIntSize = 0usize
    var second_return_end: UIntSize = 0usize
    var literal_function_index: UIntSize = function_count
    var literal_start: UIntSize = 0usize
    var literal_end: UIntSize = 0usize
    var literal_value: UIntSize = 0usize
    var literal_return_start: UIntSize = 0usize
    var literal_return_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        var body_statement_count: UIntSize = 0usize
        var first_statement_start: UIntSize = function_headers[function_index].body_end
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    body_statement_count = body_statement_count + 1usize
                    if statements[statement_index].start < first_statement_start {
                        first_statement_start = statements[statement_index].start
                    }
                }
            }
        }
        if function_index == first_caller_index {
            if body_statement_count != 2usize {
                return invalid
            }
            let binding = stage2_parse_direct_call_result_binding_fallback(
                bytes,
                first_statement_start,
                first_start,
                first_end,
                function_headers[function_index].body_end,
            )
            if !binding.valid {
                return invalid
            }
            first_declaration_start = binding.declaration_start
            first_declaration_end = binding.declaration_end
            first_use_start = binding.use_start
            first_use_end = binding.use_end
            first_return_start = binding.return_start
            first_return_end = binding.return_end
        } else if function_index == second_caller_index {
            if body_statement_count != 2usize {
                return invalid
            }
            let binding = stage2_parse_direct_call_result_binding_fallback(
                bytes,
                first_statement_start,
                second_start,
                second_end,
                function_headers[function_index].body_end,
            )
            if !binding.valid {
                return invalid
            }
            second_declaration_start = binding.declaration_start
            second_declaration_end = binding.declaration_end
            second_use_start = binding.use_start
            second_use_end = binding.use_end
            second_return_start = binding.return_start
            second_return_end = binding.return_end
        } else {
            if body_statement_count != 1usize {
                return invalid
            }
            var statement_index: UIntSize = 0usize
            for candidate_index in statements.indices {
                if statements[candidate_index].start > function_headers[function_index].body_start {
                    if statements[candidate_index].end < function_headers[function_index].body_end {
                        statement_index = candidate_index
                    }
                }
            }
            let expression = stage2_parse_return_i32_expression(
                bytes,
                statements[statement_index].start,
                function_headers[function_index].body_end - 1usize,
            )
            if expression.kind != 1u8 {
                return invalid
            }
            literal_function_index = function_index
            literal_start = expression.left_start
            literal_end = expression.left_end
            literal_value = expression.left_value
            literal_return_start = statements[statement_index].start
            literal_return_end = expression.statement_end
        }
    }
    if literal_function_index == function_count {
        return invalid
    }
    return Stage2TwoZeroResultBindingInfo {
        valid: true,
        function_count: function_count,
        first_caller_index: first_caller_index,
        first_callee_index: first_callee_index,
        first_start: first_start,
        first_end: first_end,
        first_declaration_start: first_declaration_start,
        first_declaration_end: first_declaration_end,
        first_use_start: first_use_start,
        first_use_end: first_use_end,
        first_return_start: first_return_start,
        first_return_end: first_return_end,
        second_caller_index: second_caller_index,
        second_callee_index: second_callee_index,
        second_start: second_start,
        second_end: second_end,
        second_declaration_start: second_declaration_start,
        second_declaration_end: second_declaration_end,
        second_use_start: second_use_start,
        second_use_end: second_use_end,
        second_return_start: second_return_start,
        second_return_end: second_return_end,
        literal_function_index: literal_function_index,
        literal_start: literal_start,
        literal_end: literal_end,
        literal_value: literal_value,
        literal_return_start: literal_return_start,
        literal_return_end: literal_return_end,
    }
}

fn stage2_emit_two_zero_result_bindings(
    info: Stage2TwoZeroResultBindingInfo,
    function_headers: read Slice<FunctionHeader>,
    calls_seen: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    let records_required: UIntSize = 1usize + info.function_count * 2usize + 2usize + 2usize * 3usize
    var records_emitted: UIntSize = 0usize
    var record_cursor: UIntSize = 0usize
    if record_cursor < output_capacity {
        output[record_cursor] = Stage2JirRecord { kind: 1u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 32usize, operand_b: 0usize, source_start: 0usize, source_end: 0usize }
        records_emitted = records_emitted + 1usize
    }
    record_cursor = record_cursor + 1usize
    for function_index in function_headers.indices {
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].name_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].body_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if function_index == info.first_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.first_callee_index, operand_b: 0usize, source_start: info.first_start, source_end: info.first_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.first_use_start, operand_b: info.first_use_end, source_start: info.first_declaration_start, source_end: info.first_declaration_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.first_return_start, source_end: info.first_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.second_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.second_callee_index, operand_b: 0usize, source_start: info.second_start, source_end: info.second_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.second_use_start, operand_b: info.second_use_end, source_start: info.second_declaration_start, source_end: info.second_declaration_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.second_return_start, source_end: info.second_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.literal_value, operand_b: 0usize, source_start: info.literal_start, source_end: info.literal_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.literal_return_start, source_end: info.literal_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        }
    }
    return Stage2JirSummary { functions_seen: info.function_count, statements_seen: 5usize, calls_seen: calls_seen, records_required: records_required, records_emitted: records_emitted, functions_lowered: info.function_count, errors: 0usize, status_flags: if records_emitted == records_required { 7usize } else { 3usize } }
}

/// Recognizes the intentionally small multi-call producer shape before the
/// historical single-call emitter runs.  The declaration, statement and call
/// tables remain the source of truth; this helper never matches function names
/// or source offsets by fixture-specific constants.
fn stage2_try_two_zero_direct_calls(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
) -> Stage2TwoZeroDirectCallInfo {
    let invalid = stage2_invalid_two_zero_direct_call_info()
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
        if function_headers[function_index].parameter_count != 0usize {
            return invalid
        }
    }
    if function_count != 3usize {
        if function_count != 4usize {
            if function_count != 5usize {
                return invalid
            }
        }
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    if statement_count != function_count {
        return invalid
    }

    var direct_call_count: UIntSize = 0usize
    var first_caller_index: UIntSize = function_count
    var first_callee_index: UIntSize = function_count
    var first_start: UIntSize = 0usize
    var first_end: UIntSize = 0usize
    var second_caller_index: UIntSize = function_count
    var second_callee_index: UIntSize = function_count
    var second_start: UIntSize = 0usize
    var second_end: UIntSize = 0usize
    var third_caller_index: UIntSize = function_count
    var third_callee_index: UIntSize = function_count
    var third_start: UIntSize = 0usize
    var third_end: UIntSize = 0usize
    var fourth_caller_index: UIntSize = function_count
    var fourth_callee_index: UIntSize = function_count
    var fourth_start: UIntSize = 0usize
    var fourth_end: UIntSize = 0usize
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                calls[call_index].callee_start,
                calls[call_index].callee_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                if calls[call_index].open_start >= function_headers[function_index].name_end {
                    if calls[call_index].close_end < function_headers[function_index].body_start {
                        is_signature_group = true
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if is_signature_group {
            continue
        }

        var caller_index: UIntSize = function_count
        for function_index in function_headers.indices {
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    if caller_index != function_count {
                        return invalid
                    }
                    caller_index = function_index
                }
            }
        }
        if caller_index == function_count {
            return invalid
        }
        if calls[call_index].argument_count != 0usize {
            return invalid
        }
        if calls[call_index].depth != 0usize {
            return invalid
        }
        var candidate_start: UIntSize = calls[call_index].callee_start
        let candidate_end: UIntSize = calls[call_index].callee_end
        if candidate_end >= candidate_start + 7usize {
            if bytes[candidate_start] == 0x72u8 {
                if bytes[candidate_start + 1usize] == 0x65u8 {
                    if bytes[candidate_start + 2usize] == 0x74u8 {
                        if bytes[candidate_start + 3usize] == 0x75u8 {
                            if bytes[candidate_start + 4usize] == 0x72u8 {
                                if bytes[candidate_start + 5usize] == 0x6Eu8 {
                                    if bytes[candidate_start + 6usize] == 0x20u8 {
                                        candidate_start = candidate_start + 7usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        var target_index: UIntSize = function_count
        var target_matches: UIntSize = 0usize
        for function_index in function_headers.indices {
            if stage2_same_ascii(
                bytes,
                candidate_start,
                candidate_end,
                function_headers[function_index].name_start,
                function_headers[function_index].name_end,
            ) {
                target_index = function_index
                target_matches = target_matches + 1usize
            }
        }
        if target_matches != 1usize {
            return invalid
        }
        if direct_call_count == 0usize {
            first_caller_index = caller_index
            first_callee_index = target_index
            first_start = candidate_start
            first_end = calls[call_index].close_end
        } else if direct_call_count == 1usize {
            second_caller_index = caller_index
            second_callee_index = target_index
            second_start = candidate_start
            second_end = calls[call_index].close_end
        } else if direct_call_count == 2usize {
            third_caller_index = caller_index
            third_callee_index = target_index
            third_start = candidate_start
            third_end = calls[call_index].close_end
        } else if direct_call_count == 3usize {
            fourth_caller_index = caller_index
            fourth_callee_index = target_index
            fourth_start = candidate_start
            fourth_end = calls[call_index].close_end
        } else {
            return invalid
        }
        direct_call_count = direct_call_count + 1usize
    }
    if direct_call_count + 1usize != function_count {
        return invalid
    }
    if first_caller_index == second_caller_index {
        return invalid
    }
    if function_count == 4usize {
        if first_caller_index == third_caller_index {
            return invalid
        }
        if second_caller_index == third_caller_index {
            return invalid
        }
    }
    if function_count == 5usize {
        if first_caller_index == fourth_caller_index {
            return invalid
        }
        if second_caller_index == fourth_caller_index {
            return invalid
        }
        if third_caller_index == fourth_caller_index {
            return invalid
        }
    }

    var first_return_start: UIntSize = 0usize
    var first_return_end: UIntSize = 0usize
    var second_return_start: UIntSize = 0usize
    var second_return_end: UIntSize = 0usize
    var third_return_start: UIntSize = 0usize
    var third_return_end: UIntSize = 0usize
    var fourth_return_start: UIntSize = 0usize
    var fourth_return_end: UIntSize = 0usize
    var literal_function_index: UIntSize = function_count
    var literal_start: UIntSize = 0usize
    var literal_end: UIntSize = 0usize
    var literal_value: UIntSize = 0usize
    var literal_return_start: UIntSize = 0usize
    var literal_return_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        var body_statement_count: UIntSize = 0usize
        var body_statement_index: UIntSize = 0usize
        for statement_index in statements.indices {
            if statements[statement_index].start > function_headers[function_index].body_start {
                if statements[statement_index].end < function_headers[function_index].body_end {
                    body_statement_count = body_statement_count + 1usize
                    body_statement_index = statement_index
                }
            }
        }
        if body_statement_count != 1usize {
            return invalid
        }
        if statements[body_statement_index].kind != 2u8 {
            return invalid
        }
        if function_index == first_caller_index {
            first_return_start = statements[body_statement_index].start
            first_return_end = first_end + 1usize
        } else if function_index == second_caller_index {
            second_return_start = statements[body_statement_index].start
            second_return_end = second_end + 1usize
        } else if function_index == third_caller_index {
            third_return_start = statements[body_statement_index].start
            third_return_end = third_end + 1usize
        } else if function_index == fourth_caller_index {
            fourth_return_start = statements[body_statement_index].start
            fourth_return_end = fourth_end + 1usize
        } else {
            let expression = stage2_parse_return_i32_expression(
                bytes,
                statements[body_statement_index].start,
                function_headers[function_index].body_end - 1usize,
            )
            if expression.kind != 1u8 {
                return invalid
            }
            literal_function_index = function_index
            literal_start = expression.left_start
            literal_end = expression.left_end
            literal_value = expression.left_value
            literal_return_start = statements[body_statement_index].start
            literal_return_end = expression.statement_end
        }
    }
    if literal_function_index == function_count {
        return invalid
    }
    return Stage2TwoZeroDirectCallInfo {
        valid: true,
        function_count: function_count,
        direct_call_count: direct_call_count,
        first_caller_index: first_caller_index,
        first_callee_index: first_callee_index,
        first_start: first_start,
        first_end: first_end,
        first_return_start: first_return_start,
        first_return_end: first_return_end,
        second_caller_index: second_caller_index,
        second_callee_index: second_callee_index,
        second_start: second_start,
        second_end: second_end,
        second_return_start: second_return_start,
        second_return_end: second_return_end,
        third_caller_index: third_caller_index,
        third_callee_index: third_callee_index,
        third_start: third_start,
        third_end: third_end,
        third_return_start: third_return_start,
        third_return_end: third_return_end,
        fourth_caller_index: fourth_caller_index,
        fourth_callee_index: fourth_callee_index,
        fourth_start: fourth_start,
        fourth_end: fourth_end,
        fourth_return_start: fourth_return_start,
        fourth_return_end: fourth_return_end,
        literal_function_index: literal_function_index,
        literal_start: literal_start,
        literal_end: literal_end,
        literal_value: literal_value,
        literal_return_start: literal_return_start,
        literal_return_end: literal_return_end,
    }
}

fn stage2_emit_two_literal_argument_direct_calls(
    info: Stage2TwoLiteralArgumentDirectCallInfo,
    function_headers: read Slice<FunctionHeader>,
    calls_seen: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    let records_required: UIntSize = 1usize + info.function_count * 4usize + info.direct_call_count
    var records_emitted: UIntSize = 0usize
    var record_cursor: UIntSize = 0usize
    if record_cursor < output_capacity {
        output[record_cursor] = Stage2JirRecord { kind: 1u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 32usize, operand_b: 0usize, source_start: 0usize, source_end: 0usize }
        records_emitted = records_emitted + 1usize
    }
    record_cursor = record_cursor + 1usize
    for function_index in function_headers.indices {
        let parameter_count = function_headers[function_index].parameter_count
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: parameter_count, operand_b: 0usize, source_start: function_headers[function_index].name_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].body_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if function_index == info.first_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.first_argument_value, operand_b: 0usize, source_start: info.first_argument_start, source_end: info.first_argument_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: info.first_callee_index, operand_b: parameter_count, source_start: info.first_start, source_end: info.first_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: 0usize, operand_b: 0usize, source_start: info.first_return_start, source_end: info.first_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.second_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.second_argument_value, operand_b: 0usize, source_start: info.second_argument_start, source_end: info.second_argument_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: info.second_callee_index, operand_b: parameter_count, source_start: info.second_start, source_end: info.second_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: 0usize, operand_b: 0usize, source_start: info.second_return_start, source_end: info.second_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.third_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.third_argument_value, operand_b: 0usize, source_start: info.third_argument_start, source_end: info.third_argument_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: info.third_callee_index, operand_b: parameter_count, source_start: info.third_start, source_end: info.third_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: 0usize, operand_b: 0usize, source_start: info.third_return_start, source_end: info.third_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.fourth_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.fourth_argument_value, operand_b: 0usize, source_start: info.fourth_argument_start, source_end: info.fourth_argument_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: info.fourth_callee_index, operand_b: parameter_count, source_start: info.fourth_start, source_end: info.fourth_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: 0usize, operand_b: 0usize, source_start: info.fourth_return_start, source_end: info.fourth_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.fifth_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.fifth_argument_value, operand_b: 0usize, source_start: info.fifth_argument_start, source_end: info.fifth_argument_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: info.fifth_callee_index, operand_b: parameter_count, source_start: info.fifth_start, source_end: info.fifth_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count + 1usize, operand_a: 0usize, operand_b: 0usize, source_start: info.fifth_return_start, source_end: info.fifth_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: info.literal_value, operand_b: 0usize, source_start: info.literal_start, source_end: info.literal_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: parameter_count, operand_a: 0usize, operand_b: 0usize, source_start: info.literal_return_start, source_end: info.literal_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        }
    }
    return Stage2JirSummary { functions_seen: info.function_count, statements_seen: info.function_count, calls_seen: calls_seen, records_required: records_required, records_emitted: records_emitted, functions_lowered: info.function_count, errors: 0usize, status_flags: if records_emitted == records_required { 7usize } else { 3usize } }
}

fn stage2_emit_two_zero_direct_calls(
    info: Stage2TwoZeroDirectCallInfo,
    function_headers: read Slice<FunctionHeader>,
    calls_seen: UIntSize,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    let records_required: UIntSize = 1usize + info.function_count * 4usize
    var records_emitted: UIntSize = 0usize
    var record_cursor: UIntSize = 0usize
    if record_cursor < output_capacity {
        output[record_cursor] = Stage2JirRecord { kind: 1u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 32usize, operand_b: 0usize, source_start: 0usize, source_end: 0usize }
        records_emitted = records_emitted + 1usize
    }
    record_cursor = record_cursor + 1usize
    for function_index in function_headers.indices {
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].name_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if record_cursor < output_capacity {
            output[record_cursor] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_headers[function_index].body_start, source_end: function_headers[function_index].body_end }
            records_emitted = records_emitted + 1usize
        }
        record_cursor = record_cursor + 1usize
        if function_index == info.first_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.first_callee_index, operand_b: 0usize, source_start: info.first_start, source_end: info.first_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.first_return_start, source_end: info.first_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.second_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.second_callee_index, operand_b: 0usize, source_start: info.second_start, source_end: info.second_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.second_return_start, source_end: info.second_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.third_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.third_callee_index, operand_b: 0usize, source_start: info.third_start, source_end: info.third_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.third_return_start, source_end: info.third_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else if function_index == info.fourth_caller_index {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 7u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.fourth_callee_index, operand_b: 0usize, source_start: info.fourth_start, source_end: info.fourth_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.fourth_return_start, source_end: info.fourth_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        } else {
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: info.literal_value, operand_b: 0usize, source_start: info.literal_start, source_end: info.literal_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
            if record_cursor < output_capacity {
                output[record_cursor] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: function_index, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: info.literal_return_start, source_end: info.literal_return_end }
                records_emitted = records_emitted + 1usize
            }
            record_cursor = record_cursor + 1usize
        }
    }
    return Stage2JirSummary { functions_seen: info.function_count, statements_seen: info.function_count, calls_seen: calls_seen, records_required: records_required, records_emitted: records_emitted, functions_lowered: info.function_count, errors: 0usize, status_flags: if records_emitted == records_required { 7usize } else { 3usize } }
}

/// Emits a deterministic, fixed-record JIR subset from the caller-owned
/// function/statement/call tables produced by `compile_frontend_stage2`.
///
/// The supported semantic slice is deliberately executable-shaped and exact:
/// one or more source-ordered `-> Int32` functions, each with zero parameters
/// or one explicit `name: Int32` parameter, and each
/// containing exactly one literal return, one binary operation, or one bounded
/// two-operator chain, or an expression plan with three through sixteen binary
/// operators, optionally with at most two explicit, disjoint, non-nested
/// binary groups, over
/// non-negative Int32 literals, and at most one executable same-module call
/// per function (including one bounded self-call). The zero-argument form
/// admits at most four call edges in one module. A call may carry one literal
/// or caller-parameter `Int32` argument, or one immutable local literal: an empty
/// argument list, one literal, the caller parameter, one binary value made
/// from two dense literals, or one binary value made from the caller parameter
/// and one dense literal, or one local literal bound before the call. The generic call
/// scan reports a leading return group as `return(...)`; that one header is
/// accepted only when its delimiters exactly match the bounded expression.
/// Truncation is reported without writing outside the caller's output slice.
@export(name: "jadren_selfhost_emit_stage2_jir", abi: "C")
@noalloc
pub fn emit_stage2_jir(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    statements: read Slice<StatementHeader>,
    calls: read Slice<ExpressionCallHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
    }
    var statement_count: UIntSize = 0usize
    for statement_index in statements.indices {
        statement_count = statement_index + 1usize
    }
    var call_count: UIntSize = 0usize
    var direct_call_count: UIntSize = 0usize
    var direct_call_caller_index: UIntSize = 0usize
    var direct_call_callee_index: UIntSize = 0usize
    var direct_call_index: UIntSize = 0usize
    var direct_call_start: UIntSize = 0usize
    var direct_call_argument_start: UIntSize = 0usize
    var direct_call_argument_end: UIntSize = 0usize
    var direct_call_argument_value_index: UIntSize = 0usize
    var direct_call_result_value_index: UIntSize = 0usize
    var direct_call_argument_is_empty: Bool = false
    var direct_call_argument_is_literal: Bool = false
    var direct_call_argument_is_local: Bool = false
    var direct_call_argument_is_local_binary: Bool = false
    var direct_call_argument_has_local_binary_operand: Bool = false
    var direct_call_argument_is_binary: Bool = false
    var direct_call_argument_left_is_parameter: Bool = false
    var direct_call_argument_right_is_parameter: Bool = false
    var direct_call_argument_left_is_local: Bool = false
    var direct_call_argument_right_is_local: Bool = false
    var direct_call_argument_left_start: UIntSize = 0usize
    var direct_call_argument_left_end: UIntSize = 0usize
    var direct_call_argument_right_start: UIntSize = 0usize
    var direct_call_argument_right_end: UIntSize = 0usize
    var direct_call_argument_binary_opcode: UInt8 = 0u8
    var direct_call_local_declaration_start: UIntSize = 0usize
    var direct_call_local_declaration_end: UIntSize = 0usize
    var direct_call_local_use_start: UIntSize = 0usize
    var direct_call_local_use_end: UIntSize = 0usize
    var direct_call_local_literal_start: UIntSize = 0usize
    var direct_call_local_literal_end: UIntSize = 0usize
    var direct_call_local_binary_first_start: UIntSize = 0usize
    var direct_call_local_binary_first_end: UIntSize = 0usize
    var direct_call_local_binary_second_start: UIntSize = 0usize
    var direct_call_local_binary_second_end: UIntSize = 0usize
    var direct_call_local_binary_start: UIntSize = 0usize
    var direct_call_local_binary_end: UIntSize = 0usize
    var direct_call_local_binary_opcode: UInt8 = 0u8
    var direct_call_result_binding_valid: Bool = false
    var direct_call_result_binding_declaration_start: UIntSize = 0usize
    var direct_call_result_binding_declaration_end: UIntSize = 0usize
    var direct_call_result_binding_use_start: UIntSize = 0usize
    var direct_call_result_binding_use_end: UIntSize = 0usize
    var direct_call_result_binding_return_start: UIntSize = 0usize
    var direct_call_result_binding_return_end: UIntSize = 0usize
    var direct_call_result_binding_record_count: UIntSize = 0usize
    var direct_call_extra_record_count: UIntSize = 0usize
    for call_index in calls.indices {
        call_count = call_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }

    var previous_function_end: UIntSize = 0usize
    for function_index in function_headers.indices {
        if function_headers[function_index].name_start >= function_headers[function_index].name_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].name_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].body_start >= function_headers[function_index].body_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_headers[function_index].body_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if bytes[function_headers[function_index].body_start] != 0x7Bu8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if bytes[function_headers[function_index].body_end - 1usize] != 0x7Du8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if function_index > 0usize {
            if function_headers[function_index].name_start < previous_function_end {
                return Stage2JirSummary {
                    functions_seen: function_count,
                    statements_seen: statement_count,
                    calls_seen: call_count,
                    records_required: 0usize,
                    records_emitted: 0usize,
                    functions_lowered: 0usize,
                    errors: 1usize,
                    status_flags: 0usize,
                }
            }
        }
        previous_function_end = function_headers[function_index].body_end
    }
    for statement_index in statements.indices {
        if statements[statement_index].kind < 1u8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].kind > 9u8 {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].start >= statements[statement_index].end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if statements[statement_index].end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
    }
    for call_index in calls.indices {
        if calls[call_index].callee_start >= calls[call_index].callee_end {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
        if calls[call_index].close_end > source_length {
            return Stage2JirSummary {
                functions_seen: function_count,
                statements_seen: statement_count,
                calls_seen: call_count,
                records_required: 0usize,
                records_emitted: 0usize,
                functions_lowered: 0usize,
                errors: 1usize,
                status_flags: 0usize,
            }
        }
    }

    if function_count == 0usize {
        return Stage2JirSummary {
            functions_seen: function_count,
            statements_seen: statement_count,
            calls_seen: call_count,
            records_required: 0usize,
            records_emitted: 0usize,
            functions_lowered: 0usize,
            errors: 1usize,
            status_flags: 1usize,
        }
    }
    let same_function_two_zero_calls = stage2_try_same_function_two_zero_calls(
        bytes,
        function_headers,
        statements,
        calls,
    )
    if same_function_two_zero_calls.valid {
        return stage2_emit_same_function_two_zero_calls(
            same_function_two_zero_calls,
            function_headers,
            call_count,
            output,
        )
    }
    let two_zero_result_bindings = stage2_try_two_zero_result_bindings(
        bytes,
        function_headers,
        statements,
        calls,
    )
    if two_zero_result_bindings.valid {
        return stage2_emit_two_zero_result_bindings(
            two_zero_result_bindings,
            function_headers,
            call_count,
            output,
        )
    }
    let two_literal_argument_calls = stage2_try_two_literal_argument_direct_calls(
        bytes,
        function_headers,
        statements,
        calls,
    )
    if two_literal_argument_calls.valid {
        return stage2_emit_two_literal_argument_direct_calls(
            two_literal_argument_calls,
            function_headers,
            call_count,
            output,
        )
    }
    let two_zero_calls = stage2_try_two_zero_direct_calls(
        bytes,
        function_headers,
        statements,
        calls,
    )
    if two_zero_calls.valid {
        return stage2_emit_two_zero_direct_calls(two_zero_calls, function_headers, call_count, output)
    }
    for call_index in calls.indices {
        var is_signature_group: Bool = false
        var is_leading_expression_group: Bool = false
        var is_direct_call: Bool = false
        for function_index in function_headers.indices {
            if calls[call_index].callee_start == function_headers[function_index].name_start {
                if calls[call_index].callee_end == function_headers[function_index].name_end {
                    if calls[call_index].open_start >= function_headers[function_index].name_end {
                        if calls[call_index].close_end < function_headers[function_index].body_start {
                            is_signature_group = true
                        }
                    }
                }
            }
            if calls[call_index].callee_start + 3usize == function_headers[function_index].name_start {
                if bytes[calls[call_index].callee_start] == 0x66u8 {
                    if bytes[calls[call_index].callee_start + 1usize] == 0x6Eu8 {
                        if bytes[calls[call_index].callee_start + 2usize] == 0x20u8 {
                            if calls[call_index].callee_end == function_headers[function_index].name_end {
                                if calls[call_index].open_start >= function_headers[function_index].name_end {
                                    if calls[call_index].close_end < function_headers[function_index].body_start {
                                        is_signature_group = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if calls[call_index].open_start > function_headers[function_index].body_start {
                if calls[call_index].close_end < function_headers[function_index].body_end {
                    if !is_signature_group {
                        if !is_leading_expression_group {
                            if calls[call_index].argument_count == 0usize {
                                if calls[call_index].depth == 0usize {
                                    if function_headers[function_index].parameter_count == 0usize {
                                        for target_index in function_headers.indices {
                                            if function_headers[target_index].parameter_count == 0usize {
                                                    var candidate_start: UIntSize = calls[call_index].callee_start
                                                    let candidate_end: UIntSize = calls[call_index].callee_end
                                                    if candidate_end >= candidate_start + 7usize {
                                                        if bytes[candidate_start] == 0x72u8 {
                                                            if bytes[candidate_start + 1usize] == 0x65u8 {
                                                                if bytes[candidate_start + 2usize] == 0x74u8 {
                                                                    if bytes[candidate_start + 3usize] == 0x75u8 {
                                                                        if bytes[candidate_start + 4usize] == 0x72u8 {
                                                                            if bytes[candidate_start + 5usize] == 0x6Eu8 {
                                                                                if bytes[candidate_start + 6usize] == 0x20u8 {
                                                                                    candidate_start = candidate_start + 7usize
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if stage2_same_ascii(
                                                        bytes,
                                                        candidate_start,
                                                        candidate_end,
                                                        function_headers[target_index].name_start,
                                                        function_headers[target_index].name_end,
                                                    ) {
                                                        if calls[call_index].open_end == calls[call_index].close_start {
                                                            if direct_call_count != 0usize {
                                                                return Stage2JirSummary {
                                                                    functions_seen: function_count,
                                                                    statements_seen: statement_count,
                                                                    calls_seen: call_count,
                                                                    records_required: 0usize,
                                                                    records_emitted: 0usize,
                                                                    functions_lowered: 0usize,
                                                                    errors: 1usize,
                                                                    status_flags: 1usize,
                                                                }
                                                            }
                                                            direct_call_count = 1usize
                                                            direct_call_caller_index = function_index
                                                            direct_call_callee_index = target_index
                                                            direct_call_index = call_index
                                                            direct_call_start = candidate_start
                                                            direct_call_argument_start = calls[call_index].open_end
                                                            direct_call_argument_end = calls[call_index].close_start
                                                            direct_call_argument_value_index = 0usize
                                                            direct_call_result_value_index = 0usize
                                                            direct_call_argument_is_empty = true
                                                             direct_call_argument_is_literal = false
                                                             direct_call_argument_is_local = false
                                                             direct_call_argument_is_local_binary = false
                                                             direct_call_argument_has_local_binary_operand = false
                                                             direct_call_argument_is_binary = false
                                                             direct_call_argument_left_is_parameter = false
                                                             direct_call_argument_right_is_parameter = false
                                                            direct_call_argument_left_is_local = false
                                                            direct_call_argument_right_is_local = false
                                                            direct_call_extra_record_count = 0usize
                                                            for result_statement_index in statements.indices {
                                                                if statements[result_statement_index].kind == 1u8 {
                                                                    if statements[result_statement_index].start < candidate_start {
                                                                        var result_binding: Stage2DirectCallResultBindingInfo = stage2_parse_direct_call_result_binding_fallback(
                                                                            bytes,
                                                                            statements[result_statement_index].start,
                                                                            candidate_start,
