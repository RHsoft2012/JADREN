fn stage2_parse_parameter_alias_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2LocalBindingInfo {
    let invalid: Stage2LocalBindingInfo = Stage2LocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        declaration_start: 0usize,
        declaration_end: 0usize,
        literal_start: 0usize,
        literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        literal_value: 0usize,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
    let parameter: Stage2ParameterInfo = stage2_parse_single_i32_parameter(
        bytes,
        name_end,
        body_start,
    )
    if !parameter.valid { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let parameter_use: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let declaration_end: TokenInfo = scan_token_info(bytes, parameter_use.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if equals.kind != 3u8 { return invalid }
    if parameter_use.kind != 1u8 { return invalid }
    if declaration_end.kind == 3u8 {
        if bytes[declaration_end.start] != 0x3Bu8 { return invalid }
    } else if declaration_end.kind != 1u8 {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if !stage2_same_ascii(bytes, parameter.name_start, parameter.name_end, parameter_use.start, parameter_use.end) {
        return invalid
    }
    var return_start_cursor: UIntSize = declaration_end.start
    if declaration_end.kind == 3u8 { return_start_cursor = declaration_end.end }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2LocalBindingInfo {
        valid: true,
        parameter_start: parameter.name_start,
        parameter_end: parameter.name_end,
        declaration_start: name.start,
        declaration_end: name.end,
        literal_start: 0usize,
        literal_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
        use_start: return_name.start,
        use_end: return_name.end,
        literal_value: 0usize,
        operator_opcode: 0u8,
        parameter_on_left: true,
    }
}

fn stage2_parse_two_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TwoLocalBindingInfo {
    let invalid: Stage2TwoLocalBindingInfo = Stage2TwoLocalBindingInfo {
        valid: false,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        first_literal_value: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        second_literal_value: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        binary_start: 0usize,
        binary_end: 0usize,
        operator_opcode: 0u8,
        return_start: 0usize,
        return_end: 0usize,
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let first_let: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let first_name: TokenInfo = scan_token_info(bytes, first_let.end, body_end_exclusive)
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_end_exclusive)
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_type.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_end: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    if first_let.kind != 1u8 { return invalid }
    if first_name.kind != 1u8 { return invalid }
    if first_colon.kind != 3u8 { return invalid }
    if first_type.kind != 1u8 { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_end.kind == 3u8 {
        if bytes[first_end.start] != 0x3Bu8 { return invalid }
    } else if first_end.kind != 1u8 {
        return invalid
    }
    if bytes[first_colon.start] != 0x3Au8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) { return invalid }
    var second_start_cursor: UIntSize = first_end.start
    if first_end.kind == 3u8 { second_start_cursor = first_end.end }
    let second_let: TokenInfo = scan_token_info(bytes, second_start_cursor, body_end_exclusive)
    let second_name: TokenInfo = scan_token_info(bytes, second_let.end, body_end_exclusive)
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_end_exclusive)
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_type.end, body_end_exclusive)
    let first_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let operator: TokenInfo = scan_token_info(bytes, first_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, operator.end, body_end_exclusive)
    let second_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    if second_let.kind != 1u8 { return invalid }
    if second_name.kind != 1u8 { return invalid }
    if second_colon.kind != 3u8 { return invalid }
    if second_type.kind != 1u8 { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if first_use.kind != 1u8 { return invalid }
    if operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_end.kind == 3u8 {
        if bytes[second_end.start] != 0x3Bu8 { return invalid }
    } else if second_end.kind != 1u8 {
        return invalid
    }
    if bytes[second_colon.start] != 0x3Au8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if bytes[operator.start] != 0x2Bu8 {
        if bytes[operator.start] != 0x2Du8 {
            if bytes[operator.start] != 0x2Au8 { return invalid }
        }
    }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) { return invalid }
    if !stage2_same_ascii(bytes, first_name.start, first_name.end, first_use.start, first_use.end) { return invalid }
    var second_return_start_cursor: UIntSize = second_end.start
    if second_end.kind == 3u8 { second_return_start_cursor = second_end.end }
    let return_keyword: TokenInfo = scan_token_info(bytes, second_return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, second_name.start, second_name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    var first_literal_value: UIntSize = 0usize
    var first_literal_index: UIntSize = first_literal.start
    while first_literal_index < first_literal.end {
        first_literal_value = first_literal_value * 10usize + (bytes[first_literal_index] as UIntSize) - 48usize
        first_literal_index = first_literal_index + 1usize
    }
    var second_literal_value: UIntSize = 0usize
    var second_literal_index: UIntSize = second_literal.start
    while second_literal_index < second_literal.end {
        second_literal_value = second_literal_value * 10usize + (bytes[second_literal_index] as UIntSize) - 48usize
        second_literal_index = second_literal_index + 1usize
    }
    return Stage2TwoLocalBindingInfo {
        valid: true,
        first_declaration_start: first_name.start,
        first_declaration_end: first_name.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        first_literal_value: first_literal_value,
        first_use_start: first_use.start,
        first_use_end: first_use.end,
        second_declaration_start: second_name.start,
        second_declaration_end: second_name.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        second_literal_value: second_literal_value,
        second_use_start: return_name.start,
        second_use_end: return_name.end,
        binary_start: first_use.start,
        binary_end: second_literal.end,
        operator_opcode: if bytes[operator.start] == 0x2Bu8 {
            2u8
        } else if bytes[operator.start] == 0x2Du8 {
            3u8
        } else {
            4u8
        },
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
    }
}

fn stage2_parse_three_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2ThreeLocalBindingInfo {
    let invalid: Stage2ThreeLocalBindingInfo = Stage2ThreeLocalBindingInfo {
        valid: false,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        first_literal_value: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        second_literal_value: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        third_declaration_start: 0usize,
        third_declaration_end: 0usize,
        third_literal_start: 0usize,
        third_literal_end: 0usize,
        third_literal_value: 0usize,
        third_use_start: 0usize,
        third_use_end: 0usize,
        first_binary_start: 0usize,
        first_binary_end: 0usize,
        second_binary_start: 0usize,
        second_binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let first_let: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let first_name: TokenInfo = scan_token_info(bytes, first_let.end, body_end_exclusive)
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_end_exclusive)
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_type.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_end: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    if first_let.kind != 1u8 { return invalid }
    if first_name.kind != 1u8 { return invalid }
    if first_colon.kind != 3u8 { return invalid }
    if first_type.kind != 1u8 { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_end.kind == 3u8 {
        if bytes[first_end.start] != 0x3Bu8 { return invalid }
    } else if first_end.kind != 1u8 { return invalid }
    if bytes[first_colon.start] != 0x3Au8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) { return invalid }
    let second_start_cursor: UIntSize = if first_end.kind == 3u8 { first_end.end } else { first_end.start }
    let second_let: TokenInfo = scan_token_info(bytes, second_start_cursor, body_end_exclusive)
    let second_name: TokenInfo = scan_token_info(bytes, second_let.end, body_end_exclusive)
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_end_exclusive)
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_type.end, body_end_exclusive)
    let first_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let first_operator: TokenInfo = scan_token_info(bytes, first_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, first_operator.end, body_end_exclusive)
    let second_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    if second_let.kind != 1u8 { return invalid }
    if second_name.kind != 1u8 { return invalid }
    if second_colon.kind != 3u8 { return invalid }
    if second_type.kind != 1u8 { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if first_use.kind != 1u8 { return invalid }
    if first_operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_end.kind == 3u8 {
        if bytes[second_end.start] != 0x3Bu8 { return invalid }
    } else if second_end.kind != 1u8 { return invalid }
    if bytes[second_colon.start] != 0x3Au8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if bytes[first_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) { return invalid }
    if !stage2_same_ascii(bytes, first_name.start, first_name.end, first_use.start, first_use.end) { return invalid }
    let third_start_cursor: UIntSize = if second_end.kind == 3u8 { second_end.end } else { second_end.start }
    let third_let: TokenInfo = scan_token_info(bytes, third_start_cursor, body_end_exclusive)
    let third_name: TokenInfo = scan_token_info(bytes, third_let.end, body_end_exclusive)
    let third_colon: TokenInfo = scan_token_info(bytes, third_name.end, body_end_exclusive)
    let third_type: TokenInfo = scan_token_info(bytes, third_colon.end, body_end_exclusive)
    let third_equals: TokenInfo = scan_token_info(bytes, third_type.end, body_end_exclusive)
    let second_use: TokenInfo = scan_token_info(bytes, third_equals.end, body_end_exclusive)
    let second_operator: TokenInfo = scan_token_info(bytes, second_use.end, body_end_exclusive)
    let third_literal: TokenInfo = scan_token_info(bytes, second_operator.end, body_end_exclusive)
    let third_end: TokenInfo = scan_token_info(bytes, third_literal.end, body_end_exclusive)
    if third_let.kind != 1u8 { return invalid }
    if third_name.kind != 1u8 { return invalid }
    if third_colon.kind != 3u8 { return invalid }
    if third_type.kind != 1u8 { return invalid }
    if third_equals.kind != 3u8 { return invalid }
    if second_use.kind != 1u8 { return invalid }
    if second_operator.kind != 3u8 { return invalid }
    if third_literal.kind != 2u8 { return invalid }
    if third_end.kind == 3u8 {
        if bytes[third_end.start] != 0x3Bu8 { return invalid }
    } else if third_end.kind != 1u8 { return invalid }
    if bytes[third_colon.start] != 0x3Au8 { return invalid }
    if bytes[third_equals.start] != 0x3Du8 { return invalid }
    if bytes[second_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, third_type.start, third_type.end) { return invalid }
    if !stage2_same_ascii(bytes, second_name.start, second_name.end, second_use.start, second_use.end) { return invalid }
    let return_start_cursor: UIntSize = if third_end.kind == 3u8 { third_end.end } else { third_end.start }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
    }
    if return_end.kind == 3u8 {
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, third_name.start, third_name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    var first_literal_value: UIntSize = 0usize
    var first_literal_index: UIntSize = first_literal.start
    while first_literal_index < first_literal.end { first_literal_value = first_literal_value * 10usize + (bytes[first_literal_index] as UIntSize) - 48usize; first_literal_index = first_literal_index + 1usize }
    var second_literal_value: UIntSize = 0usize
    var second_literal_index: UIntSize = second_literal.start
    while second_literal_index < second_literal.end { second_literal_value = second_literal_value * 10usize + (bytes[second_literal_index] as UIntSize) - 48usize; second_literal_index = second_literal_index + 1usize }
    var third_literal_value: UIntSize = 0usize
    var third_literal_index: UIntSize = third_literal.start
    while third_literal_index < third_literal.end { third_literal_value = third_literal_value * 10usize + (bytes[third_literal_index] as UIntSize) - 48usize; third_literal_index = third_literal_index + 1usize }
    return Stage2ThreeLocalBindingInfo {
        valid: true,
        first_declaration_start: first_name.start,
        first_declaration_end: first_name.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        first_literal_value: first_literal_value,
        first_use_start: first_use.start,
        first_use_end: first_use.end,
        second_declaration_start: second_name.start,
        second_declaration_end: second_name.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        second_literal_value: second_literal_value,
        second_use_start: second_use.start,
        second_use_end: second_use.end,
        third_declaration_start: third_name.start,
        third_declaration_end: third_name.end,
        third_literal_start: third_literal.start,
        third_literal_end: third_literal.end,
        third_literal_value: third_literal_value,
        third_use_start: return_name.start,
        third_use_end: return_name.end,
        first_binary_start: first_use.start,
        first_binary_end: second_literal.end,
        second_binary_start: second_use.start,
        second_binary_end: third_literal.end,
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
    }
}

fn stage2_parse_parameter_two_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    parameter_count: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2ParameterTwoLocalBindingInfo {
    let invalid: Stage2ParameterTwoLocalBindingInfo = Stage2ParameterTwoLocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        first_literal_value: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        second_literal_value: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        first_binary_start: 0usize,
        first_binary_end: 0usize,
        second_binary_start: 0usize,
        second_binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if parameter_count != 1usize { return invalid }
    let parameter: Stage2ParameterInfo = stage2_parse_single_i32_parameter(bytes, name_end, body_start)
    if !parameter.valid { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let first_let: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let first_name: TokenInfo = scan_token_info(bytes, first_let.end, body_end_exclusive)
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_end_exclusive)
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_type.end, body_end_exclusive)
    let parameter_use: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_operator: TokenInfo = scan_token_info(bytes, parameter_use.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, body_end_exclusive)
    let first_end: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    if first_let.kind != 1u8 { return invalid }
    if first_name.kind != 1u8 { return invalid }
    if first_colon.kind != 3u8 { return invalid }
    if first_type.kind != 1u8 { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if parameter_use.kind != 1u8 { return invalid }
    if first_operator.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_end.kind == 3u8 {
        if bytes[first_end.start] != 0x3Bu8 { return invalid }
    } else if first_end.kind != 1u8 { return invalid }
    if bytes[first_colon.start] != 0x3Au8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if bytes[first_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) { return invalid }
    if !stage2_same_ascii(bytes, parameter.name_start, parameter.name_end, parameter_use.start, parameter_use.end) { return invalid }
    let second_start_cursor: UIntSize = if first_end.kind == 3u8 { first_end.end } else { first_end.start }
    let second_let: TokenInfo = scan_token_info(bytes, second_start_cursor, body_end_exclusive)
    let second_name: TokenInfo = scan_token_info(bytes, second_let.end, body_end_exclusive)
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_end_exclusive)
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_type.end, body_end_exclusive)
    let first_local_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let second_operator: TokenInfo = scan_token_info(bytes, first_local_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, body_end_exclusive)
    let second_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    if second_let.kind != 1u8 { return invalid }
    if second_name.kind != 1u8 { return invalid }
    if second_colon.kind != 3u8 { return invalid }
    if second_type.kind != 1u8 { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if first_local_use.kind != 1u8 { return invalid }
    if second_operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_end.kind == 3u8 {
        if bytes[second_end.start] != 0x3Bu8 { return invalid }
    } else if second_end.kind != 1u8 { return invalid }
    if bytes[second_colon.start] != 0x3Au8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if bytes[second_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) { return invalid }
    if !stage2_same_ascii(bytes, first_name.start, first_name.end, first_local_use.start, first_local_use.end) { return invalid }
    let return_start_cursor: UIntSize = if second_end.kind == 3u8 { second_end.end } else { second_end.start }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, second_name.start, second_name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    var first_literal_value: UIntSize = 0usize
    var first_literal_index: UIntSize = first_literal.start
    while first_literal_index < first_literal.end { first_literal_value = first_literal_value * 10usize + (bytes[first_literal_index] as UIntSize) - 48usize; first_literal_index = first_literal_index + 1usize }
    var second_literal_value: UIntSize = 0usize
    var second_literal_index: UIntSize = second_literal.start
    while second_literal_index < second_literal.end { second_literal_value = second_literal_value * 10usize + (bytes[second_literal_index] as UIntSize) - 48usize; second_literal_index = second_literal_index + 1usize }
    return Stage2ParameterTwoLocalBindingInfo {
        valid: true,
        parameter_start: parameter.name_start,
        parameter_end: parameter.name_end,
        first_declaration_start: first_name.start,
        first_declaration_end: first_name.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        first_literal_value: first_literal_value,
        first_use_start: first_local_use.start,
        first_use_end: first_local_use.end,
        second_declaration_start: second_name.start,
        second_declaration_end: second_name.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        second_literal_value: second_literal_value,
        second_use_start: return_name.start,
        second_use_end: return_name.end,
        first_binary_start: parameter_use.start,
        first_binary_end: first_literal.end,
        second_binary_start: first_local_use.start,
        second_binary_end: second_literal.end,
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
    }
}

fn stage2_parse_parameter_three_local_binding(
    bytes: read Slice<UInt8>,
    name_start: UIntSize,
    name_end: UIntSize,
    parameter_count: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2ParameterThreeLocalBindingInfo {
    let invalid: Stage2ParameterThreeLocalBindingInfo = Stage2ParameterThreeLocalBindingInfo {
        valid: false,
        parameter_start: 0usize,
        parameter_end: 0usize,
        first_declaration_start: 0usize,
        first_declaration_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        first_literal_value: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        second_declaration_start: 0usize,
        second_declaration_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        second_literal_value: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        third_declaration_start: 0usize,
        third_declaration_end: 0usize,
        third_literal_start: 0usize,
        third_literal_end: 0usize,
        third_literal_value: 0usize,
        third_use_start: 0usize,
        third_use_end: 0usize,
        first_binary_start: 0usize,
        first_binary_end: 0usize,
        second_binary_start: 0usize,
        second_binary_end: 0usize,
        third_binary_start: 0usize,
        third_binary_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
    if parameter_count != 1usize { return invalid }
    let parameter: Stage2ParameterInfo = stage2_parse_single_i32_parameter(bytes, name_end, body_start)
    if !parameter.valid { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let first_let: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let first_name: TokenInfo = scan_token_info(bytes, first_let.end, body_end_exclusive)
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_end_exclusive)
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_type.end, body_end_exclusive)
    let parameter_use: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_operator: TokenInfo = scan_token_info(bytes, parameter_use.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, body_end_exclusive)
    let first_end: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    if first_let.kind != 1u8 { return invalid }
    if first_name.kind != 1u8 { return invalid }
    if first_colon.kind != 3u8 { return invalid }
    if first_type.kind != 1u8 { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if parameter_use.kind != 1u8 { return invalid }
    if first_operator.kind != 3u8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_end.kind == 3u8 { if bytes[first_end.start] != 0x3Bu8 { return invalid } } else if first_end.kind != 1u8 { return invalid }
    if bytes[first_colon.start] != 0x3Au8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if bytes[first_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) { return invalid }
    if !stage2_same_ascii(bytes, parameter.name_start, parameter.name_end, parameter_use.start, parameter_use.end) { return invalid }
    let second_start_cursor: UIntSize = if first_end.kind == 3u8 { first_end.end } else { first_end.start }
    let second_let: TokenInfo = scan_token_info(bytes, second_start_cursor, body_end_exclusive)
    let second_name: TokenInfo = scan_token_info(bytes, second_let.end, body_end_exclusive)
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_end_exclusive)
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_type.end, body_end_exclusive)
    let first_local_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let second_operator: TokenInfo = scan_token_info(bytes, first_local_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, body_end_exclusive)
    let second_end: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    if second_let.kind != 1u8 { return invalid }
    if second_name.kind != 1u8 { return invalid }
    if second_colon.kind != 3u8 { return invalid }
    if second_type.kind != 1u8 { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if first_local_use.kind != 1u8 { return invalid }
    if second_operator.kind != 3u8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_end.kind == 3u8 { if bytes[second_end.start] != 0x3Bu8 { return invalid } } else if second_end.kind != 1u8 { return invalid }
    if bytes[second_colon.start] != 0x3Au8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if bytes[second_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) { return invalid }
    if !stage2_same_ascii(bytes, first_name.start, first_name.end, first_local_use.start, first_local_use.end) { return invalid }
    let third_start_cursor: UIntSize = if second_end.kind == 3u8 { second_end.end } else { second_end.start }
    let third_let: TokenInfo = scan_token_info(bytes, third_start_cursor, body_end_exclusive)
    let third_name: TokenInfo = scan_token_info(bytes, third_let.end, body_end_exclusive)
    let third_colon: TokenInfo = scan_token_info(bytes, third_name.end, body_end_exclusive)
    let third_type: TokenInfo = scan_token_info(bytes, third_colon.end, body_end_exclusive)
    let third_equals: TokenInfo = scan_token_info(bytes, third_type.end, body_end_exclusive)
    let second_local_use: TokenInfo = scan_token_info(bytes, third_equals.end, body_end_exclusive)
    let third_operator: TokenInfo = scan_token_info(bytes, second_local_use.end, body_end_exclusive)
    let third_literal: TokenInfo = scan_token_info(bytes, third_operator.end, body_end_exclusive)
    let third_end: TokenInfo = scan_token_info(bytes, third_literal.end, body_end_exclusive)
    if third_let.kind != 1u8 { return invalid }
    if third_name.kind != 1u8 { return invalid }
    if third_colon.kind != 3u8 { return invalid }
    if third_type.kind != 1u8 { return invalid }
    if third_equals.kind != 3u8 { return invalid }
    if second_local_use.kind != 1u8 { return invalid }
    if third_operator.kind != 3u8 { return invalid }
    if third_literal.kind != 2u8 { return invalid }
    if third_end.kind == 3u8 { if bytes[third_end.start] != 0x3Bu8 { return invalid } } else if third_end.kind != 1u8 { return invalid }
    if bytes[third_colon.start] != 0x3Au8 { return invalid }
    if bytes[third_equals.start] != 0x3Du8 { return invalid }
    if bytes[third_operator.start] != 0x2Bu8 { return invalid }
    if !stage2_is_int32_name(bytes, third_type.start, third_type.end) { return invalid }
    if !stage2_same_ascii(bytes, second_name.start, second_name.end, second_local_use.start, second_local_use.end) { return invalid }
    let return_start_cursor: UIntSize = if third_end.kind == 3u8 { third_end.end } else { third_end.start }
    let return_keyword: TokenInfo = scan_token_info(bytes, return_start_cursor, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_end: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if return_keyword.kind != 1u8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if return_end.kind != 0u8 {
        if return_end.kind != 3u8 { return invalid }
        if bytes[return_end.start] != 0x3Bu8 { return invalid }
    }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if !stage2_same_ascii(bytes, third_name.start, third_name.end, return_name.start, return_name.end) { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_end.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    var first_literal_value: UIntSize = 0usize
    var first_literal_index: UIntSize = first_literal.start
    while first_literal_index < first_literal.end { first_literal_value = first_literal_value * 10usize + (bytes[first_literal_index] as UIntSize) - 48usize; first_literal_index = first_literal_index + 1usize }
    var second_literal_value: UIntSize = 0usize
    var second_literal_index: UIntSize = second_literal.start
    while second_literal_index < second_literal.end { second_literal_value = second_literal_value * 10usize + (bytes[second_literal_index] as UIntSize) - 48usize; second_literal_index = second_literal_index + 1usize }
    var third_literal_value: UIntSize = 0usize
    var third_literal_index: UIntSize = third_literal.start
    while third_literal_index < third_literal.end { third_literal_value = third_literal_value * 10usize + (bytes[third_literal_index] as UIntSize) - 48usize; third_literal_index = third_literal_index + 1usize }
    return Stage2ParameterThreeLocalBindingInfo {
        valid: true,
        parameter_start: parameter.name_start,
        parameter_end: parameter.name_end,
        first_declaration_start: first_name.start,
        first_declaration_end: first_name.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        first_literal_value: first_literal_value,
        first_use_start: first_local_use.start,
        first_use_end: first_local_use.end,
        second_declaration_start: second_name.start,
        second_declaration_end: second_name.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        second_literal_value: second_literal_value,
        second_use_start: second_local_use.start,
        second_use_end: second_local_use.end,
        third_declaration_start: third_name.start,
        third_declaration_end: third_name.end,
        third_literal_start: third_literal.start,
        third_literal_end: third_literal.end,
        third_literal_value: third_literal_value,
        third_use_start: return_name.start,
        third_use_end: return_name.end,
        first_binary_start: parameter_use.start,
        first_binary_end: first_literal.end,
        second_binary_start: first_local_use.start,
        second_binary_end: second_literal.end,
        third_binary_start: second_local_use.start,
        third_binary_end: third_literal.end,
        return_start: return_keyword.start,
        return_end: if return_end.kind == 0u8 { return_name.end } else { return_end.end },
    }
}

fn stage2_is_local_value_name(
    bytes: read Slice<UInt8>,
    start: UIntSize,
) -> Bool {
    if bytes[start] != 0x6Cu8 { return false }
    if bytes[start + 1usize] != 0x6Fu8 { return false }
    if bytes[start + 2usize] != 0x63u8 { return false }
    if bytes[start + 3usize] != 0x61u8 { return false }
    if bytes[start + 4usize] != 0x6Cu8 { return false }
    if bytes[start + 5usize] != 0x5Fu8 { return false }
    if bytes[start + 6usize] != 0x76u8 { return false }
    if bytes[start + 7usize] != 0x61u8 { return false }
    if bytes[start + 8usize] != 0x6Cu8 { return false }
    if bytes[start + 9usize] != 0x75u8 { return false }
    if bytes[start + 10usize] != 0x65u8 { return false }
    return true
}

fn stage2_find_local_function_shape(
    bytes: read Slice<UInt8>,
    source_length: UIntSize,
) -> Stage2LocalFunctionShape {
    let invalid: Stage2LocalFunctionShape = Stage2LocalFunctionShape { valid: false, name_start: 0usize, name_end: 0usize, body_start: 0usize, body_end: 0usize }
    var cursor: UIntSize = 0usize
    while cursor < source_length {
        let token: TokenInfo = scan_token_info(bytes, cursor, source_length)
        if token.start >= source_length {
            break
        }
        if token.kind == 1u8 {
            if token.end - token.start == 11usize {
                if stage2_is_local_value_name(bytes, token.start) {
                    var scan: UIntSize = token.end
                    var body_start: UIntSize = source_length
                    while scan < source_length {
                        let part: TokenInfo = scan_token_info(bytes, scan, source_length)
                        if part.start >= source_length { break }
                        if part.kind == 3u8 {
                            if bytes[part.start] == 0x7Bu8 {
                                body_start = part.start
                                break
                            }
                        }
                        scan = part.end
                    }
                    if body_start >= source_length { return invalid }
                    var depth: UIntSize = 1usize
                    scan = body_start + 1usize
                    while scan < source_length {
                        let part: TokenInfo = scan_token_info(bytes, scan, source_length)
                        if part.start >= source_length { break }
                        if part.kind == 3u8 {
                            if bytes[part.start] == 0x7Bu8 { depth = depth + 1usize }
                            if bytes[part.start] == 0x7Du8 {
                                if depth > 0usize { depth = depth - 1usize }
                                if depth == 0usize {
                                    return Stage2LocalFunctionShape { valid: true, name_start: token.start, name_end: token.end, body_start: body_start, body_end: part.end }
                                }
                            }
                        }
                        scan = part.end
                    }
                    return invalid
                }
            }
        }
        cursor = token.end
    }
    return invalid
}

/// Additive producer for the approved immutable metadata-SSA local binding.
/// The stream keeps the existing 64-byte physical record and adds exactly one
/// versioned metadata record; no stack slot, mutation, branch or call is
/// introduced.
@export(name: "jadren_selfhost_emit_stage2_local_binding_jir", abi: "C")
pub fn emit_stage2_local_binding_jir(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    if function_count != 1usize {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 1usize, status_flags: 10usize }
    }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    let function_name_start: UIntSize = shape.name_start
    let function_name_end: UIntSize = shape.name_end
    let function_parameter_count: UIntSize = 1usize
    let function_body_start: UIntSize = shape.body_start
    let function_body_end: UIntSize = shape.body_end
    if !shape.valid {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 1usize, status_flags: 20usize }
    }
    if function_name_start >= function_name_end {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: function_name_start, calls_seen: function_name_end, records_required: function_body_start, records_emitted: function_body_end, functions_lowered: 0usize, errors: 1usize, status_flags: 21usize }
    }
    if function_body_start >= function_body_end {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: function_name_start, calls_seen: function_name_end, records_required: function_body_start, records_emitted: function_body_end, functions_lowered: 0usize, errors: 1usize, status_flags: 22usize }
    }
    if function_body_end > source_length {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: function_name_start, calls_seen: function_name_end, records_required: function_body_start, records_emitted: function_body_end, functions_lowered: source_length, errors: 1usize, status_flags: 23usize }
    }
    let local: Stage2LocalBindingInfo = stage2_parse_local_binding(bytes, function_name_start, function_name_end, function_parameter_count, function_body_start, function_body_end)
    if !local.valid {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 1usize, status_flags: 12usize }
    }
    let required: UIntSize = 7usize
    var emitted: UIntSize = 0usize
    if output_capacity > 0usize { output[0] = Stage2JirRecord { kind: 1u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 32usize, operand_b: 0usize, source_start: 0usize, source_end: 0usize }; emitted = emitted + 1usize }
    if output_capacity > 1usize { output[1] = Stage2JirRecord { kind: 2u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 1usize, operand_b: 0usize, source_start: function_name_start, source_end: function_body_end }; emitted = emitted + 1usize }
    if output_capacity > 2usize { output[2] = Stage2JirRecord { kind: 3u8, opcode: 1u8, type_kind: 0u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 0usize, operand_a: 0usize, operand_b: 0usize, source_start: function_body_start, source_end: function_body_end }; emitted = emitted + 1usize }
    if output_capacity > 3usize { output[3] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 1usize, operand_a: local.literal_value, operand_b: 0usize, source_start: local.literal_start, source_end: local.literal_end }; emitted = emitted + 1usize }
    if output_capacity > 4usize { output[4] = Stage2JirRecord { kind: 4u8, opcode: local.operator_opcode, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 2usize, operand_a: if local.parameter_on_left { 0usize } else { 1usize }, operand_b: if local.parameter_on_left { 1usize } else { 0usize }, source_start: local.binary_start, source_end: local.binary_end }; emitted = emitted + 1usize }
    if output_capacity > 5usize { output[5] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 2usize, operand_a: local.use_start, operand_b: local.use_end, source_start: local.declaration_start, source_end: local.declaration_end }; emitted = emitted + 1usize }
    if output_capacity > 6usize { output[6] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 2usize, operand_a: 0usize, operand_b: 0usize, source_start: local.return_start, source_end: local.return_end }; emitted = emitted + 1usize }
    var status: UIntSize = 3usize
    if emitted == required { status = 7usize }
    return Stage2JirSummary { functions_seen: 1usize, statements_seen: 1usize, calls_seen: 1usize, records_required: required, records_emitted: emitted, functions_lowered: 1usize, errors: 0usize, status_flags: status }
}

@export(name: "jadren_selfhost_emit_stage2_literal_local_binding_jir", abi: "C")
