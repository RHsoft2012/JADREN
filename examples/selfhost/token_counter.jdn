            var operand_node: UIntSize = value_nodes[operand]
            if last_value_valid {
                if last_value_slot == operand {
                    operand_node = last_value_node
                }
            }
            if node_count < output_capacity {
                output[node_count] = ExpressionAstNodeHeader {
                    kind: 6u8,
                    opcode: operator_kinds[top],
                    flags: 1u8,
                    reserved: 0u8,
                    left: operand_node,
                    right: 0usize,
                    aux: 0usize,
                    start: operator_starts[top],
                    end: value_ends[operand],
                }
            }
            value_nodes[operand] = node_count
            value_starts[operand] = operator_starts[top]
            last_value_node = node_count
            last_value_slot = operand
            last_value_start = operator_starts[top]
            last_value_end = value_ends[operand]
            last_value_valid = true
            node_count = node_count + 1usize
            operator_count = top
        } else {
            if value_count < 2usize {
                return 0usize
            }
            let right: UIntSize = value_count - 1usize
            let left: UIntSize = value_count - 2usize
            var left_node: UIntSize = value_nodes[left]
            var right_node: UIntSize = value_nodes[right]
            var left_start: UIntSize = value_starts[left]
            var right_end: UIntSize = value_ends[right]
            if last_value_valid {
                if last_value_slot == left {
                    left_node = last_value_node
                }
                if last_value_slot == right {
                    right_node = last_value_node
                }
                if last_value_slot == left {
                    left_start = last_value_start
                }
                if last_value_slot == right {
                    right_end = last_value_end
                }
            }
            value_nodes[value_count - 2usize] = node_count
            value_ends[left] = right_end
            if node_count < output_capacity {
                output[node_count] = ExpressionAstNodeHeader {
                    kind: 7u8,
                    opcode: operator_kinds[top],
                    flags: 2u8,
                    reserved: 0u8,
                    left: left_node,
                    right: right_node,
                    aux: 0usize,
                    start: left_start,
                    end: right_end,
                }
            }
            node_count = node_count + 1usize
            value_count = left + 1usize
            last_value_node = node_count - 1usize
            last_value_slot = left
            last_value_start = left_start
            last_value_end = right_end
            last_value_valid = true
            operator_count = top
        }
    }
    if value_count != 1usize {
        return 0usize
    }
    return node_count
}

/// Emits the caller-owned argument stream for the post-order expression AST.
/// Each call argument is recovered from the call's outer comma level and
/// matched back to the last AST node with the same trimmed source span. This
/// keeps the AST and argument stream independently caller-owned while making
/// nested calls, groups, indexing and binary argument expressions explicit.
@export(name: "jadren_selfhost_parse_expression_ast_arguments", abi: "C")
@noalloc
pub fn parse_expression_ast_arguments(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    ast: read Slice<ExpressionAstNodeHeader>,
    output: write Slice<ExpressionAstArgumentHeader>,
) -> UIntSize {
    var ast_count: UIntSize = 0usize
    for ast_index in ast.indices {
        ast_count = ast_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    var output_index: UIntSize = 0usize
    for call_node in ast.indices {
        if ast[call_node].kind != 5u8 {
            continue
        }
        let callee_node: UIntSize = ast[call_node].left
        if callee_node >= call_node {
            return 0usize
        }
        let call_start: UIntSize = ast[call_node].start
        let call_end: UIntSize = ast[call_node].end
        if call_start < start {
            return 0usize
        }
        if call_end > end {
            return 0usize
        }
        if call_start >= call_end {
            return 0usize
        }
        var cursor: UIntSize = ast[callee_node].end
        var open_end: UIntSize = call_end
        var found_open: Bool = false
        while cursor < call_end {
            let info: TokenInfo = scan_token_info(bytes, cursor, call_end)
            if info.start >= call_end {
                break
            }
            if info.kind == 3u8 {
                if bytes[info.start] == 0x28u8 {
                    open_end = info.end
                    found_open = true
                    break
                }
            }
            cursor = info.end
        }
        if !found_open {
            return 0usize
        }
        var parenthesis_depth: UIntSize = 1usize
        var bracket_depth: UIntSize = 0usize
        var argument_has_token: Bool = false
        var argument_start: UIntSize = call_end
        var argument_end: UIntSize = call_end
        var ordinal: UIntSize = 0usize
        var closed: Bool = false
        cursor = open_end
        while cursor < call_end {
            let info: TokenInfo = scan_token_info(bytes, cursor, call_end)
            if info.start >= call_end {
                break
            }
            let token_start: UIntSize = info.start
            let token_end: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x28u8 {
                if !argument_has_token {
                    argument_start = token_start
                }
                argument_has_token = true
                parenthesis_depth = parenthesis_depth + 1usize
                argument_end = token_end
            } else {
                if symbol == 0x5Bu8 {
                    if !argument_has_token {
                        argument_start = token_start
                    }
                    argument_has_token = true
                    bracket_depth = bracket_depth + 1usize
                    argument_end = token_end
                } else {
                    if symbol == 0x29u8 {
                        if parenthesis_depth == 1usize {
                            if bracket_depth != 0usize {
                                return 0usize
                            }
                            if argument_has_token {
                                var argument_node: UIntSize = ast_count
                                for candidate_index in ast.indices {
                                    if candidate_index < call_node {
                                        if ast[candidate_index].start == argument_start {
                                            if ast[candidate_index].end == argument_end {
                                                argument_node = candidate_index
                                            }
                                        }
                                    }
                                }
                                if argument_node >= call_node {
                                    return 0usize
                                }
                                if output_index < output_capacity {
                                    output[output_index] = ExpressionAstArgumentHeader {
                                        call_node: call_node,
                                        ordinal: ordinal,
                                        node: argument_node,
                                        start: argument_start,
                                        end: argument_end,
                                    }
                                }
                                output_index = output_index + 1usize
                                ordinal = ordinal + 1usize
                            }
                            closed = true
                            cursor = call_end
                            break
                        }
                        if parenthesis_depth == 0usize {
                            return 0usize
                        }
                        parenthesis_depth = parenthesis_depth - 1usize
                        if !argument_has_token {
                            argument_start = token_start
                        }
                        argument_has_token = true
                        argument_end = token_end
                    } else {
                        if symbol == 0x5Du8 {
                            if bracket_depth == 0usize {
                                return 0usize
                            }
                            bracket_depth = bracket_depth - 1usize
                            if !argument_has_token {
                                argument_start = token_start
                            }
                            argument_has_token = true
                            argument_end = token_end
                        } else {
                            if symbol == 0x2Cu8 {
                                if parenthesis_depth == 1usize {
                                    if bracket_depth != 0usize {
                                        return 0usize
                                    }
                                    if !argument_has_token {
                                        return 0usize
                                    }
                                    var argument_node: UIntSize = ast_count
                                    for candidate_index in ast.indices {
                                        if candidate_index < call_node {
                                            if ast[candidate_index].start == argument_start {
                                                if ast[candidate_index].end == argument_end {
                                                    argument_node = candidate_index
                                                }
                                            }
                                        }
                                    }
                                    if argument_node >= call_node {
                                        return 0usize
                                    }
                                    if output_index < output_capacity {
                                        output[output_index] = ExpressionAstArgumentHeader {
                                            call_node: call_node,
                                            ordinal: ordinal,
                                            node: argument_node,
                                            start: argument_start,
                                            end: argument_end,
                                        }
                                    }
                                    output_index = output_index + 1usize
                                    ordinal = ordinal + 1usize
                                    argument_has_token = false
                                    argument_start = call_end
                                    argument_end = call_end
                                } else {
                                    if !argument_has_token {
                                        argument_start = token_start
                                    }
                                    argument_has_token = true
                                    argument_end = token_end
                                }
                            } else {
                                if !argument_has_token {
                                    argument_start = token_start
                                }
                                argument_has_token = true
                                argument_end = token_end
                            }
                        }
                    }
                }
            }
            cursor = info.end
        }
        if !closed {
            return 0usize
        }
        if ordinal != ast[call_node].aux {
            return 0usize
        }
    }
    return output_index
}

/// Resolves builtin types directly over the caller-owned post-order
/// expression AST. The output is aligned with the input node index, so a
/// later lowering stage can use the original child links without reparsing.
/// Identifiers use exact caller-provided bindings; `true` and `false` are
/// builtin booleans, integer leaves are builtin integers, groups forward the
/// inner type, caller-owned call signatures resolve call nodes, unary
/// operators validate their operand family, and bounded binary operators
/// propagate numeric/boolean results. Indexing, ranges, paths, and unknown
/// names remain unresolved with `flags=2`.
@export(name: "jadren_selfhost_infer_expression_ast_types", abi: "C")
@noalloc
pub fn infer_expression_ast_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    ast: read Slice<ExpressionAstNodeHeader>,
    bindings: read Slice<TypedNameBindingHeader>,
    call_bindings: read Slice<TypedCallBindingHeader>,
    argument_stream: read Slice<ExpressionAstArgumentHeader>,
    output: write Slice<TypedExpressionAstNodeHeader>,
) -> UIntSize {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    var ast_count: UIntSize = 0usize
    for ast_index in ast.indices {
        ast_count = ast_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    if ast_count > 128usize {
        return 0usize
    }
    var type_kinds: [UInt8; 128] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    for node_index in ast.indices {
        let node_kind: UInt8 = ast[node_index].kind
        let node_opcode: UInt8 = ast[node_index].opcode
        let node_left: UIntSize = ast[node_index].left
        let node_right: UIntSize = ast[node_index].right
        let node_start: UIntSize = ast[node_index].start
        let node_end: UIntSize = ast[node_index].end
        var inferred_type: UInt8 = 0u8
        if node_kind == 1u8 {
            if node_end <= source_length {
                if node_end - node_start == 4usize {
                    if bytes[node_start] == 0x74u8 {
                        if bytes[node_start + 1usize] == 0x72u8 {
                            if bytes[node_start + 2usize] == 0x75u8 {
                                if bytes[node_start + 3usize] == 0x65u8 {
                                    inferred_type = 1u8
                                }
                            }
                        }
                    }
                }
                if inferred_type == 0u8 {
                    if node_end - node_start == 5usize {
                        if bytes[node_start] == 0x66u8 {
                            if bytes[node_start + 1usize] == 0x61u8 {
                                if bytes[node_start + 2usize] == 0x6Cu8 {
                                    if bytes[node_start + 3usize] == 0x73u8 {
                                        if bytes[node_start + 4usize] == 0x65u8 {
                                            inferred_type = 1u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if inferred_type == 0u8 {
                    for binding_index in bindings.indices {
                        let binding_type: UInt8 = bindings[binding_index].type_kind
                        let binding_start: UIntSize = bindings[binding_index].name_start
                        let binding_end: UIntSize = bindings[binding_index].name_end
                        if binding_type >= 1u8 {
                            if binding_type <= 5u8 {
                                if binding_start < binding_end {
                                    if binding_end <= source_length {
                                        if binding_end - binding_start == node_end - node_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < node_end - node_start {
                                                if bytes[binding_start + compare_index] != bytes[node_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                inferred_type = binding_type
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else if node_kind == 2u8 {
            inferred_type = 2u8
        } else if node_kind == 3u8 {
            if node_left < node_index {
                inferred_type = type_kinds[node_left]
            }
        } else if node_kind == 5u8 {
            if node_left < node_index {
                if ast[node_left].kind == 1u8 {
                    let callee_start: UIntSize = ast[node_left].start
                    let callee_end: UIntSize = ast[node_left].end
                    var call_argument_count: UIntSize = 0usize
                    var call_arguments_valid: Bool = true
                    for argument_index in argument_stream.indices {
                        let argument_call_node: UIntSize = argument_stream[argument_index].call_node
                        if argument_call_node == node_index {
                            let argument_ordinal: UIntSize = argument_stream[argument_index].ordinal
                            let argument_node: UIntSize = argument_stream[argument_index].node
                            let argument_start: UIntSize = argument_stream[argument_index].start
                            let argument_end: UIntSize = argument_stream[argument_index].end
                            if argument_ordinal != call_argument_count {
                                call_arguments_valid = false
                            }
                            if argument_node >= ast_count {
                                call_arguments_valid = false
                            } else {
                                if argument_node >= node_index {
                                    call_arguments_valid = false
                                } else {
                                    if argument_start != ast[argument_node].start {
                                        call_arguments_valid = false
                                    }
                                    if argument_end != ast[argument_node].end {
                                        call_arguments_valid = false
                                    }
                                    if argument_end > source_length {
                                        call_arguments_valid = false
                                    }
                                    if argument_start >= argument_end {
                                        call_arguments_valid = false
                                    }
                                    if type_kinds[argument_node] == 0u8 {
                                        call_arguments_valid = false
                                    }
                                }
                            }
                            call_argument_count = call_argument_count + 1usize
                        }
                    }
                    if call_argument_count != ast[node_index].aux {
                        call_arguments_valid = false
                    }
                    if call_arguments_valid {
                        for binding_index in call_bindings.indices {
                            let binding_type: UInt8 = call_bindings[binding_index].return_type_kind
                            let binding_start: UIntSize = call_bindings[binding_index].name_start
                            let binding_end: UIntSize = call_bindings[binding_index].name_end
                            let parameter_count: UIntSize = call_bindings[binding_index].parameter_count
                            if binding_type >= 1u8 {
                                if binding_type <= 5u8 {
                                    if parameter_count == call_argument_count {
                                        if binding_start < binding_end {
                                            if binding_end <= source_length {
                                                if binding_end - binding_start == callee_end - callee_start {
                                                    var equal: Bool = true
                                                    var compare_index: UIntSize = 0usize
                                                    while compare_index < callee_end - callee_start {
                                                        if bytes[binding_start + compare_index] != bytes[callee_start + compare_index] {
                                                            equal = false
                                                            break
                                                        }
                                                        compare_index = compare_index + 1usize
                                                    }
                                                    if equal {
                                                        inferred_type = binding_type
                                                        break
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else if node_kind == 6u8 {
            if node_left < node_index {
                let operand_type: UInt8 = type_kinds[node_left]
                if operand_type != 0u8 {
                    let operand_start: UIntSize = ast[node_left].start
                    let operator_info: TokenInfo = scan_token_info(bytes, node_start, operand_start)
                    if operator_info.start < operand_start {
                        let operator: UInt8 = bytes[operator_info.start]
                        if operator == 0x21u8 {
                            if operand_type == 1u8 {
                                inferred_type = 1u8
                            }
                        } else if operator == 0x7Eu8 {
                            if operand_type == 2u8 {
                                inferred_type = 2u8
                            }
                        } else if operator == 0x2Bu8 {
                            if is_numeric_literal_type(operand_type) {
                                inferred_type = operand_type
                            }
                        } else if operator == 0x2Du8 {
                            if is_numeric_literal_type(operand_type) {
                                inferred_type = operand_type
                            }
                        }
                    }
                }
            }
        } else if node_kind == 7u8 {
            if node_left < node_index {
                if node_right < node_index {
                    let left_type: UInt8 = type_kinds[node_left]
                    let right_type: UInt8 = type_kinds[node_right]
                    if left_type != 0u8 {
                        if right_type != 0u8 {
                            let left_end: UIntSize = ast[node_left].end
                            let right_start: UIntSize = ast[node_right].start
                            let operator_info: TokenInfo = scan_token_info(bytes, left_end, right_start)
                            let operator_end: UIntSize = operator_span_end(bytes, operator_info.start, right_start)
                            let operator_width: UIntSize = operator_end - operator_info.start
                            if node_opcode == 1u8 {
                                if left_type == right_type {
                                    inferred_type = left_type
                                }
                            } else if node_opcode == 2u8 {
                                if operator_width != 2usize {
                                    if is_numeric_literal_type(left_type) {
                                        if is_numeric_literal_type(right_type) {
                                            if left_type == 3u8 {
                                                inferred_type = 3u8
                                            } else if right_type == 3u8 {
                                                inferred_type = 3u8
                                            } else {
                                                inferred_type = 2u8
                                            }
                                        }
                                    }
                                }
                            } else if node_opcode == 3u8 {
                                if is_numeric_literal_type(left_type) {
                                    if is_numeric_literal_type(right_type) {
                                        inferred_type = 1u8
                                    }
                                } else if left_type == right_type {
                                    inferred_type = 1u8
                                }
                            } else if node_opcode == 4u8 {
                                if operator_width == 2usize {
                                    if bytes[operator_info.start] == 0x26u8 {
                                        if bytes[operator_info.start + 1usize] == 0x26u8 {
                                            if left_type == 1u8 {
                                                if right_type == 1u8 {
                                                    inferred_type = 1u8
                                                }
                                            }
                                        }
                                    }
                                    if bytes[operator_info.start] == 0x7Cu8 {
                                        if bytes[operator_info.start + 1usize] == 0x7Cu8 {
                                            if left_type == 1u8 {
                                                if right_type == 1u8 {
                                                    inferred_type = 1u8
                                                }
                                            }
                                        }
                                    }
                                } else {
                                    if is_numeric_literal_type(left_type) {
                                        if is_numeric_literal_type(right_type) {
                                            inferred_type = 2u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        type_kinds[node_index] = inferred_type
        if node_index < output_capacity {
            output[node_index] = TypedExpressionAstNodeHeader {
                syntax_kind: node_kind,
                type_kind: inferred_type,
                flags: if inferred_type == 0u8 { 2u8 } else { 1u8 },
                reserved: 0u8,
                left: node_left,
                right: node_right,
                aux: ast[node_index].aux,
                start: node_start,
                end: node_end,
            }
        }
    }
    return ast_count
}

/// Fixed-array aware additive typed hand-off. The base identifier remains an
/// unresolved name in the original output, while an index node is resolved to
/// the caller-owned array element type when its base span matches exactly one
/// non-empty `TypedArrayBindingHeader` and its index is an integer. This keeps
/// the legacy ABI intact and leaves Slice/Buffer descriptors for a later
/// capability table.
@export(name: "jadren_selfhost_infer_expression_ast_types_with_arrays", abi: "C")
@noalloc
pub fn infer_expression_ast_types_with_arrays(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    ast: read Slice<ExpressionAstNodeHeader>,
    bindings: read Slice<TypedNameBindingHeader>,
    call_bindings: read Slice<TypedCallBindingHeader>,
    argument_stream: read Slice<ExpressionAstArgumentHeader>,
    array_bindings: read Slice<TypedArrayBindingHeader>,
    output: write Slice<TypedExpressionAstNodeHeader>,
) -> UIntSize {
    let ast_count: UIntSize = infer_expression_ast_types(
        bytes,
        start,
        end,
        ast,
        bindings,
        call_bindings,
        argument_stream,
        output,
    )
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    if ast_count == 0usize {
        return 0usize
    }
    if ast_count > 128usize {
        return 0usize
    }
    if output_capacity < ast_count {
        return ast_count
    }
    for node_index in ast.indices {
        if node_index >= ast_count {
            break
        }
        if ast[node_index].kind == 4u8 {
            let base_index: UIntSize = ast[node_index].left
            let index_index: UIntSize = ast[node_index].right
            if base_index < node_index {
                if index_index < node_index {
                    if ast[base_index].kind == 1u8 {
                        if output[index_index].type_kind == 2u8 {
                            var matches: UIntSize = 0usize
                            var selected_type: UInt8 = 0u8
                            for binding_index in array_bindings.indices {
                                if array_bindings[binding_index].length > 0usize {
                                    if array_bindings[binding_index].element_type_kind >= 1u8 {
                                        if array_bindings[binding_index].element_type_kind <= 5u8 {
                                            if array_bindings[binding_index].name_start < array_bindings[binding_index].name_end {
                                                if array_bindings[binding_index].name_end <= source_length {
                                                    if array_bindings[binding_index].name_end - array_bindings[binding_index].name_start == ast[base_index].end - ast[base_index].start {
                                                        var equal: Bool = true
                                                        var compare_index: UIntSize = 0usize
                                                        while compare_index < ast[base_index].end - ast[base_index].start {
                                                            if bytes[array_bindings[binding_index].name_start + compare_index] != bytes[ast[base_index].start + compare_index] {
                                                                equal = false
                                                                break
                                                            }
                                                            compare_index = compare_index + 1usize
                                                        }
                                                        if equal {
                                                            matches = matches + 1usize
                                                            selected_type = array_bindings[binding_index].element_type_kind
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if matches == 1usize {
                                output[node_index].type_kind = selected_type
                                output[node_index].flags = 1u8
                            }
                        }
                    }
                }
            }
        }
    }
    return ast_count
}

/// Dynamic Slice/Buffer aware additive typed hand-off. The base identifier
/// remains unresolved in the legacy output, while an index node is resolved
/// to the caller-owned sequence element type when its base span matches exactly
/// one valid `TypedSequenceBindingHeader` and its index is an integer. A plain
/// `=` whose left side is that index is promoted to typed syntax kind `8` only
/// for a write-capable sequence binding. Runtime length and capacity are
/// consumed later by Stage2 lowering, not guessed by this allocation-free
/// metadata producer.
@export(name: "jadren_selfhost_infer_expression_ast_types_with_sequences", abi: "C")
@noalloc
pub fn infer_expression_ast_types_with_sequences(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    ast: read Slice<ExpressionAstNodeHeader>,
    bindings: read Slice<TypedNameBindingHeader>,
    call_bindings: read Slice<TypedCallBindingHeader>,
    argument_stream: read Slice<ExpressionAstArgumentHeader>,
    sequence_bindings: read Slice<TypedSequenceBindingHeader>,
    output: write Slice<TypedExpressionAstNodeHeader>,
) -> UIntSize {
    let ast_count: UIntSize = infer_expression_ast_types(
        bytes,
        start,
        end,
        ast,
        bindings,
        call_bindings,
        argument_stream,
        output,
    )
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var output_capacity: UIntSize = 0usize
    for output_index in output.indices {
        output_capacity = output_index + 1usize
    }
    if ast_count == 0usize {
        return 0usize
    }
    if ast_count > 128usize {
        return 0usize
    }
    if output_capacity < ast_count {
        return ast_count
    }
    for node_index in ast.indices {
        if node_index >= ast_count {
            break
        }
        if ast[node_index].kind == 4u8 {
            let base_index: UIntSize = ast[node_index].left
            let index_index: UIntSize = ast[node_index].right
            if base_index < node_index {
                if index_index < node_index {
                    if ast[base_index].kind == 1u8 {
                        if output[index_index].type_kind == 2u8 {
                            var matches: UIntSize = 0usize
                            var selected_type: UInt8 = 0u8
                            for binding_index in sequence_bindings.indices {
                                if sequence_bindings[binding_index].sequence_kind == 1u8 {
                                    if sequence_bindings[binding_index].element_type_kind >= 1u8 {
                                        if sequence_bindings[binding_index].element_type_kind <= 5u8 {
                                            if sequence_bindings[binding_index].name_start < sequence_bindings[binding_index].name_end {
                                                if sequence_bindings[binding_index].name_end <= source_length {
                                                    if sequence_bindings[binding_index].name_end - sequence_bindings[binding_index].name_start == ast[base_index].end - ast[base_index].start {
                                                        var equal: Bool = true
                                                        var compare_index: UIntSize = 0usize
                                                        while compare_index < ast[base_index].end - ast[base_index].start {
                                                            if bytes[sequence_bindings[binding_index].name_start + compare_index] != bytes[ast[base_index].start + compare_index] {
                                                                equal = false
                                                                break
                                                            }
                                                            compare_index = compare_index + 1usize
                                                        }
                                                        if equal {
                                                            matches = matches + 1usize
                                                            selected_type = sequence_bindings[binding_index].element_type_kind
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if sequence_bindings[binding_index].sequence_kind == 2u8 {
                                    if sequence_bindings[binding_index].element_type_kind >= 1u8 {
                                        if sequence_bindings[binding_index].element_type_kind <= 5u8 {
                                            if sequence_bindings[binding_index].name_start < sequence_bindings[binding_index].name_end {
                                                if sequence_bindings[binding_index].name_end <= source_length {
                                                    if sequence_bindings[binding_index].name_end - sequence_bindings[binding_index].name_start == ast[base_index].end - ast[base_index].start {
                                                        var equal_buffer: Bool = true
                                                        var compare_buffer: UIntSize = 0usize
                                                        while compare_buffer < ast[base_index].end - ast[base_index].start {
                                                            if bytes[sequence_bindings[binding_index].name_start + compare_buffer] != bytes[ast[base_index].start + compare_buffer] {
                                                                equal_buffer = false
                                                                break
                                                            }
                                                            compare_buffer = compare_buffer + 1usize
                                                        }
                                                        if equal_buffer {
                                                            matches = matches + 1usize
                                                            selected_type = sequence_bindings[binding_index].element_type_kind
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if matches == 1usize {
                                output[node_index].type_kind = selected_type
                                output[node_index].flags = 1u8
                            }
                        }
                    }
                }
            }
        }
    }
    // Promote a resolved indexed assignment to the Stage2 store syntax. The
    // legacy parser still emits a binary kind-7 node; this additive producer
    // keeps that parser ABI intact and only changes the typed hand-off after
    // the sequence extension has proved the indexed element type and the
    // caller-owned write capability.
    for node_index in ast.indices {
        if node_index >= ast_count {
            break
        }
        if ast[node_index].kind == 7u8 {
            let left_index: UIntSize = ast[node_index].left
            let right_index: UIntSize = ast[node_index].right
            if left_index < node_index {
                if right_index < node_index {
                    if ast[left_index].kind == 4u8 {
                        let operator_info: TokenInfo = scan_token_info(
                            bytes,
                            ast[left_index].end,
                            ast[right_index].start,
                        )
                        let operator_end: UIntSize = operator_span_end(
                            bytes,
                            operator_info.start,
                            ast[right_index].start,
                        )
                        if operator_end - operator_info.start == 1usize {
                            if bytes[operator_info.start] == 0x3Du8 {
                                if output[left_index].type_kind != 0u8 {
                                    if output[right_index].type_kind == output[left_index].type_kind {
                                        let base_index: UIntSize = ast[left_index].left
                                        var write_capability: Bool = false
                                        if base_index < left_index {
                                            for binding_index in sequence_bindings.indices {
                                                if sequence_bindings[binding_index].reserved[0] == 1u8 {
                                                    if sequence_bindings[binding_index].sequence_kind == 1u8 {
                                                        if sequence_bindings[binding_index].name_start < sequence_bindings[binding_index].name_end {
                                                            if sequence_bindings[binding_index].name_end <= source_length {
                                                                if sequence_bindings[binding_index].name_end - sequence_bindings[binding_index].name_start == ast[base_index].end - ast[base_index].start {
                                                                    var equal_slice: Bool = true
                                                                    var compare_slice: UIntSize = 0usize
                                                                    while compare_slice < ast[base_index].end - ast[base_index].start {
                                                                        if bytes[sequence_bindings[binding_index].name_start + compare_slice] != bytes[ast[base_index].start + compare_slice] {
                                                                            equal_slice = false
                                                                            break
                                                                        }
                                                                        compare_slice = compare_slice + 1usize
                                                                    }
                                                                    if equal_slice {
                                                                        write_capability = true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if sequence_bindings[binding_index].sequence_kind == 2u8 {
                                                        if sequence_bindings[binding_index].name_start < sequence_bindings[binding_index].name_end {
                                                            if sequence_bindings[binding_index].name_end <= source_length {
                                                                if sequence_bindings[binding_index].name_end - sequence_bindings[binding_index].name_start == ast[base_index].end - ast[base_index].start {
                                                                    var equal_buffer: Bool = true
                                                                    var compare_buffer: UIntSize = 0usize
                                                                    while compare_buffer < ast[base_index].end - ast[base_index].start {
                                                                        if bytes[sequence_bindings[binding_index].name_start + compare_buffer] != bytes[ast[base_index].start + compare_buffer] {
                                                                            equal_buffer = false
                                                                            break
                                                                        }
                                                                        compare_buffer = compare_buffer + 1usize
                                                                    }
                                                                    if equal_buffer {
                                                                        write_capability = true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if write_capability {
                                            output[node_index].syntax_kind = 8u8
                                            output[node_index].type_kind = output[right_index].type_kind
                                            output[node_index].flags = 1u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return ast_count
}

/// Emits one bounded record for every top-level binary operator in an explicit
/// expression range. Delimiters are tracked so operators inside calls,
/// indexing, or groups are excluded. Unary shape, precedence, associativity,
/// and operand type resolution are intentionally deferred.
@export(name: "jadren_selfhost_parse_expression_binary_headers", abi: "C")
@noalloc
pub fn parse_expression_binary_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionBinaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind != 0u8 {
                        if candidate_kind != 5u8 {
                            if candidate_kind != 6u8 {
                                output[slot] = ExpressionBinaryHeader {
                                    kind: candidate_kind,
                                    left_start: start,
                                    left_end: token_start,
                                    operator_start: token_start,
                                    operator_end: operator_end,
                                    right_start: operator_end,
                                    right_end: end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded prefix/unary spans from one explicit expression range. A
/// prefix operator is recognized only while an operand is expected; the
/// following atom or delimiter group is retained as its operand span. This is
/// syntax-only and does not decide whether borrow/dereference is legal.
@export(name: "jadren_selfhost_parse_expression_unaries", abi: "C")
@noalloc
pub fn parse_expression_unaries(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionUnaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var expect_operand: Bool = true
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
            if expect_operand {
                if operator_end - token_start == 1usize {
                    var unary_kind: UInt8 = 0u8
                    if symbol == 0x2Bu8 {
                        unary_kind = 1u8
                    } else {
                        if symbol == 0x2Du8 {
                            unary_kind = 2u8
                        } else {
                            if symbol == 0x21u8 {
                                unary_kind = 3u8
                            } else {
                                if symbol == 0x7Eu8 {
                                    unary_kind = 4u8
                                } else {
                                    if symbol == 0x26u8 {
                                        unary_kind = 5u8
                                    } else {
                                        if symbol == 0x2Au8 {
                                            unary_kind = 6u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if unary_kind != 0u8 {
                        let operand_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                        var operand_start: UIntSize = end
                        var operand_end: UIntSize = end
                        if operand_info.start < end {
                            operand_start = operand_info.start
                            operand_end = operand_info.end
                            var operand_symbol: UInt8 = 0u8
                            if operand_info.kind == 3u8 {
                                operand_symbol = bytes[operand_info.start]
                            }
                            if operand_symbol == 0x28u8 {
                                var nested_depth: UIntSize = 1usize
                                var cursor: UIntSize = operand_info.end
                                while cursor < end {
                                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if nested_info.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var nested_symbol: UInt8 = 0u8
                                    if nested_info.kind == 3u8 {
                                        nested_symbol = bytes[nested_info.start]
                                    }
                                    if nested_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if nested_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                operand_end = nested_info.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = nested_info.end
                                }
                            } else {
                                if operand_symbol == 0x5Bu8 {
                                    var nested_depth: UIntSize = 1usize
                                    var cursor: UIntSize = operand_info.end
                                    while cursor < end {
                                        let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                        if nested_info.start >= end {
                                            cursor = end
                                            break
                                        }
                                        var nested_symbol: UInt8 = 0u8
                                        if nested_info.kind == 3u8 {
                                            nested_symbol = bytes[nested_info.start]
                                        }
                                        if nested_symbol == 0x5Bu8 {
                                            nested_depth = nested_depth + 1usize
                                        } else {
                                            if nested_symbol == 0x5Du8 {
                                                if nested_depth > 0usize {
                                                    nested_depth = nested_depth - 1usize
                                                }
                                                if nested_depth == 0usize {
                                                    operand_end = nested_info.end
                                                    break
                                                }
                                            }
                                        }
                                        cursor = nested_info.end
                                    }
                                }
                            }
                        }
                        output[slot] = ExpressionUnaryHeader {
                            kind: unary_kind,
                            operator_start: token_start,
                            operator_end: operator_end,
                            operand_start: operand_start,
                            operand_end: operand_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        expect_operand = true
                        source_index = operator_end
                        break
                    }
                }
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
            if candidate_kind != 0u8 {
                if candidate_kind != 5u8 {
                    if candidate_kind != 6u8 {
                        expect_operand = true
                    }
                }
                source_index = operator_end
                continue
            }
            if symbol == 0x2Cu8 {
                expect_operand = true
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits boolean, integer, float, string, and char literal spans from one
/// explicit expression range. Quoted literals honor a bounded backslash escape
/// state; invalid or unterminated literals are retained to `end` for recovery.
/// This stage does not validate literal contents or infer their types.
@export(name: "jadren_selfhost_parse_literal_headers", abi: "C")
@noalloc
pub fn parse_literal_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<LiteralHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = LiteralHeader {
                    kind: bool_kind,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_kind: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_kind = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = LiteralHeader {
                    kind: literal_kind,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first typed-semantics hand-off for self-hosting: builtin types
/// for boolean, integer, float, string, and char literals. The caller owns the
/// output buffer and receives records in the same source order as
/// `parse_literal_headers`. No names, operators, calls, aliases, or user
/// declarations are resolved here.
@export(name: "jadren_selfhost_infer_literal_types", abi: "C")
@noalloc
pub fn infer_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 1u8,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_type: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_type = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: literal_type,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed records for top-level binary expressions whose left and right
/// sides are each one builtin literal or one parenthesized builtin literal
/// group. Arithmetic over numeric literals yields integer or float, comparisons
/// yield bool, and logical operators over boolean literals yield bool. A
/// a bounded two-operator chain is also accepted: arithmetic operators may
/// mix, and one arithmetic operator may feed a numeric comparison according to
/// the bounded precedence categories. Names, casts, calls and user types remain
/// outside this narrow binary hand-off.
@export(name: "jadren_selfhost_infer_binary_literal_types", abi: "C")
@noalloc
pub fn infer_binary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let chain_header: TypedExpressionHeader = infer_binary_literal_chain_header(bytes, start, end)
    let chain_mode: Bool = chain_header.type_kind != 0u8
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        if chain_mode {
            output[slot] = TypedExpressionHeader {
                expression_kind: chain_header.expression_kind,
                type_kind: chain_header.type_kind,
                start: chain_header.start,
                end: chain_header.end,
                depth: chain_header.depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = end
        }
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind == 2u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        var result_type: UInt8 = 0u8
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                if left_type == 3u8 {
                                    result_type = 3u8
                                } else {
                                    if right_type == 3u8 {
                                        result_type = 3u8
                                    } else {
                                        result_type = 2u8
                                    }
                                }
                            }
                        }
                        if result_type != 0u8 {
                            let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                            let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                            var right_end: UIntSize = right_info.end
                            if right_grouped_type != 0u8 {
                                right_end = bounded_grouped_literal_end(bytes, operator_end, end)
                            } else {
                                if right_type == 3u8 {
                                    right_end = bounded_numeric_literal_end(bytes, operator_end, end)
                                }
                            }
                            output[slot] = TypedExpressionHeader {
                                expression_kind: 2u8,
                                type_kind: result_type,
                                start: left_info.start,
                                end: right_end,
                                depth: delimiter_depth,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                            source_index = operator_end
                            break
                        }
                    }
                    if candidate_kind == 3u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                let right_end: UIntSize = if right_grouped_type != 0u8 {
                                    bounded_grouped_literal_end(bytes, operator_end, end)
                                } else {
                                    right_info.end
                                }
                                output[slot] = TypedExpressionHeader {
                                    expression_kind: 2u8,
                                    type_kind: 1u8,
                                    start: left_info.start,
                                    end: right_end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                    if candidate_kind == 4u8 {
                        if is_boolean_binary_operator(bytes, token_start, operator_end) {
                            let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                start,
                                token_start,
                            )
                            let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                operator_end,
                                end,
                            )
                            let left_type: UInt8 = if left_grouped_type != 0u8 {
                                left_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, start, token_start)
                            }
                            let right_type: UInt8 = if right_grouped_type != 0u8 {
                                right_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, operator_end, end)
                            }
                            if left_type == 1u8 {
                                if right_type == 1u8 {
                                    let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                    let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                    let right_end: UIntSize = if right_grouped_type != 0u8 {
                                        bounded_grouped_literal_end(bytes, operator_end, end)
                                    } else {
                                        right_info.end
                                    }
                                    output[slot] = TypedExpressionHeader {
                                        expression_kind: 2u8,
                                        type_kind: 1u8,
                                        start: left_info.start,
                                        end: right_end,
                                        depth: delimiter_depth,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = operator_end
                                    break
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
        if chain_mode {
            break
        }
    }
    return output_index
}

/// Emits one typed record for the bounded explicit numeric cast route.
@export(name: "jadren_selfhost_infer_cast_literal_types", abi: "C")
@noalloc
pub fn infer_cast_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_cast_literal_header(bytes, start, end)
    if header.type_kind == 0u8 {
        return 0usize
    }
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        if header.type_kind != 0u8 {
            output[slot] = TypedExpressionHeader {
                expression_kind: header.expression_kind,
                type_kind: header.type_kind,
                start: header.start,
                end: header.end,
                depth: header.depth,
            }
            output_index = 1usize
        }
    }
    return output_index
}

/// Emits one typed record for a unary operator applied to exactly one builtin
/// literal or one or more nested parenthesized literal groups. Contiguous
/// prefix chains are applied from right to left, so `--42` preserves Integer
/// and `!!true` preserves Bool. `+`/`-` preserve integer or float, `!` accepts
/// bool, and `~` accepts integer. This is intentionally a prefix-only
/// hand-off; ASCII whitespace between prefix operators is accepted, while
/// borrow/dereference semantics, precedence and names remain later stages.
fn infer_unary_literal_header(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TypedExpressionHeader {
    let operator_info: TokenInfo = scan_token_info(bytes, start, end)
    if operator_info.start >= end {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operator_end: UIntSize = operator_info.end
    if operator_end != operator_info.start + 1usize {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if !is_unary_operator(bytes[operator_info.start]) {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    var operand_start: UIntSize = operator_end
    var chain_cursor: UIntSize = operator_end
    while chain_cursor < end {
        let chain_info: TokenInfo = scan_token_info(bytes, chain_cursor, end)
        if chain_info.start >= end {
            break
        }
        if chain_info.end != chain_info.start + 1usize {
            break
        }
        if !is_unary_operator(bytes[chain_info.start]) {
            break
        }
        operand_start = chain_info.end
        chain_cursor = chain_info.end
    }
    let grouped_operand_type: UInt8 = bounded_grouped_literal_type_kind(
        bytes,
        operand_start,
        end,
    )
    let operand_type: UInt8 = if grouped_operand_type != 0u8 {
        grouped_operand_type
    } else {
        bounded_literal_type_kind(bytes, operand_start, end)
    }
    let grouped: Bool = grouped_operand_type != 0u8
    var result_type: UInt8 = operand_type
    var operator_cursor: UIntSize = operand_start
    while operator_cursor > operator_info.start {
        operator_cursor = operator_cursor - 1usize
        if classify_byte(bytes[operator_cursor]) == 3u8 {
            continue
        }
        let operator: UInt8 = bytes[operator_cursor]
        var next_type: UInt8 = 0u8
        if operator == 0x2Bu8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x2Du8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x21u8 {
            if result_type == 1u8 {
                next_type = 1u8
            }
        }
        if operator == 0x7Eu8 {
            if result_type == 2u8 {
                next_type = 2u8
            }
        }
        result_type = next_type
        if result_type == 0u8 {
            break
        }
    }
    if result_type == 0u8 {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operand_info: TokenInfo = scan_token_info(bytes, operand_start, end)
    var operand_end: UIntSize = operand_info.end
    var depth: UIntSize = 0usize
    if grouped {
        operand_end = bounded_grouped_literal_end(bytes, operand_start, end)
        var depth_cursor: UIntSize = operand_start
        while true {
            let group_info: TokenInfo = scan_token_info(bytes, depth_cursor, end)
            if group_info.start >= end {
                break
            }
            if bytes[group_info.start] != 0x28u8 {
                break
            }
            depth = depth + 1usize
            depth_cursor = group_info.end
        }
    } else {
        if operand_type == 2u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
        if operand_type == 3u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
    }
    return TypedExpressionHeader {
        expression_kind: 3u8,
        type_kind: result_type,
        start: operator_info.start,
        end: operand_end,
        depth: depth,
    }
}

@export(name: "jadren_selfhost_infer_unary_literal_types", abi: "C")
@noalloc
pub fn infer_unary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_unary_literal_header(bytes, start, end)
    if header.type_kind != 0u8 {
        var output_index: UIntSize = 0usize
        for slot in output.indices {
            if output_index == 0usize {
                output[slot] = TypedExpressionHeader {
                    expression_kind: header.expression_kind,
                    type_kind: header.type_kind,
                    start: header.start,
                    end: header.end,
                    depth: header.depth,
                }
                output_index = 1usize
            }
        }
        return output_index
    }
    return 0usize
}

/// Emits one typed name record for every identifier token that matches a
/// caller-owned binding entry. The binding spans and output buffer are bounded
/// by the caller; results preserve source order and stop at output capacity.
/// This is a symbol-table hand-off, not a scope-aware resolver.
@export(name: "jadren_selfhost_infer_name_types", abi: "C")
@noalloc
pub fn infer_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                    var equal: Bool = true
                                    var compare_index: UIntSize = 0usize
                                    while compare_index < next_source - token_start {
                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                            equal = false
                                            break
                                        }
                                        compare_index = compare_index + 1usize
                                    }
                                    if equal {
                                        output[slot] = TypedExpressionHeader {
                                            expression_kind: 5u8,
                                            type_kind: bindings[binding_index].type_kind,
                                            start: token_start,
                                            end: next_source,
                                            depth: delimiter_depth,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        break
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records for caller-owned function bindings. The callee
/// bytes and positional argument count must match exactly; only builtin return
/// types are accepted. A valid record spans from the callee through the close
/// delimiter and uses expression kind `8` in the existing typed header.
@export(name: "jadren_selfhost_infer_call_types", abi: "C")
@noalloc
pub fn infer_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedCallBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    for binding_index in bindings.indices {
                    if bindings[binding_index].return_type_kind >= 1u8 {
                        if bindings[binding_index].return_type_kind <= 5u8 {
                            if bindings[binding_index].parameter_count == argument_count {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == callee_end - callee_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < callee_end - callee_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                output[slot] = TypedExpressionHeader {
                                                    expression_kind: 8u8,
                                                    type_kind: bindings[binding_index].return_type_kind,
                                                    start: callee_start,
                                                    end: close_end,
                                                    depth: delimiter_depth,
                                                }
                                                output_index = output_index + 1usize
                                                emitted = true
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records selected from caller-owned concrete overloads and
/// generic fallbacks. Matching is exact by name bytes and positional arity;
/// the lowest generic parameter count wins and an equal-specificity tie is
/// rejected as ambiguous. Parameter types, bounds and substitution remain
/// outside this additive resolver boundary.
@export(name: "jadren_selfhost_resolve_call_types", abi: "C")
@noalloc
pub fn resolve_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    candidates: read Slice<TypedCallCandidateHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    var argument_type_kind: UInt8 = 0u8
                    if argument_count == 1usize {
                        argument_type_kind = bounded_literal_type_kind(
                            bytes,
                            next_source,
                            close_start,
                        )
                    }
                    var argument_type_count: UIntSize = bounded_argument_type_count(
                        bytes,
                        next_source,
                        close_start,
                    )
                    var best_type_specificity: UInt8 = 0u8
                    var best_generic_count: UIntSize = 33usize
                    var best_return_type: UInt8 = 0u8
                    var best_match_count: UIntSize = 0usize
                    for candidate_index in candidates.indices {
                        if candidates[candidate_index].return_type_kind <= 5u8 {
                            var return_type_is_eligible: Bool = false
                            if candidates[candidate_index].return_type_kind >= 1u8 {
                                return_type_is_eligible = true
                            } else {
                                if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                    return_type_is_eligible = true
                                } else {
                                    if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                        return_type_is_eligible = true
                                    } else {
                                        if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                            return_type_is_eligible = true
                                        }
                                    }
                                }
                            }
                            if return_type_is_eligible {
                                if candidates[candidate_index].generic_parameter_count <= 32usize {
                                    if candidates[candidate_index].parameter_type_kind <= 5u8 {
                                        if candidates[candidate_index].generic_bound_kind <= 3u8 {
                                            var bound_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_parameter_count != 0usize {
                                                bound_is_eligible = true
                                            } else {
                                                if candidates[candidate_index].generic_bound_kind == 0u8 {
                                                    bound_is_eligible = true
                                                }
                                            }
                                            if bound_is_eligible {
                                            var substitution_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_substitution_kind == 0u8 {
                                                substitution_is_eligible = true
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if substitution_is_eligible {
                                        var parameter_matches: Bool = false
                                        var type_specificity: UInt8 = 0u8
                                        if candidates[candidate_index].parameter_count == argument_count {
                                            var has_parameter_type_span: Bool = false
                                            if candidates[candidate_index].parameter_type_start != 0u16 {
                                                has_parameter_type_span = true
                                            } else {
                                                if candidates[candidate_index].parameter_type_end != 0u16 {
                                                    has_parameter_type_span = true
                                                }
                                            }
                                            if has_parameter_type_span {
                                                if candidates[candidate_index].parameter_type_start < candidates[candidate_index].parameter_type_end {
                                                    let parameter_type_start: UIntSize = candidates[candidate_index].parameter_type_start as UIntSize
                                                    let parameter_type_end: UIntSize = candidates[candidate_index].parameter_type_end as UIntSize
                                                    if parameter_type_end <= source_length {
                                                        if argument_type_count == argument_count {
                                                            if bounded_parameter_type_count(bytes, parameter_type_start, parameter_type_end) == argument_count {
                                                                if argument_count <= 32usize {
                                                                    parameter_matches = true
                                                                    var parameter_index: UIntSize = 0usize
                                                                    while parameter_index < argument_count {
                                                                        let expected_type: UInt8 = bounded_parameter_type_kind_at(bytes, parameter_type_start, parameter_type_end, parameter_index)
                                                                        var actual_type: UInt8 = 0u8
                                                                        if argument_count == 1usize {
                                                                            actual_type = argument_type_kind
                                                                        } else {
                                                                            actual_type = bounded_argument_type_kind_at(bytes, next_source, close_start, parameter_index)
                                                                        }
                                                                        if expected_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if actual_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if expected_type != actual_type {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        parameter_index = parameter_index + 1usize
                                                                    }
                                                                    if parameter_matches {
                                                                        type_specificity = 2u8
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                        } else {
                                                        if candidates[candidate_index].parameter_type_kind == argument_type_kind {
                                                            parameter_matches = true
                                                            type_specificity = 2u8
                                                        }
                                                    }
                                                } else {
                                                    if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if !bounded_generic_bound_matches(bytes, next_source, close_start, argument_count, argument_type_kind, candidates[candidate_index].generic_bound_kind) {
                                                parameter_matches = false
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if argument_count != 1usize {
                                                    parameter_matches = false
                                                } else {
                                                    if argument_type_kind == 0u8 {
                                                        parameter_matches = false
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                    if !bounded_same_argument_type_matches(bytes, next_source, close_start, argument_count) {
                                                        parameter_matches = false
                                                    }
                                                } else {
                                                    if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                        if !bounded_all_argument_types_known(bytes, next_source, close_start, argument_count) {
                                                            parameter_matches = false
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].name_start < candidates[candidate_index].name_end {
                                                if candidates[candidate_index].name_end <= source_length {
                                                    if candidates[candidate_index].name_end - candidates[candidate_index].name_start == callee_end - callee_start {
                                                    var equal: Bool = true
                                                    var compare_index: UIntSize = 0usize
                                                    while compare_index < callee_end - callee_start {
                                                        if bytes[candidates[candidate_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                            equal = false
                                                            break
                                                        }
                                                        compare_index = compare_index + 1usize
                                                    }
                                                    if equal {
                                                        var selected_return_type: UInt8 = candidates[candidate_index].return_type_kind
                                                        if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                            selected_return_type = argument_type_kind
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                                selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                            } else {
                                                                if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                                    selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                                }
                                                            }
                                                        }
                                                        if type_specificity > best_type_specificity {
                                                            best_type_specificity = type_specificity
                                                            best_generic_count = candidates[candidate_index].generic_parameter_count
                                                            best_return_type = selected_return_type
                                                            best_match_count = 1usize
                                                        } else {
                                                            if type_specificity == best_type_specificity {
                                                                if candidates[candidate_index].generic_parameter_count < best_generic_count {
                                                                    best_generic_count = candidates[candidate_index].generic_parameter_count
                                                                    best_return_type = selected_return_type
                                                                    best_match_count = 1usize
                                                                } else {
                                                                    if candidates[candidate_index].generic_parameter_count == best_generic_count {
                                                                        best_match_count = best_match_count + 1usize
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    if best_match_count == 1usize {
                        output[slot] = TypedExpressionHeader {
                            expression_kind: 8u8,
                            type_kind: best_return_type,
                            start: callee_start,
                            end: close_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by the deepest visible caller-owned lexical
/// binding. Matching is exact byte equality, bindings with an invalid source
/// span/type are ignored, and later bindings win equal-depth ties. This is a
/// bounded shadowing prototype; it does not resolve regions, aliases,
/// generics, or user-defined types.
@export(name: "jadren_selfhost_infer_scoped_name_types", abi: "C")
@noalloc
pub fn infer_scoped_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedScopedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < next_source - token_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                var should_select: Bool = false
                                                if !selected {
                                                    should_select = true
                                                } else {
                                                    if bindings[binding_index].scope_depth >= selected_scope {
                                                        should_select = true
                                                    }
                                                }
                                                if should_select {
                                                    selected = true
                                                    selected_type = bindings[binding_index].type_kind
                                                    selected_scope = bindings[binding_index].scope_depth
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 6u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by a bounded caller-owned visibility region.
/// Invalid name/region spans and out-of-region tokens are ignored. This is a
/// region-aware prototype, not a complete alias, generic, or user-type
/// resolver. Region boundaries must align with the declared delimiter depth;
/// a span that cuts through a nested block is ignored.
fn delimiter_depth_at(bytes: read Slice<UInt8>, position: UIntSize) -> UIntSize {
    var cursor: UIntSize = 0usize
    var depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x29u8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x5Du8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x28u8 {
                depth = depth + 1usize
            }
            if symbol == 0x5Bu8 {
                depth = depth + 1usize
            }
        }
        cursor = info.end
    }
    return depth
}

/// Returns the top delimiter kind immediately before `position`, or `0xff`
/// for an unmatched/mismatched delimiter. Region boundaries compare this
/// value in addition to numeric depth so `(`/`[` pairs cannot be confused.
fn delimiter_top_at(bytes: read Slice<UInt8>, position: UIntSize) -> UInt8 {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return 0xffu8
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return 0xffu8
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    if stack_count == 0usize {
        return 0u8
    }
    return stack[stack_count - 1usize]
}

/// Validates the complete delimiter prefix before region name resolution.
/// This bounded hand-off rejects unmatched/mismatched closers and overflow so
/// malformed source cannot produce typed-name records.
fn delimiters_well_formed_through(bytes: read Slice<UInt8>, position: UIntSize) -> Bool {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return false
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return false
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    return true
}

@export(name: "jadren_selfhost_infer_region_name_types", abi: "C")
@noalloc
pub fn infer_region_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedRegionNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    if !delimiters_well_formed_through(bytes, end) {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                var selected_region_width: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].region_start < bindings[binding_index].region_end {
                                        if bindings[binding_index].region_end <= source_length {
                                            if bindings[binding_index].name_start >= bindings[binding_index].region_start {
                                                if bindings[binding_index].name_end <= bindings[binding_index].region_end {
                                                    if bindings[binding_index].region_start <= token_start {
                                                        if next_source <= bindings[binding_index].region_end {
                                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_start) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_end) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_end) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) != delimiter_top_at(bytes, bindings[binding_index].region_end) {
                                                    continue
                                                }
                                                if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                                                    var equal: Bool = true
                                                                    var compare_index: UIntSize = 0usize
                                                                    while compare_index < next_source - token_start {
                                                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                                            equal = false
                                                                            break
                                                                        }
                                                                        compare_index = compare_index + 1usize
                                                                    }
                                                                    if equal {
                                                                        var should_select: Bool = false
                                                                        var region_width: UIntSize = bindings[binding_index].region_end - bindings[binding_index].region_start
                                                                        if !selected {
                                                                            should_select = true
                                                                        } else {
                                                                            if bindings[binding_index].scope_depth > selected_scope {
                                                                                should_select = true
                                                                            } else {
                                                                                if bindings[binding_index].scope_depth == selected_scope {
                                                                                    if region_width <= selected_region_width {
                                                                                        should_select = true
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                        if should_select {
                                                                            selected = true
                                                                            selected_type = bindings[binding_index].type_kind
                                                                            selected_scope = bindings[binding_index].scope_depth
                                                                            selected_region_width = region_width
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 7u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only type components from an explicit `[start,end)` type
/// span. Path identifiers, capability/function keywords and delimiters are
/// preserved in source order with caller-owned output. No type resolution,
/// alias lookup, generic substitution or malformed-type recovery is done.
@export(name: "jadren_selfhost_parse_type_components", abi: "C")
@noalloc
pub fn parse_type_components(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypeComponentHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            var component_kind: UInt8 = type_component_kind(
                bytes,
                info.kind,
                token_start,
                next_source,
            )
            var component_end: UIntSize = next_source
            if symbol == 0x2Du8 {
                if next_source < end {
                    if bytes[next_source] == 0x3Eu8 {
                        component_kind = 14u8
                        component_end = next_source + 1usize
                    }
                }
            }
            if component_kind != 0u8 {
                let component_depth: UIntSize = delimiter_depth
                if component_kind == 5u8 {
                    if delimiter_depth > 0usize {
                        delimiter_depth = delimiter_depth - 1usize
                    }
                } else {
                    if component_kind == 7u8 {
                        if delimiter_depth > 0usize {
                            delimiter_depth = delimiter_depth - 1usize
                        }
                    } else {
                        if component_kind == 9u8 {
                            if delimiter_depth > 0usize {
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
                output[slot] = TypeComponentHeader {
                    kind: component_kind,
                    start: token_start,
                    end: component_end,
                    depth: component_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                if component_kind == 4u8 {
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if component_kind == 6u8 {
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if component_kind == 8u8 {
                            delimiter_depth = delimiter_depth + 1usize
                        }
                    }
                }
                source_index = component_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only match-arm spans from an explicit match-body range.
/// Patterns are bounded by a top-level `=>`; an optional top-level `if`
/// introduces a guard span. Arm bodies may be a balanced `{...}` block or an
/// expression ending at a top-level comma/semicolon. Pattern matching,
/// exhaustiveness, guard typing and recovery remain later AST/type stages.
@export(name: "jadren_selfhost_parse_match_arms", abi: "C")
@noalloc
pub fn parse_match_arms(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<MatchArmHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let first_info: TokenInfo = scan_token_info(bytes, source_index, end)
            if first_info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = first_info.start
            var pattern_end: UIntSize = end
            var guard_start: UIntSize = end
            var guard_end: UIntSize = end
            var arrow_start: UIntSize = end
            var arrow_end: UIntSize = end
            var pattern_depth: UIntSize = 0usize
            var guard_active: Bool = false
            var pattern_cursor: UIntSize = pattern_start
            while pattern_cursor < end {
                let info: TokenInfo = scan_token_info(bytes, pattern_cursor, end)
                if info.start >= end {
                    pattern_cursor = end
                    break
                }
                let token_start: UIntSize = info.start
                let next_source: UIntSize = info.end
                var symbol: UInt8 = 0u8
                if info.kind == 3u8 {
                    symbol = bytes[token_start]
                }
                if symbol == 0x28u8 {
                    pattern_depth = pattern_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        pattern_depth = pattern_depth + 1usize
                    } else {
                        if symbol == 0x29u8 {
                            if pattern_depth > 0usize {
                                pattern_depth = pattern_depth - 1usize
                            }
                        } else {
                            if symbol == 0x5Du8 {
                                if pattern_depth > 0usize {
                                    pattern_depth = pattern_depth - 1usize
                                }
                            }
                        }
                    }
                }
                if symbol == 0x3Du8 {
                    if next_source < end {
                        if bytes[next_source] == 0x3Eu8 {
                            if pattern_depth == 0usize {
                                arrow_start = token_start
                                arrow_end = next_source + 1usize
                                if !guard_active {
                                    pattern_end = arrow_start
                                } else {
                                    guard_end = arrow_start
                                }
                                pattern_cursor = arrow_end
                                break
                            }
                        }
                    }
                }
                if info.kind == 1u8 {
                    let width: UIntSize = next_source - token_start
                    if width == 2usize {
                        if bytes[token_start] == 0x69u8 {
                            if bytes[token_start + 1usize] == 0x66u8 {
                                if pattern_depth == 0usize {
                                    if !guard_active {
                                        pattern_end = token_start
                                        guard_start = next_source
                                        guard_active = true
                                    }
                                }
                            }
                        }
                    }
                }
                pattern_cursor = next_source
            }
            if arrow_start >= end {
                source_index = end
                break
            }
            if !guard_active {
                pattern_end = arrow_start
            }
            var body_start: UIntSize = end
            var body_end: UIntSize = end
            let body_info: TokenInfo = scan_token_info(bytes, arrow_end, end)
            if body_info.start < end {
                body_start = body_info.start
                var body_cursor: UIntSize = body_info.start
                var body_depth: UIntSize = 0usize
                var body_block: Bool = false
                if bytes[body_info.start] == 0x7Bu8 {
                    body_block = true
                    body_depth = 1usize
                    body_cursor = body_info.end
                }
                while body_cursor < end {
                    let body_token: TokenInfo = scan_token_info(bytes, body_cursor, end)
                    if body_token.start >= end {
                        body_cursor = end
                        break
                    }
                    var body_symbol: UInt8 = 0u8
                    if body_token.kind == 3u8 {
                        body_symbol = bytes[body_token.start]
                    }
                    if body_block {
                        if body_symbol == 0x7Bu8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x7Du8 {
                                if body_depth > 0usize {
                                    body_depth = body_depth - 1usize
                                }
                                if body_depth == 0usize {
                                    body_end = body_token.end
                                    body_cursor = body_token.end
                                    break
                                }
                            }
                        }
                    } else {
                        if body_symbol == 0x28u8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x5Bu8 {
                                body_depth = body_depth + 1usize
                            } else {
                                if body_symbol == 0x29u8 {
                                    if body_depth > 0usize {
                                        body_depth = body_depth - 1usize
                                    }
                                } else {
                                    if body_symbol == 0x5Du8 {
                                        if body_depth > 0usize {
                                            body_depth = body_depth - 1usize
                                        }
                                    } else {
                                        if body_depth == 0usize {
                                            if body_symbol == 0x2Cu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                            if body_symbol == 0x3Bu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    body_cursor = body_token.end
                }
                if body_end == end {
                    body_end = body_cursor
                }
            }
            output[slot] = MatchArmHeader {
                pattern_start: pattern_start,
                pattern_end: pattern_end,
                guard_start: guard_start,
                guard_end: guard_end,
                body_start: body_start,
                body_end: body_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = body_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if bytes[separator.start] == 0x2Cu8 {
                        source_index = separator.end
                    } else {
                        if separator.start == source_index {
                            if bytes[separator.start] == 0x3Bu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits top-level syntax-only pattern nodes from an explicit pattern range.
/// Wildcards, qualified paths, literals and constructor paths are retained as
/// bounded spans. Constructor payloads are paired with one scalar delimiter
/// depth counter; binding, exhaustiveness, type checking and recovery are
/// intentionally deferred to later compiler stages.
@export(name: "jadren_selfhost_parse_pattern_headers", abi: "C")
@noalloc
pub fn parse_pattern_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var pattern_end: UIntSize = next_source
            var payload_start: UIntSize = end
            var payload_end: UIntSize = end
            var pattern_kind: UInt8 = 2u8
            var pattern_depth: UIntSize = 0usize
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[pattern_start]
            }
            if info.kind == 1u8 {
                if next_source - pattern_start == 1usize {
                    if bytes[pattern_start] == 0x5Fu8 {
                        pattern_kind = 1u8
                    }
                }
            }
            if pattern_kind == 1u8 {
                pattern_kind = 1u8
            } else {
                let bool_kind: UInt8 = boolean_literal_kind(
                    bytes,
                    info.kind,
                    pattern_start,
                    next_source,
                )
                if info.kind == 2u8 {
                    pattern_kind = 3u8
                } else {
                    if bool_kind != 0u8 {
                        pattern_kind = 3u8
                    } else {
                        if symbol == 0x22u8 {
                            pattern_kind = 3u8
                        } else {
                            if symbol == 0x27u8 {
                                pattern_kind = 3u8
                            }
                        }
                    }
                }
            }
            if pattern_kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = next_source
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    pattern_end = quoted.end
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    if pattern_end == next_source {
                        pattern_end = cursor
                    }
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = next_source
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        pattern_end = quoted.end
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        if pattern_end == next_source {
                            pattern_end = cursor
                        }
                    }
                }
            } else {
                if info.kind == 1u8 {
                    var path_cursor: UIntSize = next_source
                    var path_done: Bool = false
                    while path_cursor < end {
                        let separator: TokenInfo = scan_token_info(bytes, path_cursor, end)
                        if separator.start >= end {
                            path_cursor = end
                            break
                        }
                        var separator_symbol: UInt8 = 0u8
                        if separator.kind == 3u8 {
                            separator_symbol = bytes[separator.start]
                        }
                        if separator_symbol == 0x2Eu8 {
                            let segment: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if segment.start < end {
                                if segment.kind == 1u8 {
                                    pattern_end = segment.end
                                    path_cursor = segment.end
                                    continue
                                }
                            }
                        }
                        if separator_symbol == 0x3Au8 {
                            let second: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if second.start < end {
                                if second.kind == 3u8 {
                                    if bytes[second.start] == 0x3Au8 {
                                        let segment: TokenInfo = scan_token_info(
                                            bytes,
                                            second.end,
                                            end,
                                        )
                                        if segment.start < end {
                                            if segment.kind == 1u8 {
                                                pattern_end = segment.end
                                                path_cursor = segment.end
                                                continue
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        path_done = true
                        break
                    }
                    if path_done {
                        path_cursor = pattern_end
                    }
                    let constructor: TokenInfo = scan_token_info(bytes, pattern_end, end)
                    if constructor.start < end {
                        if constructor.kind == 3u8 {
                            if bytes[constructor.start] == 0x28u8 {
                                pattern_kind = 4u8
                                payload_start = constructor.end
                                var cursor: UIntSize = constructor.end
                                var nested_depth: UIntSize = 1usize
                                while cursor < end {
                                    let payload: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if payload.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var payload_symbol: UInt8 = 0u8
                                    if payload.kind == 3u8 {
                                        payload_symbol = bytes[payload.start]
                                    }
                                    if payload_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if payload_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                payload_end = payload.start
                                                pattern_end = payload.end
                                                cursor = payload.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = payload.end
                                }
                                if payload_end == end {
                                    payload_end = cursor
                                    pattern_end = cursor
                                }
                            }
                        }
                    }
                }
            }
            output[slot] = PatternHeader {
                kind: pattern_kind,
                start: pattern_start,
                end: pattern_end,
                payload_start: payload_start,
                payload_end: payload_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = pattern_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if separator.kind == 3u8 {
                        if bytes[separator.start] == 0x2Cu8 {
                            source_index = separator.end
                        } else {
                            if bytes[separator.start] == 0x7Cu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only binding candidates from an explicit pattern range.
/// Bare identifiers are bindings; wildcard, literal, qualified-path and
/// constructor-head identifiers are deliberately excluded. This is a bounded
/// pre-stage for later binding/exhaustiveness/type checking and does not
/// resolve names.
@export(name: "jadren_selfhost_parse_pattern_bindings", abi: "C")
@noalloc
pub fn parse_pattern_bindings(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternBindingHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var path_pending: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    path_pending = false
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        path_pending = false
                        continue
                    }
                }
            }
            if info.kind == 1u8 {
                var wildcard: Bool = false
                if info.end - info.start == 1usize {
                    if bytes[info.start] == 0x5Fu8 {
                        wildcard = true
                    }
                }
                let next: TokenInfo = scan_token_info(bytes, info.end, end)
                var next_symbol: UInt8 = 0u8
                if next.kind == 3u8 {
                    next_symbol = bytes[next.start]
                }
                var path_segment: Bool = path_pending
                if next_symbol == 0x2Eu8 {
                    path_segment = true
                } else {
                    if next_symbol == 0x3Au8 {
                        path_segment = true
                    } else {
                        if next_symbol == 0x28u8 {
                            path_segment = true
                        }
                    }
                }
                if !wildcard {
                    if !path_segment {
                        output[slot] = PatternBindingHeader {
                            kind: 1u8,
                            start: info.start,
                            end: info.end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        source_index = info.end
                        path_pending = false
                        break
                    }
                }
                source_index = info.end
                path_pending = false
                continue
            }
            if info.kind == 3u8 {
                if symbol == 0x28u8 {
                    delimiter_depth = delimiter_depth + 1usize
                    path_pending = false
                } else {
                    if symbol == 0x5Bu8 {
                        delimiter_depth = delimiter_depth + 1usize
                        path_pending = false
                    } else {
                        if symbol == 0x7Bu8 {
                            delimiter_depth = delimiter_depth + 1usize
                            path_pending = false
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth > 0usize {
                                    delimiter_depth = delimiter_depth - 1usize
                                }
                                path_pending = false
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth > 0usize {
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                    path_pending = false
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth > 0usize {
                                            delimiter_depth = delimiter_depth - 1usize
                                        }
                                        path_pending = false
                                    } else {
                                        if symbol == 0x2Eu8 {
                                            path_pending = true
                                        } else {
                                            if symbol == 0x3Au8 {
                                                path_pending = true
                                            } else {
                                                path_pending = false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                path_pending = false
            }
            source_index = info.end
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded delimiter recovery records for an explicit pattern range.
/// Quoted strings/chars are skipped, unmatched closers are reported at their
/// own span, and an unclosed opener is reported from the first opener to the
/// caller-provided `end`. Full expected-token diagnostics remain a later
/// parser stage.
@export(name: "jadren_selfhost_parse_pattern_recovery", abi: "C")
@noalloc
pub fn parse_pattern_recovery(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternRecoveryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth == 0usize {
                                    output[slot] = PatternRecoveryHeader {
                                        kind: 2u8,
                                        start: info.start,
                                        end: info.end,
                                        depth: 0usize,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = info.end
                                    break
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth == 0usize {
                                        output[slot] = PatternRecoveryHeader {
                                            kind: 2u8,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        source_index = info.end
                                        break
                                    }
                                    delimiter_depth = delimiter_depth - 1usize
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth == 0usize {
                                            output[slot] = PatternRecoveryHeader {
                                                kind: 2u8,
                                                start: info.start,
                                                end: info.end,
                                                depth: 0usize,
                                            }
                                            output_index = output_index + 1usize
                                            emitted = true
                                            source_index = info.end
                                            break
                                        }
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = info.end
        }
        if !emitted {
            if delimiter_depth > 0usize {
                output[slot] = PatternRecoveryHeader {
                    kind: 1u8,
                    start: first_open_start,
                    end: end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = end
                delimiter_depth = 0usize
                first_open_start = end
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first bounded delimiter diagnostic for an explicit pattern range.
/// The caller-owned `stack` stores opener bytes so a mismatched closer can
/// report the expected closer without a heap-backed parser stack. Quoted
/// string/char spans are skipped and the output is at most one record.
@export(name: "jadren_selfhost_parse_pattern_diagnostics", abi: "C")
@noalloc
pub fn parse_pattern_diagnostics(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternDiagnosticHeader>,
    stack: write Slice<UInt8>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    var output_index: UIntSize = 0usize
    var output_capacity: UIntSize = 0usize
    for slot in output.indices {
        output_capacity = output_capacity + 1usize
    }
    while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    stack[delimiter_depth] = symbol
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        stack[delimiter_depth] = symbol
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            stack[delimiter_depth] = symbol
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            var is_closer: Bool = false
                            if symbol == 0x29u8 {
                                is_closer = true
                            } else {
                                if symbol == 0x5Du8 {
                                    is_closer = true
                                } else {
                                    if symbol == 0x7Du8 {
                                        is_closer = true
                                    }
                                }
                            }
                            if is_closer {
                                if delimiter_depth == 0usize {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 1u8,
                                            expected: 0u8,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                let opener: UInt8 = stack[delimiter_depth - 1usize]
                                var expected: UInt8 = 0u8
                                if opener == 0x28u8 {
                                    expected = 0x29u8
                                } else {
                                    if opener == 0x5Bu8 {
                                        expected = 0x5Du8
                                    } else {
                                        expected = 0x7Du8
                                    }
                                }
                                if symbol != expected {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 3u8,
                                            expected: expected,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: delimiter_depth,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
            }
            source_index = info.end
    }
    if delimiter_depth > 0usize {
                let opener: UInt8 = stack[delimiter_depth - 1usize]
                var expected: UInt8 = 0u8
                if opener == 0x28u8 {
                    expected = 0x29u8
                } else {
                    if opener == 0x5Bu8 {
                        expected = 0x5Du8
                    } else {
                        expected = 0x7Du8
                    }
                }
                if output_capacity > 0usize {
                    output[0] = PatternDiagnosticHeader {
                        kind: 2u8,
                        expected: expected,
                        actual: 0u8,
                        start: first_open_start,
                        end: end,
                        depth: delimiter_depth,
                    }
                    output_index = 1usize
                }
        return output_index
    }
    return output_index
}

/// Executes the complete currently-supported frontend slice through one
/// stable C ABI entry point. The implementation composes the existing Jadren
/// lexer, structural summary, root AST index, function/statement scanners and
/// call-expression scanner. Detailed records stay in caller-owned storage so
/// the same contract is usable by static, dynamic and portable hosts.
@export(name: "jadren_selfhost_compile_frontend_stage2", abi: "C")
@noalloc
pub fn compile_frontend_stage2(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    tokens: write Slice<TokenInfo>,
    ast_items: write Slice<AstItemHeader>,
    function_headers: write Slice<FunctionHeader>,
    statements: write Slice<StatementHeader>,
    calls: write Slice<ExpressionCallHeader>,
) -> FrontendStage2Summary {
    var source_length: UIntSize = 0usize
    for index in bytes.indices {
        source_length = source_length + 1usize
    }
    if start > end {
        return FrontendStage2Summary {
            source_bytes: 0usize,
            tokens_emitted: 0usize,
            ast_items_emitted: 0usize,
            function_headers_emitted: 0usize,
            statements_emitted: 0usize,
            calls_emitted: 0usize,
            syntax_errors: 1usize,
            status_flags: 0usize,
        }
    }
    if end > source_length {
        return FrontendStage2Summary {
            source_bytes: 0usize,
            tokens_emitted: 0usize,
            ast_items_emitted: 0usize,
            function_headers_emitted: 0usize,
            statements_emitted: 0usize,
            calls_emitted: 0usize,
            syntax_errors: 1usize,
            status_flags: 0usize,
        }
    }

    let source_summary: ParseSummary = summarize_source(bytes, start, end)
    let token_count: UIntSize = lex_tokens(bytes, start, end, tokens)
    let ast_item_count: UIntSize = parse_ast_items(bytes, start, end, ast_items)
    let function_header_count: UIntSize = parse_function_headers(
        bytes,
        start,
        end,
        function_headers,
    )
    let statement_count: UIntSize = parse_statements(bytes, start, end, statements)
    let call_count: UIntSize = parse_expression_calls(bytes, start, end, calls)
    var status: UIntSize = 0usize
    if source_summary.errors == 0usize {
        status = 1usize
    }
    if token_count == source_summary.tokens {
        status = status + 2usize
    }
    return FrontendStage2Summary {
        source_bytes: end - start,
        tokens_emitted: token_count,
        ast_items_emitted: ast_item_count,
        function_headers_emitted: function_header_count,
        statements_emitted: statement_count,
        calls_emitted: call_count,
        syntax_errors: source_summary.errors,
        status_flags: status,
    }
}

@noalloc
fn stage2_is_int32_name(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> Bool {
    if end - start != 5usize {
        return false
    }
    if bytes[start] != 0x49u8 {
        return false
    }
    if bytes[start + 1usize] != 0x6Eu8 {
        return false
    }
    if bytes[start + 2usize] != 0x74u8 {
        return false
    }
    if bytes[start + 3usize] != 0x33u8 {
        return false
    }
    return bytes[start + 4usize] == 0x32u8
}

/// Validates the explicit `-> Int32` suffix of one parameter-free function
/// header. Parameter parsing itself remains owned by `FunctionHeader`.
@noalloc
fn stage2_has_int32_result(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Bool {
    var cursor: UIntSize = signature_start
    var saw_dash: Bool = false
    var saw_arrow: Bool = false
    var saw_type: Bool = false
    while cursor < body_start {
        let info: TokenInfo = scan_token_info(bytes, cursor, body_start)
        if info.start >= body_start {
            break
        }
        var symbol: UInt8 = 0u8
        if info.kind == 3u8 {
            symbol = bytes[info.start]
        }
        if !saw_arrow {
            if symbol == 0x2Du8 {
                saw_dash = true
            } else {
                if symbol == 0x3Eu8 {
                    if !saw_dash {
                        return false
                    }
                    saw_arrow = true
                } else {
                    if saw_dash {
                        return false
                    }
                }
            }
        } else {
            if saw_type {
                return false
            }
            if info.kind != 1u8 {
                return false
            }
            if !stage2_is_int32_name(bytes, info.start, info.end) {
                return false
            }
            saw_type = true
        }
        cursor = info.end
    }
    if !saw_arrow {
        return false
    }
    return saw_type
}

@noalloc
fn stage2_invalid_parameter_info() -> Stage2ParameterInfo {
    return Stage2ParameterInfo {
        valid: false,
        count: 0usize,
        name_start: 0usize,
        name_end: 0usize,
        second_name_start: 0usize,
        second_name_end: 0usize,
    }
}

/// Parses exactly one `name: Int32` parameter from the function signature.
/// The return type is checked independently by `stage2_has_int32_result`.
@noalloc
fn stage2_parse_single_i32_parameter(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Stage2ParameterInfo {
    let invalid: Stage2ParameterInfo = stage2_invalid_parameter_info()
    let opening: TokenInfo = scan_token_info(bytes, signature_start, body_start)
    if opening.kind != 3u8 {
        return invalid
    }
    if opening.start >= opening.end {
        return invalid
    }
    if bytes[opening.start] != 0x28u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, opening.end, body_start)
    if name.kind != 1u8 {
        return invalid
    }
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_start)
    if colon.kind != 3u8 {
        return invalid
    }
    if colon.start >= colon.end {
        return invalid
    }
    if bytes[colon.start] != 0x3Au8 {
        return invalid
    }
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_start)
    if type_name.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) {
        return invalid
    }
    let closing: TokenInfo = scan_token_info(bytes, type_name.end, body_start)
    if closing.kind != 3u8 {
        return invalid
    }
    if closing.start >= closing.end {
        return invalid
    }
    if bytes[closing.start] != 0x29u8 {
        return invalid
    }
    return Stage2ParameterInfo {
        valid: true,
        count: 1usize,
        name_start: name.start,
        name_end: name.end,
        second_name_start: 0usize,
        second_name_end: 0usize,
    }
}

@noalloc
fn stage2_parse_pair_i32_parameters(
    bytes: read Slice<UInt8>,
    signature_start: UIntSize,
    body_start: UIntSize,
) -> Stage2ParameterInfo {
    let invalid: Stage2ParameterInfo = stage2_invalid_parameter_info()
    let opening: TokenInfo = scan_token_info(bytes, signature_start, body_start)
    if opening.kind != 3u8 {
        return invalid
    }
    if opening.start >= opening.end {
        return invalid
    }
    if bytes[opening.start] != 0x28u8 {
        return invalid
    }
    let first_name: TokenInfo = scan_token_info(bytes, opening.end, body_start)
    if first_name.kind != 1u8 {
        return invalid
    }
    let first_colon: TokenInfo = scan_token_info(bytes, first_name.end, body_start)
    if first_colon.kind != 3u8 {
        return invalid
    }
    if first_colon.start >= first_colon.end {
        return invalid
    }
    if bytes[first_colon.start] != 0x3Au8 {
        return invalid
    }
    let first_type: TokenInfo = scan_token_info(bytes, first_colon.end, body_start)
    if first_type.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, first_type.start, first_type.end) {
        return invalid
    }
    let comma: TokenInfo = scan_token_info(bytes, first_type.end, body_start)
    if comma.kind != 3u8 {
        return invalid
    }
    if comma.start >= comma.end {
        return invalid
    }
    if bytes[comma.start] != 0x2Cu8 {
        return invalid
    }
    let second_name: TokenInfo = scan_token_info(bytes, comma.end, body_start)
    if second_name.kind != 1u8 {
        return invalid
    }
    let second_colon: TokenInfo = scan_token_info(bytes, second_name.end, body_start)
    if second_colon.kind != 3u8 {
        return invalid
    }
    if second_colon.start >= second_colon.end {
        return invalid
    }
    if bytes[second_colon.start] != 0x3Au8 {
        return invalid
    }
    let second_type: TokenInfo = scan_token_info(bytes, second_colon.end, body_start)
    if second_type.kind != 1u8 {
        return invalid
    }
    if !stage2_is_int32_name(bytes, second_type.start, second_type.end) {
        return invalid
    }
    let closing: TokenInfo = scan_token_info(bytes, second_type.end, body_start)
    if closing.kind != 3u8 {
        return invalid
    }
    if closing.start >= closing.end {
        return invalid
    }
    if bytes[closing.start] != 0x29u8 {
        return invalid
    }
    return Stage2ParameterInfo {
        valid: true,
        count: 2usize,
        name_start: first_name.start,
        name_end: first_name.end,
        second_name_start: second_name.start,
        second_name_end: second_name.end,
    }
}

@noalloc
fn stage2_same_bytes(
    bytes: read Slice<UInt8>,
    first_start: UIntSize,
    first_end: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
) -> Bool {
    if first_end - first_start != second_end - second_start {
        return false
    }
    var first: UIntSize = first_start
    var second: UIntSize = second_start
    while first < first_end {
        if bytes[first] != bytes[second] {
            return false
        }
        first = first + 1usize
        second = second + 1usize
    }
    return true
}

/// Parses one non-negative decimal Int32 literal. `2147483648` is the invalid
/// sentinel and cannot collide with the supported value range.
@noalloc
fn stage2_i32_literal_value(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> UIntSize {
    let invalid: UIntSize = 2147483648usize
    if start >= end {
        return invalid
    }
    var value: UIntSize = 0usize
    var cursor: UIntSize = start
    while cursor < end {
        let byte: UInt8 = bytes[cursor]
        if byte < 0x30u8 {
            return invalid
        }
        if byte > 0x39u8 {
            return invalid
        }
        let digit: UIntSize = byte as UIntSize - 48usize
        if value > 214748364usize {
            return invalid
        }
        if value == 214748364usize {
            if digit > 7usize {
                return invalid
            }
        }
        value = value * 10usize + digit
        cursor = cursor + 1usize
    }
    return value
}

/// Recognizes the first parameter-aware executable slice: `return name op
/// literal;`, where `name` is the one `Int32` parameter from the function
/// header. The parameter is SSA value zero and the literal becomes value one.
@noalloc
fn stage2_invalid_parameter_return_expression() -> Stage2ReturnExpression {
    return Stage2ReturnExpression {
        kind: 0u8,
        grouping_kind: 0u8,
        operator_opcode: 0u8,
        second_operator_opcode: 0u8,
        third_operator_opcode: 0u8,
        fourth_operator_opcode: 0u8,
        left_value: 2147483648usize,
        right_value: 2147483648usize,
        third_value: 2147483648usize,
        fourth_value: 2147483648usize,
        fifth_value: 2147483648usize,
        left_start: 0usize,
        left_end: 0usize,
        right_start: 0usize,
        right_end: 0usize,
        third_start: 0usize,
        third_end: 0usize,
        fourth_start: 0usize,
        fourth_end: 0usize,
        fifth_start: 0usize,
        fifth_end: 0usize,
        group_start: 0usize,
        group_end: 0usize,
        expression_start: 0usize,
        expression_end: 0usize,
        statement_end: 0usize,
    }
}

@noalloc
fn stage2_parse_parameter_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    parameter_name_start: UIntSize,
    parameter_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        name.start,
        name.end,
        parameter_name_start,
        parameter_name_end,
    ) {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, name.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    var operator_opcode: UInt8 = 0u8
    if bytes[operator.start] == 0x2Bu8 {
        operator_opcode = 2u8
    }
    if bytes[operator.start] == 0x2Du8 {
        operator_opcode = 3u8
    }
    if bytes[operator.start] == 0x2Au8 {
        operator_opcode = 4u8
    }
    if operator_opcode == 0u8 {
        return invalid
    }
    let literal: TokenInfo = scan_token_info(bytes, operator.end, end)
    if literal.kind != 2u8 {
        return invalid
    }
    let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
    if value == 2147483648usize {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, literal.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 6u8
    expression.operator_opcode = operator_opcode
    expression.left_value = 0usize
    expression.right_value = value
    expression.left_start = name.start
    expression.left_end = name.end
    expression.right_start = literal.start
    expression.right_end = literal.end
    expression.expression_start = name.start
    expression.expression_end = literal.end
    expression.statement_end = semicolon.end
    return expression
}

/// Recognizes exactly `return name op literal op literal;`. A second multiply
/// is emitted as the right child to preserve ordinary multiplication precedence;
/// all other accepted cases use the left-associative reduction.
@noalloc
fn stage2_parse_parameter_two_node_chain_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    parameter_name_start: UIntSize,
    parameter_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        name.start,
        name.end,
        parameter_name_start,
        parameter_name_end,
    ) {
        return invalid
    }
    let first_operator: TokenInfo = scan_token_info(bytes, name.end, end)
    if first_operator.kind != 3u8 {
        return invalid
    }
    let first_opcode: UInt8 = stage2_binary_opcode(bytes[first_operator.start])
    if first_opcode == 0u8 {
        return invalid
    }
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, end)
    if first_literal.kind != 2u8 {
        return invalid
    }
    let first_value: UIntSize = stage2_i32_literal_value(bytes, first_literal.start, first_literal.end)
    if first_value == 2147483648usize {
        return invalid
    }
    let second_operator: TokenInfo = scan_token_info(bytes, first_literal.end, end)
    if second_operator.kind != 3u8 {
        return invalid
    }
    let second_opcode: UInt8 = stage2_binary_opcode(bytes[second_operator.start])
    if second_opcode == 0u8 {
        return invalid
    }
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, end)
    if second_literal.kind != 2u8 {
        return invalid
    }
    let second_value: UIntSize = stage2_i32_literal_value(bytes, second_literal.start, second_literal.end)
    if second_value == 2147483648usize {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, second_literal.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 10u8
    expression.operator_opcode = first_opcode
    expression.second_operator_opcode = second_opcode
    expression.left_value = 0usize
    expression.right_value = first_value
    expression.third_value = second_value
    expression.left_start = name.start
    expression.left_end = name.end
    expression.right_start = first_literal.start
    expression.right_end = first_literal.end
    expression.third_start = second_literal.start
    expression.third_end = second_literal.end
    expression.expression_start = name.start
    expression.expression_end = second_literal.end
    expression.statement_end = semicolon.end
    return expression
}

/// Recognizes only `return name (+|-) literal * literal (+|-) literal;`. This is a
/// deliberately bounded postorder plan: the multiply is SSA value four, the
/// first add is value five, and the final add or subtract is value six. It does
/// not claim a general parameter-expression parser.
@noalloc
fn stage2_parse_parameter_four_atom_precedence_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    parameter_name_start: UIntSize,
    parameter_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(bytes, name.start, name.end, parameter_name_start, parameter_name_end) {
        return invalid
    }
    let first_operator: TokenInfo = scan_token_info(bytes, name.end, end)
    if first_operator.kind != 3u8 {
        return invalid
    }
    let first_opcode: UInt8 = stage2_binary_opcode(bytes[first_operator.start])
    if first_opcode != 2u8 {
        if first_opcode != 3u8 {
            return invalid
        }
    }
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, end)
    if first_literal.kind != 2u8 {
        return invalid
    }
    let first_value: UIntSize = stage2_i32_literal_value(bytes, first_literal.start, first_literal.end)
    if first_value == 2147483648usize {
        return invalid
    }
    let second_operator: TokenInfo = scan_token_info(bytes, first_literal.end, end)
    if second_operator.kind != 3u8 {
        return invalid
    }
    if stage2_binary_opcode(bytes[second_operator.start]) != 4u8 {
        return invalid
    }
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, end)
    if second_literal.kind != 2u8 {
        return invalid
    }
    let second_value: UIntSize = stage2_i32_literal_value(bytes, second_literal.start, second_literal.end)
    if second_value == 2147483648usize {
        return invalid
    }
    let third_operator: TokenInfo = scan_token_info(bytes, second_literal.end, end)
    if third_operator.kind != 3u8 {
        return invalid
    }
    let third_opcode: UInt8 = stage2_binary_opcode(bytes[third_operator.start])
    if third_opcode != 2u8 {
        if third_opcode != 3u8 {
            return invalid
        }
    }
    let third_literal: TokenInfo = scan_token_info(bytes, third_operator.end, end)
    if third_literal.kind != 2u8 {
        return invalid
    }
    let third_value: UIntSize = stage2_i32_literal_value(bytes, third_literal.start, third_literal.end)
    if third_value == 2147483648usize {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, third_literal.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 11u8
    expression.operator_opcode = first_opcode
    expression.second_operator_opcode = 4u8
    expression.third_operator_opcode = third_opcode
    expression.left_value = 0usize
    expression.right_value = first_value
    expression.third_value = second_value
    expression.fourth_value = third_value
    expression.left_start = name.start
    expression.left_end = name.end
    expression.right_start = first_literal.start
    expression.right_end = first_literal.end
    expression.third_start = second_literal.start
    expression.third_end = second_literal.end
    expression.fourth_start = third_literal.start
    expression.fourth_end = third_literal.end
    expression.expression_start = name.start
    expression.expression_end = third_literal.end
    expression.statement_end = semicolon.end
    return expression
}

/// Recognizes the mirrored bounded parameter slice: `return literal op name;`.
/// The literal remains SSA value one because the declared parameter owns value
/// zero; the binary instruction records the reverse operand order explicitly.
@noalloc
fn stage2_parse_literal_parameter_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    parameter_name_start: UIntSize,
    parameter_name_end: UIntSize,
) -> Stage2ReturnExpression {
    let invalid: Stage2ReturnExpression = stage2_invalid_parameter_return_expression()
    if !parameter_valid {
        return invalid
    }
    let keyword: TokenInfo = scan_token_info(bytes, start, end)
    if keyword.start >= end {
        return invalid
    }
    if statement_kind(bytes, keyword.kind, keyword.start, keyword.end) != 2u8 {
        return invalid
    }
    let literal: TokenInfo = scan_token_info(bytes, keyword.end, end)
    if literal.kind != 2u8 {
        return invalid
    }
    let value: UIntSize = stage2_i32_literal_value(bytes, literal.start, literal.end)
    if value == 2147483648usize {
        return invalid
    }
    let operator: TokenInfo = scan_token_info(bytes, literal.end, end)
    if operator.kind != 3u8 {
        return invalid
    }
    let operator_opcode: UInt8 = stage2_binary_opcode(bytes[operator.start])
    if operator_opcode == 0u8 {
        return invalid
    }
    let name: TokenInfo = scan_token_info(bytes, operator.end, end)
    if name.kind != 1u8 {
        return invalid
    }
    if !stage2_same_bytes(
        bytes,
        name.start,
        name.end,
        parameter_name_start,
        parameter_name_end,
    ) {
        return invalid
    }
    let semicolon: TokenInfo = scan_token_info(bytes, name.end, end)
    if semicolon.kind != 3u8 {
        return invalid
    }
    if semicolon.start >= semicolon.end {
        return invalid
    }
    if bytes[semicolon.start] != 0x3Bu8 {
        return invalid
    }
    let trailing: TokenInfo = scan_token_info(bytes, semicolon.end, end)
    if trailing.start < end {
        return invalid
    }
    var expression: Stage2ReturnExpression = invalid
    expression.kind = 8u8
    expression.operator_opcode = operator_opcode
    expression.left_value = value
    expression.right_value = 0usize
    expression.left_start = literal.start
    expression.left_end = literal.end
    expression.right_start = name.start
    expression.right_end = name.end
    expression.expression_start = literal.start
    expression.expression_end = name.end
    expression.statement_end = semicolon.end
    return expression
}

@noalloc
fn stage2_parse_parameter_pair_return_i32_expression(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    parameter_valid: Bool,
    first_name_start: UIntSize,
    first_name_end: UIntSize,
    second_name_start: UIntSize,
    second_name_end: UIntSize,
) -> Stage2ReturnExpression {
