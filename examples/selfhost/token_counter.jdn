        var first_value: UIntSize = expression.left_value
        var first_start: UIntSize = expression.left_start
        var first_end: UIntSize = expression.left_end
        var parameter_literal_value: UIntSize = parameter_expression.right_value
        var parameter_literal_start: UIntSize = parameter_expression.right_start
        var parameter_literal_end: UIntSize = parameter_expression.right_end
        var parameter_binary_left: UIntSize = 0usize
        var parameter_binary_right: UIntSize = 1usize
        var parameter_pair_binary_left: UIntSize = 0usize
        var parameter_pair_binary_right: UIntSize = 1usize
