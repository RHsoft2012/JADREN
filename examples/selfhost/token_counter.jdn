    if output_capacity > 4usize { output[4] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 2usize, operand_a: local.second_literal_value, operand_b: 0usize, source_start: local.second_literal_start, source_end: local.second_literal_end }; emitted = emitted + 1usize }
    if output_capacity > 5usize { output[5] = Stage2JirRecord { kind: 4u8, opcode: 1u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 3usize, operand_a: local.third_literal_value, operand_b: 0usize, source_start: local.third_literal_start, source_end: local.third_literal_end }; emitted = emitted + 1usize }
    if output_capacity > 6usize { output[6] = Stage2JirRecord { kind: 4u8, opcode: 2u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 4usize, operand_a: 0usize, operand_b: 1usize, source_start: local.first_binary_start, source_end: local.first_binary_end }; emitted = emitted + 1usize }
    if output_capacity > 7usize { output[7] = Stage2JirRecord { kind: 4u8, opcode: 2u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 5usize, operand_a: 4usize, operand_b: 2usize, source_start: local.second_binary_start, source_end: local.second_binary_end }; emitted = emitted + 1usize }
    if output_capacity > 8usize { output[8] = Stage2JirRecord { kind: 4u8, opcode: 2u8, type_kind: 2u8, flags: 0u8, function_index: 0usize, block_index: 0usize, value_index: 6usize, operand_a: 5usize, operand_b: 3usize, source_start: local.third_binary_start, source_end: local.third_binary_end }; emitted = emitted + 1usize }
    if output_capacity > 9usize { output[9] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 4usize, operand_a: local.first_use_start, operand_b: local.first_use_end, source_start: local.first_declaration_start, source_end: local.first_declaration_end }; emitted = emitted + 1usize }
    if output_capacity > 10usize { output[10] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 5usize, operand_a: local.second_use_start, operand_b: local.second_use_end, source_start: local.second_declaration_start, source_end: local.second_declaration_end }; emitted = emitted + 1usize }
    if output_capacity > 11usize { output[11] = Stage2JirRecord { kind: 6u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 6usize, operand_a: local.third_use_start, operand_b: local.third_use_end, source_start: local.third_declaration_start, source_end: local.third_declaration_end }; emitted = emitted + 1usize }
    if output_capacity > 12usize { output[12] = Stage2JirRecord { kind: 5u8, opcode: 1u8, type_kind: 2u8, flags: 1u8, function_index: 0usize, block_index: 0usize, value_index: 6usize, operand_a: 0usize, operand_b: 0usize, source_start: local.return_start, source_end: local.return_end }; emitted = emitted + 1usize }
    var status: UIntSize = 3usize
    if emitted == required { status = 7usize }
    return Stage2JirSummary { functions_seen: 1usize, statements_seen: 1usize, calls_seen: 1usize, records_required: required, records_emitted: emitted, functions_lowered: 1usize, errors: 0usize, status_flags: status }
}

/// Unified bounded local-binding dispatch used by the Stage-2 source driver.
///
/// The host supplies only source bytes, the parser-produced function header
/// table and the caller-owned JIR record buffer.  Variant selection is made
/// inside Jadren by the existing strict parsers; the host no longer inspects
/// source text to choose an emitter.  Status `24` means that the source is a
/// valid bounded function shape but is not one of the admitted immutable-local
/// variants, so the host may fall back to the generic stage-2 emitter.
@export(name: "jadren_selfhost_emit_stage2_local_binding_auto_jir", abi: "C")
pub fn emit_stage2_local_binding_auto_jir(
    bytes: read Slice<UInt8>,
    function_headers: read Slice<FunctionHeader>,
    output: write Slice<Stage2JirRecord>,
) -> Stage2JirSummary {
    var source_length: UIntSize = 0usize
    for source_index in bytes.indices {
        source_length = source_index + 1usize
    }
    var function_count: UIntSize = 0usize
    for function_index in function_headers.indices {
        function_count = function_index + 1usize
    }
    if function_count != 1usize {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 1usize, status_flags: 10usize }
    }
    let shape: Stage2LocalFunctionShape = stage2_find_local_function_shape(bytes, source_length)
    if !shape.valid {
        return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 0usize, status_flags: 24usize }
    }

    let parameter_three: Stage2ParameterThreeLocalBindingInfo = stage2_parse_parameter_three_local_binding(bytes, shape.name_start, shape.name_end, 1usize, shape.body_start, shape.body_end)
    if parameter_three.valid {
        return emit_stage2_parameter_three_local_binding_jir(bytes, function_headers, output)
    }
    let parameter_two: Stage2ParameterTwoLocalBindingInfo = stage2_parse_parameter_two_local_binding(bytes, shape.name_start, shape.name_end, 1usize, shape.body_start, shape.body_end)
    if parameter_two.valid {
        return emit_stage2_parameter_two_local_binding_jir(bytes, function_headers, output)
    }
    let parameter_alias: Stage2LocalBindingInfo = stage2_parse_parameter_alias_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
    if parameter_alias.valid {
        return emit_stage2_parameter_alias_local_binding_jir(bytes, function_headers, output)
    }
    let literal: Stage2LocalBindingInfo = stage2_parse_literal_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
    if literal.valid {
        return emit_stage2_literal_local_binding_jir(bytes, function_headers, output)
    }
    let three_local: Stage2ThreeLocalBindingInfo = stage2_parse_three_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
    if three_local.valid {
        return emit_stage2_three_local_binding_jir(bytes, function_headers, output)
    }
    let two_local: Stage2TwoLocalBindingInfo = stage2_parse_two_local_binding(bytes, shape.name_start, shape.name_end, shape.body_start, shape.body_end)
    if two_local.valid {
        return emit_stage2_two_local_binding_jir(bytes, function_headers, output)
    }
    let local: Stage2LocalBindingInfo = stage2_parse_local_binding(bytes, shape.name_start, shape.name_end, 1usize, shape.body_start, shape.body_end)
    if local.valid {
        return emit_stage2_local_binding_jir(bytes, function_headers, output)
    }
    return Stage2JirSummary { functions_seen: function_count, statements_seen: 0usize, calls_seen: 0usize, records_required: 0usize, records_emitted: 0usize, functions_lowered: 0usize, errors: 0usize, status_flags: 24usize }
}

struct Stage2TypedSequenceSpans {
    valid: Bool,
    let_start: UIntSize,
    let_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
}

/// Source spans for the additive two-local immutable statement slice. The
/// typed AST owns the first literal, the local-to-literal binary expression,
/// and the final local use; these spans only delimit the three statements.
struct Stage2TypedTwoLocalSpans {
    valid: Bool,
    first_let_start: UIntSize,
    first_let_end: UIntSize,
    second_let_start: UIntSize,
    second_let_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
}

/// Source spans for the first native-producer mutable-local hand-off.  This
/// deliberately admits one parameterless mutable `let`, one assignment and one
/// return; the typed AST carries the real expression roots and the Rust
/// Stage-2 lowerer materialises StackAlloc/Load/Store for it.
struct Stage2TypedAssignmentSpans {
    valid: Bool,
    declaration_statement_start: UIntSize,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    initializer_start: UIntSize,
    initializer_end: UIntSize,
    assign_start: UIntSize,
    assign_end: UIntSize,
    assign_target_end: UIntSize,
    assign_use_start: UIntSize,
    assign_use_end: UIntSize,
    assign_literal_start: UIntSize,
    assign_literal_end: UIntSize,
    assign_binary_start: UIntSize,
    assign_binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

/// Source spans for the first native-producer conditional hand-off. The
/// producer accepts one parameterless function whose body returns a bounded
/// `if Int32 { Int32 } else { Int32 }` expression. The typed AST keeps the
/// comparison and both branch literals separate so Stage-2 owns CFG lowering.
struct Stage2TypedIfReturnSpans {
    valid: Bool,
    if_start: UIntSize,
    if_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    then_start: UIntSize,
    then_end: UIntSize,
    else_start: UIntSize,
    else_end: UIntSize,
}

/// Source spans for one immutable local initialized from a bounded `if` value
/// and consumed by one post-join binary continuation. This is deliberately a
/// single statement shape; it is not a general local/statement parser.
struct Stage2TypedIfValueContinuationSpans {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    if_start: UIntSize,
    if_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    then_start: UIntSize,
    then_end: UIntSize,
    else_start: UIntSize,
    else_end: UIntSize,
    continuation_start: UIntSize,
    continuation_end: UIntSize,
    continuation_name_end: UIntSize,
    continuation_literal_start: UIntSize,
    continuation_literal_end: UIntSize,
}

/// Source spans for one mutable local initialized from a bounded `if` value
/// and updated by one post-join `value = value + literal` assignment.  The
/// parser deliberately accepts only this exact shape; the Rust consumer owns
/// the StackAlloc/Load/Store lowering and the capture remains caller-owned.
struct Stage2TypedIfValueLocalAssignmentSpans {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    if_start: UIntSize,
    if_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    then_start: UIntSize,
    then_end: UIntSize,
    else_start: UIntSize,
    else_end: UIntSize,
    assignment_start: UIntSize,
    assignment_end: UIntSize,
    assignment_use_start: UIntSize,
    assignment_use_end: UIntSize,
    assignment_literal_start: UIntSize,
    assignment_literal_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_if_value_local_assignment_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedIfValueLocalAssignmentSpans {
    let invalid: Stage2TypedIfValueLocalAssignmentSpans = Stage2TypedIfValueLocalAssignmentSpans {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        if_start: 0usize,
        if_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        then_start: 0usize,
        then_end: 0usize,
        else_start: 0usize,
        else_end: 0usize,
        assignment_start: 0usize,
        assignment_end: 0usize,
        assignment_use_start: 0usize,
        assignment_use_end: 0usize,
        assignment_literal_start: 0usize,
        assignment_literal_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let mut_token: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, mut_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let if_token: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, if_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let then_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let then_literal: TokenInfo = scan_token_info(bytes, then_open.end, body_end_exclusive)
    let then_close: TokenInfo = scan_token_info(bytes, then_literal.end, body_end_exclusive)
    let else_keyword: TokenInfo = scan_token_info(bytes, then_close.end, body_end_exclusive)
    let else_open: TokenInfo = scan_token_info(bytes, else_keyword.end, body_end_exclusive)
    let else_literal: TokenInfo = scan_token_info(bytes, else_open.end, body_end_exclusive)
    let else_close: TokenInfo = scan_token_info(bytes, else_literal.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, else_close.end, body_end_exclusive)
    let assignment_target: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let assignment_equals: TokenInfo = scan_token_info(bytes, assignment_target.end, body_end_exclusive)
    let assignment_use: TokenInfo = scan_token_info(bytes, assignment_equals.end, body_end_exclusive)
    let assignment_operator: TokenInfo = scan_token_info(bytes, assignment_use.end, body_end_exclusive)
    let assignment_literal: TokenInfo = scan_token_info(bytes, assignment_operator.end, body_end_exclusive)
    let assignment_tail: TokenInfo = scan_token_info(bytes, assignment_literal.end, body_end_exclusive)
    let return_keyword: TokenInfo = scan_token_info(bytes, assignment_tail.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if mut_token.kind != 1u8 { return invalid }
    if mut_token.end - mut_token.start != 3usize { return invalid }
    if bytes[mut_token.start] != 0x6Du8 { return invalid }
    if bytes[mut_token.start + 1usize] != 0x75u8 { return invalid }
    if bytes[mut_token.start + 2usize] != 0x74u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if if_token.kind != 1u8 { return invalid }
    if if_token.end - if_token.start != 2usize { return invalid }
    if bytes[if_token.start] != 0x69u8 { return invalid }
    if bytes[if_token.start + 1usize] != 0x66u8 { return invalid }
    if condition_left.kind != 2u8 { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Eu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if then_open.kind != 3u8 { return invalid }
    if bytes[then_open.start] != 0x7Bu8 { return invalid }
    if then_literal.kind != 2u8 { return invalid }
    if then_close.kind != 3u8 { return invalid }
    if bytes[then_close.start] != 0x7Du8 { return invalid }
    if else_keyword.kind != 1u8 { return invalid }
    if else_keyword.end - else_keyword.start != 4usize { return invalid }
    if bytes[else_keyword.start] != 0x65u8 { return invalid }
    if bytes[else_keyword.start + 1usize] != 0x6Cu8 { return invalid }
    if bytes[else_keyword.start + 2usize] != 0x73u8 { return invalid }
    if bytes[else_keyword.start + 3usize] != 0x65u8 { return invalid }
    if else_open.kind != 3u8 { return invalid }
    if bytes[else_open.start] != 0x7Bu8 { return invalid }
    if else_literal.kind != 2u8 { return invalid }
    if else_close.kind != 3u8 { return invalid }
    if bytes[else_close.start] != 0x7Du8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if assignment_target.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, assignment_target.start, assignment_target.end) { return invalid }
    if assignment_equals.kind != 3u8 { return invalid }
    if bytes[assignment_equals.start] != 0x3Du8 { return invalid }
    if assignment_use.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, assignment_use.start, assignment_use.end) { return invalid }
    if assignment_operator.kind != 3u8 { return invalid }
    if bytes[assignment_operator.start] != 0x2Bu8 { return invalid }
    if assignment_literal.kind != 2u8 { return invalid }
    if assignment_tail.kind != 3u8 { return invalid }
    if bytes[assignment_tail.start] != 0x3Bu8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedIfValueLocalAssignmentSpans {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        if_start: if_token.start,
        if_end: else_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        then_start: then_literal.start,
        then_end: then_literal.end,
        else_start: else_literal.start,
        else_end: else_literal.end,
        assignment_start: assignment_target.start,
        assignment_end: assignment_tail.end,
        assignment_use_start: assignment_use.start,
        assignment_use_end: assignment_use.end,
        assignment_literal_start: assignment_literal.start,
        assignment_literal_end: assignment_literal.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

/// Source spans for a bounded multi-statement tail. It shares the same
/// mutable `if` merge prefix as the local-assignment hand-off, then admits two
/// assignments and a final return so Stage-2 can consume the generic
/// `TypedStatementHeader` slice.
struct Stage2TypedIfValueStatementTailSpans {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    if_start: UIntSize,
    if_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    then_start: UIntSize,
    then_end: UIntSize,
    else_start: UIntSize,
    else_end: UIntSize,
    first_start: UIntSize,
    first_end: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    second_start: UIntSize,
    second_end: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

fn stage2_parse_typed_if_value_statement_tail_spans(
    bytes: read Slice<UInt8>,
    body_start: UIntSize,
    body_end: UIntSize,
) -> Stage2TypedIfValueStatementTailSpans {
    let invalid: Stage2TypedIfValueStatementTailSpans = Stage2TypedIfValueStatementTailSpans {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        if_start: 0usize,
        if_end: 0usize,
        condition_left_start: 0usize,
        condition_left_end: 0usize,
        condition_right_start: 0usize,
        condition_right_end: 0usize,
        then_start: 0usize,
        then_end: 0usize,
        else_start: 0usize,
        else_end: 0usize,
        first_start: 0usize,
        first_end: 0usize,
        first_use_start: 0usize,
        first_use_end: 0usize,
        first_literal_start: 0usize,
        first_literal_end: 0usize,
        second_start: 0usize,
        second_end: 0usize,
        second_use_start: 0usize,
        second_use_end: 0usize,
        second_literal_start: 0usize,
        second_literal_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
        return_use_start: 0usize,
        return_use_end: 0usize,
    }
    if body_end <= body_start + 1usize { return invalid }
    let body_end_exclusive: UIntSize = body_end - 1usize
    let let_token: TokenInfo = scan_token_info(bytes, body_start + 1usize, body_end_exclusive)
    let mut_token: TokenInfo = scan_token_info(bytes, let_token.end, body_end_exclusive)
    let name: TokenInfo = scan_token_info(bytes, mut_token.end, body_end_exclusive)
    let colon: TokenInfo = scan_token_info(bytes, name.end, body_end_exclusive)
    let type_name: TokenInfo = scan_token_info(bytes, colon.end, body_end_exclusive)
    let equals: TokenInfo = scan_token_info(bytes, type_name.end, body_end_exclusive)
    let if_token: TokenInfo = scan_token_info(bytes, equals.end, body_end_exclusive)
    let condition_left: TokenInfo = scan_token_info(bytes, if_token.end, body_end_exclusive)
    let condition_operator: TokenInfo = scan_token_info(bytes, condition_left.end, body_end_exclusive)
    let condition_right: TokenInfo = scan_token_info(bytes, condition_operator.end, body_end_exclusive)
    let then_open: TokenInfo = scan_token_info(bytes, condition_right.end, body_end_exclusive)
    let then_literal: TokenInfo = scan_token_info(bytes, then_open.end, body_end_exclusive)
    let then_close: TokenInfo = scan_token_info(bytes, then_literal.end, body_end_exclusive)
    let else_keyword: TokenInfo = scan_token_info(bytes, then_close.end, body_end_exclusive)
    let else_open: TokenInfo = scan_token_info(bytes, else_keyword.end, body_end_exclusive)
    let else_literal: TokenInfo = scan_token_info(bytes, else_open.end, body_end_exclusive)
    let else_close: TokenInfo = scan_token_info(bytes, else_literal.end, body_end_exclusive)
    let declaration_tail: TokenInfo = scan_token_info(bytes, else_close.end, body_end_exclusive)
    let first_target: TokenInfo = scan_token_info(bytes, declaration_tail.end, body_end_exclusive)
    let first_equals: TokenInfo = scan_token_info(bytes, first_target.end, body_end_exclusive)
    let first_use: TokenInfo = scan_token_info(bytes, first_equals.end, body_end_exclusive)
    let first_operator: TokenInfo = scan_token_info(bytes, first_use.end, body_end_exclusive)
    let first_literal: TokenInfo = scan_token_info(bytes, first_operator.end, body_end_exclusive)
    let first_tail: TokenInfo = scan_token_info(bytes, first_literal.end, body_end_exclusive)
    let second_target: TokenInfo = scan_token_info(bytes, first_tail.end, body_end_exclusive)
    let second_equals: TokenInfo = scan_token_info(bytes, second_target.end, body_end_exclusive)
    let second_use: TokenInfo = scan_token_info(bytes, second_equals.end, body_end_exclusive)
    let second_operator: TokenInfo = scan_token_info(bytes, second_use.end, body_end_exclusive)
    let second_literal: TokenInfo = scan_token_info(bytes, second_operator.end, body_end_exclusive)
    let second_tail: TokenInfo = scan_token_info(bytes, second_literal.end, body_end_exclusive)
    let return_keyword: TokenInfo = scan_token_info(bytes, second_tail.end, body_end_exclusive)
    let return_name: TokenInfo = scan_token_info(bytes, return_keyword.end, body_end_exclusive)
    let return_tail: TokenInfo = scan_token_info(bytes, return_name.end, body_end_exclusive)
    if let_token.kind != 1u8 { return invalid }
    if let_token.end - let_token.start != 3usize { return invalid }
    if bytes[let_token.start] != 0x6Cu8 { return invalid }
    if bytes[let_token.start + 1usize] != 0x65u8 { return invalid }
    if bytes[let_token.start + 2usize] != 0x74u8 { return invalid }
    if mut_token.kind != 1u8 { return invalid }
    if mut_token.end - mut_token.start != 3usize { return invalid }
    if bytes[mut_token.start] != 0x6Du8 { return invalid }
    if bytes[mut_token.start + 1usize] != 0x75u8 { return invalid }
    if bytes[mut_token.start + 2usize] != 0x74u8 { return invalid }
    if name.kind != 1u8 { return invalid }
    if colon.kind != 3u8 { return invalid }
    if type_name.kind != 1u8 { return invalid }
    if !stage2_is_int32_name(bytes, type_name.start, type_name.end) { return invalid }
    if equals.kind != 3u8 { return invalid }
    if bytes[equals.start] != 0x3Du8 { return invalid }
    if if_token.kind != 1u8 { return invalid }
    if if_token.end - if_token.start != 2usize { return invalid }
    if bytes[if_token.start] != 0x69u8 { return invalid }
    if bytes[if_token.start + 1usize] != 0x66u8 { return invalid }
    if condition_left.kind != 2u8 { return invalid }
    if condition_operator.kind != 3u8 { return invalid }
    if bytes[condition_operator.start] != 0x3Eu8 { return invalid }
    if condition_right.kind != 2u8 { return invalid }
    if then_open.kind != 3u8 { return invalid }
    if bytes[then_open.start] != 0x7Bu8 { return invalid }
    if then_literal.kind != 2u8 { return invalid }
    if then_close.kind != 3u8 { return invalid }
    if bytes[then_close.start] != 0x7Du8 { return invalid }
    if else_keyword.kind != 1u8 { return invalid }
    if else_keyword.end - else_keyword.start != 4usize { return invalid }
    if bytes[else_keyword.start] != 0x65u8 { return invalid }
    if bytes[else_keyword.start + 1usize] != 0x6Cu8 { return invalid }
    if bytes[else_keyword.start + 2usize] != 0x73u8 { return invalid }
    if bytes[else_keyword.start + 3usize] != 0x65u8 { return invalid }
    if else_open.kind != 3u8 { return invalid }
    if bytes[else_open.start] != 0x7Bu8 { return invalid }
    if else_literal.kind != 2u8 { return invalid }
    if else_close.kind != 3u8 { return invalid }
    if bytes[else_close.start] != 0x7Du8 { return invalid }
    if declaration_tail.kind != 3u8 { return invalid }
    if bytes[declaration_tail.start] != 0x3Bu8 { return invalid }
    if first_target.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, first_target.start, first_target.end) { return invalid }
    if first_equals.kind != 3u8 { return invalid }
    if bytes[first_equals.start] != 0x3Du8 { return invalid }
    if first_use.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, first_use.start, first_use.end) { return invalid }
    if first_operator.kind != 3u8 { return invalid }
    if bytes[first_operator.start] != 0x2Bu8 { return invalid }
    if first_literal.kind != 2u8 { return invalid }
    if first_tail.kind != 3u8 { return invalid }
    if bytes[first_tail.start] != 0x3Bu8 { return invalid }
    if second_target.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, second_target.start, second_target.end) { return invalid }
    if second_equals.kind != 3u8 { return invalid }
    if bytes[second_equals.start] != 0x3Du8 { return invalid }
    if second_use.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, second_use.start, second_use.end) { return invalid }
    if second_operator.kind != 3u8 { return invalid }
    if bytes[second_operator.start] != 0x2Bu8 { return invalid }
    if second_literal.kind != 2u8 { return invalid }
    if second_tail.kind != 3u8 { return invalid }
    if bytes[second_tail.start] != 0x3Bu8 { return invalid }
    if return_keyword.kind != 1u8 { return invalid }
    if return_keyword.end - return_keyword.start != 6usize { return invalid }
    if bytes[return_keyword.start] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 1usize] != 0x65u8 { return invalid }
    if bytes[return_keyword.start + 2usize] != 0x74u8 { return invalid }
    if bytes[return_keyword.start + 3usize] != 0x75u8 { return invalid }
    if bytes[return_keyword.start + 4usize] != 0x72u8 { return invalid }
    if bytes[return_keyword.start + 5usize] != 0x6Eu8 { return invalid }
    if return_name.kind != 1u8 { return invalid }
    if !stage2_same_ascii(bytes, name.start, name.end, return_name.start, return_name.end) { return invalid }
    if return_tail.kind != 3u8 { return invalid }
    if bytes[return_tail.start] != 0x3Bu8 { return invalid }
    let trailing: TokenInfo = scan_token_info(bytes, return_tail.end, body_end_exclusive)
    if trailing.start < body_end_exclusive { return invalid }
    return Stage2TypedIfValueStatementTailSpans {
        valid: true,
        declaration_start: name.start,
        declaration_end: name.end,
        if_start: if_token.start,
        if_end: else_close.end,
        condition_left_start: condition_left.start,
        condition_left_end: condition_left.end,
        condition_right_start: condition_right.start,
        condition_right_end: condition_right.end,
        then_start: then_literal.start,
        then_end: then_literal.end,
        else_start: else_literal.start,
        else_end: else_literal.end,
        first_start: first_target.start,
        first_end: first_tail.end,
        first_use_start: first_use.start,
        first_use_end: first_use.end,
        first_literal_start: first_literal.start,
        first_literal_end: first_literal.end,
        second_start: second_target.start,
        second_end: second_tail.end,
        second_use_start: second_use.start,
        second_use_end: second_use.end,
        second_literal_start: second_literal.start,
        second_literal_end: second_literal.end,
        return_start: return_keyword.start,
        return_end: return_tail.end,
        return_use_start: return_name.start,
        return_use_end: return_name.end,
    }
}

/// Source spans for the dynamic native-producer `while` hand-off. The body is
/// an allocation-free caller-owned list of one or more `counter = counter +
/// literal;` assignments; the parser counts and re-scans it instead of fixing
/// the statement count in the ABI.
struct Stage2TypedWhileDynamicSpans {
    valid: Bool,
    body_count: UIntSize,
    ast_nodes_required: UIntSize,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    initializer_start: UIntSize,
    initializer_end: UIntSize,
    while_start: UIntSize,
    while_end: UIntSize,
    condition_left_start: UIntSize,
    condition_left_end: UIntSize,
    condition_right_start: UIntSize,
    condition_right_end: UIntSize,
    loop_body_start: UIntSize,
    loop_body_end: UIntSize,
    body_start: UIntSize,
    body_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    return_use_start: UIntSize,
    return_use_end: UIntSize,
}

struct Stage2TypedWhileDynamicBodySpan {
    valid: Bool,
    kind: UInt8,
    start: UIntSize,
    end: UIntSize,
    target_start: UIntSize,
    target_end: UIntSize,
    expression_left_start: UIntSize,
    expression_left_end: UIntSize,
    expression_middle_start: UIntSize,
    expression_middle_end: UIntSize,
    expression_middle_kind: UInt8,
    expression_right_start: UIntSize,
    expression_right_end: UIntSize,
    expression_right_kind: UInt8,
    expression_node_count: UIntSize,
    next_cursor: UIntSize,
}

/// Result of the bounded precedence-aware typed assignment emitter. The
/// expression parser below accepts up to four scalar operands and three
/// arithmetic operators; the caller-owned AST remains post-order and the
/// existing typed node ABI is unchanged.
struct Stage2TypedExpressionEmission {
    valid: Bool,
    node_count: UIntSize,
    root_node: UIntSize,
}

fn stage2_invalid_typed_expression_emission() -> Stage2TypedExpressionEmission {
    return Stage2TypedExpressionEmission { valid: false, node_count: 0usize, root_node: 0usize }
}

@noalloc
fn stage2_has_two_group_shape(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
) -> Bool {
    let first_open: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
    if first_open.kind != 3u8 { return false }
    if bytes[first_open.start] != 0x28u8 { return false }
    let first_left: TokenInfo = scan_token_info(bytes, first_open.end, expression_end)
    let first_operator: TokenInfo = scan_stage2_operator_info(bytes, first_left.end, expression_end)
    let first_right: TokenInfo = scan_token_info(bytes, first_operator.end, expression_end)
    let first_close: TokenInfo = scan_token_info(bytes, first_right.end, expression_end)
    let outer_operator: TokenInfo = scan_stage2_operator_info(bytes, first_close.end, expression_end)
    let second_open: TokenInfo = scan_token_info(bytes, outer_operator.end, expression_end)
    if second_open.kind != 3u8 { return false }
    return bytes[second_open.start] == 0x28u8
}

@noalloc
fn stage2_has_nested_left_group_shape(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
) -> Bool {
    let outer_open: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
    if outer_open.kind != 3u8 { return false }
    if bytes[outer_open.start] != 0x28u8 { return false }
    let nested_open: TokenInfo = scan_token_info(bytes, outer_open.end, expression_end)
    if nested_open.kind != 3u8 { return false }
    if bytes[nested_open.start] != 0x28u8 { return false }
    let nested_left: TokenInfo = scan_token_info(bytes, nested_open.end, expression_end)
    let nested_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_left.end, expression_end)
    let nested_right: TokenInfo = scan_token_info(bytes, nested_operator.end, expression_end)
    let nested_close: TokenInfo = scan_token_info(bytes, nested_right.end, expression_end)
    let outer_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_close.end, expression_end)
    let outer_right: TokenInfo = scan_token_info(bytes, outer_operator.end, expression_end)
    let outer_close: TokenInfo = scan_token_info(bytes, outer_right.end, expression_end)
    let final_operator: TokenInfo = scan_stage2_operator_info(bytes, outer_close.end, expression_end)
    let final_right: TokenInfo = scan_token_info(bytes, final_operator.end, expression_end)
    if nested_left.kind != 1u8 { if nested_left.kind != 2u8 { return false } }
    if nested_right.kind != 1u8 { if nested_right.kind != 2u8 { return false } }
    if outer_right.kind != 1u8 { if outer_right.kind != 2u8 { return false } }
    if final_right.kind != 1u8 { if final_right.kind != 2u8 { return false } }
    if nested_operator.kind != 3u8 { return false }
    if outer_operator.kind != 3u8 { return false }
    if final_operator.kind != 3u8 { return false }
    if bytes[nested_operator.start] != 0x2Bu8 {
        if bytes[nested_operator.start] != 0x2Du8 {
            if bytes[nested_operator.start] != 0x2Au8 { return false }
        }
    }
    if bytes[outer_operator.start] != 0x2Bu8 {
        if bytes[outer_operator.start] != 0x2Du8 {
            if bytes[outer_operator.start] != 0x2Au8 { return false }
        }
    }
    if bytes[final_operator.start] != 0x2Bu8 {
        if bytes[final_operator.start] != 0x2Du8 {
            if bytes[final_operator.start] != 0x2Au8 { return false }
        }
    }
    if nested_close.kind != 3u8 { return false }
    if bytes[nested_close.start] != 0x29u8 { return false }
    if outer_close.kind != 3u8 { return false }
    if bytes[outer_close.start] != 0x29u8 { return false }
    if final_right.end == expression_end { return true }
    let tail: TokenInfo = scan_token_info(bytes, final_right.end, expression_end)
    if tail.kind != 3u8 { return false }
    return bytes[tail.start] == 0x3Bu8
}

/// Adapts the existing generic expression parser to the bounded native
/// assignment hand-off.  The caller-owned typed AST keeps the same post-order
/// indices; this bridge only admits Int32 scalar arithmetic, groups and unary
/// +/- and caps the generic stream at 64 nodes.  The underlying parser already
/// exposes 64 operator slots; the adapter keeps the same bounded width.
@noalloc
fn stage2_emit_generic_typed_int32_expression(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
    ast: write Slice<TypedExpressionAstNodeHeader>,
    ast_capacity: UIntSize,
    ast_cursor: UIntSize,
) -> Stage2TypedExpressionEmission {
    let invalid: Stage2TypedExpressionEmission = stage2_invalid_typed_expression_emission()
    if expression_start >= expression_end { return invalid }
    var generic_ast: [ExpressionAstNodeHeader; 64] = [
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
        ExpressionAstNodeHeader { kind: 0u8, opcode: 0u8, flags: 0u8, reserved: 0u8, left: 0usize, right: 0usize, aux: 0usize, start: 0usize, end: 0usize },
    ]
    let required: UIntSize = parse_expression_ast_nodes(bytes, expression_start, expression_end, generic_ast)
    if required == 0usize { return invalid }
    if required > 64usize { return invalid }
    var node_index: UIntSize = 0usize
    while node_index < required {
        let node_kind: UInt8 = generic_ast[node_index].kind
        let node_left: UIntSize = generic_ast[node_index].left
        let node_right: UIntSize = generic_ast[node_index].right
        let node_start: UIntSize = generic_ast[node_index].start
        let node_end: UIntSize = generic_ast[node_index].end
        let node_aux: UIntSize = generic_ast[node_index].aux
        if node_kind == 1u8 {
            if node_start >= node_end { return invalid }
        } else if node_kind == 2u8 {
            if node_start >= node_end { return invalid }
        } else if node_kind == 3u8 {
            if node_left >= node_index { return invalid }
            if node_start >= node_end { return invalid }
            if bytes[node_end - 1usize] != 0x29u8 { return invalid }
        } else if node_kind == 5u8 {
            // The first dynamic-control call slice is deliberately bounded:
            // one identifier callee and one or two positional Int32
            // arguments. An argument may be a scalar leaf, arithmetic AST
            // subtree, or one nested call. The caller supplies
            // signature/argument headers after capture.
            if node_left >= node_index { return invalid }
            if generic_ast[node_left].kind != 1u8 { return invalid }
            if node_aux == 0usize { return invalid }
            if node_aux > 2usize { return invalid }
            if node_right >= node_index { return invalid }
        } else if node_kind == 6u8 {
            if node_left >= node_index { return invalid }
        } else if node_kind == 7u8 {
            if node_left >= node_index { return invalid }
            if node_right >= node_index { return invalid }
        } else {
            return invalid
        }
        let emitted_start: UIntSize = if node_index + 1usize == required { expression_start } else { node_start }
        let emitted_end: UIntSize = if node_index + 1usize == required { expression_end } else { node_end }
        if ast_capacity > ast_cursor + node_index {
            ast[ast_cursor + node_index] = TypedExpressionAstNodeHeader {
                syntax_kind: node_kind,
                type_kind: 2u8,
                flags: 1u8,
                reserved: 0u8,
                left: ast_cursor + node_left,
                right: ast_cursor + node_right,
                aux: node_aux,
                start: emitted_start,
                end: emitted_end,
            }
        }
        node_index = node_index + 1usize
    }
    return Stage2TypedExpressionEmission {
        valid: true,
        node_count: required,
        root_node: ast_cursor + required - 1usize,
    }
}

@noalloc
fn stage2_find_expression_semicolon(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    body_end: UIntSize,
) -> UIntSize {
    var cursor: UIntSize = expression_start
    var delimiter_depth: UIntSize = 0usize
    while cursor < body_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, body_end)
        if token.start >= body_end { break }
        if token.kind == 3u8 {
            let symbol: UInt8 = bytes[token.start]
            if symbol == 0x28u8 { delimiter_depth = delimiter_depth + 1usize }
            if symbol == 0x5Bu8 { delimiter_depth = delimiter_depth + 1usize }
            if symbol == 0x29u8 {
                if delimiter_depth == 0usize { return 0usize }
                delimiter_depth = delimiter_depth - 1usize
            }
            if symbol == 0x5Du8 {
                if delimiter_depth == 0usize { return 0usize }
                delimiter_depth = delimiter_depth - 1usize
            }
            if symbol == 0x3Bu8 {
                if delimiter_depth == 0usize { return token.start }
            }
        }
        cursor = token.end
    }
    return 0usize
}

@noalloc
@noalloc
fn stage2_is_int32_expression_leaf(kind: UInt8) -> Bool {
    if kind == 1u8 { return true }
    if kind == 2u8 { return true }
    return false
}

@noalloc
fn stage2_count_dynamic_nested_call_argument(
    bytes: read Slice<UInt8>,
    argument_start: UIntSize,
    expression_end: UIntSize,
) -> UIntSize {
    // Bounded second-level call shape used by the dynamic while hand-off:
    // `callee(scalar, scalar)`.  The generic AST parser owns the full tree;
    // this helper only supplies the sizing pass with the exact four nodes
    // (callee, two leaves, call) so the caller-owned buffers stay sized.
    let callee: TokenInfo = scan_token_info(bytes, argument_start, expression_end)
    let open: TokenInfo = scan_token_info(bytes, callee.end, expression_end)
    let first: TokenInfo = scan_token_info(bytes, open.end, expression_end)
    let comma: TokenInfo = scan_token_info(bytes, first.end, expression_end)
    let second: TokenInfo = scan_token_info(bytes, comma.end, expression_end)
    let close: TokenInfo = scan_token_info(bytes, second.end, expression_end)
    let outer_close: TokenInfo = scan_token_info(bytes, close.end, expression_end)
    if callee.kind != 1u8 { return 0usize }
    if open.kind != 3u8 { return 0usize }
    if bytes[open.start] != 0x28u8 { return 0usize }
    if !stage2_is_int32_expression_leaf(first.kind) { return 0usize }
    if comma.kind != 3u8 { return 0usize }
    if bytes[comma.start] != 0x2Cu8 { return 0usize }
    if !stage2_is_int32_expression_leaf(second.kind) { return 0usize }
    if close.kind != 3u8 { return 0usize }
    if bytes[close.start] != 0x29u8 { return 0usize }
    // The nested call is the second argument of an outer call, therefore its
    // close delimiter is followed by the outer call close delimiter.
    if outer_close.kind != 3u8 { return 0usize }
    if bytes[outer_close.start] != 0x29u8 { return 0usize }
    if outer_close.end != expression_end { return 0usize }
    return 4usize
}

@noalloc
fn stage2_count_dynamic_call_argument(
    bytes: read Slice<UInt8>,
    argument_start: UIntSize,
    expression_end: UIntSize,
) -> UIntSize {
    let nested_count: UIntSize = stage2_count_dynamic_nested_call_argument(bytes, argument_start, expression_end)
    if nested_count > 0usize { return nested_count }
    let left: TokenInfo = scan_token_info(bytes, argument_start, expression_end)
    let operator: TokenInfo = scan_token_info(bytes, left.end, expression_end)
    if !stage2_is_int32_expression_leaf(left.kind) { return 0usize }
    if operator.kind == 3u8 {
        if stage2_binary_opcode(bytes[operator.start]) != 0u8 {
            let right: TokenInfo = scan_token_info(bytes, operator.end, expression_end)
            if stage2_is_int32_expression_leaf(right.kind) {
                return 3usize
            }
        }
    }
    return 1usize
}

@noalloc
fn stage2_count_dynamic_binary_call_argument(
    bytes: read Slice<UInt8>,
    argument_start: UIntSize,
    expression_end: UIntSize,
) -> UIntSize {
    let first_count: UIntSize = stage2_count_dynamic_call_argument(bytes, argument_start, expression_end)
    if first_count == 0usize { return 0usize }
    let first: TokenInfo = scan_token_info(bytes, argument_start, expression_end)
    let first_separator: TokenInfo = if first_count == 3usize {
        let first_operator: TokenInfo = scan_token_info(bytes, first.end, expression_end)
        let first_right: TokenInfo = scan_token_info(bytes, first_operator.end, expression_end)
        scan_token_info(bytes, first_right.end, expression_end)
    } else {
        scan_token_info(bytes, first.end, expression_end)
    }
    if first_separator.kind != 3u8 { return 0usize }
    if bytes[first_separator.start] != 0x2Cu8 { return 0usize }
    let second_count: UIntSize = stage2_count_dynamic_call_argument(bytes, first_separator.end, expression_end)
    if second_count == 0usize { return 0usize }
    let second: TokenInfo = scan_token_info(bytes, first_separator.end, expression_end)
    let second_close: TokenInfo = if second_count == 3usize {
        let second_operator: TokenInfo = scan_token_info(bytes, second.end, expression_end)
        let second_right: TokenInfo = scan_token_info(bytes, second_operator.end, expression_end)
        scan_token_info(bytes, second_right.end, expression_end)
    } else if second_count == 4usize {
        let second_open: TokenInfo = scan_token_info(bytes, second.end, expression_end)
        let second_first: TokenInfo = scan_token_info(bytes, second_open.end, expression_end)
        let second_comma: TokenInfo = scan_token_info(bytes, second_first.end, expression_end)
        let second_right: TokenInfo = scan_token_info(bytes, second_comma.end, expression_end)
        let nested_close: TokenInfo = scan_token_info(bytes, second_right.end, expression_end)
        scan_token_info(bytes, nested_close.end, expression_end)
    } else {
        scan_token_info(bytes, second.end, expression_end)
    }
    if second_close.kind != 3u8 { return 0usize }
    if bytes[second_close.start] != 0x29u8 { return 0usize }
    if second_close.end != expression_end { return 0usize }
    return first_count + second_count + 2usize
}

@noalloc
fn stage2_count_dynamic_direct_call_expression(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
) -> UIntSize {
    // Keep the assignment-call sizing path explicit.  The generic expression
    // parser already emits the same post-order call AST, but this bounded
    // probe makes the producer accept a direct `callee(scalar, scalar)` RHS
    // before it reaches the legacy arithmetic recognizers.
    let callee: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
    let open: TokenInfo = scan_token_info(bytes, callee.end, expression_end)
    let first: TokenInfo = scan_token_info(bytes, open.end, expression_end)
    let comma: TokenInfo = scan_token_info(bytes, first.end, expression_end)
    let second: TokenInfo = scan_token_info(bytes, comma.end, expression_end)
    let close: TokenInfo = scan_token_info(bytes, second.end, expression_end)
    if callee.kind != 1u8 { return 0usize }
    if open.kind != 3u8 { return 0usize }
    if bytes[open.start] != 0x28u8 { return 0usize }
    if !stage2_is_int32_expression_leaf(first.kind) { return 0usize }
    if comma.kind != 3u8 { return 0usize }
    if bytes[comma.start] != 0x2Cu8 { return 0usize }
    if !stage2_is_int32_expression_leaf(second.kind) { return 0usize }
    if close.kind != 3u8 { return 0usize }
    if bytes[close.start] != 0x29u8 { return 0usize }
    if close.end != expression_end { return 0usize }
    return 4usize
}

fn stage2_count_generic_int32_expression(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
) -> UIntSize {
    // Keep call counting in lock-step with the generic AST adapter. The
    // current dynamic-control hand-off admits exactly
    // `identifier(name|literal)` or
    // `identifier(binary(name|literal, name|literal),
    // name|literal|binary(name|literal, name|literal)|call(...))`;
    // argument metadata is emitted by the host capture adapter because the
    // producer ABI intentionally remains the existing typed-while layout.
    let first: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
    let open: TokenInfo = scan_token_info(bytes, first.end, expression_end)
    let argument: TokenInfo = scan_token_info(bytes, open.end, expression_end)
    let close: TokenInfo = scan_token_info(bytes, argument.end, expression_end)
    if first.kind == 1u8 {
        if open.kind == 3u8 {
            if bytes[open.start] == 0x28u8 {
                if argument.kind == 1u8 {
                    if close.kind == 3u8 {
                        if bytes[close.start] == 0x29u8 {
                            if close.end == expression_end { return 3usize }
                        }
                    }
                }
                if argument.kind == 2u8 {
                    if close.kind == 3u8 {
                        if bytes[close.start] == 0x29u8 {
                            if close.end == expression_end { return 3usize }
                        }
                    }
                }
                if close.kind == 3u8 {
                    if bytes[close.start] == 0x2Cu8 {
                        let second: TokenInfo = scan_token_info(bytes, close.end, expression_end)
                        let second_close: TokenInfo = scan_token_info(bytes, second.end, expression_end)
                        if argument.kind == 1u8 {
                            if second.kind == 1u8 {
                                if second_close.kind == 3u8 {
                                    if bytes[second_close.start] == 0x29u8 {
                                        if second_close.end == expression_end { return 4usize }
                                    }
                                }
                            }
                        }
                        if argument.kind == 1u8 {
                            if second.kind == 2u8 {
                                if second_close.kind == 3u8 {
                                    if bytes[second_close.start] == 0x29u8 {
                                        if second_close.end == expression_end { return 4usize }
                                    }
                                }
                            }
                        }
                        if argument.kind == 2u8 {
                            if second.kind == 1u8 {
                                if second_close.kind == 3u8 {
                                    if bytes[second_close.start] == 0x29u8 {
                                        if second_close.end == expression_end { return 4usize }
                                    }
                                }
                            }
                        }
                        if argument.kind == 2u8 {
                            if second.kind == 2u8 {
                                if second_close.kind == 3u8 {
                                    if bytes[second_close.start] == 0x29u8 {
                                        if second_close.end == expression_end { return 4usize }
                                    }
                                }
                            }
                        }
                    }
                }
                // Bounded arithmetic argument: `callee(left op right, tail)`.
                // The generic emitter preserves the binary node and the host
                // capture adapter publishes it as one argument root.
                let binary_argument_count: UIntSize = stage2_count_dynamic_binary_call_argument(bytes, open.end, expression_end)
                if binary_argument_count > 0usize { return binary_argument_count }
            }
        }
    }
    var cursor: UIntSize = expression_start
    var delimiter_depth: UIntSize = 0usize
    var node_count: UIntSize = 0usize
    var expecting_operand: Bool = true
    while cursor < expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, expression_end)
        if token.start >= expression_end { break }
        if token.kind == 1u8 {
            if !expecting_operand { return 0usize }
            node_count = node_count + 1usize
            expecting_operand = false
        } else if token.kind == 2u8 {
            if !expecting_operand { return 0usize }
            node_count = node_count + 1usize
            expecting_operand = false
        } else if token.kind == 3u8 {
            let symbol: UInt8 = bytes[token.start]
            if symbol == 0x28u8 {
                if !expecting_operand { return 0usize }
                delimiter_depth = delimiter_depth + 1usize
                if delimiter_depth > 32usize { return 0usize }
                expecting_operand = true
            } else if symbol == 0x29u8 {
                if delimiter_depth == 0usize { return 0usize }
                if expecting_operand { return 0usize }
                delimiter_depth = delimiter_depth - 1usize
                node_count = node_count + 1usize
                expecting_operand = false
            } else if symbol == 0x2Bu8 {
                node_count = node_count + 1usize
                if expecting_operand { expecting_operand = true } else { expecting_operand = true }
            } else if symbol == 0x2Du8 {
                node_count = node_count + 1usize
                if expecting_operand { expecting_operand = true } else { expecting_operand = true }
            } else if symbol == 0x2Au8 {
                if expecting_operand { return 0usize }
                node_count = node_count + 1usize
                expecting_operand = true
            } else {
                return 0usize
            }
        } else {
            return 0usize
        }
        if node_count > 64usize { return 0usize }
        cursor = token.end
    }
    if delimiter_depth != 0usize { return 0usize }
    if expecting_operand { return 0usize }
    return node_count
}

@noalloc
fn stage2_last_expression_token(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
) -> TokenInfo {
    var cursor: UIntSize = expression_start
    var last: TokenInfo = TokenInfo { kind: 0u8, start: 0usize, end: 0usize }
    while cursor < expression_end {
        let token: TokenInfo = scan_token_info(bytes, cursor, expression_end)
        if token.start >= expression_end { break }
        let token_end: UIntSize = token.end
        last = token
        cursor = token_end
    }
    return last
}

fn stage2_emit_typed_assignment_expression_legacy(
    bytes: read Slice<UInt8>,
    expression_start: UIntSize,
    expression_end: UIntSize,
    ast: write Slice<TypedExpressionAstNodeHeader>,
    ast_capacity: UIntSize,
    ast_cursor: UIntSize,
) -> Stage2TypedExpressionEmission {
    let invalid: Stage2TypedExpressionEmission = stage2_invalid_typed_expression_emission()
    if expression_start >= expression_end { return invalid }

    // Two disjoint binary groups are emitted as leaves, first group, second
    // group and final root: `(a op b) outer (c op d)`.  Keeping this branch
    // before the single-group cases makes the delimiters part of the root
    // spans instead of accidentally treating the second opening parenthesis
    // as a scalar operand.
    let two_group_first_open: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
    if stage2_has_nested_left_group_shape(bytes, expression_start, expression_end) {
        let nested_outer_open: TokenInfo = scan_token_info(bytes, expression_start, expression_end)
        let nested_inner_open: TokenInfo = scan_token_info(bytes, nested_outer_open.end, expression_end)
        let nested_left: TokenInfo = scan_token_info(bytes, nested_inner_open.end, expression_end)
        let nested_inner_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_left.end, expression_end)
        let nested_inner_right: TokenInfo = scan_token_info(bytes, nested_inner_operator.end, expression_end)
        let nested_inner_close: TokenInfo = scan_token_info(bytes, nested_inner_right.end, expression_end)
        let nested_outer_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_inner_close.end, expression_end)
        let nested_outer_right: TokenInfo = scan_token_info(bytes, nested_outer_operator.end, expression_end)
        let nested_outer_close: TokenInfo = scan_token_info(bytes, nested_outer_right.end, expression_end)
        let nested_final_operator: TokenInfo = scan_stage2_operator_info(bytes, nested_outer_close.end, expression_end)
        let nested_final_right: TokenInfo = scan_token_info(bytes, nested_final_operator.end, expression_end)
        if nested_left.kind != 1u8 { if nested_left.kind != 2u8 { return invalid } }
        if nested_inner_right.kind != 1u8 { if nested_inner_right.kind != 2u8 { return invalid } }
        if nested_outer_right.kind != 1u8 { if nested_outer_right.kind != 2u8 { return invalid } }
        if nested_final_right.kind != 1u8 { if nested_final_right.kind != 2u8 { return invalid } }
        if nested_inner_operator.kind != 3u8 { return invalid }
        if nested_outer_operator.kind != 3u8 { return invalid }
        if nested_final_operator.kind != 3u8 { return invalid }
        if bytes[nested_inner_operator.start] != 0x2Bu8 {
            if bytes[nested_inner_operator.start] != 0x2Du8 {
                if bytes[nested_inner_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if bytes[nested_outer_operator.start] != 0x2Bu8 {
            if bytes[nested_outer_operator.start] != 0x2Du8 {
                if bytes[nested_outer_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if bytes[nested_final_operator.start] != 0x2Bu8 {
            if bytes[nested_final_operator.start] != 0x2Du8 {
                if bytes[nested_final_operator.start] != 0x2Au8 { return invalid }
            }
        }
        if nested_inner_close.kind != 3u8 { return invalid }
        if bytes[nested_inner_close.start] != 0x29u8 { return invalid }
        if nested_outer_close.kind != 3u8 { return invalid }
        if bytes[nested_outer_close.start] != 0x29u8 { return invalid }
        if nested_final_right.end != expression_end { return invalid }
        let nested_left_kind: UInt8 = if nested_left.kind == 1u8 { 1u8 } else { 2u8 }
        let nested_inner_right_kind: UInt8 = if nested_inner_right.kind == 1u8 { 1u8 } else { 2u8 }
