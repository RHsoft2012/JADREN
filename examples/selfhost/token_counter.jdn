                                kind: 4u8,
                                opcode: 1u8,
                                type_kind: 2u8,
                                flags: 0u8,
                                function_index: function_index,
                                block_index: 0usize,
                                value_index: 1usize,
                                operand_a: stage2_i32_literal_value(
