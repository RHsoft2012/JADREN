/// written into caller-owned output; name resolution and binding semantics
/// remain later compiler stages.
@export(name: "jadren_selfhost_parse_ast_pattern_binding_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_binding_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternBindingHeader>,
) -> UIntSize {
    return parse_pattern_bindings(bytes, start, end, output)
}

/// Projects bounded pattern recovery records as an AST child view. Recovery
/// kind, offending span and delimiter depth remain syntax-only and are written
/// into caller-owned output; diagnostic policy remains a later compiler stage.
@export(name: "jadren_selfhost_parse_ast_pattern_recovery_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_recovery_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternRecoveryHeader>,
) -> UIntSize {
    return parse_pattern_recovery(bytes, start, end, output)
}

/// Projects bounded delimiter diagnostics as an AST child view. Kind,
/// expected/actual delimiters, span and depth remain syntax-only and are
/// written into caller-owned output; the opener stack is caller-owned too.
@export(name: "jadren_selfhost_parse_ast_pattern_diagnostic_children", abi: "C")
@noalloc
pub fn parse_ast_pattern_diagnostic_children(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternDiagnosticHeader>,
    stack: write Slice<UInt8>,
) -> UIntSize {
    return parse_pattern_diagnostics(bytes, start, end, output, stack)
}

/// Emits bounded postfix spans from one explicit expression range. A call or
/// index opener is considered postfix only when a preceding atom/group can be
/// observed; a single dot followed by an identifier is a field span and `?`
/// is a try-postfix span. No name resolution or call arity is performed.
@export(name: "jadren_selfhost_parse_expression_postfixes", abi: "C")
@noalloc
pub fn parse_expression_postfixes(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionPostfixHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var can_postfix: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                can_postfix = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                can_postfix = true
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                can_postfix = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                can_postfix = true
                source_index = next_source
                continue
            }
            if symbol == 0x2Eu8 {
                var is_range_prefix: Bool = false
                if end - token_start >= 2usize {
                    if bytes[token_start + 1usize] == 0x2Eu8 {
                        is_range_prefix = true
                    }
                }
                if can_postfix {
                    if !is_range_prefix {
                        let field_info: TokenInfo = scan_token_info(bytes, next_source, end)
                        if field_info.kind == 1u8 {
                            output[slot] = ExpressionPostfixHeader {
                                kind: 2u8,
                                start: token_start,
                                end: field_info.end,
                                depth: delimiter_depth,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                            source_index = field_info.end
                            can_postfix = true
                            break
                        }
                    }
                }
                can_postfix = false
                source_index = next_source
                continue
            }
            if symbol == 0x3Fu8 {
                if can_postfix {
                    output[slot] = ExpressionPostfixHeader {
                        kind: 4u8,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                    source_index = next_source
                    break
                }
                source_index = next_source
                continue
            }
            var postfix_kind: UInt8 = 0u8
            var closing_symbol: UInt8 = 0u8
            if symbol == 0x28u8 {
                if can_postfix {
                    postfix_kind = 1u8
                    closing_symbol = 0x29u8
                }
            } else {
                if symbol == 0x5Bu8 {
                    if can_postfix {
                        postfix_kind = 3u8
                        closing_symbol = 0x5Du8
                    }
                }
            }
            if postfix_kind != 0u8 {
                var nested_depth: UIntSize = 1usize
                var cursor: UIntSize = next_source
                var group_end: UIntSize = end
                while cursor < end {
                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if nested_info.start >= end {
                        cursor = end
                        break
                    }
                    var nested_symbol: UInt8 = 0u8
                    if nested_info.kind == 3u8 {
                        nested_symbol = bytes[nested_info.start]
                    }
                    if nested_symbol == symbol {
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == closing_symbol {
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                            if nested_depth == 0usize {
                                group_end = nested_info.end
                                break
                            }
                        }
                    }
                    cursor = nested_info.end
                }
                output[slot] = ExpressionPostfixHeader {
                    kind: postfix_kind,
                    start: token_start,
                    end: group_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                delimiter_depth = delimiter_depth + 1usize
                can_postfix = false
                source_index = next_source
                break
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
            } else {
                if symbol == 0x5Bu8 {
                    delimiter_depth = delimiter_depth + 1usize
                }
            }
            can_postfix = false
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded call headers from one explicit expression range. A call is
/// recognized only when a parenthesized group follows an atom or completed
/// delimiter group. The scanner counts commas at the call's outer delimiter
/// level and skips nested groups; it does not resolve the callee or validate
/// argument types.
@export(name: "jadren_selfhost_parse_expression_calls", abi: "C")
@noalloc
pub fn parse_expression_calls(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionCallHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            output[slot] = ExpressionCallHeader {
                callee_start: callee_start,
                callee_end: callee_end,
                open_start: token_start,
                open_end: next_source,
                close_start: close_start,
                close_end: close_end,
                argument_count: argument_count,
                depth: delimiter_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits one bounded record for every top-level binary operator in an explicit
/// expression range. Delimiters are tracked so operators inside calls,
/// indexing, or groups are excluded. Unary shape, precedence, associativity,
/// and operand type resolution are intentionally deferred.
@export(name: "jadren_selfhost_parse_expression_binary_headers", abi: "C")
@noalloc
pub fn parse_expression_binary_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionBinaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind != 0u8 {
                        if candidate_kind != 5u8 {
                            if candidate_kind != 6u8 {
                                output[slot] = ExpressionBinaryHeader {
                                    kind: candidate_kind,
                                    left_start: start,
                                    left_end: token_start,
                                    operator_start: token_start,
                                    operator_end: operator_end,
                                    right_start: operator_end,
                                    right_end: end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded prefix/unary spans from one explicit expression range. A
/// prefix operator is recognized only while an operand is expected; the
/// following atom or delimiter group is retained as its operand span. This is
/// syntax-only and does not decide whether borrow/dereference is legal.
@export(name: "jadren_selfhost_parse_expression_unaries", abi: "C")
@noalloc
pub fn parse_expression_unaries(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<ExpressionUnaryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var expect_operand: Bool = true
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                expect_operand = false
                source_index = next_source
                continue
            }
            let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
            if expect_operand {
                if operator_end - token_start == 1usize {
                    var unary_kind: UInt8 = 0u8
                    if symbol == 0x2Bu8 {
                        unary_kind = 1u8
                    } else {
                        if symbol == 0x2Du8 {
                            unary_kind = 2u8
                        } else {
                            if symbol == 0x21u8 {
                                unary_kind = 3u8
                            } else {
                                if symbol == 0x7Eu8 {
                                    unary_kind = 4u8
                                } else {
                                    if symbol == 0x26u8 {
                                        unary_kind = 5u8
                                    } else {
                                        if symbol == 0x2Au8 {
                                            unary_kind = 6u8
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if unary_kind != 0u8 {
                        let operand_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                        var operand_start: UIntSize = end
                        var operand_end: UIntSize = end
                        if operand_info.start < end {
                            operand_start = operand_info.start
                            operand_end = operand_info.end
                            var operand_symbol: UInt8 = 0u8
                            if operand_info.kind == 3u8 {
                                operand_symbol = bytes[operand_info.start]
                            }
                            if operand_symbol == 0x28u8 {
                                var nested_depth: UIntSize = 1usize
                                var cursor: UIntSize = operand_info.end
                                while cursor < end {
                                    let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if nested_info.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var nested_symbol: UInt8 = 0u8
                                    if nested_info.kind == 3u8 {
                                        nested_symbol = bytes[nested_info.start]
                                    }
                                    if nested_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if nested_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                operand_end = nested_info.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = nested_info.end
                                }
                            } else {
                                if operand_symbol == 0x5Bu8 {
                                    var nested_depth: UIntSize = 1usize
                                    var cursor: UIntSize = operand_info.end
                                    while cursor < end {
                                        let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                                        if nested_info.start >= end {
                                            cursor = end
                                            break
                                        }
                                        var nested_symbol: UInt8 = 0u8
                                        if nested_info.kind == 3u8 {
                                            nested_symbol = bytes[nested_info.start]
                                        }
                                        if nested_symbol == 0x5Bu8 {
                                            nested_depth = nested_depth + 1usize
                                        } else {
                                            if nested_symbol == 0x5Du8 {
                                                if nested_depth > 0usize {
                                                    nested_depth = nested_depth - 1usize
                                                }
                                                if nested_depth == 0usize {
                                                    operand_end = nested_info.end
                                                    break
                                                }
                                            }
                                        }
                                        cursor = nested_info.end
                                    }
                                }
                            }
                        }
                        output[slot] = ExpressionUnaryHeader {
                            kind: unary_kind,
                            operator_start: token_start,
                            operator_end: operator_end,
                            operand_start: operand_start,
                            operand_end: operand_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        expect_operand = true
                        source_index = operator_end
                        break
                    }
                }
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
            if candidate_kind != 0u8 {
                if candidate_kind != 5u8 {
                    if candidate_kind != 6u8 {
                        expect_operand = true
                    }
                }
                source_index = operator_end
                continue
            }
            if symbol == 0x2Cu8 {
                expect_operand = true
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits boolean, integer, float, string, and char literal spans from one
/// explicit expression range. Quoted literals honor a bounded backslash escape
/// state; invalid or unterminated literals are retained to `end` for recovery.
/// This stage does not validate literal contents or infer their types.
@export(name: "jadren_selfhost_parse_literal_headers", abi: "C")
@noalloc
pub fn parse_literal_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<LiteralHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = LiteralHeader {
                    kind: bool_kind,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_kind: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_kind = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = LiteralHeader {
                    kind: literal_kind,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = LiteralHeader {
                    kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first typed-semantics hand-off for self-hosting: builtin types
/// for boolean, integer, float, string, and char literals. The caller owns the
/// output buffer and receives records in the same source order as
/// `parse_literal_headers`. No names, operators, calls, aliases, or user
/// declarations are resolved here.
@export(name: "jadren_selfhost_infer_literal_types", abi: "C")
@noalloc
pub fn infer_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            let bool_kind: UInt8 = boolean_literal_kind(bytes, info.kind, token_start, next_source)
            if bool_kind != 0u8 {
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 1u8,
                    start: token_start,
                    end: next_source,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = next_source
                break
            }
            if info.kind == 2u8 {
                var literal_type: UInt8 = 2u8
                var literal_end: UIntSize = next_source
                if next_source < end {
                    if bytes[next_source] == 0x2Eu8 {
                        if next_source + 1usize < end {
                            if bytes[next_source + 1usize] != 0x2Eu8 {
                                let fraction_info: TokenInfo = scan_token_info(
                                    bytes,
                                    next_source + 1usize,
                                    end,
                                )
                                if fraction_info.kind == 2u8 {
                                    if fraction_info.start == next_source + 1usize {
                                        literal_type = 3u8
                                        literal_end = fraction_info.end
                                    }
                                }
                            }
                        }
                    }
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: literal_type,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x22u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x22u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 4u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            if symbol == 0x27u8 {
                var cursor: UIntSize = next_source
                var escaped: Bool = false
                var literal_end: UIntSize = end
                while cursor < end {
                    let quoted_info: TokenInfo = scan_token_info(bytes, cursor, end)
                    if quoted_info.start >= end {
                        cursor = end
                        break
                    }
                    var quoted_symbol: UInt8 = 0u8
                    if quoted_info.kind == 3u8 {
                        quoted_symbol = bytes[quoted_info.start]
                    }
                    if escaped {
                        escaped = false
                    } else {
                        if quoted_symbol == 0x5Cu8 {
                            escaped = true
                        } else {
                            if quoted_symbol == 0x27u8 {
                                literal_end = quoted_info.end
                                break
                            }
                        }
                    }
                    cursor = quoted_info.end
                }
                output[slot] = TypedExpressionHeader {
                    expression_kind: 1u8,
                    type_kind: 5u8,
                    start: token_start,
                    end: literal_end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = literal_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed records for top-level binary expressions whose left and right
/// sides are each one builtin literal or one parenthesized builtin literal
/// group. Arithmetic over numeric literals yields integer or float, comparisons
/// yield bool, and logical operators over boolean literals yield bool. A
/// a bounded two-operator chain is also accepted: arithmetic operators may
/// mix, and one arithmetic operator may feed a numeric comparison according to
/// the bounded precedence categories. Names, casts, calls and user types remain
/// outside this narrow binary hand-off.
@export(name: "jadren_selfhost_infer_binary_literal_types", abi: "C")
@noalloc
pub fn infer_binary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let chain_header: TypedExpressionHeader = infer_binary_literal_chain_header(bytes, start, end)
    let chain_mode: Bool = chain_header.type_kind != 0u8
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        if chain_mode {
            output[slot] = TypedExpressionHeader {
                expression_kind: chain_header.expression_kind,
                type_kind: chain_header.type_kind,
                start: chain_header.start,
                end: chain_header.end,
                depth: chain_header.depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = end
        }
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if delimiter_depth == 0usize {
                if info.kind == 3u8 {
                    let operator_end: UIntSize = operator_span_end(bytes, token_start, end)
                    let candidate_kind: UInt8 = operator_kind(bytes, token_start, operator_end)
                    if candidate_kind == 2u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        var result_type: UInt8 = 0u8
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                if left_type == 3u8 {
                                    result_type = 3u8
                                } else {
                                    if right_type == 3u8 {
                                        result_type = 3u8
                                    } else {
                                        result_type = 2u8
                                    }
                                }
                            }
                        }
                        if result_type != 0u8 {
                            let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                            let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                            var right_end: UIntSize = right_info.end
                            if right_grouped_type != 0u8 {
                                right_end = bounded_grouped_literal_end(bytes, operator_end, end)
                            } else {
                                if right_type == 3u8 {
                                    right_end = bounded_numeric_literal_end(bytes, operator_end, end)
                                }
                            }
                            output[slot] = TypedExpressionHeader {
                                expression_kind: 2u8,
                                type_kind: result_type,
                                start: left_info.start,
                                end: right_end,
                                depth: delimiter_depth,
                            }
                            output_index = output_index + 1usize
                            emitted = true
                            source_index = operator_end
                            break
                        }
                    }
                    if candidate_kind == 3u8 {
                        let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            start,
                            token_start,
                        )
                        let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                            bytes,
                            operator_end,
                            end,
                        )
                        let left_type: UInt8 = if left_grouped_type != 0u8 {
                            left_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, start, token_start)
                        }
                        let right_type: UInt8 = if right_grouped_type != 0u8 {
                            right_grouped_type
                        } else {
                            bounded_literal_type_kind(bytes, operator_end, end)
                        }
                        if is_numeric_literal_type(left_type) {
                            if is_numeric_literal_type(right_type) {
                                let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                let right_end: UIntSize = if right_grouped_type != 0u8 {
                                    bounded_grouped_literal_end(bytes, operator_end, end)
                                } else {
                                    right_info.end
                                }
                                output[slot] = TypedExpressionHeader {
                                    expression_kind: 2u8,
                                    type_kind: 1u8,
                                    start: left_info.start,
                                    end: right_end,
                                    depth: delimiter_depth,
                                }
                                output_index = output_index + 1usize
                                emitted = true
                                source_index = operator_end
                                break
                            }
                        }
                    }
                    if candidate_kind == 4u8 {
                        if is_boolean_binary_operator(bytes, token_start, operator_end) {
                            let left_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                start,
                                token_start,
                            )
                            let right_grouped_type: UInt8 = bounded_grouped_literal_type_kind(
                                bytes,
                                operator_end,
                                end,
                            )
                            let left_type: UInt8 = if left_grouped_type != 0u8 {
                                left_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, start, token_start)
                            }
                            let right_type: UInt8 = if right_grouped_type != 0u8 {
                                right_grouped_type
                            } else {
                                bounded_literal_type_kind(bytes, operator_end, end)
                            }
                            if left_type == 1u8 {
                                if right_type == 1u8 {
                                    let left_info: TokenInfo = scan_token_info(bytes, start, token_start)
                                    let right_info: TokenInfo = scan_token_info(bytes, operator_end, end)
                                    let right_end: UIntSize = if right_grouped_type != 0u8 {
                                        bounded_grouped_literal_end(bytes, operator_end, end)
                                    } else {
                                        right_info.end
                                    }
                                    output[slot] = TypedExpressionHeader {
                                        expression_kind: 2u8,
                                        type_kind: 1u8,
                                        start: left_info.start,
                                        end: right_end,
                                        depth: delimiter_depth,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = operator_end
                                    break
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
        if chain_mode {
            break
        }
    }
    return output_index
}

/// Emits one typed record for the bounded explicit numeric cast route.
@export(name: "jadren_selfhost_infer_cast_literal_types", abi: "C")
@noalloc
pub fn infer_cast_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_cast_literal_header(bytes, start, end)
    if header.type_kind == 0u8 {
        return 0usize
    }
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        if header.type_kind != 0u8 {
            output[slot] = TypedExpressionHeader {
                expression_kind: header.expression_kind,
                type_kind: header.type_kind,
                start: header.start,
                end: header.end,
                depth: header.depth,
            }
            output_index = 1usize
        }
    }
    return output_index
}

/// Emits one typed record for a unary operator applied to exactly one builtin
/// literal or one or more nested parenthesized literal groups. Contiguous
/// prefix chains are applied from right to left, so `--42` preserves Integer
/// and `!!true` preserves Bool. `+`/`-` preserve integer or float, `!` accepts
/// bool, and `~` accepts integer. This is intentionally a prefix-only
/// hand-off; ASCII whitespace between prefix operators is accepted, while
/// borrow/dereference semantics, precedence and names remain later stages.
fn infer_unary_literal_header(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
) -> TypedExpressionHeader {
    let operator_info: TokenInfo = scan_token_info(bytes, start, end)
    if operator_info.start >= end {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operator_end: UIntSize = operator_info.end
    if operator_end != operator_info.start + 1usize {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    if !is_unary_operator(bytes[operator_info.start]) {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    var operand_start: UIntSize = operator_end
    var chain_cursor: UIntSize = operator_end
    while chain_cursor < end {
        let chain_info: TokenInfo = scan_token_info(bytes, chain_cursor, end)
        if chain_info.start >= end {
            break
        }
        if chain_info.end != chain_info.start + 1usize {
            break
        }
        if !is_unary_operator(bytes[chain_info.start]) {
            break
        }
        operand_start = chain_info.end
        chain_cursor = chain_info.end
    }
    let grouped_operand_type: UInt8 = bounded_grouped_literal_type_kind(
        bytes,
        operand_start,
        end,
    )
    let operand_type: UInt8 = if grouped_operand_type != 0u8 {
        grouped_operand_type
    } else {
        bounded_literal_type_kind(bytes, operand_start, end)
    }
    let grouped: Bool = grouped_operand_type != 0u8
    var result_type: UInt8 = operand_type
    var operator_cursor: UIntSize = operand_start
    while operator_cursor > operator_info.start {
        operator_cursor = operator_cursor - 1usize
        if classify_byte(bytes[operator_cursor]) == 3u8 {
            continue
        }
        let operator: UInt8 = bytes[operator_cursor]
        var next_type: UInt8 = 0u8
        if operator == 0x2Bu8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x2Du8 {
            if is_numeric_literal_type(result_type) {
                next_type = result_type
            }
        }
        if operator == 0x21u8 {
            if result_type == 1u8 {
                next_type = 1u8
            }
        }
        if operator == 0x7Eu8 {
            if result_type == 2u8 {
                next_type = 2u8
            }
        }
        result_type = next_type
        if result_type == 0u8 {
            break
        }
    }
    if result_type == 0u8 {
        return TypedExpressionHeader {
            expression_kind: 0u8,
            type_kind: 0u8,
            start: 0usize,
            end: 0usize,
            depth: 0usize,
        }
    }
    let operand_info: TokenInfo = scan_token_info(bytes, operand_start, end)
    var operand_end: UIntSize = operand_info.end
    var depth: UIntSize = 0usize
    if grouped {
        operand_end = bounded_grouped_literal_end(bytes, operand_start, end)
        var depth_cursor: UIntSize = operand_start
        while true {
            let group_info: TokenInfo = scan_token_info(bytes, depth_cursor, end)
            if group_info.start >= end {
                break
            }
            if bytes[group_info.start] != 0x28u8 {
                break
            }
            depth = depth + 1usize
            depth_cursor = group_info.end
        }
    } else {
        if operand_type == 2u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
        if operand_type == 3u8 {
            operand_end = bounded_numeric_literal_end(bytes, operand_start, end)
        }
    }
    return TypedExpressionHeader {
        expression_kind: 3u8,
        type_kind: result_type,
        start: operator_info.start,
        end: operand_end,
        depth: depth,
    }
}

@export(name: "jadren_selfhost_infer_unary_literal_types", abi: "C")
@noalloc
pub fn infer_unary_literal_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    let header: TypedExpressionHeader = infer_unary_literal_header(bytes, start, end)
    if header.type_kind != 0u8 {
        var output_index: UIntSize = 0usize
        for slot in output.indices {
            if output_index == 0usize {
                output[slot] = TypedExpressionHeader {
                    expression_kind: header.expression_kind,
                    type_kind: header.type_kind,
                    start: header.start,
                    end: header.end,
                    depth: header.depth,
                }
                output_index = 1usize
            }
        }
        return output_index
    }
    return 0usize
}

/// Emits one typed name record for every identifier token that matches a
/// caller-owned binding entry. The binding spans and output buffer are bounded
/// by the caller; results preserve source order and stop at output capacity.
/// This is a symbol-table hand-off, not a scope-aware resolver.
@export(name: "jadren_selfhost_infer_name_types", abi: "C")
@noalloc
pub fn infer_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                    var equal: Bool = true
                                    var compare_index: UIntSize = 0usize
                                    while compare_index < next_source - token_start {
                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                            equal = false
                                            break
                                        }
                                        compare_index = compare_index + 1usize
                                    }
                                    if equal {
                                        output[slot] = TypedExpressionHeader {
                                            expression_kind: 5u8,
                                            type_kind: bindings[binding_index].type_kind,
                                            start: token_start,
                                            end: next_source,
                                            depth: delimiter_depth,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        break
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records for caller-owned function bindings. The callee
/// bytes and positional argument count must match exactly; only builtin return
/// types are accepted. A valid record spans from the callee through the close
/// delimiter and uses expression kind `8` in the existing typed header.
@export(name: "jadren_selfhost_infer_call_types", abi: "C")
@noalloc
pub fn infer_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedCallBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    for binding_index in bindings.indices {
                    if bindings[binding_index].return_type_kind >= 1u8 {
                        if bindings[binding_index].return_type_kind <= 5u8 {
                            if bindings[binding_index].parameter_count == argument_count {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == callee_end - callee_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < callee_end - callee_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                output[slot] = TypedExpressionHeader {
                                                    expression_kind: 8u8,
                                                    type_kind: bindings[binding_index].return_type_kind,
                                                    start: callee_start,
                                                    end: close_end,
                                                    depth: delimiter_depth,
                                                }
                                                output_index = output_index + 1usize
                                                emitted = true
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed call records selected from caller-owned concrete overloads and
/// generic fallbacks. Matching is exact by name bytes and positional arity;
/// the lowest generic parameter count wins and an equal-specificity tie is
/// rejected as ambiguous. Parameter types, bounds and substitution remain
/// outside this additive resolver boundary.
@export(name: "jadren_selfhost_resolve_call_types", abi: "C")
@noalloc
pub fn resolve_call_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    candidates: read Slice<TypedCallCandidateHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var callee_start: UIntSize = end
    var callee_end: UIntSize = end
    var can_call: Bool = false
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if info.kind == 1u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if info.kind == 2u8 {
                if !can_call {
                    callee_start = token_start
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                if !can_call {
                    callee_start = token_start
                }
                delimiter_depth = delimiter_depth + 1usize
                callee_end = next_source
                can_call = true
                source_index = next_source
                continue
            }
            if symbol != 0x28u8 {
                can_call = false
                source_index = next_source
                continue
            }
            if !can_call {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            var nested_depth: UIntSize = 1usize
            var cursor: UIntSize = next_source
            var close_start: UIntSize = end
            var close_end: UIntSize = end
            var argument_count: UIntSize = 0usize
            var argument_has_token: Bool = false
            while cursor < end {
                let nested_info: TokenInfo = scan_token_info(bytes, cursor, end)
                if nested_info.start >= end {
                    cursor = end
                    break
                }
                var nested_symbol: UInt8 = 0u8
                if nested_info.kind == 3u8 {
                    nested_symbol = bytes[nested_info.start]
                }
                if nested_symbol == 0x28u8 {
                    if nested_depth == 1usize {
                        argument_has_token = true
                    }
                    nested_depth = nested_depth + 1usize
                } else {
                    if nested_symbol == 0x5Bu8 {
                        if nested_depth == 1usize {
                            argument_has_token = true
                        }
                        nested_depth = nested_depth + 1usize
                    } else {
                        if nested_symbol == 0x29u8 {
                            if nested_depth == 1usize {
                                if argument_has_token {
                                    argument_count = argument_count + 1usize
                                }
                                close_start = nested_info.start
                                close_end = nested_info.end
                                nested_depth = 0usize
                                break
                            }
                            if nested_depth > 0usize {
                                nested_depth = nested_depth - 1usize
                            }
                        } else {
                            if nested_symbol == 0x5Du8 {
                                if nested_depth > 0usize {
                                    nested_depth = nested_depth - 1usize
                                }
                            } else {
                                if nested_depth == 1usize {
                                    if nested_symbol == 0x2Cu8 {
                                        if argument_has_token {
                                            argument_count = argument_count + 1usize
                                            argument_has_token = false
                                        }
                                    } else {
                                        argument_has_token = true
                                    }
                                }
                            }
                        }
                    }
                }
                cursor = nested_info.end
            }
            if nested_depth > 0usize {
                if argument_has_token {
                    argument_count = argument_count + 1usize
                }
            }
            if close_start < end {
                if callee_start < callee_end {
                    var argument_type_kind: UInt8 = 0u8
                    if argument_count == 1usize {
                        argument_type_kind = bounded_literal_type_kind(
                            bytes,
                            next_source,
                            close_start,
                        )
                    }
                    var argument_type_count: UIntSize = bounded_argument_type_count(
                        bytes,
                        next_source,
                        close_start,
                    )
                    var best_type_specificity: UInt8 = 0u8
                    var best_generic_count: UIntSize = 33usize
                    var best_return_type: UInt8 = 0u8
                    var best_match_count: UIntSize = 0usize
                    for candidate_index in candidates.indices {
                        if candidates[candidate_index].return_type_kind <= 5u8 {
                            var return_type_is_eligible: Bool = false
                            if candidates[candidate_index].return_type_kind >= 1u8 {
                                return_type_is_eligible = true
                            } else {
                                if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                    return_type_is_eligible = true
                                } else {
                                    if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                        return_type_is_eligible = true
                                    } else {
                                        if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                            return_type_is_eligible = true
                                        }
                                    }
                                }
                            }
                            if return_type_is_eligible {
                                if candidates[candidate_index].generic_parameter_count <= 32usize {
                                    if candidates[candidate_index].parameter_type_kind <= 5u8 {
                                        if candidates[candidate_index].generic_bound_kind <= 3u8 {
                                            var bound_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_parameter_count != 0usize {
                                                bound_is_eligible = true
                                            } else {
                                                if candidates[candidate_index].generic_bound_kind == 0u8 {
                                                    bound_is_eligible = true
                                                }
                                            }
                                            if bound_is_eligible {
                                            var substitution_is_eligible: Bool = false
                                            if candidates[candidate_index].generic_substitution_kind == 0u8 {
                                                substitution_is_eligible = true
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                if candidates[candidate_index].generic_parameter_count > 0usize {
                                                    if candidates[candidate_index].parameter_count >= 2usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                            if candidates[candidate_index].parameter_type_start == 0u16 {
                                                                if candidates[candidate_index].parameter_type_end == 0u16 {
                                                                    substitution_is_eligible = true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if substitution_is_eligible {
                                        var parameter_matches: Bool = false
                                        var type_specificity: UInt8 = 0u8
                                        if candidates[candidate_index].parameter_count == argument_count {
                                            var has_parameter_type_span: Bool = false
                                            if candidates[candidate_index].parameter_type_start != 0u16 {
                                                has_parameter_type_span = true
                                            } else {
                                                if candidates[candidate_index].parameter_type_end != 0u16 {
                                                    has_parameter_type_span = true
                                                }
                                            }
                                            if has_parameter_type_span {
                                                if candidates[candidate_index].parameter_type_start < candidates[candidate_index].parameter_type_end {
                                                    let parameter_type_start: UIntSize = candidates[candidate_index].parameter_type_start as UIntSize
                                                    let parameter_type_end: UIntSize = candidates[candidate_index].parameter_type_end as UIntSize
                                                    if parameter_type_end <= source_length {
                                                        if argument_type_count == argument_count {
                                                            if bounded_parameter_type_count(bytes, parameter_type_start, parameter_type_end) == argument_count {
                                                                if argument_count <= 32usize {
                                                                    parameter_matches = true
                                                                    var parameter_index: UIntSize = 0usize
                                                                    while parameter_index < argument_count {
                                                                        let expected_type: UInt8 = bounded_parameter_type_kind_at(bytes, parameter_type_start, parameter_type_end, parameter_index)
                                                                        var actual_type: UInt8 = 0u8
                                                                        if argument_count == 1usize {
                                                                            actual_type = argument_type_kind
                                                                        } else {
                                                                            actual_type = bounded_argument_type_kind_at(bytes, next_source, close_start, parameter_index)
                                                                        }
                                                                        if expected_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if actual_type == 0u8 {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        if expected_type != actual_type {
                                                                            parameter_matches = false
                                                                            break
                                                                        }
                                                                        parameter_index = parameter_index + 1usize
                                                                    }
                                                                    if parameter_matches {
                                                                        type_specificity = 2u8
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].parameter_count == 1usize {
                                                        if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                        } else {
                                                        if candidates[candidate_index].parameter_type_kind == argument_type_kind {
                                                            parameter_matches = true
                                                            type_specificity = 2u8
                                                        }
                                                    }
                                                } else {
                                                    if candidates[candidate_index].parameter_type_kind == 0u8 {
                                                        parameter_matches = true
                                                        if candidates[candidate_index].generic_bound_kind != 0u8 {
                                                            type_specificity = 1u8
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind != 0u8 {
                                                                type_specificity = 1u8
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if !bounded_generic_bound_matches(bytes, next_source, close_start, argument_count, argument_type_kind, candidates[candidate_index].generic_bound_kind) {
                                                parameter_matches = false
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                if argument_count != 1usize {
                                                    parameter_matches = false
                                                } else {
                                                    if argument_type_kind == 0u8 {
                                                        parameter_matches = false
                                                    }
                                                }
                                            } else {
                                                if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                    if !bounded_same_argument_type_matches(bytes, next_source, close_start, argument_count) {
                                                        parameter_matches = false
                                                    }
                                                } else {
                                                    if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                        if !bounded_all_argument_types_known(bytes, next_source, close_start, argument_count) {
                                                            parameter_matches = false
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if parameter_matches {
                                            if candidates[candidate_index].name_start < candidates[candidate_index].name_end {
                                                if candidates[candidate_index].name_end <= source_length {
                                                    if candidates[candidate_index].name_end - candidates[candidate_index].name_start == callee_end - callee_start {
                                                    var equal: Bool = true
                                                    var compare_index: UIntSize = 0usize
                                                    while compare_index < callee_end - callee_start {
                                                        if bytes[candidates[candidate_index].name_start + compare_index] != bytes[callee_start + compare_index] {
                                                            equal = false
                                                            break
                                                        }
                                                        compare_index = compare_index + 1usize
                                                    }
                                                    if equal {
                                                        var selected_return_type: UInt8 = candidates[candidate_index].return_type_kind
                                                        if candidates[candidate_index].generic_substitution_kind == 1u8 {
                                                            selected_return_type = argument_type_kind
                                                        } else {
                                                            if candidates[candidate_index].generic_substitution_kind == 2u8 {
                                                                selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                            } else {
                                                                if candidates[candidate_index].generic_substitution_kind == 3u8 {
                                                                    selected_return_type = bounded_argument_type_kind_at(bytes, next_source, close_start, 0usize)
                                                                }
                                                            }
                                                        }
                                                        if type_specificity > best_type_specificity {
                                                            best_type_specificity = type_specificity
                                                            best_generic_count = candidates[candidate_index].generic_parameter_count
                                                            best_return_type = selected_return_type
                                                            best_match_count = 1usize
                                                        } else {
                                                            if type_specificity == best_type_specificity {
                                                                if candidates[candidate_index].generic_parameter_count < best_generic_count {
                                                                    best_generic_count = candidates[candidate_index].generic_parameter_count
                                                                    best_return_type = selected_return_type
                                                                    best_match_count = 1usize
                                                                } else {
                                                                    if candidates[candidate_index].generic_parameter_count == best_generic_count {
                                                                        best_match_count = best_match_count + 1usize
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    if best_match_count == 1usize {
                        output[slot] = TypedExpressionHeader {
                            expression_kind: 8u8,
                            type_kind: best_return_type,
                            start: callee_start,
                            end: close_end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                    }
                }
            }
            if close_end < end {
                source_index = close_end
            } else {
                source_index = end
            }
            callee_end = close_end
            can_call = true
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by the deepest visible caller-owned lexical
/// binding. Matching is exact byte equality, bindings with an invalid source
/// span/type are ignored, and later bindings win equal-depth ties. This is a
/// bounded shadowing prototype; it does not resolve regions, aliases,
/// generics, or user-defined types.
@export(name: "jadren_selfhost_infer_scoped_name_types", abi: "C")
@noalloc
pub fn infer_scoped_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedScopedNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                    if bindings[binding_index].name_end <= source_length {
                                        if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                            var equal: Bool = true
                                            var compare_index: UIntSize = 0usize
                                            while compare_index < next_source - token_start {
                                                if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                    equal = false
                                                    break
                                                }
                                                compare_index = compare_index + 1usize
                                            }
                                            if equal {
                                                var should_select: Bool = false
                                                if !selected {
                                                    should_select = true
                                                } else {
                                                    if bindings[binding_index].scope_depth >= selected_scope {
                                                        should_select = true
                                                    }
                                                }
                                                if should_select {
                                                    selected = true
                                                    selected_type = bindings[binding_index].type_kind
                                                    selected_scope = bindings[binding_index].scope_depth
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 6u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits typed names selected by a bounded caller-owned visibility region.
/// Invalid name/region spans and out-of-region tokens are ignored. This is a
/// region-aware prototype, not a complete alias, generic, or user-type
/// resolver. Region boundaries must align with the declared delimiter depth;
/// a span that cuts through a nested block is ignored.
fn delimiter_depth_at(bytes: read Slice<UInt8>, position: UIntSize) -> UIntSize {
    var cursor: UIntSize = 0usize
    var depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x29u8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x5Du8 {
                if depth > 0usize {
                    depth = depth - 1usize
                } else {
                    return source_length + 1usize
                }
            }
            if symbol == 0x28u8 {
                depth = depth + 1usize
            }
            if symbol == 0x5Bu8 {
                depth = depth + 1usize
            }
        }
        cursor = info.end
    }
    return depth
}

/// Returns the top delimiter kind immediately before `position`, or `0xff`
/// for an unmatched/mismatched delimiter. Region boundaries compare this
/// value in addition to numeric depth so `(`/`[` pairs cannot be confused.
fn delimiter_top_at(bytes: read Slice<UInt8>, position: UIntSize) -> UInt8 {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return 0xffu8
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return 0xffu8
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return 0xffu8
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return 0xffu8
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    if stack_count == 0usize {
        return 0u8
    }
    return stack[stack_count - 1usize]
}

/// Validates the complete delimiter prefix before region name resolution.
/// This bounded hand-off rejects unmatched/mismatched closers and overflow so
/// malformed source cannot produce typed-name records.
fn delimiters_well_formed_through(bytes: read Slice<UInt8>, position: UIntSize) -> Bool {
    var cursor: UIntSize = 0usize
    var stack: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ]
    var stack_count: UIntSize = 0usize
    while cursor < position {
        let info: TokenInfo = scan_token_info(bytes, cursor, position)
        if info.start >= position {
            break
        }
        if info.kind == 3u8 {
            let symbol: UInt8 = bytes[info.start]
            if symbol == 0x28u8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x5Bu8 {
                if stack_count >= 32usize {
                    return false
                }
                stack[stack_count] = symbol
                stack_count = stack_count + 1usize
            }
            if symbol == 0x29u8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x28u8 {
                    return false
                }
                stack_count = top
            }
            if symbol == 0x5Du8 {
                if stack_count == 0usize {
                    return false
                }
                let top: UIntSize = stack_count - 1usize
                if stack[top] != 0x5Bu8 {
                    return false
                }
                stack_count = top
            }
        }
        cursor = info.end
    }
    return true
}

@export(name: "jadren_selfhost_infer_region_name_types", abi: "C")
@noalloc
pub fn infer_region_name_types(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    bindings: read Slice<TypedRegionNameBindingHeader>,
    output: write Slice<TypedExpressionHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var source_length: UIntSize = 0usize
    for source_length_index in bytes.indices {
        source_length = source_length_index + 1usize
    }
    if start > end {
        return 0usize
    }
    if end > source_length {
        return 0usize
    }
    if !delimiters_well_formed_through(bytes, end) {
        return 0usize
    }
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            if symbol == 0x29u8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x5Du8 {
                if delimiter_depth > 0usize {
                    delimiter_depth = delimiter_depth - 1usize
                }
                source_index = next_source
                continue
            }
            if symbol == 0x28u8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if symbol == 0x5Bu8 {
                delimiter_depth = delimiter_depth + 1usize
                source_index = next_source
                continue
            }
            if info.kind == 1u8 {
                var selected: Bool = false
                var selected_type: UInt8 = 0u8
                var selected_scope: UIntSize = 0usize
                var selected_region_width: UIntSize = 0usize
                for binding_index in bindings.indices {
                    if bindings[binding_index].type_kind >= 1u8 {
                        if bindings[binding_index].type_kind <= 5u8 {
                            if bindings[binding_index].name_start < bindings[binding_index].name_end {
                                if bindings[binding_index].name_end <= source_length {
                                    if bindings[binding_index].region_start < bindings[binding_index].region_end {
                                        if bindings[binding_index].region_end <= source_length {
                                            if bindings[binding_index].name_start >= bindings[binding_index].region_start {
                                                if bindings[binding_index].name_end <= bindings[binding_index].region_end {
                                                    if bindings[binding_index].region_start <= token_start {
                                                        if next_source <= bindings[binding_index].region_end {
                                            if bindings[binding_index].scope_depth <= delimiter_depth {
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_start) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_depth_at(bytes, bindings[binding_index].region_end) != bindings[binding_index].scope_depth {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_end) == 0xffu8 {
                                                    continue
                                                }
                                                if delimiter_top_at(bytes, bindings[binding_index].region_start) != delimiter_top_at(bytes, bindings[binding_index].region_end) {
                                                    continue
                                                }
                                                if bindings[binding_index].name_end - bindings[binding_index].name_start == next_source - token_start {
                                                                    var equal: Bool = true
                                                                    var compare_index: UIntSize = 0usize
                                                                    while compare_index < next_source - token_start {
                                                                        if bytes[bindings[binding_index].name_start + compare_index] != bytes[token_start + compare_index] {
                                                                            equal = false
                                                                            break
                                                                        }
                                                                        compare_index = compare_index + 1usize
                                                                    }
                                                                    if equal {
                                                                        var should_select: Bool = false
                                                                        var region_width: UIntSize = bindings[binding_index].region_end - bindings[binding_index].region_start
                                                                        if !selected {
                                                                            should_select = true
                                                                        } else {
                                                                            if bindings[binding_index].scope_depth > selected_scope {
                                                                                should_select = true
                                                                            } else {
                                                                                if bindings[binding_index].scope_depth == selected_scope {
                                                                                    if region_width <= selected_region_width {
                                                                                        should_select = true
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                        if should_select {
                                                                            selected = true
                                                                            selected_type = bindings[binding_index].type_kind
                                                                            selected_scope = bindings[binding_index].scope_depth
                                                                            selected_region_width = region_width
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if selected {
                    output[slot] = TypedExpressionHeader {
                        expression_kind: 7u8,
                        type_kind: selected_type,
                        start: token_start,
                        end: next_source,
                        depth: delimiter_depth,
                    }
                    output_index = output_index + 1usize
                    emitted = true
                }
            }
            source_index = next_source
            if emitted {
                break
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only type components from an explicit `[start,end)` type
/// span. Path identifiers, capability/function keywords and delimiters are
/// preserved in source order with caller-owned output. No type resolution,
/// alias lookup, generic substitution or malformed-type recovery is done.
@export(name: "jadren_selfhost_parse_type_components", abi: "C")
@noalloc
pub fn parse_type_components(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<TypeComponentHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let token_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[token_start]
            }
            var component_kind: UInt8 = type_component_kind(
                bytes,
                info.kind,
                token_start,
                next_source,
            )
            var component_end: UIntSize = next_source
            if symbol == 0x2Du8 {
                if next_source < end {
                    if bytes[next_source] == 0x3Eu8 {
                        component_kind = 14u8
                        component_end = next_source + 1usize
                    }
                }
            }
            if component_kind != 0u8 {
                let component_depth: UIntSize = delimiter_depth
                if component_kind == 5u8 {
                    if delimiter_depth > 0usize {
                        delimiter_depth = delimiter_depth - 1usize
                    }
                } else {
                    if component_kind == 7u8 {
                        if delimiter_depth > 0usize {
                            delimiter_depth = delimiter_depth - 1usize
                        }
                    } else {
                        if component_kind == 9u8 {
                            if delimiter_depth > 0usize {
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
                output[slot] = TypeComponentHeader {
                    kind: component_kind,
                    start: token_start,
                    end: component_end,
                    depth: component_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                if component_kind == 4u8 {
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if component_kind == 6u8 {
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if component_kind == 8u8 {
                            delimiter_depth = delimiter_depth + 1usize
                        }
                    }
                }
                source_index = component_end
                break
            }
            source_index = next_source
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only match-arm spans from an explicit match-body range.
/// Patterns are bounded by a top-level `=>`; an optional top-level `if`
/// introduces a guard span. Arm bodies may be a balanced `{...}` block or an
/// expression ending at a top-level comma/semicolon. Pattern matching,
/// exhaustiveness, guard typing and recovery remain later AST/type stages.
@export(name: "jadren_selfhost_parse_match_arms", abi: "C")
@noalloc
pub fn parse_match_arms(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<MatchArmHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let first_info: TokenInfo = scan_token_info(bytes, source_index, end)
            if first_info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = first_info.start
            var pattern_end: UIntSize = end
            var guard_start: UIntSize = end
            var guard_end: UIntSize = end
            var arrow_start: UIntSize = end
            var arrow_end: UIntSize = end
            var pattern_depth: UIntSize = 0usize
            var guard_active: Bool = false
            var pattern_cursor: UIntSize = pattern_start
            while pattern_cursor < end {
                let info: TokenInfo = scan_token_info(bytes, pattern_cursor, end)
                if info.start >= end {
                    pattern_cursor = end
                    break
                }
                let token_start: UIntSize = info.start
                let next_source: UIntSize = info.end
                var symbol: UInt8 = 0u8
                if info.kind == 3u8 {
                    symbol = bytes[token_start]
                }
                if symbol == 0x28u8 {
                    pattern_depth = pattern_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        pattern_depth = pattern_depth + 1usize
                    } else {
                        if symbol == 0x29u8 {
                            if pattern_depth > 0usize {
                                pattern_depth = pattern_depth - 1usize
                            }
                        } else {
                            if symbol == 0x5Du8 {
                                if pattern_depth > 0usize {
                                    pattern_depth = pattern_depth - 1usize
                                }
                            }
                        }
                    }
                }
                if symbol == 0x3Du8 {
                    if next_source < end {
                        if bytes[next_source] == 0x3Eu8 {
                            if pattern_depth == 0usize {
                                arrow_start = token_start
                                arrow_end = next_source + 1usize
                                if !guard_active {
                                    pattern_end = arrow_start
                                } else {
                                    guard_end = arrow_start
                                }
                                pattern_cursor = arrow_end
                                break
                            }
                        }
                    }
                }
                if info.kind == 1u8 {
                    let width: UIntSize = next_source - token_start
                    if width == 2usize {
                        if bytes[token_start] == 0x69u8 {
                            if bytes[token_start + 1usize] == 0x66u8 {
                                if pattern_depth == 0usize {
                                    if !guard_active {
                                        pattern_end = token_start
                                        guard_start = next_source
                                        guard_active = true
                                    }
                                }
                            }
                        }
                    }
                }
                pattern_cursor = next_source
            }
            if arrow_start >= end {
                source_index = end
                break
            }
            if !guard_active {
                pattern_end = arrow_start
            }
            var body_start: UIntSize = end
            var body_end: UIntSize = end
            let body_info: TokenInfo = scan_token_info(bytes, arrow_end, end)
            if body_info.start < end {
                body_start = body_info.start
                var body_cursor: UIntSize = body_info.start
                var body_depth: UIntSize = 0usize
                var body_block: Bool = false
                if bytes[body_info.start] == 0x7Bu8 {
                    body_block = true
                    body_depth = 1usize
                    body_cursor = body_info.end
                }
                while body_cursor < end {
                    let body_token: TokenInfo = scan_token_info(bytes, body_cursor, end)
                    if body_token.start >= end {
                        body_cursor = end
                        break
                    }
                    var body_symbol: UInt8 = 0u8
                    if body_token.kind == 3u8 {
                        body_symbol = bytes[body_token.start]
                    }
                    if body_block {
                        if body_symbol == 0x7Bu8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x7Du8 {
                                if body_depth > 0usize {
                                    body_depth = body_depth - 1usize
                                }
                                if body_depth == 0usize {
                                    body_end = body_token.end
                                    body_cursor = body_token.end
                                    break
                                }
                            }
                        }
                    } else {
                        if body_symbol == 0x28u8 {
                            body_depth = body_depth + 1usize
                        } else {
                            if body_symbol == 0x5Bu8 {
                                body_depth = body_depth + 1usize
                            } else {
                                if body_symbol == 0x29u8 {
                                    if body_depth > 0usize {
                                        body_depth = body_depth - 1usize
                                    }
                                } else {
                                    if body_symbol == 0x5Du8 {
                                        if body_depth > 0usize {
                                            body_depth = body_depth - 1usize
                                        }
                                    } else {
                                        if body_depth == 0usize {
                                            if body_symbol == 0x2Cu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                            if body_symbol == 0x3Bu8 {
                                                body_end = body_token.start
                                                body_cursor = body_token.start
                                                break
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    body_cursor = body_token.end
                }
                if body_end == end {
                    body_end = body_cursor
                }
            }
            output[slot] = MatchArmHeader {
                pattern_start: pattern_start,
                pattern_end: pattern_end,
                guard_start: guard_start,
                guard_end: guard_end,
                body_start: body_start,
                body_end: body_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = body_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if bytes[separator.start] == 0x2Cu8 {
                        source_index = separator.end
                    } else {
                        if separator.start == source_index {
                            if bytes[separator.start] == 0x3Bu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits top-level syntax-only pattern nodes from an explicit pattern range.
/// Wildcards, qualified paths, literals and constructor paths are retained as
/// bounded spans. Constructor payloads are paired with one scalar delimiter
/// depth counter; binding, exhaustiveness, type checking and recovery are
/// intentionally deferred to later compiler stages.
@export(name: "jadren_selfhost_parse_pattern_headers", abi: "C")
@noalloc
pub fn parse_pattern_headers(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            let pattern_start: UIntSize = info.start
            let next_source: UIntSize = info.end
            var pattern_end: UIntSize = next_source
            var payload_start: UIntSize = end
            var payload_end: UIntSize = end
            var pattern_kind: UInt8 = 2u8
            var pattern_depth: UIntSize = 0usize
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[pattern_start]
            }
            if info.kind == 1u8 {
                if next_source - pattern_start == 1usize {
                    if bytes[pattern_start] == 0x5Fu8 {
                        pattern_kind = 1u8
                    }
                }
            }
            if pattern_kind == 1u8 {
                pattern_kind = 1u8
            } else {
                let bool_kind: UInt8 = boolean_literal_kind(
                    bytes,
                    info.kind,
                    pattern_start,
                    next_source,
                )
                if info.kind == 2u8 {
                    pattern_kind = 3u8
                } else {
                    if bool_kind != 0u8 {
                        pattern_kind = 3u8
                    } else {
                        if symbol == 0x22u8 {
                            pattern_kind = 3u8
                        } else {
                            if symbol == 0x27u8 {
                                pattern_kind = 3u8
                            }
                        }
                    }
                }
            }
            if pattern_kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = next_source
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    pattern_end = quoted.end
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    if pattern_end == next_source {
                        pattern_end = cursor
                    }
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = next_source
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        pattern_end = quoted.end
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        if pattern_end == next_source {
                            pattern_end = cursor
                        }
                    }
                }
            } else {
                if info.kind == 1u8 {
                    var path_cursor: UIntSize = next_source
                    var path_done: Bool = false
                    while path_cursor < end {
                        let separator: TokenInfo = scan_token_info(bytes, path_cursor, end)
                        if separator.start >= end {
                            path_cursor = end
                            break
                        }
                        var separator_symbol: UInt8 = 0u8
                        if separator.kind == 3u8 {
                            separator_symbol = bytes[separator.start]
                        }
                        if separator_symbol == 0x2Eu8 {
                            let segment: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if segment.start < end {
                                if segment.kind == 1u8 {
                                    pattern_end = segment.end
                                    path_cursor = segment.end
                                    continue
                                }
                            }
                        }
                        if separator_symbol == 0x3Au8 {
                            let second: TokenInfo = scan_token_info(bytes, separator.end, end)
                            if second.start < end {
                                if second.kind == 3u8 {
                                    if bytes[second.start] == 0x3Au8 {
                                        let segment: TokenInfo = scan_token_info(
                                            bytes,
                                            second.end,
                                            end,
                                        )
                                        if segment.start < end {
                                            if segment.kind == 1u8 {
                                                pattern_end = segment.end
                                                path_cursor = segment.end
                                                continue
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        path_done = true
                        break
                    }
                    if path_done {
                        path_cursor = pattern_end
                    }
                    let constructor: TokenInfo = scan_token_info(bytes, pattern_end, end)
                    if constructor.start < end {
                        if constructor.kind == 3u8 {
                            if bytes[constructor.start] == 0x28u8 {
                                pattern_kind = 4u8
                                payload_start = constructor.end
                                var cursor: UIntSize = constructor.end
                                var nested_depth: UIntSize = 1usize
                                while cursor < end {
                                    let payload: TokenInfo = scan_token_info(bytes, cursor, end)
                                    if payload.start >= end {
                                        cursor = end
                                        break
                                    }
                                    var payload_symbol: UInt8 = 0u8
                                    if payload.kind == 3u8 {
                                        payload_symbol = bytes[payload.start]
                                    }
                                    if payload_symbol == 0x28u8 {
                                        nested_depth = nested_depth + 1usize
                                    } else {
                                        if payload_symbol == 0x29u8 {
                                            if nested_depth > 0usize {
                                                nested_depth = nested_depth - 1usize
                                            }
                                            if nested_depth == 0usize {
                                                payload_end = payload.start
                                                pattern_end = payload.end
                                                cursor = payload.end
                                                break
                                            }
                                        }
                                    }
                                    cursor = payload.end
                                }
                                if payload_end == end {
                                    payload_end = cursor
                                    pattern_end = cursor
                                }
                            }
                        }
                    }
                }
            }
            output[slot] = PatternHeader {
                kind: pattern_kind,
                start: pattern_start,
                end: pattern_end,
                payload_start: payload_start,
                payload_end: payload_end,
                depth: pattern_depth,
            }
            output_index = output_index + 1usize
            emitted = true
            source_index = pattern_end
            if source_index < end {
                let separator: TokenInfo = scan_token_info(bytes, source_index, end)
                if separator.start < end {
                    if separator.kind == 3u8 {
                        if bytes[separator.start] == 0x2Cu8 {
                            source_index = separator.end
                        } else {
                            if bytes[separator.start] == 0x7Cu8 {
                                source_index = separator.end
                            }
                        }
                    }
                }
            }
            break
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits syntax-only binding candidates from an explicit pattern range.
/// Bare identifiers are bindings; wildcard, literal, qualified-path and
/// constructor-head identifiers are deliberately excluded. This is a bounded
/// pre-stage for later binding/exhaustiveness/type checking and does not
/// resolve names.
@export(name: "jadren_selfhost_parse_pattern_bindings", abi: "C")
@noalloc
pub fn parse_pattern_bindings(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternBindingHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var path_pending: Bool = false
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    path_pending = false
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        path_pending = false
                        continue
                    }
                }
            }
            if info.kind == 1u8 {
                var wildcard: Bool = false
                if info.end - info.start == 1usize {
                    if bytes[info.start] == 0x5Fu8 {
                        wildcard = true
                    }
                }
                let next: TokenInfo = scan_token_info(bytes, info.end, end)
                var next_symbol: UInt8 = 0u8
                if next.kind == 3u8 {
                    next_symbol = bytes[next.start]
                }
                var path_segment: Bool = path_pending
                if next_symbol == 0x2Eu8 {
                    path_segment = true
                } else {
                    if next_symbol == 0x3Au8 {
                        path_segment = true
                    } else {
                        if next_symbol == 0x28u8 {
                            path_segment = true
                        }
                    }
                }
                if !wildcard {
                    if !path_segment {
                        output[slot] = PatternBindingHeader {
                            kind: 1u8,
                            start: info.start,
                            end: info.end,
                            depth: delimiter_depth,
                        }
                        output_index = output_index + 1usize
                        emitted = true
                        source_index = info.end
                        path_pending = false
                        break
                    }
                }
                source_index = info.end
                path_pending = false
                continue
            }
            if info.kind == 3u8 {
                if symbol == 0x28u8 {
                    delimiter_depth = delimiter_depth + 1usize
                    path_pending = false
                } else {
                    if symbol == 0x5Bu8 {
                        delimiter_depth = delimiter_depth + 1usize
                        path_pending = false
                    } else {
                        if symbol == 0x7Bu8 {
                            delimiter_depth = delimiter_depth + 1usize
                            path_pending = false
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth > 0usize {
                                    delimiter_depth = delimiter_depth - 1usize
                                }
                                path_pending = false
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth > 0usize {
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                    path_pending = false
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth > 0usize {
                                            delimiter_depth = delimiter_depth - 1usize
                                        }
                                        path_pending = false
                                    } else {
                                        if symbol == 0x2Eu8 {
                                            path_pending = true
                                        } else {
                                            if symbol == 0x3Au8 {
                                                path_pending = true
                                            } else {
                                                path_pending = false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                path_pending = false
            }
            source_index = info.end
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits bounded delimiter recovery records for an explicit pattern range.
/// Quoted strings/chars are skipped, unmatched closers are reported at their
/// own span, and an unclosed opener is reported from the first opener to the
/// caller-provided `end`. Full expected-token diagnostics remain a later
/// parser stage.
@export(name: "jadren_selfhost_parse_pattern_recovery", abi: "C")
@noalloc
pub fn parse_pattern_recovery(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternRecoveryHeader>,
) -> UIntSize {
    var source_index: UIntSize = start
    var output_index: UIntSize = 0usize
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    for slot in output.indices {
        var emitted: Bool = false
        while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            if symbol == 0x29u8 {
                                if delimiter_depth == 0usize {
                                    output[slot] = PatternRecoveryHeader {
                                        kind: 2u8,
                                        start: info.start,
                                        end: info.end,
                                        depth: 0usize,
                                    }
                                    output_index = output_index + 1usize
                                    emitted = true
                                    source_index = info.end
                                    break
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            } else {
                                if symbol == 0x5Du8 {
                                    if delimiter_depth == 0usize {
                                        output[slot] = PatternRecoveryHeader {
                                            kind: 2u8,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = output_index + 1usize
                                        emitted = true
                                        source_index = info.end
                                        break
                                    }
                                    delimiter_depth = delimiter_depth - 1usize
                                } else {
                                    if symbol == 0x7Du8 {
                                        if delimiter_depth == 0usize {
                                            output[slot] = PatternRecoveryHeader {
                                                kind: 2u8,
                                                start: info.start,
                                                end: info.end,
                                                depth: 0usize,
                                            }
                                            output_index = output_index + 1usize
                                            emitted = true
                                            source_index = info.end
                                            break
                                        }
                                        delimiter_depth = delimiter_depth - 1usize
                                    }
                                }
                            }
                        }
                    }
                }
            }
            source_index = info.end
        }
        if !emitted {
            if delimiter_depth > 0usize {
                output[slot] = PatternRecoveryHeader {
                    kind: 1u8,
                    start: first_open_start,
                    end: end,
                    depth: delimiter_depth,
                }
                output_index = output_index + 1usize
                emitted = true
                source_index = end
                delimiter_depth = 0usize
                first_open_start = end
            }
        }
        if !emitted {
            break
        }
    }
    return output_index
}

/// Emits the first bounded delimiter diagnostic for an explicit pattern range.
/// The caller-owned `stack` stores opener bytes so a mismatched closer can
/// report the expected closer without a heap-backed parser stack. Quoted
/// string/char spans are skipped and the output is at most one record.
@export(name: "jadren_selfhost_parse_pattern_diagnostics", abi: "C")
@noalloc
pub fn parse_pattern_diagnostics(
    bytes: read Slice<UInt8>,
    start: UIntSize,
    end: UIntSize,
    output: write Slice<PatternDiagnosticHeader>,
    stack: write Slice<UInt8>,
) -> UIntSize {
    var source_index: UIntSize = start
    var delimiter_depth: UIntSize = 0usize
    var first_open_start: UIntSize = end
    var output_index: UIntSize = 0usize
    var output_capacity: UIntSize = 0usize
    for slot in output.indices {
        output_capacity = output_capacity + 1usize
    }
    while source_index < end {
            let info: TokenInfo = scan_token_info(bytes, source_index, end)
            if info.start >= end {
                source_index = end
                break
            }
            var symbol: UInt8 = 0u8
            if info.kind == 3u8 {
                symbol = bytes[info.start]
            }
            if info.kind == 3u8 {
                if symbol == 0x22u8 {
                    var cursor: UIntSize = info.end
                    var escaped: Bool = false
                    while cursor < end {
                        let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                        if quoted.start >= end {
                            cursor = end
                            break
                        }
                        var quoted_symbol: UInt8 = 0u8
                        if quoted.kind == 3u8 {
                            quoted_symbol = bytes[quoted.start]
                        }
                        if escaped {
                            escaped = false
                        } else {
                            if quoted_symbol == 0x5Cu8 {
                                escaped = true
                            } else {
                                if quoted_symbol == 0x22u8 {
                                    cursor = quoted.end
                                    break
                                }
                            }
                        }
                        cursor = quoted.end
                    }
                    source_index = cursor
                    continue
                } else {
                    if symbol == 0x27u8 {
                        var cursor: UIntSize = info.end
                        var escaped: Bool = false
                        while cursor < end {
                            let quoted: TokenInfo = scan_token_info(bytes, cursor, end)
                            if quoted.start >= end {
                                cursor = end
                                break
                            }
                            var quoted_symbol: UInt8 = 0u8
                            if quoted.kind == 3u8 {
                                quoted_symbol = bytes[quoted.start]
                            }
                            if escaped {
                                escaped = false
                            } else {
                                if quoted_symbol == 0x5Cu8 {
                                    escaped = true
                                } else {
                                    if quoted_symbol == 0x27u8 {
                                        cursor = quoted.end
                                        break
                                    }
                                }
                            }
                            cursor = quoted.end
                        }
                        source_index = cursor
                        continue
                    }
                }
                if symbol == 0x28u8 {
                    if delimiter_depth == 0usize {
                        first_open_start = info.start
                    }
                    stack[delimiter_depth] = symbol
                    delimiter_depth = delimiter_depth + 1usize
                } else {
                    if symbol == 0x5Bu8 {
                        if delimiter_depth == 0usize {
                            first_open_start = info.start
                        }
                        stack[delimiter_depth] = symbol
                        delimiter_depth = delimiter_depth + 1usize
                    } else {
                        if symbol == 0x7Bu8 {
                            if delimiter_depth == 0usize {
                                first_open_start = info.start
                            }
                            stack[delimiter_depth] = symbol
                            delimiter_depth = delimiter_depth + 1usize
                        } else {
                            var is_closer: Bool = false
                            if symbol == 0x29u8 {
                                is_closer = true
                            } else {
                                if symbol == 0x5Du8 {
                                    is_closer = true
                                } else {
                                    if symbol == 0x7Du8 {
                                        is_closer = true
                                    }
                                }
                            }
                            if is_closer {
                                if delimiter_depth == 0usize {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 1u8,
                                            expected: 0u8,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: 0usize,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                let opener: UInt8 = stack[delimiter_depth - 1usize]
                                var expected: UInt8 = 0u8
                                if opener == 0x28u8 {
                                    expected = 0x29u8
                                } else {
                                    if opener == 0x5Bu8 {
                                        expected = 0x5Du8
                                    } else {
                                        expected = 0x7Du8
                                    }
                                }
                                if symbol != expected {
                                    if output_capacity > 0usize {
                                        output[0] = PatternDiagnosticHeader {
                                            kind: 3u8,
                                            expected: expected,
                                            actual: symbol,
                                            start: info.start,
                                            end: info.end,
                                            depth: delimiter_depth,
                                        }
                                        output_index = 1usize
                                    }
                                    return output_index
                                }
                                delimiter_depth = delimiter_depth - 1usize
                            }
                        }
                    }
                }
            }
            source_index = info.end
    }
    if delimiter_depth > 0usize {
                let opener: UInt8 = stack[delimiter_depth - 1usize]
                var expected: UInt8 = 0u8
                if opener == 0x28u8 {
                    expected = 0x29u8
                } else {
                    if opener == 0x5Bu8 {
                        expected = 0x5Du8
                    } else {
                        expected = 0x7Du8
                    }
                }
                if output_capacity > 0usize {
                    output[0] = PatternDiagnosticHeader {
                        kind: 2u8,
                        expected: expected,
                        actual: 0u8,
                        start: first_open_start,
                        end: end,
                        depth: delimiter_depth,
                    }
                    output_index = 1usize
                }
        return output_index
    }
    return output_index
}
