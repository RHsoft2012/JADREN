                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 1usize,
                    operand_a: parameter_expression.right_value,
                    operand_b: 0usize,
                    source_start: parameter_expression.right_start,
                    source_end: parameter_expression.right_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 3usize < output_capacity {
                output[record_base + 3usize] = Stage2JirRecord {
                    kind: 4u8,
                    opcode: parameter_expression.operator_opcode,
                    type_kind: 2u8,
                    flags: 0u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 1usize,
                    source_start: parameter_expression.expression_start,
                    source_end: parameter_expression.expression_end,
                }
                records_emitted = records_emitted + 1usize
            }
            if record_base + 4usize < output_capacity {
                output[record_base + 4usize] = Stage2JirRecord {
                    kind: 5u8,
                    opcode: 1u8,
                    type_kind: 2u8,
                    flags: 1u8,
                    function_index: function_index,
                    block_index: 0usize,
                    value_index: 2usize,
                    operand_a: 0usize,
                    operand_b: 0usize,
                    source_start: statements[return_statement_index].start,
                    source_end: parameter_expression.statement_end,
                }
                records_emitted = records_emitted + 1usize
            }
