module selfhost.token_counter;

/// Bootstrap dogfooding slice used by the self-hosting prototype.
///
/// The Rust compiler remains the bootstrap authority. This small, allocation-
/// free lexer primitive is intentionally expressible in the 0.1 core and can
/// later be composed into a Jadren lexer module without changing the bootstrap
/// contract.
@repr(C)
pub struct TokenSpan {
    pub start: UIntSize,
    pub end: UIntSize,
}

/// Stable token record used by the next self-hosted lexer layer.
@repr(C)
pub struct TokenInfo {
    pub kind: UInt8,
    pub start: UIntSize,
    pub end: UIntSize,
}

/// Allocation-free token stream summary used by the first parser-shaped slice.
@repr(C)
pub struct TokenCounts {
    pub identifiers: UIntSize,
    pub numbers: UIntSize,
    pub symbols: UIntSize,
    pub total: UIntSize,
}

/// Parser-shaped source summary used before a complete self-hosted AST.
/// The fields are deliberately small and caller-independent: the stage only
/// counts tokens and checks balanced `{}`/`()` delimiters without allocating.
@repr(C)
pub struct ParseSummary {
    pub tokens: UIntSize,
    pub braces: UIntSize,
    pub parentheses: UIntSize,
    pub errors: UIntSize,
}

/// Composite result produced by the first stage-2 frontend candidate.
///
/// The candidate deliberately owns no memory: every detailed record is
/// written into caller-provided slices and this 64-byte summary only reports
/// the records that were actually emitted. `status_flags` uses bit 0 for a
/// structurally balanced source range and bit 1 when the token output covered
/// the complete range. This is a bounded frontend hand-off, not a self-hosted
/// compiler or a replacement for the Rust bootstrap.
@repr(C)
pub struct FrontendStage2Summary {
    pub source_bytes: UIntSize,
    pub tokens_emitted: UIntSize,
    pub ast_items_emitted: UIntSize,
    pub function_headers_emitted: UIntSize,
    pub statements_emitted: UIntSize,
    pub calls_emitted: UIntSize,
    pub syntax_errors: UIntSize,
    pub status_flags: UIntSize,
}

/// Summary returned by the fused Stage-2 frontend-to-JIR hand-off.
///
/// The export below composes the existing caller-owned frontend tables and
/// JIR record stream without allocating or changing either existing ABI. The
/// status bits are intentionally separate: bit 0 means a syntax-valid
/// frontend range, bit 1 means the frontend token output was complete, bit 2
/// means the JIR output was complete. This is a bounded pipeline boundary,
/// not a self-hosted compiler or a replacement for the Rust bootstrap.
@repr(C)
pub struct Stage2PipelineSummary {
    pub source_bytes: UIntSize,
    pub tokens_emitted: UIntSize,
    pub syntax_errors: UIntSize,
    pub frontend_status_flags: UIntSize,
    pub records_required: UIntSize,
    pub records_emitted: UIntSize,
    pub functions_lowered: UIntSize,
    pub status_flags: UIntSize,
}

/// One deterministic record in the bounded stage-2 JIR hand-off.
///
/// `kind` is `1=type`, `2=function`, `3=block`, `4=instruction`, or
/// `5=terminator`. The first supported subset emits one signed 32-bit integer
/// type, functions with zero through two typed Int32 parameters, one entry block,
/// and either one integer
/// constant or a bounded sequence of integer constants and binary instructions
/// before the value-return terminator. Dense function/block/value IDs are
/// carried as indices. A function's `operand_a` stores its bounded parameter
/// count; those parameters occupy the first function-local SSA values. This
/// fixed record is an auditable bridge to the
/// canonical Rust JIR model, not its complete serialized representation.
@repr(C)
pub struct Stage2JirRecord {
    pub kind: UInt8,
    pub opcode: UInt8,
    pub type_kind: UInt8,
    pub flags: UInt8,
    pub function_index: UIntSize,
    pub block_index: UIntSize,
    pub value_index: UIntSize,
    pub operand_a: UIntSize,
    pub operand_b: UIntSize,
    pub source_start: UIntSize,
    pub source_end: UIntSize,
}

/// Summary for the bounded stage-2 JIR emitter.
///
/// `status_flags` uses bit 0 for structurally valid caller-owned tables, bit 1
/// for the supported semantic subset and bit 2 for complete output capacity.
/// A truncated output therefore reports status `3`, while a complete supported
/// lowering reports `7`. This remains a candidate hand-off and does not remove
/// the Rust bootstrap.
@repr(C)
pub struct Stage2JirSummary {
    pub functions_seen: UIntSize,
    pub statements_seen: UIntSize,
    pub calls_seen: UIntSize,
    pub records_required: UIntSize,
    pub records_emitted: UIntSize,
    pub functions_lowered: UIntSize,
    pub errors: UIntSize,
    pub status_flags: UIntSize,
}

/// C-compatible typed statement metadata emitted by the bounded self-host
/// producer.  The first internal slice contains exactly one immutable `let`
/// followed by `return`; it is intentionally not a general statement AST.
@repr(C)
pub struct TypedStatementHeader {
    pub kind: UInt8,
    pub flags: UInt8,
    pub type_kind: UInt8,
    pub reserved: UInt8,
    pub target_start: UIntSize,
    pub target_end: UIntSize,
    pub expression_node: UIntSize,
    pub start: UIntSize,
    pub end: UIntSize,
}

/// C-compatible typed conditional metadata for one bounded `if ... else ...`
/// return expression. The three roots point into a shared post-order AST.
@repr(C)
pub struct TypedIfReturnHeader {
    pub condition_node: UIntSize,
    pub then_node: UIntSize,
    pub else_node: UIntSize,
    pub start: UIntSize,
    pub end: UIntSize,
    pub kind: UInt8,
    pub type_kind: UInt8,
    pub reserved: [UInt8; 6],
}

/// C-compatible metadata for one bounded `while` with a mutable scalar local.
/// The initializer node, loop condition and body assignment share one
/// caller-owned typed AST; the Rust Stage-2 consumer lowers the explicit
/// StackAlloc/Load/Store loop.
@repr(C)
pub struct TypedWhileHeader {
    pub condition_node: UIntSize,
    pub start: UIntSize,
    pub end: UIntSize,
    pub kind: UInt8,
    pub type_kind: UInt8,
    pub reserved: [UInt8; 6],
}

/// C-compatible metadata for one bounded `if` value followed by a single
/// immutable local continuation. The control and binding records remain
/// separate caller-owned slices so the Rust consumer can validate each ABI
/// boundary independently.
@repr(C)
pub struct TypedIfValueContinuationHeader {
    pub continuation_node: UIntSize,
    pub binding_name_start: UIntSize,
    pub binding_name_end: UIntSize,
    pub type_kind: UInt8,
    pub reserved: [UInt8; 7],
}

/// C-compatible metadata for one bounded `if` value materialised into a
/// mutable local and followed by one post-join assignment.  The header keeps
/// the same 32-byte layout as the immutable continuation so the consumer can
/// reuse the caller-owned binding/AST validation while selecting the local
/// lowering contract explicitly through its export and capture magic.
@repr(C)
pub struct TypedIfValueLocalAssignmentHeader {
    pub continuation_node: UIntSize,
    pub binding_name_start: UIntSize,
    pub binding_name_end: UIntSize,
    pub type_kind: UInt8,
    pub reserved: [UInt8; 7],
}

/// Summary for the additive typed straight-line statement hand-off.  Status
/// bit 0 means source/metadata validation, bit 1 the exact bounded shape and
/// bit 2 complete caller-owned output capacity.
@repr(C)
pub struct TypedStatementStage2Summary {
    pub source_bytes: UIntSize,
    pub statements_required: UIntSize,
    pub statements_emitted: UIntSize,
    pub ast_nodes_required: UIntSize,
    pub ast_nodes_emitted: UIntSize,
    pub errors: UIntSize,
    pub status_flags: UIntSize,
    pub reserved: UIntSize,
}

/// Narrow source descriptor for the additive immutable-local Stage-2 slice.
/// This is intentionally one admitted straight-line initializer; it is not a
/// general statement AST or a mutable storage model.
struct Stage2LocalBindingInfo {
    valid: Bool,
    parameter_start: UIntSize,
    parameter_end: UIntSize,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    literal_start: UIntSize,
    literal_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    use_start: UIntSize,
    use_end: UIntSize,
    literal_value: UIntSize,
    operator_opcode: UInt8,
    parameter_on_left: Bool,
}

/// Narrow source descriptor for an immutable local whose value is a dense
/// literal binary initializer and is immediately passed to a direct call.
/// This is intentionally separate from `Stage2LocalBindingInfo`: the latter
/// carries one literal span for the existing alias/literal shapes, while this
/// descriptor retains both operand spans needed to emit the local SSA value.
struct Stage2LocalCallBinaryInfo {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    use_start: UIntSize,
    use_end: UIntSize,
    first_literal_value: UIntSize,
    second_literal_value: UIntSize,
    operator_opcode: UInt8,
}

/// Narrow source descriptor for a literal immutable local used as the left
/// operand of the direct-call binary argument. This keeps the local declaration
/// and the call expression separate so the emitter can preserve dense SSA
/// ordering without introducing a general local expression graph.
struct Stage2LocalBinaryCallArgumentInfo {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    literal_start: UIntSize,
    literal_end: UIntSize,
    local_use_start: UIntSize,
    local_use_end: UIntSize,
    right_literal_start: UIntSize,
    right_literal_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    literal_value: UIntSize,
    right_literal_value: UIntSize,
    operator_opcode: UInt8,
}

/// Narrow source descriptor for a literal used as the left operand and an
/// immutable local used as the right operand of a direct-call binary argument.
/// The local declaration remains separate from the call expression so the
/// emitter can preserve dense SSA order without a general expression graph.
struct Stage2BinaryLocalCallArgumentInfo {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    literal_start: UIntSize,
    literal_end: UIntSize,
    local_use_start: UIntSize,
    local_use_end: UIntSize,
    left_literal_start: UIntSize,
    left_literal_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
    literal_value: UIntSize,
    left_literal_value: UIntSize,
    operator_opcode: UInt8,
}

/// Narrow descriptor for a direct call whose result is materialised into one
/// immutable local before the function returns that local. This is deliberately
/// separate from argument locals: the call itself defines the local SSA value.
struct Stage2DirectCallResultBindingInfo {
    valid: Bool,
    declaration_start: UIntSize,
    declaration_end: UIntSize,
    use_start: UIntSize,
    use_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
}

fn stage2_invalid_direct_call_result_binding_info() -> Stage2DirectCallResultBindingInfo {
    return Stage2DirectCallResultBindingInfo {
        valid: false,
        declaration_start: 0usize,
        declaration_end: 0usize,
        use_start: 0usize,
        use_end: 0usize,
        return_start: 0usize,
        return_end: 0usize,
    }
}

struct Stage2TwoLocalBindingInfo {
    valid: Bool,
    first_declaration_start: UIntSize,
    first_declaration_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    first_literal_value: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    second_declaration_start: UIntSize,
    second_declaration_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    second_literal_value: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    binary_start: UIntSize,
    binary_end: UIntSize,
    operator_opcode: UInt8,
    return_start: UIntSize,
    return_end: UIntSize,
}

struct Stage2ThreeLocalBindingInfo {
    valid: Bool,
    first_declaration_start: UIntSize,
    first_declaration_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    first_literal_value: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    second_declaration_start: UIntSize,
    second_declaration_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    second_literal_value: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
    third_declaration_start: UIntSize,
    third_declaration_end: UIntSize,
    third_literal_start: UIntSize,
    third_literal_end: UIntSize,
    third_literal_value: UIntSize,
    third_use_start: UIntSize,
    third_use_end: UIntSize,
    first_binary_start: UIntSize,
    first_binary_end: UIntSize,
    second_binary_start: UIntSize,
    second_binary_end: UIntSize,
    return_start: UIntSize,
    return_end: UIntSize,
}

struct Stage2ParameterTwoLocalBindingInfo {
    valid: Bool,
    parameter_start: UIntSize,
    parameter_end: UIntSize,
    first_declaration_start: UIntSize,
    first_declaration_end: UIntSize,
    first_literal_start: UIntSize,
    first_literal_end: UIntSize,
    first_literal_value: UIntSize,
    first_use_start: UIntSize,
    first_use_end: UIntSize,
    second_declaration_start: UIntSize,
    second_declaration_end: UIntSize,
    second_literal_start: UIntSize,
    second_literal_end: UIntSize,
    second_literal_value: UIntSize,
    second_use_start: UIntSize,
    second_use_end: UIntSize,
