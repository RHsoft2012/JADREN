module selfhost.typed_statement_assignment_int32_five_locals_cross_local

fn local_value() -> Int32 {
    let first: Int32 = 10;
    let second: Int32 = 20;
    let third: Int32 = 30;
    let fourth: Int32 = 40;
    let fifth: Int32 = 50;
    first = first + 1;
    second = first - 2;
    third = second * 3;
    fourth = third + 4;
    fifth = fourth + third;
    return fifth;
}
