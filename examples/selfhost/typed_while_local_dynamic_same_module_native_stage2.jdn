module examples.selfhost.typed_while_local_dynamic_same_module_native_stage2

// JADREN_STAGE2_DYNAMIC_TYPED_CALL
// JADREN_STAGE2_DYNAMIC_MUTABLE_BODY_LET
// JADREN_STAGE2_DYNAMIC_SAME_MODULE_DEFINITIONS
// This fixture keeps the dynamic while/call shape but lowers helper and
// nested from this same module. No C helper object is needed at link time.
fn local_value() -> Int32 {
    var counter: Int32 = 0;
    while counter < 4 {
        var step: Int32 = helper(counter + 1, nested(counter, 2));
        step = helper(step, 1);
        counter = counter + step;
        if counter < 4 { continue; }
    }
    return counter;
}

fn helper(left: Int32, right: Int32) -> Int32 {
    return left + right;
}

fn nested(left: Int32, right: Int32) -> Int32 {
    return left * right;
}
