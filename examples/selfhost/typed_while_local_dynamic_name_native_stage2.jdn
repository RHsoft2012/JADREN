module examples.selfhost.typed_while_local_dynamic_name_native_stage2

// Native producer -> JST2WHD1 -> dynamic assignments with a bound local RHS.
fn local_value() -> Int32 {
    var counter: Int32 = 0;
    while counter < 4 {
        counter = counter + 1;
        counter = counter + counter;
        counter = counter + 1;
        counter = counter + counter;
    }
    return counter;
}
