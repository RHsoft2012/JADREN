module examples.selfhost.typed_nested_while_local_inner_list_native_stage2

// Native producer -> JST2WN01 -> nested Int32 CFG with a dynamic inner body list.
fn local_value() -> Int32 {
    var outer: Int32 = 0;
    while outer < 4 {
        outer = outer + 1;
        var inner: Int32 = 0;
        while inner < 4 {
            inner = inner + 1;
            inner = inner + inner;
        }
        outer = outer + outer;
    }
    return outer;
}
