module examples.selfhost.typed_while_local_multiple_control_stage2

// Two conditional controls are lowered in source order. The first continue
// skips the tail on the first two passes; the second break exits at 14.

fn main() -> Int32 {
    var counter: Int32 = 0
    while counter < 20 {
        counter = counter + 1
        if counter < 3 { continue }
        if counter > 12 { break }
        counter = counter + 10
    }
    return counter
}
