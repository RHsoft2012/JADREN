module examples.selfhost.typed_nested_while_local_conditional_native_stage2

// Native producer -> JST2WNQ1 -> nested Int32 while with an inner break.
fn local_value() -> Int32 {
    var outer: Int32 = 0;
    while outer < 4 {
        outer = outer + 1;
        var inner: Int32 = 0;
        while inner < 4 {
            inner = inner + 1;
            if inner < 2 { break; }
        }
        outer = outer + outer;
    }
    return outer;
}
