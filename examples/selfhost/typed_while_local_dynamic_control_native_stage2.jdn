module examples.selfhost.typed_while_local_dynamic_control_native_stage2

// Native producer -> JST2WHG1 -> dynamic assignments plus conditional controls.
fn local_value() -> Int32 {
    var counter: Int32 = 0;
    while counter < 4 {
        counter = counter + 1;
        if counter < 2 { continue; }
        counter = counter + 1;
        if counter < 4 { break; }
    }
    return counter;
}
