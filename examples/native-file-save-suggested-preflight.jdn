module examples.native_file_save_suggested_preflight

// A non-interactive native smoke for the suggested export name contract. The
// basename contains a path separator and is rejected before GetSaveFileNameW
// can open a dialog, therefore all caller-owned outputs must stay unchanged.
fn main() -> Int32 {
    var path: [UInt8; 4] = [91u8, 91u8, 91u8, 91u8]
    var path_length: [UIntSize; 1] = [77usize]
    if ui_file_save_suggested_exact("Export CSV", "bad/path", "csv", path, path_length) {
        return 1
    }
    if path[0] != 91u8 { return 2 }
    if path[1] != 91u8 { return 3 }
    if path_length[0] != 77usize { return 4 }
    return 0
}
