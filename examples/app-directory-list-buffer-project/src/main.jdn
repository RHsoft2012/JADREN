                            status = 25
                        }
                    }
                    if status == 0 {
                        if item_count[0] != 782usize {
                            status = 26
                        }
                    }
                    if status == 0 {
                        if ! dir_list_ex_exact_buffer("target/app-directory-list-buffer-project-smoke/empty",
                        names,
                        32usize,
                        names_length,
                        kinds,
                        4usize,
                        item_count) {
                            status = 27
                        }
                    }
                    if status == 0 {
                        if names_length[0] != 0usize {
                            status = 28
                        }
                    }
                    if status == 0 {
                        if item_count[0] != 0usize {
                            status = 29
                        }
                    }
                }
            }
        }
    }
    cleanup()
    return status
