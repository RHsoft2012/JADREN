module examples.http_reactor_keep_alive;

// Two requests on one native reactor connection. The fixture deliberately
// keeps the request size bounded and exact; partial request accumulation is a
// later protocol layer. The response buffer is larger than the serialized
// response, so the prefix-send API proves that only response_length is sent.
fn main() -> Int32 {
    let listener: UIntSize = net_tcp_listen(38138u16)
    if (listener as Int32) == 0 { return 10 }
    let reactor: UIntSize = net_reactor_open(4u32, 8u32)
    if (reactor as Int32) == 0 { net_socket_close(listener); return 11 }

    let accept_operation: UIntSize = net_reactor_submit_accept(reactor, listener, 10usize)
    if (accept_operation as Int32) == 0 {
        net_reactor_close(reactor); net_socket_close(listener); return 12
    }
    let accepted_events: UInt32 = net_reactor_poll(reactor, 5000u32)
    if accepted_events == 0u32 {
        net_reactor_close(reactor); net_socket_close(listener); return 13
    }
    let client: UIntSize = net_reactor_event_socket(reactor, 0u32)
    if (client as Int32) == 0 {
        net_reactor_close(reactor); net_socket_close(listener); return 14
    }

    // GET /hello plus Host header and CRLF terminator: exactly 40 bytes.
    var request: [UInt8; 40] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var body: [UInt8; 2] = [79u8, 75u8]
    var response: [UInt8; 144] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]

    let receive_operation: UIntSize = net_reactor_submit_receive_buffer(
        reactor, client, request, 10usize)
    if (receive_operation as Int32) == 0 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 15
    }
    let received_events: UInt32 = net_reactor_poll(reactor, 5000u32)
    if received_events == 0u32 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 16
    }
    let received_bytes: UIntSize = net_reactor_event_bytes(reactor, 0u32)
    if (received_bytes as Int32) != 40 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 17
    }
    if !http_request_is_complete(request) {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 18
    }
    if !http_route_match(request, "GET", "/hello") {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 19
    }

    let first_response_length: UIntSize = http_response_write_ex(
        200u16, "text/plain", body, true, response)
    if first_response_length == 0usize {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 20
    }
    let first_send: UIntSize = net_reactor_submit_send_buffer_prefix(
        reactor, client, response, first_response_length, 30usize)
    if (first_send as Int32) == 0 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 21
    }
    let first_sent_events: UInt32 = net_reactor_poll(reactor, 5000u32)
    if first_sent_events == 0u32 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 22
    }
    let first_sent_bytes: UIntSize = net_reactor_event_bytes(reactor, 0u32)
    if (first_sent_bytes as Int32) != (first_response_length as Int32) {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 23
    }

    // The client keeps the connection open and sends the same bounded request.
    let second_receive: UIntSize = net_reactor_submit_receive_buffer(
        reactor, client, request, 20usize)
    if (second_receive as Int32) == 0 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 24
    }
    let second_received_events: UInt32 = net_reactor_poll(reactor, 5000u32)
    if second_received_events == 0u32 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 25
    }
    let second_received_bytes: UIntSize = net_reactor_event_bytes(reactor, 0u32)
    if (second_received_bytes as Int32) != 40 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 26
    }
    if !http_request_is_complete(request) {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 27
    }

    let second_response_length: UIntSize = http_response_write_ex(
        200u16, "text/plain", body, false, response)
    if second_response_length == 0usize {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 28
    }
    let second_send: UIntSize = net_reactor_submit_send_buffer_prefix(
        reactor, client, response, second_response_length, 40usize)
    if (second_send as Int32) == 0 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 29
    }
    let second_sent_events: UInt32 = net_reactor_poll(reactor, 5000u32)
    if second_sent_events == 0u32 {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 30
    }
    let second_sent_bytes: UIntSize = net_reactor_event_bytes(reactor, 0u32)
    if (second_sent_bytes as Int32) != (second_response_length as Int32) {
        net_socket_close(client); net_reactor_close(reactor); net_socket_close(listener); return 31
    }

    let client_closed: Bool = net_socket_close(client)
    let reactor_closed: Bool = net_reactor_close(reactor)
    let listener_closed: Bool = net_socket_close(listener)
    if !client_closed { return 32 }
    if !reactor_closed { return 33 }
    if !listener_closed { return 34 }
    return 0
}
