module examples.dynamic_array_nested

// DynamicArray<T> remains the source spelling of owning Buffer<T> even when
// the element is another dynamic array. The existing move-aware Buffer ABI is
// reused; no second descriptor or runtime family is introduced.
fn main() -> Int32 {
    let outer_created: Result<DynamicArray<DynamicArray<Int32>>, Int32> = buffer_create(0usize)
    let first_created: Result<DynamicArray<Int32>, Int32> = buffer_create(0usize)
    let second_created: Result<DynamicArray<Int32>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match first_created {
                Ok(first) => {
                    match second_created {
                        Ok(second) => {
                            if !buffer_append(first, 11) { result_code = 1 }
                            if !buffer_append(second, 22) { result_code = 2 }
                            if !buffer_append(outer, first) { result_code = 3 }
                            if !buffer_append(outer, second) { result_code = 4 }
                            if buffer_length(outer) != 2usize { result_code = 5 }
                            if outer[0][0] != 11 { result_code = 6 }
                            if outer[1][0] != 22 { result_code = 7 }
                            if !buffer_clear_move(outer) { result_code = 8 }
                            if buffer_length(outer) != 0usize { result_code = 9 }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
