module examples.stdlib_buffer_owning_generic_enum_nested

// A generic C-layout enum can carry more than one owning Buffer descriptor
// after materialization.  The nested value must move through the enum without
// duplicating either descriptor or the OwnedString payload.
@repr(C)
enum Event<T> {
    Idle,
    Ready(T),
    Done,
}

fn main() -> Int32 {
    let events_created: Result<Buffer<Event<Buffer<Buffer<OwnedString>>>>, Int32> = buffer_create(0usize)
    let nested_created: Result<Buffer<Buffer<OwnedString>>, Int32> = buffer_create(0usize)
    let leaf_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
    let output_created: Result<Buffer<Buffer<OwnedString>>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match events_created {
        Error(status) => { result_code = status }
        Ok(events) => {
            match nested_created {
                Error(status) => { result_code = status }
                Ok(nested) => {
                    match leaf_created {
                        Error(status) => { result_code = status }
                        Ok(leaf) => {
                            let text_created: Result<OwnedString, Int32> = string_owned_from("Nested")
                            match text_created {
                                Error(status) => { result_code = status }
                                Ok(text) => {
                                    if !buffer_append(leaf, text) { result_code = 1 }
                                    if !buffer_append(nested, leaf) { result_code = 2 }
                                    let ready: Event<Buffer<Buffer<OwnedString>>> = Event.Ready(nested)
                                    if !buffer_append(events, ready) { result_code = 3 }
                                }
                            }
                        }
                    }
                }
            }
            match output_created {
                Error(status) => { result_code = status }
                Ok(output_nested) => {
                    let output: Event<Buffer<Buffer<OwnedString>>> = Event.Ready(output_nested)
                    let moved: Int32 = buffer_remove_move_into_status(events, 0usize, output)
                    if moved != 0 { result_code = moved }
                    match output {
                        Event.Ready(value) => {
                            if buffer_length(value) != 1usize { result_code = 4 }
                            if buffer_length(value[0]) != 1usize { result_code = 5 }
                            if string_owned_length(value[0][0]) != 6usize { result_code = 6 }
                            let cleared: Int32 = buffer_clear_move_status(value)
                            if cleared != 0 { result_code = cleared }
                        }
                        _ => { result_code = 7 }
                    }
                }
            }
            let cleared_events: Int32 = buffer_clear_move_status(events)
            if cleared_events != 0 { result_code = cleared_events }
        }
    }
    return result_code
}
