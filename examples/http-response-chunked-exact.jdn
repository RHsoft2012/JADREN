module examples.http_response_chunked_exact

// Chunked decoding is explicit and bounded: the complete response is already
// in caller-owned storage, and no output is changed when framing/capacity is
// invalid.
fn main() -> Int32 {
    var response: [UInt8; 88] = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 50u8, 48u8, 48u8, 32u8, 79u8, 75u8, 13u8, 10u8, 84u8, 114u8, 97u8, 110u8, 115u8, 102u8, 101u8, 114u8, 45u8, 69u8, 110u8, 99u8, 111u8, 100u8, 105u8, 110u8, 103u8, 58u8, 32u8, 99u8, 104u8, 117u8, 110u8, 107u8, 101u8, 100u8, 13u8, 10u8, 13u8, 10u8, 52u8, 13u8, 10u8, 74u8, 68u8, 78u8, 33u8, 13u8, 10u8, 54u8, 13u8, 10u8, 99u8, 104u8, 117u8, 110u8, 107u8, 33u8, 13u8, 10u8, 48u8, 13u8, 10u8, 88u8, 45u8, 84u8, 114u8, 97u8, 105u8, 108u8, 101u8, 114u8, 58u8, 32u8, 121u8, 101u8, 115u8, 13u8, 10u8, 13u8, 10u8]
    var output: [UInt8; 10] = [77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8, 77u8]
    var length: [UIntSize; 1] = [91usize]

    if !http_response_body_chunked_exact(response, output, length) { return 1 }
    if length[0] != 10usize { return 2 }
    if output[0] != 74u8 { return 3 }
    if output[3] != 33u8 { return 4 }
    if output[4] != 99u8 { return 5 }
    if output[9] != 33u8 { return 6 }

    var too_small: [UInt8; 9] = [55u8, 55u8, 55u8, 55u8, 55u8, 55u8, 55u8, 55u8, 55u8]
    var unchanged: [UIntSize; 1] = [123usize]
    if http_response_body_chunked_exact(response, too_small, unchanged) { return 7 }
    if too_small[0] != 55u8 { return 8 }
    if unchanged[0] != 123usize { return 9 }

    return 0
}
