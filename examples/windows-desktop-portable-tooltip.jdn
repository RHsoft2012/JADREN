module windows_desktop_portable_tooltip.main

// Retained hover help is declared next to the event control. Windows uses its
// native tooltip controller; Linux/X11 paints the same bounded hint above the
// hovered button without creating a second child window.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 1 {
        ui_set_status("Run clicked.")
    }
    if event_id == 2 {
        ui_set_status("Checkbox changed.")
    }
    return event_id
}

fn main() -> Int32 {
    let root: Int32 = ui_app_begin("Jadren Portable Tooltip", 720, 420, 0xF6F8FCu32)
    if root == 0 { return 1 }
    let panel: Int32 = ui_app_panel(root, 640, 260, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 2 }
    let title: Int32 = ui_app_label(panel, "Hover a control for help.", 560, 36,
                                     0x111827u32, 0xFFFFFFu32, 8, 1)
    let status: Int32 = ui_app_status(panel, "Ready.", 560, 38,
                                      0x111827u32, 0xDCFCE7u32, 8, 1)
    let run: Int32 = ui_app_button(panel, "Run action", 1, 180, 42,
                                   0xFFFFFFu32, 0x168EF5u32, 12, 0)
    let run_tip: Bool = ui_app_tooltip(run, "Runs the current action.", 240, 42,
                                       0xFFFFFFu32, 0x252526u32, 8)
    let checkbox: Int32 = ui_app_checkbox(panel, "Enable feature", 2, 240, 42,
                                          0x111827u32, 0x18C964u32, 12, 0, 1)
    let checkbox_tip: Bool = ui_app_tooltip(checkbox,
                                            "Toggles the optional feature.",
                                            260, 42, 0xFFFFFFu32, 0x252526u32, 8)
    if title == 0 { return 3 }
    if status == 0 { return 3 }
    if run == 0 { return 3 }
    if checkbox == 0 { return 3 }
    if !run_tip { return 4 }
    if !checkbox_tip { return 4 }
    if !ui_app_end(panel) { return 5 }
    if !ui_app_end(root) { return 6 }
    return ui_app_run()
}
