                            status = 52
                        }
                    }
                    if status == 0 {
                        length[0] = 783usize
                        if table.export_json_exact_buffer(0,
                        short,
                        8usize,
                        length) {
                            status = 53
                        }
                    }
                    if status == 0 {
                        if short[0] != 91u8 {
                            status = 54
                        }
                    }
                    if status == 0 {
                        if length[0] != 783usize {
                            status = 55
                        }
                    }
                }
            }
        }
    }
    list.clear(0)
    table.clear(0)
    return status
