module examples.http_server;

// One-request native Jadren HTTP server: TCP transport, route matcher and
// bounded response writer are composed directly without an external bridge.
fn main() -> Int32 {
    let listener: UIntSize = net_tcp_listen(38124u16)
    if (listener as Int32) == 0 { return 10 }
    let client: UIntSize = net_tcp_accept(listener)
    if (client as Int32) == 0 {
        net_socket_close(listener)
        return 11
    }
    let timeout_configured: Bool = net_socket_set_timeout(client, 2000u32)
    if !timeout_configured {
        net_socket_close(client)
        net_socket_close(listener)
        return 12
    }

    var request: [UInt8; 40] = [71u8, 69u8, 84u8, 32u8, 47u8, 104u8, 101u8, 108u8, 108u8, 111u8, 32u8, 72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 13u8, 10u8, 72u8, 111u8, 115u8, 116u8, 58u8, 32u8, 108u8, 111u8, 99u8, 97u8, 108u8, 104u8, 111u8, 115u8, 116u8, 13u8, 10u8, 13u8, 10u8]
    let received: UIntSize = net_tcp_receive(client, request)
    if (received as Int32) == 0 {
        net_socket_close(client)
        net_socket_close(listener)
        return 13
    }

    let matched: Bool = http_route_match(request, "GET", "/hello")
    if matched {
        var body: [UInt8; 4] = [65u8, 104u8, 111u8, 106u8]
        var response: [UInt8; 87] = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 50u8, 48u8, 48u8, 32u8, 79u8, 75u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 84u8, 121u8, 112u8, 101u8, 58u8, 32u8, 116u8, 101u8, 120u8, 116u8, 47u8, 112u8, 108u8, 97u8, 105u8, 110u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 76u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 52u8, 13u8, 10u8, 67u8, 111u8, 110u8, 110u8, 101u8, 99u8, 116u8, 105u8, 111u8, 110u8, 58u8, 32u8, 99u8, 108u8, 111u8, 115u8, 101u8, 13u8, 10u8, 13u8, 10u8, 65u8, 104u8, 111u8, 106u8]
        let written: UIntSize = http_response_write(200u16, "text/plain", body, response)
        let sent: UIntSize = net_tcp_send_prefix(client, response, written)
        net_socket_close(client)
        net_socket_close(listener)
        if (written as Int32) != 87 { return 14 }
        if (sent as Int32) != 87 { return 15 }
        return 0
    }

    var body: [UInt8; 9] = [78u8, 111u8, 116u8, 32u8, 102u8, 111u8, 117u8, 110u8, 100u8]
    var response: [UInt8; 99] = [72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 32u8, 52u8, 48u8, 52u8, 32u8, 78u8, 111u8, 116u8, 32u8, 70u8, 111u8, 117u8, 110u8, 100u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 84u8, 121u8, 112u8, 101u8, 58u8, 32u8, 116u8, 101u8, 120u8, 116u8, 47u8, 112u8, 108u8, 97u8, 105u8, 110u8, 13u8, 10u8, 67u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 45u8, 76u8, 101u8, 110u8, 103u8, 116u8, 104u8, 58u8, 32u8, 57u8, 13u8, 10u8, 67u8, 111u8, 110u8, 110u8, 101u8, 99u8, 116u8, 105u8, 111u8, 110u8, 58u8, 32u8, 99u8, 108u8, 111u8, 115u8, 101u8, 13u8, 10u8, 13u8, 10u8, 78u8, 111u8, 116u8, 32u8, 102u8, 111u8, 117u8, 110u8, 100u8]
    let written: UIntSize = http_response_write(404u16, "text/plain", body, response)
    let sent: UIntSize = net_tcp_send_prefix(client, response, written)
    net_socket_close(client)
    net_socket_close(listener)
    if (written as Int32) != 99 { return 16 }
    if (sent as Int32) != 99 { return 17 }
    return 0
}
