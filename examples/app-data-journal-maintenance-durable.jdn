module examples.app_data_journal_maintenance_durable

// Combine byte and frame limits into one caller-driven maintenance boundary.
// The runtime never creates a worker; the application may call this from its
// own scheduler tick.
fn main() -> Int32 {
    file_delete("target/jadren/app-data-journal-maintenance-durable.journal")
    file_delete("target/jadren/app-data-journal-maintenance-durable.scratch")
    file_delete("target/jadren/app-data-journal-maintenance-durable.tmp")
    file_delete("target/jadren/app-data-journal-maintenance-durable.lock")
    file_delete("target/jadren/app-data-journal-maintenance-durable.index")
    file_delete("target/jadren/app-data-journal-maintenance-durable.index.tmp")
    file_delete("target/jadren/app-data-journal-maintenance-durable.csv")
    file_delete("target/jadren/app-data-journal-maintenance-durable.csv.tmp")

    if !app_state_set_int("counter", 1i64) { return 1 }
    if !app_data_journal_append_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.scratch",
        "target/jadren/app-data-journal-maintenance-durable.lock"
    ) { return 2 }
    if !app_state_set_int("counter", 2i64) { return 3 }
    if !app_data_journal_append_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.scratch",
        "target/jadren/app-data-journal-maintenance-durable.lock"
    ) { return 4 }

    var before_stats: [UIntSize; 2] = [0usize, 0usize]
    if !app_data_journal_stats_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        before_stats
    ) { return 5 }
    if before_stats[0] != 2usize { return 6 }
    if before_stats[1] <= 1usize { return 7 }
    var span: [UIntSize; 3] = [0usize, 0usize, 0usize]
    if !app_data_journal_frame_span_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        0usize,
        span
    ) { return 30 }
    if span[0] != 0usize { return 31 }
    if span[1] <= span[2] { return 32 }
    if span[2] == 0usize { return 33 }
    var plan: [UIntSize; 3] = [777usize, 777usize, 777usize]
    if !app_data_journal_maintenance_plan_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        before_stats[1] - 1usize,
        8usize,
        plan
    ) { return 8 }
    if plan[0] != 1usize { return 9 }
    if plan[1] != before_stats[0] { return 10 }
    if plan[2] != before_stats[1] { return 11 }
    if !app_data_journal_compact_if_needed_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.scratch",
        "target/jadren/app-data-journal-maintenance-durable.tmp",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        before_stats[1] - 1usize,
        1usize
    ) { return 12 }

    var after_stats: [UIntSize; 2] = [0usize, 0usize]
    if !app_data_journal_stats_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        after_stats
    ) { return 13 }
    if after_stats[0] != 1usize { return 14 }
    if after_stats[1] >= before_stats[1] { return 15 }

    if !app_data_journal_build_index_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.index.tmp",
        "target/jadren/app-data-journal-maintenance-durable.lock"
    ) { return 34 }
    var indexed_span: [UIntSize; 3] = [777usize, 777usize, 777usize]
    if !app_data_journal_index_lookup_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        0usize,
        indexed_span
    ) { return 35 }
    if indexed_span[0] != 0usize { return 36 }
    if indexed_span[1] <= indexed_span[2] { return 37 }
    if indexed_span[2] == 0usize { return 38 }
    var page: [UIntSize; 6] = [0usize, 0usize, 0usize, 0usize, 0usize, 0usize]
    let page_count: UIntSize = app_data_journal_index_range_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        0usize,
        2usize,
        page,
    )
    if page_count != 1usize { return 57 }
    if page[0] != indexed_span[0] { return 58 }
    if page[1] != indexed_span[1] { return 59 }
    if page[2] != indexed_span[2] { return 60 }
    var short_page: [UIntSize; 2] = [777usize, 777usize]
    if app_data_journal_index_range_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        0usize,
        2usize,
        short_page,
    ) != 0usize { return 61 }
    if short_page[0] != 777usize { return 62 }
    if short_page[1] != 777usize { return 64 }
    if app_data_journal_index_range_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        1usize,
        1usize,
        page,
    ) != 0usize { return 63 }

    // Read the same indexed page as contiguous payload bytes. Metadata adds
    // the payload output offset so a virtualized caller can slice the page
    // without another lock/read round-trip.
    var page_payload: [UInt8; 1024] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var page_metadata: [UIntSize; 4] = [777usize, 777usize, 777usize, 777usize]
    let payload_page_count: UIntSize = app_data_journal_index_read_page_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.index",
        "target/jadren/app-data-journal-maintenance-durable.lock",
        0usize,
        1usize,
        page_payload,
        page_metadata,
    )
    if payload_page_count != 1usize { return 65 }
    if page_metadata[0] != indexed_span[0] { return 66 }
    if page_metadata[1] != indexed_span[1] { return 67 }
    if page_metadata[2] != indexed_span[2] { return 68 }
    if page_metadata[3] != 0usize { return 69 }
    let exact_payload_length: UIntSize = app_data_journal_frame_length_durable(
        "target/jadren/app-data-journal-maintenance-durable.journal",
        "target/jadren/app-data-journal-maintenance-durable.lock",
