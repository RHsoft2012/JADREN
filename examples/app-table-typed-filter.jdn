module examples.app_table_typed_filter

// Typed filters copy complete rows into a destination table.  They match the
// declared column kind and never fall back to lexical text comparison.
fn main() -> Int32 {
    app_table_clear(0)
    app_table_clear(1)
    app_table_clear(2)
    app_table_clear(3)
    if !app_table_set_column_name(0, 0, "signed") { return 1 }
    if !app_table_set_column_name(0, 1, "unsigned") { return 2 }
    if !app_table_set_column_name(0, 2, "ratio") { return 3 }
    if !app_table_set_column_name(0, 3, "enabled") { return 4 }
    if !app_table_set_column_type(0, 0, 1) { return 5 }
    if !app_table_set_column_type(0, 1, 2) { return 6 }
    if !app_table_set_column_type(0, 2, 4) { return 7 }
    if !app_table_set_column_type(0, 3, 3) { return 8 }
    if !app_table_append_row(0) { return 9 }
    if !app_table_append_row(0) { return 10 }
    if !app_table_set_int(0, 0, 0, 7 as Int64) { return 11 }
    if !app_table_set_int(0, 1, 0, -2 as Int64) { return 12 }
    if !app_table_set_uint(0, 0, 1, 9u64) { return 13 }
    if !app_table_set_uint(0, 1, 1, 4u64) { return 14 }
    if !app_table_set_float(0, 0, 2, 1.5f64) { return 15 }
    if !app_table_set_float(0, 1, 2, 2.5f64) { return 16 }
    if !app_table_set_bool(0, 0, 3, true) { return 17 }
    if !app_table_set_bool(0, 1, 3, false) { return 18 }
    if !app_table_read_bool(0, 0, 3) { return 19 }
    if app_table_read_bool(0, 1, 3) { return 20 }

    if !app_table_filter_int(0, 1, 0, 7 as Int64) { return 21 }
    if app_table_row_count(1) != 1 { return 22 }
    if app_table_read_int(1, 0, 0) != 7 as Int64 { return 22 }
    if !app_table_filter_uint(0, 2, 1, 4u64) { return 23 }
    if app_table_row_count(2) != 1 { return 24 }
    if app_table_read_uint(2, 0, 1) != 4u64 { return 24 }
    if !app_table_filter_float(0, 3, 2, 2.5f64) { return 25 }
    if app_table_row_count(3) != 1 { return 26 }
    if app_table_read_float(3, 0, 2) != 2.5f64 { return 26 }
    if !app_table_read_bool(0, 0, 3) { return 27 }
    if app_table_read_bool(0, 1, 3) { return 28 }
    if !app_table_filter_bool(0, 1, 3, true) { return 29 }
    if app_table_row_count(1) != 1 { return 30 }
    if !app_table_read_bool(1, 0, 3) { return 30 }

    // A typed filter rejects a mismatched column kind without changing the
    // destination table.
    if app_table_filter_int(0, 1, 1, 9 as Int64) { return 31 }
    if app_table_row_count(1) != 1 { return 32 }
    print("Jadren typed table filter: ready")
    return 0
}
