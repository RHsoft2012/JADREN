    ]
    var length: [UIntSize; 1] = [0usize]
    if !app_data_write_exact(snapshot, length) { return 8 }
    if length[0] < 20usize { return 9 }

    // The response is now stale because local state changed after the request.
    if !app_state_set_text("mode", "local") { return 10 }
    if !app_state_set_int("counter", 9 as Int64) { return 11 }
    if app_data_load_exact_if_revision(snapshot, length[0], expected_revision) { return 12 }
    if app_state_get_int("counter") != 9 as Int64 { return 13 }

    // With the current token the same fully validated payload can be applied.
    let current_revision: UInt64 = app_data_revision()
    if !app_data_load_exact_if_revision(snapshot, length[0], current_revision) { return 14 }
    if app_state_get_int("counter") != 7 as Int64 { return 15 }
    if app_list_count(0) != 1 { return 16 }
    if app_table_row_count(0) != 1 { return 17 }
    return 0
}
