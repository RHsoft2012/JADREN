module examples.app_data_load_exact_if_revision

// Caller-owned HTTP/IPC import guarded by the complete model revision.
// A stale response must not replace newer local state.
fn main() -> Int32 {
    app_state_clear()
    app_list_clear(0)
    app_table_clear(0)
    if !app_state_set_text("mode", "remote") { return 1 }
    if !app_state_set_int("counter", 7 as Int64) { return 2 }
    if !app_list_push_text(0, "Remote task") { return 3 }
    if !app_table_set_column_name(0, 0, "name") { return 4 }
    if !app_table_append_row(0) { return 5 }
    if !app_table_set_cell(0, 0, 0, "Remote task") { return 6 }
    if !app_data_validate() { return 7 }

    let expected_revision: UInt64 = app_data_revision()
    var snapshot: [UInt8; 1024] = [
