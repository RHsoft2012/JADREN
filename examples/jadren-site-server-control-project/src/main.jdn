    0u8]
    var host_length:[UIntSize;
    1] =[0usize]
    var target_length:[UIntSize;
    1] =[0usize]
    if ! read_cell_exact(0,
    row,
    0,
    host,
    host_length) {
        return false
    }
    if ! read_cell_exact(0,
    row,
    1,
    target,
    target_length) {
        return false
    }
    if ! set_text_bytes("route_draft_host",
    host,
    host_length[0usize]) {
        return false
    }
    return set_text_bytes("route_draft_target",
    target,
    target_length[0usize])
}
fn read_route_draft(host: write Slice<UInt8>, host_length: write Slice<UIntSize>, target: write Slice<UInt8>, target_length: write Slice<UIntSize>) -> Bool {
    if ! read_text_exact(27,
    host,
    host_length) {
        return false
    }
    return read_text_exact(28,
    target,
    target_length)
}
fn refresh_route_table() -> Bool {
    let node: Int32 = route_table_node()
    if node == 0 {
        return false
    }
    return table_refresh(node)
}
fn route_table_select(row: Int32) -> Bool {
    let node: Int32 = route_table_node()
    if node == 0 {
        return false
    }
    if ! table_set_selected_row(node,
    row) {
        return false
    }
    if ! app_state_set_int("route_selected_row",
    row as Int64) {
        return false
    }
    return copy_route_row_to_draft(row)
}
