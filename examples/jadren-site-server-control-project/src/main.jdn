fn reset_server_profile() -> Bool {
    if ! app_state_set_text("host",
    "127.0.0.1") {
        return false
    }
    if ! app_state_set_text("port",
    "8080") {
        return false
    }
    if ! app_state_set_text("bind",
    "127.0.0.1") {
        return false
    }
    if ! app_state_set_text("webroot",
    "C:/Jadren/site") {
        return false
    }
    if ! app_state_set_text("server_executable",
    "C:/Jadren/site/jadrenserver.exe") {
        return false
    }
    if ! app_state_set_text("route1_host",
    "site.example.com") {
        return false
    }
    if ! app_state_set_text("route1_target",
    "C:/Jadren/site") {
        return false
    }
    if ! app_state_set_text("route2_host",
    "web.example.com") {
        return false
    }
    if ! app_state_set_text("route2_target",
    "http://127.0.0.1:8090") {
        return false
    }
    if ! app_state_set_text("route3_host",
    "api.example.com") {
        return false
    }
    if ! app_state_set_text("route3_target",
    "http://127.0.0.1:8090") {
        return false
    }
    if ! seed_default_routes() {
        return false
    }
    let node: Int32 = route_table_node()
    if node>0i32 {
        if ! refresh_route_table() {
            return false
        }
        if ! route_table_select(0i32) {
            return false
        }
    }
    ui_set_input_text(10,
    "127.0.0.1")
    ui_set_input_text(11,
    "8080")
    ui_set_input_text(12,
    "127.0.0.1")
    ui_set_input_text(13,
    "C:/Jadren/site")
    ui_set_input_text(14,
    "C:/Jadren/site/jadrenserver.exe")
    return true
}
fn route_table_node() -> Int32 {
    let value: Int64 = app_state_get_int("route_table_node")
    if value <= 0i64 {
        return 0
    }
    return value as Int32
}
