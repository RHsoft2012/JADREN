    if length[0]>5usize {
        return 0u16
    }
    var number: UInt32 = 0u32
    var index: UIntSize = 0usize
    while index<length[0] {
        if value[index] < 48u8 {
            return 0u16
        }
        if value[index]>57u8 {
            return 0u16
        }
        number = number * 10u32 +(value[index] - 48u8) as UInt32
        if number>65535u32 {
            return 0u16
        }
        index += 1usize
    }
    if number == 0u32 {
        return 0u16
    }
    return number as UInt16
}
