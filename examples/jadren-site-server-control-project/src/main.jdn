fn validate_routes() -> Bool {
    let count: Int32 = row_count(0)
    if count <= 0i32 {
        return false
    }
    if count>64i32 {
        return false
    }
    var row: Int32 = 0i32
    while row<count {
        if ! validate_table_route(row) {
            return false
        }
        row = row + 1i32
    }
    return true
}
fn save_route_config(temporary_path: read String, target_path: read String, directory_path: read String) -> Bool {
    if ! validate_routes() {
        return false
    }
    if ! dir_create(directory_path) {
        if ! exists(directory_path) {
            return false
        }
    }
    var status: Int32 = 0i32
    let created: Result<Buffer<UInt8>,
    Int32> = buffer_create(32768usize)
    match created {
        Error(error) => {
            status = error
        }
        Ok(document) => {
            if ! buffer_resize(document,
            32768usize) {
                status = 1i32
            }
            if status == 0i32 {
                let capacity: UIntSize = buffer_length(document)
                var length: UIntSize = string_builder_append("{\"schema\":\"jadren-server-routes-0.1\",\"listen\":{\"bind\":\"127.0.0.1\",\"port\":8080},\"reject_unknown_host\":true,\"routes\":[",
                buffer_slice_write(document,
                0usize,
                capacity),
                0usize)
                var row: Int32 = 0i32
                let route_count: Int32 = row_count(0)
                while row<route_count {
                    length = append_route_record(document,
                    length,
                    row,
                    row>0i32)
                    if length == 0usize {
                        status = 2i32
                    }
                    if status != 0i32 {
                        break
                    }
                    row = row + 1i32
                }
                if status == 0i32 {
                    length = string_builder_append("]}\n",
                    buffer_slice_write(document,
                    0usize,
                    capacity),
                    length)
                    if ! write_atomic_durable(temporary_path,
                    target_path,
                    directory_path,
                    buffer_slice(document,
                    0usize,
                    length),
                    length) {
                        status = 3i32
                    }
                }
            }
        }
    }
    return status == 0i32
}
