fn write_settings(temporary_path: read String, path: read String, directory_path: read String) -> Bool {
    var status: Int32 = 0i32
    let created: Result<Buffer<UInt8>,
    Int32> = buffer_create(2048usize)
    match created {
        Error(error) => {
            status = error
        }
        Ok(snapshot) => {
            if ! buffer_resize(snapshot,
            2048usize) {
                status = 1i32
            }
            if status == 0i32 {
                var length:[UIntSize;
                1] =[0usize]
                if ! write_json_exact_buffer(snapshot,
                2048usize,
                length) {
                    status = 2i32
                } else {
                    if ! dir_create(directory_path) {
                        if ! exists(directory_path) {
                            status = 3i32
                        }
                    }
                    if status == 0i32 {
                        if ! write_atomic_durable(temporary_path,
                        path,
                        directory_path,
                        buffer_slice(snapshot,
                        0usize,
                        length[0]),
                        length[0]) {
                            status = 4i32
                        }
                    }
                }
            }
        }
    }
    return status == 0i32
}
fn save_settings(path: read String) -> Bool {
    return write_settings("config/jadren-site-server-control.tmp",
    path,
    "config")
}
fn save_autostart_manifest() -> Bool {
    return write_settings("C:/ProgramData/Jadren/config/server-autostart.tmp",
    "C:/ProgramData/Jadren/config/server-autostart.json",
    "C:/ProgramData/Jadren/config")
}
// The launcher starts from the repository/installation root. The parent
// fallback keeps a manually started copy from target/ compatible with the
// same persisted settings file.
fn load_saved_settings() -> Bool {
    if exists("config/jadren-site-server-control.json") {
        return load("config/jadren-site-server-control.json")
    }
    if exists("../config/jadren-site-server-control.json") {
        return load("../config/jadren-site-server-control.json")
    }
    return false
}
// Route editor contract: hostnames are allowlisted metadata for Cloudflare
// ingress and loopback HTTP services. PostgreSQL is deliberately not a route
// kind; it remains an internal dependency of the Node API on port 5432.
fn route_service_kind(value: read Slice<UInt8>, length: UIntSize) -> Int32 {
    if length == 0usize {
        return 0i32
    }
    if value[0usize] == 47u8 {
        return 1i32
    }
    if length >= 3usize {
        if value[1usize] == 58u8 {
            if value[2usize] == 47u8 {
                return 1i32
            }
        }
    }
    var loopback_v4:[UInt8;
    17] =[104u8,
    116u8,
    116u8,
    112u8,
    58u8,
    47u8,
    47u8,
    49u8,
    50u8,
    55u8,
    46u8,
    48u8,
    46u8,
    48u8,
    46u8,
    49u8,
    58u8]
    var loopback_name:[UInt8;
    17] =[104u8,
    116u8,
    116u8,
    112u8,
    58u8,
    47u8,
    47u8,
    108u8,
    111u8,
    99u8,
    97u8,
    108u8,
    104u8,
    111u8,
    115u8,
    116u8,
    58u8]
    if route_prefix(value,
    length,
    loopback_v4,
    17usize) {
        return 2i32
    }
    if route_prefix(value,
    length,
    loopback_name,
    17usize) {
        return 2i32
    }
    return 0i32
}
fn route_host_valid(value: read Slice<UInt8>, length: UIntSize) -> Bool {
    if length == 0usize {
        return false
    }
    if length>253usize {
        return false
    }
    var label_length: UIntSize = 0usize
    var index: UIntSize = 0usize
    while index<length {
        let character: UInt8 = value[index]
        if character == 46u8 {
            if label_length == 0usize {
                return false
            }
            if value[index - 1usize] == 45u8 {
                return false
            }
            label_length = 0usize
        } else {
            var alphanumeric: Bool = false
            if character >= 48u8 {
                if character <= 57u8 {
                    alphanumeric = true
                }
            }
            if character >= 65u8 {
                if character <= 90u8 {
                    alphanumeric = true
                }
            }
            if character >= 97u8 {
                if character <= 122u8 {
                    alphanumeric = true
                }
            }
            if ! alphanumeric {
                if character != 45u8 {
                    return false
                }
            }
            if label_length == 0usize {
                if character == 45u8 {
                    return false
                }
            }
            label_length = label_length + 1usize
            if label_length>63usize {
                return false
            }
        }
        index = index + 1usize
    }
    if label_length == 0usize {
        return false
    }
    if value[length - 1usize] == 45u8 {
        return false
    }
    return true
}
fn route_prefix(value: read Slice<UInt8>, length: UIntSize, prefix: read Slice<UInt8>, prefix_length: UIntSize) -> Bool {
    if length<prefix_length {
        return false
    }
    var index: UIntSize = 0usize
    while index<prefix_length {
        if value[index] != prefix[index] {
            return false
        }
        index = index + 1usize
    }
    return true
}
fn route_contains_5432(value: read Slice<UInt8>, length: UIntSize) -> Bool {
    if length<4usize {
        return false
    }
    var index: UIntSize = 0usize
    while index + 3usize<length {
        if value[index] == 53u8 {
            if value[index + 1usize] == 52u8 {
                if value[index + 2usize] == 51u8 {
                    if value[index + 3usize] == 50u8 {
                        return true
                    }
                }
            }
        }
        index = index + 1usize
    }
    return false
}
fn route_target_valid(value: read Slice<UInt8>, length: UIntSize, kind: Int32) -> Bool {
    if length == 0usize {
        return false
    }
    if length>128usize {
        return false
    }
    var index: UIntSize = 0usize
    while index<length {
        let character: UInt8 = value[index]
        if character == 34u8 {
            return false
        }
        if character == 92u8 {
            return false
        }
        if character == 10u8 {
            return false
        }
        if character == 13u8 {
            return false
        }
        index = index + 1usize
    }
    if kind == 1i32 {
        if value[0usize] == 47u8 {
            return true
        }
        if length<3usize {
            return false
        }
        if value[1usize] == 58u8 {
            return value[2usize] == 47u8
        }
        return false
    }
    var loopback_v4:[UInt8;
    18] =[104u8,
    116u8,
    116u8,
    112u8,
    58u8,
    47u8,
    47u8,
    49u8,
    50u8,
    55u8,
    46u8,
    48u8,
    46u8,
    48u8,
    46u8,
    49u8,
    58u8,
    0u8]
    var loopback_name:[UInt8;
    17] =[104u8,
    116u8,
    116u8,
    112u8,
    58u8,
    47u8,
    47u8,
    108u8,
    111u8,
    99u8,
    97u8,
    108u8,
    104u8,
    111u8,
    115u8,
    116u8,
    58u8]
    var prefix_length: UIntSize = 0usize
    if route_prefix(value,
    length,
    loopback_v4,
    17usize) {
        prefix_length = 17usize
    } else if route_prefix(value,
    length,
    loopback_name,
    17usize) {
        prefix_length = 17usize
    } else {
        return false
    }
    if route_contains_5432(value,
    length) {
        return false
    }
    if length <= prefix_length {
        return false
    }
    index = prefix_length
    var digits: UIntSize = 0usize
    while index<length {
        if value[index] < 48u8 {
            return false
        }
        if value[index]>57u8 {
            return false
        }
        digits = digits + 1usize
        if digits>5usize {
            return false
        }
        index = index + 1usize
    }
    return digits>0usize
}
fn validate_route_values(host: read Slice<UInt8>, host_length: UIntSize, target: read Slice<UInt8>, target_length: UIntSize) -> Bool {
    if ! route_host_valid(host,
    host_length) {
        return false
    }
    let kind: Int32 = route_service_kind(target,
    target_length)
    if kind == 0i32 {
        return false
    }
    return route_target_valid(target,
    target_length,
    kind)
}
