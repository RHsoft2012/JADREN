}
fn append_route_bytes(output: write Buffer<UInt8>, offset: UIntSize, value: read Slice<UInt8>, length: UIntSize) -> UIntSize {
    var index: UIntSize = 0usize
    var current: UIntSize = offset
    while index<length {
        if current >= buffer_length(output) {
            return 0usize
        }
        output[current] = value[index]
        current = current + 1usize
        index = index + 1usize
    }
    return current
}
