fn has_smoke_flag() -> Bool {
    if process_arg_count() != 2usize {
        return false
    }
    var value:[UInt8;
    7] =[45u8,
    45u8,
    115u8,
    109u8,
    111u8,
    107u8,
    101u8]
    let length: UIntSize = process_arg_read(1usize,
    value)
    if length != 7usize {
        return false
    }
    if value[0] != 45u8 {
        return false
    }
    if value[1] != 45u8 {
        return false
    }
    if value[2] != 115u8 {
        return false
    }
    if value[3] != 109u8 {
        return false
    }
    if value[4] != 111u8 {
        return false
    }
    if value[5] != 107u8 {
        return false
    }
    return value[6] == 101u8
}
// The --smoke-http path runs the same callbacks against a local test origin.
fn has_http_smoke_flag() -> Bool {
    if process_arg_count() != 2usize {
        return false
    }
    var value:[UInt8;
    12] =[45u8,
    45u8,
    115u8,
    109u8,
    111u8,
    107u8,
    101u8,
    45u8,
    104u8,
    116u8,
    116u8,
    112u8,
    ]
    var argument:[UInt8;
    12] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    ]
    let length: UIntSize = process_arg_read(1usize,
    argument)
    if length != 12usize {
        return false
    }
    var index: UIntSize = 0usize
    while index<12usize {
        if argument[index] != value[index] {
            return false
        }
        index += 1usize
    }
    return true
}
