fn append_prefix(output: write Buffer<UInt8>, input: read Slice<UInt8>, length: UIntSize) -> Bool {
    var index: UIntSize = 0usize
    while index<length {
        if ! buffer_append(output,
        input[index]) {
            return false
        }
        index += 1usize
    }
    return true
}
fn contains_buffer_marker(input: read Slice<UInt8>, input_length: UIntSize, marker: read Slice<UInt8>, marker_length: UIntSize,) -> Bool {
    if marker_length == 0usize {
        return true
    }
    if marker_length>input_length {
        return false
    }
    var start: UIntSize = 0usize
    while start + marker_length <= input_length {
        var index: UIntSize = 0usize
        var matched: Bool = true
        while index<marker_length {
            if input[start + index] != marker[index] {
                matched = false
                break
            }
            index += 1usize
        }
        if matched {
            return true
        }
        start += 1usize
    }
    return false
}
