    }
    if ! refresh_route_table() {
        return false
    }
    return route_table_select(destination)
}
fn add_route_from_draft() -> Bool {
    return apply_route_draft( - 1i32)
}
fn update_route_from_draft() -> Bool {
    return apply_route_draft(table_selected_row(26))
}
fn remove_selected_route() -> Bool {
    let row: Int32 = table_selected_row(26)
    if row<0i32 {
        return false
    }
    if ! remove_row(0,
    row) {
        return false
    }
    let count: Int32 = row_count(0)
    if ! refresh_route_table() {
        return false
    }
    if count == 0i32 {
        if ! app_state_set_text("route_draft_host",
        "") {
            return false
        }
        return app_state_set_text("route_draft_target",
        "")
    }
    var selected: Int32 = row
    if selected >= count {
        selected = count - 1i32
    }
    return route_table_select(selected)
}
fn configured_webroot(output: write Slice<UInt8>, length: write Slice<UIntSize>) -> Bool {
    return read_text_exact(13,
    output,
    length)
}
fn refresh_process_status() -> Bool {
    let handle: UInt64 = app_state_get_uint("server_handle")
    if handle == 0u64 {
        ui_set_status("Stav procesu: panel nema vlastny spusteny server.")
        return false
    }
    if is_running(handle) {
        ui_set_status("Stav procesu: server bezi.")
        return true
    }
    if ! app_state_set_uint("server_handle",
    0u64) {
        ui_set_status("Stav procesu: proces skoncil, stav sa nepodarilo vycistit.")
        return false
    }
    ui_set_status("Stav procesu: server uz nebezi.")
    return false
}
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 26 {
        let row: Int32 = table_selected_row(26)
        if row >= 0i32 {
            if route_table_select(row) {
                ui_set_status("Vybraná trasa je pripravená na úpravu.")
            } else {
                ui_set_status("Vybranú trasu sa nepodarilo načítať.")
            }
        }
    } else if event_id == 29 {
        if add_route_from_draft() {
            ui_set_status("Trasa bola pridaná do zoznamu; uložte route config.")
        } else {
            ui_set_status("Trasa sa nedala pridať: overte hostname a static/loopback cieľ.")
        }
    } else if event_id == 30 {
        if update_route_from_draft() {
            ui_set_status("Trasa bola upravená; uložte route config.")
        } else {
            ui_set_status("Trasa sa nedala upraviť: vyberte riadok a overte jeho cieľ.")
        }
    } else if event_id == 31 {
        if remove_selected_route() {
            ui_set_status("Trasa bola odstránená zo zoznamu.")
        } else {
            ui_set_status("Vyberte trasu, ktorú chcete odstrániť.")
        }
    } else if event_id == 1 {
        let status: Int32 = local_health_check()
        if status == 200i32 {
            ui_set_status("Health-check HTTP: server odpovedal 200 na /healthz.")
        } else if status == - 20i32 {
            ui_set_status("Health-check: zadajte localhost alebo 127.0.0.1 a platny port.")
        } else {
            ui_set_status("Health-check HTTP: server nie je dostupny alebo vratil chybny kontrakt.")
        }
    } else if event_id == 2 {
        let status: Int32 = admin_status_request()
        if status == 200i32 {
            ui_set_status("Administracia HTTP: /admin/update/status odpovedal 200.")
        } else if status == 403i32 {
            ui_set_status("Administracia HTTP: bearer token bol odmietnuty (403).")
        } else if status == 404i32 {
            ui_set_status("Administracia HTTP: endpoint je skryty (404); skontrolujte token na serveri.")
        } else if status == - 24i32 {
            ui_set_status("Administracia: zadajte bearer token; token sa neuklada do konfiguracie.")
        } else {
            ui_set_status("Administracia HTTP: volanie sa nepodarilo dokončit.")
        }
    } else if event_id == 3 {
        if save_settings("config/jadren-site-server-control.json") {
            ui_set_status("Nastavenia boli ulozene atomicky.")
        } else {
            ui_set_status("Nastavenia sa nepodarilo ulozit.")
        }
    } else if event_id == 4 {
        let port: UInt16 = configured_port()
        if port == 0u16 {
            ui_set_status("Start: zadajte platny port 1-65535.")
        } else {
            let existing: UInt64 = app_state_get_uint("server_handle")
            var already_running: Bool = false
            if existing != 0u64 {
                already_running = is_running(existing)
            }
            if already_running {
                ui_set_status("Server uz bezi; druhy proces sa nespusta.")
            } else {
                var webroot:[UInt8;
                64] =[0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                0u8,
                ]
                var webroot_length:[UIntSize;
                1] =[0usize]
                let configured: Bool = configured_webroot(webroot,
                webroot_length)
                if ! configured {
                    ui_set_status("Start: vyberte existujuci webroot.")
                    return event_id
                } else if webroot_length[0] == 0usize {
                    ui_set_status("Start: vyberte existujuci webroot.")
                    return event_id
                }
                let created: Result<Buffer<UInt8>,
                Int32> = buffer_create(64usize)
                match created {
                    Error(_) => {
                        ui_set_status("Start zlyhal: nepodarilo sa vytvorit webroot Buffer.")
                    }
                    Ok(webroot_buffer) => {
                        if ! buffer_resize(webroot_buffer,
                        webroot_length[0]) {
                            ui_set_status("Start zlyhal: webroot Buffer nema dostatocnu kapacitu.")
                        } else {
                            var index: UIntSize = 0usize
                            while index<webroot_length[0] {
                                webroot_buffer[index] = webroot[index]
                                index += 1usize
                            }
                            let handle: UInt64 = start_with_webroot_buffer(port,
                            webroot_buffer,
                            webroot_length[0])
                            if handle == 0u64 {
                                ui_set_status("Start zlyhal: vedla ovladaca musi byt jadrenserver.exe a webroot.")
                            } else if ! app_state_set_uint("server_handle",
                            handle) {
                                stop(handle,
                                2000u32)
                                ui_set_status("Start zlyhal pri ulozeni procesu do ovladacieho stavu.")
                            } else {
                                ui_set_status("Server bol spusteny nativnym allowlistovanym procesnym ABI.")
                            }
                        }
                    }
                }
            }
        }
    } else if event_id == 5 {
        let handle: UInt64 = app_state_get_uint("server_handle")
        if handle == 0u64 {
            ui_set_status("Stop: panel nema vlastny spusteny proces.")
        } else if stop(handle,
        2000u32) {
            if ! app_state_set_uint("server_handle",
            0u64) {
                ui_set_status("Server sa zastavil, ale stav procesu sa nepodarilo vycistit.")
            } else {
                ui_set_status("Server bol zastaveny bounded nativnym procesnym ABI.")
            }
        } else {
            ui_set_status("Stop zlyhal alebo proces neukoncil v bounded limite.")
        }
    } else if event_id == 6 {
        if choose_webroot() {
            ui_set_status("Webroot bol vybrany natívnym dialogom.")
        } else {
            ui_set_status("Vyber webrootu bol zruseny alebo cesta nebola platna.")
        }
    } else if event_id == 7 {
        let refreshed: Bool = refresh_process_status()
        if refreshed {
        }
    } else if event_id == 8 {
        if validate_routes() {
            ui_set_status("Trasy su platne: hostname allowlist a loopback service ciel su v poriadku.")
        } else {
            ui_set_status("Trasy su neplatne: pouzite hostname, static/http-proxy a localhost/127.0.0.1.");
        }
    } else if event_id == 9 {
        if save_route_config("C:/ProgramData/Jadren/config/server-routes.tmp",
        "C:/ProgramData/Jadren/config/server-routes.json",
        "C:/ProgramData/Jadren/config") {
            if export_json_file_durable_directory(0,
            "C:/ProgramData/Jadren/config/server-routes-table.json",
            "C:/ProgramData/Jadren/config/server-routes-table.tmp",
            "C:/ProgramData/Jadren/config") {
                ui_set_status("Route konfiguracia a editor tras boli ulozene mimo webrootu.")
            } else {
                ui_set_status("Route konfiguracia bola ulozena, ale tabulka tras sa nepodarila ulozit.")
            }
        } else {
            ui_set_status("Route konfiguraciu sa nepodarilo ulozit; spustite panel s pravami pre ProgramData.")
        }
    } else if event_id == 10 {
        if choose_server_executable() {
            ui_set_status("Server EXE bol vybrany natívnym systemovym dialogom.")
        } else {
            ui_set_status("Vyber servera bol zruseny alebo cesta nebola platna.")
        }
    } else if event_id == 11 {
        if save_autostart_manifest() {
            ui_set_status("Autostart manifest bol ulozeny do ProgramData; registraciu vykona podpisany PowerShell postup s potvrdenim.")
        } else {
            ui_set_status("Autostart manifest sa nepodarilo ulozit; skontrolujte prava pre ProgramData.")
        }
    } else if event_id == 12 {
        if reset_server_profile() {
            ui_set_status("Novy server: pripraveny je samostatny aktivny profil s bezpecnymi predvolbami.")
        } else {
            ui_set_status("Novy server sa nepodarilo pripravit.")
        }
    }
    return event_id
}
