fn prepare_route_table() -> Bool {
    clear(0)
    if ! set_column_name(0,
    0,
    "hostname") {
        return false
    }
    if ! set_column_name(0,
    1,
    "target") {
        return false
    }
    if ! set_column_type(0,
    0,
    0) {
        return false
    }
    if ! set_column_type(0,
    1,
    0) {
        return false
    }
    if exists("C:/ProgramData/Jadren/config/server-routes-table.json") {
        if ! import_json_file(0,
        "C:/ProgramData/Jadren/config/server-routes-table.json") {
            return false
        }
        if ! validate_routes() {
            return false
        }
        return row_count(0)>0
    } else if exists("config/server-routes-table.json") {
        if ! import_json_file(0,
        "config/server-routes-table.json") {
            return false
        }
        if ! validate_routes() {
            return false
        }
        return row_count(0)>0
    }
    return seed_default_routes()
}
fn seed_default_routes() -> Bool {
    clear(0)
    if ! append_row(0) {
        return false
    }
    if ! set_cell(0,
    0,
