fn verify_smoke() -> Bool {
    if ! app_state_set_text("status",
    "Smoke pripravena") {
        return false
    }
    if ! prepare_route_table() {
        return false
    }
    if ! validate_routes() {
        return false
    }
    if ! set_cell(0,
    1,
    1,
    "http://127.0.0.1:5432") {
        return false
    }
    if validate_routes() {
        return false
    }
    if ! set_cell(0,
    1,
    1,
    "http://127.0.0.1:8090") {
        return false
    }
    if ! validate_routes() {
        return false
    }
    if ! append_row(0) {
        return false
    }
    if ! set_cell(0,
    3,
    0,
    "admin.example.com") {
        return false
    }
    if ! set_cell(0,
    3,
    1,
    "http://localhost:8091") {
        return false
    }
    if row_count(0) != 4i32 {
        return false
    }
    if ! validate_routes() {
        return false
    }
    if ! remove_row(0,
    3) {
        return false
    }
    if row_count(0) != 3i32 {
        return false
    }
    ui_set_input_text(27,
    "admin.example.com")
    ui_set_input_text(28,
    "http://localhost:8091")
    if on_click(29) != 29 {
        return false
    }
    if row_count(0) != 4i32 {
        return false
    }
    ui_set_input_text(27,
    "control.example.com")
    ui_set_input_text(28,
    "http://127.0.0.1:8092")
    if on_click(30) != 30 {
        return false
    }
    if ! validate_routes() {
        return false
    }
    if on_click(31) != 31 {
        return false
    }
    if row_count(0) != 3i32 {
        return false
    }
    if ! save_settings("target/jadren-site-server-control-smoke.json") {
        return false
    }
    if ! exists("target/jadren-site-server-control-smoke.json") {
        return false
    }
    if ! delete("target/jadren-site-server-control-smoke.json") {
        return false
    }
    if ! write_settings("target/server-autostart-smoke.tmp",
    "target/server-autostart-smoke.json",
    "target") {
        return false
    }
    if ! exists("target/server-autostart-smoke.json") {
        return false
    }
    if ! delete("target/server-autostart-smoke.json") {
        return false
    }
    if ! save_route_config("target/jadren-server-routes-smoke.tmp",
    "target/jadren-server-routes-smoke.json",
    "target") {
        return false
    }
    if ! exists("target/jadren-server-routes-smoke.json") {
        return false
    }
    if ! delete("target/jadren-server-routes-smoke.json") {
        return false
    }
    if ! export_json_file_durable_directory(0,
    "target/jadren-server-routes-table-smoke.json",
    "target/jadren-server-routes-table-smoke.tmp",
    "target") {
        return false
    }
    if ! exists("target/jadren-server-routes-table-smoke.json") {
        return false
    }
    if ! delete("target/jadren-server-routes-table-smoke.json") {
        return false
    }
    return ! exists("target/jadren-site-server-control-smoke.json")
}
fn verify_http_smoke() -> Bool {
