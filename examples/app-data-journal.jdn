module examples.app_data_journal

// Bounded append-only checkpoint journal.  The scratch path is caller-owned:
// Jadren serializes the complete model there, appends one length-framed record
// to the journal and can later recover the last complete record after a crash.
fn main() -> Int32 {
    // Re-running the example starts from a clean journal.
    file_delete("target/jadren/app-data.journal")
    file_delete("target/jadren/app-data.journal.scratch")

    if !app_state_set_int("counter", 1i64) {
        return 1
    }
    if !app_data_journal_append(
        "target/jadren/app-data.journal",
        "target/jadren/app-data.journal.scratch",
    ) {
        return 2
    }

    if !app_state_set_int("counter", 2i64) {
        return 3
    }
    if !app_data_journal_append(
        "target/jadren/app-data.journal",
        "target/jadren/app-data.journal.scratch",
    ) {
        return 4
    }

    // Simulate a checksum-invalid final write. Recovery must ignore this
    // corrupt frame and restore the previous complete checkpoint (counter = 2).
    file_append_text(
        "target/jadren/app-data.journal",
        "JADREN-APP-JOURNAL-0.2\n1\n0\nX",
    )
    app_state_clear()
    if !app_data_journal_recover(
        "target/jadren/app-data.journal",
        "target/jadren/app-data.journal.scratch",
    ) {
        return 5
    }
    if app_state_get_int("counter") != 2i64 {
        return 6
    }
    return 0
}
