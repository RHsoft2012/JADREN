module network_client_keep_alive_buffer_project.main

import jadren.app.fs.write_text
import jadren.network.client.close
import jadren.network.client.open
import jadren.network.client.request_exact_buffer

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn run_requests(
    body: write Buffer<UInt8>,
    request: write Buffer<UInt8>,
    response: write Buffer<UInt8>,
    output: write Buffer<UInt8>,
) -> Int32 {
    if !buffer_resize(body, 1usize) { return 1 }
    if !buffer_resize(request, 270usize) { return 2 }
    if !buffer_resize(response, 250usize) { return 3 }
    if !buffer_resize(output, 32usize) { return 4 }
    var response_length: [UIntSize; 1] = [0usize]
    var body_length: [UIntSize; 1] = [0usize]
    output[0usize] = 77u8
    let invalid_body: Int32 = request_exact_buffer(
        0usize,
        "localhost",
        "GET",
        "/api/state",
        body,
        2usize,
        1u32,
        request,
        270usize,
        response,
        250usize,
        response_length,
        output,
        32usize,
        body_length,
    )
    if invalid_body != -1i32 { return 16 }
    let invalid_request: Int32 = request_exact_buffer(
        0usize,
        "localhost",
        "GET",
        "/api/state",
        body,
        0usize,
        1u32,
        request,
        271usize,
        response,
        250usize,
        response_length,
        output,
        32usize,
        body_length,
    )
    if invalid_request != -1i32 { return 17 }
    let invalid_response: Int32 = request_exact_buffer(
        0usize,
        "localhost",
        "GET",
        "/api/state",
        body,
        0usize,
        1u32,
        request,
        270usize,
        response,
        251usize,
        response_length,
        output,
        32usize,
        body_length,
    )
    if invalid_response != -1i32 { return 18 }
    let invalid_output: Int32 = request_exact_buffer(
        0usize,
        "localhost",
        "GET",
        "/api/state",
        body,
        0usize,
        1u32,
        request,
        270usize,
        response,
        250usize,
        response_length,
        output,
        33usize,
        body_length,
    )
    if invalid_output != -7i32 { return 19 }
    if output[0usize] != 77u8 { return 20 }
    let socket: UIntSize = open("localhost", 38162u16, 5000u32)
    if socket == 0usize { return 5 }
    let first: Int32 = request_exact_buffer(
        socket,
        "localhost",
        "GET",
        "/api/state",
        body,
        0usize,
        1u32,
        request,
        270usize,
        response,
        250usize,
        response_length,
        output,
        32usize,
        body_length,
    )
    if first != 200i32 {
        close(socket)
        return 6
    }
    if body_length[0] != 11usize {
        close(socket)
        return 7
    }
    if output[9usize] != 48u8 {
        close(socket)
        return 8
    }
    if output[10usize] != 125u8 {
        close(socket)
        return 9
    }
    let second: Int32 = request_exact_buffer(
        socket,
        "localhost",
        "GET",
        "/api/state",
        body,
        0usize,
        0u32,
        request,
        270usize,
        response,
        250usize,
        response_length,
        output,
        32usize,
        body_length,
    )
    if second != 200i32 {
        close(socket)
        return 10
    }
    if body_length[0] != 11usize {
        close(socket)
        return 11
    }
    if output[9usize] != 49u8 {
        close(socket)
        return 12
    }
    if output[10usize] != 125u8 {
        close(socket)
        return 13
    }
    if !close(socket) { return 14 }
    if write_text(
        "target/jadren/network-client-keep-alive-buffer.result",
        "client:2 dynamic_buffers:true keep_alive:true close:true\n",
    ) == 0usize { return 15 }
    return 0
}

fn main() -> Int32 {
    let body_created: Result<Buffer<UInt8>, Int32> = buffer_create(1usize)
    var status: Int32 = 0i32
    match body_created {
        Error(error) => { status = error }
        Ok(body) => {
            let request_created: Result<Buffer<UInt8>, Int32> = buffer_create(270usize)
            match request_created {
                Error(error) => { status = error }
                Ok(request) => {
                    let response_created: Result<Buffer<UInt8>, Int32> = buffer_create(250usize)
                    match response_created {
                        Error(error) => { status = error }
                        Ok(response) => {
                            let output_created: Result<Buffer<UInt8>, Int32> = buffer_create(32usize)
                            match output_created {
                                Error(error) => { status = error }
                                Ok(output) => {
                                    status = run_requests(body, request, response, output)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return status
}
