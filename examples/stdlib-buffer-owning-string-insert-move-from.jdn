module examples.stdlib_buffer_owning_string_insert_move_from

// Insert direct OwnedString values through the caller-owned move ABI. An
// invalid index must leave the source cleanup and destination list intact.
fn main() -> Int32 {
    let values_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
    let first_created: Result<OwnedString, Int32> = string_owned_from("first")
    let second_created: Result<OwnedString, Int32> = string_owned_from("second")
    let status_created: Result<OwnedString, Int32> = string_owned_from("status")
    var result_code: Int32 = 0

    match values_created {
        Ok(values) => {
            match first_created {
                Ok(first) => {
                    match second_created {
                        Ok(second) => {
                            match status_created {
                                Ok(status_text) => {
                                    if !buffer_append(values, first) { result_code = 1 }
                                    if !buffer_insert_move_from(values, 0usize, second) { result_code = 2 }
                                    if buffer_length(values) != 2usize { result_code = 3 }
                                    let status: Int32 = buffer_insert_move_from_status(values, 99usize, status_text)
                                    if status != -20 { result_code = 4 }
                                    if buffer_length(values) != 2usize { result_code = 5 }
                                    if !buffer_remove_drop(values, 0usize) { result_code = 6 }
                                    if !buffer_clear_move(values) { result_code = 7 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    return result_code
}
