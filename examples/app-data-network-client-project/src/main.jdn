    var cell: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if read_cell(0, 0, 0, cell) != 5usize { return 15 }
    if cell[0] != 66u8 { return 16 }
    if !save_atomic(
        "target/jadren/app-data-network-client.tmp",
        "target/jadren/app-data-network-client.data"
    ) { return 17 }
    return 0
}
