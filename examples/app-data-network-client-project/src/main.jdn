@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    var load_mode: Bool = false
    if arg_count() == 2usize {
        var flag: [UInt8; 6] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
        let flag_length: UIntSize = arg_read(1usize, flag)
        if flag_length == 6usize {
            if flag[0] == 45u8 {
                if flag[1] == 45u8 {
                    if flag[2] == 108u8 {
                        if flag[3] == 111u8 {
                            if flag[4] == 97u8 {
                                if flag[5] == 100u8 { load_mode = true }
                            }
                        }
                    }
                }
            }
        }
    }
    clear()
    if load_mode {
        if !load("target/jadren/app-data-network-client.data") { return 20 }
        if get_int("selected") != 7i64 { return 21 }
        if count(0) != 2 { return 22 }
        if row_count(0) != 1 { return 23 }
