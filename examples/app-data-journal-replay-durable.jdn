    ]
    var frame_length: [UIntSize; 1] = [777usize]
    if !app_data_journal_read_frame_exact_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock",
        0usize,
        frame_output,
        frame_length
    ) { return 9 }
    if frame_length[0] < 20usize { return 10 }
    if frame_output[0] != 74u8 { return 11 }
    if frame_output[1] != 65u8 { return 12 }
    if app_state_get_int("counter") != 3i64 { return 13 }

    // Latest read discovers and copies the newest valid frame under one lock.
    if !app_data_journal_read_latest_frame_exact_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock",
        frame_output,
        frame_length
    ) { return 21 }
    if frame_length[0] < 20usize { return 22 }
    if frame_output[0] != 74u8 { return 23 }
    if frame_output[1] != 65u8 { return 24 }

    var short_output: [UInt8; 8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var short_length: [UIntSize; 1] = [777usize]
    if app_data_journal_read_frame_exact_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock",
        0usize,
        short_output,
        short_length
    ) { return 14 }
    if short_length[0] != 777usize { return 15 }

    app_state_clear()
    if !app_data_journal_recover_frame_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock",
        1usize
    ) { return 16 }
    if app_state_get_int("counter") != 2i64 { return 17 }

    if !app_data_journal_recover_frame_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock",
        2usize
    ) { return 18 }
    if app_state_get_int("counter") != 3i64 { return 19 }

    if app_data_journal_recover_frame_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock",
        3usize
    ) { return 20 }

    file_delete("target/jadren/app-data-journal-replay-durable.journal")
    file_delete("target/jadren/app-data-journal-replay-durable.scratch")
    file_delete("target/jadren/app-data-journal-replay-durable.lock")
    return 0
}
