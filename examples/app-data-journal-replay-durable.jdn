module examples.app_data_journal_replay_durable

// Replay selected historical checkpoints from a retained journal.
fn main() -> Int32 {
    file_delete("target/jadren/app-data-journal-replay-durable.journal")
    file_delete("target/jadren/app-data-journal-replay-durable.scratch")
    file_delete("target/jadren/app-data-journal-replay-durable.lock")

    if !app_state_set_int("counter", 1i64) { return 1 }
    if !app_data_journal_append_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock"
    ) { return 2 }
    if !app_state_set_int("counter", 2i64) { return 3 }
    if !app_data_journal_append_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock"
    ) { return 4 }
    if !app_state_set_int("counter", 3i64) { return 5 }
    if !app_data_journal_append_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.scratch",
        "target/jadren/app-data-journal-replay-durable.lock"
    ) { return 6 }

    let frame_count: UIntSize = app_data_journal_count_frames_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock"
    )
    if frame_count != 3usize { return 7 }

    var journal_stats: [UIntSize; 2] = [777usize, 777usize]
    if !app_data_journal_stats_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock",
        journal_stats
    ) { return 25 }
    if journal_stats[0] != 3usize { return 26 }
    if journal_stats[1] < 60usize { return 27 }

    let frame_length_hint: UIntSize = app_data_journal_frame_length_durable(
        "target/jadren/app-data-journal-replay-durable.journal",
        "target/jadren/app-data-journal-replay-durable.lock",
        0usize
    )
    if frame_length_hint < 20usize { return 8 }

    var frame_output: [UInt8; 1024] = [
