module app_state_json_buffer_project.main
import jadren.app.state.clear
import jadren.app.state.get_bool
import jadren.app.state.get_int
import jadren.app.state.load_json_exact_buffer
import jadren.app.state.set_bool
import jadren.app.state.set_int
import jadren.app.state.write_json_exact_buffer
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn main() -> Int32 {
    var status: Int32 = 0i32
    clear()
    if ! set_int("count",
    3i64) {
        status = 1
    }
    if status == 0 {
        if ! set_bool("enabled",
        true) {
            status = 2
        }
    }
    let snapshot_created: Result<Buffer<UInt8>,
    Int32> = buffer_create(128usize)
    match snapshot_created {
        Ok(snapshot) => {
            var length:[UIntSize;
            1] =[777usize]
            if status == 0 {
                if !buffer_resize(snapshot, 128usize) {
                    status = 17
                }
            }
            if status == 0 {
                if ! write_json_exact_buffer(snapshot,
                128usize,
                length) {
                    status = 3
                }
            }
            if status == 0 {
                if length[0] != 26usize {
                    status = 4
                }
            }
            if status == 0 {
                if snapshot[0] != 123u8 {
                    status = 5
                }
            }
            if status == 0 {
            if snapshot[25] != 125u8 {
                    status = 6
                }
            }
            if status == 0 {
                clear()
                if ! load_json_exact_buffer(snapshot,
                length[0]) {
                    status = 7
                }
                if status == 0 {
                    if get_int("count") != 3i64 {
                        status = 8
                    }
                }
                if status == 0 {
                    if ! get_bool("enabled") {
                        status = 9
                    }
                }
            }
            let tiny_created: Result<Buffer<UInt8>,
            Int32> = buffer_create(4usize)
            match tiny_created {
                Ok(tiny) => {
                    if status == 0 {
                        if !buffer_resize(tiny, 4usize) {
                            status = 18
                        }
                    }
                    if status == 0 {
                        tiny[0] = 90u8
                        length[0] = 777usize
                        if write_json_exact_buffer(tiny,
                        4usize,
                        length) {
                            status = 10
                        }
                        if status == 0 {
                            if tiny[0] != 90u8 {
                                status = 11
                            }
                        }
                        if status == 0 {
                            if length[0] != 777usize {
                                status = 12
                            }
                        }
                        if status == 0 {
                            length[0] = 778usize
                            if write_json_exact_buffer(tiny,
                            5usize,
                            length) {
                                status = 50
                            }
                        }
                        if status == 0 {
                            if tiny[0] != 90u8 {
                                status = 51
                            }
                        }
                        if status == 0 {
                            if length[0] != 778usize {
                                status = 52
                            }
                        }
                    }
                    let invalid_created: Result<Buffer<UInt8>,
                    Int32> = buffer_create(4usize)
                    match invalid_created {
                        Ok(invalid) => {
                            if status == 0 {
                                if !buffer_resize(invalid, 4usize) {
                                    status = 19
                                }
                            }
                            if status == 0 {
                                invalid[0] = 123u8
                                invalid[1] = 98u8
                                invalid[2] = 97u8
                                invalid[3] = 100u8
                                if load_json_exact_buffer(invalid,
                                4usize) {
                                    status = 13
                                }
                                if status == 0 {
                                    if get_int("count") != 3i64 {
                                        status = 14
                                    }
                                }
                                if status == 0 {
                                    if load_json_exact_buffer(invalid,
                                    5usize) {
                                        status = 15
                                    }
                                }
                                if status == 0 {
                                    if get_int("count") != 3i64 {
                                        status = 16
                                    }
                                }
                            }
                        }
                        Error(error) => {
                            if status == 0 {
                                status = error
                            }
                        }
                    }
                }
                Error(error) => {
                    if status == 0 {
                        status = error
                    }
                }
            }
        }
        Error(error) => {
            if status == 0 {
                status = error
            }
        }
    }
    return status
}
