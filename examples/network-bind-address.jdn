module examples.network_bind_address

// Explicit bind is opt-in; the legacy listen(port) API remains loopback-only.
fn main() -> Int32 {
    var address:[UInt8;
    16] =[48u8,
    46u8,
    48u8,
    46u8,
    48u8,
    46u8,
    48u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let listener: UIntSize = net_tcp_listen_on_prefix(address, 7usize, 19091u16)
    if listener == 0usize {
        return 1
    }
    if ! net_socket_close(listener) {
        return 2
    }
    let invalid: UIntSize = net_tcp_listen_on_prefix(address, 17usize, 19092u16)
    if invalid != 0usize {
        return 3
    }
    return 0
}
