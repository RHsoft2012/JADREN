module examples.app_collection_count_if_model_revision_project.main

import jadren.app.data.revision
import jadren.app.list
import jadren.app.list.clear
import jadren.app.list.count
import jadren.app.list.count_if_model_revision
import jadren.app.list.push_text
import jadren.app.table.append_row
import jadren.app.table.row_count
import jadren.app.table.row_count_if_model_revision
import jadren.app.table.set_cell
import jadren.app.table.set_column_name
import jadren.app.table.set_column_type
import jadren.app.table.set_schema_version
import jadren.app.table.set_int
import jadren.app.table.set_uint
import jadren.app.table.set_float
import jadren.app.table.set_bool
import jadren.app.table.index_build
import jadren.app.table.index_build_int
import jadren.app.table.index_build_uint
import jadren.app.table.index_build_float
import jadren.app.table.index_build_bool
import jadren.app.table.index_find_text_if_model_revision
import jadren.app.table.index_find_int_if_model_revision
import jadren.app.table.index_find_uint_if_model_revision
import jadren.app.table.index_find_float_if_model_revision
import jadren.app.table.index_find_bool_if_model_revision
import jadren.app.table.find_int_if_model_revision
import jadren.app.table.find_uint_if_model_revision
import jadren.app.table.find_float_if_model_revision
import jadren.app.table.find_bool_if_model_revision
import jadren.app.table.find_column_if_model_revision
import jadren.app.table.schema_version_if_model_revision
import jadren.app.table

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    clear(0)
    app_table_clear(0)
    if ! push_text(0, "first") { return 1 }
    if ! push_text(0, "second") { return 2 }
    if ! set_column_name(0, 0, "name") { return 3 }
    if ! set_column_type(0, 0, 0) { return 4 }
    if ! set_column_type(0, 1, 1) { return 5 }
    if ! set_column_type(0, 2, 2) { return 6 }
    if ! set_column_type(0, 3, 4) { return 7 }
    if ! set_column_type(0, 4, 3) { return 8 }
    if ! append_row(0) { return 9 }
    if ! set_cell(0, 0, 0, "row") { return 9 }
    if ! set_int(0, 0, 1, 42 as Int64) { return 10 }
    if ! set_uint(0, 0, 2, 7u64) { return 11 }
    if ! set_float(0, 0, 3, 1.25f64) { return 12 }
    if ! set_bool(0, 0, 4, true) { return 13 }
    if ! set_schema_version(0, 7) { return 14 }
    if ! index_build(0, 0) { return 15 }
    let text_index_current: UInt64 = revision()
    if index_find_text_if_model_revision(0, 0, "row", text_index_current) != 0 { return 16 }
    if ! index_build_int(0, 1) { return 17 }
    let int_index_current: UInt64 = revision()
    if index_find_int_if_model_revision(0, 1, 42 as Int64, int_index_current) != 0 { return 18 }
    if ! index_build_uint(0, 2) { return 19 }
    let uint_index_current: UInt64 = revision()
    if index_find_uint_if_model_revision(0, 2, 7u64, uint_index_current) != 0 { return 20 }
    if ! index_build_float(0, 3) { return 21 }
    let float_index_current: UInt64 = revision()
    if index_find_float_if_model_revision(0, 3, 1.25f64, float_index_current) != 0 { return 22 }
    if ! index_build_bool(0, 4) { return 23 }
    let bool_index_current: UInt64 = revision()
    if index_find_bool_if_model_revision(0, 4, true, bool_index_current) != 0 { return 24 }

    let current: UInt64 = revision()
    if count_if_model_revision(0, current) != 2 { return 20 }
    if list.find_text_if_model_revision(0, "second", 0, current) != 1 { return 21 }
    if row_count_if_model_revision(0, current) != 1 { return 22 }
    if table.find_text_if_model_revision(0, 0, "row", 0, current) != 0 { return 23 }
    if find_int_if_model_revision(0, 1, 42 as Int64, 0, current) != 0 { return 24 }
    if find_uint_if_model_revision(0, 2, 7u64, 0, current) != 0 { return 25 }
    if find_float_if_model_revision(0, 3, 1.25f64, 0, current) != 0 { return 26 }
    if find_bool_if_model_revision(0, 4, true, 0, current) != 0 { return 27 }
    if find_column_if_model_revision(0, "name", current) != 0 { return 28 }
    if schema_version_if_model_revision(0, current) != 7 { return 29 }

    let stale: UInt64 = revision()
    if ! push_text(0, "changed") { return 35 }
    if count_if_model_revision(0, stale) != -1 { return 36 }
    if list.find_text_if_model_revision(0, "second", 0, stale) != -1 { return 37 }
    if row_count_if_model_revision(0, stale) != -1 { return 38 }
    if table.find_text_if_model_revision(0, 0, "row", 0, stale) != -1 { return 39 }
    if find_int_if_model_revision(0, 1, 42 as Int64, 0, stale) != -1 { return 40 }
    if find_uint_if_model_revision(0, 2, 7u64, 0, stale) != -1 { return 41 }
    if find_float_if_model_revision(0, 3, 1.25f64, 0, stale) != -1 { return 42 }
    if find_bool_if_model_revision(0, 4, true, 0, stale) != -1 { return 43 }
    if index_find_text_if_model_revision(0, 0, "row", stale) != -1 { return 30 }
    if index_find_int_if_model_revision(0, 1, 42 as Int64, stale) != -1 { return 31 }
    if index_find_uint_if_model_revision(0, 2, 7u64, stale) != -1 { return 32 }
    if index_find_float_if_model_revision(0, 3, 1.25f64, stale) != -1 { return 33 }
    if index_find_bool_if_model_revision(0, 4, true, stale) != -1 { return 34 }
    if find_column_if_model_revision(0, "name", stale) != -1 { return 35 }
    if schema_version_if_model_revision(0, stale) != -1 { return 36 }
    if count(0) != 3 { return 37 }

    let current_after_list: UInt64 = revision()
    if count_if_model_revision(0, current_after_list) != 3 { return 38 }

    if ! append_row(0) { return 39 }
    let current_after_table: UInt64 = revision()
    if row_count_if_model_revision(0, current_after_table) != 2 { return 40 }
    if count_if_model_revision(0, current_after_table) != 3 { return 41 }

    clear(0)
    app_table_clear(0)
    let empty_revision: UInt64 = revision()
    if count_if_model_revision(0, empty_revision) != 0 { return 56 }
    if list.find_text_if_model_revision(0, "missing", 0, empty_revision) != -1 { return 57 }
    if row_count_if_model_revision(0, empty_revision) != 0 { return 58 }
    if table.find_text_if_model_revision(0, 0, "missing", 0, empty_revision) != -1 { return 59 }
    if find_int_if_model_revision(0, 1, 42 as Int64, 0, empty_revision) != -1 { return 60 }
    if find_uint_if_model_revision(0, 2, 7u64, 0, empty_revision) != -1 { return 61 }
    if find_float_if_model_revision(0, 3, 1.25f64, 0, empty_revision) != -1 { return 62 }
    if find_bool_if_model_revision(0, 4, true, 0, empty_revision) != -1 { return 63 }
    if index_find_text_if_model_revision(0, 0, "missing", empty_revision) != -1 { return 64 }
    if index_find_int_if_model_revision(0, 1, 42 as Int64, empty_revision) != -1 { return 65 }
    if index_find_uint_if_model_revision(0, 2, 7u64, empty_revision) != -1 { return 66 }
    if index_find_float_if_model_revision(0, 3, 1.25f64, empty_revision) != -1 { return 67 }
    if index_find_bool_if_model_revision(0, 4, true, empty_revision) != -1 { return 68 }
    if count_if_model_revision(99, empty_revision) != -1 { return 69 }
    if list.find_text_if_model_revision(99, "missing", 0, empty_revision) != -1 { return 70 }
    if row_count_if_model_revision(-1, empty_revision) != -1 { return 71 }
    if table.find_text_if_model_revision(-1, 0, "missing", 0, empty_revision) != -1 { return 72 }
    if find_int_if_model_revision(99, 1, 42 as Int64, 0, empty_revision) != -1 { return 73 }
    if find_uint_if_model_revision(-1, 2, 7u64, 0, empty_revision) != -1 { return 74 }
    if find_float_if_model_revision(99, 3, 1.25f64, 0, empty_revision) != -1 { return 75 }
    if find_bool_if_model_revision(-1, 4, true, 0, empty_revision) != -1 { return 76 }
    if index_find_text_if_model_revision(99, 0, "missing", empty_revision) != -1 { return 77 }
    if index_find_int_if_model_revision(-1, 1, 42 as Int64, empty_revision) != -1 { return 78 }
    if index_find_uint_if_model_revision(99, 2, 7u64, empty_revision) != -1 { return 79 }
    if index_find_float_if_model_revision(-1, 3, 1.25f64, empty_revision) != -1 { return 80 }
    if index_find_bool_if_model_revision(99, 4, true, empty_revision) != -1 { return 81 }
    if find_column_if_model_revision(99, "name", empty_revision) != -1 { return 82 }
    if schema_version_if_model_revision(-1, empty_revision) != -1 { return 83 }

    return 0
}
