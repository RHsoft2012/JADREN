module network_response_header_buffer_project.main

import jadren.network.http.response_header_exact_buffer
import jadren.network.http.write_response_header_block_ex

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 { return event_id }

fn run(response: write Buffer<UInt8>, output: write Buffer<UInt8>, short: write Buffer<UInt8>) -> Int32 {
    if !buffer_resize(response, 512usize) { return 1 }
    if !buffer_resize(output, 64usize) { return 2 }
    if !buffer_resize(short, 3usize) { return 3 }
    var body: [UInt8; 2] = [79u8, 75u8]
    let written: UIntSize = write_response_header_block_ex(
        200u16,
        "text/plain",
        "ETag: \"abc123\"\r\nRetry-After: 7\r\nX-Empty:",
        body,
        false,
        buffer_slice_write(response, 0usize, 512usize),
    )
    if written == 0usize { return 4 }
    if !buffer_resize(response, written) { return 5 }

    var length: [UIntSize; 1] = [77usize]
    if !response_header_exact_buffer(response, "ETag", output, 64usize, length) { return 6 }
    if length[0] != 8usize { return 7 }
    if output[0] != 34u8 { return 8 }
    if output[7] != 34u8 { return 9 }

    if !response_header_exact_buffer(response, "Retry-After", output, 64usize, length) { return 10 }
    if length[0] != 1usize { return 11 }
    if output[0] != 55u8 { return 12 }

    output[0] = 77u8
    if !response_header_exact_buffer(response, "X-Empty", output, 64usize, length) { return 13 }
    if length[0] != 0usize { return 14 }
    if output[0] != 77u8 { return 15 }

    short[0] = 91u8
    length[0] = 123usize
    if response_header_exact_buffer(response, "ETag", short, 3usize, length) { return 16 }
    if short[0] != 91u8 { return 17 }
    if length[0] != 123usize { return 18 }
    return 0
}

fn main() -> Int32 {
    var status: Int32 = 0i32
    let response_created: Result<Buffer<UInt8>, Int32> = buffer_create(512usize)
    match response_created {
        Ok(response) => {
            let output_created: Result<Buffer<UInt8>, Int32> = buffer_create(64usize)
            match output_created {
                Ok(output) => {
                    let short_created: Result<Buffer<UInt8>, Int32> = buffer_create(3usize)
                    match short_created {
                        Ok(short) => { status = run(response, output, short) }
                        Error(error) => { status = error }
                    }
                }
                Error(error) => { status = error }
            }
        }
        Error(error) => { status = error }
    }
    return status
}
