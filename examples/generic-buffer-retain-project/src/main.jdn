module generic_buffer_retain.main

import jadren.core.collections.append
import jadren.core.collections.capacity
import jadren.core.collections.create
import jadren.core.collections.length
import jadren.core.collections.retain

fn main() -> Int32 {
    var result_code: Int32 = 0

    let integers: Result<Buffer<Int32>, Int32> = create(8usize)
    match integers {
        Ok(values) => {
            if ! append(values, 7) { result_code = 1 }
            if ! append(values, 3) { result_code = 2 }
            if ! append(values, 7) { result_code = 3 }
            if ! append(values, 9) { result_code = 4 }
            if ! append(values, 7) { result_code = 5 }
            let initial_capacity: UIntSize = capacity(values)
            if ! retain(values, 7) { result_code = 6 }
            if length(values) != 3usize { result_code = 7 }
            if values[0] != 7 { result_code = 8 }
            if values[1] != 7 { result_code = 9 }
            if values[2] != 7 { result_code = 10 }
            if capacity(values) != initial_capacity { result_code = 11 }
            if ! retain(values, 9) { result_code = 12 }
            if length(values) != 0usize { result_code = 13 }
            if capacity(values) != initial_capacity { result_code = 14 }
        }
        Error(status) => { result_code = status }
    }

    let bools: Result<Buffer<Bool>, Int32> = create(4usize)
    match bools {
        Ok(values) => {
            if ! append(values, true) { result_code = 15 }
            if ! append(values, false) { result_code = 16 }
            if ! append(values, true) { result_code = 17 }
            let initial_capacity: UIntSize = capacity(values)
            if ! retain(values, true) { result_code = 18 }
            if length(values) != 2usize { result_code = 19 }
            if values[0] != true { result_code = 20 }
            if values[1] != true { result_code = 21 }
            if capacity(values) != initial_capacity { result_code = 22 }
            if ! retain(values, false) { result_code = 23 }
            if length(values) != 0usize { result_code = 24 }
        }
        Error(status) => { result_code = status }
    }

    let empty: Result<Buffer<Int32>, Int32> = create(0usize)
    match empty {
        Ok(values) => {
            if ! retain(values, 1) { result_code = 25 }
            if length(values) != 0usize { result_code = 26 }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
