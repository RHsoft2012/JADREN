fn status_from_code(code: Int64) -> AssetStatus {
    if code == 1i64 {
        return AssetStatus.Discovered
    }
    if code == 2i64 {
        return AssetStatus.Ready
    }
    if code == 3i64 {
        return AssetStatus.Missing
    }
    if code == 4i64 {
        return AssetStatus.Failed
    }
    return AssetStatus.Unknown
}
