module examples.stdlib_buffer_owning_result_carrier_insert_move_from

// Insert caller-owned Result carriers into a dynamic list. Ok transfers the
// OwnedString descriptor, Error stays scalar-only, and an invalid index keeps
// the status path rollback-safe.
fn main() -> Int32 {
    let values_created: Result<Buffer<Result<OwnedString, Int32>>, Int32> = buffer_create(0usize)
    let first_created: Result<OwnedString, Int32> = string_owned_from("first")
    let second_created: Result<OwnedString, Int32> = string_owned_from("second")
    let status_created: Result<OwnedString, Int32> = string_owned_from("status")
    var result_code: Int32 = 0

    match values_created {
        Ok(values) => {
            match first_created {
                Ok(first) => {
                    match second_created {
                        Ok(second) => {
                            match status_created {
                                Ok(status_text) => {
                                    let existing: Result<OwnedString, Int32> = Error(-7)
                                    let incoming: Result<OwnedString, Int32> = Ok(second)
                                    if !buffer_append(values, existing) { result_code = 1 }
                                    if !buffer_insert_move_from(values, 0usize, incoming) { result_code = 2 }
                                    if buffer_length(values) != 2usize { result_code = 3 }
                                    let invalid: Result<OwnedString, Int32> = Ok(status_text)
                                    let status: Int32 = buffer_insert_move_from_status(values, 99usize, invalid)
                                    if status != -20 { result_code = 4 }
                                    if buffer_length(values) != 2usize { result_code = 5 }
                                    let unused_first: Result<OwnedString, Int32> = Ok(first)
                                    if !buffer_append(values, unused_first) { result_code = 6 }
                                    if !buffer_remove_drop(values, 0usize) { result_code = 7 }
                                    if !buffer_clear_move(values) { result_code = 8 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    return result_code
}
