module examples.app_state_dynamic

// Dynamic bounded key registry: enumerate, remove, then enumerate again.
fn main() -> Int32 {
    app_state_clear()
    let first_set: Bool = app_state_set_text("first", "A")
    let second_set: Bool = app_state_set_int("second", 2 as Int64)
    let third_set: Bool = app_state_set_bool("third", true)
    if !first_set { return 1 }
    if !second_set { return 2 }
    if !third_set { return 3 }
    if app_state_count() != 3 { return 4 }

    var key: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let first_length: UIntSize = app_state_read_key(0, key)
    if first_length != 5usize { return 5 }
    if key[0] != 102u8 { return 6 }

    let second_length: UIntSize = app_state_read_key(1, key)
    if second_length != 6usize { return 7 }
    if key[0] != 115u8 { return 8 }

    let removed: Bool = app_state_remove("second")
    if !removed { return 9 }
    if app_state_count() != 2 { return 10 }
    let shifted_length: UIntSize = app_state_read_key(1, key)
    if shifted_length != 5usize { return 11 }
    if key[0] != 116u8 { return 12 }

    let missing: Bool = app_state_remove("missing")
    if missing { return 13 }
    app_state_clear()
    return 0
}
