module examples.stdlib_buffer_nested_owning_carrier_array

// The outer Buffer owns inner buffers whose leaf is an inline array of
// Option<OwnedString>. Nested cleanup must reach both carrier slots.
fn main() -> Int32 {
    let outer_created: Result<Buffer<Buffer<[Option<OwnedString>; 2]>>, Int32> = buffer_create(0usize)
    let inner_created: Result<Buffer<[Option<OwnedString>; 2]>, Int32> = buffer_create(0usize)
    let first_created: Result<OwnedString, Int32> = string_owned_from("first")
    let second_created: Result<OwnedString, Int32> = string_owned_from("second")
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match inner_created {
                Ok(inner) => {
                    match first_created {
                        Ok(first) => {
                            match second_created {
                                Ok(second) => {
                                    let item: [Option<OwnedString>; 2] = [Some(first), Some(second)]
                                    if !buffer_append(inner, item) { result_code = 1 }
                                    if !buffer_append_move(outer, inner) { result_code = 2 }
                                    if buffer_length(outer) != 1usize { result_code = 3 }
                                    let grown: Int32 = buffer_resize_move_status(outer, 2usize)
                                    if grown != 0 { result_code = 4 }
                                    if !buffer_remove_drop(outer, 0usize) { result_code = 5 }
                                    if !buffer_clear_move(outer) { result_code = 6 }
                                    if buffer_length(outer) != 0usize { result_code = 7 }
                                    let status: Int32 = buffer_remove_drop_status(outer, 0usize)
                                    if status != -20 { result_code = 8 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    return result_code
}
