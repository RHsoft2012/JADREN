module examples.native_file_flush_path

// Flushes an export through a caller-owned UTF-8 path, such as the exact bytes
// published by ui_file_save_extension_exact. An invalid explicit path length
// is rejected before the runtime opens the existing target.
fn main() -> Int32 {
    var path: [UInt8; 28] = [116u8, 97u8, 114u8, 103u8, 101u8, 116u8, 47u8,
        106u8, 97u8, 100u8, 114u8, 101u8, 110u8, 45u8, 102u8, 108u8,
        117u8, 115u8, 104u8, 45u8, 112u8, 97u8, 116u8, 104u8, 46u8, 98u8,
        105u8, 110u8]
    var input: [UInt8; 3] = [65u8, 66u8, 67u8]
    var output: [UInt8; 3] = [0u8, 0u8, 0u8]

    if file_write_prefix_path(path, 28usize, input, 3usize) != 3usize { return 1 }
    if file_flush_path(path, 29usize) { return 2 }
    if !file_flush_path(path, 28usize) { return 3 }
    if file_read_at_path(path, 28usize, 0usize, output) != 3usize { return 4 }
    if output[0] != 65u8 { return 5 }
    if output[1] != 66u8 { return 6 }
    if output[2] != 67u8 { return 7 }
    return 0
}
