module examples.app_list_sort_callback

// Sort by UTF-8 item length while preserving the order of equal lengths.
fn compare_length(list_id: Int32, left_item: Int32, right_item: Int32) -> Int32 {
    var left: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var right: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let left_length: UIntSize = app_list_read_text(list_id, left_item, left)
    let right_length: UIntSize = app_list_read_text(list_id, right_item, right)
    if left_length < right_length { return -1 }
    if left_length > right_length { return 1 }
    return 0
}

fn mutate_source(list_id: Int32, left_item: Int32, right_item: Int32) -> Int32 {
    if left_item == 0 {
        if right_item == 1 {
            let changed: Bool = app_list_push_text(list_id, "Mutation")
        }
    }
    return 0
}

fn main() -> Int32 {
    app_list_clear(0)
    if !app_list_push_text(0, "Long") { return 1 }
    if !app_list_push_text(0, "A") { return 2 }
    if !app_list_push_text(0, "Bee") { return 3 }
    if !app_list_push_text(0, "C") { return 4 }
    if !app_list_sort_callback(0, compare_length) { return 5 }

    var output: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let first_length: UIntSize = app_list_read_text(0, 0, output)
    if first_length != 1usize { return 6 }
    if output[0] != 65u8 { return 7 }
    let second_length: UIntSize = app_list_read_text(0, 1, output)
    if second_length != 1usize { return 8 }
    if output[0] != 67u8 { return 9 }
    let third_length: UIntSize = app_list_read_text(0, 2, output)
    if third_length != 3usize { return 10 }
    if output[0] != 66u8 { return 11 }

    app_list_clear(0)
    if !app_list_push_text(0, "First") { return 12 }
    if !app_list_push_text(0, "Second") { return 13 }
    if app_list_sort_callback(0, mutate_source) { return 14 }
    if app_list_count(0) != 3 { return 15 }
    let preserved_length: UIntSize = app_list_read_text(0, 0, output)
    if preserved_length != 5usize { return 16 }
    if output[0] != 70u8 { return 17 }
    return 0
}
