module app_state_add_uint.main
// Unsigned counters use the same bounded and revision-guarded contract as
// signed counters, with overflow rejected before any state mutation.
fn main() -> Int32 {
    app_state_clear()
    if ! app_state_add_uint("downloads",
    3u64) {
        return 1
    }
    if app_state_get_uint("downloads") != 3u64 {
        return 2
    }
    if ! app_state_add_uint("downloads",
    4u64) {
        return 3
    }
    if app_state_get_uint("downloads") != 7u64 {
        return 4
    }
    let snapshot: UInt64 = app_state_revision()
    if ! app_state_add_uint_if_revision("downloads",
    5u64,
    snapshot) {
        return 5
    }
    if app_state_get_uint("downloads") != 12u64 {
        return 6
    }
    let current: UInt64 = app_state_revision()
    if app_state_add_uint_if_revision("downloads",
    1u64,
    snapshot) {
        return 7
    }
    if app_state_get_uint("downloads") != 12u64 {
        return 8
    }
    if app_state_revision() != current {
        return 9
    }
    if ! app_state_set_int("wrong_kind",
    1i64) {
        return 10
    }
    let mismatch_revision: UInt64 = app_state_revision()
    if app_state_add_uint_if_revision("wrong_kind",
    1u64,
    mismatch_revision) {
        return 11
    }
    if app_state_revision() != mismatch_revision {
        return 12
    }
    if app_state_get_uint("wrong_kind") != 1u64 {
        return 13
    }
    if ! app_state_set_uint("maximum",
    18446744073709551615u64) {
        return 14
    }
    let overflow_revision: UInt64 = app_state_revision()
    if app_state_add_uint("maximum",
    1u64) {
        return 15
    }
    if app_state_add_uint_if_revision("maximum",
    1u64,
    overflow_revision) {
        return 16
    }
    if app_state_get_uint("maximum") != 18446744073709551615u64 {
        return 17
    }
    if app_state_revision() != overflow_revision {
        return 18
    }
    var output:[UInt64;
    1] =[0u64]
    if ! app_state_read_uint("downloads",
    output) {
        return 19
    }
    if output[0] != 12u64 {
        return 20
    }
    return 0
}
