module examples.app_export_file_durable_project

import jadren.app.list.clear
import jadren.app.list.export_csv_file_durable
import jadren.app.list.push_text

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    file_delete("target/jadren/app-export-file-list.csv")
    file_delete("target/jadren/app-export-file-list.tmp")
    file_delete("target/jadren/app-export-file-table.csv")
    file_delete("target/jadren/app-export-file-table.tmp")

    clear(0)
    if !export_csv_file_durable(0, "target/jadren/app-export-file-list.csv", "target/jadren/app-export-file-list.tmp") { return 1 }
    if !file_exists("target/jadren/app-export-file-list.csv") { return 2 }
    if file_size("target/jadren/app-export-file-list.csv") != 0usize { return 2 }
    if file_exists("target/jadren/app-export-file-list.tmp") { return 3 }

    if !push_text(0, "A") { return 4 }
    if !push_text(0, "B,C") { return 5 }
    if file_write_text("target/jadren/app-export-file-list.csv", "old") != 3usize { return 6 }
    if !export_csv_file_durable(0, "target/jadren/app-export-file-list.csv", "target/jadren/app-export-file-list.tmp") { return 7 }
    if file_exists("target/jadren/app-export-file-list.tmp") { return 8 }
    if file_size("target/jadren/app-export-file-list.csv") != 8usize { return 8 }

    var list_output: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var list_length: [UIntSize; 1] = [999usize]
    if !file_read_exact("target/jadren/app-export-file-list.csv", list_output, list_length) { return 9 }
    if list_length[0] != 8usize { return 10 }
    if list_output[0] != 65u8 { return 10 }
    if list_output[2] != 34u8 { return 10 }
    if list_output[6] != 34u8 { return 10 }
    if list_output[7] != 10u8 { return 10 }

    if export_csv_file_durable(0, "target/jadren/app-export-file-list.csv", "target/jadren/app-export-file-list.csv") { return 11 }
    if file_size("target/jadren/app-export-file-list.csv") != 8usize { return 12 }
    if file_exists("target/jadren/app-export-file-list.tmp") { return 12 }

    app_table_clear(0)
    if !app_table_set_column_name(0, 0, "name") { return 13 }
    if !app_table_append_row(0) { return 14 }
    if !app_table_set_cell(0, 0, 0, "Alpha") { return 15 }
    if file_write_text("target/jadren/app-export-file-table.csv", "old-table") != 9usize { return 16 }
    if !app_table_export_csv_file_durable(0, "target/jadren/app-export-file-table.csv", "target/jadren/app-export-file-table.tmp") { return 17 }
    if file_exists("target/jadren/app-export-file-table.tmp") { return 18 }
    if file_size("target/jadren/app-export-file-table.csv") != 11usize { return 18 }

    var table_output: [UInt8; 33] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var table_length: [UIntSize; 1] = [777usize]
    if !file_read_exact("target/jadren/app-export-file-table.csv", table_output, table_length) { return 19 }
    if table_length[0] != 11usize { return 20 }
    if table_output[0] != 110u8 { return 20 }
    if table_output[4] != 10u8 { return 20 }
    if table_output[5] != 65u8 { return 20 }
    if table_output[10] != 10u8 { return 20 }

    app_table_clear(1)
    if file_write_text("target/jadren/app-export-file-table.csv", "keep-table") != 10usize { return 21 }
    if app_table_export_csv_file_durable(1, "target/jadren/app-export-file-table.csv", "target/jadren/app-export-file-table.tmp") { return 22 }
    if file_exists("target/jadren/app-export-file-table.tmp") { return 23 }
    if file_size("target/jadren/app-export-file-table.csv") != 10usize { return 23 }

    file_delete("target/jadren/app-export-file-list.csv")
    file_delete("target/jadren/app-export-file-list.tmp")
    file_delete("target/jadren/app-export-file-table.csv")
    file_delete("target/jadren/app-export-file-table.tmp")
    return 0
}
