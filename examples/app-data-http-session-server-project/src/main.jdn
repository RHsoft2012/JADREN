module app_data_http_session_server_project.main

import jadren.app.data.load_exact
import jadren.app.data.load_exact_if_revision
import jadren.app.data.revision
import jadren.app.data.save_atomic
import jadren.app.data.snapshot_length
import jadren.app.data.snapshot_length_if_revision
import jadren.app.data.write_exact
import jadren.app.data.write_exact_if_revision
import jadren.app.fs.write_text
import jadren.app.list.push_text
import jadren.app.state.clear
import jadren.app.state.set_int
import jadren.app.table.append_row
import jadren.app.table.set_cell
import jadren.network.http.request_append
import jadren.network.http.request_body_exact_prefix
import jadren.network.http.request_is_complete_prefix
import jadren.network.http.route_match_prefix
import jadren.network.http.write_response_header_prefix
import jadren.network.tcp.accept
import jadren.network.tcp.close_socket
import jadren.network.tcp.listen
import jadren.network.tcp.receive
import jadren.network.tcp.send_all_prefix
import jadren.network.tcp.set_timeout

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn serve_client(
    client: UIntSize,
    request: write Slice<UInt8>,
    input_body: write Slice<UInt8>,
    model_body: write Slice<UInt8>,
    response: write Slice<UInt8>,
) -> Int32 {
    if !set_timeout(client, 3000u32) {
        close_socket(client)
        return 1
    }
    var chunk: [UInt8; 256] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var received: UIntSize = 0usize
    var reads: UIntSize = 0usize
    while reads < 16usize {
        if received >= 1536usize { break }
        let chunk_received: UIntSize = receive(client, chunk)
        if chunk_received == 0usize { break }
        let appended: UIntSize = request_append(request, received, chunk, chunk_received)
        if appended == 0usize { break }
        received = appended
        reads = reads + 1usize
        if request_is_complete_prefix(request, received) { break }
    }
      var accepted: Bool = false
      var stale_rejected: Bool = false
      var export_stale_rejected: Bool = false
    if received > 0usize {
        if request_is_complete_prefix(request, received) {
            if route_match_prefix(request, received, "POST", "/model") {
                var input_length: [UIntSize; 1] = [0usize]
                if request_body_exact_prefix(request, received, input_body, input_length) {
                    accepted = load_exact(input_body, input_length[0])
                }
              } else if route_match_prefix(request, received, "POST", "/stale") {
                var input_length: [UIntSize; 1] = [0usize]
                if request_body_exact_prefix(request, received, input_body, input_length) {
                    let expected_revision: UInt64 = revision()
                    if !set_int("selected", 99i64) {
                        accepted = false
                    } else {
                        accepted = load_exact_if_revision(
                            input_body, input_length[0], expected_revision
                        )
                        stale_rejected = !accepted
                    }
                  }
              } else if route_match_prefix(request, received, "POST", "/export-stale") {
                  let expected_revision: UInt64 = revision()
                  var export_length: [UIntSize; 1] = [0usize]
                  if !set_int("selected", 100i64) {
                      accepted = false
                  } else {
                      accepted = write_exact_if_revision(
                          model_body, export_length, expected_revision
                      )
                      export_stale_rejected = !accepted
                  }
              } else if route_match_prefix(request, received, "GET", "/model") {
                accepted = true
            }
        }
    }
    var stale: [UInt8; 5] = [83u8, 84u8, 65u8, 76u8, 69u8]
      if stale_rejected {
        let response_length: UIntSize = write_response_header_prefix(
            409u16, "text/plain", "X-Jadren-Model", "stale",
            stale, 5usize, response
        )
        if response_length == 0usize { close_socket(client); return 2 }
        let sent: UIntSize = send_all_prefix(client, response, response_length)
        let closed: Bool = close_socket(client)
        if sent != response_length { return 3 }
        if !closed { return 4 }
          return 0
      }
      var export_stale: [UInt8; 12] = [69u8, 88u8, 80u8, 79u8, 82u8, 84u8, 45u8, 83u8, 84u8, 65u8, 76u8, 69u8]
      if export_stale_rejected {
          let response_length: UIntSize = write_response_header_prefix(
              409u16, "text/plain", "X-Jadren-Model", "export-stale",
              export_stale, 12usize, response
          )
          if response_length == 0usize { close_socket(client); return 2 }
          let sent: UIntSize = send_all_prefix(client, response, response_length)
          let closed: Bool = close_socket(client)
          if sent != response_length { return 3 }
          if !closed { return 4 }
          return 0
      }
    var rejected: [UInt8; 5] = [69u8, 82u8, 82u8, 79u8, 82u8]
    if !accepted {
        let response_length: UIntSize = write_response_header_prefix(
            400u16, "text/plain", "X-Jadren-Model", "rejected",
            rejected, 5usize, response
        )
        if response_length == 0usize { close_socket(client); return 2 }
        let sent: UIntSize = send_all_prefix(client, response, response_length)
        let closed: Bool = close_socket(client)
        if sent != response_length { return 3 }
        if !closed { return 4 }
        return 5
    }
    let expected_model_revision: UInt64 = revision()
    let planned_model_length: UIntSize = snapshot_length_if_revision(expected_model_revision)
    if planned_model_length == 0usize {
        close_socket(client)
        return 6
    }
    if planned_model_length > 1024usize {
        close_socket(client)
        return 6
    }
    var model_length: [UIntSize; 1] = [0usize]
    if !write_exact_if_revision(model_body, model_length, expected_model_revision) {
        close_socket(client)
        return 6
    }
    if model_length[0] != planned_model_length {
        close_socket(client)
        return 6
    }
    let response_length: UIntSize = write_response_header_prefix(
        200u16, "application/octet-stream", "X-Jadren-Model", "native",
        model_body, model_length[0], response
    )
    if response_length == 0usize { close_socket(client); return 7 }
    let sent: UIntSize = send_all_prefix(client, response, response_length)
    let closed: Bool = close_socket(client)
    if sent != response_length { return 8 }
    if !closed { return 9 }
    return 0
}

fn main() -> Int32 {
    clear()
    app_list_clear(0)
    app_table_clear(0)
    if !set_int("selected", 7i64) { return 1 }
    if !push_text(0, "First task") { return 2 }
    if !push_text(0, "Second task") { return 3 }
    if !append_row(0) { return 4 }
    if !set_cell(0, 0, 0, "Build") { return 5 }
    if !set_cell(0, 0, 1, "Open") { return 6 }

    var request: [UInt8; 1536] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0