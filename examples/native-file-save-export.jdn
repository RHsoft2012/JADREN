    let copied: UIntSize = string_builder_append_bytes_prefix(
        target, target_length[0], temporary, 0usize
    )
    if copied != target_length[0] { return 2 }
    let lock_length: UIntSize = string_builder_append(".jadren.lock", temporary, copied)
    if lock_length == 0usize { return 3 }
    // Three caller-visible attempts avoid a short collision between cooperating
    // exports without introducing an unbounded wait on the UI thread.
    let lock_token: UIntSize = file_lock_path_retry(temporary, lock_length, 3usize, 20usize)
    if lock_token == 0usize { return 4 }
    let temporary_length: UIntSize = string_builder_append(".jadren.tmp", temporary, copied)
    if temporary_length == 0usize {
        file_unlock(lock_token)
        return 5
    }

    var csv: [UInt8; 21] = [105u8, 100u8, 44u8, 115u8, 116u8, 97u8, 116u8,
        117u8, 115u8, 10u8, 49u8, 44u8, 101u8, 120u8, 112u8, 111u8,
        114u8, 116u8, 101u8, 100u8, 10u8]
    if file_write_prefix_path(temporary, temporary_length, csv, 21usize) != 21usize {
        file_delete_path(temporary, temporary_length)
        file_unlock(lock_token)
        return 6
    }
    if !file_flush_path(temporary, temporary_length) {
        file_delete_path(temporary, temporary_length)
        file_unlock(lock_token)
        return 7
    }
    if !file_replace_atomic_paths(temporary, temporary_length, target, target_length[0]) {
        file_delete_path(temporary, temporary_length)
        file_unlock(lock_token)
        return 8
    }
    if !file_flush_path(target, target_length[0]) {
        file_unlock(lock_token)
        return 9
    }
    if !file_unlock(lock_token) { return 10 }
    return 0
}

fn main() -> Int32 {
    return export_csv()
}
