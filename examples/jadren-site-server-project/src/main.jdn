            } else if is_keep_alive_flag {
                var parsed_keep_alive:[UInt64;
                1] =[0u64]
                if ! parse_uint(value_text,
                value_length,
                parsed_keep_alive) {
                    return 11
                }
                if parsed_keep_alive[0] == 0u64 {
                    allow_keep_alive = false
                } else if parsed_keep_alive[0] == 1u64 {
                    allow_keep_alive = true
                } else {
                    return 11
                }
            } else {
                if parsed_value[0] == 0u64 {
                    return 11
                }
                max_requests = parsed_value[0] as UIntSize
            }
        }
        argument_index = argument_index + 2usize
    }
    dir_create("logs")
    var download_count:[UInt64;
    1] =[0u64]
    if ! load_download_count(download_count) {
        return 11
    }
    if tls_enabled {
        if tls_certificate_length == 0usize {
            return 11
        }
        if tls_private_key_length == 0usize {
            return 11
        }
    }
    var rate_state:[UInt64;
    2] =[0u64,
    0u64]
    // requests, successful responses, other 4xx responses, 429 responses, 5xx responses
    var metrics:[UInt64;
    5] =[0u64,
    0u64,
    0u64,
    0u64,
    0u64]
    let listener: UIntSize = if bind_address_length > 0usize {
        listen_on_prefix(bind_address, bind_address_length, port)
    } else {
        listen(port)
    }
    if listener == 0usize {
        return 10
    }
    var served: UIntSize = 0usize
    var running: Bool = true
    while running {
        let client: UIntSize = accept(listener)
        if client == 0usize {
            served = served + 1usize
        } else {
            var tls: UIntSize = 0usize
            if tls_enabled {
                tls = open_server_paths(client,
                tls_certificate_path,
                tls_certificate_length,
                tls_private_key_path,
                tls_private_key_length)
                if tls == 0usize {
                    close(client)
                    served = served + 1usize
                    if max_requests>0usize {
                        if served >= max_requests {
                            running = false
                        }
                    }
                    continue
                }
            }
            let handled: Int32 = serve_client(client,
            tls,
            tls_enabled,
            allow_keep_alive,
            rate_limit,
            rate_state,
            admin_token,
            admin_token_length,
            metrics,
            download_count,
            host_allowlist,
            host_allowlist_length)
            if handled<0 {
                served = served + 1usize
            } else {
                served = served + 1usize
            }
        }
        if max_requests>0usize {
            if served >= max_requests {
                running = false
            }
        }
    }
    close(listener)
    return 0
}
