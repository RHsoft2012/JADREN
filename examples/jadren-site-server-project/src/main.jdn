    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let digit_length: UIntSize = format_uint(value,
    digits)
    write_atomic_durable(
    "logs/jadren-site-server.downloads.count.tmp",
