// Native static origin for the current working directory.
// Keep the audit contract deliberately redacted: no path, query, headers, or
// client address is persisted. The log is caller-owned append-only JSONL.
fn audit_request(status: UInt16) {
    var written: UIntSize = 0usize
    if status == 200u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":200}\n")
    } else if status == 302u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":302}\n")
    } else if status == 304u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":304}\n")
    } else if status == 206u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":206}\n")
    } else if status == 400u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":400}\n")
    } else if status == 404u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":404}\n")
    } else if status == 403u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":403}\n")
    } else if status == 405u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":405}\n")
    } else if status == 416u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":416}\n")
    } else if status == 429u16 {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":429}\n")
    } else {
        written = append_text("logs/jadren-site-server.audit.jsonl",
        "{\"event\":\"request\",\"status\":500}\n")
    }
    if written != 0usize {
        if ! flush("logs/jadren-site-server.audit.jsonl") {
            written = 0usize
        }
    }
}
// Download accounting is deliberately aggregate and local: only a completed
// full GET of a /releases/ artifact increments this monotonic counter. No IP,
// user agent, query or client identity is retained.
// A missing counter is the first-run state. Once the file exists, malformed
// content must stop startup instead of silently resetting a durable metric.
fn load_download_count(output: write Slice<UInt64>) -> Bool {
    output[0] = 0u64
    if ! exists("logs/jadren-site-server.downloads.count") {
        return true
    }
    var stored:[UInt8;
    32] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    var stored_length:[UIntSize;
    1] =[0usize]
    if ! read_text_exact("logs/jadren-site-server.downloads.count",
    stored,
    stored_length) {
        return false
    }
    // Accept the conventional text-file line ending without accepting any
    // other whitespace or silently recovering malformed persisted state.
    var normalized_length: UIntSize = stored_length[0]
    while normalized_length > 0usize {
        let last: UInt8 = stored[normalized_length - 1usize]
        if last == 10u8 {
            normalized_length = normalized_length - 1usize
        } else if last == 13u8 {
            normalized_length = normalized_length - 1usize
        } else {
            break
        }
    }
    if normalized_length == 0usize {
        return false
    }
    var parsed:[UInt64;
    1] =[0u64]
    if parse_uint(stored,
    normalized_length,
    parsed) {
        output[0] = parsed[0]
        return true
    }
    return false
}
