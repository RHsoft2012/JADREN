    5000u32)
    let seventh: UInt32 = step(tls,
    5000u32)
    let eighth: UInt32 = step(tls,
    5000u32)
    if first == 4u32 {
        return false
    }
    if second == 4u32 {
        return false
    }
    if third == 4u32 {
        return false
