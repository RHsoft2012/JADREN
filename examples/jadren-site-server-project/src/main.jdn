    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let actual_length: UIntSize = process_arg_read(index,
    actual)
    if actual_length != expected_length {
        return false
    }
    var position: UIntSize = 0usize
    while position < expected_length {
        if actual[position] != expected[position] {
            return false
        }
        position = position + 1usize
    }
    return true
}
fn print_server_help() {
    print("Jadren native site server 0.1.3-preview.13")
    print("Usage: jadrenserver.exe [--version | --help | --update]")
    print("       jadrenserver.exe [server options]")
    print("  --version              print the installed server version")
    print("  --help                 print this help")
    print("  --update               queue a safe update check for the external updater")
    print("  --port <n>             listen on TCP port (default 8080)")
    print("  --bind-address <ipv4>  bind to a numeric IPv4 address")
    print("  --hostname-file <p>    allow Host values listed one per line")
    print("  --admin-token-file <p> enable authenticated admin routes")
    print("  --tls-cert <p> --tls-key <v> enable direct TLS")
}
fn redirect_target_code(target: read Slice<UInt8>, length: UIntSize) -> UInt8 {
    var home:[UInt8;
    5] =[47u8,
    104u8,
    111u8,
    109u8,
    101u8]
    var home_slash:[UInt8;
    6] =[47u8,
    104u8,
    111u8,
    109u8,
    101u8,
    47u8]
    var landing:[UInt8;
    13] =[47u8,
    108u8,
    97u8,
    110u8,
    100u8,
    105u8,
    110u8,
    103u8,
    46u8,
    104u8,
    116u8,
    109u8,
    108u8]
    var docs_index:[UInt8;
    26] =[47u8,
    100u8,
    111u8,
    99u8,
    115u8,
    47u8,
    114u8,
    101u8,
    102u8,
    101u8,
    114u8,
    101u8,
    110u8,
    99u8,
    101u8,
    47u8,
    105u8,
    110u8,
    100u8,
    101u8,
    120u8,
    46u8,
    104u8,
    116u8,
    109u8,
    108u8]
    var docs_css:[UInt8;
    38] =[47u8,
    100u8,
    111u8,
    99u8,
    115u8,
    47u8,
    114u8,
    101u8,
    102u8,
    101u8,
    114u8,
    101u8,
    110u8,
    99u8,
    101u8,
    47u8,
    97u8,
    115u8,
    115u8,
    101u8,
    116u8,
    115u8,
    47u8,
    106u8,
    97u8,
    100u8,
    114u8,
    101u8,
    110u8,
    45u8,
    100u8,
    111u8,
    99u8,
    115u8,
    46u8,
    99u8,
    115u8,
    115u8]
    if length == 5usize {
        if bytes_equal_exact(target,
        length,
        home,
        5usize) {
            return 1u8
        }
    }
    if length == 6usize {
        if bytes_equal_exact(target,
        length,
        home_slash,
        6usize) {
            return 1u8
        }
    }
    if length == 13usize {
        if bytes_equal_exact(target,
        length,
        landing,
        13usize) {
            return 1u8
        }
    }
    if length == 26usize {
        if bytes_equal_exact(target,
        length,
        docs_index,
        26usize) {
            return 2u8
        }
    }
    if length == 38usize {
        if bytes_equal_exact(target,
        length,
        docs_css,
        38usize) {
            return 3u8
        }
    }
    if length >= 16usize {
        if target[0] == 47u8 {
            if target[1] == 100u8 {
                if target[2] == 111u8 {
                    if target[3] == 99u8 {
                        if target[4] == 115u8 {
                            if target[5] == 47u8 {
                                if target[6] == 114u8 {
                                    if target[7] == 101u8 {
                                        if target[8] == 102u8 {
                                            if target[9] == 101u8 {
                                                if target[10] == 114u8 {
                                                    if target[11] == 101u8 {
                                                        if target[12] == 110u8 {
                                                            if target[13] == 99u8 {
                                                                if target[14] == 101u8 {
                                                                    if target[15] == 47u8 {
                                                                        return 3u8
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0u8
}
fn append_legacy_docs_suffix(target: read Slice<UInt8>, length: UIntSize, output: write Slice<UInt8>) -> UIntSize {
    var source_index: UIntSize = 16usize
    var output_length: UIntSize = 0usize
    while source_index<length {
        output[output_length] = target[source_index]
        output_length = output_length + 1usize
        source_index = source_index + 1usize
    }
    return output_length
}
// `http_request_header_exact` intentionally rejects duplicate headers. This
// bounded pre-scan distinguishes an absent Range header from a malformed or
// duplicate one, so the latter cannot silently become a complete download.
fn request_has_range_header(request: read Slice<UInt8>, input_length: UIntSize) -> Bool {
    var cursor: UIntSize = 0usize
    var request_line_complete: Bool = false
    while cursor + 1usize<input_length {
        if request[cursor] == 13u8 {
            if request[cursor + 1usize] == 10u8 {
                cursor = cursor + 2usize
                request_line_complete = true
                break
            }
        }
        cursor = cursor + 1usize
    }
    if ! request_line_complete {
        return false
    }
    while cursor + 1usize<input_length {
        if request[cursor] == 13u8 {
            if request[cursor + 1usize] == 10u8 {
                return false
            }
        }
        if cursor + 5usize<input_length {
            let first: UInt8 = request[cursor]
            if ascii_equal_ignore_case(first,
            114u8,
            82u8) {
                if ascii_equal_ignore_case(request[cursor + 1usize],
                97u8,
                65u8) {
                    if ascii_equal_ignore_case(request[cursor + 2usize],
                    110u8,
                    78u8) {
                        if ascii_equal_ignore_case(request[cursor + 3usize],
                        103u8,
                        71u8) {
                            if ascii_equal_ignore_case(request[cursor + 4usize],
                            101u8,
                            69u8) {
                                if request[cursor + 5usize] == 58u8 {
                                    return true
                                }
                            }
                        }
                    }
                }
            }
        }
        while cursor + 1usize<input_length {
            if request[cursor] == 13u8 {
                if request[cursor + 1usize] == 10u8 {
                    cursor = cursor + 2usize
                    break
                }
            }
            cursor = cursor + 1usize
        }
    }
    return false
}
// Strict, bounded single-range parser. RFC suffix ranges and multipart ranges
// are intentionally unsupported by this small static origin.
fn parse_single_byte_range(input: read Slice<UInt8>, input_length: UIntSize, full_length: UIntSize, scratch: write Slice<UInt8>, output: write Slice<UIntSize>,) -> Bool {
    if full_length == 0usize {
        return false
    }
    if input_length<7usize {
        return false
    }
    if ! ascii_equal_ignore_case(input[0usize],
    98u8,
    66u8) {
        return false
    }
    if ! ascii_equal_ignore_case(input[1usize],
    121u8,
    89u8) {
        return false
    }
    if ! ascii_equal_ignore_case(input[2usize],
    116u8,
    84u8) {
        return false
    }
    if ! ascii_equal_ignore_case(input[3usize],
    101u8,
    69u8) {
        return false
    }
    if ! ascii_equal_ignore_case(input[4usize],
    115u8,
    83u8) {
        return false
    }
    if input[5usize] != 61u8 {
        return false
    }
    var dash: UIntSize = input_length
    var cursor: UIntSize = 6usize
    while cursor<input_length {
        if input[cursor] == 45u8 {
            if dash != input_length {
                return false
            }
            dash = cursor
        }
        cursor = cursor + 1usize
    }
    if dash == input_length {
        return false
    }
    if dash == 6usize {
        return false
    }
    let start_length: UIntSize = dash - 6usize
    if start_length>20usize {
        return false
    }
    cursor = 0usize
    while cursor<start_length {
        scratch[cursor] = input[6usize + cursor]
        cursor = cursor + 1usize
    }
    var parsed:[UInt64;
    1] =[0u64]
    if ! parse_uint(scratch,
    start_length,
    parsed) {
        return false
    }
    let full_length_u64: UInt64 = full_length as UInt64
    if parsed[0usize] >= full_length_u64 {
        return false
    }
    let start: UInt64 = parsed[0usize]
    var end: UInt64 = full_length_u64 - 1u64
    if dash + 1usize<input_length {
        let end_length: UIntSize = input_length - dash - 1usize
        if end_length>20usize {
            return false
        }
        cursor = 0usize
        while cursor<end_length {
            scratch[cursor] = input[dash + 1usize + cursor]
            cursor = cursor + 1usize
        }
        parsed[0usize] = 0u64
        if ! parse_uint(scratch,
        end_length,
        parsed) {
            return false
        }
        if parsed[0usize] < start {
            return false
        }
        end = parsed[0usize]
        if end >= full_length_u64 {
            end = full_length_u64 - 1u64
        }
    }
    output[0usize] = start as UIntSize
    output[1usize] = end as UIntSize
    return true
}
fn server_receive(client: UIntSize, tls: UIntSize, secure: Bool, output: write Slice<UInt8>) -> UIntSize {
    if secure {
        return net_tls_receive(tls,
        output)
    }
    return receive(client,
    output)
}
