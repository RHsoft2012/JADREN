module examples.stdlib_buffer_owning_record_carrier_remove_drop

// Drop-only remove can dispose active Buffer branches inside Option/Result
// fields before compacting the record allocation.  No carrier value escapes
// the operation, so the existing caller-owned field table remains sufficient.
@repr(C)
struct Entry {
    id: Int32,
    maybe: Option<Buffer<Int32>>,
    outcome: Result<Buffer<Int32>, Buffer<Int32>>
}

fn main() -> Int32 {
    let first_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let second_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let third_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let direct_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match first_created {
        Ok(first) => {
            match second_created {
                Ok(second) => {
                    match third_created {
                        Ok(third) => {
                            match direct_created {
                                Ok(direct) => {
                                    if !buffer_append(first, 11) { result_code = 1 }
                                    if !buffer_append(second, 22) { result_code = 2 }
                                    if !buffer_append(third, 33) { result_code = 3 }
                                    let first_entry: Entry = Entry {
                                        id: 1,
                                        maybe: Some(first),
                                        outcome: Ok(second)
                                    }
                                    let second_entry: Entry = Entry {
                                        id: 2,
                                        maybe: None,
                                        outcome: Error(third)
                                    }
                                    if !buffer_append(direct, first_entry) { result_code = 4 }
                                    if !buffer_append(direct, second_entry) { result_code = 5 }
                                    let first_status: Int32 = buffer_remove_drop_status(direct, 0usize)
                                    if first_status != 0 { result_code = 6 }
                                    if buffer_length(direct) != 1usize { result_code = 7 }
                                    if !buffer_remove_drop(direct, 0usize) { result_code = 8 }
                                    if buffer_length(direct) != 0usize { result_code = 9 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    let nested_value_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let nested_error_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    let inner_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    let outer_created: Result<Buffer<Buffer<Entry>>, Int32> = buffer_create(0usize)
    match nested_value_created {
        Ok(value) => {
            match nested_error_created {
                Ok(error) => {
                    match inner_created {
                        Ok(inner) => {
                            match outer_created {
                                Ok(outer) => {
                                    if !buffer_append(value, 44) { result_code = 10 }
                                    if !buffer_append(error, 55) { result_code = 11 }
                                    let nested_entry: Entry = Entry {
                                        id: 3,
                                        maybe: Some(value),
                                        outcome: Error(error)
                                    }
                                    if !buffer_append(inner, nested_entry) { result_code = 12 }
                                    if !buffer_append(outer, inner) { result_code = 13 }
                                    let nested_status: Int32 = buffer_remove_drop_status(outer, 0usize)
                                    if nested_status != 0 { result_code = 14 }
                                    if buffer_length(outer) != 0usize { result_code = 15 }
                                }
                                Error(status) => { result_code = status }
                            }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
