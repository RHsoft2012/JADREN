module examples.http_session_tls_pipelined_client

// Jadren TLS client: both HTTP/1.1 requests are encrypted in one application
// write. Separate receive buffers make the two response frames observable.
fn main() -> Int32 {
    let socket: UIntSize = net_tcp_connect_dns("localhost", 38147u16)
    if (socket as Int32) == 0 { return 10 }
    let tls: UIntSize = net_tls_open_client(socket, "localhost", false)
    if (tls as Int32) == 0 { net_socket_close(socket); return 11 }

    let first: UInt32 = net_tls_step(tls, 2000u32)
    let second: UInt32 = net_tls_step(tls, 2000u32)
    let third: UInt32 = net_tls_step(tls, 2000u32)
    let fourth: UInt32 = net_tls_step(tls, 2000u32)
    let fifth: UInt32 = net_tls_step(tls, 2000u32)
    let sixth: UInt32 = net_tls_step(tls, 2000u32)
    let seventh: UInt32 = net_tls_step(tls, 2000u32)
    let eighth: UInt32 = net_tls_step(tls, 2000u32)
    if first == 3u32 { net_tls_close(tls); return 12 }
    if first == 4u32 { net_tls_close(tls); return 12 }
    if second == 4u32 { net_tls_close(tls); return 12 }
    if third == 4u32 { net_tls_close(tls); return 12 }
    if fourth == 4u32 { net_tls_close(tls); return 12 }
    if fifth == 4u32 { net_tls_close(tls); return 12 }
    if sixth == 4u32 { net_tls_close(tls); return 12 }
    if seventh == 4u32 { net_tls_close(tls); return 12 }
    if eighth == 4u32 { net_tls_close(tls); return 12 }
    if net_tls_state(tls) != 2u32 { net_tls_close(tls); return 12 }

    var request: [UInt8; 123] = [71u8, 69u8, 84u8, 32u8, 47u8, 104u8, 101u8, 108u8, 108u8, 111u8, 32u8, 72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 13u8, 10u8, 72u8, 111u8, 115u8, 116u8, 58u8, 32u8, 108u8, 111u8, 99u8, 97u8, 108u8, 104u8, 111u8, 115u8, 116u8, 13u8, 10u8, 67u8, 111u8, 110u8, 110u8, 101u8, 99u8, 116u8, 105u8, 111u8, 110u8, 58u8, 32u8, 107u8, 101u8, 101u8, 112u8, 45u8, 97u8, 108u8, 105u8, 118u8, 101u8, 13u8, 10u8, 13u8, 10u8, 71u8, 69u8, 84u8, 32u8, 47u8, 104u8, 101u8, 108u8, 108u8, 111u8, 32u8, 72u8, 84u8, 84u8, 80u8, 47u8, 49u8, 46u8, 49u8, 13u8, 10u8, 72u8, 111u8, 115u8, 116u8, 58u8, 32u8, 108u8, 111u8, 99u8, 97u8, 108u8, 104u8, 111u8, 115u8, 116u8, 13u8, 10u8, 67u8, 111u8, 110u8, 110u8, 101u8, 99u8, 116u8, 105u8, 111u8, 110u8, 58u8, 32u8, 99u8, 108u8, 111u8, 115u8, 101u8, 13u8, 10u8, 13u8, 10u8]
    let sent: UIntSize = net_tls_send(tls, request)
    if (sent as Int32) != 123 { net_tls_close(tls); return 13 }

    var response_one: [UInt8; 128] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var response_two: [UInt8; 128] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let received_one: UIntSize = net_tls_receive(tls, response_one)
    let received_two: UIntSize = net_tls_receive(tls, response_two)
    let closed: Bool = net_tls_close(tls)
    if received_one == 0usize { return 14 }
    if received_two == 0usize { return 14 }
    if response_one[0] != 72u8 { return 15 }
    if response_one[11] != 48u8 { return 15 }
    if response_two[0] != 72u8 { return 16 }
    if response_two[11] != 48u8 { return 16 }
    if !closed { return 17 }
    return 0
}
