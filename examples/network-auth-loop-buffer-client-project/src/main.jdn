module network_auth_loop_buffer_client_project.main

import jadren.app.fs.write_text
import jadren.core.process.arg_count
import jadren.core.process.arg_read
import jadren.network.client.request_once_header_exact_buffer

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn run_requests(
    token_first: String,
    token_second: String,
    expected: Int32,
    body: write Buffer<UInt8>,
    request: write Buffer<UInt8>,
    response: write Buffer<UInt8>,
    output: write Buffer<UInt8>,
) -> Int32 {
    if !buffer_resize(body, 1usize) { return 1 }
    if !buffer_resize(request, 256usize) { return 2 }
    if !buffer_resize(response, 192usize) { return 3 }
    if !buffer_resize(output, 64usize) { return 4 }
    var response_length: [UIntSize; 1] = [99usize]
    var output_length: [UIntSize; 1] = [99usize]
    let first: Int32 = request_once_header_exact_buffer(
        "localhost", "localhost", 38163u16, 3000u32,
        "GET", "/status", "Authorization", token_first,
        body, 0usize, request, 256usize, response, 192usize,
        response_length, output, 64usize, output_length,
    )
    if first != expected { return 5 }
    if expected == 200i32 {
        if output_length[0] != 2usize { return 6 }
        if output[0usize] != 79u8 { return 7 }
        if output[1usize] != 75u8 { return 8 }
    }
    let second: Int32 = request_once_header_exact_buffer(
        "localhost", "localhost", 38163u16, 3000u32,
        "GET", "/status", "Authorization", token_second,
        body, 0usize, request, 256usize, response, 192usize,
        response_length, output, 64usize, output_length,
    )
    if second != expected { return 9 }
    if expected == 200i32 {
        if output_length[0] != 2usize { return 10 }
        if output[0usize] != 79u8 { return 11 }
        if output[1usize] != 75u8 { return 12 }
    }
    return 0
}

fn main() -> Int32 {
    var wrong: Bool = false
    if arg_count() == 2usize {
        var flag: [UInt8; 7] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
        let length: UIntSize = arg_read(1usize, flag)
        if length == 7usize {
            if flag[0] == 45u8 {
                if flag[1] == 45u8 {
                    if flag[2] == 119u8 {
                        if flag[3] == 114u8 {
                            if flag[4] == 111u8 {
                                if flag[5] == 110u8 {
                                    if flag[6] == 103u8 { wrong = true }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let token_first: String = if wrong { "Bearer wrong" } else { "Bearer abc123" }
    let token_second: String = if wrong { "Bearer wrong" } else { "Bearer abc123" }
    let expected: Int32 = if wrong { 401i32 } else { 200i32 }
    var status: Int32 = 0
    let body_created: Result<Buffer<UInt8>, Int32> = buffer_create(1usize)
    match body_created {
        Ok(body) => {
            let request_created: Result<Buffer<UInt8>, Int32> = buffer_create(256usize)
            match request_created {
                Ok(request) => {
                    let response_created: Result<Buffer<UInt8>, Int32> = buffer_create(192usize)
                    match response_created {
                        Ok(response) => {
                            let output_created: Result<Buffer<UInt8>, Int32> = buffer_create(64usize)
                            match output_created {
                                Ok(output) => { status = run_requests(token_first, token_second, expected, body, request, response, output) }
                                Error(error) => { status = error }
                            }
                        }
                        Error(error) => { status = error }
                    }
                }
                Error(error) => { status = error }
            }
        }
        Error(error) => { status = error }
    }
    if status != 0 { return status }
    if wrong {
        if write_text(
            "target/jadren/network-auth-loop-buffer-client.result",
            "network-auth-loop-buffer-client:401x2\n",
        ) == 0usize { return 20 }
    } else {
        if write_text(
            "target/jadren/network-auth-loop-buffer-client.result",
            "network-auth-loop-buffer-client:200x2\n",
        ) == 0usize { return 21 }
    }
    return 0
}
