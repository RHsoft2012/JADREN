    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let written: UIntSize = http_response_write_chunked(200u16,
    "text/plain",
    body,
    response)
    if written != 106usize {
        return 1
    }
    if response[0] != 72u8 {
        return 2
    }
    if response[43] != 84u8 {
        return 3
    }
    var decoded:[UInt8;
    4] =[0u8,
    0u8,
    0u8,
    0u8]
    var decoded_length:[UIntSize;
    1] =[99usize]
    if ! http_response_body_chunked_exact(response,
    decoded,
    decoded_length) {
        return 4
    }
    if decoded_length[0] != 4usize {
        return 5
    }
    if decoded[0] != 74u8 {
        return 6
    }
    if decoded[3] != 33u8 {
        return 6
    }
    var empty_body:[UInt8;
    0] =[]
    var empty_response:[UInt8;
    105] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
