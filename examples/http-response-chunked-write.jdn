    77u8,
    77u8,
    77u8,
    77u8]
    if http_response_write_chunked(200u16,
    "text/plain",
    body,
    too_small) != 0usize {
        return 8
    }
    if too_small[0] != 77u8 {
        return 9
    }
    var padded_body:[UInt8;
    8] =[74u8,
    68u8,
    78u8,
    33u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let prefix_written: UIntSize = http_response_write_chunked_prefix(200u16,
    "text/plain",
    padded_body,
    4usize,
    response,
    )
    if prefix_written != 106usize {
        return 10
    }
    if ! http_response_body_chunked_exact(response,
    decoded,
    decoded_length) {
        return 11
    }
    if decoded_length[0] != 4usize {
        return 12
    }
    if http_response_write_chunked_prefix(200u16,
    "text/plain",
    padded_body,
    9usize,
    response,
    ) != 0usize {
        return 13
    }
    if response[0] != 72u8 {
        return 14
    }
    return 0
}
