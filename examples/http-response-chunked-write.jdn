module examples.http_response_chunked_write
// The server-side writer emits one caller-owned data chunk followed by the
// terminal zero chunk. The response is then decoded by the existing exact
// reader so the fixture checks the full wire contract, not only a marker.
fn main() -> Int32 {
    var body:[UInt8;
    4] =[74u8,
    68u8,
    78u8,
    33u8]
    var response:[UInt8;
    106] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
