module examples.app_table_sort

// Typed table ordering keeps numeric columns numeric.  The existing
// app_table_sort_text API is still available for lexical text ordering.
fn main() -> Int32 {
    app_table_clear(0)
    if !app_table_set_column_name(0, 0, "signed") { return 1 }
    if !app_table_set_column_name(0, 1, "unsigned") { return 2 }
    if !app_table_set_column_name(0, 2, "ratio") { return 3 }
    if !app_table_set_column_name(0, 3, "enabled") { return 4 }
    if !app_table_set_column_type(0, 0, 1) { return 5 }
    if !app_table_set_column_type(0, 1, 2) { return 6 }
    if !app_table_set_column_type(0, 2, 4) { return 7 }
    if !app_table_set_column_type(0, 3, 3) { return 8 }

    if !app_table_append_row(0) { return 9 }
    if !app_table_append_row(0) { return 10 }
    if !app_table_append_row(0) { return 11 }

    if !app_table_set_int(0, 0, 0, 12 as Int64) { return 12 }
    if !app_table_set_int(0, 1, 0, -4 as Int64) { return 13 }
    if !app_table_set_int(0, 2, 0, 7 as Int64) { return 14 }
    if !app_table_set_uint(0, 0, 1, 90u64) { return 15 }
    if !app_table_set_uint(0, 1, 1, 3u64) { return 16 }
    if !app_table_set_uint(0, 2, 1, 40u64) { return 17 }
    if !app_table_set_float(0, 0, 2, 2.5f64) { return 18 }
    if !app_table_set_float(0, 1, 2, 1.25f64) { return 19 }
    if !app_table_set_float(0, 2, 2, 3.75f64) { return 20 }
    if !app_table_set_bool(0, 0, 3, true) { return 21 }
    if !app_table_set_bool(0, 1, 3, false) { return 22 }
    if !app_table_set_bool(0, 2, 3, true) { return 23 }

    if !app_table_sort_int(0, 0, false) { return 24 }
    if app_table_read_int(0, 0, 0) != -4 as Int64 { return 25 }
    if app_table_read_int(0, 2, 0) != 12 as Int64 { return 26 }

    if !app_table_sort_uint(0, 1, true) { return 27 }
    if app_table_read_uint(0, 0, 1) != 90u64 { return 28 }
    if app_table_read_uint(0, 2, 1) != 3u64 { return 29 }

    if !app_table_sort_float(0, 2, false) { return 30 }
    if app_table_read_float(0, 0, 2) != 1.25f64 { return 31 }
    if app_table_read_float(0, 2, 2) != 3.75f64 { return 32 }

    if !app_table_sort_bool(0, 3, false) { return 33 }
    if app_table_read_bool(0, 0, 3) { return 34 }
    if !app_table_read_bool(0, 2, 3) { return 35 }

    print("Jadren typed table sort: ready")
    return 0
}
