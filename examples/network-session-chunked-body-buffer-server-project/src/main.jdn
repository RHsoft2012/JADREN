module network_session_chunked_body_buffer_server_project.main

import jadren.network.http.write_response_prefix_ex
import jadren.network.session.accept
import jadren.network.session.close
import jadren.network.session.close_connection
import jadren.network.session.open
import jadren.network.session.receive_request_chunked_body_buffer
import jadren.network.session.send_chunked_body_buffer
import jadren.network.session.send_prefix
import jadren.network.tcp.listen

fn fail(connection: UIntSize, session: UIntSize, code: Int32) -> Int32 {
    if connection != 0usize {
        let closed_connection: Bool = close_connection(connection)
    }
    if session != 0usize {
        let closed_session: Bool = close(session)
    }
    return code
}

fn verify_body(values: read Buffer<UInt8>, first: UInt8, second: UInt8, third: UInt8, fourth: UInt8) -> Bool {
    let body: read Slice<UInt8> = buffer_slice(values, 0usize, 4usize)
    if body[0usize] != first { return false }
    if body[1usize] != second { return false }
    if body[2usize] != third { return false }
    if body[3usize] != fourth { return false }
    return true
}

fn send_ok(connection: UIntSize, response: write Slice<UInt8>, keep_alive: Bool) -> Bool {
    var response_body: [UInt8; 2] = [79u8, 75u8]
    let written: UIntSize = write_response_prefix_ex(
        200u16,
        "text/plain",
        response_body,
        2usize,
        keep_alive,
        response,
    )
    if written == 0usize { return false }
    return send_prefix(connection, response, written)
}

fn main() -> Int32 {
    let listener: UIntSize = listen(38165u16)
    if listener == 0usize { return 1 }
    let session: UIntSize = open(listener, 1u32, 1024u32, 1024u32)
    if session == 0usize { return 2 }
    let connection: UIntSize = accept(session, 5000u32)
    if connection == 0usize {
        close(session)
        return 3
    }

    var response: [UInt8; 128] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var body_length: [UIntSize; 1] = [99usize]
    var status: Int32 = 0
    let request_created: Result<Buffer<UInt8>, Int32> = buffer_create(256usize)
    match request_created {
        Ok(request) => {
            if !buffer_resize(request, 256usize) {
                return fail(connection, session, 4)
            }
            let body_created: Result<Buffer<UInt8>, Int32> = buffer_create(16usize)
            match body_created {
                Ok(body) => {
                    if !buffer_resize(body, 16usize) {
                        return fail(connection, session, 5)
                    }
                    if !receive_request_chunked_body_buffer(
                        connection,
                        5000u32,
                        request,
                        256usize,
                        body,
                        16usize,
                        body_length,
                    ) {
                        return fail(connection, session, 6)
                    }
                    if body_length[0] != 4usize {
                        return fail(connection, session, 7)
                    }
                    if !verify_body(body, 74u8, 68u8, 78u8, 33u8) {
                        return fail(connection, session, 8)
                    }
                    if !send_ok(connection, response, true) {
                        return fail(connection, session, 9)
                    }
                    if !receive_request_chunked_body_buffer(
                        connection,
                        5000u32,
                        request,
                        256usize,
                        body,
                        16usize,
                        body_length,
                    ) {
                        return fail(connection, session, 10)
                    }
                    if body_length[0] != 4usize {
                        return fail(connection, session, 11)
                    }
                    if !verify_body(body, 74u8, 65u8, 68u8, 33u8) {
                        return fail(connection, session, 12)
                    }
                    let response_created: Result<Buffer<UInt8>, Int32> = buffer_create(256usize)
                    match response_created {
                        Ok(response_buffer) => {
                            if !buffer_resize(response_buffer, 256usize) {
                                status = 13
                            } else if !send_chunked_body_buffer(
                                connection,
                                200u16,
                                "text/plain",
                                body,
                                body_length[0],
                                response_buffer,
                                256usize,
                            ) {
                                status = 14
                            }
                        }
                        Error(error) => { status = error }
                    }
                }
                Error(error) => { status = error }
            }
        }
        Error(error) => { status = error }
    }
    if status != 0 { return fail(connection, session, status) }
    if !close_connection(connection) {
        close(session)
        return 14
    }
    if !close(session) { return 15 }
    if file_write_text(
        "target/jadren/network-session-chunked-body-buffer-server.result",
        "session-chunked-body-buffer-server:2 final:JAD! chunked:true response_chunked:true\n",
    ) == 0usize { return 16 }
    return 0
}
