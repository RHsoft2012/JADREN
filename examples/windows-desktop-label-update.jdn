module windows_desktop_label_update.main

// Headless retained-label smoke: the node setter must accept labels and
// statuses, while rejecting a layout node. No message loop is needed for the
// model update path; native backends repaint when a window is already live.
fn main() -> Int32 {
    let root: Int32 = ui_app_begin("Jadren label update", 640, 360, 0xF6F8FCu32)
    if root == 0 { return 1 }
    let panel: Int32 = ui_app_panel(root, 560, 220, 0xFFFFFFu32, 12, 12, 8, 0, 1)
    if panel == 0 { return 2 }
    let label: Int32 = ui_app_label(panel, "Initial label", 480, 34,
                                    0x111827u32, 0xFFFFFFu32, 8, 1)
    let status: Int32 = ui_app_status(panel, "Initial status", 480, 34,
                                      0x111827u32, 0xDCFCE7u32, 8, 1)
    if label == 0 { return 3 }
    if status == 0 { return 3 }
    if !ui_app_label_set_text(label, "Updated label") { return 4 }
    if !ui_app_label_set_text(status, "Updated status") { return 5 }
    if ui_app_label_set_text(panel, "Panel is not a text node") { return 6 }
    if !ui_app_end(panel) { return 7 }
    if !ui_app_end(root) { return 8 }
    return 0
}
