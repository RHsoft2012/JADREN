module examples.nested_while_conditional_continue

fn main() -> Int32 {
    var outer: Int32 = 0
    while outer < 2 {
        outer = outer + 1
        var inner: Int32 = 0
        while inner < 3 {
            inner = inner + 1
            if inner == 2 {
                continue
            }
        }
        outer = outer + inner
    }
    return outer
}
