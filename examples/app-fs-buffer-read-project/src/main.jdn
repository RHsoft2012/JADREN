module app_fs_buffer_read_project.main
import jadren.app.fs.delete
import jadren.app.fs.exists
import jadren.app.fs.read_bytes_exact_buffer
import jadren.app.fs.read_text_exact_buffer
import jadren.app.fs.write_text
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn main() -> Int32 {
    let path: String = "target/app-fs-buffer-read-project.txt"
    delete(path)
    var status: Int32 = 0i32
    if exists(path) {
        status = 1
    }
    let written: UIntSize = write_text(path,
    "JADREN-FS-BUFFER")
    if status == 0 {
        if written != 16usize {
            status = 2
        }
    }
    let output_created: Result<Buffer<UInt8>,
    Int32> = buffer_create(32usize)
    match output_created {
        Error(error) => {
            if status == 0 {
                status = error
            }
        }
        Ok(output) => {
            if ! buffer_resize(output, 32usize) {
                if status == 0 { status = 3 }
            }
            var length:[UIntSize;
            1] =[777usize]
            if status == 0 {
                if ! read_bytes_exact_buffer(path,
                output,
                32usize,
                length) {
                    status = 3
                }
            }
            if status == 0 {
                if length[0] != written {
                    status = 4
                }
            }
            if status == 0 {
                if output[0] != 74u8 {
                    status = 5
                }
            }
            if status == 0 {
                if output[15] != 82u8 {
                    status = 6
                }
            }
            if status == 0 {
                output[0] = 90u8
                length[0] = 778usize
                if ! read_text_exact_buffer(path,
                output,
                32usize,
                length) {
                    status = 7
                }
            }
            if status == 0 {
                if length[0] != written {
                    status = 8
                }
            }
            if status == 0 {
                if output[0] != 74u8 {
                    status = 9
                }
            }
            if status == 0 {
                if output[15] != 82u8 {
                    status = 10
                }
            }
            if status == 0 {
                if output[16] != 0u8 {
                    status = 11
                }
            }
            let short_created: Result<Buffer<UInt8>,
            Int32> = buffer_create(4usize)
            match short_created {
                Error(error) => {
                    if status == 0 {
                        status = error
                    }
                }
                Ok(short) => {
                    if ! buffer_resize(short, 4usize) {
                        if status == 0 { status = 12 }
                    }
                    if status == 0 {
                        short[0] = 91u8
                        short[1] = 92u8
                        short[2] = 93u8
                        short[3] = 94u8
                        length[0] = 779usize
                        if read_bytes_exact_buffer(path,
                        short,
                        4usize,
                        length) {
                            status = 12
                        }
                    }
                    if status == 0 {
                        if short[0] != 91u8 {
                            status = 13
                        }
                    }
                    if status == 0 {
                        if short[1] != 92u8 {
                            status = 14
                        }
                    }
                    if status == 0 {
                        if short[2] != 93u8 {
                            status = 15
                        }
                    }
                    if status == 0 {
                        if short[3] != 94u8 {
                            status = 16
                        }
                    }
                    if status == 0 {
                        if length[0] != 779usize {
                            status = 17
                        }
                    }
                    if status == 0 {
                        length[0] = 781usize
                        if read_bytes_exact_buffer(path,
                        short,
                        5usize,
                        length) {
                            status = 50
                        }
                    }
                    if status == 0 {
                        if short[0] != 91u8 {
                            status = 51
                        }
                    }
                    if status == 0 {
                        if short[3] != 94u8 {
                            status = 51
                        }
                    }
                    if status == 0 {
                        if length[0] != 781usize {
                            status = 52
                        }
                    }
                    if status == 0 {
                        length[0] = 782usize
                        if read_text_exact_buffer(path,
                        short,
                        5usize,
                        length) {
                            status = 53
                        }
                    }
                    if status == 0 {
                        if short[0] != 91u8 {
                            status = 54
                        }
                    }
                    if status == 0 {
                        if length[0] != 782usize {
                            status = 55
                        }
                    }
                }
            }
            if status == 0 {
                length[0] = 780usize
                if read_bytes_exact_buffer("target/app-fs-buffer-read-project-missing.txt",
                output,
                32usize,
                length) {
                    status = 18
                }
            }
            if status == 0 {
                if output[0] != 74u8 {
                    status = 19
                }
            }
            if status == 0 {
                if length[0] != 780usize {
                    status = 20
                }
            }
        }
    }
    if ! delete(path) {
        if status == 0 {
            status = 21
        }
    }
    if exists(path) {
        if status == 0 {
            status = 22
        }
    }
    return status
}
