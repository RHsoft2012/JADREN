fn main() -> Int32 {
    var wrong: Bool = false
    if arg_count() == 2usize {
        var flag: [UInt8; 7] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
        let length: UIntSize = arg_read(1usize, flag)
        if length == 7usize {
            if flag[0] == 45u8 {
                if flag[1] == 45u8 {
                    if flag[2] == 119u8 {
                        if flag[3] == 114u8 {
                            if flag[4] == 111u8 {
                                if flag[5] == 110u8 {
                                    if flag[6] == 103u8 { wrong = true }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    var expected: UInt16 = 200u16
    if wrong {
        expected = 401u16
    }
    let first: UInt16 = if wrong {
        request_status("Bearer wrong")
    } else {
        request_status_exact("Bearer abc123")
    }
    if first != expected { return 1 }
    let second: UInt16 = if wrong {
        request_status("Bearer wrong")
    } else {
        request_status("Bearer abc123")
    }
    if second != expected { return 2 }
    if wrong {
        if write_text(
            "target/jadren/network-auth-loop-client.result",
            "network-auth-loop-client:401x2\\n"
        ) == 0usize { return 3 }
    } else {
        if write_text(
            "target/jadren/network-auth-loop-client.result",
            "network-auth-loop-client:200x2\\n"
        ) == 0usize { return 4 }
    }
    return 0
}
