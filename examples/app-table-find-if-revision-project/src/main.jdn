module app_table_find_if_revision_project.main

import jadren.app.data.revision
import jadren.app.table.append_row
import jadren.app.table.clear
import jadren.app.table.find_bool_if_revision
import jadren.app.table.find_float_if_revision
import jadren.app.table.find_int_if_revision
import jadren.app.table.find_text_if_revision
import jadren.app.table.find_uint_if_revision
import jadren.app.table.set_cell
import jadren.app.table.set_column_type

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    clear(0)
    if ! set_column_type(0, 0, 0) { return 1 }
    if ! set_column_type(0, 1, 1) { return 2 }
    if ! set_column_type(0, 2, 2) { return 3 }
    if ! set_column_type(0, 3, 4) { return 4 }
    if ! set_column_type(0, 4, 3) { return 5 }
    if ! append_row(0) { return 6 }
    if ! append_row(0) { return 7 }
    if ! append_row(0) { return 8 }

    if ! set_cell(0, 0, 0, "Alpha") { return 9 }
    if ! set_cell(0, 1, 0, "Bravo") { return 10 }
    if ! set_cell(0, 2, 0, "Charlie") { return 11 }
    if ! set_cell(0, 0, 1, "10") { return 12 }
    if ! set_cell(0, 1, 1, "20") { return 13 }
    if ! set_cell(0, 2, 1, "30") { return 14 }
    if ! set_cell(0, 0, 2, "100") { return 15 }
    if ! set_cell(0, 1, 2, "200") { return 16 }
    if ! set_cell(0, 2, 2, "300") { return 17 }
    if ! set_cell(0, 0, 3, "1.0") { return 18 }
    if ! set_cell(0, 1, 3, "2.0") { return 19 }
    if ! set_cell(0, 2, 3, "3.0") { return 20 }
    if ! set_cell(0, 0, 4, "false") { return 21 }
    if ! set_cell(0, 1, 4, "true") { return 22 }
    if ! set_cell(0, 2, 4, "false") { return 23 }

    let text_stale: UInt64 = revision()
    if ! set_cell(0, 1, 0, "Changed") { return 24 }
    if find_text_if_revision(0, 0, "Bravo", 1, text_stale) != -1 { return 25 }
    if ! set_cell(0, 1, 0, "Bravo") { return 26 }
    let text_current: UInt64 = revision()
    if find_text_if_revision(0, 0, "Bravo", 1, text_current) != 1 { return 27 }
    if find_text_if_revision(0, 0, "Alpha", 1, text_current) != -1 { return 28 }

    let int_stale: UInt64 = revision()
    if ! set_cell(0, 1, 1, "25") { return 29 }
    if find_int_if_revision(0, 1, 20 as Int64, 1, int_stale) != -1 { return 30 }
    if ! set_cell(0, 1, 1, "20") { return 31 }
    let int_current: UInt64 = revision()
    if find_int_if_revision(0, 1, 20 as Int64, 1, int_current) != 1 { return 32 }

    let uint_stale: UInt64 = revision()
    if ! set_cell(0, 1, 2, "250") { return 33 }
    if find_uint_if_revision(0, 2, 200u64, 1, uint_stale) != -1 { return 34 }
    if ! set_cell(0, 1, 2, "200") { return 35 }
    let uint_current: UInt64 = revision()
    if find_uint_if_revision(0, 2, 200u64, 1, uint_current) != 1 { return 36 }

    let float_stale: UInt64 = revision()
    if ! set_cell(0, 1, 3, "2.5") { return 37 }
    if find_float_if_revision(0, 3, 2.0f64, 1, float_stale) != -1 { return 38 }
    if ! set_cell(0, 1, 3, "2.0") { return 39 }
    let float_current: UInt64 = revision()
    if find_float_if_revision(0, 3, 2.0f64, 1, float_current) != 1 { return 40 }

    let bool_stale: UInt64 = revision()
    if ! set_cell(0, 1, 4, "false") { return 41 }
    if find_bool_if_revision(0, 4, true, 1, bool_stale) != -1 { return 42 }
    if ! set_cell(0, 1, 4, "true") { return 43 }
    let bool_current: UInt64 = revision()
    if find_bool_if_revision(0, 4, true, 1, bool_current) != 1 { return 44 }

    return 0
}
