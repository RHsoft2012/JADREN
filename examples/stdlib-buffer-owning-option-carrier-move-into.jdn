module examples.stdlib_buffer_owning_option_carrier_move_into

// Move an Option carrier into caller-owned output. Some transfers the
// OwnedString descriptor; None has no owning payload to clean.
fn main() -> Int32 {
    let values_created: Result<Buffer<Option<OwnedString>>, Int32> = buffer_create(0usize)
    let first_created: Result<OwnedString, Int32> = string_owned_from("first")
    let second_created: Result<OwnedString, Int32> = string_owned_from("second")
    var result_code: Int32 = 0

    match values_created {
        Ok(values) => {
            match first_created {
                Ok(first) => {
                    let first_item: Option<OwnedString> = Some(first)
                    let output: Option<OwnedString> = None
                    if !buffer_append(values, first_item) { result_code = 1 }
                    if !buffer_remove_move_into(values, 0usize, output) { result_code = 2 }
                    if buffer_length(values) != 0usize { result_code = 3 }
                    let empty_remove_status: Int32 = buffer_remove_move_into_status(values, 0usize, output)
                    if empty_remove_status != -20 { result_code = 4 }

                    match second_created {
                        Ok(second) => {
                            if !buffer_append(values, None) { result_code = 5 }
                            let second_item: Option<OwnedString> = Some(second)
                            if !buffer_append(values, second_item) { result_code = 6 }
                            let popped: Option<OwnedString> = None
                            if !buffer_pop_move_into(values, popped) { result_code = 7 }
                            if buffer_length(values) != 1usize { result_code = 8 }
                            if !buffer_pop_move_into(values, popped) { result_code = 9 }
                            if buffer_length(values) != 0usize { result_code = 10 }
                            let empty_pop_status: Int32 = buffer_pop_move_into_status(values, popped)
                            if empty_pop_status != -20 { result_code = 11 }
                        }
                        Error(status) => { result_code = status }
                    }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    return result_code
}
