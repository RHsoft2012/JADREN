module examples.app_list_page

fn main() -> Int32 {
    app_list_clear(0)
    app_list_clear(1)
    if !app_list_push_text(0, "Alpha") { return 1 }
    if !app_list_push_text(0, "Beta") { return 2 }
    if !app_list_push_text(0, "Gamma") { return 3 }
    if !app_list_push_text(1, "stale") { return 4 }

    // A middle page copies in source order and replaces the destination atomically.
    if !app_list_page(0, 1, 1, 2) { return 5 }
    if app_list_count(1) != 2 { return 6 }
    var output: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if app_list_read_text(1, 0, output) != 4usize { return 7 }
    if output[0] != 66u8 { return 8 }
    if app_list_read_text(1, 1, output) != 5usize { return 9 }
    if output[0] != 71u8 { return 10 }

    // The end position is a valid empty final page.
    if !app_list_page(0, 1, 3, 2) { return 11 }
    if app_list_count(1) != 0 { return 12 }

    // An index beyond the end fails without changing the destination.
    if !app_list_push_text(1, "Keep") { return 13 }
    if app_list_page(0, 1, 4, 1) { return 14 }
    if app_list_count(1) != 1 { return 15 }
    if app_list_read_text(1, 0, output) != 4usize { return 16 }
    if output[0] != 75u8 { return 17 }
    return 0
}
