module examples.app_table_page

fn main() -> Int32 {
    app_table_clear(0)
    app_table_clear(1)
    if !app_table_set_column_type(0, 0, 1) { return 1 }
    if !app_table_append_row(0) { return 2 }
    if !app_table_append_row(0) { return 3 }
    if !app_table_append_row(0) { return 4 }
    if !app_table_set_int(0, 0, 0, 10 as Int64) { return 5 }
    if !app_table_set_int(0, 1, 0, 20 as Int64) { return 6 }
    if !app_table_set_int(0, 2, 0, 30 as Int64) { return 7 }

    // The page keeps the typed schema and source row order.
    if !app_table_page(0, 1, 1, 2) { return 8 }
    if app_table_row_count(1) != 2 { return 9 }
    if app_table_read_int(1, 0, 0) != 20 as Int64 { return 10 }
    if app_table_read_int(1, 1, 0) != 30 as Int64 { return 11 }

    // The end position is a valid empty final page.
    if !app_table_page(0, 1, 3, 2) { return 12 }
    if app_table_row_count(1) != 0 { return 13 }

    // An index beyond the end fails without changing the destination.
    if !app_table_append_row(1) { return 14 }
    if !app_table_set_int(1, 0, 0, 99 as Int64) { return 15 }
    if app_table_page(0, 1, 4, 1) { return 16 }
    if app_table_row_count(1) != 1 { return 17 }
    if app_table_read_int(1, 0, 0) != 99 as Int64 { return 18 }
    return 0
}
