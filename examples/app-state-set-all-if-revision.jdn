module app_state_set_all_if_revision.main
// Every typed state replacement is guarded by the revision observed by the
// caller. A stale write must leave both the value and generation unchanged.
fn main() -> Int32 {
    app_state_clear()

    if ! app_state_set_uint("total",
    10u64) {
        return 1
    }
    let uint_snapshot: UInt64 = app_state_revision()
    if ! app_state_set_uint_if_revision("total",
    25u64,
    uint_snapshot) {
        return 2
    }
    if app_state_get_uint("total") != 25u64 {
        return 3
    }
    let uint_current: UInt64 = app_state_revision()
    if app_state_set_uint_if_revision("total",
    30u64,
    uint_snapshot) {
        return 4
    }
    if app_state_get_uint("total") != 25u64 {
        return 5
    }
    if app_state_revision() != uint_current {
        return 5
    }

    if ! app_state_set_float("rate",
    1.5f64) {
        return 6
    }
    let float_snapshot: UInt64 = app_state_revision()
    if ! app_state_set_float_if_revision("rate",
    2.75f64,
    float_snapshot) {
        return 7
    }
    if app_state_get_float("rate") != 2.75f64 {
        return 8
    }
    let float_current: UInt64 = app_state_revision()
    if app_state_set_float_if_revision("rate",
    3.5f64,
    float_snapshot) {
        return 9
    }
    if app_state_get_float("rate") != 2.75f64 {
        return 10
    }
    if app_state_revision() != float_current {
        return 10
    }

    if ! app_state_set_bool("enabled",
    false) {
        return 11
    }
    let bool_snapshot: UInt64 = app_state_revision()
    if ! app_state_set_bool_if_revision("enabled",
    true,
    bool_snapshot) {
        return 12
    }
    if ! app_state_get_bool("enabled") {
        return 13
    }
    let bool_current: UInt64 = app_state_revision()
    if app_state_set_bool_if_revision("enabled",
    false,
    bool_snapshot) {
        return 14
    }
    if ! app_state_get_bool("enabled") {
        return 15
    }
    if app_state_revision() != bool_current {
        return 15
    }

    if ! app_state_set_text("name",
    "old") {
        return 16
    }
    let text_snapshot: UInt64 = app_state_revision()
    if ! app_state_set_text_if_revision("name",
    "new",
    text_snapshot) {
        return 17
    }
    var text_output: [UInt8; 8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    let text_length: UIntSize = app_state_read_text("name",
    text_output)
    if text_length != 3usize {
        return 18
    }
    if text_output[0] != 110u8 {
        return 18
    }
    if text_output[1] != 101u8 {
        return 18
    }
    if text_output[2] != 119u8 {
        return 18
    }
    let text_current: UInt64 = app_state_revision()
    if app_state_set_text_if_revision("name",
    "stale",
    text_snapshot) {
        return 19
    }
    if app_state_revision() != text_current {
        return 20
    }
    var invalid_output: [UInt8; 8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if app_state_set_text_if_revision("",
    "invalid",
    app_state_revision()) {
        return 21
    }
    if app_state_read_text("name",
    invalid_output) != 3usize {
        return 22
    }
    return 0
}
