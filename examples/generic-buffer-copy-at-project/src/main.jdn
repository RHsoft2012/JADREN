module generic_buffer_copy_at.main
import jadren.core.collections.append
import jadren.core.collections.capacity
import jadren.core.collections.copy_at
import jadren.core.collections.copy_at_status
import jadren.core.collections.create
import jadren.core.collections.length
fn main() -> Int32 {
    var result_code: Int32 = 0
    let integers: Result<Buffer<Int32>,
    Int32> = create(4usize)
    match integers {
        Ok(values) => {
            if ! append(values,
            11) {
                result_code = 1
            }
            if ! append(values,
            22) {
                result_code = 2
            }
            let initial_capacity: UIntSize = capacity(values)
            let output_created: Result<Buffer<Int32>,
            Int32> = create(1usize)
            match output_created {
                Ok(output) => {
                    if ! append(output,
                    - 1) {
                        result_code = 3
                    }
                    if ! copy_at(values,
                    1usize,
                    output) {
                        result_code = 4
                    }
                    if output[0usize] != 22 {
                        result_code = 5
                    }
                    if copy_at(values,
                    9usize,
                    output) {
                        result_code = 6
                    }
                    if output[0usize] != 22 {
                        result_code = 7
                    }
                    if copy_at_status(values,
                    0usize,
                    output) != 0 {
                        result_code = 8
                    }
                    if output[0usize] != 11 {
                        result_code = 9
                    }
                    if copy_at_status(values,
                    9usize,
                    output) != - 20 {
                        result_code = 10
                    }
                    if output[0usize] != 11 {
                        result_code = 11
                    }
                }
                Error(status) => {
                    result_code = status
                }
            }
            if length(values) != 2usize {
                result_code = 12
            }
            if capacity(values) != initial_capacity {
                result_code = 13
            }
        }
        Error(status) => {
            result_code = status
        }
    }
    let bools: Result<Buffer<Bool>,
    Int32> = create(2usize)
    match bools {
        Ok(values) => {
            if ! append(values,
            false) {
                result_code = 14
            }
            if ! append(values,
            true) {
                result_code = 15
            }
            let output_created: Result<Buffer<Bool>,
            Int32> = create(1usize)
            match output_created {
                Ok(output) => {
                    if ! append(output,
                    false) {
                        result_code = 16
                    }
                    if ! copy_at(values,
                    1usize,
                    output) {
                        result_code = 17
                    }
                    if ! output[0usize] {
                        result_code = 18
                    }
                    if copy_at_status(values,
                    7usize,
                    output) != - 20 {
                        result_code = 19
                    }
                    if ! output[0usize] {
                        result_code = 20
                    }
                }
                Error(status) => {
                    result_code = status
                }
            }
        }
        Error(status) => {
            result_code = status
        }
    }
    let source: Result<Buffer<Int32>,
    Int32> = create(1usize)
    match source {
        Ok(values) => {
            if ! append(values,
            7) {
                result_code = 21
            }
            let empty_output: Result<Buffer<Int32>,
            Int32> = create(0usize)
            match empty_output {
                Ok(output) => {
                    if copy_at(values,
                    0usize,
                    output) {
                        result_code = 22
                    }
                    if copy_at_status(values,
                    0usize,
                    output) != - 21 {
                        result_code = 23
                    }
                }
                Error(status) => {
                    result_code = status
                }
            }
        }
        Error(status) => {
            result_code = status
        }
    }
    return result_code
}
