module ui_list_page_project.main
import jadren.app.data.revision
import jadren.app.list.clear
import jadren.app.list.count
import jadren.app.list.find_text
import jadren.app.list.push_text
import jadren.app.ui.begin
import jadren.app.ui.finish
import jadren.app.ui.list
import jadren.app.ui.list_bind
import jadren.app.ui.list_count
import jadren.app.ui.list_page_if_revision
import jadren.app.ui.list_page_if_model_revision
import jadren.app.ui.list_read_item_exact
import jadren.app.ui.panel
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn main() -> Int32 {
    clear(0)
    clear(1)
    if ! push_text(0,
    "Alpha") {
        return 1
    }
    if ! push_text(0,
    "Beta") {
        return 2
    }
    if ! push_text(0,
    "Gamma") {
        return 3
    }
    if ! push_text(0,
    "Delta") {
        return 4
    }
    if ! push_text(1,
    "Sentinel") {
        return 5
    }
    let root: Int32 = begin("Jadren list page",
    720,
    420,
    0xF6F8FCu32)
    if root == 0 {
        return 6
    }
    let panel_node: Int32 = panel(root,
    660,
    300,
    0xFFFFFFu32,
    16,
    12,
    8,
    0,
    1)
    if panel_node == 0 {
        return 7
    }
    let source_node: Int32 = list(panel_node,
    10,
    600,
    110,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    let destination_node: Int32 = list(panel_node,
    11,
    600,
    110,
    0x111827u32,
    0xFFFFFFu32,
    8,
    1)
    if source_node == 0 {
        return 8
    }
    if destination_node == 0 {
        return 8
    }
    if ! list_bind(source_node,
    0) {
        return 9
    }
    if ! list_bind(destination_node,
    1) {
        return 10
    }
    var output:[UInt8;
    32] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
    ]
    var length:[UIntSize;
    1] =[99usize]
    let first_revision: UInt64 = revision()
    if ! list_page_if_model_revision(source_node,
    1,
    1,
    2,
    first_revision) {
        return 11
    }
    if count(1) != 2 {
        return 12
    }
    if list_count(destination_node) != 2 {
        return 13
    }
    if ! list_read_item_exact(destination_node,
    0,
    output,
    length) {
        return 14
    }
    if length[0] != 4usize {
        return 15
    }
    if output[0] != 66u8 {
        return 16
    }
    if ! list_read_item_exact(destination_node,
    1,
    output,
    length) {
        return 17
    }
    if length[0] != 5usize {
        return 18
    }
    if output[0] != 71u8 {
        return 19
    }
    let stale: UInt64 = revision()
    if ! push_text(0,
    "Epsilon") {
        return 20
    }
    if list_page_if_model_revision(source_node,
    1,
    2,
    2,
    stale) {
        return 21
    }
    if count(1) != 2 {
        return 22
    }
    if list_count(destination_node) != 2 {
        return 23
    }
    if find_text(1,
    "Beta",
    0) != 0 {
        return 24
    }
    if find_text(1,
    "Gamma",
    0) != 1 {
        return 25
    }
    let current: UInt64 = revision()
    if ! list_page_if_model_revision(source_node,
    1,
    2,
    2,
    current) {
        return 26
    }
    if count(1) != 2 {
        return 27
    }
    if list_count(destination_node) != 2 {
        return 28
    }
    if ! list_read_item_exact(destination_node,
    0,
    output,
    length) {
        return 29
    }
    if length[0] != 5usize {
        return 30
    }
    if output[0] != 71u8 {
        return 31
    }
    if ! list_read_item_exact(destination_node,
    1,
    output,
    length) {
        return 32
    }
    if length[0] != 5usize {
        return 33
    }
    if output[0] != 68u8 {
        return 34
    }
    let empty_revision: UInt64 = revision()
    if ! list_page_if_model_revision(source_node,
    1,
    5,
    2,
    empty_revision) {
        return 35
    }
    if count(1) != 0 {
        return 36
    }
    if list_count(destination_node) != 0 {
        return 37
    }
    if list_page_if_revision(source_node,
    1,
    - 1,
    2,
    revision()) {
        return 38
    }
    if list_page_if_revision(source_node,
    1,
    0,
    - 1,
    revision()) {
        return 39
    }
    if list_page_if_revision(source_node,
    0,
    0,
    1,
    revision()) {
        return 40
    }
    if list_count(destination_node) != 0 {
        return 41
    }
    if ! finish(panel_node) {
        return 42
    }
    if ! finish(root) {
        return 43
    }
    return 0
}
