module examples.stdlib_buffer_record_resize_clear_move

// Direct Buffer<Entry> growth/clear uses the same field-table contract as
// nested record buffers, but does not need an intermediate Buffer descriptor.
@repr(C)
struct Entry {
    id: Int32,
    values: Buffer<Int32>
}

fn main() -> Int32 {
    let records_created: Result<Buffer<Entry>, Int32> = buffer_create(0usize)
    let values_created: Result<Buffer<Int32>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match records_created {
        Ok(records) => {
            match values_created {
                Ok(values) => {
                    if !buffer_append(values, 17) { result_code = 1 }
                    let item: Entry = Entry { id: 7, values: values }
                    if !buffer_append(records, item) { result_code = 2 }

                    let grown: Int32 = buffer_resize_move_status(records, 2usize)
                    if grown != 0 { result_code = 3 }
                    if buffer_length(records) != 2usize { result_code = 4 }

                    let cleared: Bool = buffer_clear_move(records)
                    if !cleared { result_code = 5 }
                    if buffer_length(records) != 0usize { result_code = 6 }

                    // Reuse the allocation through the status form after the
                    // first record's owning field has been destroyed.
                    let cleared_again: Int32 = buffer_clear_move_status(records)
                    if cleared_again != 0 { result_code = 7 }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }

    return result_code
}
