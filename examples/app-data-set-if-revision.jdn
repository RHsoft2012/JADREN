module app_data_set_if_revision.main

// Equality-only guarded text updates for the bounded dynamic list and table
// model. A stale snapshot must not overwrite a newer value; a current snapshot
// updates exactly one item or cell.
fn main() -> Int32 {
    app_list_clear(0)
    app_table_clear(0)
    app_table_clear(1)
    if ! app_list_push_text(0, "first") { return 1 }
    if ! app_list_push_text(0, "second") { return 2 }
    if ! app_table_append_row(0) { return 3 }
    if ! app_table_append_row(0) { return 4 }
    if ! app_table_set_cell(0, 0, 0, "row-a") { return 5 }
    if ! app_table_set_cell(0, 1, 0, "row-b") { return 6 }

    let stale: UInt64 = app_data_revision()
    if ! app_list_set_text(0, 0, "newer") { return 7 }
    if app_list_set_text_if_revision(0, 0, "stale", stale) { return 8 }
    if app_table_set_cell_if_revision(0, 0, 0, "stale", stale) { return 9 }
    var output: [UInt8; 16] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    if app_list_read_text(0, 0, output) != 5usize { return 10 }
    if output[0] != 110u8 { return 11 }
    if output[4] != 114u8 { return 12 }
    if app_table_read_cell(0, 0, 0, output) != 5usize { return 13 }
    if output[0] != 114u8 { return 14 }
    if output[4] != 97u8 { return 15 }

    let current_list: UInt64 = app_data_revision()
    if ! app_list_set_text_if_revision(0, 0, "updated", current_list) { return 16 }
    if app_list_read_text(0, 0, output) != 7usize { return 17 }
    if output[0] != 117u8 { return 18 }
    if output[6] != 100u8 { return 19 }

    let current_table: UInt64 = app_data_revision()
    if ! app_table_set_cell_if_revision(0, 0, 0, "changed", current_table) { return 20 }
    if app_table_read_cell(0, 0, 0, output) != 7usize { return 21 }
    if output[0] != 99u8 { return 22 }
    if output[6] != 100u8 { return 23 }

    // Caller-owned byte prefixes use the same equality-only guard. A stale
    // snapshot and a length beyond the source slice must not mutate either
    // retained collection.
    var bytes: [UInt8; 8] = [98u8, 121u8, 116u8, 101u8, 115u8, 0u8, 0u8, 0u8]
    let stale_list_bytes: UInt64 = app_data_revision()
    if ! app_list_set_text(0, 0, "fresh") { return 24 }
    if app_list_set_text_bytes_if_revision(0, 0, bytes, 5usize, stale_list_bytes) { return 25 }
    if app_list_read_text(0, 0, output) != 5usize { return 26 }
    if output[0] != 102u8 { return 27 }
    if output[4] != 104u8 { return 28 }
    let current_list_bytes: UInt64 = app_data_revision()
    if ! app_list_set_text_bytes_if_revision(0, 0, bytes, 5usize, current_list_bytes) { return 29 }
    if app_list_read_text(0, 0, output) != 5usize { return 30 }
    if output[0] != 98u8 { return 31 }
    if output[4] != 115u8 { return 32 }
    let short_list_bytes: UInt64 = app_data_revision()
    if app_list_set_text_bytes_if_revision(0, 0, bytes, 9usize, short_list_bytes) { return 33 }
    if app_list_read_text(0, 0, output) != 5usize { return 34 }
    if output[0] != 98u8 { return 35 }

    let stale_table_bytes: UInt64 = app_data_revision()
    if ! app_table_set_cell(0, 0, 0, "fresh-table") { return 36 }
    if app_table_set_cell_bytes_if_revision(0, 0, 0, bytes, 5usize, stale_table_bytes) { return 37 }
    if app_table_read_cell(0, 0, 0, output) != 11usize { return 38 }
    if output[0] != 102u8 { return 39 }
    if output[10] != 101u8 { return 40 }
    let current_table_bytes: UInt64 = app_data_revision()
    if ! app_table_set_cell_bytes_if_revision(0, 0, 0, bytes, 5usize, current_table_bytes) { return 41 }
    if app_table_read_cell(0, 0, 0, output) != 5usize { return 42 }
    if output[0] != 98u8 { return 43 }
    if output[4] != 115u8 { return 44 }
    let short_table_bytes: UInt64 = app_data_revision()
    if app_table_set_cell_bytes_if_revision(0, 0, 0, bytes, 9usize, short_table_bytes) { return 45 }
    if app_table_read_cell(0, 0, 0, output) != 5usize { return 46 }
    if output[0] != 98u8 { return 47 }

    let invalid_revision: UInt64 = app_data_revision()
    if app_list_set_text_if_revision(0, 99, "invalid", invalid_revision) { return 48 }
    if app_table_set_cell_if_revision(0, 99, 0, "invalid", invalid_revision) { return 49 }
    if app_list_count(0) != 2 { return 50 }
    if app_table_row_count(0) != 2 { return 51 }

    if ! app_table_set_column_type(1, 0, 1) { return 52 }
    if ! app_table_append_row(1) { return 53 }
    if ! app_table_set_int(1, 0, 0, 42 as Int64) { return 54 }
    let typed_revision: UInt64 = app_data_revision()
    if app_table_set_cell_if_revision(1, 0, 0, "not-an-int", typed_revision) { return 55 }
    if app_table_read_int(1, 0, 0) != 42 as Int64 { return 56 }
    var invalid_bytes: [UInt8; 11] = [110u8, 111u8, 116u8, 45u8, 97u8, 110u8, 45u8, 105u8, 110u8, 116u8, 0u8]
    let typed_bytes_revision: UInt64 = app_data_revision()
    if app_table_set_cell_bytes_if_revision(1, 0, 0, invalid_bytes, 10usize, typed_bytes_revision) { return 57 }
    if app_table_read_int(1, 0, 0) != 42 as Int64 { return 58 }
    return 0
}
