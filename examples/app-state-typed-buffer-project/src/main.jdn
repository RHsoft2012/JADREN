fn check_bool() -> Int32 {
    let created: Result<Buffer<Bool>,
    Int32> = buffer_create(1usize)
    var status: Int32 = 0
    match created {
        Error(error) => {
            status = error
        }
        Ok(output) => {
            if ! buffer_resize(output,
            1usize) {
                status = 31
            }
            if status == 0 {
                output[0] = false
            }
            if status == 0 {
                if ! read_bool_buffer("enabled",
                output,
                1usize) {
                    status = 31
                }
            }
            if status == 0 {
                if ! output[0] {
                    status = 32
                }
            }
            if status == 0 {
                output[0] = false
            }
            if status == 0 {
                if read_bool_buffer("missing",
                output,
                1usize) {
                    status = 33
                }
            }
            if status == 0 {
                if output[0] {
                    status = 34
                }
            }
            if status == 0 {
                if read_bool_buffer("signed",
                output,
                1usize) {
                    status = 35
                }
            }
            if status == 0 {
                if output[0] {
                    status = 36
                }
            }
            if status == 0 {
                output[0] = true
            }
            if status == 0 {
                if read_bool_buffer("enabled",
                output,
                0usize) {
                    status = 37
                }
            }
            if status == 0 {
                if ! output[0] {
                    status = 38
                }
            }
            if status == 0 {
                output[0] = false
            }
            if status == 0 {
                if read_bool_buffer("enabled",
                output,
                2usize) {
                    status = 39
                }
            }
            if status == 0 {
                if output[0] {
                    status = 40
                }
            }
        }
    }
    return status
}
fn main() -> Int32 {
    clear()
    if ! set_int("signed",
    - 42i64) {
        return 1
    }
    if ! set_uint("unsigned",
    42u64) {
        return 2
    }
    if ! set_float("ratio",
    1.25f64) {
        return 3
    }
    if ! set_bool("enabled",
    true) {
        return 4
    }
    var status: Int32 = check_int()
    if status == 0 {
        status = check_uint()
    }
    if status == 0 {
        status = check_float()
    }
    if status == 0 {
        status = check_bool()
    }
    clear()
    return status
}
