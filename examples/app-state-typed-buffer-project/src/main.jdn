module app_state_typed_buffer_project.main
import jadren.app.state.clear
import jadren.app.state.read_bool_buffer
import jadren.app.state.read_float_buffer
import jadren.app.state.read_int_buffer
import jadren.app.state.read_uint_buffer
import jadren.app.state.set_bool
import jadren.app.state.set_float
import jadren.app.state.set_int
import jadren.app.state.set_uint
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn check_int() -> Int32 {
    let created: Result<Buffer<Int64>,
    Int32> = buffer_create(1usize)
    var status: Int32 = 0
    match created {
        Error(error) => {
            status = error
        }
        Ok(output) => {
            if ! buffer_resize(output,
            1usize) {
                status = 1
            }
            if status == 0 {
                output[0] = - 11i64
            }
            if status == 0 {
                if ! read_int_buffer("signed",
                output,
                1usize) {
                    status = 1
                }
            }
            if status == 0 {
                if output[0] != - 42i64 {
                    status = 2
                }
            }
            if status == 0 {
                output[0] = 91i64
            }
            if status == 0 {
                if read_int_buffer("missing",
                output,
                1usize) {
                    status = 3
                }
            }
            if status == 0 {
                if output[0] != 91i64 {
                    status = 4
                }
            }
            if status == 0 {
                if read_int_buffer("unsigned",
                output,
                1usize) {
                    status = 5
                }
            }
            if status == 0 {
                if output[0] != 91i64 {
                    status = 6
                }
            }
            if status == 0 {
                output[0] = 92i64
            }
            if status == 0 {
                if read_int_buffer("signed",
                output,
                0usize) {
                    status = 7
                }
            }
            if status == 0 {
                if output[0] != 92i64 {
                    status = 8
                }
            }
            if status == 0 {
                output[0] = 93i64
            }
            if status == 0 {
                if read_int_buffer("signed",
                output,
                2usize) {
                    status = 9
                }
            }
            if status == 0 {
                if output[0] != 93i64 {
                    status = 10
                }
            }
        }
    }
    return status
}
