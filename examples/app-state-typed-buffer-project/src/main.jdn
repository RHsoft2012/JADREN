fn check_float() -> Int32 {
    let created: Result<Buffer<Float64>,
    Int32> = buffer_create(1usize)
    var status: Int32 = 0
    match created {
        Error(error) => {
            status = error
        }
        Ok(output) => {
            if ! buffer_resize(output,
            1usize) {
                status = 21
            }
            if status == 0 {
                output[0] = 0.0f64
            }
            if status == 0 {
                if ! read_float_buffer("ratio",
                output,
                1usize) {
                    status = 21
                }
            }
            if status == 0 {
                if output[0] != 1.25f64 {
                    status = 22
                }
            }
            if status == 0 {
                output[0] = 9.5f64
            }
            if status == 0 {
                if read_float_buffer("missing",
                output,
