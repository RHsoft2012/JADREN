/// Demonstrates the source-level transform value objects. The exported C ABI
/// remains the same 52-byte scene record as the low-level helpers.
@export(name: "jadren_unity_api_emit_declarative_scene", abi: "C")
@noalloc
pub fn emit_declarative_scene(
    output: write Slice<UnityCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    if capacity < 2usize { return 0usize }
    let spawn_transform: UnityTransform = unity_transform(
        1.0f32, 2.0f32, 3.0f32,
        0.0f32, 0.0f32, 0.0f32, 1.0f32,
        1.0f32, 1.0f32, 1.0f32,
    )
    if !unity_scene_spawn_with_transform(
        output, capacity, 0usize, 501u32, 7u32, spawn_transform) {
        return 0usize
    }
    let moved: UnityTransform = unity_transform_identity()
    if !unity_scene_set_transform_value(output, capacity, 1usize, 501u32, moved) {
        return 0usize
    }
    return 2usize
}

/// Demonstrates a typed UI color value lowered to the existing UI record.
@export(name: "jadren_unity_api_emit_declarative_ui", abi: "C")
@noalloc
pub fn emit_declarative_ui(
    output: write Slice<UnityUiCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    if capacity < 2usize { return 0usize }
    let accent: UnityColor = unity_color(0.1f32, 0.6f32, 1.0f32, 1.0f32)
    if !unity_ui_set_color_value(output, capacity, 0usize, 301u32, accent) {
        return 0usize
    }
    let white: UnityColor = unity_color_white()
    if !unity_ui_set_color_value(output, capacity, 1usize, 302u32, white) {
        return 0usize
    }
    return 2usize
}

/// Demonstrates one declarative scene node lowered to three bounded records:
/// spawn, parent and inactive state.
@export(name: "jadren_unity_api_emit_declarative_node", abi: "C")
@noalloc
pub fn emit_declarative_node(
    output: write Slice<UnityCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    let transform: UnityTransform = unity_transform_identity()
    let node: UnitySceneNode = unity_scene_node(
        601u32, 8u32, 600u32, transform, false,
    )
    return unity_scene_emit_node(output, capacity, 0usize, node)
}

/// Demonstrates one declarative UI style lowered to color, active and
/// interactable records for one registered target.
@export(name: "jadren_unity_api_emit_declarative_style", abi: "C")
@noalloc
pub fn emit_declarative_style(
    output: write Slice<UnityUiCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    let color: UnityColor = unity_color(0.2f32, 0.4f32, 0.8f32, 1.0f32)
    let style: UnityUiStyle = unity_ui_style(303u32, color, false, false)
    return unity_ui_apply_style(output, capacity, 0usize, style)
}

/// Demonstrates a typed target/text range lowered to the existing text record
/// and caller-owned UTF-8 pool.
@export(name: "jadren_unity_api_emit_declarative_text", abi: "C")
pub fn emit_declarative_text(
    output: write Slice<UnityUiTextCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 1usize {
        return 0usize
    }
    if text_capacity < 9usize {
        return 0usize
    }
    text_output[0] = 74u8
    text_output[1] = 97u8
    text_output[2] = 100u8
    text_output[3] = 114u8
    text_output[4] = 101u8
    text_output[5] = 110u8
    text_output[6] = 32u8
    text_output[7] = 85u8
    text_output[8] = 73u8
    // The public constructors are available to application code; the export
    // keeps the smoke path explicitly noalloc by constructing the same value
    // objects inline before lowering the typed range.
    let text: UnityTextRange = UnityTextRange { offset: 0u32, length: 9u32 }
    let value: UnityUiTextValue = UnityUiTextValue {
        target_id: 304u32, text_offset: text.offset, text_length: text.length,
    }
    if !unity_ui_write_text_value(
        output, text_output, command_capacity, text_capacity, 0usize, value,
    ) {
        return 0usize
    }
    return 1usize
}

/// Demonstrates a typed list item lowered to one bounded list record.
@export(name: "jadren_unity_api_emit_declarative_list_item", abi: "C")
pub fn emit_declarative_list_item(
    output: write Slice<UnityUiListCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 1usize {
        return 0usize
    }
    if text_capacity < 4usize {
        return 0usize
    }
    text_output[0] = 66u8
    text_output[1] = 101u8
    text_output[2] = 116u8
    text_output[3] = 97u8
    let text: UnityTextRange = unity_text_range(0u32, 4u32)
    let item: UnityUiListItemValue = unity_ui_list_item_value(77u32, 102u32, 1u32, text)
    if !unity_ui_write_list_item_value(
        output, text_output, command_capacity, text_capacity, 0usize, item,
    ) {
        return 0usize
    }
    return 1usize
}

/// Demonstrates a typed table cell lowered to one bounded table record.
@export(name: "jadren_unity_api_emit_declarative_table_cell", abi: "C")
pub fn emit_declarative_table_cell(
    output: write Slice<UnityUiTableCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 1usize {
        return 0usize
    }
    if text_capacity < 2usize {
        return 0usize
    }
    text_output[0] = 52u8
    text_output[1] = 50u8
    let text: UnityTextRange = unity_text_range(0u32, 2u32)
    let cell: UnityUiTableCellValue = unity_ui_table_cell_value(
        88u32, 1001u32, 11u32, 1u32, 1u32, text,
    )
    if !unity_ui_write_table_cell_value(
        output, text_output, command_capacity, text_capacity, 0usize, cell,
    ) {
        return 0usize
    }
    return 1usize
}

/// Demonstrates the natural Jadren Editor plan stream. The command buffer is
/// bounded and the prefab path is kept in a separate caller-owned UTF-8 pool;
/// Unity validates the path/handles and applies the plan only through the
/// explicit Editor tooling/Undo boundary.
@export(name: "jadren_unity_api_emit_editor_plan", abi: "C")
pub fn emit_editor_plan(
    output: write Slice<UnityEditorPlanCommandRecord>,
    asset_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    asset_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 18usize {
        return 0usize
    }
    if asset_capacity < 85usize {
        return 0usize
    }
    // The path remains caller-owned; the host checks it is a project-relative
    // prefab before loading it. The bounded copy helper keeps the freestanding
    // Unity DLL free of a hidden string runtime dependency.
    let asset_input: [UInt8; 27] = [
        65u8, 115u8, 115u8, 101u8, 116u8, 115u8, 47u8,
        80u8, 114u8, 101u8, 102u8, 97u8, 98u8, 115u8, 47u8,
        80u8, 97u8, 110u8, 101u8, 108u8, 46u8, 112u8, 114u8,
        101u8, 102u8, 97u8, 98u8,
    ]
    let asset_length: UIntSize = unity_editor_plan_copy_asset_path(
        asset_input, 27usize, asset_output, asset_capacity,
    )
    if asset_length == 0usize {
        return 0usize
    }

    let create_transform: UnityTransform = unity_transform_identity()
    if !unity_editor_plan_create_primitive(
        output, command_capacity, 0usize, 900u32, 3u32, 0u32,
        create_transform, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_add_component(
        output, command_capacity, 1usize, 900u32, 1u32,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_component_float(
        output, command_capacity, 2usize, 900u32, 1u32, 1u32, 3.5f32,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_component_bool(
        output, command_capacity, 3usize, 900u32, 1u32, 1u32, false,
    ) {
        return 0usize
    }
    let moved_transform: UnityTransform = unity_transform(
        0.0f32, 1.0f32, 0.0f32,
        0.0f32, 0.0f32, 0.0f32, 1.0f32,
        1.0f32, 1.0f32, 1.0f32,
    )
    if !unity_editor_plan_set_transform(
        output, command_capacity, 4usize, 900u32, moved_transform,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_active(
        output, command_capacity, 5usize, 900u32, false,
    ) {
        return 0usize
    }
    let prefab_transform: UnityTransform = unity_transform_identity()
    if !unity_editor_plan_instantiate_prefab(
        output, command_capacity, 6usize, 901u32, 0u32, 0u32,
        asset_length as UInt32, prefab_transform, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_parent(
        output, command_capacity, 7usize, 901u32, 900u32,
    ) {
        return 0usize
    }
    let title_input: [UInt8; 12] = [
        65u8, 73u8, 32u8, 65u8, 115u8, 115u8, 105u8,
        115u8, 116u8, 101u8, 110u8, 116u8,
    ]
    let button_input: [UInt8; 6] = [83u8, 112u8, 117u8, 115u8, 116u8, 105u8]
    let title_length: UIntSize = unity_editor_plan_copy_text_at(
        title_input, 12usize, asset_output, asset_capacity, 27usize,
    )
    let button_length: UIntSize = unity_editor_plan_copy_text_at(
        button_input, 6usize, asset_output, asset_capacity, 39usize,
    )
    if title_length == 0usize {
        return 0usize
    }
    if button_length == 0usize {
        return 0usize
    }
    if !unity_editor_plan_create_ui_canvas(
        output, command_capacity, 8usize, 910u32, 0u32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_event_router(
        output, command_capacity, 9usize, 914u32, 910u32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_panel(
        output, command_capacity, 10usize, 911u32, 910u32,
        0.0f32, 0.0f32, 800.0f32, 500.0f32,
        0.08f32, 0.10f32, 0.15f32, 1.0f32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_text(
        output, command_capacity, 11usize, 912u32, 911u32,
        27u32, title_length as UInt32, 28u32,
        0.0f32, 120.0f32, 700.0f32, 80.0f32,
        1.0f32, 1.0f32, 1.0f32, 1.0f32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_button(
        output, command_capacity, 12usize, 913u32, 911u32,
        39u32, button_length as UInt32, 20u32,
        0.0f32, -80.0f32, 240.0f32, 60.0f32,
        0.10f32, 0.55f32, 0.95f32, 1.0f32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_ui_color(
        output, command_capacity, 13usize, 913u32,
        0.10f32, 0.75f32, 0.40f32, 1.0f32,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_ui_interactable(
        output, command_capacity, 14usize, 913u32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_set_ui_text(
        output, command_capacity, 15usize, 912u32,
        27u32, title_length as UInt32,
    ) {
        return 0usize
    }
    if !unity_editor_plan_attach_ui_event_source(
        output, command_capacity, 16usize, 913u32, 914u32,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_toggle(
        output, command_capacity, 17usize, 915u32, 911u32,
        39u32, button_length as UInt32, 18u32,
        280.0f32, -80.0f32, 240.0f32, 60.0f32,
        0.10f32, 0.75f32, 0.40f32, 1.0f32, true, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_slider(
        output, command_capacity, 18usize, 916u32, 911u32, 0.35f32,
        0.0f32, -150.0f32, 240.0f32, 24.0f32,
        0.10f32, 0.55f32, 0.95f32, 1.0f32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_create_ui_input_field(
        output, command_capacity, 19usize, 917u32, 911u32,
        39u32, button_length as UInt32, 16u32,
        280.0f32, -150.0f32, 240.0f32, 48.0f32,
        1.0f32, 1.0f32, 1.0f32, 1.0f32, true,
    ) {
        return 0usize
    }
    if !unity_editor_plan_attach_ui_text_event_source(
        output, command_capacity, 20usize, 917u32, 914u32,
    ) {
        return 0usize
    }
    let saved_prefab_path: [UInt8; 40] = [
        65u8, 115u8, 115u8, 101u8, 116u8, 115u8, 47u8,
        74u8, 97u8, 100u8, 114u8, 101u8, 110u8, 71u8, 101u8,
        110u8, 101u8, 114u8, 97u8, 116u8, 101u8, 100u8, 47u8,
        78u8, 97u8, 116u8, 105u8, 118u8, 101u8, 80u8, 108u8,
        97u8, 110u8, 46u8, 112u8, 114u8, 101u8, 102u8, 97u8,
        98u8,
    ]
    if unity_editor_plan_copy_text_at(
        saved_prefab_path, 40usize, asset_output, asset_capacity, 45usize,
    ) != 40usize {
        return 0usize
    }
    if !unity_editor_plan_save_prefab_asset(
        output, command_capacity, 21usize, 900u32, 45u32, 40u32,
    ) {
        return 0usize
    }
    return 22usize
}

fn main() -> Int32 {
    return 0
}
