@export(name: "jadren_unity_api_emit_scene", abi: "C")
@noalloc
pub fn emit_scene(output: write Slice<UnityCommandRecord>, capacity: UIntSize) -> UIntSize {
    if capacity < 4usize {
        return 0usize
    }
    if !unity_scene_spawn(output, capacity, 0usize, 42u32, 7u32,
                          1.0f32, 2.0f32, 3.0f32,
                          0.0f32, 0.0f32, 0.0f32, 1.0f32,
                          1.0f32, 1.0f32, 1.0f32) {
        return 0usize
    }
    if !unity_scene_transform(output, capacity, 1usize, 42u32,
                              4.0f32, 5.0f32, 6.0f32,
                              0.0f32, 0.0f32, 0.0f32, 1.0f32,
                              2.0f32, 2.0f32, 2.0f32) {
        return 0usize
    }
    if !unity_scene_set_active(output, capacity, 2usize, 42u32, false) {
        return 0usize
    }
    if !unity_scene_destroy(output, capacity, 3usize, 42u32) {
        return 0usize
    }
    return 4usize
}

@export(name: "jadren_unity_api_emit_parenting", abi: "C")
@noalloc
pub fn emit_parenting(output: write Slice<UnityCommandRecord>, capacity: UIntSize) -> UIntSize {
    if capacity < 3usize {
        return 0usize
    }
    if !unity_scene_spawn(output, capacity, 0usize, 100u32, 7u32,
                          0.0f32, 0.0f32, 0.0f32,
                          0.0f32, 0.0f32, 0.0f32, 1.0f32,
                          1.0f32, 1.0f32, 1.0f32) {
        return 0usize
    }
    if !unity_scene_spawn(output, capacity, 1usize, 101u32, 7u32,
                          1.0f32, 0.0f32, 0.0f32,
                          0.0f32, 0.0f32, 0.0f32, 1.0f32,
                          1.0f32, 1.0f32, 1.0f32) {
        return 0usize
    }
    if !unity_scene_set_parent(output, capacity, 2usize, 101u32, 100u32) {
        return 0usize
    }
    return 3usize
}

@export(name: "jadren_unity_api_emit_primitive", abi: "C")
@noalloc
pub fn emit_primitive(output: write Slice<UnityCommandRecord>, capacity: UIntSize) -> UIntSize {
    if capacity < 1usize {
        return 0usize
    }
    // Primitive id 3 is Unity's Cube. The entity handle stays explicit and
    // is owned by the Unity host just like a prefab-spawned entity.
    if !unity_scene_create_primitive(
        output,
        capacity,
        0usize,
        99u32,
        3u32,
        0.0f32,
        0.0f32,
        0.0f32,
        0.0f32,
        0.0f32,
        0.0f32,
        1.0f32,
        1.0f32,
        1.0f32,
        1.0f32,
    ) {
        return 0usize
    }
    return 1usize
}

@export(name: "jadren_unity_api_emit_component", abi: "C")
@noalloc
pub fn emit_component(output: write Slice<UnityCommandRecord>, capacity: UIntSize) -> UIntSize {
    if capacity < 1usize {
        return 0usize
    }
    // Component id 12 is resolved by the Unity host smoke to Rigidbody.
    if !unity_scene_add_component(output, capacity, 0usize, 99u32, 12u32) {
        return 0usize
    }
    return 1usize
}

@export(name: "jadren_unity_api_emit_component_float", abi: "C")
@noalloc
pub fn emit_component_float(
    output: write Slice<UnityComponentFloatCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    if capacity < 1usize {
        return 0usize
    }
    // Component 12 is Rigidbody; property 1 is its mass in the Unity host.
    if !unity_component_set_float(
        output,
        capacity,
        0usize,
        99u32,
        12u32,
        1u32,
        3.5f32,
    ) {
        return 0usize
    }
    return 1usize
}

@export(name: "jadren_unity_api_emit_component_bool", abi: "C")
@noalloc
pub fn emit_component_bool(
    output: write Slice<UnityComponentBoolCommandRecord>,
    capacity: UIntSize,
) -> UIntSize {
    if capacity < 1usize {
        return 0usize
    }
    // Component 12 is Rigidbody; property 2 is useGravity in the Unity host.
    if !unity_component_set_bool(
        output,
        capacity,
        0usize,
        99u32,
        12u32,
        2u32,
        false,
    ) {
        return 0usize
    }
    return 1usize
}

@export(name: "jadren_unity_api_emit_renderer_color", abi: "C")
