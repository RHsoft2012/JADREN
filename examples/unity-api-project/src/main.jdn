@export(name: "jadren_unity_api_emit_ui", abi: "C")
@noalloc
pub fn emit_ui(output: write Slice<UnityUiCommandRecord>, capacity: UIntSize) -> UIntSize {
    if capacity < 3usize {
        return 0usize
    }
    if !unity_ui_set_color(output, capacity, 0usize, 21u32,
                           0.1f32, 0.6f32, 1.0f32, 1.0f32) {
        return 0usize
    }
    if !unity_ui_set_active(output, capacity, 1usize, 21u32, false) {
        return 0usize
    }
    if !unity_ui_set_interactable(output, capacity, 2usize, 21u32, false) {
        return 0usize
    }
    return 3usize
}

@export(name: "jadren_unity_api_emit_ui_text", abi: "C")
@noalloc
pub fn emit_ui_text(
    output: write Slice<UnityUiTextCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 1usize {
        return 0usize
    }
    if text_capacity < 9usize {
        return 0usize
    }

    // UTF-8 bytes for "Jadren UI". The caller-owned pool remains separate
    // from the fixed 32-byte command records.
    text_output[0] = 74u8
    text_output[1] = 97u8
    text_output[2] = 100u8
    text_output[3] = 114u8
    text_output[4] = 101u8
    text_output[5] = 110u8
    text_output[6] = 32u8
    text_output[7] = 85u8
    text_output[8] = 73u8

    if !unity_ui_set_text(
        output,
        text_output,
        command_capacity,
        text_capacity,
        0usize,
        21u32,
        0u32,
        9u32,
    ) {
        return 0usize
    }
    return 1usize
}

@export(name: "jadren_unity_api_emit_ui_list", abi: "C")
@noalloc
pub fn emit_ui_list(
    output: write Slice<UnityUiListCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 4usize {
        return 0usize
    }
    if text_capacity < 14usize {
        return 0usize
    }

    // Caller-owned UTF-8 bytes for three rows: Alpha, Beta, Gamma.
    text_output[0] = 65u8
    text_output[1] = 108u8
    text_output[2] = 112u8
    text_output[3] = 104u8
    text_output[4] = 97u8
    text_output[5] = 66u8
    text_output[6] = 101u8
    text_output[7] = 116u8
    text_output[8] = 97u8
    text_output[9] = 71u8
    text_output[10] = 97u8
    text_output[11] = 109u8
    text_output[12] = 109u8
    text_output[13] = 97u8

    if !unity_ui_list_clear(output, command_capacity, 0usize, 77u32) {
        return 0usize
    }
    if !unity_ui_list_set_item(
        output,
        text_output,
        command_capacity,
        text_capacity,
        1usize,
        77u32,
        101u32,
        0u32,
        0u32,
        5u32,
    ) {
        return 0usize
    }
    if !unity_ui_list_set_item(
        output,
        text_output,
        command_capacity,
        text_capacity,
        2usize,
        77u32,
        102u32,
        1u32,
        5u32,
        4u32,
    ) {
        return 0usize
    }
    if !unity_ui_list_set_item(
        output,
        text_output,
        command_capacity,
        text_capacity,
        3usize,
        77u32,
        103u32,
        2u32,
        9u32,
        5u32,
    ) {
        return 0usize
    }
    return 4usize
}

@export(name: "jadren_unity_api_emit_ui_table", abi: "C")
@noalloc
pub fn emit_ui_table(
    output: write Slice<UnityUiTableCommandRecord>,
    text_output: write Slice<UInt8>,
    command_capacity: UIntSize,
    text_capacity: UIntSize,
) -> UIntSize {
    if command_capacity < 7usize {
        return 0usize
    }
    if text_capacity < 22usize {
        return 0usize
    }

    // Caller-owned UTF-8 bytes: Name, Value, Alpha, 42, Beta, 99.
    text_output[0] = 78u8
    text_output[1] = 97u8
    text_output[2] = 109u8
    text_output[3] = 101u8
    text_output[4] = 86u8
    text_output[5] = 97u8
    text_output[6] = 108u8
    text_output[7] = 117u8
    text_output[8] = 101u8
    text_output[9] = 65u8
    text_output[10] = 108u8
    text_output[11] = 112u8
    text_output[12] = 104u8
    text_output[13] = 97u8
    text_output[14] = 52u8
    text_output[15] = 50u8
    text_output[16] = 66u8
    text_output[17] = 101u8
    text_output[18] = 116u8
    text_output[19] = 97u8
    text_output[20] = 57u8
    text_output[21] = 57u8

    if !unity_ui_table_clear(output, command_capacity, 0usize, 88u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        1usize, 88u32, 1000u32, 10u32, 0u32, 0u32, 0u32, 4u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        2usize, 88u32, 1000u32, 11u32, 0u32, 1u32, 4u32, 5u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        3usize, 88u32, 1001u32, 10u32, 1u32, 0u32, 9u32, 5u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        4usize, 88u32, 1001u32, 11u32, 1u32, 1u32, 14u32, 2u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        5usize, 88u32, 1002u32, 10u32, 2u32, 0u32, 16u32, 4u32) {
        return 0usize
    }
    if !unity_ui_table_set_cell(output, text_output, command_capacity, text_capacity,
        6usize, 88u32, 1002u32, 11u32, 2u32, 1u32, 20u32, 2u32) {
        return 0usize
    }
    return 7usize
}

