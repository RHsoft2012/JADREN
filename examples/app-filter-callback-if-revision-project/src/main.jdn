module app_filter_callback_if_revision_project.main

import jadren.app.data.revision
import jadren.app.list.count
import jadren.app.list.find_text
import jadren.app.list.push_text
import jadren.app.table.append_row
import jadren.app.table.read_cell_exact
import jadren.app.table.row_count
import jadren.app.table.set_cell
import jadren.app.table.set_column_name
import jadren.app.table.set_column_type

fn keep_first(source: Int32, index: Int32) -> Bool {
    return index == 0
}

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    app_list_clear(0)
    app_list_clear(1)
    if ! push_text(0, "Alpha") { return 1 }
    if ! push_text(0, "Beta") { return 2 }
    if ! push_text(1, "Sentinel") { return 3 }

    let stale_list: UInt64 = revision()
    if ! push_text(0, "Gamma") { return 4 }
    if app_list_filter_callback_if_revision(0, 1, keep_first, stale_list) { return 5 }
    if count(1) != 1 { return 6 }
    if find_text(1, "Sentinel", 0) != 0 { return 7 }

    let current_list: UInt64 = revision()
    if ! app_list_filter_callback_if_revision(0, 1, keep_first, current_list) { return 8 }
    if count(1) != 1 { return 9 }
    if find_text(1, "Alpha", 0) != 0 { return 10 }
    if find_text(1, "Sentinel", 0) != -1 { return 11 }

    app_table_clear(2)
    app_table_clear(3)
    if ! set_column_type(2, 0, 0) { return 12 }
    if ! set_column_name(2, 0, "Value") { return 13 }
    if ! append_row(2) { return 14 }
    if ! append_row(2) { return 15 }
    if ! set_cell(2, 0, 0, "One") { return 16 }
    if ! set_cell(2, 1, 0, "Two") { return 17 }

    if ! set_column_type(3, 0, 0) { return 18 }
    if ! set_column_name(3, 0, "Value") { return 19 }
    if ! append_row(3) { return 20 }
    if ! set_cell(3, 0, 0, "Table sentinel") { return 21 }

    let stale_table: UInt64 = revision()
    if ! set_cell(2, 0, 0, "One updated") { return 22 }
    if app_table_filter_callback_if_revision(2, 3, keep_first, stale_table) { return 23 }
    if row_count(3) != 1 { return 24 }
    var output: [UInt8; 32] = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]
    var length: [UIntSize; 1] = [99usize]
    if ! read_cell_exact(3, 0, 0, output, length) { return 25 }
    if length[0] != 13usize { return 26 }
    if output[0] != 84u8 { return 27 }

    let current_table: UInt64 = revision()
    if ! app_table_filter_callback_if_revision(2, 3, keep_first, current_table) { return 28 }
    if row_count(3) != 1 { return 29 }
    if ! read_cell_exact(3, 0, 0, output, length) { return 30 }
    if length[0] != 11usize { return 31 }
    if output[0] != 79u8 { return 32 }

    if app_table_filter_callback_if_revision(2, 2, keep_first, revision()) { return 33 }
    return 0
}
