module app_state_http_keep_alive_project.main
import jadren.app.fs.write_text
import jadren.app.state.clear
import jadren.app.state.get_int
import jadren.app.state.save_atomic
import jadren.app.state.set_int
import jadren.app.state.write_json_exact
import jadren.network.router.add_exact
import jadren.network.session.close
import jadren.network.session.open
import jadren.network.session.step
import jadren.network.tcp.listen
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}
fn publish_state(body: write Slice<UInt8>) -> Bool {
    var state_length:[UIntSize;
    1] =[0usize]
    if ! write_json_exact(body,
    state_length) {
        return false
    }
    return add_exact("GET",
    "/api/state",
    200u16,
    "application/json",
    body,
    state_length[0]
    )
}
fn main() -> Int32 {
    clear()
    if ! set_int("count",
    0i64) {
        return 1
    }
    var body:[UInt8;
    16] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
    ]
    http_router_clear()
    if ! publish_state(body) {
        return 2
    }
    let listener: UIntSize = listen(38162u16)
    if listener == 0usize {
        return 3
    }
    let session: UIntSize = open(listener,
    1u32,
    1024u32,
    1024u32)
    if session == 0usize {
        return 4
    }
    let first: UInt32 = step(session,
    5000u32)
    if first != 1u32 {
        close(session);
        return 5
    }
    if get_int("count") != 0i64 {
        close(session);
        return 6
    }
    if ! set_int("count",
    1i64) {
        close(session);
        return 7
    }
    if ! publish_state(body) {
        close(session);
        return 8
    }
    let second: UInt32 = step(session,
    5000u32)
    if second != 2u32 {
        close(session);
        return 9
    }
    if ! close(session) {
        return 10
    }
    if ! save_atomic("target/app-state-http-keep-alive.state.tmp",
    "target/app-state-http-keep-alive.state"
    ) {
        return 11
    }
    if write_text("target/app-state-http-keep-alive.result",
    "session:2,count:1\n"
    ) == 0usize {
        return 12
    }
    return 0
}
