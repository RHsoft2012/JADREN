pub fn run_exchange(reactor: UIntSize, listener: UIntSize, user_data: UIntSize) -> Int32 {
    let accept_operation = submit_accept(reactor,
    listener,
    user_data)
    if accept_operation == 0usize {
        return 10
    }
    let client = connect("127.0.0.1",
    38156u16)
    if client == 0usize {
        return 11
    }
    if ! set_timeout(client,
    3000u32) {
        close_socket(client)
        return 12
    }
    let accepted_events = poll(reactor,
    3000u32)
    if accepted_events == 0u32 {
        close_socket(client)
        return 13
    }
    let accepted = event_socket(reactor,
    0u32)
    if accepted == 0usize {
        close_socket(client)
        return 14
    }
    if event_operation(reactor,
    0u32) != accept_operation {
        close_socket(accepted)
        close_socket(client)
        return 15
    }
    var body:[UInt8;
    1] =[0u8]
    var request:[UInt8;
    128] =[0u8,
