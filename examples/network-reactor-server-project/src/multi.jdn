    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let request_length = write_request_prefix("GET",
    "/hello",
    "localhost",
    body,
    0usize,
    request)
    if request_length == 0usize {
        close_socket(accepted)
        close_socket(client)
        return 16
    }
    let receive_operation = submit_receive_buffer(reactor,
    accepted,
    request,
    user_data + 1usize)
    if receive_operation == 0usize {
        close_socket(accepted)
        close_socket(client)
        return 17
    }
    if send_prefix(client,
    request,
    request_length) != request_length {
        close_socket(accepted)
        close_socket(client)
        return 18
    }
    let received_events = poll(reactor,
    3000u32)
    if received_events == 0u32 {
        close_socket(accepted)
        close_socket(client)
        return 19
    }
    if event_operation(reactor,
    0u32) != receive_operation {
        close_socket(accepted)
        close_socket(client)
        return 20
    }
    let received_bytes = event_bytes(reactor,
    0u32)
    if received_bytes == 0usize {
        close_socket(accepted)
        close_socket(client)
        return 21
    }
    if ! request_is_complete_prefix(request,
    received_bytes) {
        close_socket(accepted)
        close_socket(client)
        return 22
    }
    if ! route_match_prefix(request,
    received_bytes,
    "GET",
    "/hello") {
        close_socket(accepted)
        close_socket(client)
        return 23
    }
    var response:[UInt8;
    128] =[0u8,
    0u8,
