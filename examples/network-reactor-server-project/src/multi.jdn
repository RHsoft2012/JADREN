    if body_length != 2usize {
        close_socket(accepted)
        close_socket(client)
        return 31
    }
    if client_body[0] != 79u8 {
        close_socket(accepted)
        close_socket(client)
        return 32
    }
    if client_body[1] != 75u8 {
        close_socket(accepted)
        close_socket(client)
        return 32
    }
    if ! close_socket(accepted) {
        close_socket(client)
        return 33
    }
    if ! close_socket(client) {
        return 34
    }
    return 0
