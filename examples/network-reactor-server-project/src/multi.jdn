    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8]
    let response_length = respond(request,
    response)
    if response_length == 0usize {
        close_socket(accepted)
        close_socket(client)
        return 24
    }
    let send_operation = submit_send_buffer_prefix(reactor,
    accepted,
    response,
    response_length,
    user_data + 2usize)
    if send_operation == 0usize {
        close_socket(accepted)
        close_socket(client)
        return 25
    }
    if poll(reactor,
    3000u32) == 0u32 {
        close_socket(accepted)
        close_socket(client)
        return 26
    }
    if event_operation(reactor,
    0u32) != send_operation {
        close_socket(accepted)
        close_socket(client)
        return 27
    }
    if event_bytes(reactor,
    0u32) != response_length {
        close_socket(accepted)
        close_socket(client)
        return 28
    }
    var client_response:[UInt8;
    128] =[0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
