module examples.network_reactor_server_project
import examples.network_reactor_server_project.multi.run_exchange
import jadren.app.fs.write_text
import jadren.app.state.save_atomic
import jadren.app.state.set_int
import jadren.network.reactor.cancel
import jadren.network.reactor.close
import jadren.network.reactor.event_bytes
import jadren.network.reactor.event_flags
import jadren.network.reactor.event_operation
import jadren.network.reactor.event_socket
import jadren.network.reactor.open
import jadren.network.reactor.poll
import jadren.network.reactor.submit_accept
import jadren.network.reactor.submit_receive_buffer
import jadren.network.router.add
import jadren.network.router.clear
import jadren.network.tcp.close_socket
import jadren.network.tcp.connect
import jadren.network.tcp.listen
import jadren.network.tcp.set_timeout

@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    return event_id
}

fn main() -> Int32 {
    let listener = listen(38156u16)
    if listener == 0usize {
        return 10
    }
    let reactor = open(4u32,
    16u32)
    if reactor == 0usize {
        close_socket(listener)
        return 11
    }
    clear()
    var body:[UInt8;
    2] =[79u8,
    75u8]
    if ! add("GET",
    "/hello",
    200u16,
    "text/plain",
    body) {
        close(reactor)
        close_socket(listener)
        return 12
    }
    if run_exchange(reactor,
    listener,
    100usize) != 0 {
        close(reactor)
        close_socket(listener)
        return 13
    }
    if run_exchange(reactor,
    listener,
    200usize) != 0 {
        close(reactor)
        close_socket(listener)
        return 14
    }
    // A third accepted connection is deliberately left without payload. Its
    // receive operation is cancelled and the cancellation event is consumed
    // before all owned sockets are closed.
    let accept_operation = submit_accept(reactor,
    listener,
    300usize)
    if accept_operation == 0usize {
        close(reactor)
        close_socket(listener)
        return 15
    }
    let pending_client = connect("127.0.0.1",
    38156u16)
    if pending_client == 0usize {
        close(reactor)
        close_socket(listener)
        return 16
    }
    if ! set_timeout(pending_client,
    3000u32) {
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 17
    }
    if poll(reactor,
    3000u32) == 0u32 {
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 18
    }
    let pending_server = event_socket(reactor,
    0u32)
    if pending_server == 0usize {
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 19
    }
    if event_operation(reactor,
    0u32) != accept_operation {
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 19
    }
    var pending_buffer:[UInt8;
    4] =[0u8,
    0u8,
    0u8,
    0u8]
    let pending_receive = submit_receive_buffer(reactor,
    pending_server,
    pending_buffer,
    301usize)
    if pending_receive == 0usize {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 20
    }
    if ! cancel(reactor,
    pending_receive) {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 21
    }
    if poll(reactor,
    1000u32) == 0u32 {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 22
    }
    if event_operation(reactor,
    0u32) != pending_receive {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 23
    }
    if event_flags(reactor,
    0u32) != 32u32 {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 24
    }
    if event_bytes(reactor,
    0u32) != 0usize {
        close_socket(pending_server)
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 25
    }
    if ! close_socket(pending_server) {
        close_socket(pending_client)
        close(reactor)
        close_socket(listener)
        return 26
    }
    if ! close_socket(pending_client) {
        close(reactor)
        close_socket(listener)
        return 27
    }
    if ! close(reactor) {
        close_socket(listener);
        return 28
    }
    if ! close_socket(listener) {
        return 29
    }
    if ! set_int("reactor_exchanges", 2i64) {
        return 30
    }
    if ! save_atomic(
        "target/jadren/network-reactor-server.tmp",
        "target/jadren/network-reactor-server.data"
    ) {
        return 31
    }
    if write_text(
        "target/jadren/network-reactor-server.result",
        "network-reactor-server:pass\n"
    ) == 0usize {
        return 32
    }
    print("bounded reactor server handled two connections and one cancellation")
    return 0
}
