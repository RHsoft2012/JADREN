module examples.stdlib_buffer_generic_nested_owning_nominal

// A generic C-layout nominal wrapper can own a nested Buffer descriptor.
// The outer generic Buffer must move the wrapper and recursively drop the
// inner Buffer without copying ownership or leaking its allocation.
@repr(C)
struct Box<T> {
    value: T
}

fn main() -> Int32 {
    let outer_created: Result<Buffer<Box<Buffer<OwnedString>>>, Int32> = buffer_create(0usize)
    let inner_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
    var result_code: Int32 = 0

    match outer_created {
        Ok(outer) => {
            match inner_created {
                Ok(inner) => {
                    let value: Result<OwnedString, Int32> = string_owned_from("Nested")
                    match value {
                        Ok(text) => {
                            if !buffer_append(inner, text) { result_code = 1 }
                        }
                        Error(status) => { result_code = status }
                    }
                    let item: Box<Buffer<OwnedString>> = Box { value: inner }
                    if !buffer_append(outer, item) { result_code = 2 }
                    if buffer_length(outer) != 1usize { result_code = 3 }
                    let output_inner_created: Result<Buffer<OwnedString>, Int32> = buffer_create(0usize)
                    match output_inner_created {
                        Ok(output_inner) => {
                            let output: Box<Buffer<OwnedString>> = Box { value: output_inner }
                            let move_status: Int32 = buffer_remove_move_into_status(outer, 0usize, output)
                            if move_status != 0 { result_code = move_status }
                            if buffer_length(output.value) != 1usize { result_code = 4 }
                            if string_owned_length(output.value[0]) != 6usize { result_code = 5 }
                            let output_clear_status: Int32 = buffer_clear_move_status(output.value)
                            if output_clear_status != 0 { result_code = output_clear_status }
                        }
                        Error(status) => { result_code = status }
                    }
                    if buffer_length(outer) != 0usize { result_code = 6 }
                    let clear_status: Int32 = buffer_clear_move_status(outer)
                    if clear_status != 0 { result_code = clear_status }
                }
                Error(status) => { result_code = status }
            }
        }
        Error(status) => { result_code = status }
    }
    return result_code
}
