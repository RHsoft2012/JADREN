    ]
    let received: UIntSize = receive(socket, payload)
    if received == 0usize {
        close_socket(socket)
        return 5
    }
    let status: UInt16 = response_status_prefix(payload, received)
    let body_length: UIntSize = response_body_prefix(payload, received, snapshot)
    if !close_socket(socket) { return 6 }
    if status != 200u16 { return 7 }
    if body_length < 20usize { return 8 }
    if !load_exact_if_revision(snapshot, body_length, expected_revision) { return 9 }
    if get_int("service_status") != 200i64 { return 10 }
    if !set_int("last_status", 200i64) { return 11 }
    if get_int("last_status") != 200i64 { return 12 }
    if !save_atomic(
        "target/jadren/app-network-client.tmp",
        "target/jadren/app-network-client.data"
    ) { return 13 }
    if write_text(
        "target/jadren/app-network-client.result",
        "app-network-client:200\\n"
    ) == 0usize { return 14 }
    return 0
}
