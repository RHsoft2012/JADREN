module examples.app_table_index_range_int

// Inclusive numeric range query over a deterministic Int index.
fn main() -> Int32 {
    app_table_clear(0)
    if !app_table_set_column_type(0, 0, 1) { return 1 }

    if !app_table_append_row(0) { return 2 }
    if !app_table_set_int(0, 0, 0, 9i64) { return 3 }
    if !app_table_append_row(0) { return 4 }
    if !app_table_set_int(0, 1, 0, -2i64) { return 5 }
    if !app_table_append_row(0) { return 6 }
    if !app_table_set_int(0, 2, 0, 5i64) { return 7 }
    if !app_table_append_row(0) { return 8 }
    if !app_table_set_int(0, 3, 0, 5i64) { return 9 }
    if !app_table_index_build_int(0, 0) { return 10 }

    var output: [Int32; 4] = [77, 77, 77, 77]
    let high_matches: UIntSize = app_table_index_collect_int_range(0, 0, 5i64, 9i64, output)
    if high_matches != 3usize { return 11 }
    if output[0] != 2 { return 12 }
    if output[1] != 3 { return 12 }
    if output[2] != 0 { return 12 }

    let low_matches: UIntSize = app_table_index_collect_int_range(0, 0, -2i64, 5i64, output)
    if low_matches != 3usize { return 13 }
    if output[0] != 1 { return 14 }
    if output[1] != 2 { return 14 }
    if output[2] != 3 { return 14 }

    // A short destination is rejected before any element is overwritten.
    var short: [Int32; 2] = [77, 77]
    let short_matches: UIntSize = app_table_index_collect_int_range(0, 0, -2i64, 9i64, short)
    if short_matches != 0usize { return 15 }
    if short[0] != 77 { return 15 }
    if short[1] != 77 { return 15 }

    if !app_table_set_int(0, 3, 0, 8i64) { return 16 }
    if app_table_index_collect_int_range(0, 0, 5i64, 9i64, output) != 0usize { return 17 }
    app_table_clear(0)
    return 0
}
