module windows_desktop_portable_select.main

// Retained dropdown example. Options are attached to the returned node id;
// the native backend translates that id to its callback event internally.
@export(name: "jadren_ui_on_click", abi: "C")
pub fn on_click(event_id: Int32) -> Int32 {
    if event_id == 2 {
        ui_set_status("Selection changed.")
    }
    if event_id == 3 {
        ui_set_status("Saved selection.")
    }
    return event_id
}

fn main() -> Int32 {
    let root: Int32 = ui_app_begin("Jadren Portable Select", 720, 420, 0xF6F8FCu32)
    if root == 0 { return 1 }
    let panel: Int32 = ui_app_panel(root, 640, 260, 0xFFFFFFu32, 16, 12, 8, 0, 1)
    if panel == 0 { return 2 }
    ui_layout_status("Choose an option from the retained dropdown.", 560, 34,
                     0x111827u32, 0xDCFCE7u32, 10, 1)
    let select: Int32 = ui_app_select(panel, 2, 360, 38,
                                      0x111827u32, 0xFFFFFFu32, 8, 0)
    if select == 0 { return 3 }
    if !ui_app_select_option(select, "First option") { return 4 }
    if !ui_app_select_option(select, "Second option") { return 5 }
    if !ui_app_select_option(select, "Third option") { return 6 }
    if !ui_app_select_set_index(select, 1) { return 7 }
    if ui_app_select_index(select) != 1 { return 8 }
    let button: Int32 = ui_app_button(panel, "Save selection", 3, 200, 42,
                                      0xFFFFFFu32, 0x168EF5u32, 12, 0)
    if button == 0 { return 9 }
    if !ui_app_end(panel) { return 10 }
    if !ui_app_end(root) { return 11 }
    return ui_app_run()
}
