module examples.http_session_server

// Bounded HTTP session: the same TCP connection serves two requests.
// The first response keeps the connection alive; the second closes it.
fn main() -> Int32 {
    let listener: UIntSize = net_tcp_listen(38125u16)
    if (listener as Int32) == 0 { return 10 }

    let session: UIntSize = http_session_open(listener, 2u32, 1024u32, 1024u32)
    if (session as Int32) == 0 {
        net_socket_close(listener)
        return 11
    }

    http_router_clear()
    var body: [UInt8; 4] = [65u8, 104u8, 111u8, 106u8]
    let added: Bool = http_router_add("GET", "/hello", 200u16, "text/plain", body)
    if !added {
        http_session_close(session)
        return 12
    }

    let first: UInt32 = http_session_step(session, 2000u32)
    let second: UInt32 = http_session_step(session, 2000u32)
    let closed: Bool = http_session_close(session)
    if first != 1u32 { return 13 }
    if second != 2u32 { return 14 }
    if !closed { return 15 }
    return 0
}
