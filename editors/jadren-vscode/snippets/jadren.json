{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:argument}: ${3:Int32}) -> ${4:Int32} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a typed Jadren function"
  },
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:project}.${2:main}",
      "",
      "${0}"
    ],
    "description": "Create a Jadren module declaration"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:Int32}",
      "    ${0}",
      "}"
    ],
    "description": "Create a Jadren struct"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a Jadren if block"
  },
  "If Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "Create a Jadren if/else block"
  },
  "For Range": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a Jadren for loop"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:module}",
      "${0}"
    ],
    "description": "Create a Jadren import"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:\"value\"})${0}"
    ],
    "description": "Print a value in Jadren"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    ${0}",
      "}"
    ],
    "description": "Create a Jadren program entry point"
  }
}
