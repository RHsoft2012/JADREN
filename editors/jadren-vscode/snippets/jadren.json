  "App Typed Event Reducer": {
    "prefix": "appreducer",
    "body": [
      "import jadren.app.event.AppEvent",
      "import jadren.app.event.click",
      "",
      "pub struct ${1:Model} {",
      "    ${2:count}: Int64,",
      "    ${3:enabled}: Bool,",
      "}",
      "",
      "pub fn reduce(event: AppEvent, model: write Slice<${1:Model}>, capacity: UIntSize) -> Bool {",
      "    if capacity < 1usize { return false }",
      "    if event.id != ${4:event_id} { return false }",
      "    model[0].${2:count} = model[0].${2:count} + 1i64",
      "    return true",
      "}",
      "",
      "var ${5:model}: [${1:Model}; 1] = [${1:Model} { ${2:count}: 0i64, ${3:enabled}: false }]",
      "if !reduce(click(${4:event_id}), ${5:model}, 1usize) { return ${6:1} }",
      "${0}"
    ],
    "description": "Create a project-owned typed AppEvent reducer over a caller-owned model slice"
  },
