{
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "name": "Jadren Dark",
  "colors": {
    "focusBorder": "#55B7FF",
    "foreground": "#D4D4D4",
    "descriptionForeground": "#9D9D9D",
    "errorForeground": "#FF6B81",
    "widget.shadow": "#00000066",
    "editor.background": "#1E1E1E",
    "editor.foreground": "#D4D4D4",
    "editorLineNumber.foreground": "#858585",
    "editorLineNumber.activeForeground": "#C6C6C6",
    "editorCursor.foreground": "#55B7FF",
    "editor.selectionBackground": "#264F78AA",
    "editor.inactiveSelectionBackground": "#264F7844",
    "editor.selectionHighlightBackground": "#264F7844",
    "editor.wordHighlightBackground": "#57575755",
    "editor.wordHighlightStrongBackground": "#6A6A6A77",
    "editor.findMatchBackground": "#B9823B88",
    "editor.findMatchHighlightBackground": "#B9823B44",
    "editorWhitespace.foreground": "#404040",
    "editorIndentGuide.background1": "#404040",
    "editorIndentGuide.activeBackground1": "#707070",
    "editorBracketMatch.background": "#3A3D41",
    "editorBracketMatch.border": "#55B7FF",
    "editorGutter.background": "#1E1E1E",
    "editorError.foreground": "#FF6B81",
    "editorWarning.foreground": "#FFC66D",
    "editorInfo.foreground": "#55B7FF",
    "editorHint.foreground": "#6ED8A6",
    "editorHoverWidget.background": "#252526",
    "editorHoverWidget.border": "#454545",
    "editorSuggestWidget.background": "#252526",
    "editorSuggestWidget.border": "#454545",
    "editorSuggestWidget.foreground": "#D4D4D4",
    "editorSuggestWidget.highlightForeground": "#55B7FF",
    "editorSuggestWidget.selectedBackground": "#094771",
    "editorWidget.background": "#252526",
    "editorWidget.border": "#454545",
    "sideBar.background": "#252526",
    "sideBar.foreground": "#D4D4D4",
    "sideBar.border": "#3E3E42",
    "sideBarTitle.foreground": "#D4D4D4",
    "sideBarSectionHeader.background": "#2D2D30",
    "sideBarSectionHeader.foreground": "#C6C6C6",
    "list.hoverBackground": "#2A2D2E",
    "list.activeSelectionBackground": "#094771",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#37373D",
    "list.highlightForeground": "#55B7FF",
    "activityBar.background": "#333333",
    "activityBar.foreground": "#D4D4D4",
    "activityBar.inactiveForeground": "#858585",
    "activityBarBadge.background": "#2998E8",
    "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#3C3C3C",
    "titleBar.activeForeground": "#D4D4D4",
    "titleBar.inactiveBackground": "#3C3C3C",
    "titleBar.inactiveForeground": "#858585",
    "tab.activeBackground": "#1E1E1E",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#2D2D30",
    "tab.inactiveForeground": "#858585",
    "tab.activeBorderTop": "#55B7FF",
    "tab.border": "#3E3E42",
    "panel.background": "#1E1E1E",
    "panel.border": "#3E3E42",
    "panelTitle.activeForeground": "#D4D4D4",
    "panelTitle.inactiveForeground": "#858585",
    "statusBar.background": "#007ACC",
    "statusBar.foreground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#005A9E",
    "terminal.background": "#1E1E1E",
    "terminal.foreground": "#D4D4D4",
    "terminal.ansiBlack": "#1E1E1E",
    "terminal.ansiRed": "#FF6B81",
    "terminal.ansiGreen": "#6ED8A6",
    "terminal.ansiYellow": "#FFC66D",
    "terminal.ansiBlue": "#55B7FF",
    "terminal.ansiMagenta": "#C77DBB",
    "terminal.ansiCyan": "#2AACBB",
    "terminal.ansiWhite": "#D4D4D4",
    "terminal.ansiBrightBlack": "#858585",
    "terminal.ansiBrightRed": "#FF8B9B",
    "terminal.ansiBrightGreen": "#8BE8B7",
    "terminal.ansiBrightYellow": "#FFD98C",
    "terminal.ansiBrightBlue": "#8ACFFF",
    "terminal.ansiBrightMagenta": "#E0A6D6",
    "terminal.ansiBrightCyan": "#74D9E3",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "button.background": "#2998E8",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#43A9F0",
    "badge.background": "#2998E8",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#55B7FF",
    "gitDecoration.addedResourceForeground": "#6ED8A6",
    "gitDecoration.modifiedResourceForeground": "#FFC66D",
    "gitDecoration.deletedResourceForeground": "#FF6B81",
    "gitDecoration.untrackedResourceForeground": "#55B7FF"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": {"foreground": "#6A9955", "fontStyle": "italic"}
    },
    {
      "scope": ["keyword", "keyword.control", "storage.modifier"],
      "settings": {"foreground": "#CF8E6D"}
    },
    {
      "scope": ["entity.name.namespace", "storage.type", "support.type"],
      "settings": {"foreground": "#56A8F5"}
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {"foreground": "#FFC66D"}
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other.property"],
      "settings": {"foreground": "#C77DBB"}
    },
    {
      "scope": ["constant.numeric"],
      "settings": {"foreground": "#2AACBB"}
    },
    {
      "scope": ["string", "string.quoted", "constant.character"],
      "settings": {"foreground": "#6AAB73"}
    },
    {
      "scope": ["constant.language", "constant.language.boolean", "keyword.operator"],
      "settings": {"foreground": "#E5C07B"}
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {"foreground": "#B8C0CC"}
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {"foreground": "#FFFFFF", "background": "#8C263C"}
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#6A9955",
    "keyword": "#CF8E6D",
    "namespace": "#56A8F5",
    "type": "#56A8F5",
    "function": "#FFC66D",
    "parameter": "#C77DBB",
    "variable": "#C77DBB",
    "property": "#C77DBB",
    "number": "#2AACBB",
    "string": "#6AAB73",
    "operator": "#E5C07B"
  }
}
